+    function compressImage(file, maxEdge = 720, quality = 0.78) {
+      return new Promise((resolve, reject) => {
+        if (!file || typeof FileReader !== 'function' || typeof Image !== 'function') {
+          reject(new Error('image_unavailable'));
+          return;
+        }
+        const reader = new FileReader();
+        reader.onerror = () => reject(new Error('read_failed'));
+        reader.onload = () => {
+          const image = new Image();
+          image.onerror = () => reject(new Error('decode_failed'));
+          image.onload = () => {
+            try {
+              const scale = Math.min(1, maxEdge / Math.max(image.width, image.height));
+              const canvas = document.createElement('canvas');
+              canvas.width = Math.max(1, Math.round(image.width * scale));
+              canvas.height = Math.max(1, Math.round(image.height * scale));
+              const context = canvas.getContext('2d');
+              if (!context) throw new Error('canvas_unavailable');
+              context.drawImage(image, 0, 0, canvas.width, canvas.height);
+              const dataUrl = canvas.toDataURL('image/jpeg', quality);
+              const safe = sanitizeLookPhoto(dataUrl);
+              if (!safe) throw new Error('invalid_photo');
+              resolve(safe);
+            } catch (error) {
+              reject(error);
+            }
+          };
+          image.src = typeof reader.result === 'string' ? reader.result : '';
+        };
+        reader.readAsDataURL(file);
+      });
+    }
