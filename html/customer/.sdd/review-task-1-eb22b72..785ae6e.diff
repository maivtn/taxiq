+    function isRecord(value) {
+      return value !== null && typeof value === 'object' && !Array.isArray(value);
+    }
+
+    function mergeRecord(defaultValue, incomingValue) {
+      if (Array.isArray(defaultValue)) {
+        return Array.isArray(incomingValue) ? structuredClone(incomingValue) : structuredClone(defaultValue);
+      }
+      if (isRecord(defaultValue)) {
+        if (!isRecord(incomingValue)) return structuredClone(defaultValue);
+        const result = {};
+        for (const [key, fallback] of Object.entries(defaultValue)) {
+          result[key] = Object.prototype.hasOwnProperty.call(incomingValue, key)
+            ? mergeRecord(fallback, incomingValue[key])
+            : structuredClone(fallback);
+        }
+        return result;
+      }
+      if (defaultValue === null) {
+        return null;
+      }
+      if (typeof defaultValue === 'number') {
+        return typeof incomingValue === 'number' && Number.isFinite(incomingValue) ? incomingValue : defaultValue;
+      }
+      return typeof incomingValue === typeof defaultValue ? incomingValue : structuredClone(defaultValue);
+    }
+
+    function migrateState(value) {
+      const defaults = createDefaultState();
+      if (!value || typeof value !== 'object' || Array.isArray(value)) return defaults;
+      const migrated = mergeRecord(defaults, value);
+      migrated.schemaVersion = SCHEMA_VERSION;
+      migrated.updatedAt = new Date().toISOString();
+      if (!['vi', 'en'].includes(migrated.profile.language)) migrated.profile.language = defaults.profile.language;
+      delete migrated.pointBalance;
+      delete migrated.savedOffers;
+      return migrated;
+    }
+
