function spCreate(){
  const o=orderById(spOrder); if(!o)return;
  if(o.closed||o.voided)return infoModal('Order đã khóa','Không thể gán thợ hoặc tạo phiếu mới cho order này.');
  if(!o.unassigned.length)return infoModal('Không còn dịch vụ','Tất cả dịch vụ đã được gán thợ.');
  /* Đọc lựa chọn thợ ngay trên từng dòng dịch vụ, rồi gom theo thợ → mỗi thợ 1 ticket */
  const groups=new Map();
  o.unassigned.forEach((s,i)=>{
    const sel=($('sp-tech'+i)||{}).value||'';
    if(!sel)return;
    const stShort=sel==='__next'?(recommendedStaffForServices([s],{clockedOnly:true})||{}).short:sel;
    if(!stShort)return;
    if(!groups.has(stShort))groups.set(stShort,[]);
    groups.get(stShort).push(s);
  });
  if(!groups.size)return infoModal('Chưa chọn thợ','Chọn thợ cho ít nhất một dịch vụ ở cột bên phải để tạo ticket.');
  const created=[];
  groups.forEach((svcList,stShort)=>{
    const st=staff.find(x=>x.short===stShort); if(!st)return;
    st.turn++;                                                     /* Rule 42: +1 turn/ticket */
    o.unassigned=o.unassigned.filter(x=>!svcList.includes(x));
    const t=T(o,svcList,stShort,'waiting');
    log(t,'Split từ order bởi Manager — gán '+stShort+' (turn +1)');
    oLog(o,'Assign Tech: '+svcList.map(x=>x.name).join(' + ')+' → '+stShort);
    created.push({id:t.id,stShort,n:svcList.length});
  });
  renderAll();
  toast(created.length===1
    ? 'Đã tạo '+created[0].id+' cho '+created[0].stShort+' ('+created[0].n+' dịch vụ).'
    : 'Đã tạo '+created.length+' ticket: '+created.map(c=>c.stShort+' ('+c.n+')').join(', ')+'.');
}
function openTicket(id){
  const t=byId(id); if(!t)return infoModal('Ticket không khả dụng','Không tìm thấy ticket trong nguồn dữ liệu tập trung.');
  curTicket=id;
  const [lbl,cls]=stMap[t.status];
  $('tk-title').textContent='Ticket '+t.id;
  $('tk-status').textContent=lbl; $('tk-status').className='status '+cls;
	  const cust=customerByName(t.customer);
	  $('tk-cust').innerHTML='<b>'+safeText(t.customer)+'</b>'+customerTagsHtml(cust)+'<span>Order '+safeText(t.orderId)+' · '+safeText(t.time)+(t.note?' · Note: '+safeText(t.note):'')+'</span>'+(cust&&cust.notes&&cust.notes.staff?'<div class="visibility-notes" style="margin-top:0.4375rem">'+customerVisibilityNotesHtml({notes:{staff:cust.notes.staff}})+'</div>':'');
  $('tk-svcs').innerHTML=t.services.map(renderTicketServiceRow).join('')+
    `<div class="ticket-service-row total"><span class="ticket-service-icon">${iconHtml('receipt-text','icon-only')}</span><span><b>Tạm tính</b><span>Chưa gồm tax và tip ở checkout</span></span><strong>${fmt(subtotal(t))}</strong></div>`;
  $('tk-staff').innerHTML=renderTicketStaffCard(t);
  $('tk-timeline').innerHTML=t.timeline.map(renderTicketTimelineItem).join('')||'<div class="report-empty">Chưa có timeline.</div>';
  const F=$('tk-foot'); F.innerHTML='';
  const mk=(lbl,cls,fn,icon)=>{const b=document.createElement('button');b.className='btn '+cls;b.innerHTML=(icon?iconHtml(icon,'icon-inline'):'')+lbl;b.onclick=fn;F.appendChild(b);};
	  if(['waiting','inservice'].includes(t.status)) mk('Void','red-o',()=>{closeM('m-ticket');voidTicket(id);},'ban');
	  mk('Back','',()=>closeM('m-ticket'),'arrow-left');
	  mk('Order '+t.orderId,'',()=>{closeM('m-ticket');openSplit(t.orderId);},'receipt-text');
	  if(!['closed','void'].includes(t.status)) mk('Request Add-on','',()=>{closeM('m-ticket');openAddonRequest(id);},'badge-plus');
	  if(t.status==='waiting')  mk('Start Service','blue',()=>{closeM('m-ticket');startTicket(id);},'play');
  if(t.status==='inservice')mk('Done','green',()=>{closeM('m-ticket');doneTicket(id);},'check');
  if(t.status==='done'&&orderStatus(orderById(t.orderId))==='ready') mk('Checkout Order','green',()=>{closeM('m-ticket');openCheckout(t.orderId);},'badge-dollar-sign');
  if(t.status==='closed')   mk('Receipt','blue',()=>{closeM('m-ticket');openReceipt(t.orderId);},'receipt');
  refreshIcons();
  openM('m-ticket');
}
function changeStaff(){
  const t=byId(curTicket);
  const opts=staff.filter(s=>s.clocked).map(s=>s.short).join(' / ');
  promptModal('Đổi thợ','Nhập tên thợ đang trong ca'+(opts?' ('+opts+')':'')+'.',{
    label:'Tên thợ *',value:t.staff||'',required:true,error:'Vui lòng nhập tên thợ.',okText:'Đổi thợ'
  },v=>{
    const s=staff.find(x=>x.short.toLowerCase()===v.toLowerCase());
    if(!s){ $('dlg-error').textContent='Không tìm thấy thợ "'+v+'" trong danh sách.'; return false; }
    if(!s.clocked){ $('dlg-error').textContent=s.short+' chưa clock-in — không thể gán.'; return false; }
    log(t,'Change staff: '+(t.staff||'—')+' → '+s.short+' (by Front Desk)');
    const old=staff.find(x=>x.short===t.staff); if(old)old.turn=Math.max(0,old.turn-1);
    t.staff=s.short; s.turn++;
    renderAll(); openTicket(curTicket);
  });
}

