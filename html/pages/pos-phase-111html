const POS_DEMO_DATA_VERSION=2;
function migratePosDemoData(state,seedState){
  if(!state||Number(state.posDemoDataVersion||0)>=POS_DEMO_DATA_VERSION)return false;
  const clone=value=>JSON.parse(JSON.stringify(value));
  const mergeMissing=(current,seed,key)=>{
    const result=Array.isArray(current)?current:[];
    const existing=new Set(result.map(item=>item&&item[key]));
    (Array.isArray(seed)?seed:[]).forEach(item=>{
      if(!item||existing.has(item[key]))return;
      result.push(clone(item));
      existing.add(item[key]);
    });
    return result;
  };
  state.orders=mergeMissing(state.orders,seedState&&seedState.orders,'id');
  state.tickets=mergeMissing(state.tickets,seedState&&seedState.tickets,'id');
  state.customers=mergeMissing(state.customers,seedState&&seedState.customers,'name');
  state.seq=Math.max(Number(state.seq)||0,Number(seedState&&seedState.seq)||0);
  state.posDemoDataVersion=POS_DEMO_DATA_VERSION;
