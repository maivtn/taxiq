const DIALOG_BACKGROUND_IDS=['notif','userMenu'];
const DIALOG_FOCUSABLE='a[href],button:not([disabled]),input:not([disabled]):not([type="hidden"]),select:not([disabled]),textarea:not([disabled]),[tabindex]:not([tabindex="-1"])';
function prepareDialog(overlay){
  const shell=overlay.querySelector(':scope > .modal')||overlay.firstElementChild;
  if(!shell)return;
  shell.setAttribute('role','dialog');
  shell.setAttribute('aria-modal','true');
  shell.setAttribute('tabindex','-1');
  const title=shell.querySelector('h1,h2,h3');
  if(title){
    if(!title.id)title.id=`${overlay.id}-title`;
    shell.setAttribute('aria-labelledby',title.id);
    shell.removeAttribute('aria-label');
  }else{
    shell.setAttribute('aria-label','Nexora Touch dialog');
  }
  const description=shell.querySelector('.m-head .sub,.checkin-hero .sub,.profile-hero .sub,.detail-hero .sub,.menu-modal-hero .sub');
  if(description){
    if(!description.id)description.id=`${overlay.id}-description`;
    shell.setAttribute('aria-describedby',description.id);
  }else{
    shell.removeAttribute('aria-describedby');
  }
  overlay.querySelectorAll('button.x').forEach(button=>{
    button.type='button';
    button.setAttribute('aria-label','Đóng');
  });
}
function dialogFocusable(overlay){
  return [...overlay.querySelectorAll(DIALOG_FOCUSABLE)].filter(element=>{
    const style=getComputedStyle(element);
    return !element.closest('[inert]')&&style.display!=='none'&&style.visibility!=='hidden';
  });
}
function focusDialog(overlay){
  const shell=overlay.querySelector(':scope > .modal')||overlay.firstElementChild;
  if(!shell)return;
  const focusable=dialogFocusable(overlay);
  const target=overlay.querySelector('[autofocus]')||focusable[0]||shell;
  target.focus({preventScroll:true});
}
function trapDialogFocus(event,overlay){
  const focusable=dialogFocusable(overlay);
  const shell=overlay.querySelector(':scope > .modal')||overlay.firstElementChild;
  if(!focusable.length){
    event.preventDefault();
    if(shell)shell.focus({preventScroll:true});
    return;
  }
  const first=focusable[0];
  const last=focusable[focusable.length-1];
  if(event.shiftKey&&(document.activeElement===first||!overlay.contains(document.activeElement))){
    event.preventDefault();
    last.focus();
  }else if(!event.shiftKey&&(document.activeElement===last||!overlay.contains(document.activeElement))){
    event.preventDefault();
    first.focus();
  }
}
const MODAL_BASE_Z=200;
function nextModalZIndex(modal){
  return [...document.querySelectorAll('.overlay.on')]
    .filter(open=>open!==modal)
    .reduce((top,open)=>Math.max(top,parseInt(getComputedStyle(open).zIndex,10)||MODAL_BASE_Z),MODAL_BASE_Z)+10;
}
function topOpenModal(){
  return [...document.querySelectorAll('.overlay.on')]
    .sort((a,b)=>(parseInt(getComputedStyle(a).zIndex,10)||MODAL_BASE_Z)-(parseInt(getComputedStyle(b).zIndex,10)||MODAL_BASE_Z))
    .pop()||null;
}
function syncDialogState(){
  const top=topOpenModal();
  const hasOpen=Boolean(top);
  document.querySelectorAll('#app > :not(.pos-workspace-dialogs)').forEach(element=>{
    element.inert=hasOpen;
  });
  DIALOG_BACKGROUND_IDS.forEach(id=>{
    const element=$(id);
    if(element)element.inert=hasOpen;
  });
  document.querySelectorAll('.overlay').forEach(overlay=>{
    const visible=overlay.classList.contains('on');
    overlay.setAttribute('aria-hidden',visible?'false':'true');
    overlay.inert=!visible||(hasOpen&&overlay!==top);
  });
  document.body.classList.toggle('modal-open',hasOpen);
}
function restoreDialogFocus(modal){
  const trigger=dialogReturnFocus.get(modal);
  dialogReturnFocus.delete(modal);
  requestAnimationFrame(()=>{
    const top=topOpenModal();
    if(trigger&&trigger.isConnected&&!trigger.closest('[inert]'))trigger.focus({preventScroll:true});
    else if(top)focusDialog(top);
  });
}
