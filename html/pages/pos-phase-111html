/* ---------- Staff Form: Add/Edit tách khỏi màn View ---------- */
let sfMode='add', sfTarget=null;
let sfDirty=false, sfCurrentTab='profile', sfRole='Technician';
const initials = n => n.split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase();
function clearToast(){
  clearTimeout(toast._t);
  toast._t=null;
  const el=$('toast');
  if(!el)return;
  el.classList.remove('on');
  el.textContent='';
}
function toast(msg){
  clearToast();
  const el=$('toast');
  el.textContent=msg;
  el.classList.add('on');
  toast._t=setTimeout(clearToast,5000);
}
function fmtPhone(el){
  const d=el.value.replace(/\D/g,'').slice(0,10);
  el.value = d.length>6 ? `(${d.slice(0,3)}) ${d.slice(3,6)}-${d.slice(6)}`
           : d.length>3 ? `(${d.slice(0,3)}) ${d.slice(3)}`
           : d.length>0 ? `(${d}` : '';
}
function sfOpen(mode,target){
  if(!needRole('Owner','Manager'))return;
  sfMode=mode; sfTarget=(target==null)?null:target;
  $('sf-pick').style.display=mode==='add'?'block':'none';
  $('sf-title').textContent={add:'Thêm Thợ',edit:'Chỉnh sửa thợ'}[mode];
  $('sf-sub').textContent = sfTarget!=null ? staff[sfTarget].name : 'Chọn từ danh sách hoặc tự nhập mới';
  $('sf-search').value = sfTarget!=null ? staff[sfTarget].name : '';
  $('sf-menu').classList.remove('on');
  if(sfTarget!=null) sfFill(staff[sfTarget]); else sfBlank();
  sfDirty=false; sfUpdateDirty(); sfSetTab('profile');
  updateStaffFormAction();
  openM('m-staffform');
  setTimeout(()=>$('sf-name').focus(),60); /* focus ô Tên thợ */
}
function sfAdd(){ sfOpen('add',null); }
function sfEdit(i){ sfOpen('edit',i); }
function sfView(i){ openStaff(i); }
function sfSetTab(tab){
  sfCurrentTab=tab;
  document.querySelectorAll('[data-staff-form-tab]').forEach(button=>{ const on=button.dataset.staffFormTab===tab; button.classList.toggle('active',on); button.setAttribute('aria-selected',on?'true':'false'); });
  document.querySelectorAll('[data-staff-form-pane]').forEach(pane=>pane.classList.toggle('active',pane.dataset.staffFormPane===tab));
  refreshIcons();
}
function sfUpdateDirty(){ const indicator=$('sf-unsaved'); if(indicator)indicator.classList.toggle('on',sfDirty); }
function staffFormValidation(){
  const name=$('sf-name').value.trim();
  const digits=$('sf-phone').value.replace(/\D/g,'');
  const services=svcSelected();
  const commission=parseFloat($('sf-comm').value);
  if(!name)return {valid:false,hint:'Nhập tên thợ.',tab:'profile',field:'sf-name'};
  if(digits.length!==10)return {valid:false,hint:'Nhập số điện thoại Mỹ gồm 10 số.',tab:'profile',field:'sf-phone'};
  if(!sfRole)return {valid:false,hint:'Chọn một role cho staff.',tab:'profile',field:null};
  if(!services.length)return {valid:false,hint:'Chọn ít nhất một service.',tab:'services',field:null};
  if(!Number.isFinite(commission)||commission<0||commission>100)return {valid:false,hint:'Commission phải từ 0 đến 100%.',tab:'compensation',field:'sf-comm'};
  return {valid:true,hint:'Đã đủ thông tin bắt buộc.',tab:null,field:null};
}
function updateStaffFormAction(){
  const button=$('sf-save'), hint=$('sf-action-hint');
  if(!button||!hint)return;
  const state=staffFormValidation();
  button.disabled=!state.valid;
  hint.textContent=state.hint;
  hint.classList.toggle('ready',state.valid);
}
function sfMarkDirty(event){
  updateStaffFormAction();
  if(!$('m-staffform').classList.contains('on')||(event&&event.target&&event.target.id==='sf-search'))return;
  sfDirty=true; sfUpdateDirty();
}
function sfClose(force=false){
  if(sfDirty&&!force){
    confirmModal('Unsaved changes','Các thay đổi của staff chưa được lưu. Rời Edit và bỏ thay đổi?',()=>{ sfDirty=false; sfUpdateDirty(); closeM('m-staffform'); },{okText:'Discard changes',danger:true});
    return;
  }
  sfDirty=false; sfUpdateDirty(); closeM('m-staffform');
}
