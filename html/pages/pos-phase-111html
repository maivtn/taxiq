function log(t,msg){ t.timeline.push(nowStr()+' — '+msg); }
function keepTodayOrderVisible(o){
  const nextStatus=orderStatus(o);
  if(!todayOrderMatchesView(o))todayView=({inservice:'inservice',ready:'ready',closed:'closed'}[nextStatus]||'attention');
  renderAll();
  return nextStatus;
}
function startTicket(id){
  const t=byId(id); if(!t)return;
  const o=orderById(t.orderId);
  t.status='inservice';
  log(t,'Started by '+(t.staff||'Front Desk'));
  oLog(o,'Ticket '+t.id+' start → order In Service');
  keepTodayOrderVisible(o);
  toast('Đã chuyển sang In Service. Bấm Done khi dịch vụ xong.');
}
function doneTicket(id){
  const t=byId(id); if(!t)return;
  t.status='done'; log(t,'Done — chờ các ticket khác của order');
  const o=orderById(t.orderId);
  const nextStatus=orderStatus(o);
  if(nextStatus==='ready')oLog(o,'Tất cả ticket Done — order Ready to Pay');
  keepTodayOrderVisible(o);
  if(nextStatus==='ready')toast('Dịch vụ đã xong. Order '+o.id+' đang chờ checkout trong Ready to Pay.');
  else toast('Dịch vụ xong. Order '+o.id+' vẫn ở In Service để chờ thợ khác.');
}
function voidTicket(id){
  if(!needRole('Manager','Owner'))return;
  promptModal('Hủy ticket','Nhập lý do hủy ticket '+id+'. Dịch vụ trong ticket sẽ trả về "chưa gán thợ" của order; turn của thợ được hoàn lại.',{
    label:'Lý do hủy *',required:true,error:'Vui lòng nhập lý do hủy ticket.',okText:'Void ticket'
  },reason=>{
    const t=byId(id);
    if(!t)return false;
    const o=orderById(t.orderId);
    o.unassigned.push(...t.services);           /* Rule 42: dịch vụ về unassigned */
    const s=staff.find(x=>x.short===t.staff); if(s)s.turn=Math.max(0,s.turn-1); /* hoàn turn */
    t.status='void'; t.voidReason=reason; log(t,'Void — '+reason);
    oLog(o,'Ticket '+t.id+' void ('+reason+') — dịch vụ trả về chưa gán, hoàn turn '+(t.staff||''));
    renderAll();
  });
}
function voidOrder(id){
  if(!needRole('Manager','Owner'))return;
  promptModal('Hủy order','Nhập lý do hủy order '+id+'. Toàn bộ ticket con sẽ bị void.',{
    label:'Lý do hủy *',required:true,error:'Vui lòng nhập lý do hủy order.',okText:'Void',danger:true
  },reason=>{
    const auditReason=String(reason||'').trim();
    if(!auditReason){ $('dlg-error').textContent='Vui lòng nhập lý do hủy order.'; return false; }
    const o=orderById(id); if(!o)return false;
    o.voided=true; o.voidReason=auditReason; oLog(o,'Order void — '+auditReason);
    tickets.filter(t=>t.orderId===id&&!['void','closed'].includes(t.status)).forEach(t=>{
      const s=staff.find(x=>x.short===t.staff); if(s)s.turn=Math.max(0,s.turn-1);
      t.status='void'; t.voidReason=auditReason; log(t,'Void theo order — '+auditReason);
    });
    renderAll();
  });
}

