let bkCustomFrom = '', bkCustomTo = '';
function startOfToday(){ const d=new Date(); d.setHours(0,0,0,0); return d; }
function localDateKey(date){
  return `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`;
}
function shiftedDateKey(days){
  const date=startOfToday();
  date.setDate(date.getDate()+days);
  return localDateKey(date);
}
function defaultRangeFrom(){ return shiftedDateKey(-7); }
function defaultRangeTo(){ return shiftedDateKey(0); }
function ensureCustomRanges(){
  if(!histCustomFrom)histCustomFrom=defaultRangeFrom();
  if(!histCustomTo)histCustomTo=defaultRangeTo();
  if(!orderCustomFrom)orderCustomFrom=defaultRangeFrom();
  if(!orderCustomTo)orderCustomTo=defaultRangeTo();
  if(!bkCustomFrom)bkCustomFrom=shiftedDateKey(0);
  if(!bkCustomTo)bkCustomTo=shiftedDateKey(7);
}
function dateBetween(value,from,to){
  if(!value||!from||!to)return false;
  const start=from<=to?from:to;
  const end=from<=to?to:from;
  return value>=start&&value<=end;
}
function dateRangeLabel(from,to){
  if(!from||!to)return 'From - To';
  const compact=v=>v.slice(5).replace('-','/');
  return `${compact(from)} - ${compact(to)}`;
}
function bookingDateValue(value){
  const raw=String(value||'').trim();
  if(raw==='Hôm nay')return shiftedDateKey(0);
  if(raw==='Ngày mai')return shiftedDateKey(1);
  if(/^\d{4}-\d{2}-\d{2}$/.test(raw))return raw;
  return '';
}
function bookingDateDisplay(value){
  const kind=bookingDateKind(value);
  if(kind==='today')return posT('date.today');
  if(kind==='tomorrow')return posT('date.tomorrow');
  return value;
}
function bookingDateKind(value){
  const raw=String(value||'').trim();
  if(raw==='Hôm nay')return 'today';
  if(raw==='Ngày mai')return 'tomorrow';
  const normalized=bookingDateValue(raw);
  if(normalized){
    const date=new Date(normalized+'T00:00:00');
    if(Number.isNaN(date.getTime()))return 'other';
    const diff=Math.round((date-startOfToday())/86400000);
    if(diff===0)return 'today';
    if(diff===1)return 'tomorrow';
    if(diff>=0&&diff<=7)return 'next7';
  }
  return 'other';
}
function orderDateValue(order){
  if(order&&/^\d{4}-\d{2}-\d{2}$/.test(order.dateKey||''))return order.dateKey;
  if(order&&Number.isFinite(order.daysAgo))return shiftedDateKey(-order.daysAgo);
  return shiftedDateKey(0);
}
function orderMatchesDateFilter(order){
  if(orderDateFilter==='all')return true;
  if(orderDateFilter==='custom')return dateBetween(orderDateValue(order),orderCustomFrom,orderCustomTo);
  if(orderDateFilter==='today')return orderDateValue(order)===shiftedDateKey(0);
  if(orderDateFilter==='week')return dateBetween(orderDateValue(order),defaultRangeFrom(),defaultRangeTo());
  return true;
}
function bookingMatchesDateFilter(b){
  const kind=bookingDateKind(b.date);
  if(bkDateFilter==='all')return true;
  if(bkDateFilter==='custom')return dateBetween(bookingDateValue(b.date),bkCustomFrom,bkCustomTo);
  if(bkDateFilter==='next7')return kind==='today'||kind==='tomorrow'||kind==='next7';
  return kind===bkDateFilter;
}
