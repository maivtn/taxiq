/* ================= REPORT ================= */
function exportCSV(){
  const rows=[['order','customer','items','techs','status','total','tip','method'],
    ...orders.map(o=>[o.id,o.customer,
      oTickets(o).flatMap(t=>t.services.map(s=>s.name)).concat(o.products.map(p=>p.name)).join('+'),
      [...new Set(oTickets(o).map(t=>t.staff))].join('+'),
      orderStatus(o),oTotal(o).toFixed(2),(o.tip||0).toFixed(2),o.method||''])];
  const blob=new Blob([rows.map(r=>r.join(',')).join('\n')],{type:'text/csv'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='nexora-daily-report.csv'; a.click();
}
/* #2: Close Day có đối chiếu tiền mặt (expected vs actual + difference) trước khi chốt */
function reconUpdate(){
  const el=$('reconDiff'); if(!el)return;
  const expected=payTotals.Cash||0;
  const actual=parseFloat((($('reconActual')||{}).value||'').replace(/[^0-9.]/g,''))||0;
  const diff=+(actual-expected).toFixed(2);
  const match=Math.abs(diff)<0.005;
  el.className='recon-diff '+(match?'match':(diff>0?'over':'short'));
  el.innerHTML=`<span>${match?'Khớp / Balanced':(diff>0?'Dư / Over':'Thiếu / Short')}</span><b>${diff>0?'+':''}${fmt(diff)}</b>`;
}
function closeDay(){
  if(!needRole('Owner','Manager'))return;
  const blockers=closeDayBlockers().filter(item=>item.count>0);
  if(blockers.length)return infoModal('Close Day blocked',blockers.map(item=>item.label+': '+item.blocked).join('\n')+'\n\nMở checklist Close day readiness để đi tới từng màn xử lý.');
  const expected=payTotals.Cash||0;
  const body=`<div class="cash-recon">
      <div class="recon-line"><span>Expected cash / Dự kiến (từ tiền mặt đã thu)</span><b id="reconExp">${fmt(expected)}</b></div>
      <label class="f-label" style="margin-top:0.5rem">Actual cash count / Đếm két thực tế</label>
      <input class="f-input" id="reconActual" inputmode="decimal" value="${expected.toFixed(2)}" oninput="reconUpdate()">
      <div class="recon-diff match" id="reconDiff"></div>
    </div>`;
  formModal('Close Day — Đối chiếu tiền mặt','Đếm két và đối chiếu trước khi chốt ca.',body,()=>{
    const actual=parseFloat((($('reconActual')||{}).value||'').replace(/[^0-9.]/g,''))||0;
    const diff=+(actual-expected).toFixed(2);
    toast('Day closed — cash '+(Math.abs(diff)<0.005?'khớp':(diff>0?'dư '+fmt(diff):'thiếu '+fmt(Math.abs(diff))))+'. Daily Report đã chốt.');
  },{okText:'Close Day'});
  setTimeout(reconUpdate,0);
}

/* ================= CENTRALIZED WEB DATA SOURCE ================= */
function collectSharedState(){
  return {
    posDemoDataVersion:POS_DEMO_DATA_VERSION,
    seq, bookingSeq, proofSeq, addonSeq,
    categoryList, services, catalog, products, salonRoles, salonCfg,
    orders, tickets, bookings, customers, staff,
    baseTips, baseTipCount, payTotals,
    pendingCheckins, paymentProofs, addonRequests
  };
}
function applySharedState(st){
  if(!st) return;
  seq=st.seq??seq; bookingSeq=st.bookingSeq??bookingSeq;
  proofSeq=st.proofSeq??proofSeq; addonSeq=st.addonSeq??addonSeq;
  if(st.categoryList)categoryList=st.categoryList;
  if(st.services)services=st.services;
  if(st.catalog)catalog=st.catalog;
  if(st.products)products=st.products;
  if(st.salonRoles)salonRoles=st.salonRoles;
  if(st.salonCfg)salonCfg=st.salonCfg;
  if(st.orders)orders=st.orders;
  if(st.tickets)tickets=st.tickets;
  if(st.bookings)bookings=st.bookings;
  if(st.customers)customers.splice(0,customers.length,...st.customers); /* customers là const — thay tại chỗ */
  if(st.staff)staff.splice(0,staff.length,...st.staff); /* staff là const — thay phần tử tại chỗ */
  baseTips=st.baseTips??baseTips; baseTipCount=st.baseTipCount??baseTipCount;
  if(st.payTotals)payTotals=st.payTotals;
  if(st.pendingCheckins)pendingCheckins=st.pendingCheckins;
  if(st.paymentProofs)paymentProofs=st.paymentProofs;
  if(st.addonRequests)addonRequests=st.addonRequests;
}
let sharedRev=0, remotePending=false;
function saveSharedState(){
  if(!window.NexoraStore) return;
  const st=collectSharedState(); st.rev=sharedRev;
  sharedRev=(NexoraStore.save(st)||{}).rev||sharedRev;
}
function hydrateSharedState(){
  if(!window.NexoraStore) return;
  let st=NexoraStore.load();
  if(st){
    const migrated=migratePosDemoData(st,POS_DEMO_SEED);
    if(migrated)st=NexoraStore.save(st)||st;
    applySharedState(st); sharedRev=st.rev||0;
  }
  else { saveSharedState(); } /* lần đầu: seed từ dữ liệu khởi tạo trong file */
}
/* Tab khác ghi (kiosk check-in, staff Start/Done, app khách gửi proof) → cập nhật trực tiếp.
   Đang mở modal thì chờ đóng modal mới áp để không giật nội dung đang thao tác. */
function applyRemoteState(st){
  if(!st||typeof st.rev!=='number'||st.rev<=sharedRev) return;
  applySharedState(st); sharedRev=st.rev;
  if(document.querySelector('.overlay.on')){ remotePending=true; return; }
  renderAll();
}
if(window.NexoraStore){
  hydrateSharedState();
  NexoraStore.subscribe(applyRemoteState);
}


/* ================= POS PHASE-1 HOST ADAPTER ================= */
const POS_WORKSPACE_TABS = ['today', 'orders', 'tickets', 'booking', 'customers', 'staff', 'report', 'setup'];
const POS_SCREEN_BY_TAB = {
  today: 's-today',
  orders: 's-orders',
  tickets: 's-tickets',
  booking: 's-booking',
  customers: 's-customers',
  staff: 's-staff',
  report: 's-report',
  setup: 's-setup'
};
const WORKSPACE_SEARCH_BY_TAB={today:'searchBox',orders:'orderSearch',tickets:'histSearch',booking:'bkSearch',customers:'custMgmtSearch'};

function syncHeaderSearch(target){
  const headerSearch=$('workspaceSearch');
  if(!headerSearch)return;
  const field=$(WORKSPACE_SEARCH_BY_TAB[target]);
  headerSearch.disabled=!field;
  headerSearch.value=field?field.value:'';
  headerSearch.placeholder=posT(field?'app.search.current':'app.search.unavailable');
}
function searchCurrentWorkspace(value){
  const selected=document.querySelector('[data-tab-target].is-active');
  const field=$(WORKSPACE_SEARCH_BY_TAB[selected&&selected.dataset.tabTarget]);
  if(!field)return;
  field.value=value;
  field.dispatchEvent(new Event('input',{bubbles:true}));
}

function getValidMainTab(target) {
  return POS_WORKSPACE_TABS.includes(target) ? target : 'today';
}

function syncMainTabUrl(target, mode) {
  const url = new URL(window.location.href);
  if (url.searchParams.get('tab') === target) return;
  url.searchParams.set('tab', target);
  const nextUrl = url.search + url.hash;
  const state = { tab: target };
  if (mode === 'replace') window.history.replaceState(state, '', nextUrl);
  else window.history.pushState(state, '', nextUrl);
}

function activateMainTab(target, options) {
  const activeTarget = getValidMainTab(target);
  const activeScreen = POS_SCREEN_BY_TAB[activeTarget];

  document.querySelectorAll('[data-tab-target]').forEach((tab) => {
    const isActive = tab.dataset.tabTarget === activeTarget;
    tab.classList.toggle('is-active', isActive);
    tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
  });

  document.querySelectorAll('[data-tab-panel]').forEach((panel) => {
    const isActive = panel.dataset.tabPanel === activeTarget;
    panel.classList.toggle('is-active', isActive);
    panel.classList.toggle('active', isActive);
  });
  syncHeaderSearch(activeTarget);

  if (!options || options.syncUrl !== false) {
    syncMainTabUrl(activeTarget, options && options.replaceUrl ? 'replace' : 'push');
  }

  return activeScreen;
}

function show(id, options) {
  clearToast();
  closeNotif();
  closeUserMenu();
  const tab = Object.keys(POS_SCREEN_BY_TAB).find((key) => POS_SCREEN_BY_TAB[key] === id) || 'today';
  return activateMainTab(tab, options);
}

function goTab(id, options) {
  return show(id, options);
}

function go(button) {
  return goTab(button && button.dataset ? button.dataset.s : 's-today');
}

function renderAll() {
  renderStats();
  renderPendingCheckins();
  renderPaymentProofs();
  renderAddonApprovals();
  renderChips();
  renderOrderChips();
  renderOrders();
  renderTicketChips();
  renderTable();
  renderHistory();
  renderBooking();
  renderCustomers();
  renderStaffScreen();
  renderReport();
  renderSetupLists();
  renderNotifDot();
  if($('notif').classList.contains('on'))renderNotif();
  syncOpenOrderDetail();
  refreshIcons();
  applyAppLocale();
  syncLocaleControls();
  enhanceInteractiveSurfaces();
  saveSharedState();
}

document.querySelectorAll('[data-tab-target]').forEach((tab) => {
  tab.addEventListener('click', () => activateMainTab(tab.dataset.tabTarget));
});

window.addEventListener('popstate', () => {
  const requested = new URLSearchParams(window.location.search).get('tab');
  activateMainTab(requested, { syncUrl: false });
});

const initialPosWorkspaceTab = getValidMainTab(new URLSearchParams(window.location.search).get('tab'));
applyRole();
activateMainTab(initialPosWorkspaceTab, { syncUrl: false, replaceUrl: true });
renderAll();
renderSalonPanel();
refreshIcons();

  </script>
