let curOrder=null;
function openCheckout(id){
  const o=orderById(id)||orderById((byId(id)||{}).orderId);
  if(!o)return infoModal('Không thể checkout','Không tìm thấy order.');
  if(o.unassigned.length)return infoModal('Không thể checkout','Order còn '+o.unassigned.length+' dịch vụ chưa gán thợ — Assign Tech trước (Rule 40).');
  if(orderStatus(o)!=='ready')return infoModal('Chưa Ready to Pay','Chờ tất cả ticket của order Done rồi mới checkout.');
  curOrder=o.id; tipVal=0; received=0; ratingVal=0; discountVal=o.discount||0; discountLabel=o.discountLabel||'';
  const techs=[...new Set(oTickets(o).map(t=>t.staff))];
  $('co-title').textContent='Checkout — Order '+o.id;
  $('co-sub').textContent=o.customer+' · '+techs.join(' + ');
  $('co-tiplbl').textContent='Tip cho '+techs.join(' + ')+' — optional, chia theo tỷ lệ dịch vụ';
  renderCoBill(); renderPromoRow(); renderTipRow(); updateChange(); qrRegen();
  setRating(0);
  pay(document.querySelector('#payRow [data-p="cash"]'));
  openM('m-checkout');
}
function renderCoBill(){
  const o=orderById(curOrder);
  const alloc=tipAllocation(o,tipVal);
  const disc=coDiscount(o), sub=oSubtotal(o);
  $('co-bill').innerHTML=
    oTickets(o).map(t=>t.services.map(s=>`<div class="bl item"><span>${s.name} · ${t.staff}</span><b>${fmt(s.price)}</b></div>`).join('')).join('')+
    o.products.map(p=>`<div class="bl item"><span>${iconHtml('shopping-bag')}${p.name} · product</span><b>${fmt(p.price)}</b></div>`).join('')+
    `<div class="bl math sub"><span>Subtotal</span><b>${fmt(sub)}</b></div>`+
    (disc>0?`<div class="bl math"><span style="color:var(--green)">${iconHtml('tag')}Promo ${discountLabel||''}</span><b style="color:var(--green)">−${fmt(disc)}</b></div>`:'')+
    `<div class="bl math"><span>Tax ${(TAX*100).toFixed(2)}%</span><b>${fmt(coTax(o))}</b></div>
     <div class="bl math"><span>Tip ${tipVal>0&&alloc.length>1?' <small style="color:var(--muted)">('+alloc.map(a=>a.staff+' '+fmt(a.share)).join(' · ')+' — theo tỷ lệ dịch vụ, chỉnh tay được)</small>':''}</span><b>${fmt(tipVal)}</b></div>
     <div class="bl total"><span>Total</span><b>${fmt(coTotal(o))}</b></div>`;
  if($('co-due-amt'))$('co-due-amt').textContent=fmt(coTotal(o));
  if($('co-due-sub'))$('co-due-sub').textContent=disc>0?('Đã giảm '+fmt(disc)+(tipVal>0?' · gồm tip '+fmt(tipVal):'')):(tipVal>0?('Gồm tip '+fmt(tipVal)):'Khách thanh toán');
}
function renderPromoRow(){
  const o=orderById(curOrder);
  $('promoRow').innerHTML=PROMOS.map((pr,i)=>{
    const on=(pr[1]==='none'&&discountVal===0)||(discountLabel===pr[0]&&discountVal>0);
    return `<button class="opt ${on?'active':''}" onclick="applyPromo(${i})">${pr[0]}${pr[1]==='pct'?' ('+(pr[2]*100)+'%)':''}</button>`;
  }).join('')+`<button class="opt" onclick="customPromo()">Custom $</button>`;
}
function applyPromo(i){
  const o=orderById(curOrder), pr=PROMOS[i];
  discountVal = pr[1]==='pct' ? +(oSubtotal(o)*pr[2]).toFixed(2) : pr[1]==='amt' ? pr[2] : 0;
  discountLabel = pr[1]==='none' ? '' : pr[0];
  renderCoBill(); renderPromoRow(); updateChange();
}
function customPromo(){
  const o=orderById(curOrder);
  promptModal('Custom discount','Nhập số tiền giảm cho bill hiện tại (không vượt subtotal).',{
    label:'Discount ($)',type:'number',value:'0',okText:'Apply'
  },v=>{ discountVal=Math.min(oSubtotal(o),Math.max(0,parseFloat(v)||0)); discountLabel=discountVal>0?'Custom':''; renderCoBill(); renderPromoRow(); updateChange(); });
}
function renderTipRow(){
  const o=orderById(curOrder), sub=oSvcSum(o);
  const presets=[['No Tip',0],['15%',sub*.15],['18%',sub*.18],['20%',sub*.20]];
  $('tipRow').innerHTML=presets.map(([l,v],i)=>
    `<button class="opt ${(i===0&&tipVal===0)?'active':''}" onclick="setTip(${v.toFixed(2)},this)">${l}${v?' '+fmt(v):''}</button>`).join('')+
    `<button class="opt" onclick="customTip(this)">Custom</button>`;
