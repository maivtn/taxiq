function createOrderValidation(){
  const missing=[];
  if(!draft.services.length)missing.push('Cần chọn ít nhất một service.');
  if(!draft.staff)missing.push('Cần chọn technician.');
  return {
    valid:missing.length===0,
    message:missing.length?missing.join(' '):'Đã đủ thông tin để tạo Order và Ticket.',
    target:!draft.services.length?'create-service-group':(!draft.staff?'create-staff-group':'')
  };
}
function updateCreateOrderState(){
  const state=createOrderValidation(), btn=$('createOrderBtn'), hint=$('createOrderRequirement');
  if(btn)btn.disabled=!state.valid;
  if(hint){ hint.textContent=state.message; hint.classList.toggle('ready',state.valid); }
  const serviceGroup=$('create-service-group'), staffGroup=$('create-staff-group');
  if(serviceGroup)serviceGroup.classList.toggle('has-error',!draft.services.length);
  if(staffGroup)staffGroup.classList.toggle('has-error',!draft.staff);
}
function createOrder(){ /* tạo order + ticket đầu tiên cho thợ đã chọn (đường tắt walk-in một thợ) */
