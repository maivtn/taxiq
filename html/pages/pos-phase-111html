function reportLedger(){
  const closedOrders=orders.filter(o=>o.closed&&o.id!=='#098');
  const round=n=>+n.toFixed(2);
  const grossSales=round(REPORT_BASELINE.grossSales+closedOrders.reduce((sum,o)=>sum+oSubtotal(o),0));
  const discounts=round(REPORT_BASELINE.discounts+closedOrders.reduce((sum,o)=>sum+oDiscount(o),0));
  const netSales=round(grossSales-discounts);
  const tax=round(REPORT_BASELINE.tax+closedOrders.reduce((sum,o)=>sum+oTax(o),0));
  const tips=round(REPORT_BASELINE.tips+baseTips);
  const payments=round(Object.values(payTotals).reduce((sum,value)=>sum+value,0));
  const expectedPayments=round(netSales+tax+tips);
  return {
    grossSales,discounts,netSales,tax,tips,payments,expectedPayments,
    difference:round(payments-expectedPayments),
    paid:REPORT_BASELINE.paidOrders+closedOrders.length,
    tipOrders:REPORT_BASELINE.tipOrders+baseTipCount
  };
}
