  promptModal('Tax rate','Nhập tax rate áp dụng cho bill.',{
    label:'Tax rate (%)',type:'number',value:'8.25',okText:'Save tax'
  },v=>{ if(v)$('su-tax').innerHTML=parseFloat(v)+'% '+iconHtml('pencil','icon-inline trailing'); refreshIcons(); });
