function renderSplit(){
  const o=orderById(spOrder); if(!o)return;
  const canAssign=!o.closed&&!o.voided&&o.unassigned.length>0;
  const isLocked=o.closed||o.voided;
  $('sp-summary').innerHTML=renderOrderSummary(o);
  $('sp-assign-panel').classList.toggle('is-complete',!canAssign);
  $('sp-unassigned').innerHTML=canAssign?o.unassigned.map(renderOrderServiceCard).join('')
    :`<div class="assignment-empty-card">${iconHtml(isLocked?'lock-keyhole':'circle-check','icon-inline')}<div><b>${isLocked?'Order không còn thao tác phân công':'All services are assigned'}</b><span>${isLocked?'Xem T1/T2 và chi tiết dịch vụ ở danh sách bên phải.':'Review the tickets on the right, then checkout when every ticket is Done.'}</span></div></div>`;
