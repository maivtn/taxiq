  if(!state.valid){
    updateCreateOrderState();
    const target=$(state.target); if(target)target.scrollIntoView({behavior:'smooth',block:'center'});
    return;
  }
	  const stShort=draft.staff==='__next'?recommendedStaffForServices(draft.services,{clockedOnly:true}).short:draft.staff;
  const s=staff.find(x=>x.short===stShort); s.turn++;
	  const id='#'+seq++;
	  const o=O(id,draft.customer,nowStr(),{note:$('draftNote').value,products:[...draft.products]});
  const t=T(o,[...draft.services],stShort,'waiting');
  log(t,'Assigned to '+stShort+' (turn +1)');
  oLog(o,'Order tạo tại quầy — 1 ticket cho '+stShort+(draft.products.length?' · '+draft.products.length+' product':''));
  oLog(o,'Ticket QR generated');
  orders.sort((a,b)=>a.id===id?-1:b.id===id?1:0);
