/* Thợ có thể làm: tất cả dịch vụ tiệm / trọn một category / từng service lẻ */
function svcSummary(list){
  list=list||[];
  const all=allSvcNames();
  if(all.length&&all.every(n=>list.includes(n)))return 'Tất cả dịch vụ';
  const parts=[];
  Object.keys(catalog).forEach(c=>{
    const names=catSvcNames(c);
    if(names.length&&names.every(n=>list.includes(n)))parts.push('Cả nhóm '+c);
    else parts.push(...names.filter(n=>list.includes(n)));
  });
  return parts.join(', ')||'—';
}
function renderSvcChecks(sel){
  const all=allSvcNames();
  const allOn=all.length&&all.every(n=>sel.includes(n));
  $('sf-svcs').innerHTML=
    `<label class="svc-chk all ${allOn?'on':''}"><input type="checkbox" ${allOn?'checked':''} onchange="svcAll(this.checked)"> Tất cả dịch vụ của tiệm</label>`+
    Object.keys(catalog).map((c,ci)=>{
      const names=catSvcNames(c);
      const catOn=names.length&&names.every(n=>sel.includes(n));
      return `<div class="svc-cat">
        <label class="svc-chk cat ${catOn?'on':''}"><input type="checkbox" ${catOn?'checked':''} onchange="svcCat(${ci},this.checked)"> Cả nhóm ${c}</label>
        <div class="svc-list">${catalog[c].map(s=>
          `<label class="svc-chk ${sel.includes(s.name)?'on':''}"><input type="checkbox" value="${s.name}" ${sel.includes(s.name)?'checked':''} onchange="svcOne()"> ${s.name}</label>`).join('')}</div>
      </div>`;
    }).join('');
  updateStaffFormAction();
}
function svcSelected(){ return [...document.querySelectorAll('#sf-svcs input[value]')].filter(c=>c.checked).map(c=>c.value); }
function svcAll(on){ renderSvcChecks(on?allSvcNames():[]); }
function svcCat(ci,on){
  const names=catSvcNames(Object.keys(catalog)[ci]);
  let sel=svcSelected().filter(n=>!names.includes(n));
  if(on)sel=sel.concat(names);
  renderSvcChecks(sel);
}
function svcOne(){ renderSvcChecks(svcSelected()); }
function comboFilter(){
  const q=$('sf-search').value.toLowerCase();
  const items=staff.map((s,i)=>({s,i})).filter(x=>
    !q||(x.s.name+' '+x.s.phone+' '+x.s.email+' '+(x.s.services||[]).join(' ')).toLowerCase().includes(q));
  $('sf-menu').innerHTML=items.length?items.map(x=>`
    <div class="combo-item" onclick="sfPick(${x.i})">
      <div class="combo-avatar">${initials(x.s.name)}</div>
      <div><b>${x.s.name}</b> · ${x.s.phone}<br><small style="color:var(--muted)">${svcSummary(x.s.services)}</small></div>
    </div>`).join(''):'<div class="combo-empty">Không tìm thấy thợ phù hợp.</div>';
  $('sf-menu').classList.add('on');
  enhanceInteractiveSurfaces($('sf-menu'));
}
