function servicePickerConfig(scope){
  const booking=scope==='booking';
  return booking
    ?{state:bDraft,input:'bkServiceSearch',suggestions:'bkServiceSuggestions',selected:'bkSelectedServiceList',count:'bkSelectedServiceCount'}
    :{state:draft,input:'serviceSearch',suggestions:'serviceSuggestions',selected:'selectedServiceList',count:'selectedServiceCount'};
}
function openServiceSuggestions(scope){
  const cfg=servicePickerConfig(scope), input=$(cfg.input), suggestions=$(cfg.suggestions), query=servicePickerQuery(scope);
  if(!query){ renderServicePicker(scope); closeServiceSuggestions(scope); return; }
  closeAllServiceSuggestions();
  renderServicePicker(scope);
  if(suggestions)suggestions.classList.add('on');
  if(input)input.setAttribute('aria-expanded','true');
}
function closeServiceSuggestions(scope){
  const cfg=servicePickerConfig(scope), input=$(cfg.input), suggestions=$(cfg.suggestions);
  if(suggestions)suggestions.classList.remove('on');
  if(input)input.setAttribute('aria-expanded','false');
}
function closeAllServiceSuggestions(){
  ['draft','booking'].forEach(closeServiceSuggestions);
}
function servicePickerQuery(scope){
  const cfg=servicePickerConfig(scope), input=$(cfg.input);
  return (input&&input.value||'').trim().toLowerCase();
}
function serviceCategorySummary(svc){
  return (svc.cats&&svc.cats.length?svc.cats.join(' · '):'Salon service')+(svc.dur?' · '+svc.dur+' min':'');
}
function servicePickerSuggestions(scope){
  const q=servicePickerQuery(scope);
  return services
    .filter(s=>!q||(s.name+' '+(s.cats||[]).join(' ')+' '+(s.dur||'')).toLowerCase().includes(q))
    .sort((a,b)=>a.name.localeCompare(b.name));
}
function renderServicePicker(scope){
  const cfg=servicePickerConfig(scope);
  const suggestions=$(cfg.suggestions), selected=$(cfg.selected), count=$(cfg.count);
  if(!suggestions||!selected)return;
  const list=servicePickerSuggestions(scope);
  const pickedNames=new Set((cfg.state.services||[]).map(s=>s.name));
  suggestions.innerHTML=list.length?list.slice(0,40).map((s,i)=>{
    const isPicked=pickedNames.has(s.name);
    return `<button class="service-suggestion ${isPicked?'active':''}" type="button" role="option" aria-selected="${isPicked?'true':'false'}" onclick="toggleServiceFromPicker('${scope}',${i})">
      <span><b class="service-suggestion-name">${safeText(s.name)}</b><span class="service-suggestion-detail">${safeText(serviceCategorySummary(s))}</span></span>
      <span class="service-suggestion-side"><strong class="service-suggestion-price">${fmt(s.price)}</strong><span class="service-suggestion-toggle">${iconHtml(isPicked?'check':'plus','icon-only')}</span></span>
    </button>`;
  }).join(''):`<div class="service-suggestion-empty">Không tìm thấy dịch vụ phù hợp. Thử tìm theo tên hoặc category.</div>`;
  const picked=cfg.state.services||[];
  if(count)count.textContent=picked.length+' selected';
  selected.innerHTML=picked.length?picked.map((s,i)=>{
    const full=services.find(x=>x.name===s.name)||s;
    return `<div class="selected-service-row">
      <span><b>${safeText(s.name)}</b><span>${safeText(serviceCategorySummary(full))}</span></span>
      <strong class="selected-service-price">${fmt(s.price)}</strong>
      <button class="selected-service-remove" type="button" aria-label="Remove ${safeText(s.name)}" onclick="removeServiceFromPicker('${scope}',${i})">${iconHtml('x','icon-only')}</button>
    </div>`;
  }).join(''):`<div class="selected-service-empty">Chưa chọn dịch vụ.</div>`;
  refreshIcons();
}
function refreshServicePickerDependents(scope){
  if(scope==='booking')bkRenderStaff(); else renderStaffOpts();
}
function toggleServiceFromPicker(scope,index){
  const cfg=servicePickerConfig(scope);
  const s=servicePickerSuggestions(scope)[index];
  if(!s)return;
  const existingIndex=cfg.state.services.findIndex(item=>item.name===s.name);
  if(existingIndex>=0)cfg.state.services.splice(existingIndex,1);
  else cfg.state.services.push({name:s.name,price:s.price});
  if(scope==='booking')bkShowErrors=true;
  renderServicePicker(scope);
  refreshServicePickerDependents(scope);
}
function removeServiceFromPicker(scope,index){
  const cfg=servicePickerConfig(scope);
  cfg.state.services.splice(index,1);
  if(scope==='booking')bkShowErrors=true;
  renderServicePicker(scope);
  refreshServicePickerDependents(scope);
}
function servicePickerKey(event,scope){
  if(event.key==='Escape'){
    event.preventDefault(); event.stopPropagation(); closeServiceSuggestions(scope); return;
  }
  if(event.key==='Enter'){
    event.preventDefault();
    if(!servicePickerQuery(scope))return;
    toggleServiceFromPicker(scope,0);
  }
}
