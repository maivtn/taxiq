}
function setAppLocale(locale,options={}){
  appLocale=POS_LOCALES.includes(locale)?locale:'en-US';
  try{ localStorage.setItem(POS_LOCALE_STORAGE_KEY,appLocale); }catch(error){ /* POS remains usable when storage is blocked. */ }
  renderAll();
  applyAppLocale();
  syncLocaleControls();
  if(options.announce!==false)toast(posT(appLocale==='vi-VN'?'locale.changed.vi':'locale.changed.en'));
}
function setLang(locale,btn){ setAppLocale(locale,{source:btn}); }
