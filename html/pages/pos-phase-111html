<!doctype html>
<html lang="en-US">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nexora Touch - POS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: { base: '#4648D4', hover: '#3A3BBF', active: '#2D2EAA', subtle: '#E9E9FF' },
            ink: { primary: '#0B1C30', secondary: '#64748B', muted: '#565E74' },
            canvas: '#F8FAFC', surface: '#FFFFFF', line: '#E2E8F0',
            success: '#10B981', warning: '#F59E0B', danger: '#EF4444'
          },
          borderRadius: { control: '12px', card: '14px', panel: '18px' },
          boxShadow: {
            card: '0 10px 24px rgba(11,28,48,.06)',
            panel: '0 18px 48px rgba(11,28,48,.10)',
            modal: '0 24px 64px rgba(11,28,48,.16)'
          }
        }
      }
    };
  </script>
  <style>
    :root {
      --primary-base: #4648D4;
      --primary-hover: #3A3BBF;
      --primary-active: #2D2EAA;
      --primary-subtle: #E9E9FF;
      --primary-gradient: linear-gradient(135deg, #2F63FF 0%, #7A3DF5 100%);
      --text-primary: #0B1C30;
      --text-secondary: #64748B;
      --text-muted: #565E74;
      --background-default: #F8FAFC;
      --surface-default: #FFFFFF;
      --border-default: #E2E8F0;
      --status-success: #10B981;
      --status-warning: #F59E0B;
      --status-error: #EF4444;
      --radius-control: 12px;
      --radius-card: 14px;
      --radius-panel: 18px;
      --shadow-card: 0 10px 24px rgba(11, 28, 48, 0.06);
      --shadow-panel: 0 18px 48px rgba(11, 28, 48, 0.10);
      --shadow-modal: 0 24px 64px rgba(11, 28, 48, 0.16);
      --font-body: 1rem;
      --font-meta: 0.9375rem;
      --font-section: 1.125rem;
      --font-title: 1.25rem;
      --font-display: 1.375rem;
      --font-total: 1.5rem;
      --touch-target: 52px;
      --luxury-gold: #d4af37;
      --brand-cyan: #32d7ff;
      --nexora-canvas: #f7f9fc;
      --nexora-surface: #ffffff;
      --nexora-surface-muted: #f3f6fa;
      --nexora-border: #dde5ef;
      --nexora-rule: #e7ecf3;
      --nexora-text: #0b1220;
      --nexora-muted: #4d5870;
      --nexora-subtle: #7a8296;
      --nexora-sidebar: #081f49;
      --nexora-brand: #4648d8;
      --nexora-brand-dark: #393bc8;
      --nexora-electric: #2b59ff;
      --nexora-violet: #8e4df8;
      --nexora-success: #00b873;
      --nexora-warning: #f59e0b;
      --nexora-card-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
      --nexora-soft-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -0.0625rem;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    html,
    html {
      background: var(--nexora-canvas);
      font-size: 15px; /* 1 size chính — mọi font-size khác tính theo rem của base này */
    }
    body {
      margin: 0;
      min-height: 100%;
      font-family: "Inter", sans-serif;
      background: var(--nexora-canvas);
      color: var(--nexora-text);
    }

    button,
    input,
    textarea,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }

    ::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.05);
    }

    ::-webkit-scrollbar-thumb {
      background: var(--brand-cyan);
      border-radius: 99px;
    }

    .shell {
      min-height: 100vh;
      background: var(--nexora-canvas);
    }

    .sidebar {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 30;
      display: none;
      width: 18rem; /* = .app-area padding-left; keep in sync */
      flex-direction: column;
      background: var(--nexora-sidebar);
      color: #fff;
      padding: 1.4375rem 1rem;
    }

    .sidebar-panel {
      flex-shrink: 0;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.05);
      padding: 0.8125rem;
    }

    .profile-row {
      display: flex;
      min-width: 0;
      align-items: center;
      gap: 0.625rem;
    }

    .avatar {
      display: inline-flex;
      width: 40px;
      height: 40px;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--nexora-electric), var(--nexora-violet));
      color: #fff;
      font-size: 1rem;
      font-weight: 800;
      text-transform: uppercase;
    }

    .profile-name {
      overflow: hidden;
      color: #fff;
      font-size: 1.0625rem;
      font-weight: 700;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .profile-email {
      margin-top: 0.125rem;
      overflow: hidden;
      color: rgba(255, 255, 255, 0.6);
      font-size: 0.875rem;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .plan-panel {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.625rem;
      margin-top: 0.625rem;
      padding: 0.5rem 0.625rem;
    }

    .plan-copy {
      min-width: 0;
    }

    .panel-kicker {
      color: rgba(255, 255, 255, 0.45);
      font-size: 0.875rem;
      font-weight: 700;
      letter-spacing: normal;
      text-transform: none;
    }

    .panel-title {
      margin-top: 0.125rem;
      color: #fff;
      font-size: 1rem;
      font-weight: 800;
    }

    .plan-button {
      flex-shrink: 0;
      width: auto;
      margin-top: 0;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 8px;
      background: transparent;
      padding: 0.3125rem 0.4375rem;
      color: var(--luxury-gold);
      font-size: 0.9375rem;
      font-weight: 700;
      transition: background 0.2s, border-color 0.2s;
    }

    .plan-button:hover {
      border-color: rgba(255, 255, 255, 0.25);
      background: rgba(255, 255, 255, 0.05);
    }

    .sidebar-nav {
      margin-top: 1.25rem;
      flex: 1;
      overflow-y: auto;
      padding-right: 0.1875rem;
    }

    .nav-divider {
      margin: 0.1875rem 0;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .nav-item {
      display: flex;
      width: 100%;
      height: 48px;
      align-items: center;
      gap: 0.625rem;
      border: 0;
      border-radius: 8px;
      background: transparent;
      padding: 0 0.8125rem;
      color: rgba(255, 255, 255, 0.85);
      text-align: left;
      font-size: 1.0625rem;
      font-weight: 700;
      transition: background 0.2s, color 0.2s, box-shadow 0.2s;
    }

    .nav-item:hover {
      background: rgba(255, 255, 255, 0.05);
      color: #fff;
    }

    .nav-item.is-active {
      background: linear-gradient(90deg, var(--nexora-electric), var(--nexora-violet));
      color: #fff;
      box-shadow: 0 10px 24px rgba(43, 89, 255, 0.2);
    }

    .sidebar-icon-wrap {
      display: inline-flex;
      width: 36px;
      height: 36px;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
    }

    .sidebar-icon {
      width: 28px;
      height: 28px;
      object-fit: contain;
      filter: brightness(1.15) saturate(1.2) contrast(1.05)
        drop-shadow(0 0 3px rgba(255, 66, 215, 0.3))
        drop-shadow(0 0 6px rgba(50, 215, 255, 0.2));
      transition: filter 0.2s, transform 0.2s;
    }

    .nav-item:hover .sidebar-icon,
    .nav-item.is-active .sidebar-icon {
      filter: brightness(1.3) saturate(1.35) contrast(1.1)
        drop-shadow(0 0 4px rgba(255, 66, 215, 0.45))
        drop-shadow(0 0 8px rgba(50, 215, 255, 0.35))
        drop-shadow(0 0 12px rgba(138, 92, 255, 0.25));
      transform: scale(1.04);
    }

    .nav-item:hover .sidebar-icon-wrap,
    .nav-item.is-active .sidebar-icon-wrap {
      background: radial-gradient(
        circle,
        rgba(138, 92, 255, 0.24) 0%,
        rgba(50, 215, 255, 0.08) 45%,
        transparent 72%
      );
    }

    .lucide-menu-icon {
      display: block;
      width: 28px;
      height: 28px;
      color: #fff;
      filter: drop-shadow(0 0 4px rgba(255, 66, 215, 0.32))
        drop-shadow(0 0 8px rgba(50, 215, 255, 0.24));
      transition: filter 0.2s, transform 0.2s;
    }

    .nav-item:hover .lucide-menu-icon,
    .nav-item.is-active .lucide-menu-icon {
      filter: drop-shadow(0 0 4px rgba(255, 66, 215, 0.45))
        drop-shadow(0 0 8px rgba(50, 215, 255, 0.35))
        drop-shadow(0 0 12px rgba(138, 92, 255, 0.25));
      transform: scale(1.04);
    }

    /* Sign out: nav-item màu đỏ, ngay dưới Support */
    .nav-item.nav-item-logout{color:#F87171;}
    .nav-item.nav-item-logout:hover{background:rgba(248,113,113,.14);color:#FCA5A5;}
    .nav-item-logout .lucide-menu-icon{color:#F87171;filter:drop-shadow(0 0 4px rgba(248,113,113,.3));}
    .nav-item-logout:hover .lucide-menu-icon{color:#FCA5A5;filter:drop-shadow(0 0 6px rgba(248,113,113,.45));transform:scale(1.04);}

    .lucide-menu-icon path,
    .lucide-menu-icon rect,
    .lucide-menu-icon circle,
    .lucide-menu-icon line,
    .lucide-menu-icon polyline {
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .app-area {
      min-height: 100vh;
    }

    .header {
      position: sticky;
      top: 0;
      z-index: 20;
      display: flex;
      min-height: 64px;
      align-items: center;
      justify-content: space-between;
      gap: 0.625rem;
      border-bottom: 1px solid var(--nexora-border);
      background: var(--nexora-surface);
      padding: 0 0.8125rem;
    }

    .mobile-brand {
      display: flex;
      min-width: 0;
      align-items: center;
      gap: 0.625rem;
    }

    .icon-button {
      display: inline-flex;
      width: 40px;
      height: 40px;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--nexora-border);
      border-radius: 8px;
      background: #fff;
      color: var(--nexora-text);
      box-shadow: var(--nexora-soft-shadow);
      transition: background 0.2s;
    }

    .icon-button:hover {
      background: var(--nexora-surface-muted);
    }

    .brand-logo {
      width: 36px;
      height: 36px;
      flex-shrink: 0;
      object-fit: contain;
    }

    .search {
      position: relative;
      display: none;
      width: min(100%, 385px);
    }

    .search svg {
      position: absolute;
      top: 50%;
      left: 16px;
      width: 16px;
      height: 16px;
      color: var(--nexora-muted);
      transform: translateY(-50%);
      pointer-events: none;
    }

    .search input {
      width: 100%;
      height: 44px;
      border: 1px solid transparent;
      border-radius: 999px;
      outline: 0;
      background: var(--nexora-surface-muted);
      padding: 0 0.8125rem 0 2.4375rem;
      color: var(--nexora-text);
      font-size: 1.0625rem;
    }

    .search input::placeholder {
      color: var(--nexora-subtle);
    }

    .search input:focus {
      border-color: var(--nexora-brand);
      box-shadow: 0 0 0 2px rgba(70, 72, 216, 0.2);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .dev-reset-button {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
      justify-content: center;
      gap: 0.4375rem;
      border: 1px solid #fecaca;
      border-radius: var(--radius-control);
      background: #fff7f7;
      padding: 0 0.6875rem;
      color: #b91c1c;
      font-size: 1rem;
      font-weight: 800;
      white-space: nowrap;
    }

    .dev-reset-button:hover {
      border-color: var(--status-error);
      background: #fef2f2;
    }

    .dev-reset-button svg {
      width: 19px;
      height: 19px;
      flex: 0 0 19px;
    }

    @media (max-width: 720px) {
      .dev-reset-button {
        width: 44px;
        padding: 0;
      }

      .dev-reset-button span {
        display: none;
      }
    }

    .notification-button {
      position: relative;
    }

    .notification-dot {
      position: absolute;
      top: 8px;
      right: 8px;
      width: 8px;
      height: 8px;
      border: 2px solid #fff;
      border-radius: 999px;
      background: #ef4444;
    }

    .profile-button {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      border: 1px solid var(--nexora-border);
      border-radius: 999px;
      background: #fff;
      padding: 0.25rem 0.5rem 0.25rem 0.25rem;
      box-shadow: var(--nexora-soft-shadow);
    }

    .profile-button .avatar {
      width: 32px;
      height: 32px;
      font-size: 0.9375rem;
    }

    .profile-copy {
      display: none;
      text-align: left;
    }

    .profile-copy strong {
      display: block;
      color: var(--nexora-text);
      font-size: 1rem;
      line-height: 1.2;
    }

    .profile-copy span {
      color: var(--nexora-subtle);
      font-size: 0.875rem;
    }

    .content {
      min-height: calc(100vh - 64px);
      padding: 0.8125rem 0.8125rem 4.9375rem;
    }

    .blank-stage {
      min-height: calc(100vh - 176px);
    }

    .page-heading {
      margin-bottom: 1.25rem;
    }

    .page-title {
      margin: 0;
      color: var(--nexora-text);
      font-size: 1.375rem;
      font-weight: 800;
      line-height: 32px;
      letter-spacing: normal;
    }

    .page-description {
      margin: 0.4375rem 0 0;
      color: var(--nexora-muted);
      font-size: 1.0625rem;
      font-weight: 500;
      line-height: 20px;
    }

    .page-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1rem;
    }

    .page-tab {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
      gap: 0.5rem;
      border: 1px solid var(--nexora-border);
      border-radius: 12px;
      background: var(--nexora-surface);
      padding: 0.4375rem 0.6875rem 0.4375rem 0.5rem;
      color: var(--nexora-muted);
      font-size: 1rem;
      font-weight: 800;
      box-shadow: var(--nexora-card-shadow);
      transition: background 0.2s, border-color 0.2s, color 0.2s, box-shadow 0.2s, transform 0.2s;
    }

    .page-tab:hover {
      border-color: rgba(70, 72, 216, 0.35);
      background: #fff;
      color: var(--nexora-text);
      transform: translateY(-1px);
    }

    .page-tab.is-active {
      border-color: transparent;
      background: linear-gradient(90deg, var(--nexora-electric), var(--nexora-violet));
      color: #fff;
      box-shadow: 0 12px 26px rgba(43, 89, 255, 0.22);
    }

    .page-tab-icon {
      display: inline-flex;
      width: 28px;
      height: 28px;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
      border-radius: 9px;
      background: var(--nexora-surface-muted);
      color: var(--nexora-brand);
    }

    .page-tab.is-active .page-tab-icon {
      background: rgba(255, 255, 255, 0.18);
      color: #fff;
    }

    .page-tab svg {
      width: 17px;
      height: 17px;
    }

    .page-tab .bi {
      font-size: 1.1875rem;
      line-height: 1;
    }

    .page-tab svg path,
    .page-tab svg rect {
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .page-tab svg.bi path {
      fill: currentColor;
      stroke: none;
    }

    @media (max-width: 767px) {
      .page-tabs {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.1875rem;
        margin-top: 0.6875rem;
      }

      .page-tab {
        width: 100%;
        min-width: 0;
        min-height: 48px;
        flex-direction: column;
        justify-content: center;
        gap: 0.125rem;
        border-radius: 10px;
        padding: 0.25rem 0.125rem;
        font-size: 0.875rem;
        line-height: 1.12;
        text-align: center;
        box-shadow: none;
      }

      .page-tab-icon {
        width: 20px;
        height: 20px;
        border-radius: 7px;
      }

      .page-tab svg {
        width: 13px;
        height: 13px;
      }

      .page-tab .bi {
        font-size: 1rem;
      }

      .page-tab > span:last-child {
        display: block;
        max-width: 100%;
        overflow-wrap: anywhere;
      }
    }

    @media (max-width: 380px) {
      .page-tab {
        min-height: 46px;
        font-size: 0.875rem;
      }

      .page-tab-icon {
        width: 18px;
        height: 18px;
      }
    }

    .tab-content {
      margin-top: 1.25rem;
    }

    .tab-panel,
    .sub-panel {
      display: none;
    }

    .tab-panel.is-active,
    .sub-panel.is-active {
      display: block;
    }

    .placeholder-panel {
      display: grid;
      min-height: 280px;
      place-items: center;
      border: 1px dashed var(--nexora-border);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.72);
      color: var(--nexora-muted);
      text-align: center;
      box-shadow: var(--nexora-card-shadow);
    }

    .placeholder-panel h2 {
      margin: 0;
      color: var(--nexora-text);
      font-size: 1.1875rem;
      font-weight: 900;
    }

    .placeholder-panel p {
      max-width: 420px;
      margin: 0.4375rem auto 0;
      font-size: 1rem;
      font-weight: 500;
      line-height: 1.6;
    }

    .overview-toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.6875rem;
      margin-bottom: 0.9375rem;
    }

    .mode-switch {
      display: inline-flex;
      gap: 0.3125rem;
      border: 1px solid var(--nexora-border);
      border-radius: 12px;
      background: var(--nexora-surface-muted);
      padding: 0.25rem;
    }

    .mode-switch button {
      min-height: 34px;
      border: 0;
      border-radius: 9px;
      background: transparent;
      padding: 0 0.625rem;
      color: var(--nexora-muted);
      font-size: 1rem;
      font-weight: 800;
    }

    .mode-switch button.is-active {
      background: #fff;
      color: var(--nexora-brand);
      box-shadow: var(--nexora-card-shadow);
    }

    .overview-card {
      border: 1px solid var(--nexora-border);
      border-radius: 12px;
      background: var(--nexora-surface);
      box-shadow: var(--nexora-card-shadow);
    }

    .overview-card-pad {
      padding: 0.9375rem;
    }

    .overview-kpis {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.625rem;
      margin-bottom: 0.9375rem;
    }

    /* Call Log stats: 2 columns on mobile, 4 in one row on larger screens */
    .overview-kpis[data-call-stats] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (min-width: 768px) {
      .overview-kpis[data-call-stats] {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    .kpi-card {
      position: relative;
      overflow: hidden;
      padding: 0.9375rem;
    }

    .kpi-card::after {
      content: "";
      position: absolute;
      top: -18px;
      right: -18px;
      width: 82px;
      height: 82px;
      border-radius: 999px;
      background: var(--kpi-accent, var(--nexora-brand));
      opacity: 0.08;
    }

    .kpi-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.625rem;
      margin-bottom: 0.625rem;
    }

    .kpi-icon {
      display: inline-flex;
      width: 38px;
      height: 38px;
      align-items: center;
      justify-content: center;
      border-radius: 11px;
      background: color-mix(in srgb, var(--kpi-accent, var(--nexora-brand)) 12%, white);
      color: var(--kpi-accent, var(--nexora-brand));
    }

    .kpi-icon svg {
      width: 19px;
      height: 19px;
    }

    .kpi-icon .bi {
      font-size: 1.1875rem;
      line-height: 1;
    }

    .kpi-icon svg path,
    .kpi-icon svg rect,
    .kpi-icon svg circle {
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .kpi-label {
      color: var(--nexora-subtle);
      font-size: 0.875rem;
      font-weight: 900;
      letter-spacing: 0.08em;
