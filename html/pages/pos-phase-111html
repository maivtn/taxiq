/* ================= STAFF / CLOCK ================= */
function activeAssignedTickets(staffShort){
  return tickets.filter(t=>t.staff===staffShort&&['waiting','inservice'].includes(t.status));
}
function applyStaffClock(i,reopen,override){
  const s=staff[i];
  if(s.clocked){
    s.clocked=false; s.cout=nowStr();
    if(override)activeAssignedTickets(s.short).forEach(t=>log(t,'Manager override: '+s.short+' clocked out while ticket remained assigned'));
  }else{
    s.clocked=true; s.cin=nowStr(); s.cout=null;
  }
  renderAll();
  if(reopen)openStaff(i);
}
function openClockOutReview(i,reopen,assigned){
  const s=staff[i];
  const rows=assigned.map(t=>`<div class="clockout-ticket">
    <div><b>${safeText(t.id)} · ${safeText(t.customer)}</b><small>${stMap[t.status][0]} · ${t.services.map(service=>safeText(service.name)).join(' + ')}</small></div>
    <button class="act" type="button" onclick="dialogClose();openTicket('${t.id}')">Transfer ticket</button>
  </div>`).join('');
  setDialog('Clock out needs review',s.short+' còn '+assigned.length+' ticket đang gán.',{
    sub:'Transfer tickets hoặc dùng Manager override',
    extra:`<div class="recon-warn">${iconHtml('triangle-alert','icon-inline')}Clock out có thể làm ticket mất thợ đang phục vụ. Mở từng ticket để Change staff trước.</div><div class="clockout-ticket-list">${rows}</div>`
  });
  dialogAction=null; dialogAfterClose=null;
  dialogButton('Đóng','',dialogClose);
  dialogButton('Manager override','red-o',()=>{ dialogClose(); applyStaffClock(i,reopen,true); });
  refreshIcons();
}
function clockToggle(i,reopen){
  if(!needRole('Owner','Manager'))return; /* thợ tự clock trên app; trên POS chỉ Owner/Manager */
  const s=staff[i];
  if(!s.clocked){ applyStaffClock(i,reopen,false); return; }
  const assigned=activeAssignedTickets(s.short);
  if(assigned.length){ openClockOutReview(i,reopen,assigned); return; }
  confirmModal('Clock out',s.short+' không còn ticket Waiting/In Service. Clock out bây giờ?',()=>applyStaffClock(i,reopen,false),{okText:'Clock out',danger:true});
}

/* ---------- Schedule editor (dùng chung Add Staff + Edit hồ sơ) ---------- */
let schedState={};
function renderSched(cid,sched){
  schedState[cid]=sched;
  $(cid).innerHTML='<div class="sched-head"><span></span><span></span><span>Vào</span><span></span><span>Ra</span></div>'+sched.map((r,i)=>`
    <div class="sched-row ${r.on?'':'off'}">
      <b class="d">${r.d}</b>
      <label class="dayoff"><input type="checkbox" ${r.on?'':'checked'} onchange="schedToggle('${cid}',${i})"> Day off</label>
      <input type="time" class="f-input" id="${cid}-f${i}" value="${r.on?r.from:''}" ${r.on?'':'disabled'}>
      <span style="text-align:center;color:var(--muted)">–</span>
      <input type="time" class="f-input" id="${cid}-t${i}" value="${r.on?r.to:''}" ${r.on?'':'disabled'}>
    </div>`).join('');
}
function readSched(cid){
  return schedState[cid].map((r,i)=>{
    const f=$(cid+'-f'+i), t=$(cid+'-t'+i);
    return {d:r.d,on:r.on,
      from:(r.on&&f&&f.value)||r.from,
      to:(r.on&&t&&t.value)||r.to};
  });
}
function schedToggle(cid,i){
  const s=readSched(cid); s[i].on=!s[i].on; renderSched(cid,s);
}

