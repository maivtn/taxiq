  },0);
}
function bookingTimeMinutes(value){
  const raw=String(value||'').trim();
  let match=raw.match(/^(\d{1,2}):(\d{2})\s*(AM|PM)$/i);
  if(match){ let hour=Number(match[1])%12; if(match[3].toUpperCase()==='PM')hour+=12; return hour*60+Number(match[2]); }
  match=raw.match(/^(\d{1,2}):(\d{2})$/);
  return match?Number(match[1])*60+Number(match[2]):NaN;
}
function bookingIntervalsOverlap(startA,durationA,startB,durationB){ return startA<startB+durationB&&startB<startA+durationA; }
function bookingScheduleForDate(s,dateKey){
  const date=new Date(dateKey+'T12:00:00');
  const day=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][date.getDay()];
  return s.schedule.find(slot=>slot.d===day&&slot.on)||null;
}
function bookingHasConflict(s,dateKey,time,duration){
  const start=bookingTimeMinutes(time);
  return bookings.some(b=>!['cancelled','converted'].includes(b.status)&&b.staffReq===s.short&&bookingDateValue(b.date)===dateKey&&
    bookingIntervalsOverlap(start,duration,bookingTimeMinutes(b.time),bookingDurationMinutes(b.service.split(' + '))));
}
function isStaffAvailableForBooking(s,dateKey,time,selectedServices){
  if(!s||s.link!=='Active'||!dateKey||!time||!selectedServices.length)return false;
  const duration=bookingDurationMinutes(selectedServices), start=bookingTimeMinutes(time), slot=bookingScheduleForDate(s,dateKey);
  if(!slot||!Number.isFinite(start))return false;
  const withinShift=start>=bookingTimeMinutes(slot.from)&&start+duration<=bookingTimeMinutes(slot.to);
  return withinShift&&!bookingHasConflict(s,dateKey,time,duration);
}
