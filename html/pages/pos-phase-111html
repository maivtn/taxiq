function openPermissionSetup(){
  if(!needRole('Owner'))return;
  permDraft = salonRoles.map(r=>({name:r.name, desc:r.desc, builtin:r.builtin, perms:[...r.perms]}));
  renderPermRoles();
  openM('m-permission');
}
function renderPermRoles(){
  $('permError').style.display='none';
  $('permRoles').innerHTML = permDraft.map((r,i)=>{
    const head = r.builtin
      ? `<div class="perm-role-info"><b>${safeText(r.name)}</b> <span class="perm-lock">${iconHtml('lock','icon-inline')}Built-in · Full access</span><div class="perm-role-desc">${safeText(r.desc)}</div></div>`
      : `<div class="perm-role-fields">
           <input class="f-input" value="${safeText(r.name)}" placeholder="Tên role *" oninput="permDraft[${i}].name=this.value">
           <input class="f-input" value="${safeText(r.desc)}" placeholder="Mô tả (tùy chọn)" oninput="permDraft[${i}].desc=this.value">
         </div>
         <button class="act red" onclick="removeSalonRole(${i})" title="Xóa role">${iconHtml('trash-2','icon-inline')}Xóa</button>`;
    const catalog = PERMISSION_CATALOG.map(pc=>{
      const on=r.perms.includes(pc.key);
      return `<label class="perm-chk ${r.builtin?'locked':''}"><input type="checkbox" ${on?'checked':''} ${r.builtin?'disabled':''} onchange="togglePerm(${i},'${pc.key}',this.checked)"><span>${safeText(pc.label)}</span></label>`;
    }).join('');
    return `<div class="perm-role-card ${r.builtin?'locked':''}">
      <div class="perm-role-head">${head}</div>
      ${r.builtin?'':`<div class="perm-catalog">${catalog}</div>`}
    </div>`;
  }).join('');
  refreshIcons();
}
function togglePerm(i,key,on){
  const perms=permDraft[i].perms, k=perms.indexOf(key);
  if(on){ if(k<0)perms.push(key); } else if(k>=0){ perms.splice(k,1); }
}
function addSalonRole(){ permDraft.push({name:'', desc:'', builtin:false, perms:[]}); renderPermRoles(); }
function removeSalonRole(i){
  const role=permDraft[i];
  if(!role||role.builtin)return;
  if(role.name&&staff.some(member=>member.role===role.name))return permErr('Role "'+role.name+'" đang được gán cho staff. Hãy đổi role của staff trước khi xóa.');
  permDraft.splice(i,1); renderPermRoles();
}
function permErr(msg){ const e=$('permError'); e.textContent=msg; e.style.display='block'; return false; }
function savePermissionSetup(){
  const seen=['owner'];
  for(const r of permDraft){
    if(r.builtin) continue; /* Owner luôn full access, khóa */
    const nm=(r.name||'').trim();
    if(!nm) return permErr('Mỗi role cần có tên.');
    if(seen.includes(nm.toLowerCase())) return permErr('Tên role bị trùng: "'+nm+'". Tên phải là duy nhất trong salon.');
    if(!r.perms.length) return permErr('Role "'+nm+'" cần ít nhất một quyền từ catalog.');
    seen.push(nm.toLowerCase());
  }
  if(!permDraft.some(r=>r.builtin)) return permErr('Salon phải luôn có built-in Owner.');
  const draftRoleNames=new Set(permDraft.map(role=>(role.name||'').trim().toLowerCase()));
  const missingAssignedRole=staff.find(member=>member.role&&!draftRoleNames.has(member.role.toLowerCase()));
  if(missingAssignedRole)return permErr('Role "'+missingAssignedRole.role+'" đang được gán cho '+missingAssignedRole.name+'. Hãy đổi role của staff trước khi đổi tên hoặc xóa role.');
      salonRoles = permDraft.map(r=> r.builtin
        ? {name:'Owner', desc:r.desc||'Chủ tiệm — toàn quyền, không thể sửa hoặc xóa', builtin:true, perms:ALL_PERMS()}
        : {name:r.name.trim(), desc:(r.desc||'').trim(), builtin:false, perms:[...r.perms]});
      closeM('m-permission'); renderSetupLists(); renderRoleChips(); saveSharedState();
  toast('Đã lưu role & permission.');
}
function editTax(){
