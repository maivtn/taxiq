function payToggle(btn){ if(!needRole('Owner'))return; toggleSwitch(btn); }
function syncLocaleControls(){
  document.querySelectorAll('[data-locale]').forEach(button=>{
    const active=button.dataset.locale===appLocale;
    button.classList.toggle('active',active&&Boolean(button.closest('#langRow')));
