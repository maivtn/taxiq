function loadAppLocale(){
  try{
    const saved=localStorage.getItem(POS_LOCALE_STORAGE_KEY);
    return POS_LOCALES.includes(saved)?saved:'en-US';
  }catch(error){ return 'en-US'; }
}
let appLocale=loadAppLocale();
function posT(key,vars={}){
  const entry=POS_I18N[key];
  let value=entry?(entry[appLocale]||entry['en-US']):key;
  Object.entries(vars).forEach(([name,replacement])=>{ value=value.replaceAll(`{${name}}`,String(replacement)); });
  return value;
}
function posCount(key,count){ return posT(`${key}.${appLocale==='en-US'&&count===1?'one':'other'}`,{count}); }
const POS_EXACT_I18N=new Map();
Object.entries(POS_I18N).forEach(([key,entry])=>{
  POS_LOCALES.forEach(locale=>{ const value=entry[locale]; if(value&&!value.includes('{'))POS_EXACT_I18N.set(value,key); });
});
function posExact(value){
  const key=POS_EXACT_I18N.get(String(value||'').trim());
  return key?posT(key):value;
}
function applyAppLocale(root=document){
  if(!root)return;
  document.documentElement.lang=appLocale;
  root.querySelectorAll('[data-i18n]').forEach(node=>{ node.textContent=posT(node.dataset.i18n); });
  root.querySelectorAll('[data-i18n-placeholder]').forEach(node=>{ node.placeholder=posT(node.dataset.i18nPlaceholder); });
  root.querySelectorAll('[data-i18n-title]').forEach(node=>{ node.title=posT(node.dataset.i18nTitle); });
  root.querySelectorAll('[data-i18n-aria-label]').forEach(node=>{ node.setAttribute('aria-label',posT(node.dataset.i18nAriaLabel)); });
  const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);
  const textNodes=[];
  while(walker.nextNode())textNodes.push(walker.currentNode);
  textNodes.forEach(node=>{
    if(node.parentElement&&node.parentElement.closest('script,style,template,[data-i18n]'))return;
    const raw=node.nodeValue,trimmed=raw.trim(),translated=posExact(trimmed);
    if(trimmed&&translated!==trimmed)node.nodeValue=raw.replace(trimmed,translated);
  });
  root.querySelectorAll('[placeholder]:not([data-i18n-placeholder]),[title]:not([data-i18n-title]),[aria-label]:not([data-i18n-aria-label])').forEach(node=>{
    ['placeholder','title','aria-label'].forEach(attribute=>{ if(node.hasAttribute(attribute))node.setAttribute(attribute,posExact(node.getAttribute(attribute))); });
  });
}
