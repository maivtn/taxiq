          }

          .settings-field-grid,
          .settings-location-grid,
          .settings-template-grid,
          .settings-offer-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }

          .settings-business-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }

          .settings-booking-policy-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
          }

          .settings-social-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }

          .settings-loyalty-form {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }

          .settings-offer-modal-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }

          .settings-offer-grid.is-list {
            grid-template-columns: 1fr;
          }

          .settings-config-row {
            grid-template-columns: minmax(120px, 0.4fr) minmax(0, 1fr);
          }

          .settings-service-row {
            grid-template-columns: minmax(0, 1fr) auto;
          }

          .settings-service-header {
