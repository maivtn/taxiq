            try { const saved=localStorage.getItem(key); if(codes.includes(saved))current=saved; } catch (_) {}
            const industrySectors = [
              { key:'nail', icon:'✦', monogram:'BN', sample:true, logo:'assets/bitcoin-nailbar-logo.png', photo:'salon-operations.jpg',
                name:['Nail & làm đẹp','Nail & beauty','美甲与美容','네일·뷰티','Uñas y belleza','ネイル・美容','เล็บและความงาม','الأظافر والجمال','Onglerie et beauté'],
                description:['Một không gian để giới thiệu tiệm nail, hành trình đón khách và những trải nghiệm khách hàng tại tiệm.','A place to present nail salons, the guest journey, and in-salon experiences.','展示美甲店、顾客到店流程和店内体验的空间。','네일숍과 고객 방문 과정, 매장 경험을 소개하는 공간입니다.','Un espacio para presentar salones de uñas y la experiencia del cliente.','ネイルサロンと来店の流れ、店内体験を紹介する場所です。','พื้นที่นำเสนอร้านทำเล็บและประสบการณ์ลูกค้าในร้าน','مساحة لعرض صالونات الأظافر وتجربة العملاء داخلها.','Un espace pour présenter les salons d’onglerie et l’expérience client.'] },
              { key:'hair', icon:'✂', monogram:'✂', sample:false, photo:'salon-community.jpg',
                name:['Tóc & barber','Hair & barber','美发与理容','헤어·바버','Peluquería y barbería','ヘア・理容','ผมและบาร์เบอร์','الشعر والحلاقة','Coiffure et barbier'],
                description:['Nhóm dành cho salon tóc và barber, với hồ sơ riêng để giới thiệu dịch vụ và phong cách của từng doanh nghiệp.','A category for hair salons and barbers to present their services and individual style.','为美发店和理容店展示服务与独特风格的分类。','헤어 살롱과 바버숍이 서비스와 고유한 스타일을 소개하는 분류입니다.','Una categoría para que peluquerías y barberías presenten sus servicios y estilo.','ヘアサロンと理容店がサービスや個性を紹介するカテゴリです。','หมวดสำหรับร้านทำผมและบาร์เบอร์เพื่อแนะนำบริการและเอกลักษณ์','فئة لصالونات الشعر والحلاقة لعرض خدماتها وطابعها الخاص.','Une catégorie pour présenter les services et le style des salons de coiffure.'] },
              { key:'spa', icon:'❋', monogram:'❋', sample:false, photo:'salon-reception.jpg',
                name:['Spa & wellness','Spa & wellness','水疗与健康','스파·웰니스','Spa y bienestar','スパ・ウェルネス','สปาและสุขภาพ','السبا والعافية','Spa et bien-être'],
                description:['Nhóm giới thiệu spa, chăm sóc da và các dịch vụ wellness theo từng hồ sơ doanh nghiệp.','A space for spas, skincare, and wellness services organized by business profile.','按企业资料展示水疗、护肤与健康服务的空间。','스파, 스킨케어, 웰니스 서비스를 업체별로 소개하는 공간입니다.','Un espacio para spas, cuidado de la piel y servicios de bienestar.','スパ、スキンケア、ウェルネスの事業者を紹介する場所です。','พื้นที่สำหรับสปา การดูแลผิว และบริการสุขภาพ','مساحة للسبا والعناية بالبشرة وخدمات العافية حسب ملف النشاط.','Un espace pour les spas, les soins de la peau et le bien-être.'] },
              { key:'restaurant', icon:'🍽', monogram:'🍽', sample:false, photo:'restaurant-industry-photo.jpg',
                name:['Nhà hàng & ẩm thực','Restaurants & dining','餐厅与餐饮','레스토랑 및 다이닝','Restaurantes y gastronomía','レストラン・飲食','ร้านอาหารและการรับประทานอาหาร','المطاعم والمأكولات','Restaurants et restauration'],
                description:['Giới thiệu nhà hàng, quán cà phê và trải nghiệm dùng bữa qua thực đơn, không gian, giờ mở cửa và thông tin đặt bàn.','Present restaurants, cafés and dining experiences through menus, ambience, hours and reservation details.','通过菜单、环境、营业时间和订位信息展示餐厅、咖啡馆与用餐体验。','메뉴, 공간, 영업시간 및 예약 정보로 레스토랑과 카페의 다이닝 경험을 소개합니다.','Presenta restaurantes, cafeterías y experiencias gastronómicas con menús, ambiente, horarios y reservas.','メニュー、店内の雰囲気、営業時間、予約情報からレストランやカフェを紹介します。','แนะนำร้านอาหาร คาเฟ่ และประสบการณ์การรับประทานอาหารผ่านเมนู บรรยากาศ เวลาเปิด และการจอง','اعرض المطاعم والمقاهي وتجارب الطعام من خلال القوائم والأجواء وساعات العمل والحجز.','Présentez restaurants, cafés et expériences culinaires avec menus, ambiance, horaires et réservations.'] },
              { key:'other', icon:'◇', monogram:'◇', sample:false, photo:'salon-marketing-v2.jpg',
                name:['Dịch vụ khác','Other services','其他服务','기타 서비스','Otros servicios','その他のサービス','บริการอื่น ๆ','خدمات أخرى','Autres services'],
                description:['Các ngành dịch vụ khác có thể được tổ chức thành danh mục riêng khi có hồ sơ được xác nhận.','Other service industries can receive their own categories when approved profiles are available.','其他服务行业可在资料确认后建立独立分类。','확인된 프로필이 준비되면 다른 서비스 업종도 별도 분류로 구성할 수 있습니다.','Otros sectores de servicios pueden tener su propia categoría con perfiles aprobados.','確認済みプロフィールがそろえば、ほかのサービス業も分類できます。','ธุรกิจบริการอื่นสามารถมีหมวดเฉพาะเมื่อมีข้อมูลที่ยืนยันแล้ว','يمكن إنشاء فئات مستقلة للخدمات الأخرى عند توفر ملفات معتمدة.','Les autres services pourront avoir leur propre catégorie avec des profils approuvés.'] }
            ];
            const industrySalonIntro={
              vi:'BITCOIN NAIL BAR là salon do Brian Nguyen vận hành tại Houston và là nơi thử nghiệm thực tế đầu tiên của NEXORA TOUCH.',
              en:'BITCOIN NAIL BAR is the Houston salon operated by Brian Nguyen and NEXORA TOUCH’s first real-world pilot.',
              zh:'BITCOIN NAIL BAR 是 Brian Nguyen 在休斯敦经营的美甲店，也是 NEXORA TOUCH 的首个实际试点。',
              ko:'BITCOIN NAIL BAR는 Brian Nguyen이 휴스턴에서 운영하는 네일숍이자 NEXORA TOUCH의 첫 현장 시범 매장입니다.',
              es:'BITCOIN NAIL BAR es el salón que Brian Nguyen dirige en Houston y el primer piloto real de NEXORA TOUCH.',
              ja:'BITCOIN NAIL BAR は Brian Nguyen がヒューストンで運営するネイルサロンで、NEXORA TOUCH 初の実店舗での試験拠点です。',
              th:'BITCOIN NAIL BAR คือร้านทำเล็บในฮูสตันที่ Brian Nguyen ดำเนินงาน และเป็นสถานที่ทดลองใช้งานจริงแห่งแรกของ NEXORA TOUCH',
              ar:'BITCOIN NAIL BAR هو صالون يديره Brian Nguyen في هيوستن وأول موقع تجريبي فعلي لـ NEXORA TOUCH.',
              fr:'BITCOIN NAIL BAR est le salon exploité par Brian Nguyen à Houston et le premier terrain d’essai réel de NEXORA TOUCH.'
            };
            const industrySalonStory={vi:'Đọc câu chuyện tiệm ↗',en:'Read the salon story ↗',zh:'阅读沙龙故事 ↗',ko:'살롱 이야기 보기 ↗',es:'Leer la historia del salón ↗',ja:'サロンのストーリーを見る ↗',th:'อ่านเรื่องราวของร้าน ↗',ar:'اقرأ قصة الصالون ↗',fr:'Découvrir l’histoire du salon ↗'};
            const directoryLabels={
              vi:{title:'Doanh nghiệp trong ngành',sample:'MẪU',verified:'ĐÃ XÁC NHẬN',verifiedNote:'Doanh nghiệp đã đồng ý công bố hồ sơ.',view:'Xem hồ sơ doanh nghiệp ↗'},
              en:{title:'Businesses in this industry',sample:'SAMPLE',verified:'VERIFIED',verifiedNote:'The business approved publication of its profile.',view:'View business profile ↗'},
              zh:{title:'本行业的企业',sample:'示例',verified:'已确认',verifiedNote:'企业已同意公开资料。',view:'查看企业资料 ↗'},
              ko:{title:'이 업종의 업체',sample:'샘플',verified:'확인됨',verifiedNote:'사업자가 프로필 공개에 동의했습니다.',view:'업체 프로필 보기 ↗'},
              es:{title:'Empresas de este sector',sample:'MUESTRA',verified:'VERIFICADO',verifiedNote:'La empresa autorizó publicar su perfil.',view:'Ver perfil de la empresa ↗'},
              ja:{title:'この業種の事業者',sample:'サンプル',verified:'確認済み',verifiedNote:'事業者はプロフィールの公開に同意しています。',view:'事業者プロフィールを見る ↗'},
              th:{title:'ธุรกิจในหมวดนี้',sample:'ตัวอย่าง',verified:'ยืนยันแล้ว',verifiedNote:'ธุรกิจยินยอมให้เผยแพร่โปรไฟล์แล้ว',view:'ดูโปรไฟล์ธุรกิจ ↗'},
              ar:{title:'الأنشطة في هذا القطاع',sample:'نموذج',verified:'تم التحقق',verifiedNote:'وافق النشاط على نشر ملفه.',view:'عرض ملف النشاط ↗'},
              fr:{title:'Entreprises de ce secteur',sample:'EXEMPLE',verified:'VÉRIFIÉ',verifiedNote:'L’entreprise a approuvé la publication de son profil.',view:'Voir le profil de l’entreprise ↗'}
            };
            const previewBusinesses=Array.isArray(window.NEXORA_DIRECTORY_SAMPLES)?window.NEXORA_DIRECTORY_SAMPLES:[];
            const publicBusinesses=Array.isArray(window.NEXORA_CONNECTED_BUSINESSES)?window.NEXORA_CONNECTED_BUSINESSES.filter(record=>record&&record.connected===true&&record.verified===true&&record.publishConsent===true&&record.public===true&&typeof record.id==='string'&&record.id.trim()&&typeof record.name==='string'&&record.name.trim()):[];
            function businessesFor(sectorKey){
              const published=publicBusinesses.filter(record=>record.sector===sectorKey);
              return published.length?published:previewBusinesses.filter(record=>record.sector===sectorKey).map(record=>({...record,demo:true}));
            }
            function safeDirectoryLink(value){
              if(typeof value!=='string'||!value.trim())return '';
              const raw=value.trim();
              try{const url=new URL(raw,location.href);const absolute=/^[a-z][a-z\d+.-]*:/i.test(raw)||raw.startsWith('//');return url.protocol==='https:'||(!absolute&&url.origin===location.origin)?url.href:'';}catch{return '';}
            }
            const requestedParams=new URLSearchParams(location.search);
            const requestedIndustry=requestedParams.get('industry');
            let selectedBusinessId=requestedParams.get('business');
            let selectedIndustry = Math.max(0,industrySectors.findIndex(sector=>sector.key===requestedIndustry));
            function renderIndustry() {
              const index=codes.indexOf(current);
              const labels=directoryLabels[current];
              const tabs=document.getElementById('industry-tabs');
              tabs.setAttribute('aria-label',dict[current].industrySector);
              tabs.replaceChildren(...industrySectors.map((sector,sectorIndex)=>{
                const button=document.createElement('button'); button.type='button';
                button.textContent=`${sector.icon}  ${sector.name[index]}`;
                button.setAttribute('aria-pressed',String(sectorIndex===selectedIndustry));
                button.addEventListener('click',()=>{ selectedIndustry=sectorIndex; selectedBusinessId=null; renderIndustry(); });
                return button;
              }));
              const sector=industrySectors[selectedIndustry];
              const businesses=businessesFor(sector.key);
              const business=businesses.find(record=>record.id===selectedBusinessId)||businesses[0]||null;
              selectedBusinessId=business?.id||null;
              document.querySelector('#industry-display .industry-overview').style.setProperty('--industry-photo',`url("${sector.photo}")`);
              document.getElementById('industry-index').textContent=dict[current].industrySector;
              document.getElementById('industry-name').textContent=sector.name[index];
              document.getElementById('industry-description').textContent=sector.description[index];
              const tags=document.getElementById('industry-tags');
              const tag=document.createElement('span'); tag.textContent=dict[current].industryDemo;
              tags.replaceChildren(tag);
              const profile=document.getElementById('industry-profile');
              profile.dataset.sector=sector.key;
              profile.dataset.tone=business?.tone||'';
              profile.classList.toggle('has-logo',Boolean(business?.logo));
              document.getElementById('industry-profile-label').textContent=business?.demo?dict[current].industryProfileDemo:business?labels.verified:dict[current].industryProfileEmpty;
              document.getElementById('industry-profile-location').textContent=business?.location||'';
              const avatar=document.getElementById('industry-avatar');
              if(business?.logo){const logo=document.createElement('img');logo.src=business.logo;logo.alt='';logo.decoding='async';avatar.replaceChildren(logo);}else{avatar.textContent=business?.monogram||sector.monogram;}
              document.getElementById('industry-business-name').textContent=business?.name||sector.name[index];
              document.getElementById('industry-business-type').textContent=business?sector.name[index]:'';
              document.getElementById('industry-business-description').textContent=business?.id==='bitcoin-nail-bar'?industrySalonIntro[current]:business?.summary?(business.summary[current]||((current==='vi'||current==='en')?business.summary.en:sector.description[index])):dict[current].industryEmptyBody;
              const story=document.getElementById('industry-profile-story');
              const storyUrl=safeDirectoryLink(business?.story?(business.story[current]||business.story.en):business?.profileUrl);
              story.hidden=!storyUrl;
              if(!story.hidden){story.textContent=business.id==='bitcoin-nail-bar'?industrySalonStory[current]:labels.view;story.href=storyUrl;}
              document.getElementById('industry-profile-footer').textContent=business?.demo?dict[current].industrySampleFooter:business?labels.verifiedNote:dict[current].industryEmptyFooter;
              document.getElementById('industry-directory-kicker').textContent=business?.demo?dict[current].industryProfileDemo:labels.verified;
              document.getElementById('industry-directory-title').textContent=labels.title;
              document.getElementById('industry-directory-note').textContent=business?.demo?dict[current].industrySampleFooter:labels.verifiedNote;
              const grid=document.getElementById('industry-directory-grid');
              grid.replaceChildren(...businesses.map(record=>{
                const button=document.createElement('button');button.type='button';button.className='industry-directory-card';button.dataset.businessId=record.id;button.dataset.tone=record.tone||'';button.setAttribute('aria-pressed',String(record.id===selectedBusinessId));button.setAttribute('aria-label',record.name);
                const mark=document.createElement('span');mark.className='industry-directory-mark';mark.setAttribute('aria-hidden','true');
                if(record.logo){const img=document.createElement('img');img.src=record.logo;img.alt='';img.decoding='async';mark.append(img);}else{mark.textContent=record.monogram||'◇';}
                const copy=document.createElement('span');copy.className='industry-directory-copy';
                const badge=document.createElement('small');badge.textContent=record.demo?labels.sample:labels.verified;
                const name=document.createElement('strong');name.textContent=record.name;
                const type=document.createElement('span');type.textContent=sector.name[index];
                copy.append(badge,name,type);
                const arrow=document.createElement('span');arrow.className='industry-directory-arrow';arrow.setAttribute('aria-hidden','true');arrow.textContent='↗';
                button.append(mark,copy,arrow);
                button.addEventListener('click',()=>{selectedBusinessId=record.id;renderIndustry();[...document.querySelectorAll('.industry-directory-card')].find(item=>item.dataset.businessId===record.id)?.focus();});
                return button;
              }));
            }
            function setLanguage(code) {
              current=codes.includes(code)?code:'vi';
              document.documentElement.lang=current;
              document.documentElement.dir=current==='ar'?'rtl':'ltr';
              selector.value=current;
              selector.setAttribute('aria-label',dict[current].headerLanguage);
              document.querySelector('.footer-legal').setAttribute('aria-label',dict[current].footerLegalLabel);
              document.getElementById('language-code').textContent=current.toUpperCase();
              document.getElementById('menu-toggle').setAttribute('aria-label',dict[current].headerMenu);
