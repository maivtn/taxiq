      <script>window.NEXORA_SHELL = { activePage: 'owner-settings', activeTab: 'account' };</script>
      <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
      <script src="https://unpkg.com/lucide@1.23.0/dist/umd/lucide.min.js"></script>
      <script src="../assets/nexora-icons.js"></script>
      <script src="../assets/nexora-shell-nav.js?v=20261029-sidebar-group-labels"></script>
      <script src="../assets/nexora-shell.js?v=20261030-header-nine-dots-v48"></script>
      <script>
        (function () {
          'use strict';

          var tabs = Array.prototype.slice.call(document.querySelectorAll('[data-settings-tab]'));
          var panels = Array.prototype.slice.call(document.querySelectorAll('[data-settings-panel]'));
          var subAccountViewButtons = Array.prototype.slice.call(document.querySelectorAll('[data-sub-account-view]'));
          var subAccountPanels = Array.prototype.slice.call(document.querySelectorAll('[data-sub-account-panel]'));
          var modalOpenButtons = Array.prototype.slice.call(document.querySelectorAll('[data-open-modal]'));
          var modalCloseButtons = Array.prototype.slice.call(document.querySelectorAll('[data-close-modal]'));
          var ownerModals = Array.prototype.slice.call(document.querySelectorAll('.owner-modal'));
          var subAccountActionButtons = Array.prototype.slice.call(document.querySelectorAll('[data-sub-account-action]'));
          var resetPasswordButtons = Array.prototype.slice.call(document.querySelectorAll('[data-open-reset-password-modal]'));
          var resendEmailButtons = Array.prototype.slice.call(document.querySelectorAll('[data-open-resend-email-modal]'));
          var deactivateButtons = Array.prototype.slice.call(document.querySelectorAll('[data-open-deactivate-modal]'));
          var roleDeleteButtons = Array.prototype.slice.call(document.querySelectorAll('[data-delete-role]'));
          var subAccountActionStatus = document.querySelector('[data-sub-account-action-status]');
          var roleActionStatus = document.querySelector('[data-role-action-status]');
          var saveEditSubAccountButton = document.querySelector('[data-save-edit-sub-account]');
          var addRoleButton = document.querySelector('[data-add-role]');
          var logFilterMenu = document.querySelector('[data-log-filter-menu]');
          var logFilterToggle = document.querySelector('[data-log-filter-toggle]');
          var logFilterDropdown = document.querySelector('[data-log-filter-dropdown]');
          var sidebarMenuToggles = Array.prototype.slice.call(document.querySelectorAll('[data-sidebar-menu-toggle]'));
          var sidebarMenuResetButton = document.querySelector('[data-sidebar-menu-reset]');
          var sidebarMenuStatus = document.querySelector('[data-sidebar-menu-status]');
          var currentEditSubAccountButton = null;
          var pendingDeactivateRow = null;
          var defaultTab = 'account';
          var defaultSubAccountView = 'accounts';
          var systemConfirmButtonColor = 'var(--nexora-brand)';
          var fallbackSidebarVisibilityStorageKey = 'nexora.sidebar.visibility.v1';
          var subAccountActionMessages = {
            'activate': '{email} was activated.',
            'deactivate': '{email} was deactivated.',
            'reset-password': 'Password reset and a new login email was sent to {email}.',
            'resend-login-email': 'Login email resent to {email}.'
          };

          function sidebarVisibilityStorageKey() {
            return (window.NEXORA_SHELL && window.NEXORA_SHELL.sidebarVisibilityStorageKey) || fallbackSidebarVisibilityStorageKey;
          }

          function sidebarToggleKeySet() {
            var keys = {};
            sidebarMenuToggles.forEach(function (toggle) {
              keys[toggle.getAttribute('data-sidebar-menu-toggle')] = true;
            });
            return keys;
          }

          function normalizeSidebarHiddenKeys(keys) {
            var valid = sidebarToggleKeySet();
            var seen = {};
            var hiddenKeys = [];
            if (!Array.isArray(keys)) return hiddenKeys;
            keys.forEach(function (rawKey) {
              var key = String(rawKey || '');
              if (!key || key === 'settings' || seen[key] || !valid[key]) return;
              seen[key] = true;
              hiddenKeys.push(key);
            });
            return hiddenKeys;
          }

          function readSidebarHiddenKeys() {
            if (window.NEXORA_SHELL && typeof window.NEXORA_SHELL.getHiddenSidebarKeys === 'function') {
              return normalizeSidebarHiddenKeys(window.NEXORA_SHELL.getHiddenSidebarKeys());
            }
            try {
              var raw = window.localStorage.getItem(sidebarVisibilityStorageKey());
              if (!raw) return [];
              var data = JSON.parse(raw);
              if (Array.isArray(data)) return normalizeSidebarHiddenKeys(data);
              if (data && Array.isArray(data.hiddenKeys)) return normalizeSidebarHiddenKeys(data.hiddenKeys);
            } catch (error) {
              return [];
            }
            return [];
          }

          function setSidebarMenuStatus(message) {
            if (sidebarMenuStatus) sidebarMenuStatus.textContent = message;
          }

          function hiddenKeysFromSidebarToggles() {
            var hiddenKeys = [];
            sidebarMenuToggles.forEach(function (toggle) {
              var key = toggle.getAttribute('data-sidebar-menu-toggle');
              if (toggle.disabled || key === 'settings') return;
              if (!toggle.checked) hiddenKeys.push(key);
            });
            return hiddenKeys;
          }

          function saveSidebarHiddenKeys(hiddenKeys) {
            hiddenKeys = normalizeSidebarHiddenKeys(hiddenKeys);
            if (window.NEXORA_SHELL && typeof window.NEXORA_SHELL.setHiddenSidebarKeys === 'function') {
              hiddenKeys = window.NEXORA_SHELL.setHiddenSidebarKeys(hiddenKeys);
              if (typeof window.NEXORA_SHELL.refreshSidebar === 'function') window.NEXORA_SHELL.refreshSidebar();
              return hiddenKeys;
            }
            try {
              window.localStorage.setItem(sidebarVisibilityStorageKey(), JSON.stringify({ hiddenKeys: hiddenKeys }));
            } catch (error) {}
            return hiddenKeys;
          }

          function sidebarMenuLabel(toggle) {
            var row = toggle.closest('[data-sidebar-menu-item]');
            var label = row ? row.querySelector('.sidebar-menu-title') : null;
            return label ? label.textContent : 'Sidebar item';
          }

          function applySidebarMenuVisibilityState() {
            var hiddenMap = {};
            readSidebarHiddenKeys().forEach(function (key) { hiddenMap[key] = true; });
            sidebarMenuToggles.forEach(function (toggle) {
              var key = toggle.getAttribute('data-sidebar-menu-toggle');
              if (toggle.disabled || key === 'settings') {
                toggle.checked = true;
                return;
              }
              toggle.checked = !hiddenMap[key];
            });
            var hiddenCount = Object.keys(hiddenMap).length;
            setSidebarMenuStatus(hiddenCount ? hiddenCount + ' sidebar item' + (hiddenCount === 1 ? ' is' : 's are') + ' hidden.' : 'All sidebar items are visible.');
          }

          function handleSidebarMenuToggle(toggle) {
            if (toggle.disabled) return;
            var hiddenKeys = saveSidebarHiddenKeys(hiddenKeysFromSidebarToggles());
            setSidebarMenuStatus((toggle.checked ? 'Showing ' : 'Hiding ') + sidebarMenuLabel(toggle) + ' in sidebar.');
            if (!hiddenKeys.length) setSidebarMenuStatus('All sidebar items are visible.');
          }

          sidebarMenuToggles.forEach(function (toggle) {
            toggle.addEventListener('change', function () {
              handleSidebarMenuToggle(toggle);
            });
          });

          if (sidebarMenuResetButton) {
            sidebarMenuResetButton.addEventListener('click', function () {
              sidebarMenuToggles.forEach(function (toggle) { toggle.checked = true; });
              saveSidebarHiddenKeys([]);
              setSidebarMenuStatus('All sidebar items are visible.');
            });
          }

          function hasTab(tabId) {
            return tabs.some(function (tab) { return tab.getAttribute('data-settings-tab') === tabId; });
          }

          function currentQueryTab() {
            try {
              return new URLSearchParams(window.location.search).get('tab') || '';
            } catch (error) {
              return '';
            }
          }

          function currentQueryView() {
            try {
              return new URLSearchParams(window.location.search).get('view') || '';
            } catch (error) {
              return '';
            }
          }

          function activateTab(tabId, shouldUpdateUrl) {
            var nextTab = hasTab(tabId) ? tabId : defaultTab;
            tabs.forEach(function (tab) {
              var isActive = tab.getAttribute('data-settings-tab') === nextTab;
              tab.classList.toggle('is-active', isActive);
              tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
              tab.setAttribute('tabindex', isActive ? '0' : '-1');
              if (isActive && typeof tab.scrollIntoView === 'function') {
                tab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
              }
            });
            panels.forEach(function (panel) {
              panel.hidden = panel.getAttribute('data-settings-panel') !== nextTab;
            });
            if (window.NEXORA_SHELL && typeof window.NEXORA_SHELL.setActiveTab === 'function') {
              window.NEXORA_SHELL.setActiveTab(nextTab);
            }
            if (shouldUpdateUrl && window.history && typeof window.history.replaceState === 'function') {
              var url = new URL(window.location.href);
              url.searchParams.set('tab', nextTab);
              if (nextTab !== 'sub-account') url.searchParams.delete('view');
              window.history.replaceState(null, '', url.toString());
            }
          }

          window.activateMainTab = function (tabId) {
            activateTab(tabId, true);
          };

          tabs.forEach(function (tab, index) {
            tab.addEventListener('click', function () {
              activateTab(tab.getAttribute('data-settings-tab'), true);
            });
            tab.addEventListener('keydown', function (event) {
              if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
              event.preventDefault();
              var direction = event.key === 'ArrowRight' ? 1 : -1;
              var nextIndex = (index + direction + tabs.length) % tabs.length;
              tabs[nextIndex].focus();
              activateTab(tabs[nextIndex].getAttribute('data-settings-tab'), true);
            });
          });

          function openModal(modalId) {
            var modal = document.getElementById(modalId);
            if (!modal) return;
            modal.hidden = false;
            document.body.classList.add('owner-modal-open');
            var closeButton = modal.querySelector('[data-close-modal]');
            if (closeButton) closeButton.focus();
          }

          function closeModal(modalId) {
            var modal = document.getElementById(modalId);
            if (!modal) return;
            modal.hidden = true;
            var hasOpenModal = ownerModals.some(function (item) { return !item.hidden; });
            if (!hasOpenModal) document.body.classList.remove('owner-modal-open');
          }

          function setText(selector, value) {
            var element = document.querySelector(selector);
            if (element) element.textContent = value || '';
          }

          function setValue(selector, value) {
            var element = document.querySelector(selector);
            if (element) element.value = value || '';
          }

          function updateStatusPill(statusPill, status) {
            if (!statusPill) return;
            var nextStatus = status || 'Active';
            statusPill.textContent = nextStatus;
            statusPill.className = 'status-pill';
            statusPill.classList.toggle('is-pending', nextStatus === 'Pending');
            statusPill.classList.toggle('is-disabled', nextStatus === 'Disabled');
          }

          function populateEditSubAccountModal(button) {
            currentEditSubAccountButton = button;
            setValue('[data-edit-account-name]', button.getAttribute('data-account-name'));
            setText('[data-edit-account-id]', button.getAttribute('data-account-id'));
            setText('[data-edit-account-email]', button.getAttribute('data-account-email'));
            setValue('[data-edit-account-phone]', button.getAttribute('data-account-phone'));
            setValue('[data-edit-account-role]', button.getAttribute('data-account-role'));
            updateStatusPill(document.querySelector('[data-edit-account-status]'), button.getAttribute('data-account-status'));
          }

          function subAccountName(button) {
            return button.getAttribute('data-account-name') || button.getAttribute('data-account-email') || 'this Sub Account';
          }

          function subAccountActionTarget(button, action, email) {
            return {
              getAttribute: function (attribute) {
                if (attribute === 'data-sub-account-action') return action;
                if (attribute === 'data-account-email') return email;
                return button.getAttribute(attribute);
              },
              closest: function (selector) {
                return button.closest(selector);
              }
            };
          }

          function showSubAccountConfirm(button, options) {
            var email = button.getAttribute('data-account-email') || '';
            var fallbackMessage = options.title + '\n\n' + options.text;
            var confirmAction = function () {
              setSubAccountActionStatus(subAccountActionTarget(button, options.action, email));
            };

            if (options.action === 'deactivate') pendingDeactivateRow = button.closest('tr');

            if (window.Swal && typeof window.Swal.fire === 'function') {
              Swal.fire({
                icon: options.icon || 'warning',
                title: options.title,
                text: options.text,
                showCancelButton: true,
                confirmButtonText: options.confirmButtonText,
                cancelButtonText: 'Cancel',
                confirmButtonColor: options.confirmButtonColor || systemConfirmButtonColor,
                reverseButtons: true
              }).then(function (result) {
                if (result.isConfirmed) {
                  confirmAction();
                  return;
                }
                if (options.action === 'deactivate') pendingDeactivateRow = null;
              });
              return;
            }

            if (window.confirm(fallbackMessage)) {
              confirmAction();
              return;
            }
            if (options.action === 'deactivate') pendingDeactivateRow = null;
          }

          function validateRoleName(value) {
            var trimmed = (value || '').trim();
            if (!trimmed) return 'Role name is required.';
            if (trimmed.length > 100) return 'Role name must be 100 characters or fewer.';
            return '';
          }

          function roleIdFromName(name) {
            var slug = (name || '').trim().toUpperCase().replace(/[^A-Z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 80);
            return 'ROLE-' + (slug || 'NEW');
          }

          function openRoleDetailsForNewRole(roleName) {
            window.location.href = 'role-details.html?roleId=' + encodeURIComponent(roleIdFromName(roleName)) + '&roleName=' + encodeURIComponent(roleName);
          }

          function showAddRoleModal() {
            if (window.Swal && typeof window.Swal.fire === 'function') {
              Swal.fire({
                title: 'Add Role',
                input: 'text',
                inputLabel: 'Role name',
                inputPlaceholder: 'Enter role name',
                inputAttributes: { maxlength: '100', autocapitalize: 'off', autocomplete: 'off' },
                showCancelButton: true,
                confirmButtonText: 'Add',
                cancelButtonText: 'Cancel',
                confirmButtonColor: systemConfirmButtonColor,
                inputValidator: function (value) {
                  var validationMessage = validateRoleName(value);
                  if (validationMessage) return validationMessage;
                }
              }).then(function (result) {
                if (!result.isConfirmed) return;
                var roleName = (result.value || '').trim();
                Swal.fire({
                  icon: 'success',
                  title: 'Role added successfully',
                  text: roleName + ' was added. Set module permissions next.',
                  confirmButtonText: 'Set modules',
                  confirmButtonColor: systemConfirmButtonColor
                }).then(function () {
                  openRoleDetailsForNewRole(roleName);
                });
              });
              return;
            }

            var fallbackRoleName = window.prompt('Role name');
            if (fallbackRoleName === null) return;
            var validationMessage = validateRoleName(fallbackRoleName);
            if (validationMessage) {
              window.alert(validationMessage);
              return;
            }
            var roleName = fallbackRoleName.trim();
            window.alert('Role added successfully');
            openRoleDetailsForNewRole(roleName);
          }

          if (addRoleButton) addRoleButton.addEventListener('click', showAddRoleModal);

          function assignedSubAccountCount(button) {
            return parseInt(button.getAttribute('data-role-assigned-count') || '0', 10) || 0;
          }

          function deleteRoleRow(button) {
            var roleName = button.getAttribute('data-role-name') || 'Role';
            var row = button.closest('tr');
            if (row) row.remove();
            if (roleActionStatus) roleActionStatus.textContent = roleName + ' role deleted.';
          }

          function showDeleteRoleConfirm(button) {
            if (assignedSubAccountCount(button) !== 0) return;
            var roleName = button.getAttribute('data-role-name') || 'This role';
            if (window.Swal && typeof window.Swal.fire === 'function') {
              Swal.fire({
                icon: 'warning',
                title: 'Delete role?',
                text: roleName + ' has no assigned Sub Accounts and will be removed.',
                showCancelButton: true,
                confirmButtonText: 'Delete Role',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#dc2626',
                reverseButtons: true
              }).then(function (result) {
                if (result.isConfirmed) deleteRoleRow(button);
              });
              return;
            }
            if (window.confirm('Delete role?\n\n' + roleName + ' has no assigned Sub Accounts and will be removed.')) {
              deleteRoleRow(button);
            }
          }

          roleDeleteButtons.forEach(function (button) {
            button.addEventListener('click', function () {
              showDeleteRoleConfirm(button);
            });
          });

          modalOpenButtons.forEach(function (button) {
            button.addEventListener('click', function () {
              var modalId = button.getAttribute('data-open-modal');
              if (modalId === 'edit-sub-account-modal') populateEditSubAccountModal(button);
              openModal(modalId);
            });
          });

          modalCloseButtons.forEach(function (button) {
            button.addEventListener('click', function () {
              closeModal(button.getAttribute('data-close-modal'));
            });
          });

          resetPasswordButtons.forEach(function (button) {
            button.addEventListener('click', function () {
              var name = subAccountName(button);
              showSubAccountConfirm(button, {
                action: 'reset-password',
                icon: 'warning',
                title: 'Reset Sub Account password?',
                text: 'A new password will be generated for ' + name + ' and sent through the Sub Account credential flow.',
                confirmButtonText: 'Reset Password'
              });
            });
          });

          resendEmailButtons.forEach(function (button) {
            button.addEventListener('click', function () {
              var name = subAccountName(button);
              var email = button.getAttribute('data-account-email') || '';
              showSubAccountConfirm(button, {
                action: 'resend-login-email',
                icon: 'question',
                title: 'Send login email?',
                text: 'A login email will be sent to ' + name + ' at ' + email + '.',
                confirmButtonText: 'Send Mail'
              });
            });
          });

          deactivateButtons.forEach(function (button) {
            button.addEventListener('click', function () {
              var name = subAccountName(button);
              showSubAccountConfirm(button, {
                action: 'deactivate',
                icon: 'warning',
                title: 'Deactivate Sub Account?',
                text: name + ' will lose login access until this Sub Account is activated again.',
                confirmButtonText: 'Deactivate',
                confirmButtonColor: '#dc2626'
              });
            });
          });

          function setSubAccountActionStatus(button) {
            var action = button.getAttribute('data-sub-account-action');
            var email = button.getAttribute('data-account-email') || 'this Sub Account';
            var message = subAccountActionMessages[action] || 'Action completed for {email}.';
            if (subAccountActionStatus) subAccountActionStatus.textContent = message.replace('{email}', email);
            if (action !== 'activate' && action !== 'deactivate') return;
            var row = action === 'deactivate' && pendingDeactivateRow ? pendingDeactivateRow : button.closest('tr');
            if (!row) return;
            var statusPill = row.querySelector('.status-pill');
            if (!statusPill) return;
            statusPill.textContent = action === 'activate' ? 'Active' : 'Disabled';
            statusPill.classList.toggle('is-disabled', action === 'deactivate');
            statusPill.classList.remove('is-pending');
            if (action === 'deactivate') pendingDeactivateRow = null;
          }

          subAccountActionButtons.forEach(function (button) {
            button.addEventListener('click', function () {
              setSubAccountActionStatus(button);
            });
          });

          if (saveEditSubAccountButton) {
            saveEditSubAccountButton.addEventListener('click', function () {
              if (!currentEditSubAccountButton) return;
              var row = currentEditSubAccountButton.closest('tr');
              var name = (document.querySelector('[data-edit-account-name]') || {}).value || '';
              var phone = (document.querySelector('[data-edit-account-phone]') || {}).value || '';
              var role = (document.querySelector('[data-edit-account-role]') || {}).value || '';
              var status = (document.querySelector('[data-edit-account-status]') || {}).textContent || 'Active';
              currentEditSubAccountButton.setAttribute('data-account-name', name);
              currentEditSubAccountButton.setAttribute('data-account-phone', phone);
              currentEditSubAccountButton.setAttribute('data-account-role', role);
              currentEditSubAccountButton.setAttribute('data-account-status', status);
              if (row) {
                var metas = row.querySelectorAll('td:first-child .cell-meta');
                if (metas[0]) metas[0].textContent = name;
                if (metas[1]) metas[1].textContent = '+1 ' + phone;
                var roleBadge = row.querySelector('.role-badge');
                if (roleBadge) roleBadge.textContent = role;
                updateStatusPill(row.querySelector('.status-pill'), status);
                var resetButton = row.querySelector('[data-open-reset-password-modal]');
                if (resetButton) resetButton.setAttribute('data-account-name', name);
                var resendButton = row.querySelector('[data-open-resend-email-modal]');
                if (resendButton) resendButton.setAttribute('data-account-name', name);
                var deactivateButton = row.querySelector('[data-open-deactivate-modal]');
                if (deactivateButton) deactivateButton.setAttribute('data-account-name', name);
              }
              if (subAccountActionStatus) subAccountActionStatus.textContent = 'Sub Account updated for ' + name + '.';
              closeModal('edit-sub-account-modal');
            });
          }

          function setLogFilterDropdownOpen(isOpen) {
            if (!logFilterToggle || !logFilterDropdown) return;
            logFilterDropdown.hidden = !isOpen;
            logFilterToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            logFilterToggle.classList.toggle('is-active', isOpen);
          }

          if (logFilterToggle) {
            logFilterToggle.addEventListener('click', function () {
              setLogFilterDropdownOpen(logFilterDropdown ? logFilterDropdown.hidden : false);
            });
          }

          document.addEventListener('click', function (event) {
            if (!logFilterMenu || !logFilterDropdown || logFilterDropdown.hidden) return;
            if (!logFilterMenu.contains(event.target)) setLogFilterDropdownOpen(false);
          });

          document.addEventListener('keydown', function (event) {
            if (event.key !== 'Escape') return;
            setLogFilterDropdownOpen(false);
            ownerModals.forEach(function (modal) {
              if (!modal.hidden) closeModal(modal.id);
            });
          });

          function hasSubAccountView(viewId) {
            return subAccountViewButtons.some(function (button) { return button.getAttribute('data-sub-account-view') === viewId; });
          }

          function activateSubAccountView(viewId, shouldUpdateUrl) {
            var nextView = hasSubAccountView(viewId) ? viewId : defaultSubAccountView;
            subAccountViewButtons.forEach(function (button) {
              var isActive = button.getAttribute('data-sub-account-view') === nextView;
              button.classList.toggle('is-active', isActive);
              button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
            });
            subAccountPanels.forEach(function (panel) {
              panel.hidden = panel.getAttribute('data-sub-account-panel') !== nextView;
            });
            if (shouldUpdateUrl && window.history && typeof window.history.replaceState === 'function') {
              var url = new URL(window.location.href);
              url.searchParams.set('tab', 'sub-account');
              url.searchParams.set('view', nextView);
              window.history.replaceState(null, '', url.toString());
            }
          }

          subAccountViewButtons.forEach(function (button) {
            button.addEventListener('click', function () {
              activateSubAccountView(button.getAttribute('data-sub-account-view'), true);
            });
          });

          var saveButtons = Array.prototype.slice.call(document.querySelectorAll('[data-save-button]'));
          saveButtons.forEach(function (button) {
            button.addEventListener('click', function () {
              var status = document.querySelector('[data-save-status]');
              if (status) status.textContent = 'Saved just now.';
            });
          });

          var copyButton = document.querySelector('[data-copy-affiliate]');
          var copyInput = document.querySelector('[data-affiliate-url]');
          var copyStatus = document.querySelector('[data-copy-status]');
          if (copyButton && copyInput) {
            copyButton.addEventListener('click', function () {
              copyInput.select();
              try {
                if (navigator.clipboard && navigator.clipboard.writeText) {
                  navigator.clipboard.writeText(copyInput.value);
                } else {
                  document.execCommand('copy');
                }
                if (copyStatus) copyStatus.textContent = 'Affiliate link copied.';
              } catch (error) {
                if (copyStatus) copyStatus.textContent = 'Select and copy the link manually.';
              }
            });
          }

          applySidebarMenuVisibilityState();
          activateTab(currentQueryTab(), false);
          activateSubAccountView(currentQueryView(), false);
        })();
      </script>
      <script src="../assets/salon-data.js"></script>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
      <script src="../assets/owner-settings-content.js"></script>
      <script src="../assets/owner-service-applications.js"></script>
    </body>
    </html>

