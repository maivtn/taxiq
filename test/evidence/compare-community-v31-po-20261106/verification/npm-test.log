        .booking-duration {
          display: inline-flex;
          align-items: center;
          gap: 5px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 800;
          font-variant-numeric: tabular-nums;
        }

        .booking-duration .bi { color: var(--nexora-subtle); font-size: 13px; }

        .booking-status-cell {
          white-space: nowrap;
        }

        .booking-status {
          display: inline-flex;
          align-items: center;
          border-radius: 999px;
          padding: 4px 9px;
          font-size: 10px;
          font-weight: 900;
          letter-spacing: 0.02em;
        }

        .booking-status-new {
          background: rgba(245, 158, 11, 0.14);
          color: #9a5a00;
        }

        .booking-status-sms {
          background: rgba(70, 72, 216, 0.12);
          color: var(--nexora-brand);
        }

        .booking-status-done {
          background: rgba(0, 184, 115, 0.12);
          color: var(--nexora-success);
        }

        .booking-status-noshow {
          background: rgba(239, 68, 68, 0.12);
          color: #dc2626;
        }

        .booking-status-chips {
          display: flex;
          flex-wrap: wrap;
          gap: 8px;
          margin-bottom: 14px;
        }

        .booking-status-chip {
          display: inline-flex;
          align-items: center;
          gap: 7px;
          border: 1px solid var(--nexora-border);
          border-radius: 999px;
          background: #fff;
          padding: 7px 13px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 700;
          cursor: pointer;
          transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
        }

        .booking-status-chip:hover {
          border-color: rgba(70, 72, 216, 0.4);
        }

        .booking-status-chip.is-active {
          border-color: rgba(70, 72, 216, 0.5);
          background: color-mix(in srgb, var(--nexora-brand) 8%, white);
          color: var(--nexora-brand);
        }

        .booking-status-chip-count {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          min-width: 20px;
          height: 18px;
          padding: 0 6px;
          border-radius: 999px;
          background: var(--nexora-canvas);
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 800;
        }

        .booking-status-chip.is-active .booking-status-chip-count {
          background: var(--nexora-brand);
          color: #fff;
        }

        .cust-count {
          color: var(--nexora-muted);
          font-size: 11.5px;
          font-weight: 600;
        }

        .booking-empty-cell {
          text-align: center;
          padding: 20px;
          color: var(--nexora-muted);
          font-weight: 600;
        }

        .booking-actions {
          display: flex;
          flex-wrap: wrap;
          justify-content: flex-end;
          gap: 7px;
          min-width: 78px;
        }

        .booking-empty {
          border: 1px dashed var(--nexora-border);
          border-radius: 10px;
          background: var(--nexora-canvas);
          padding: 18px;
          color: var(--nexora-muted);
          text-align: center;
          font-size: 12px;
          font-weight: 700;
        }

        .booking-card-list {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
          gap: 10px;
        }

        .booking-appointment-card {
          display: grid;
          gap: 12px;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: #fff;
          padding: 14px;
          box-shadow: 0 8px 22px rgba(15, 23, 42, 0.05);
        }

        .booking-card-top {
          display: flex;
          align-items: flex-start;
          justify-content: space-between;
          gap: 10px;
        }

        .booking-card-name {
          color: var(--nexora-text);
          font-size: 14px;
          font-weight: 800;
          line-height: 1.3;
        }

        .booking-card-contact {
          margin-top: 4px;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 600;
          line-height: 1.45;
          overflow-wrap: anywhere;
        }

        .booking-card-info-list {
          display: grid;
          gap: 7px;
          border-top: 1px solid var(--nexora-rule);
          padding-top: 10px;
        }

        .booking-card-info-row {
          display: grid;
          grid-template-columns: 76px minmax(0, 1fr);
          align-items: baseline;
          gap: 10px;
          min-width: 0;
        }

        .booking-card-label {
          color: var(--nexora-subtle);
          font-size: 10px;
          font-weight: 800;
          letter-spacing: 0.04em;
          text-transform: uppercase;
        }

        .booking-card-value {
          color: var(--nexora-text);
          font-size: 12px;
          font-weight: 700;
          line-height: 1.4;
          overflow-wrap: anywhere;
        }

        .booking-card-actions {
          display: flex;
          flex-wrap: wrap;
          justify-content: flex-end;
          gap: 7px;
          padding-top: 1px;
        }

        .booking-source-voice {
          background: rgba(50, 215, 255, 0.12);
          color: #087c99;
        }

        .booking-source-lp {
          background: #e9e9ff;
          color: var(--nexora-brand);
        }

        .booking-source-sms {
          background: rgba(0, 184, 115, 0.12);
          color: var(--nexora-success);
        }

        .booking-source-qr {
          background: rgba(142, 77, 248, 0.13);
          color: var(--nexora-violet);
        }

        .booking-source-manual {
          background: rgba(245, 158, 11, 0.14);
          color: #b45309;
        }

        .tech-intro {
          display: flex;
          flex-wrap: wrap;
          align-items: center;
          justify-content: space-between;
          gap: 12px;
          margin-bottom: 14px;
        }

        .tech-intro-text {
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 700;
          line-height: 1.5;
        }

        .tech-grid {
          display: flex;
          flex-wrap: wrap;
          gap: 12px;
        }

        .tech-card {
          display: grid;
          align-content: start;
          gap: 9px;
          flex: 0 1 280px;
          width: 280px;
          max-width: 100%;
          border: 1px solid var(--nexora-border);
          border-radius: 12px;
          background: #fff;
          padding: 13px;
          box-shadow: var(--nexora-card-shadow);
        }

        .tech-top {
          display: grid;
          grid-template-columns: 40px minmax(0, 1fr) auto;
          align-items: center;
          gap: 10px;
          margin-bottom: 0;
        }

        .tech-avatar {
          display: inline-flex;
          width: 40px;
          height: 40px;
          flex-shrink: 0;
          align-items: center;
          justify-content: center;
          border-radius: 999px;
          background: linear-gradient(135deg, var(--nexora-electric), var(--nexora-violet));
          color: #fff;
          font-size: 14px;
          font-weight: 900;
        }

        .tech-profile {
          display: grid;
          min-width: 0;
          gap: 2px;
        }

        .tech-name {
          overflow: hidden;
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 900;
          line-height: 1.18;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .tech-phone {
          margin-top: 2px;
          overflow: hidden;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 700;
          line-height: 1.18;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .toggle-pill {
          position: relative;
          width: 42px;
          height: 24px;
          flex-shrink: 0;
          border: 0;
          border-radius: 999px;
          background: var(--nexora-border);
        }

        .toggle-pill::after {
          content: "";
          position: absolute;
          top: 3px;
          left: 3px;
          width: 18px;
          height: 18px;
          border-radius: 999px;
          background: #fff;
          box-shadow: 0 1px 4px rgba(15, 23, 42, 0.2);
          transition: transform 0.2s;
        }

        .toggle-pill.is-on {
          background: var(--nexora-success);
        }

        .toggle-pill.is-on::after {
          transform: translateX(18px);
        }

        .tech-services {
          display: flex;
          max-height: 128px;
          overflow-y: auto;
          flex-wrap: wrap;
          align-content: flex-start;
          gap: 6px;
          margin-bottom: 0;
          padding-right: 3px;
        }

        .tech-services .badge {
          min-height: 20px;
          padding: 3px 7px;
          line-height: 1;
        }

        .tech-stats {
          display: flex;
          align-items: center;
          gap: 6px;
          margin-top: 0;
          text-align: left;
        }

        .tech-card-footer {
          display: flex;
          height: 42px;
          min-height: 42px;
          align-items: center;
          justify-content: space-between;
          gap: 8px;
          margin-top: 2px;
          border-radius: 10px;
          background: var(--nexora-canvas);
          padding: 6px 7px;
          box-sizing: border-box;
        }

        .tech-card-actions {
          display: flex;
          justify-content: flex-end;
          margin-top: 0;
          padding-top: 0;
        }

        .tech-card-actions .booking-secondary-button {
          min-height: 30px;
          padding: 6px 9px;
          border-radius: 8px;
          font-size: 11px;
        }

        .tech-card-actions .booking-secondary-button.icon-only {
          width: 30px;
          min-width: 30px;
          height: 30px;
          padding: 0;
        }

        .tech-stat {
          display: inline-flex;
          min-height: 28px;
          align-items: center;
          gap: 6px;
          border: 0;
          border-radius: 999px;
          background: var(--nexora-canvas);
          padding: 4px 9px;
        }

        .tech-stat strong {
          display: inline;
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 900;
          line-height: 1;
        }

        .tech-stat span {
          color: var(--nexora-muted);
          font-size: 10px;
          font-weight: 800;
          line-height: 1;
          white-space: nowrap;
        }

        .tech-modal {
          position: fixed;
          inset: 0;
          z-index: 120;
          display: grid;
          place-items: center;
          background: rgba(8, 31, 73, 0.42);
          padding: 18px;
          backdrop-filter: blur(8px);
        }

        .tech-modal[hidden] {
          display: none;
        }

        .tech-dialog {
          display: flex;
          width: min(100%, 920px);
          max-height: min(88vh, 760px);
          overflow: hidden;
          flex-direction: column;
          border: 1px solid var(--nexora-border);
          border-radius: 14px;
          background: #fff;
          box-shadow: 0 28px 80px rgba(8, 31, 73, 0.24);
        }

        .tech-modal-head,
        .tech-modal-actions {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 12px;
          padding: 16px 18px;
        }

        .tech-modal-head {
          flex-shrink: 0;
          border-bottom: 1px solid var(--nexora-border);
          background: linear-gradient(180deg, #fff, #f8fbff);
          padding: 14px 16px;
        }

        .tech-modal-heading {
          display: flex;
          min-width: 0;
          align-items: center;
          gap: 10px;
        }

        .tech-title-mark {
          display: inline-flex;
          width: 36px;
          height: 36px;
          flex: 0 0 auto;
          align-items: center;
          justify-content: center;
          border-radius: 11px;
          background: color-mix(in srgb, var(--nexora-brand) 10%, white);
          color: var(--nexora-brand);
          font-size: 16px;
        }

        .tech-modal-title {
          color: var(--nexora-text);
          font-size: 15px;
          font-weight: 800;
        }

        .tech-modal-sub {
          margin-top: 3px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 500;
          line-height: 1.45;
        }

        .tech-modal-close {
          display: inline-flex;
          width: 34px;
          height: 34px;
          align-items: center;
          justify-content: center;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: #fff;
          color: var(--nexora-muted);
          font-size: 16px;
        }

        .tech-modal-body {
          display: grid;
          grid-template-columns: minmax(0, 1fr);
          gap: 12px;
          overflow: auto;
          padding: 12px;
        }

        .tech-modal-section {
          border: 1px solid var(--nexora-border);
          border-radius: 11px;
          background: #fff;
          padding: 12px;
          box-shadow: 0 8px 22px rgba(15, 23, 42, 0.04);
        }

        .tech-modal-section-title {
          display: flex;
          align-items: center;
          gap: 8px;
          color: var(--nexora-text);
          font-size: 12px;
          font-weight: 800;
          margin-bottom: 10px;
        }

        .tech-modal-section:first-child {
          position: relative;
          z-index: 3;
        }

        .tech-modal[data-tech-mode="detail"] [data-tech-picker-section] {
          display: none;
        }

        .tech-select-row {
          display: grid;
          grid-template-columns: minmax(0, 1fr) auto;
          align-items: start;
          gap: 8px;
        }

        .tech-combobox {
          position: relative;
          min-width: 0;
        }

        .tech-search {
          position: relative;
          display: block;
          margin: 0;
        }

        .tech-search i {
          position: absolute;
          top: 50%;
          left: 12px;
          color: var(--nexora-subtle);
          font-size: 13px;
          transform: translateY(-50%);
          pointer-events: none;
        }

        .tech-search .tech-select-chevron {
          right: 12px;
          left: auto;
          font-size: 12px;
        }

        .tech-combobox.is-open .tech-select-chevron {
          transform: translateY(-50%) rotate(180deg);
        }

        .tech-search input {
          width: 100%;
          height: 42px;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          outline: 0;
          background: #fff;
          padding: 0 34px;
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 700;
        }

        .tech-search input:focus {
          border-color: rgba(0, 184, 115, 0.72);
          box-shadow: 0 0 0 3px rgba(0, 184, 115, 0.12);
        }

        .tech-select-menu {
          position: absolute;
          top: calc(100% + 6px);
          right: 0;
          left: 0;
          z-index: 8;
          max-height: 292px;
          overflow-y: auto;
          border: 1px solid var(--nexora-border);
          border-radius: 12px;
          background: #fff;
          padding: 6px;
          box-shadow: 0 18px 45px rgba(8, 31, 73, 0.16);
        }

        .tech-select-menu[hidden] {
          display: none;
        }

        .tech-choice-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 7px;
          max-height: none;
          overflow: visible;
          padding-right: 2px;
        }

        .tech-choice-card {
          display: flex;
          align-items: center;
          gap: 9px;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: #fff;
          padding: 8px;
          color: var(--nexora-muted);
          text-align: left;
          transition: border-color 0.2s, background 0.2s, transform 0.2s, box-shadow 0.2s;
        }

        .tech-choice-card:hover {
          border-color: rgba(70, 72, 216, 0.25);
          background: var(--nexora-surface-muted);
        }

        .tech-choice-card.is-active {
          border-color: rgba(70, 72, 216, 0.42);
          background: color-mix(in srgb, var(--nexora-brand) 7%, white);
          color: var(--nexora-brand);
        }

        .tech-choice-card .tech-avatar {
          width: 32px;
          height: 32px;
          font-size: 12px;
        }

        .tech-choice-name {
          color: var(--nexora-text);
          font-size: 12px;
          font-weight: 800;
        }

        .tech-choice-meta {
          margin-top: 2px;
          color: var(--nexora-muted);
          font-size: 10.5px;
          font-weight: 500;
        }

        .tech-empty {
          display: none;
          border: 1px dashed var(--nexora-border);
          border-radius: 10px;
          background: #fff;
          padding: 10px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 600;
        }

        .tech-empty.is-visible {
          display: block;
        }

        .tech-create-button {
          height: 42px;
          display: inline-flex;
          align-items: center;
          gap: 6px;
          white-space: nowrap;
        }

        .tech-modal-grid {
          display: grid;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: 10px;
        }

        .tech-modal-grid .settings-field:nth-child(4),
        .tech-modal-grid .settings-field:last-child {
          grid-column: 1 / -1;
        }

        .tech-service-checks {
          display: block;
        }

        .tech-service-picker {
          display: block;
          max-height: 360px;
          overflow-y: auto;
          padding-right: 2px;
        }

        .tech-service-picker > * + * {
          margin-top: 6px;
        }

        .tech-service-picker-toolbar {
          position: sticky;
          top: 0;
          z-index: 2;
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 8px;
          border: 1px solid rgba(70, 72, 216, 0.28);
          border-radius: 9px;
          background: color-mix(in srgb, var(--nexora-brand) 5%, white);
          padding: 8px 9px;
          color: var(--nexora-text);
          font-size: 11px;
          font-weight: 900;
        }

        .tech-service-picker-toolbar label,
        .tech-service-category-all {
          display: inline-flex;
          align-items: center;
          gap: 6px;
          cursor: pointer;
          white-space: nowrap;
        }

        .tech-service-picker-toolbar input,
        .tech-service-category-all input {
          width: 14px;
          height: 14px;
          flex: 0 0 auto;
          accent-color: var(--nexora-brand);
        }

        .tech-service-picker-count,
        .tech-service-category-count {
          flex: 0 0 auto;
          border-radius: 999px;
          background: #e9edff;
          padding: 2px 7px;
          color: var(--nexora-brand);
          font-size: 10px;
          font-weight: 800;
        }

        .tech-service-category-count {
          margin-left: auto;
        }

        .tech-service-category {
          overflow: hidden;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: #fff;
        }

        .tech-service-category-head {
          display: flex;
          align-items: center;
          gap: 8px;
          list-style: none;
          cursor: pointer;
          background: #f8faff;
          padding: 8px 9px;
        }

        .tech-service-category-head::-webkit-details-marker {
          display: none;
        }

        .tech-service-category-head::after {
          content: '⌄';
          margin-left: 0;
          color: var(--nexora-subtle);
          font-size: 14px;
          font-weight: 900;
          line-height: 1;
          transition: transform .16s ease;
        }

        .tech-service-category:not([open]) .tech-service-category-head::after {
          transform: rotate(-90deg);
        }

        .tech-service-category-title {
          min-width: 0;
          overflow: hidden;
          color: var(--nexora-text);
          font-size: 10px;
          font-weight: 900;
          letter-spacing: .04em;
          text-overflow: ellipsis;
          text-transform: uppercase;
          white-space: nowrap;
        }

        .tech-service-category-all {
          color: var(--nexora-muted);
          font-size: 10px;
          font-weight: 800;
        }

        .tech-service-category-body {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
          gap: 6px;
          border-top: 1px solid var(--nexora-rule);
          padding: 8px;
        }

        .tech-service-catalog-state {
          border: 1px dashed var(--nexora-border);
          border-radius: 9px;
          background: #fff;
          padding: 14px 10px;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 700;
          text-align: center;
        }

        .tech-service-check {
          display: flex;
          min-height: 34px;
          align-items: center;
          gap: 6px;
          border: 1px solid var(--nexora-border);
          border-radius: 9px;
          background: #fff;
          padding: 7px 8px;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 700;
        }

        .tech-service-check input {
          width: 14px;
          height: 14px;
          flex: 0 0 auto;
          accent-color: var(--nexora-brand);
        }

        .tech-service-check:has(input:checked) {
          border-color: rgba(70, 72, 216, 0.42);
          background: color-mix(in srgb, var(--nexora-brand) 7%, white);
          color: var(--nexora-text);
        }

        .tech-service-check.is-all {
          grid-column: 1 / -1;
          border-color: rgba(70, 72, 216, 0.28);
          background: color-mix(in srgb, var(--nexora-brand) 5%, white);
          font-weight: 900;
        }

        .tech-schedule {
          display: grid;
          grid-template-columns: 1fr;
          gap: 7px;
        }

        .tech-schedule-row {
          display: grid;
          grid-template-columns: minmax(82px, 1fr) auto minmax(0, 300px);
          align-items: center;
          gap: 8px;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: #fff;
          padding: 8px;
          transition: border-color 0.2s, background 0.2s, opacity 0.2s;
        }

        .tech-schedule-row.is-day-off {
          border-color: var(--nexora-rule);
          background: var(--nexora-canvas);
          opacity: 0.62;
        }

        .tech-schedule-toggle {
          width: 16px;
          height: 16px;
          accent-color: var(--nexora-brand);
        }

        .tech-schedule-off {
          display: inline-flex;
          align-items: center;
          gap: 6px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 700;
          white-space: nowrap;
        }

        .tech-schedule-day {
          color: var(--nexora-text);
          font-size: 12px;
          font-weight: 800;
        }

        .tech-schedule-time {
          display: grid;
          grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
          align-items: center;
          gap: 6px;
        }

        .tech-schedule-time span {
          color: var(--nexora-muted);
          font-size: 10px;
          font-weight: 800;
          text-transform: uppercase;
        }

        .tech-schedule-time input {
          width: 100%;
          height: 32px;
          border: 1px solid var(--nexora-border);
          border-radius: 8px;
          background: #fff;
          padding: 0 8px;
          color: var(--nexora-text);
          font-size: 12px;
          font-weight: 700;
        }

        .tech-schedule-time input:disabled {
          background: var(--nexora-surface-muted);
          color: var(--nexora-subtle);
        }

        .tech-modal-actions {
          flex-shrink: 0;
          justify-content: flex-end;
          border-top: 1px solid var(--nexora-border);
          background: #fff;
          padding: 12px 16px;
        }

        @media (max-width: 767px) {
          .tech-modal {
            padding: 10px;
          }

          .tech-dialog {
            max-height: 92vh;
            border-radius: 12px;
          }

          .tech-modal-head {
            padding: 12px;
          }

          .tech-modal-body {
            grid-template-columns: 1fr;
            gap: 10px;
            padding: 10px;
          }

          .tech-choice-grid {
            max-height: 190px;
          }

          .tech-modal-grid {
            grid-template-columns: 1fr;
          }

          .tech-service-checks {
            grid-template-columns: repeat(auto-fit, minmax(76px, 1fr));
          }

          .tech-schedule-row {
            grid-template-columns: minmax(78px, 1fr) auto;
          }

          .tech-schedule-time {
            grid-column: 1 / -1;
          }
        }

        .sms-preview-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 10px;
        }

        .bottom-nav {
          position: fixed;
          right: 12px;
          bottom: 12px;
          left: 12px;
          z-index: 40;
          display: grid;
          grid-template-columns: repeat(5, 1fr);
          gap: 4px;
          border: 1px solid rgba(221, 229, 239, 0.95);
          border-radius: 18px;
          background: rgba(255, 255, 255, 0.96);
          padding: 8px;
          box-shadow: 0 16px 40px rgba(8, 31, 73, 0.16);
          backdrop-filter: blur(18px);
        }

        .bottom-nav button {
          display: flex;
          min-width: 0;
          flex-direction: column;
          align-items: center;
          gap: 4px;
          border: 0;
          border-radius: 12px;
          background: transparent;
          padding: 8px 4px;
          color: var(--nexora-muted);
          font-size: 10px;
          font-weight: 800;
        }

        .bottom-nav button.is-active {
          background: var(--nexora-brand);
          color: #fff;
        }

        .bottom-nav img {
          width: 22px;
          height: 22px;
          object-fit: contain;
        }

        /* Typography pass: keep hierarchy clear without making every label feel heavy. */
        .page-title,
        .settings-title,
        .trial-title {
          font-weight: 700;
        }

        .mode-switch button,
        .language-switcher button,
        .booking-subtab,
        .booking-primary-button,
        .booking-secondary-button,
        .booking-mini-button,
        .action-button,
        .plan-select-button,
        .voice-scenario-button,
        .quick-button,
        .owner-quick-button,
        .bottom-nav button,
        .trial-submit {
          font-weight: 700;
        }

        .card-title,
        .action-title,
        .owner-action-title,
        .owner-feed-copy,
        .booking-date,
        .booking-customer-name,
        .settings-card-title,
        .settings-config-title,
        .settings-service-name,
        .settings-template-name,
        .settings-offer-name,
        .service-plan-name,
        .business-name,
        .tech-name {
          font-weight: 700;
        }

        .kpi-value,
        .service-plan-price,
        .roi-value,
        .voice-number,
        .tech-stat strong {
          font-weight: 800;
        }

        .kpi-label,
        .badge,
        .card-meta,
        .owner-section-label,
        .owner-feed-time,
        .settings-eyebrow,
        .settings-sync-pill,
        .settings-mini-stat,
        .plan-rec,
        .plan-check,
        .booking-time-main,
        .trial-brand,
        .trial-benefit,
        .trial-chip,
        .trial-day,
        .trial-label,
        .trial-credit,
        .settings-status {
          font-weight: 700;
        }

        .kpi-label,
        .owner-section-label {
          letter-spacing: 0.05em;
        }

        .kpi-trend,
        .action-desc,
        .booking-customer-meta,
        .booking-time-date,
        .settings-card-sub,
        .settings-template-desc,
        .settings-offer-desc,
        .settings-save-copy,
        .plan-feature,
        .guarantee-grid,
        .voice-bubble,
        .voice-bridge,
        .voice-log-row,
        .tech-stat span,
        .trial-note,
        .trial-footer,
        .settings-progress {
          font-weight: 500;
        }

        @media (min-width: 640px) {
          .header {
            padding: 0 20px;
          }

          .search {
            display: block;
          }

          .language-switcher {
            display: inline-flex;
          }

          .profile-copy {
            display: block;
          }

          .page-title {
            font-size: 30px;
            line-height: 36px;
          }

          .page-description {
            font-size: 16px;
            line-height: 24px;
          }

          .voice-kpis {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }

          .owner-action-card {
            grid-template-columns: 36px minmax(0, 1fr) auto;
          }

          .owner-action-card .action-button {
            grid-column: auto;
          }

          .owner-quick-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
          }

          .roi-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
          }

          .guarantee-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }

          .trial-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }

          .trial-span-2 {
            grid-column: 1 / -1;
          }

          .settings-sync-grid {
            grid-template-columns: repeat(5, minmax(0, 1fr));
          }

          .settings-field-grid,
          .settings-location-grid,
          .settings-template-grid,
          .settings-offer-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }

          .settings-business-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }

          .settings-booking-policy-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
          }

          .settings-social-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }

          .settings-loyalty-form {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }

          .settings-offer-modal-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }

          .settings-offer-grid.is-list {
            grid-template-columns: 1fr;
          }

          .settings-config-row {
            grid-template-columns: minmax(120px, 0.4fr) minmax(0, 1fr);
          }

          .settings-service-row {
            grid-template-columns: minmax(0, 1fr) auto;
          }

          .settings-service-header {
            display: grid;
            grid-template-columns: 34px minmax(180px, 1fr) 76px 88px 28px 28px;
          }

          .settings-service-row.is-compact {
            grid-template-columns: 1fr;
          }

          .settings-service-edit-grid {
            grid-template-columns: 34px minmax(180px, 1fr) 76px 88px 28px 28px;
            align-items: center;
          }

          .settings-service-row.is-compact .settings-service-edit-grid {
            grid-template-columns: 34px minmax(180px, 1fr) 76px 88px 28px 28px;
          }

          .settings-service-row.is-compact .settings-service-edit-grid > .settings-service-input,
          .settings-service-row.is-compact .settings-service-input-wrap,
          .settings-service-row.is-compact .settings-service-edit,
          .settings-service-row.is-compact .settings-service-remove {
            grid-column: auto;
            grid-row: auto;
          }

          .settings-service-meta {
            justify-content: flex-end;
          }

          .settings-save-bar {
            grid-template-columns: minmax(0, 1fr) auto;
          }

          .quick-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
          }

          .booking-controls {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            align-items: end;
          }

          .booking-actions {
            grid-column: auto;
            justify-content: flex-end;
          }

          .sms-preview-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
          }

          .content {
            padding: 24px 24px 96px;
          }
        }

        @media (min-width: 1024px) {
          .plans-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
          }
        }

        @media (min-width: 1366px) {
          .sidebar {
            display: flex;
          }

          .app-area {
            padding-left: 288px;
          }

          .mobile-brand {
            display: none;
          }

          .header {
            padding: 0 28px;
          }

          .content {
            padding: 28px;
          }

          .blank-stage {
            min-height: calc(100vh - 120px);
          }

          .overview-grid {
            grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
          }

          .owner-dashboard-grid {
            grid-template-columns: minmax(0, 1fr) minmax(320px, 1fr);
          }

          .booking-grid {
            grid-template-columns: 1fr;
          }

          .booking-controls {
            grid-template-columns: minmax(130px, 0.7fr) minmax(220px, 1.4fr) repeat(2, minmax(140px, 0.75fr)) auto;
          }

          .voice-grid {
            grid-template-columns: minmax(0, 1fr) minmax(320px, 0.85fr);
          }

          .plans-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
          }

          .settings-grid,
          .settings-two-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }

          .settings-template-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
          }

          .settings-offer-grid.is-list {
            grid-template-columns: 1fr;
          }

          .bottom-nav {
            display: none;
          }
        }

        @media (max-width: 767px) {
          #panel-settings .settings-hero.is-compact {
            padding: 11px 12px;
          }

          #panel-settings .settings-hero.is-compact .settings-eyebrow {
            display: inline-flex;
            gap: 5px;
            padding: 4px 7px;
            font-size: 8px;
            line-height: 1;
            vertical-align: middle;
          }

          #panel-settings .settings-hero.is-compact .settings-title {
            display: inline;
            margin: 0 0 0 7px;
            font-size: 16px;
            line-height: 1.18;
            vertical-align: middle;
          }

          #panel-settings .settings-hero.is-compact .settings-desc {
            margin-top: 8px;
            font-size: 11px;
            line-height: 1.38;
          }

          .tech-card {
            flex: 0 1 100%;
            width: 100%;
            max-width: 100%;
          }

          .tech-top {
            grid-template-columns: 36px minmax(0, 1fr) auto;
            gap: 9px;
          }

          .tech-avatar {
            width: 36px;
            height: 36px;
            font-size: 13px;
          }

          .booking-controls {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
          }

          .booking-filter-popover .booking-controls {
            display: flex;
            flex-direction: column;
          }

          .booking-controls .booking-control-field:nth-child(1) {
            grid-column: 1 / 2;
          }

          .booking-controls .booking-control-field:nth-child(2) {
            grid-column: 2 / 4;
          }

          .booking-controls .booking-control-field:nth-child(3) {
            grid-column: 1 / 2;
          }

          .booking-controls .booking-control-field:nth-child(4) {
            grid-column: 2 / 3;
          }

          .booking-controls .booking-clear-button {
            grid-column: 3 / 4;
            width: auto;
            min-width: 52px;
            padding: 0 10px;
          }

          .booking-table-wrap {
            overflow-x: visible;
            border: 0;
            background: transparent;
          }

          .booking-table {
            display: block;
            min-width: 0;
            border-collapse: separate;
            font-size: 12px;
          }

          .booking-table thead {
            display: none;
          }

          .booking-table tbody {
            display: grid;
            gap: 10px;
          }

          .booking-table-row {
            display: grid;
            gap: 10px;
            border: 1px solid var(--nexora-border);
            border-radius: 10px;
            background: #fff;
            padding: 12px;
            box-shadow: 0 8px 22px rgba(15, 23, 42, 0.05);
          }

          .booking-table td {
            display: grid;
            grid-template-columns: 76px minmax(0, 1fr);
            align-items: start;
            gap: 9px;
            border-top: 0;
            padding: 0;
          }

          .booking-table td::before {
            color: var(--nexora-subtle);
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 0.04em;
            line-height: 1.4;
            text-transform: uppercase;
          }

          .booking-table td:nth-child(1)::before {
            content: "Customer";
          }

          .booking-table td:nth-child(2)::before {
            content: "Service";
          }

          .booking-table td:nth-child(3)::before {
            content: "Technician";
          }

          .booking-table td:nth-child(4)::before {
            content: "Time";
          }

          .booking-table td:nth-child(5)::before {
            content: "Status";
          }

          .booking-table td:nth-child(6)::before {
            content: "Action";
          }

          /* Customer table — mobile card labels (override booking labels) */
          .cust-table td:nth-child(1)::before { content: "Customer"; }
          .cust-table td:nth-child(2)::before { content: "Phone"; }
          .cust-table td:nth-child(3)::before { content: "Group"; }
          .cust-table td:nth-child(4)::before { content: "Source"; }
          .cust-table td:nth-child(5)::before { content: "Visits"; }
          .cust-table td:nth-child(6)::before { content: "Last Visit"; }
          .cust-table td:nth-child(7)::before { content: "Action"; }

          /* Call Log table — mobile card labels */
          .call-table td:nth-child(1)::before { content: "Time"; }
          .call-table td:nth-child(2)::before { content: "Caller"; }
          .call-table td:nth-child(3)::before { content: "Phone"; }
          .call-table td:nth-child(4)::before { content: "Status"; }
          .call-table td:nth-child(5)::before { content: "Duration"; }
          .call-table td:nth-child(6)::before { content: "Notes"; }
          .call-table td:nth-child(7)::before { content: "Action"; }

          .booking-table[data-booking-table] td:nth-child(2)::before { content: "Customer"; }
          .booking-table[data-booking-table] td:nth-child(3)::before { content: "Service"; }
          .booking-table[data-booking-table] td:nth-child(4)::before { content: "Technician"; }
          .booking-table[data-booking-table] td:nth-child(5)::before { content: "Appointment"; }
          .booking-table[data-booking-table] td:nth-child(7)::before { content: "Status"; }
          .booking-table[data-booking-table] td:nth-child(8)::before { content: "Action"; }

          /* Chips stay auto-width (never stretch full-width) on mobile */
          .booking-status-chips {
            gap: 6px;
          }

          .booking-status-chip {
            flex: 0 0 auto;
            width: auto;
            padding: 6px 11px;
            font-size: 11px;
          }

          .booking-status-cell {
            white-space: normal;
          }

          .booking-status-cell .booking-status {
            justify-self: start;
            width: auto;
          }

          /* Badges in card cells size to content, not full-width */
          .booking-table td > .badge {
            justify-self: start;
            width: auto;
          }

          .booking-actions {
            min-width: 0;
            justify-content: flex-start;
          }

          .booking-detail-hero,
          .booking-detail-info-grid {
            grid-template-columns: 1fr;
          }

          .booking-detail-status-pill {
            justify-self: start;
          }

          #panel-plans .roi-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 6px;
          }

          #panel-plans .roi-metric {
            border-radius: 10px;
            padding: 9px 6px;
          }

          #panel-plans .roi-metric::before {
            top: -18px;
            right: -18px;
            width: 46px;
            height: 46px;
          }

          #panel-plans .roi-value {
            font-size: 20px;
            line-height: 1;
          }

          #panel-plans .roi-label {
            margin-top: 3px;
            font-size: 8.5px;
            line-height: 1.2;
          }

          #panel-overview {
            max-width: 100%;
            min-width: 0;
            overflow-x: hidden;
          }

          #panel-overview *,
          #panel-overview *::before,
          #panel-overview *::after {
            min-width: 0;
          }

          #panel-overview .overview-toolbar,
          #panel-overview .overview-kpis,
          #panel-overview .overview-grid,
          #panel-overview .owner-dashboard-grid,
          #panel-overview .owner-actions,
          #panel-overview .owner-side-stack,
          #panel-overview .overview-card {
            max-width: 100%;
          }

          #panel-overview .mode-switch {
            max-width: 100%;
          }

          #panel-overview .mode-switch button {
            padding: 0 10px;
          }

          #panel-overview .overview-card-pad {
            padding: 14px;
          }

          #panel-overview .overview-kpis {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 12px;
          }

          #panel-overview .overview-kpis > .kpi-card {
            flex-basis: calc(25% - 4.5px);
          }

          #panel-overview .overview-kpis .kpi-card {
            min-height: 78px;
            border-radius: 10px;
            padding: 5px 6px;
          }

          #panel-overview .overview-kpis .kpi-card::after {
            top: -14px;
            right: -14px;
            width: 48px;
            height: 48px;
          }

          #panel-overview .overview-kpis .kpi-top {
            align-items: flex-start;
            gap: 4px;
            margin-bottom: 7px;
          }

          #panel-overview .overview-kpis .kpi-icon {
            width: 24px;
            height: 24px;
            border-radius: 8px;
            font-size: 10px;
          }

          #panel-overview .overview-kpis .kpi-icon svg {
            width: 13px;
            height: 13px;
          }

          #panel-overview .overview-kpis .kpi-top .badge {
            max-width: 52px;
            padding: 4px 5px;
            font-size: 7.5px;
            line-height: 1.05;
            text-align: center;
            white-space: normal;
          }

          #panel-overview .overview-kpis .kpi-label {
            font-size: 7.5px;
            letter-spacing: 0.035em;
            line-height: 1.15;
          }

          #panel-overview .overview-kpis .kpi-value {
