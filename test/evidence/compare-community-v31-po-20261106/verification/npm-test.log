                  <h3><i class="bi bi-person-plus" aria-hidden="true"></i> <span data-cust-edit-title>Create customer</span></h3>
                  <button class="pos-icon-btn" type="button" data-cust-edit-close aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                </div>
                <div class="sms-mbody">
                  <label class="pos-inline-lbl" for="cf-name">Name</label>
                  <input class="pos-input" id="cf-name" data-cf-name style="width:100%;margin-bottom:8px" placeholder="Customer name">
                  <label class="pos-inline-lbl" for="cf-phone">Phone</label>
                  <input class="pos-input" id="cf-phone" data-cf-phone type="tel" style="width:100%;margin-bottom:8px" placeholder="(555) 555-5555">
                  <label class="pos-inline-lbl" for="cf-email">Email</label>
                  <input class="pos-input" id="cf-email" data-cf-email type="email" style="width:100%;margin-bottom:8px" placeholder="name@email.com">
                  <label class="pos-inline-lbl" for="cf-birthday">Birthday</label>
                  <input class="pos-input" id="cf-birthday" data-cf-birthday style="width:100%;margin-bottom:8px" placeholder="Jun 9, 2026">
                  <label class="pos-inline-lbl" for="cf-address">Address</label>
                  <input class="pos-input" id="cf-address" data-cf-address style="width:100%;margin-bottom:8px" placeholder="Street, city, state">
                  <label class="pos-inline-lbl" for="cf-type">Type</label>
                  <select class="pos-input" id="cf-type" data-cf-type style="width:100%;margin-bottom:8px"></select>
                  <label class="pos-inline-lbl" for="cf-status">Status</label>
                  <select class="pos-input" id="cf-status" data-cf-status style="width:100%">
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                  </select>
                  <div class="pos-warn-text" data-cust-edit-error style="margin-top:8px" hidden></div>
                </div>
                <div class="sms-mfoot" style="justify-content:flex-end">
                  <button class="pos-btn" type="button" data-cust-edit-close>Cancel</button>
                  <button class="pos-btn pos-btn-primary" type="button" data-cust-save><i class="bi bi-check2" aria-hidden="true"></i> Save</button>
                </div>
