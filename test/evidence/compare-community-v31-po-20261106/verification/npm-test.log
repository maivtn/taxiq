          function confirmSmsCreditPurchase() {
            var selectedPackage = getSelectedSmsCreditPackage();
            var selectedPayment = getSelectedSmsCreditPayment();
            if (selectedPayment.id === 'CARD' && !validateSmsCreditCardForm()) return;
            if (window.NEXORA_CREDITS && typeof window.NEXORA_CREDITS.addSmsTopupCredits === 'function') {
              window.NEXORA_CREDITS.addSmsTopupCredits(selectedPackage.credits);
            }
            updateCredits(state.credits + selectedPackage.credits);
            if (window.NEXORA_CREDITS && typeof window.NEXORA_CREDITS.recordSmsCreditPurchase === 'function') {
              window.NEXORA_CREDITS.recordSmsCreditPurchase({
                credits: selectedPackage.credits,
                balance: state.credits,
                packageName: selectedPackage.name,
                paymentMethod: selectedPayment.label
              });
            }
            if (window.NEXORA_CREDITS && typeof window.NEXORA_CREDITS.renderCreditsPage === 'function') {
              window.NEXORA_CREDITS.renderCreditsPage();
            }
            closeSmsCreditModal();
            showSmsCreditPurchaseSuccess(selectedPackage, selectedPayment);
          }

          function getSelectedVoiceCreditPackage() {
            return VOICE_CREDIT_PACKAGES.find(function(pkg) { return pkg.id === voiceCreditPackageId; }) || VOICE_CREDIT_PACKAGES[0];
          }

          function getSelectedVoiceCreditPayment() {
            return SMS_CREDIT_PAYMENT_METHODS.find(function(method) { return method.id === voiceCreditPaymentId; }) || SMS_CREDIT_PAYMENT_METHODS[0];
          }

          function renderVoiceCreditPackages() {
            var target = document.querySelector('[data-voice-credit-package-list]');
            if (!target) return;

            target.innerHTML = VOICE_CREDIT_PACKAGES.map(function(pkg) {
              var selected = pkg.id === voiceCreditPackageId;
              return '<button class="sms-credit-package' + (selected ? ' is-selected' : '') + (pkg.featured ? ' is-featured' : '') + '" type="button" data-voice-credit-package="' + pkg.id + '" aria-pressed="' + (selected ? 'true' : 'false') + '">' +
                '<span class="sms-credit-package-check" aria-hidden="true">✓</span>' +
                '<span class="sms-credit-package-name">' + pkg.name + '</span>' +
                '<span class="sms-credit-package-amount">' + pkg.credits.toLocaleString() + ' phút</span>' +
                '<span class="sms-credit-package-price">' + marketingMoney(pkg.price, { cents: true }) + '</span>' +
                '<span class="sms-credit-package-note">' + pkg.note + '</span>' +
