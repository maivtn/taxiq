          }
        };

        var FIRST_CALL_SMS_TEMPLATES = {
          'thanks-booking': {
            label: 'Thanks for Booking',
            text: 'Thanks for booking with Bitcoin Nail Bar! We’re excited to see you. Reply to this text with any questions or to learn about our current promotions.'
          },
          'first-time-welcome': {
            label: 'First-Time Welcome',
            text: 'Thanks for calling Bitcoin Nail Bar! We’re glad to have you. Reply here anytime with questions, or ask about booking your next visit.'
          },
          'promo-teaser': {
            label: 'Promotion Teaser',
            text: 'Thanks for calling Bitcoin Nail Bar! Ask us about this month’s promotions on your next visit — reply to this text with any questions.'
          }
        };

        function updatePromoCount() {
          var textarea = document.querySelector('[data-settings-promo]');
          var counter = document.querySelector('[data-promo-count]');
          if (!textarea || !counter) return;

          var max = parseInt(textarea.getAttribute('maxlength'), 10) || 1000;
          var len = textarea.value.length;
          counter.textContent = len;
          var wrap = counter.closest('.settings-promo-count');
          if (wrap) wrap.classList.toggle('is-max', len >= max);
        }

        function fillPromoTemplate(key) {
          var template = PROMO_TEMPLATES[key];
          var textarea = document.querySelector('[data-settings-promo]');
          if (!template || !textarea) return;

          var max = parseInt(textarea.getAttribute('maxlength'), 10) || 1000;
          textarea.value = template.text.slice(0, max);
          textarea.focus();
          updatePromoCount();
          setSettingsStatus('Promotion template filled in: ' + template.label + '. Edit it for your salon, then click Save.');
        }

        function fillGreetingTemplate(key) {
          var template = GREETING_TEMPLATES[key];
          var textarea = document.querySelector('[data-settings-greeting]');
          if (!template || !textarea) return;

          textarea.value = template.text;
          textarea.focus();
          setSettingsStatus('Greeting template filled in: ' + template.label + '. Edit it for your salon, then click Save.');
        }

        function fillFirstCallSmsTemplate(key) {
          var template = FIRST_CALL_SMS_TEMPLATES[key];
          var textarea = document.querySelector('[data-settings-first-call-sms-message]');
          if (!template || !textarea) return;

          var max = parseInt(textarea.getAttribute('maxlength'), 10) || 320;
          textarea.value = template.text.slice(0, max);
          textarea.focus();
          setSettingsStatus('First-call SMS template filled in: ' + template.label + '. Edit it for your salon, then click Save.');
        }

        function addSettingsServiceRow(name, price, duration, categoryId, categoryName) {
          var list = categoryId
            ? settingsEnsureCategory(categoryId, categoryName)
            : settingsEnsureCustomCategory();
          if (!list) return;

          var rowIndex = list.querySelectorAll('[data-service-row]').length;
          var serviceId = 'custom-' + Date.now();
          list.insertAdjacentHTML('beforeend', settingsServiceRowMarkup({
            id: serviceId,
            name: name,
            price: Number(price),
            durationMin: Number(duration),
            icon: '✨'
          }, rowIndex));
          updateSettingsServiceCategoryCount(list.closest('[data-service-category]'));
          var managedCategory = settingsEnsureManagedCategory(categoryId || 'custom-services', categoryName || 'CUSTOM SERVICES');
          managedCategory.services.push({ id: serviceId, name: name, price: Number(price), durationMin: Number(duration), icon: '✨' });
          renderSettingsCategoryManager();
          setSettingsStatus('Service added: ' + name + '.');
        }

        function getSettingsServiceModalField(name) {
          var field = document.querySelector('[data-service-modal-field="' + name + '"]');
          return field ? field.value.trim() : '';
        }

        function setSettingsServiceModalError(message) {
          var error = document.querySelector('[data-service-modal-error]');
          if (!error) return;

          error.textContent = message || '';
          error.hidden = !message;
        }

        function setSettingsServiceModalMode(mode) {
          var title = document.querySelector('[data-service-modal-title]');
          var sub = document.querySelector('[data-service-modal-sub]');
          var saveButton = document.querySelector('[data-service-modal-save]');
          if (mode === 'edit') {
            if (title) title.textContent = 'Edit service';
            if (sub) sub.textContent = 'Update the service details, then save your changes.';
            if (saveButton) saveButton.innerHTML = '<i class="bi bi-check-lg" aria-hidden="true"></i>Save changes';
          } else {
            if (title) title.textContent = 'Add service';
            if (sub) sub.textContent = 'Enter the service details, then choose a category for it.';
            if (saveButton) saveButton.innerHTML = '<i class="bi bi-plus-lg" aria-hidden="true"></i>Add service';
          }
        }

        function openSettingsServiceModal() {
          var modal = document.querySelector('[data-service-modal]');
          if (!modal) return;

          settingsServiceEditContext = null;
          populateSettingsServiceModalCategories();
          ['name', 'description', 'price', 'duration'].forEach(function(name) {
            var field = document.querySelector('[data-service-modal-field="' + name + '"]');
            if (field) field.value = '';
          });
          setSettingsServiceModalMode('add');
          setSettingsServiceModalError('');
          modal.hidden = false;
          document.body.style.overflow = 'hidden';

          var firstField = document.querySelector('[data-service-modal-field="name"]');
          if (firstField) firstField.focus();
        }

        function findSettingsManagedService(serviceId, categoryId) {
          var category = settingsManagedCategories.find(function(item) { return item.id === categoryId; });
          var service = category ? category.services.find(function(item) { return item.id === serviceId; }) : null;
          return { category: category, service: service };
        }

        function openSettingsServiceModalForEdit(serviceId, categoryId) {
          var modal = document.querySelector('[data-service-modal]');
          if (!modal) return;

          var found = findSettingsManagedService(serviceId, categoryId);
          if (!found.service) return;

          settingsServiceEditContext = { serviceId: serviceId, categoryId: categoryId };
          populateSettingsServiceModalCategories();

          var categoryField = document.querySelector('[data-service-modal-field="category"]');
          if (categoryField) categoryField.value = categoryId;

          var values = {
            name: found.service.name,
            description: found.service.description,
            price: found.service.price,
            duration: found.service.durationMin
          };
          ['name', 'description', 'price', 'duration'].forEach(function(name) {
            var field = document.querySelector('[data-service-modal-field="' + name + '"]');
            if (field) field.value = values[name] == null ? '' : values[name];
          });

          setSettingsServiceModalMode('edit');
          setSettingsServiceModalError('');
          modal.hidden = false;
          document.body.style.overflow = 'hidden';

          var firstField = document.querySelector('[data-service-modal-field="name"]');
          if (firstField) firstField.focus();
        }

        function closeSettingsServiceModal() {
          var modal = document.querySelector('[data-service-modal]');
          if (!modal) return;

          modal.hidden = true;
          settingsServiceEditContext = null;
          setSettingsServiceModalError('');
          document.body.style.overflow = '';
        }

        function updateSettingsServiceRow(serviceId, previousCategoryId, updates) {
          var found = findSettingsManagedService(serviceId, previousCategoryId);
          if (!found.service) return;

          var previousRow = document.querySelector('[data-service-row][data-service-id="' + serviceId + '"]');
          var previousCategoryEl = previousRow ? previousRow.closest('[data-service-category]') : null;

          found.service.name = updates.name;
          found.service.price = updates.price;
          found.service.durationMin = updates.durationMin;
          if (updates.description) {
            found.service.description = updates.description;
          } else {
            delete found.service.description;
          }

          if (updates.categoryId === previousCategoryId) {
            if (previousRow) {
              var inputs = previousRow.querySelectorAll('.settings-service-input');
              if (inputs[0]) inputs[0].value = found.service.name;
              if (inputs[1]) inputs[1].value = found.service.price;
              if (inputs[2]) inputs[2].value = found.service.durationMin;
            }
            setSettingsStatus('Service updated: ' + found.service.name + '.');
            return;
          }

          found.category.services = found.category.services.filter(function(item) { return item.id !== serviceId; });
          if (previousRow) previousRow.remove();
          updateSettingsServiceCategoryCount(previousCategoryEl);

          var nextCategory = settingsEnsureManagedCategory(updates.categoryId, updates.categoryName);
          nextCategory.services.push(found.service);
          var nextList = settingsEnsureCategory(updates.categoryId, updates.categoryName);
          if (nextList) {
            nextList.insertAdjacentHTML('beforeend', settingsServiceRowMarkup(found.service, nextList.querySelectorAll('[data-service-row]').length));
            updateSettingsServiceCategoryCount(nextList.closest('[data-service-category]'));
          }
          renderSettingsCategoryManager();
          setSettingsStatus('Service updated: ' + found.service.name + '.');
        }

        function saveSettingsServiceModal() {
          var name = getSettingsServiceModalField('name');
          var priceValue = getSettingsServiceModalField('price');
          var durationValue = getSettingsServiceModalField('duration');
          var description = getSettingsServiceModalField('description');
          var categoryField = document.querySelector('[data-service-modal-field="category"]');
          var categoryOption = categoryField && categoryField.options[categoryField.selectedIndex];
          var categoryId = categoryField ? categoryField.value : 'custom-services';
          var categoryName = categoryOption ? categoryOption.textContent.trim() : 'CUSTOM SERVICES';
          var price = Number(priceValue);
          var duration = Number(durationValue);
          var field;

          if (!name) {
            setSettingsServiceModalError('Service name is required.');
            field = document.querySelector('[data-service-modal-field="name"]');
            if (field) field.focus();
            return;
          }

          if (!priceValue || !Number.isFinite(price) || price < 0) {
            setSettingsServiceModalError('Price must be a valid number.');
            field = document.querySelector('[data-service-modal-field="price"]');
            if (field) field.focus();
            return;
          }

          if (!durationValue || !Number.isFinite(duration) || duration <= 0) {
            setSettingsServiceModalError('Minutes must be greater than 0.');
            field = document.querySelector('[data-service-modal-field="duration"]');
            if (field) field.focus();
            return;
          }

          if (settingsServiceEditContext) {
            updateSettingsServiceRow(settingsServiceEditContext.serviceId, settingsServiceEditContext.categoryId, {
              name: name,
              price: price,
              durationMin: duration,
              description: description,
              categoryId: categoryId,
              categoryName: categoryName
            });
            closeSettingsServiceModal();
            return;
          }

          addSettingsServiceRow(name, price, duration, categoryId, categoryName);
          closeSettingsServiceModal();
        }

        function showServiceScanPanel() {
          var panel = document.querySelector('[data-service-scan]');
          var progress = document.querySelector('[data-service-scan-progress]');
          if (!panel || !progress) return;

          panel.hidden = false;
          progress.innerHTML = '✓ Open camera / upload menu photo<br>✓ AI reads the menu photo<br>✓ Detects service names, prices, and durations<br>✓ Adds new services to the list below';
          setSettingsStatus('Menu scan flow ready.');
        }

        function toggleServiceSuggestPanel() {
          var panel = document.querySelector('[data-service-suggest]');
          if (!panel) return;

          panel.hidden = !panel.hidden;
          setSettingsStatus(panel.hidden ? 'Industry suggestions hidden.' : 'Industry suggestions opened.');
        }

        function runSettingsAction(action) {
          if (action === 'photo') {
            showServiceScanPanel();
            return;
          }

          if (action === 'suggest') {
            toggleServiceSuggestPanel();
            return;
          }

          if (action === 'preview') {
            setSettingsStatus('Playing an AI Voice greeting preview.');
            return;
          }

          if (action === 'save') {
            setSettingsStatus('Settings saved. AI Voice, SMS, LP, Schema, and Booking Book are all in sync.');
          }
        }

        function filterSettingsTemplates(filter, activeButton) {
          document.querySelectorAll('[data-template-filter]').forEach(function(button) {
            button.classList.toggle('is-active', button === activeButton);
          });

          document.querySelectorAll('[data-template-cat]').forEach(function(card) {
            card.hidden = filter !== 'all' && card.dataset.templateCat !== filter;
          });

          setSettingsStatus(filter === 'all' ? 'Showing all promotion templates.' : 'Filtered templates: ' + activeButton.textContent.trim() + '.');
        }

        function toggleSettingsCollapse(button) {
          if (!button) return;

          var section = button.closest('.settings-card, .settings-template-library, .settings-subsection');
          if (!section) return;

          var isCollapsed = section.classList.toggle('is-collapsed');
          button.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
          button.setAttribute('aria-label', isCollapsed ? 'Expand this section' : 'Collapse this section');
        }

        function syncFirstCallSmsToggle(toggle) {
          if (!toggle) return;

          var enabled = toggle.classList.contains('is-on');
          toggle.setAttribute('aria-checked', enabled ? 'true' : 'false');
          toggle.setAttribute('aria-label', enabled ? 'Disable first-call SMS' : 'Enable first-call SMS');
          var label = document.querySelector('[data-settings-first-call-sms-toggle-label]');
          if (label) {
            label.textContent = enabled ? 'On · Auto send' : 'Off';
            label.classList.toggle('is-off', !enabled);
          }
        }

        function syncBookingSmsNotificationToggle(toggle) {
          if (!toggle) return;

          var enabled = toggle.classList.contains('is-on');
          var recipient = toggle.dataset.settingsBookingSmsRecipient || 'booking recipient';
          var row = toggle.closest('[data-settings-booking-sms-row]');
          var status = row ? row.querySelector('[data-settings-booking-sms-status]') : null;

          toggle.setAttribute('aria-checked', enabled ? 'true' : 'false');
          toggle.setAttribute('aria-label', enabled ? 'Disable ' + recipient.toLowerCase() + ' booking SMS' : 'Enable ' + recipient.toLowerCase() + ' booking SMS');
          if (status) {
            status.textContent = enabled ? 'On' : 'Off';
            status.classList.toggle('is-off', !enabled);
          }
        }

        function syncBookingPoliciesPreview() {
          var toggle = document.querySelector('[data-settings-booking-policy-toggle]');
          var deposit = document.querySelector('[data-settings-booking-policy-deposit]');
          var minPrice = document.querySelector('[data-settings-booking-policy-min-price]');
          var cancellationWindow = document.querySelector('[data-settings-booking-policy-cancellation-window]');
          var noShowFee = document.querySelector('[data-settings-booking-policy-no-show-fee]');
          var preview = document.querySelector('[data-settings-booking-policy-preview-text]');
          var label = document.querySelector('[data-settings-booking-policy-toggle-label]');
          if (!preview) return;

          var enabled = !toggle || toggle.classList.contains('is-on');
          var depositText = deposit && deposit.value.trim() ? deposit.value.trim() : '20% of service price';
          var minPriceText = minPrice && minPrice.value.trim() ? minPrice.value.trim() : '$75';
          var cancellationWindowText = cancellationWindow && cancellationWindow.value.trim() ? cancellationWindow.value.trim() : '2h';
          var noShowFeeText = noShowFee && noShowFee.value.trim() ? noShowFee.value.trim() : '$20';

          if (toggle) {
            toggle.setAttribute('aria-checked', enabled ? 'true' : 'false');
            toggle.setAttribute('aria-label', enabled ? 'Disable deposit requirement' : 'Enable deposit requirement');
          }
          if (label) label.textContent = enabled ? 'Require deposit' : 'Deposit not required';

          preview.textContent = enabled
            ? '"A ' + depositText + ' deposit is required for services ' + minPriceText + '+. Cancel ' + cancellationWindowText + ' ahead to avoid a ' + noShowFeeText + ' no-show fee."'
            : '"No deposit is required. Cancel ' + cancellationWindowText + ' ahead to avoid a ' + noShowFeeText + ' no-show fee."';
        }

        var settingsLanguageGreetings = {
          auto: 'Hi! Thanks for calling Bitcoin Nail Bar. I\'m your bilingual AI assistant — I can help you book an appointment, check pricing, or answer questions in English or Vietnamese. How can I help today?',
          vi: 'Xin chào! Cảm ơn bạn đã gọi đến Bitcoin Nail Bar. Tôi là trợ lý AI của tiệm. Tôi có thể giúp bạn đặt lịch hẹn, kiểm tra giá hoặc giải đáp thắc mắc. Hôm nay tôi có thể giúp gì cho bạn?',
          en: 'Hello! Thank you for calling Bitcoin Nail Bar. This is the AI assistant. I can help you book an appointment, check prices, or answer questions. How can I help today?'
        };

        var settingsLanguageStatusText = {
          auto: 'Auto is on: the AI automatically detects Vietnamese or English when a customer calls.',
          vi: 'Vietnamese is active: the AI greets and answers customers in Vietnamese first.',
          en: 'English is active: AI greets and answers customers in English.'
        };

