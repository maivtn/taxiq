        function selectServicePlan(plan) {
          var labels = {
            Starter: 'Choose Starter',
            Pro: 'Choose Pro',
            Elite: 'Choose Elite'
          };

          document.querySelectorAll('[data-plan-card]').forEach(function(card) {
            card.classList.toggle('is-selected', card.dataset.planCard === plan.toLowerCase());
