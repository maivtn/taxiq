          }

          .settings-service-row.is-compact {
            grid-template-columns: 1fr;
          }

          .settings-service-edit-grid {
            grid-template-columns: 34px minmax(180px, 1fr) 76px 88px 28px 28px;
            align-items: center;
          }

          .settings-service-row.is-compact .settings-service-edit-grid {
            grid-template-columns: 34px minmax(180px, 1fr) 76px 88px 28px 28px;
          }

          .settings-service-row.is-compact .settings-service-edit-grid > .settings-service-input,
          .settings-service-row.is-compact .settings-service-input-wrap,
          .settings-service-row.is-compact .settings-service-edit,
          .settings-service-row.is-compact .settings-service-remove {
            grid-column: auto;
            grid-row: auto;
          }

          .settings-service-meta {
            justify-content: flex-end;
          }

          .settings-save-bar {
            grid-template-columns: minmax(0, 1fr) auto;
          }

          .quick-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
          }

          .booking-controls {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            align-items: end;
          }

          .booking-actions {
            grid-column: auto;
            justify-content: flex-end;
          }

          .sms-preview-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
          }

          .content {
            padding: 24px 24px 96px;
          }
        }

        @media (min-width: 1024px) {
          .plans-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
          }
        }

        @media (min-width: 1366px) {
          .sidebar {
            display: flex;
          }

          .app-area {
            padding-left: 288px;
          }

          .mobile-brand {
            display: none;
          }

          .header {
            padding: 0 28px;
          }

          .content {
            padding: 28px;
          }

          .blank-stage {
            min-height: calc(100vh - 120px);
          }

          .overview-grid {
            grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
          }

          .owner-dashboard-grid {
            grid-template-columns: minmax(0, 1fr) minmax(320px, 1fr);
          }

          .booking-grid {
            grid-template-columns: 1fr;
          }

          .booking-controls {
            grid-template-columns: minmax(130px, 0.7fr) minmax(220px, 1.4fr) repeat(2, minmax(140px, 0.75fr)) auto;
          }

          .voice-grid {
            grid-template-columns: minmax(0, 1fr) minmax(320px, 0.85fr);
          }

          .plans-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
          }

          .settings-grid,
          .settings-two-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
          }

          .settings-template-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
          }

          .settings-offer-grid.is-list {
            grid-template-columns: 1fr;
          }

          .bottom-nav {
            display: none;
          }
        }

        @media (max-width: 767px) {
          #panel-settings .settings-hero.is-compact {
            padding: 11px 12px;
          }

          #panel-settings .settings-hero.is-compact .settings-eyebrow {
            display: inline-flex;
            gap: 5px;
            padding: 4px 7px;
            font-size: 8px;
            line-height: 1;
            vertical-align: middle;
          }

          #panel-settings .settings-hero.is-compact .settings-title {
            display: inline;
            margin: 0 0 0 7px;
            font-size: 16px;
            line-height: 1.18;
            vertical-align: middle;
          }

          #panel-settings .settings-hero.is-compact .settings-desc {
            margin-top: 8px;
            font-size: 11px;
            line-height: 1.38;
          }

          .tech-card {
            flex: 0 1 100%;
            width: 100%;
            max-width: 100%;
          }

          .tech-top {
            grid-template-columns: 36px minmax(0, 1fr) auto;
            gap: 9px;
          }

          .tech-avatar {
            width: 36px;
            height: 36px;
            font-size: 13px;
          }

          .booking-controls {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
          }

          .booking-filter-popover .booking-controls {
            display: flex;
            flex-direction: column;
          }

          .booking-controls .booking-control-field:nth-child(1) {
            grid-column: 1 / 2;
          }

          .booking-controls .booking-control-field:nth-child(2) {
            grid-column: 2 / 4;
          }

          .booking-controls .booking-control-field:nth-child(3) {
            grid-column: 1 / 2;
          }

          .booking-controls .booking-control-field:nth-child(4) {
            grid-column: 2 / 3;
          }

          .booking-controls .booking-clear-button {
            grid-column: 3 / 4;
            width: auto;
            min-width: 52px;
            padding: 0 10px;
          }

          .booking-table-wrap {
            overflow-x: visible;
            border: 0;
            background: transparent;
          }

          .booking-table {
            display: block;
            min-width: 0;
            border-collapse: separate;
            font-size: 12px;
          }

          .booking-table thead {
            display: none;
          }

          .booking-table tbody {
            display: grid;
            gap: 10px;
          }

          .booking-table-row {
            display: grid;
            gap: 10px;
            border: 1px solid var(--nexora-border);
            border-radius: 10px;
            background: #fff;
            padding: 12px;
            box-shadow: 0 8px 22px rgba(15, 23, 42, 0.05);
          }

          .booking-table td {
            display: grid;
            grid-template-columns: 76px minmax(0, 1fr);
            align-items: start;
            gap: 9px;
            border-top: 0;
            padding: 0;
          }

          .booking-table td::before {
            color: var(--nexora-subtle);
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 0.04em;
            line-height: 1.4;
            text-transform: uppercase;
          }

          .booking-table td:nth-child(1)::before {
            content: "Customer";
          }

          .booking-table td:nth-child(2)::before {
            content: "Service";
          }

          .booking-table td:nth-child(3)::before {
            content: "Technician";
          }

          .booking-table td:nth-child(4)::before {
            content: "Time";
          }

          .booking-table td:nth-child(5)::before {
            content: "Status";
          }

          .booking-table td:nth-child(6)::before {
            content: "Action";
          }

          /* Customer table — mobile card labels (override booking labels) */
          .cust-table td:nth-child(1)::before { content: "Customer"; }
          .cust-table td:nth-child(2)::before { content: "Phone"; }
          .cust-table td:nth-child(3)::before { content: "Group"; }
          .cust-table td:nth-child(4)::before { content: "Source"; }
          .cust-table td:nth-child(5)::before { content: "Visits"; }
          .cust-table td:nth-child(6)::before { content: "Last Visit"; }
          .cust-table td:nth-child(7)::before { content: "Action"; }

          /* Call Log table — mobile card labels */
          .call-table td:nth-child(1)::before { content: "Time"; }
          .call-table td:nth-child(2)::before { content: "Caller"; }
          .call-table td:nth-child(3)::before { content: "Phone"; }
          .call-table td:nth-child(4)::before { content: "Status"; }
          .call-table td:nth-child(5)::before { content: "Duration"; }
          .call-table td:nth-child(6)::before { content: "Notes"; }
          .call-table td:nth-child(7)::before { content: "Action"; }

          .booking-table[data-booking-table] td:nth-child(2)::before { content: "Customer"; }
          .booking-table[data-booking-table] td:nth-child(3)::before { content: "Service"; }
          .booking-table[data-booking-table] td:nth-child(4)::before { content: "Technician"; }
          .booking-table[data-booking-table] td:nth-child(5)::before { content: "Appointment"; }
          .booking-table[data-booking-table] td:nth-child(7)::before { content: "Status"; }
          .booking-table[data-booking-table] td:nth-child(8)::before { content: "Action"; }

          /* Chips stay auto-width (never stretch full-width) on mobile */
          .booking-status-chips {
            gap: 6px;
          }

          .booking-status-chip {
            flex: 0 0 auto;
            width: auto;
            padding: 6px 11px;
            font-size: 11px;
          }

          .booking-status-cell {
            white-space: normal;
          }

          .booking-status-cell .booking-status {
            justify-self: start;
            width: auto;
          }

          /* Badges in card cells size to content, not full-width */
          .booking-table td > .badge {
            justify-self: start;
            width: auto;
          }

          .booking-actions {
            min-width: 0;
            justify-content: flex-start;
          }

          .booking-detail-hero,
          .booking-detail-info-grid {
            grid-template-columns: 1fr;
          }

          .booking-detail-status-pill {
            justify-self: start;
          }

          #panel-plans .roi-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
