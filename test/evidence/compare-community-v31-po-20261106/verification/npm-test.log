        .category-chip-name { min-width: 0; overflow-wrap: anywhere; font-size: 12px; font-weight: 850; line-height: 1.15; }
        .category-chip-number { flex: 0 0 auto; min-width: 22px; border-radius: 999px; background: #e9edff; padding: 3px 7px; color: var(--nexora-brand); font-size: 11px; font-weight: 900; line-height: 1.1; text-align: center; }
