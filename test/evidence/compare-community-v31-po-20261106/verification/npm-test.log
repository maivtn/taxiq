      <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
      <style>
        :root {
          --luxury-gold: #d4af37;
          --brand-cyan: #32d7ff;
          --nexora-canvas: #f7f9fc;
          --nexora-surface: #ffffff;
          --nexora-surface-muted: #f3f6fa;
          --nexora-border: #dde5ef;
          --nexora-text: #0b1220;
          --nexora-muted: #4d5870;
          --nexora-subtle: #7a8296;
          --nexora-sidebar: #081f49;
          --nexora-brand: #4648d8;
          --nexora-electric: #2b59ff;
          --nexora-violet: #8e4df8;
          --nexora-card-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
          --nexora-soft-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
        }

        * {
          box-sizing: border-box;
          -webkit-tap-highlight-color: transparent;
        }

        .sr-only {
          position: absolute;
          width: 1px;
          height: 1px;
          padding: 0;
          margin: -1px;
          overflow: hidden;
          clip: rect(0, 0, 0, 0);
          white-space: nowrap;
          border: 0;
        }

        html,
        body {
          margin: 0;
          min-height: 100%;
          font-family: "Inter", sans-serif;
          background: var(--nexora-canvas);
          color: var(--nexora-text);
        }

        button,
        input,
        textarea,
        select {
          font: inherit;
        }

        button {
          cursor: pointer;
        }

        ::-webkit-scrollbar {
          width: 6px;
          height: 6px;
        }

        ::-webkit-scrollbar-track {
          background: rgba(0, 0, 0, 0.05);
        }

        ::-webkit-scrollbar-thumb {
          background: var(--brand-cyan);
          border-radius: 99px;
        }

        .shell {
          min-height: 100vh;
          background: var(--nexora-canvas);
        }

        .sidebar {
          position: fixed;
          inset: 0 auto 0 0;
          z-index: 30;
          display: none;
          width: 288px;
          flex-direction: column;
          background: var(--nexora-sidebar);
          color: #fff;
          padding: 28px 20px;
        }

        .sidebar-panel {
          flex-shrink: 0;
          border: 1px solid rgba(255, 255, 255, 0.15);
          border-radius: 12px;
          background: rgba(255, 255, 255, 0.05);
          padding: 16px;
        }

        .profile-row {
          display: flex;
          min-width: 0;
          align-items: center;
          gap: 12px;
        }

        .avatar {
          display: inline-flex;
          width: 40px;
          height: 40px;
          flex-shrink: 0;
          align-items: center;
          justify-content: center;
          border-radius: 999px;
          background: linear-gradient(135deg, var(--nexora-electric), var(--nexora-violet));
          color: #fff;
          font-size: 13px;
          font-weight: 800;
          text-transform: uppercase;
        }

        .profile-name {
          overflow: hidden;
          color: #fff;
          font-size: 14px;
          font-weight: 700;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .profile-email {
          margin-top: 2px;
