        <!-- ✦ Tạo SMS Campaign composer (ported from nexora-sms-dashboard.html) -->
        <div id="nx-campaign-root">
          <div class="modal-overlay" id="composerModal" aria-hidden="true">
            <div class="modal" role="dialog" aria-modal="true" aria-labelledby="composerModalTitle">
              <div class="modal-header">
                <div class="modal-title" id="composerModalTitle"><i class="marketing-icon" data-lucide="megaphone" aria-hidden="true"></i><span>Tạo SMS Campaign</span></div>
                <button class="modal-close" id="closeComposerBtn" aria-label="Đóng"><i class="marketing-icon" data-lucide="x" aria-hidden="true"></i></button>
              </div>
              <div class="modal-body">

                <!-- STEP 1: SEGMENT -->
                <div class="field-group">
