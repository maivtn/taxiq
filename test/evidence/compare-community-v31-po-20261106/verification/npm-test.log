          var TAG_SAMPLES = { '{TenKhach}': 'Linh', '{TenTiem}': 'Bitcoin Nail Bar', '{Link}': 'nexora.ai/b/x7k2', '{SoDT}': '832-786-5576' };
          var smsState = { segment: SEGMENTS[0], scheduleMode: 'now', credits: 847, confirming: false };
          var smsBannerTimer = null;
          function segById(id) { return SEGMENTS.find(function (s) { return s.id === id; }) || SEGMENTS[0]; }

          /* SMS part counting — GSM-7 is 160 chars/part (153 when concatenated, extended chars cost 2);
             UCS-2 (accented Vietnamese, emoji) drops to 70 (67 when concatenated). */
          var GSM7_BASIC = '@£$¥èéùìòÇ\nØø\rÅåΔ_ΦΓΛΩΠΨΣΘΞÆæßÉ !"#¤%&\'()*+,-./0123456789:;<=>?¡ABCDEFGHIJKLMNOPQRSTUVWXYZÄÖÑÜ§¿abcdefghijklmnopqrstuvwxyzäöñüà';
          var GSM7_EXT = '^{}\\[~]|€';
          function smsInfo(text) {
            if (!text) return { units: 0, parts: 0, encoding: 'GSM-7', perPart: 160 };
            var isUnicode = false, gsmUnits = 0;
            for (var ch of text) {
              if (GSM7_BASIC.indexOf(ch) !== -1) gsmUnits += 1;
              else if (GSM7_EXT.indexOf(ch) !== -1) gsmUnits += 2;
              else { isUnicode = true; break; }
            }
            if (isUnicode) {
              var u = text.length;   // UTF-16 units = UCS-2 units (emoji counts as 2)
              return { units: u, parts: u <= 70 ? 1 : Math.ceil(u / 67), encoding: 'UCS-2', perPart: u <= 70 ? 70 : 67 };
            }
            return { units: gsmUnits, parts: gsmUnits <= 160 ? 1 : Math.ceil(gsmUnits / 153), encoding: 'GSM-7', perPart: gsmUnits <= 160 ? 160 : 153 };
          }

          function renderCampaignCards() {
