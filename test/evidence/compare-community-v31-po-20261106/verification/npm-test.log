          function sendCampaign() {
            var text = $('[data-sms-text]').value.trim();
            if (!text) { toast('Vui lòng soạn nội dung SMS trước.', 'info'); return; }
            var schedDate = $('[data-sched-date]').value, schedHm = $('[data-sched-hm]').value;
            if (smsState.scheduleMode === 'schedule' && !schedDate) { toast('Vui lòng chọn ngày gửi.', 'info'); return; }

            var info = smsInfo(text);
            var totalSms = smsState.segment.count * info.parts;
            if (smsState.credits < totalSms) { toast('Không đủ credits: cần ' + totalSms + ', còn ' + smsState.credits + '.', 'error'); return; }

            // Two-step send: the first tap shows the details, the second actually sends.
            if (!smsState.confirming) {
              smsState.confirming = true;
              var when = smsState.scheduleMode === 'now' ? 'Gửi ngay lập tức'
                : smsState.scheduleMode === 'schedule' ? 'Hẹn giờ: ' + schedDate + ' lúc ' + schedHm
                : 'Tự động theo điều kiện segment';
              html('[data-confirm-detail]',
                'Nhóm: <strong>' + esc(smsState.segment.name) + '</strong> (' + smsState.segment.count + ' khách)<br>' +
                'Số tin: <strong>' + totalSms + ' SMS</strong> (' + info.parts + ' tin/khách, ' + info.encoding + ')<br>' +
                'Chi phí: <strong>' + money(totalSms * PRICE_PER_SMS) + '</strong> — trừ ' + totalSms + ' credits<br>' +
                'Lịch: <strong>' + esc(when) + '</strong>');
              $('[data-confirm-box]').classList.add('show');
              $('[data-confirm-box]').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
              set('[data-sms-send]', '✅ Xác nhận gửi');
              return;
            }

            smsState.credits -= totalSms;
            renderCredits();
            closeComposer();

            var msg = smsState.scheduleMode === 'now'
              ? '✅ Đã gửi ' + totalSms + ' SMS đến ' + smsState.segment.count + ' khách (' + smsState.segment.name + ').'
              : smsState.scheduleMode === 'schedule'
                ? '⏰ Đã lên lịch ' + totalSms + ' SMS — gửi ' + schedDate + ' lúc ' + schedHm + '.'
                : '🤖 Đã bật gửi tự động cho nhóm ' + smsState.segment.name + '.';
            set('[data-sms-banner-text]', msg);
            $('[data-sms-banner]').classList.add('show');
            clearTimeout(smsBannerTimer);
            smsBannerTimer = setTimeout(function () { $('[data-sms-banner]').classList.remove('show'); }, 6000);
          }

          function renderSms() { renderCampaignCards(); renderCredits(); }

          document.addEventListener('click', function (e) {
            var open = e.target.closest('[data-seg-open]');
            if (open) { openComposer(open.getAttribute('data-seg-open')); return; }
            if (e.target.closest('[data-sms-new]')) { openComposer('new'); return; }
            if (e.target.closest('[data-sms-close]') || e.target.closest('[data-sms-cancel]')) { closeComposer(); return; }
            // click on the backdrop itself (not the dialog) closes
            if (e.target.matches('[data-sms-modal]')) { closeComposer(); return; }

            var pick = e.target.closest('[data-seg-pick]');
            if (pick) {
              smsState.segment = segById(pick.getAttribute('data-seg-pick'));
              renderSegButtons();
              renderTemplates(smsState.segment.id);
              updateCost();
              if (smsState.confirming) resetConfirm();
              return;
            }

            var tpl = e.target.closest('[data-tpl]');
            if (tpl) {
              var t = (TEMPLATES[smsState.segment.id] || [])[+tpl.getAttribute('data-tpl')];
              if (t) { $('[data-sms-text]').value = t.text; updateCharCount(); }
              return;
            }

            var tag = e.target.closest('[data-tag]');
            if (tag) {
              var ta = $('[data-sms-text]');
              var v = tag.getAttribute('data-tag');
              var s0 = ta.selectionStart, e0 = ta.selectionEnd;
              ta.value = ta.value.slice(0, s0) + v + ta.value.slice(e0);
              ta.selectionStart = ta.selectionEnd = s0 + v.length;
              ta.focus();
              updateCharCount();
              return;
            }

            var sch = e.target.closest('[data-mode]');
            if (sch) {
              smsState.scheduleMode = sch.getAttribute('data-mode');
              document.querySelectorAll('[data-sched-row] .sched-opt').forEach(function (b) { b.classList.toggle('is-on', b === sch); });
              $('[data-sched-time]').classList.toggle('show', smsState.scheduleMode === 'schedule');
              if (smsState.confirming) resetConfirm();
              return;
            }

            if (e.target.closest('[data-sms-send]')) { sendCampaign(); return; }
          });

          document.addEventListener('input', function (e) {
            if (e.target.closest('[data-sms-text]')) updateCharCount();
            if (e.target.matches('[data-ci-phone]')) renderCheckinModalResults();
          });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && $('[data-sms-modal]').classList.contains('open')) closeComposer();
            if (e.key === 'Escape' && $('[data-ci-modal]').classList.contains('open')) closeCheckinModal();
            var swapModal = $('[data-swap-tech-modal]');
            if (e.key === 'Escape' && swapModal && swapModal.classList.contains('open')) closeSwapTechModal();
            var queueServiceModal = $('[data-queue-service-modal]');
            if (e.key === 'Escape' && queueServiceModal && queueServiceModal.classList.contains('open')) closeQueueServiceModal();
            var mgTechSelectMenu = $('[data-mg-tech-select-menu]');
            if (e.key === 'Escape' && mgTechSelectMenu && !mgTechSelectMenu.hidden) { setMgTechSelectOpen(false); return; }
            var mgTechModal = $('[data-mg-tech-modal]');
            if (e.key === 'Escape' && mgTechModal && !mgTechModal.hidden) closeTechModal();
          });

          document.addEventListener('click', function (e) {
            if (e.target.closest('[data-pos-mode-open]')) { openModeModal(); return; }
            var roleCard = e.target.closest('[data-pos-role]');
            if (roleCard) { selectModeRole(roleCard.getAttribute('data-pos-role')); return; }
            if (e.target.closest('[data-pos-mode-submit]')) { submitModeSwitch(); return; }
            if (e.target.closest('[data-pos-mode-close]') || e.target === modeModal) closeModeModal();
          });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && modeModal.classList.contains('open')) closeModeModal();
            if (e.key === 'Enter' && modeModal.classList.contains('open') && document.activeElement === modePin) submitModeSwitch();
          });

          /* ═══════════ tabs ═══════════ */
          function initBookingTab() {
            if (window.NEXORA_POS_BOOKING && typeof window.NEXORA_POS_BOOKING.init === 'function') window.NEXORA_POS_BOOKING.init();
          }
          function renderBookingTab() {
            if (window.NEXORA_POS_BOOKING && typeof window.NEXORA_POS_BOOKING.render === 'function') window.NEXORA_POS_BOOKING.render();
          }
          // URL compatibility during the transition: old links keep working, pointed at their new home.
          var TAB_ALIASES = { dispatch: 'tickets', appointments: 'booking' };
          var TABS = ['checkin', 'todaybooking', 'tickets', 'booking', 'estimate', 'customers', 'clock', 'management', 'printer'];
          var tabBtns = document.querySelectorAll('[data-pos-tab]');
          var panels = document.querySelectorAll('[data-pos-panel]');
          function activateTab(id) {
            if (TAB_ALIASES[id]) id = TAB_ALIASES[id];
            if (id === 'management' && getActiveStaff().role === 'frontdesk') id = 'todaybooking';
            if (TABS.indexOf(id) === -1) id = 'todaybooking';
            activeTabId = id;
            tabBtns.forEach(function (t) { t.classList.toggle('is-active', t.getAttribute('data-pos-tab') === id); });
            panels.forEach(function (p) { p.classList.toggle('is-active', p.getAttribute('data-pos-panel') === id); });
            var url = new URL(window.location.href);
            url.searchParams.set('tab', id);
            window.history.replaceState({ tab: id }, '', url.search);
            if (id === 'todaybooking' || id === 'tickets') renderFloor();
            if (id === 'estimate') estimateView.refresh();
            if (id === 'clock') renderClock();
            if (id === 'management') {
              resetServiceCategoryCollapses();
              renderManagement();
            }
            if (id === 'booking') { initBookingTab(); renderBookingTab(); }
            if (id === 'customers') renderCustomersTab();
            if (id !== 'sms') closeComposer();
            if (window.NEXORA_SHELL && window.NEXORA_SHELL.setActiveTab) window.NEXORA_SHELL.setActiveTab(id);
          }
          tabBtns.forEach(function (t) { t.addEventListener('click', function () { activateTab(t.getAttribute('data-pos-tab')); }); });

          // The sidebar's POS sub-items drive this page's tabs through the shell's navigate hook.
          window.activateMainTab = activateTab;

          var estimateView = window.NEXORA_POS_ESTIMATE.mount($('[data-pos-panel="estimate"]'), {
            getServices: function () { return salonCatalog.services; },
            checkIn: function (payload) {
              var known = custByPhone(payload.phone);
              var result = appointmentStore.create({
                customerName: known ? known.name : payload.customerName, phone: payload.phone,
                tickets: payload.tickets, status: 'confirmed', source: 'front-desk',
                note: 'Service estimate: ' + money(payload.estimate.totalCents / 100) +
                  ' after ' + (payload.estimate.type === 'percent' ? payload.estimate.value + '%' : money(payload.estimate.value)) +
                  ' discount. Tax and tip excluded. Confirm discount at checkout.',
                metadata: { estimate: payload.estimate }
              }, null, salonCatalog);
              if (!result.ok) return result;
              reloadAppointmentSnapshot();
              checkInBooking(posBookingById(result.record.id));
              activateTab('tickets');
              return result;
            }
          });

          /* ═══════════ boot ═══════════ */
          qclkRotate();
          renderFloor();
          renderClock();
          renderManagement();
          renderSms();
          initBookingTab();
          renderBookingTab();
          renderCustomersTab();
          loadMenuServicesIntoSalonCatalog();
          applyPosModeAccess();
          activateTab(new URL(window.location.href).searchParams.get('tab') || 'todaybooking');
          if (salonData.storageAvailable && !salonData.storageAvailable()) {
            setTimeout(function () { toast('Local changes are available in this tab; cross-tab sync is unavailable.', 'info'); }, 0);
          }

          // Wait / service / pay timers tick on their own; refresh the board while it is on screen.
          setInterval(function () {
            var todayBookingPanel = $('[data-pos-panel="todaybooking"]');
            var ticketsPanel = $('[data-pos-panel="tickets"]');
            var onScreen = (todayBookingPanel && todayBookingPanel.classList.contains('is-active')) || (ticketsPanel && ticketsPanel.classList.contains('is-active'));
            if (onScreen) renderFloor();
          }, 30000);

          // The QR token rotates every 15s; only tick while the Time Clock tab is visible.
          setInterval(function () {
            var panel = $('[data-pos-panel="clock"]');
            if (panel && panel.classList.contains('is-active')) renderQr();
          }, 1000);

          if (window.lucide && window.lucide.createIcons) window.lucide.createIcons();
        })();
      </script>
    </body>
    </html>

