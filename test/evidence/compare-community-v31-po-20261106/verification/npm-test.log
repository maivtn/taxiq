                      <option value="comeback">Comeback Offer July (nexora.ai/btcnailbar/comeback-offer-july)</option>
                      <option value="birthday">Birthday Special (nexora.ai/btcnailbar/birthday-july)</option>
                    </select>
                    <a class="btn-outline" id="createLpBtn" href="nexora-sms-dashboard.html?view=landingpage" target="_blank" rel="noopener"><i class="marketing-icon is-compact" data-lucide="plus" aria-hidden="true"></i><span>Tạo trang</span></a>
