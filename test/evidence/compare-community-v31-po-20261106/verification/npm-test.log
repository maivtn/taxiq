            var vipBadge = c.seg === 'vip' ? '<span class="pos-chip pos-chip-gold"><i class="bi bi-gem" aria-hidden="true"></i> VIP</span>' : '';
            var inactiveBadge = custStatusOf(c) === 'inactive' ? '<span class="pos-chip pos-chip-gray">Inactive</span>' : '';
            var cornerBadges = vipBadge + inactiveBadge;
            var tags = c.tags || [];
            var labelStyle = 'letter-spacing:.04em;text-transform:uppercase';
            return '<div class="wl-card cust-card perf-card">' +
              '<div class="perf-head">' +
                '<div class="perf-head-main">' +
                  '<button class="cust-card-name" type="button" data-cust-pick="' + esc(c.name) + '" style="display:block">' + esc(c.name) + '</button>' +
                  '<div class="perf-sub" style="font-size:13.5px">' + esc(c.phone || 'No phone on file') + '</div>' +
                '</div>' +
                (cornerBadges ? '<div style="margin-left:auto;flex-shrink:0">' + cornerBadges + '</div>' : '') +
              '</div>' +
              '<div class="perf-divider"></div>' +
              '<div class="perf-stat-row">' +
                '<div class="perf-stat-col"><span class="perf-section-label" style="' + labelStyle + '">Source</span>' + custSrcBadgeHtml(c) + '</div>' +
                '<div class="perf-stat-col"><span class="perf-section-label" style="' + labelStyle + '">Activity</span><span class="perf-stat-value">' + (c.visits || 0) + ' visits</span><span class="perf-stat-sub">Last ' + custLastVisitLabel(c) + '</span></div>' +
              '</div>' +
              '<div class="perf-divider"></div>' +
              '<div><span class="perf-section-label" style="' + labelStyle + '">Regular tech</span>' + custTechSummaryHtml(c) + '</div>' +
              (tags.length ? '<div class="perf-divider"></div><div><span class="perf-section-label" style="' + labelStyle + '">Tags</span><div class="pill-row">' + tags.map(function (tg) { return '<span class="cust-tag-chip is-on">' + esc(tg) + '</span>'; }).join('') + '</div></div>' : '') +
              '<div class="perf-divider"></div>' +
              '<div class="pos-inline" style="gap:10px">' +
                '<button class="pos-btn" style="flex:1;justify-content:center" type="button" data-cust-pick="' + esc(c.name) + '" title="View profile"><i class="bi bi-person-vcard" aria-hidden="true"></i> View</button>' +
                '<button class="pos-btn" style="flex:1;justify-content:center" type="button" data-cust-edit="' + ci + '" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>' +
              '</div>' +
            '</div>';
          }
          // Table mode — columns ported from the AI Hub Customers workspace (Customer/Phone/Group/Source/Visits/Last Visit/Action)
          // Which techs are a declared "Customer fit" for this guest — same rule matchScore() uses to
          // give a tech +MATCH_RULES.wFit at assignment: a tech's fit tag overlaps the guest's own
          // profile tags, or the guest is VIP and the tech lists 'VIP' as a fit (Management → Skills & Catalog).
          function custFitTechs(c) {
            return TECHS.filter(function (t) {
              return (t.fit || []).some(function (f) { return (c.tags || []).indexOf(f) !== -1 || (f === 'VIP' && c.seg === 'vip'); });
            });
          }
          function custFitHtml(c) {
            var techs = custFitTechs(c);
            if (!techs.length) return '—';
            return techs.map(function (t) { return '<span class="pos-chip pos-chip-blue"><i class="bi bi-person-check-fill" aria-hidden="true"></i> ' + esc(t.name) + '</span>'; }).join(' ');
          }
          // Shared badge for Source (how the customer was acquired) — used by both the table and the profile modal.
          function custSrcBadgeHtml(c) {
            var src = CUST_SRC_META[c.src];
            return src ? '<span class="pos-chip pos-chip-gray"><i class="bi ' + src.icon + '" aria-hidden="true"></i> ' + esc(src.label) + '</span>' : '—';
          }
          // Shared by the Customers list and profile surfaces so tags & three-level notes stay in sync.
          var NOTE_LEVELS = [
            ['owner', '<i class="bi bi-lock-fill" aria-hidden="true"></i> Owner only', 'var(--nexora-danger)'],
            ['staff', '<i class="bi bi-people-fill" aria-hidden="true"></i> Techs / front desk', 'var(--nexora-warning)'],
            ['customer', '<i class="bi bi-phone" aria-hidden="true"></i> Guest sees', 'var(--nexora-success)']
          ];
          function toggleCustTag(ci, tag) {
            var c = CUSTOMERS[ci]; if (!c) return;
            c.tags = c.tags || [];
            var ti = c.tags.indexOf(tag);
            if (ti >= 0) c.tags.splice(ti, 1); else c.tags.push(tag);
          }
          function saveCustNoteLevel(ci, level, value) {
            var c = CUSTOMERS[ci]; if (!c) return;
            c.notes = c.notes || { owner: '', staff: '', customer: '' };
            value = value.trim();
            if (c.notes[level] !== value) logAdmin('🏷️ Note (' + level + ') edited for ' + c.name);
            c.notes[level] = value;
          }
          // Customer profile — tags & three-level notes.
          function custNoteLevelsHtml(c, ci) {
            return '<div class="cust-note-levels">' + NOTE_LEVELS.map(function (l) {
              return '<div class="pos-inline" style="gap:6px;margin:3px 0;flex-wrap:nowrap">' +
                '<span style="font-size:12px;font-weight:800;color:' + l[2] + ';white-space:nowrap;width:120px">' + l[1] + '</span>' +
                '<input class="pos-mini text" data-mg-note="' + ci + '|' + l[0] + '" value="' + esc((c.notes && c.notes[l[0]]) || '') + '" placeholder="—"></div>';
            }).join('') + '</div>';
          }
          function custFrequentTechIds(c) {
            var counts = {}, lastSeen = {}, history = CUSTHIST[c.name] || [];
            history.forEach(function (visit, index) {
              if (!visit.techId || !techById(visit.techId)) return;
              counts[visit.techId] = (counts[visit.techId] || 0) + 1;
              lastSeen[visit.techId] = index;
            });
            var ids = Object.keys(counts).sort(function (a, b) {
              return counts[b] - counts[a] || lastSeen[b] - lastSeen[a];
            });
            var preferred = Array.isArray(c.prefTech) ? c.prefTech[0] : c.prefTech;
            if (preferred && techById(preferred)) {
              ids = ids.filter(function (id) { return id !== preferred; });
              ids.unshift(preferred);
            }
            return ids.slice(0, 3);
          }
          function custPrefTechChipsHtml(c, ci) {
            var frequentIds = custFrequentTechIds(c);
            if (!frequentIds.length) return '<span class="pos-muted">No frequent tech yet</span>';
            return '<div class="cust-pref-tech-list">' + frequentIds.map(function (id) {
              var t = techById(id);
              var active = c.prefTech === t.id;
              return '<span class="cust-pref-tech-chip' + (active ? ' is-on' : '') + '">' +
                '<i class="bi bi-person" aria-hidden="true"></i> ' + esc(t.name) + '</span>';
            }).join('') + '</div>';
          }
          // Editing tags/notes/regular-tech happens in the profile modal (View), not inline in the list —
          // that's what let the table collapse from 11 columns down to 7 on narrower screens.
          // Shared summary lines for both table rows and cards: regular tech chip and tags
          // (max 3 shown, "+N" for the rest) — kept in one place so table/card never drift apart.
          function custTechSummaryHtml(c) {
            var techIds = Array.isArray(c.prefTech) ? c.prefTech : (c.prefTech ? [c.prefTech] : []);
            var chips = techIds.map(function (id) {
              var name = techName(id);
              return name === '—' ? '' : '<span class="cust-pref-tag is-on"><i class="bi bi-person" aria-hidden="true"></i>' + esc(name) + '</span>';
            }).filter(Boolean).join('');
            return chips ? '<span class="cust-tech-chip-row">' + chips + '</span>' : '—';
          }
          function custTagsSummaryHtml(c) {
            var tags = c.tags || [];
            if (!tags.length) return '—';
            var visible = tags.slice(0, 3), extra = tags.length - visible.length;
            return '<span class="cust-tag-chip-row">' + visible.map(function (t) { return '<span class="cust-tag-chip is-on">' + esc(t) + '</span>'; }).join('') +
              (extra > 0 ? '<span class="pos-muted" style="font-size:12px;font-weight:700">+' + extra + '</span>' : '') + '</span>';
          }
          // Table mode: 7 columns instead of 11 — Customer/Status/Source/Activity/Technician/Tags/Action —
          // so the table stays usable on an iPad landscape width instead of forcing horizontal scroll.
          function custTableRowHtml(c) {
            var ci = CUSTOMERS.indexOf(c);
            var seg = CUST_SEG_META[c.seg];
            var segHtml = seg ? '<span class="pos-chip ' + seg.chip + '"><i class="bi ' + seg.icon + '" aria-hidden="true"></i> ' + esc(seg.label) + '</span>' : '—';
            var inactiveTag = custStatusOf(c) === 'inactive' ? ' <span class="pos-chip pos-chip-gray">Inactive</span>' : '';
            return '<tr class="booking-table-row">' +
              '<td><button class="booking-customer-name" type="button" data-cust-pick="' + esc(c.name) + '" style="background:none;border:0;padding:0;cursor:pointer;text-align:left;color:inherit;font:inherit">' + esc(c.name) + '</button>' + inactiveTag +
                '<div class="cust-table-sub">' + esc(c.phone || '—') + '</div></td>' +
              '<td>' + segHtml + '</td>' +
              '<td>' + custSrcBadgeHtml(c) + '</td>' +
              '<td>' + (c.visits || 0) + ' visits<div class="cust-table-sub">Last ' + custLastVisitLabel(c) + '</div></td>' +
              '<td>' + custTechSummaryHtml(c) + '</td>' +
              '<td>' + custTagsSummaryHtml(c) + '</td>' +
              '<td><div class="wl-actions">' +
                '<button class="pos-btn pos-btn-sm" type="button" data-cust-pick="' + esc(c.name) + '" title="View profile"><i class="bi bi-person-vcard" aria-hidden="true"></i> View</button>' +
                '<button class="pos-btn pos-btn-sm" type="button" data-cust-edit="' + ci + '" title="Edit"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>' +
              '</div></td>' +
            '</tr>';
          }
          function renderCustomersTable(rows) {
            if (!rows.length) return '<div class="wl-empty">No customers match.</div>';
            return '<div class="booking-table-wrap"><table class="booking-table"><thead><tr>' +
              '<th scope="col">Customer</th><th scope="col">Status</th><th scope="col">Source</th><th scope="col">Activity</th><th scope="col">Regular tech</th>' +
              '<th scope="col">Tags</th><th scope="col">Action</th>' +
              '</tr></thead><tbody>' + rows.map(custTableRowHtml).join('') + '</tbody></table></div>';
          }
          function renderCustomersTab() {
            var searchEl = $('[data-cust-search]');
            var matches = custSearchMatches(searchEl ? searchEl.value : '');
            set('[data-cust-count]', matches.length + '/' + CUSTOMERS.length + ' customers');
            renderCustSegChips();
            document.querySelectorAll('[data-cust-view-target]').forEach(function (b) {
              var active = b.getAttribute('data-cust-view-target') === custViewMode;
              b.classList.toggle('is-active', active);
              b.setAttribute('aria-pressed', String(active));
            });
            var tableWrap = $('[data-cust-table-wrap]'), cardWrap = $('[data-cust-results]');
            if (custViewMode === 'table') {
              if (tableWrap) { tableWrap.hidden = false; html('[data-cust-table-wrap]', renderCustomersTable(matches)); }
              if (cardWrap) { cardWrap.hidden = true; cardWrap.innerHTML = ''; }
            } else {
              if (tableWrap) { tableWrap.hidden = true; tableWrap.innerHTML = ''; }
              if (cardWrap) { cardWrap.hidden = false; html('[data-cust-results]', matches.length ? matches.map(custResultRowHtml).join('') : '<div class="wl-empty">No customers match.</div>'); }
            }
          }
          /* ── customer profile modal — merges the existing profile content with the AI Hub fields ── */
          function renderCustProfileModal(c) {
            var ci = CUSTOMERS.indexOf(c);
            var seg = CUST_SEG_META[c.seg];
            var segBadge = seg ? '<span class="pos-chip ' + seg.chip + '">' + esc(seg.label) + '</span>' : '';
            var inactiveBadge = custStatusOf(c) === 'inactive' ? '<span class="pos-chip pos-chip-gray">Inactive</span>' : '';
            var contactRows = [
              c.phone ? '<div><i class="bi bi-telephone" aria-hidden="true"></i>' + esc(c.phone) + '</div>' : '',
              c.email ? '<div><i class="bi bi-envelope" aria-hidden="true"></i>' + esc(c.email) + '</div>' : '',
              c.address ? '<div><i class="bi bi-geo-alt" aria-hidden="true"></i>' + esc(c.address) + '</div>' : '',
              c.birthday ? '<div><i class="bi bi-cake2" aria-hidden="true"></i>' + esc(c.birthday) + '</div>' : ''
            ].filter(Boolean).join('');
            // Everything shown in the Customers table (View brings it all up here too), and editable in
            // place exactly like the table: Regular tech, Tags, and all three note levels.
            html('[data-cust-profile]',
              '<div class="cust-profile-head">' +
                '<div class="cust-profile-avatar">' + esc(initials(c.name)) + '</div>' +
                '<div><div class="cust-profile-name">' + esc(c.name) + ' ' + segBadge + ' ' + custSrcBadgeHtml(c) + ' ' + inactiveBadge + '</div>' +
                (contactRows ? '<div class="cust-profile-contact">' + contactRows + '</div>' : '') +
              '</div></div>' +
              '<div class="cust-profile-stats">' +
                '<div class="cust-profile-stat"><span class="cust-profile-stat-value">' + (c.visits || 0) + '</span><span class="cust-profile-stat-label">Visits</span></div>' +
                '<div class="cust-profile-stat"><span class="cust-profile-stat-value">' + money0(c.spent || 0) + '</span><span class="cust-profile-stat-label">Lifetime</span></div>' +
                '<div class="cust-profile-stat"><span class="cust-profile-stat-value is-text">' + custLastVisitLabel(c) + '</span><span class="cust-profile-stat-label">Last visit</span></div>' +
              '</div>' +
              custUpcomingCardHtml(c) +
              custInsightsCardHtml(c, ci) +
              custPrefsCardHtml(c, ci) +
              '<div class="cust-section-title">Notes by visibility</div>' + custNoteLevelsHtml(c, ci) +
              '<div class="cust-section-title" style="margin-top:14px">Visit history</div>' + custVisitHistoryTableHtml(c.name) +
              '<div class="cust-section-title" style="margin-top:14px">Payment history</div>' + custPaymentHistoryTableHtml(c.name)
            );
            html('[data-cust-profile-actions]',
              '<button class="pos-btn pos-btn-primary pos-btn-sm" type="button" data-cust-checkin="' + esc(c.name) + '"><i class="bi bi-door-open" aria-hidden="true"></i> Check in</button>' +
              '<button class="pos-btn pos-btn-sm" type="button" data-cust-newbooking="' + esc(c.name) + '"><i class="bi bi-calendar-plus" aria-hidden="true"></i> New booking</button>' +
              '<button class="pos-btn pos-btn-sm" type="button" data-cust-edit="' + CUSTOMERS.indexOf(c) + '"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>'
            );
          }
          function openCustProfileModal(name) {
            var c = custOf(name); if (!c) return;
            custProfileOpenIndex = CUSTOMERS.indexOf(c);
            renderCustProfileModal(c);
            $('[data-cust-profile-modal]').classList.add('open');
            document.body.style.overflow = 'hidden';
          }
          function closeCustProfileModal() {
            $('[data-cust-profile-modal]').classList.remove('open');
            document.body.style.overflow = '';
            custProfileOpenIndex = -1;
          }
          // Re-renders the profile modal in place after an in-modal tag/note/pref/tab edit, so the change
          // shows immediately instead of only updating once the modal is reopened. Guarded to the
          // currently-open customer so an edit elsewhere (e.g. the table) doesn't refresh a stale target.
          function refreshOpenCustProfile(ci) {
            var modal = $('[data-cust-profile-modal]');
            if (!modal || !modal.classList.contains('open')) return;
            if (ci !== undefined && ci !== custProfileOpenIndex) return;
            var c = CUSTOMERS[custProfileOpenIndex];
            if (c) renderCustProfileModal(c);
          }
          /* ── create / edit customer modal (fields merged in from AI Hub) ── */
          var custEditIndex = -1;
          function populateCustTypeOptions() {
            var sel = $('[data-cf-type]'); if (!sel || sel.options.length) return;
            sel.innerHTML = CUST_TYPES.map(function (t) { return '<option value="' + esc(t) + '">' + esc(t) + '</option>'; }).join('');
          }
          function setCustEditError(message) {
            var el = $('[data-cust-edit-error]'); if (!el) return;
            el.textContent = message || ''; el.hidden = !message;
          }
          function openCustCreateModal() {
            populateCustTypeOptions();
            custEditIndex = -1;
            set('[data-cust-edit-title]', 'Create customer');
            $('[data-cf-name]').value = ''; $('[data-cf-phone]').value = ''; $('[data-cf-email]').value = '';
            $('[data-cf-birthday]').value = ''; $('[data-cf-address]').value = ''; $('[data-cf-type]').value = 'Individual';
            $('[data-cf-status]').value = 'active';
            setCustEditError('');
            $('[data-cust-edit-modal]').classList.add('open');
            document.body.style.overflow = 'hidden';
          }
          function openCustEditModal(index) {
            var c = CUSTOMERS[index]; if (!c) return;
            populateCustTypeOptions();
            custEditIndex = index;
            set('[data-cust-edit-title]', 'Update customer');
            $('[data-cf-name]').value = c.name || ''; $('[data-cf-phone]').value = c.phone || ''; $('[data-cf-email]').value = c.email || '';
            $('[data-cf-birthday]').value = c.birthday || ''; $('[data-cf-address]').value = c.address || '';
            $('[data-cf-type]').value = custTypeOf(c); $('[data-cf-status]').value = custStatusOf(c);
            setCustEditError('');
            $('[data-cust-edit-modal]').classList.add('open');
            document.body.style.overflow = 'hidden';
          }
          function closeCustEditModal() {
            $('[data-cust-edit-modal]').classList.remove('open');
            document.body.style.overflow = '';
            custEditIndex = -1;
          }
          function saveCustModal() {
            var name = $('[data-cf-name]').value.trim();
            var phone = $('[data-cf-phone]').value.trim();
            if (custEditIndex === -1 && (!name || !phone)) { setCustEditError('Name and phone are required.'); return; }
            var email = $('[data-cf-email]').value.trim();
            var birthday = $('[data-cf-birthday]').value.trim();
            var address = $('[data-cf-address]').value.trim();
            var type = $('[data-cf-type]').value;
            var status = $('[data-cf-status]').value;
            var isCreating = custEditIndex === -1;
            if (isCreating) {
              CUSTOMERS.push({
                name: name, phone: phone, email: email, birthday: birthday, address: address, type: type, status: status,
                seg: 'new', visits: 0, spent: 0, tags: [], prefTech: null, notes: { owner: '', staff: '', customer: '' }, src: 'manual'
              });
            } else {
              var c = CUSTOMERS[custEditIndex]; if (!c) { closeCustEditModal(); return; }
              c.name = name || c.name; c.phone = phone || c.phone; c.email = email; c.birthday = birthday; c.address = address; c.type = type; c.status = status;
            }
            var savedName = isCreating ? name : CUSTOMERS[custEditIndex].name;
            closeCustEditModal();
            renderCustomersTab();
            toast((isCreating ? 'Customer created — ' : 'Customer updated — ') + savedName);
          }
          function setCustImportStatus(message, tone) {
            var el = $('[data-cust-import-status]'); if (!el) return;
            el.textContent = message || '';
            el.hidden = !message;
            el.className = 'pos-chip ' + (tone === 'success' ? 'pos-chip-green' : tone === 'error' ? 'pos-chip-amber' : 'pos-chip-gray');
          }
          function custImportSummaryText(result) {
            return 'Imported ' + result.imported + ' | Updated ' + result.updated + (result.skipped ? ' | Skipped ' + result.skipped : '');
          }
          function clearCustImportFileInput() {
            var input = $('[data-cust-import-file]');
            if (input) input.value = '';
          }
          function triggerCustExcelImport() {
            var input = $('[data-cust-import-file]');
            if (input) input.click();
          }
          function applyCustImportRows(rows) {
            var importer = window.NEXORA_CUSTOMER_IMPORT || window.NexoraCustomerImport;
            if (!importer) { setCustImportStatus('Excel import unavailable', 'error'); toast('Excel import unavailable', 'warning'); return null; }
            var result = importer.mergeCustomers(CUSTOMERS, rows, { techs: TECHS });
            renderCustomersTab();
            var summary = custImportSummaryText(result);
            setCustImportStatus(summary, result.imported || result.updated ? 'success' : 'error');
            if (typeof logAdmin === 'function') logAdmin('Customer Excel import: ' + summary);
            toast(result.imported || result.updated ? summary : 'No customers imported', result.imported || result.updated ? 'success' : 'warning');
            return result;
          }
          function handleCustImportFile(file) {
            if (!file) return;
            var importer = window.NEXORA_CUSTOMER_IMPORT || window.NexoraCustomerImport;
            if (!importer) { setCustImportStatus('Excel import unavailable', 'error'); clearCustImportFileInput(); return; }
            setCustImportStatus('Importing...', 'info');
            var reader = new FileReader();
            reader.onerror = function () {
              clearCustImportFileInput();
              setCustImportStatus('Could not read file', 'error');
              toast('Could not read file', 'warning');
            };
            if (/\.(xlsx|xls)$/i.test(file.name || '')) {
              reader.onload = function (event) {
                try {
                  if (!window.XLSX) throw new Error('XLSX library missing');
                  var workbook = XLSX.read(event.target.result, { type: 'array' });
                  var firstSheet = workbook.SheetNames[0];
                  var rows = firstSheet ? XLSX.utils.sheet_to_json(workbook.Sheets[firstSheet], { defval: '', raw: false }) : [];
                  applyCustImportRows(rows);
                } catch (err) {
                  setCustImportStatus('Could not import Excel file', 'error');
                  toast('Could not import Excel file', 'warning');
                } finally {
                  clearCustImportFileInput();
                }
              };
              reader.readAsArrayBuffer(file);
            } else {
              reader.onload = function (event) {
                try {
                  var delimiter = /\.tsv$/i.test(file.name || '') ? '\t' : null;
                  applyCustImportRows(importer.parseDelimited(event.target.result, delimiter));
                } catch (err) {
                  setCustImportStatus('Could not import customer file', 'error');
                  toast('Could not import customer file', 'warning');
                } finally {
                  clearCustImportFileInput();
                }
              };
              reader.readAsText(file);
            }
          }

          /* ── check-in requests (📥) ── */
          var ciqViewMode = 'card'; // 'card' | 'table'
          function ciqActionsHtml(r) {
            return '<button class="pos-btn pos-btn-success pos-btn-sm queue-action-approve" data-ciq-ok="' + r.id + '"><i class="bi bi-check-lg" aria-hidden="true"></i> Accept</button>' +
              '<button class="pos-btn pos-btn-sm queue-action-danger" data-ciq-no="' + r.id + '" title="Decline"><i class="bi bi-x-lg" aria-hidden="true"></i> Decline</button>';
          }
          // Big full-width Accept/Decline for the card layout — same data-ciq-ok/-no
          // hooks as ciqActionsHtml, styled with the shared .perf-cta-btn card CTA.
          function ciqCardActionsHtml(r) {
            return '<button class="perf-cta-btn perf-cta-btn-success-fill" data-ciq-ok="' + r.id + '"><i class="bi bi-check-lg" aria-hidden="true"></i> Accept</button>' +
              '<button class="perf-cta-btn perf-cta-btn-danger" data-ciq-no="' + r.id + '" title="Decline"><i class="bi bi-x-lg" aria-hidden="true"></i> Decline</button>';
          }
          function ciqCardHtml(r) {
            var tech = r.reqTech ? esc(techName(r.reqTech)) : '<span class="pos-muted">Anyone</span>';
            var promo = r.promo ? '<span class="pos-chip pos-chip-red">' + esc(r.promo) + '</span>' : '<span class="pos-muted">—</span>';
            return '<div class="wl-card queue-card">' +
              '<div class="booking-card-name">' + esc(r.name) + '</div>' +
              '<div class="booking-card-split">' +
                '<div><span class="booking-card-label">Source</span><span class="pos-chip pos-chip-gray">' + esc(r.src) + '</span></div>' +
                '<div><span class="booking-card-label">Service</span><span class="booking-card-value">' + esc(posServiceDisplayName(r.svc)) + '</span></div>' +
              '</div>' +
              '<div class="booking-card-split">' +
                '<div><span class="booking-card-label">Technician request</span><span class="booking-card-value">' + tech + '</span></div>' +
                '<div><span class="booking-card-label">Promo</span>' + promo + '</div>' +
              '</div>' + custProfHtml(r.name) +
              '<div class="perf-cta-row" style="border-top:1px solid var(--nexora-rule);padding-top:10px">' + ciqCardActionsHtml(r) + '</div></div>';
          }
          function renderCiqTable(items) {
            if (!items.length) return '<div class="wl-empty">No check-in requests right now.</div>';
            return '<div class="booking-table-wrap"><table class="booking-table"><thead><tr>' +
              '<th scope="col">Guest</th><th scope="col">Source</th><th scope="col">Service</th><th scope="col">Technician request</th><th scope="col">Promo</th><th scope="col">Actions</th>' +
              '</tr></thead><tbody>' + items.map(function (r) {
                return '<tr class="booking-table-row"><td><div class="booking-customer-name">' + esc(r.name) + '</div>' + custProfHtml(r.name) + '</td>' +
                  '<td>' + esc(r.src) + '</td><td>' + esc(posServiceDisplayName(r.svc)) + '</td>' +
                  '<td>' + (r.reqTech ? '<i class="bi bi-person" aria-hidden="true"></i> ' + esc(techName(r.reqTech)) : 'Anyone') + '</td>' +
                  '<td>' + (r.promo ? '🎁 ' + esc(r.promo) : '—') + '</td><td><div class="wl-actions">' + ciqActionsHtml(r) + '</div></td></tr>';
              }).join('') + '</tbody></table></div>';
          }
          function renderCiq() {
            $('[data-ciq-panel]').hidden = !CHECKINQ.length;
            set('[data-ciq-count]', CHECKINQ.length);
            html('[data-ciq-list]', ciqViewMode === 'table' ? renderCiqTable(CHECKINQ) : CHECKINQ.map(ciqCardHtml).join(''));
          }

          /* ── access requests (🔐) ── */
          var arqViewMode = 'card'; // 'card' | 'table'
          function arqActionsHtml(r, t) {
            return '<button class="pos-btn pos-btn-success pos-btn-sm queue-action-approve" data-arq-ok="' + r.id + '"><i class="bi bi-check-lg" aria-hidden="true"></i> Give to ' + esc(t.name) + '</button>' +
              '<button class="pos-btn pos-btn-sm queue-action-danger" data-arq-no="' + r.id + '" title="Decline"><i class="bi bi-x-lg" aria-hidden="true"></i> Decline</button>';
          }
          // Big full-width Give to/Decline for the card layout — same data-arq-ok/-no
          // hooks as arqActionsHtml, styled with the shared .perf-cta-btn card CTA.
          function arqCardActionsHtml(r, t) {
            return '<button class="perf-cta-btn perf-cta-btn-success-fill" data-arq-ok="' + r.id + '"><i class="bi bi-check-lg" aria-hidden="true"></i> Give to ' + esc(t.name) + '</button>' +
              '<button class="perf-cta-btn perf-cta-btn-danger" data-arq-no="' + r.id + '" title="Decline"><i class="bi bi-x-lg" aria-hidden="true"></i> Decline</button>';
          }
          function arqSkillHtml(req, ok) {
            return req ? esc(req) + ': ' + (ok ? '<span class="pos-good-text">Eligible ✓</span>' : '<span class="pos-danger-text">Missing ⚠</span>') : '—';
          }
          function arqCardHtml(row) {
            var r = row.r, w = row.w, t = row.t, req = row.req, ok = row.ok;
            return '<div class="wl-card queue-card">' +
              '<div class="arq-card-row"><div class="arq-card-label">Tech</div><div class="arq-card-value arq-card-value-xl">' + esc(t.name) + '</div></div>' +
              '<div class="arq-card-row"><div class="arq-card-label">Ticket</div><div class="arq-card-value">#' + w.id + ' — ' + esc(w.name) + (w.svc ? ' · ' + esc(posServiceDisplayName(w.svc)) : '') + '</div></div>' +
              '<div class="arq-card-row"><div class="arq-card-label">Currently</div><div class="arq-card-value arq-card-value-plain">' + (w.techId ? esc(techName(w.techId)) : 'Unassigned') + '</div></div>' +
              '<div class="arq-card-row"><div class="arq-card-label">Skill</div><div class="arq-card-value arq-card-value-plain">' + arqSkillHtml(req, ok) + '</div></div>' +
              '<div class="perf-cta-row">' + arqCardActionsHtml(r, t) + '</div></div>';
          }
          // Table mode carries the same info as the card view (tech, ticket, current assignment, skill match).
          function renderArqTable(rows) {
            if (!rows.length) return '<div class="wl-empty">No access requests right now.</div>';
            return '<div class="booking-table-wrap"><table class="booking-table"><thead><tr>' +
              '<th scope="col">Tech</th><th scope="col">Ticket</th><th scope="col">Currently</th><th scope="col">Skill</th><th scope="col">Actions</th>' +
              '</tr></thead><tbody>' + rows.map(function (row) {
                var r = row.r, w = row.w, t = row.t, req = row.req, ok = row.ok;
                return '<tr class="booking-table-row"><td><div class="booking-customer-name">' + esc(t.name) + '</div></td>' +
                  '<td>#' + w.id + ' — ' + esc(w.name) + (w.svc ? ' · ' + esc(posServiceDisplayName(w.svc)) : '') + '</td>' +
                  '<td>' + (w.techId ? esc(techName(w.techId)) : 'Unassigned') + '</td>' +
                  '<td>' + arqSkillHtml(req, ok) + '</td>' +
                  '<td><div class="wl-actions">' + arqActionsHtml(r, t) + '</div></td></tr>';
              }).join('') + '</tbody></table></div>';
          }
          function renderArq() {
            var items = ACCESSQ.filter(function (r) { return WAITLIST.find(function (w) { return w.id === r.wid; }) && techById(r.tid); });
            $('[data-arq-panel]').hidden = !items.length;
            set('[data-arq-count]', items.length);
            var rows = items.map(function (r) {
              var w = WAITLIST.find(function (x) { return x.id === r.wid; });
              var t = techById(r.tid);
              var match = matchScore(t, w);
              return { r: r, w: w, t: t, req: match.req, ok: match.okSkill };
            });
            html('[data-arq-list]', arqViewMode === 'table' ? renderArqTable(rows) : rows.map(arqCardHtml).join(''));
          }

          /* ── bookings & ETA (📅 🚗) ── */
          function etaRem(e) { return Math.max(0, e.min - Math.floor((Date.now() - e.at) / 60000)); }
          function etaStatusChipHtml(e) {
            return !e ? '<span class="pos-chip pos-chip-gray"><i class="bi bi-circle" aria-hidden="true"></i> No response yet</span>'
              : e.st === 'otw' ? '<span class="pos-chip pos-chip-blue"><i class="bi bi-car-front-fill" aria-hidden="true"></i> On the way · ~' + etaRem(e) + "' out" + (e.share ? ' · 📍 live' : '') + '</span>'
              : e.st === 'late' ? '<span class="pos-chip pos-chip-amber"><i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i> Running late · ~' + etaRem(e) + "' out" + (e.share ? ' · 📍 live' : '') + '</span>'
              : e.st === 'here' ? '<span class="pos-chip pos-chip-green"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> At the door</span>'
              : '<span class="pos-chip pos-chip-green"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> In the queue</span>';
          }
          function etaActionHtml(x) {
            var e = x.b.eta;
            return (e && e.st === 'in') ? ''
              : (e && e.st === 'here') ? '<button class="pos-btn pos-btn-success pos-btn-sm queue-action-approve" data-eta-in="' + x.i + '"><i class="bi bi-check-lg" aria-hidden="true"></i> Check in to queue</button>'
              : '<button class="pos-btn pos-btn-sm queue-action-arrived" data-eta-here="' + x.i + '"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> Arrived</button>';
          }
          // Big outline CTA for the card layout only — same states/attributes as etaActionHtml,
          // just styled as one full-width primary action instead of a compact table-row button.
          function etaCardActionHtml(x) {
            var e = x.b.eta;
            return (e && e.st === 'in') ? ''
              : (e && e.st === 'here') ? '<button class="perf-cta-btn perf-cta-btn-success" data-eta-in="' + x.i + '"><i class="bi bi-check-lg" aria-hidden="true"></i> Check in to queue</button>'
              : '<button class="perf-cta-btn" data-eta-here="' + x.i + '"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> Arrived</button>';
          }
          function etaCardHtml(x) {
            var b = x.b, e = b.eta;
            var map = (e && e.share && (e.st === 'otw' || e.st === 'late'))
              ? '<div class="live-map">🚗··········💅 Live trip — guest is sharing their route · ~' + etaRem(e) + "' out</div>" : '';
            var tech = b.techId ? esc(techName(b.techId)) : 'Any tech';
            var extra = custProfHtml(b.name);
            return '<div class="wl-card queue-card">' +
              '<div class="queue-card-head">' +
                '<div class="queue-card-identity">' +
                  '<div class="booking-card-name">' + esc(b.name) + '</div>' +
                  (b.phone ? '<div class="queue-card-phone"><i class="bi bi-telephone" aria-hidden="true"></i> ' + esc(b.phone) + '</div>' : '') +
                '</div>' +
                '<span class="pos-chip pos-chip-blue"><i class="bi bi-clock" aria-hidden="true"></i> ' + esc(b.time || 'No time') + '</span>' +
              '</div>' +
              '<div class="booking-card-split">' +
                '<div><span class="booking-card-label">Service</span><span class="booking-card-value">' + esc(posServiceDisplayName(b.svc)) + '</span></div>' +
                '<div><span class="booking-card-label">With</span><span class="booking-card-value">' + esc(tech) + '</span></div>' +
              '</div>' +
              (extra ? '<div>' + extra + '</div>' : '') +
              map +
              '<div><span class="booking-card-label">Status</span> ' + etaStatusChipHtml(e) + '</div>' +
              '<div class="perf-cta-row" style="border-top:1px solid var(--nexora-rule);padding-top:10px">' + etaCardActionHtml(x) + '</div>' +
              '</div>';
          }
          // Check-in "Bookings today" table mode — one row per booking, same actions as the card view.
          function renderEtaTable(items) {
            if (!items.length) return '<div class="wl-empty">No bookings today yet.</div>';
            return '<div class="booking-table-wrap"><table class="booking-table"><thead><tr>' +
              '<th scope="col">Guest</th><th scope="col">Time</th><th scope="col">Service</th><th scope="col">Status</th><th scope="col">Action</th>' +
              '</tr></thead><tbody>' + items.map(function (x) {
                var b = x.b;
                return '<tr class="booking-table-row"><td><div class="booking-customer-name">' + esc(b.name) + '</div></td>' +
                  '<td>' + esc(b.time || '') + '</td>' +
                  '<td>' + esc(posServiceDisplayName(b.svc || '')) + (b.techId ? ' · ' + esc(techName(b.techId)) : '') + '</td>' +
                  '<td>' + etaStatusChipHtml(b.eta) + '</td>' +
                  '<td><div class="wl-actions">' + etaActionHtml(x) + '</div></td></tr>';
              }).join('') + '</tbody></table></div>';
          }
          var checkinBookingsViewMode = 'card'; // 'card' | 'table'
          function renderEta() {
            var items = BOOKINGS.map(function (b) { return { b: b, i: b.id }; }).filter(function (x) { return (x.b.day || 'today') === 'today'; });
            var open = items.filter(function (x) { return !(x.b.eta && x.b.eta.st === 'in'); });
            $('[data-eta-panel]').hidden = !items.length;
            set('[data-eta-count]', open.length);
            html('[data-eta-list]', checkinBookingsViewMode === 'table' ? renderEtaTable(items) : items.map(etaCardHtml).join(''));
          }

          /* ── the board ── */
          // Tickets view mode + status filter (#pos-nail-salon-ops Phase 3 UI)
          var ticketsViewMode = 'card';   // 'card' | 'table'
          var ticketsFilter = 'all';      // all | waiting | service | ready | completed | cancelled
          var TICKETS_STATUS_CHIPS = [
            { id: 'all', label: 'All' },
            { id: 'waiting', label: 'Waiting' },
            { id: 'service', label: 'In service' },
            { id: 'ready', label: 'Ready' },
            { id: 'completed', label: 'Completed' },
            { id: 'cancelled', label: 'Cancelled' }
          ];
          function ticketsChipCount(id) {
            if (id === 'all') return WAITLIST.filter(ticketOpen).length;
            return WAITLIST.filter(function (w) { return w.status === id; }).length;
          }
          function ticketsMatchesFilter(w) {
            if (ticketsFilter === 'all') return ticketOpen(w);
            return w.status === ticketsFilter;
          }
          function renderTicketsStatusChips() {
            html('[data-tix-status-chips]', TICKETS_STATUS_CHIPS.map(function (chip) {
              var active = ticketsFilter === chip.id;
              return '<button class="booking-status-chip' + (active ? ' is-active' : '') + '" type="button" data-tix-status-chip="' + chip.id + '" aria-pressed="' + (active ? 'true' : 'false') + '">' +
                esc(chip.label) + ' <span class="booking-status-chip-count">' + ticketsChipCount(chip.id) + '</span></button>';
            }).join(''));
          }
          var TICKET_STATUS_BADGE = {
            waiting: ['pos-chip-amber', 'Waiting'], service: ['pos-chip-violet', 'In service'], ready: ['pos-chip-green', 'Ready'],
            completed: ['pos-chip-blue', 'Completed'], cancelled: ['pos-chip-gray', 'Cancelled']
          };
          function ticketStatusBadge(status) {
            var meta = TICKET_STATUS_BADGE[status] || ['pos-chip-gray', status];
            return '<span class="pos-chip ' + meta[0] + '">' + esc(meta[1]) + '</span>';
          }
          function ticketCustomerGroupHtml(w) {
            var c = custOf(w.name);
            var seg = c && CUST_SEG_META[c.seg];
            var fallback = w.customerGroup || (c && c.seg) || '';
            if (!seg && fallback) {
              var fallbackKey = String(fallback).toLowerCase();
              seg = CUST_SEG_META[fallbackKey] || Object.keys(CUST_SEG_META).map(function (id) { return CUST_SEG_META[id]; }).find(function (meta) { return meta.label.toLowerCase() === fallbackKey; });
            }
            var label = seg ? seg.label : fallback;
            var visits = c ? c.visits : w.visits;
            var groupTag = label ? (seg
              ? '<span class="pos-chip ' + seg.chip + '"><i class="bi ' + seg.icon + '" aria-hidden="true"></i> ' + esc(label) + '</span>'
              : '<span class="pos-chip pos-chip-gray">' + esc(label) + '</span>') : '';
            var visitTag = visits ? '<span class="pos-chip pos-chip-gray">' + visits + ' visits</span>' : '';
            return groupTag || visitTag ? '<span class="queue-customer-group">' + groupTag + visitTag + '</span>' : '<span class="pos-muted">—</span>';
          }
          function ticketQueueCardGroupHtml(w) {
            var groupHtml = ticketCustomerGroupHtml(w);
            return groupHtml === '<span class="pos-muted">—</span>' ? '' : groupHtml;
          }
          function ticketQueueNoteHtml(w) {
            var c = custOf(w.name);
            var note = String(w.note || (c && c.notes && c.notes.staff) || '').trim();
            return note ? '<span class="queue-table-note" title="' + esc(note) + '">' + esc(note) + '</span>' : '<span class="pos-muted">—</span>';
          }
          function ticketNeedsTechPicker(w) {
            return w && w.status === 'waiting' && !w.techId && !w.reqTech;
          }
          function scrollQueueTicketIntoView(wid) {
            setTimeout(function () {
              var target = document.querySelector('[data-queue-ticket-id="' + wid + '"]');
              if (target && target.scrollIntoView) target.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }, 0);
          }
          function followQueueTicketAfterAction(w, fallbackFilter) {
            if (!w) return;
            if (ticketsFilter !== 'all' && !ticketsMatchesFilter(w) && fallbackFilter) ticketsFilter = fallbackFilter;
            fSel = w.id;
            renderFloor(); renderManagement();
            if (ticketsMatchesFilter(w)) scrollQueueTicketIntoView(w.id);
          }
          function spotlightQueueTicket(wid) {
            fSel = wid;
            ticketsFilter = 'waiting';
            activateTab('tickets');
            scrollQueueTicketIntoView(wid);
          }
          function ticketTechHtml(w, variant) {
            var cls = variant === 'card' ? 'queue-card-tech-value' : 'queue-table-tech';
            if (w.techId) return '<span class="' + cls + '">' + esc(techName(w.techId)) + '</span>';
            if (w.reqTech) return '<span class="' + cls + ' is-requested">' + esc(techName(w.reqTech)) + '</span>';
            return '<span class="' + cls + ' is-anyone">Anyone</span>';
          }
          function queueServiceNames(w) {
            var names = (w.items || []).map(function (item) { return posServiceDisplayName(item.name || ''); }).filter(Boolean);
            return names.length ? names : [posServiceDisplayName(w.svc || 'No service chosen')];
          }
          function queueServicesHtml(w, variant) {
            var names = queueServiceNames(w);
            if (variant === 'card') {
              return '<span class="queue-ticket-services">' + names.map(function (name) {
                return '<span class="queue-ticket-service-line">' + esc(name) + '</span>';
              }).join('') + '</span>';
            }
            return '<span class="queue-ticket-services queue-ticket-services-compact">' + esc(names.join(', ')) + '</span>';
          }
          // Table mode: one row per technician ticket (not per order), same actions as the card view.
          // Table mode carries the operational fields as separate columns so the queue can be scanned
          // quickly: appointment hour, customer group, note, service, tech, status, elapsed time, total.
          function renderTicketsTable(groups, now) {
            var rows = groups.reduce(function (acc, g) { return acc.concat(g.tickets.map(function (w) { return { w: w, g: g }; })); }, []);
            if (!rows.length) return '<div class="wl-empty">No guests yet — add a walk-in, or let the kiosk check someone in.</div>';
            return '<div class="booking-table-wrap"><table class="booking-table queue-table"><thead><tr>' +
              '<th scope="col">Guest</th><th scope="col">Phone</th><th scope="col">Hour</th><th scope="col">Customer group</th>' +
              '<th scope="col">Service</th><th scope="col">Tech</th><th scope="col">Status</th><th scope="col">Elapsed</th><th scope="col">Total</th><th scope="col">Note</th><th scope="col">Actions</th>' +
              '</tr></thead><tbody>' + rows.map(function (r) {
                var w = r.w;
                var itemsTot = (w.items || []).reduce(function (s, i) { return s + i.price; }, 0);
                var elapsedLabel = w.status === 'waiting' ? (w.atMs ? Math.max(0, Math.floor((now - w.atMs) / 60000)) + "' waiting" : '—')
                  : w.status === 'service' ? (w.svcAtMs ? Math.max(0, Math.floor((now - w.svcAtMs) / 60000)) + "' in service" : '—')
                  : w.status === 'ready' ? (w.readyAtMs ? Math.max(0, Math.floor((now - w.readyAtMs) / 60000)) + "' to pay" : '—')
                  : '—';
                return '<tr class="booking-table-row" data-queue-ticket-id="' + w.id + '"><td><div class="booking-customer-name">' + esc(w.name) +
                  (r.g.tickets.length > 1 ? ' <span class="pos-muted" style="font-size:12px;font-weight:600">· ' + r.g.tickets.length + ' svc</span>' : '') + '</div>' +
                  '</td>' +
                  '<td>' + esc(w.phone || '—') + '</td>' +
                  '<td>' + esc(w.bookingTime || w.at || '—') + '</td>' +
                  '<td>' + ticketCustomerGroupHtml(w) + '</td>' +
                  '<td>' + queueServicesHtml(w, 'table') + '</td>' +
                  '<td>' + ticketTechHtml(w) + '</td>' +
                  '<td>' + ticketStatusBadge(w.status) + '</td>' +
                  '<td>' + elapsedLabel + '</td>' +
                  '<td>' + money(itemsTot) + '</td>' +
                  '<td>' + ticketQueueNoteHtml(w) + '</td>' +
                  '<td><div class="wl-actions">' + ticketActionsHtml(w) + '</div></td></tr>';
              }).join('') + '</tbody></table></div>';
          }
          function queueServiceEditButtonHtml(w, variant) {
            var cls = variant === 'card' ? 'perf-cta-btn perf-cta-btn-muted' : 'pos-btn pos-btn-sm queue-action-muted';
            return '<button class="' + cls + '" type="button" data-wservice="' + w.id + '" title="Edit service"><i class="bi bi-pencil-square" aria-hidden="true"></i> Edit service</button>';
          }
          function ticketActionsHtml(w) {
            if (w.status === 'waiting') {
              if (ticketNeedsTechPicker(w)) {
                return '<button class="pos-btn pos-btn-primary pos-btn-sm queue-action-primary" data-wswap="' + w.id + '"><i class="bi bi-person-plus" aria-hidden="true"></i> Assign tech</button>' +
                  queueServiceEditButtonHtml(w, 'compact') +
                  '<button class="pos-btn pos-btn-sm queue-action-danger" data-wcancel="' + w.id + '" title="Cancel"><i class="bi bi-x-lg" aria-hidden="true"></i> Cancel</button>';
              }
              var startTech = waitingStartTech(w);
              return '<button class="pos-btn pos-btn-primary pos-btn-sm queue-action-primary" data-wstart="' + w.id + '"' + (startTech ? '' : ' disabled') + '><i class="bi bi-play-fill" aria-hidden="true"></i> ' + (startTech ? esc(startTech.name) : 'No tech') + '</button>' +
                '<button class="pos-btn pos-btn-sm queue-action-muted" data-wswap="' + w.id + '" title="Change tech"><i class="bi bi-arrow-left-right" aria-hidden="true"></i> Change tech</button>' +
                queueServiceEditButtonHtml(w, 'compact') +
                '<button class="pos-btn pos-btn-sm queue-action-danger" data-wcancel="' + w.id + '" title="Cancel"><i class="bi bi-x-lg" aria-hidden="true"></i> Cancel</button>';
            }
            if (w.status === 'service') {
              return '<button class="pos-btn pos-btn-sm queue-action-muted" data-wswap="' + w.id + '" title="Change tech"><i class="bi bi-arrow-left-right" aria-hidden="true"></i> Change tech</button>' +
                queueServiceEditButtonHtml(w, 'compact') +
                '<button class="pos-btn pos-btn-sm queue-action-progress" data-wdone="' + w.id + '" title="Tech finished — guest waits to pay"><i class="bi bi-check2" aria-hidden="true"></i> Done</button>' +
                '<button class="pos-btn pos-btn-sm queue-action-danger" data-wcancel="' + w.id + '" title="Cancel"><i class="bi bi-x-lg" aria-hidden="true"></i> Cancel</button>';
            }
            if (w.status === 'ready') {
              return '<span class="pos-chip pos-chip-green"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Ready</span>' +
                queueServiceEditButtonHtml(w, 'compact') +
                '<button class="pos-btn pos-btn-sm queue-action-danger" data-wcancel="' + w.id + '" title="Cancel"><i class="bi bi-x-lg" aria-hidden="true"></i> Cancel</button>';
            }
            // completed/cancelled tickets only show up here via the Tickets status-chip filter — read-only
            return ticketStatusBadge(w.status);
          }
          function ticketLabelHtml(w) {
            var svcName = esc(queueServiceNames(w).join(', '));
            var techLbl = w.status === 'waiting' ? (w.techId ? 'waiting on ' + esc(techName(w.techId)) : (w.reqTech ? 'requested ' + esc(techName(w.reqTech)) : 'Anyone'))
              : w.status === 'service' ? esc(techName(w.techId)) + ' — in service'
              : w.status === 'ready' ? esc(techName(w.techId)) + ' — ready'
              : w.status === 'completed' ? esc(techName(w.techId)) + ' — completed'
              : esc(techName(w.techId)) + ' — cancelled';
            return svcName + ' — ' + techLbl;
          }
          // Shared body for the redesigned ticket card — name/phone/time head, customer-group
          // badges, Service/Tech and Status/Elapsed stat rows, Total, and an optional Note —
          // every status branch below just appends its own action row after this.
          function ticketCardBodyHtml(w, elapsedLabel, statusChipHtml, techExtra) {
            var groupHtml = ticketQueueCardGroupHtml(w);
            var items = w.items || [];
            var total = items.reduce(function (s, i) { return s + i.price; }, 0);
            var c = custOf(w.name);
            var noteText = String(w.note || (c && c.notes && c.notes.staff) || '').trim();
            return '<div class="perf-head">' +
                '<div class="perf-head-main">' +
                  '<span class="perf-name">' + esc(w.name) + '</span>' +
                  '<div class="perf-sub" style="font-size:13px"><i class="bi bi-telephone" aria-hidden="true"></i> ' + esc(w.phone || 'No phone') + '</div>' +
                '</div>' +
                '<span class="pos-chip" style="margin-left:auto;flex-shrink:0;white-space:nowrap;background:#eef1fb;color:var(--nexora-brand)"><i class="bi bi-clock" aria-hidden="true"></i> ' + esc(w.bookingTime || w.at || 'Walk-in') + '</span>' +
              '</div>' +
              (groupHtml ? '<div style="margin-top:10px">' + groupHtml + '</div>' : '') +
              '<div class="perf-divider"></div>' +
              '<div class="perf-stat-row">' +
                '<div class="perf-stat-col"><span class="perf-section-label">Service</span><span class="perf-stat-value">' + queueServicesHtml(w, 'card') + '</span></div>' +
                '<div class="perf-stat-col"><span class="perf-section-label">Tech</span><span class="perf-stat-value">' + ticketTechHtml(w, 'card') + (techExtra || '') + '</span></div>' +
              '</div>' +
              '<div class="perf-divider"></div>' +
              '<div class="perf-stat-row">' +
                '<div class="perf-stat-col"><span class="perf-section-label">Status</span>' + statusChipHtml + '</div>' +
                '<div class="perf-stat-col"><span class="perf-section-label">Elapsed</span><span class="perf-stat-value">' + esc(elapsedLabel || '—') + '</span></div>' +
              '</div>' +
              '<div class="perf-divider"></div>' +
              '<div><span class="perf-section-label">Total</span><span class="perf-stat-value">' + money(total) + '</span></div>' +
              (noteText ? '<div class="perf-divider"></div><div><span class="perf-section-label">Note</span><span class="perf-stat-value" style="font-weight:600">' + esc(noteText) + '</span></div>' : '');
          }
          // One WAITLIST row = one technician ticket. A single-ticket order
          // renders exactly like the original floor card, so the common walk-in path is unchanged.
          function renderSingleTicketCard(w, now, selW) {
            var sel = selW && selW.id === w.id ? ' is-sel' : '';

            if (w.status === 'waiting') {
              var waitMin = w.atMs ? Math.max(0, Math.floor((now - w.atMs) / 60000)) : 0;
              var late = waitMin > 20;
              var reqBusy = w.reqTech && !freeTechs().find(function (t) { return t.id === w.reqTech; });
              var needsTechPicker = ticketNeedsTechPicker(w);
              var startTech = waitingStartTech(w);
              return '<article class="wl-card queue-card perf-card tappable' + (late ? ' late' : (w.appt ? ' appt' : '')) + sel + '" data-wtap="' + w.id + '" data-queue-ticket-id="' + w.id + '">' +
                ticketCardBodyHtml(w, w.atMs ? waitMin + "' waiting" : '—', ticketStatusBadge('waiting'), reqBusy ? ' <span class="pos-warn-text" style="font-size:12px">(busy)</span>' : '') +
                '<div class="perf-divider"></div>' +
                '<div class="perf-cta-row">' +
                  (needsTechPicker
                    ? '<button class="perf-cta-btn perf-cta-btn-muted" data-wswap="' + w.id + '"><i class="bi bi-person-plus" aria-hidden="true"></i> Assign tech</button>'
                    : '<button class="perf-cta-btn perf-cta-btn-primary" data-wstart="' + w.id + '"' + (startTech ? '' : ' disabled') + '><i class="bi bi-play-fill" aria-hidden="true"></i> ' + (startTech ? esc(startTech.name) : 'No tech') + '</button>') +
                  (needsTechPicker ? '' : '<button class="perf-cta-btn perf-cta-btn-muted" data-wswap="' + w.id + '" title="Change tech"><i class="bi bi-arrow-left-right" aria-hidden="true"></i> Change tech</button>') +
                  queueServiceEditButtonHtml(w, 'card') +
                  '<button class="perf-cta-btn perf-cta-btn-danger" data-wcancel="' + w.id + '" title="Cancel"><i class="bi bi-x-lg" aria-hidden="true"></i> Cancel</button>' +
                '</div></article>';
            }
            if (w.status === 'ready') {
              var rdyMin = w.readyAtMs ? Math.max(0, Math.floor((now - w.readyAtMs) / 60000)) : 0;
              return '<article class="wl-card queue-card perf-card rdy" data-queue-ticket-id="' + w.id + '">' +
                ticketCardBodyHtml(w, w.readyAtMs ? rdyMin + "' to pay" : '—', ticketStatusBadge('ready')) +
                '<div class="perf-divider"></div>' +
                '<div class="perf-cta-row">' +
                  '<button class="perf-cta-btn perf-cta-btn-success-fill" data-wpay="' + esc(w.orderId) + '"><i class="bi bi-credit-card" aria-hidden="true"></i> Checkout</button>' +
                  queueServiceEditButtonHtml(w, 'card') +
                  '<button class="perf-cta-btn perf-cta-btn-danger" data-wcancel="' + w.id + '" title="Cancel"><i class="bi bi-x-lg" aria-hidden="true"></i> Cancel</button>' +
                '</div></article>';
            }
            if (w.status === 'service') {
              var svcMin = w.svcAtMs ? Math.max(0, Math.floor((now - w.svcAtMs) / 60000)) : 0;
              return '<article class="wl-card queue-card perf-card svc' + sel + '" data-queue-ticket-id="' + w.id + '">' +
                ticketCardBodyHtml(w, w.svcAtMs ? svcMin + "' in service" : '—', ticketStatusBadge('service')) +
                '<div class="perf-divider"></div>' +
                '<div class="perf-cta-row">' +
                  '<button class="perf-cta-btn perf-cta-btn-muted" data-wswap="' + w.id + '" title="Change tech"><i class="bi bi-arrow-left-right" aria-hidden="true"></i> Change tech</button>' +
                  queueServiceEditButtonHtml(w, 'card') +
                  '<button class="perf-cta-btn perf-cta-btn-primary" data-wdone="' + w.id + '" title="Tech finished — guest waits to pay"><i class="bi bi-check2" aria-hidden="true"></i> Done</button>' +
                  '<button class="perf-cta-btn perf-cta-btn-success" data-wpay="' + esc(w.orderId) + '"><i class="bi bi-credit-card" aria-hidden="true"></i> Checkout</button>' +
                  '<button class="perf-cta-btn perf-cta-btn-danger" data-wcancel="' + w.id + '" title="Cancel"><i class="bi bi-x-lg" aria-hidden="true"></i> Cancel</button>' +
                '</div></article>';
            }
            // completed/cancelled — only reachable via the Tickets status-chip filter; read-only
            return '<article class="wl-card queue-card perf-card" data-queue-ticket-id="' + w.id + '">' +
              ticketCardBodyHtml(w, '—', ticketStatusBadge(w.status)) +
              '</article>';
          }
          // Multi-ticket order card: one guest/order with several service tickets, each on its own line
          // with its own status/actions, and one Checkout button for the whole order (#pos-nail-salon-ops).
          function renderTicketGroupCard(g, now, selW) {
            var lines = g.tickets.map(function (w) {
              var sel = selW && selW.id === w.id ? ' is-sel' : '';
              return '<div class="wl-ticket-row' + sel + '" data-wtap="' + w.id + '" data-queue-ticket-id="' + w.id + '">' +
                '<span class="wl-ticket-svc">' + ticketLabelHtml(w) + '</span>' +
                '<span class="wl-ticket-actions">' + ticketActionsHtml(w) + '</span></div>';
            }).join('');
            var activeTickets = g.tickets.filter(function (w) { return w.status !== 'cancelled'; });
            var readyCount = activeTickets.filter(function (w) { return w.status === 'ready'; }).length;
            var allReady = activeTickets.length > 0 && readyCount === activeTickets.length;
            var total = g.tickets.reduce(function (s, w) { return s + (w.items || []).reduce(function (ss, i) { return ss + i.price; }, 0); }, 0);
            var mins = g.tickets.reduce(function (s, w) { return s + (w.durationMin || 0); }, 0);
            var checkedInBadge = g.bookingId ? ' <span class="pos-chip pos-chip-blue">Checked in</span>' : '';
            var chargeBtn = allReady
              ? '<button class="pos-btn pos-btn-success pos-btn-sm queue-action-pay" data-wpay="' + esc(g.orderId) + '"><i class="bi bi-credit-card" aria-hidden="true"></i> Checkout</button>'
              : '<button class="pos-btn pos-btn-sm queue-action-muted" disabled>' + readyCount + '/' + activeTickets.length + ' ready</button>';
            return '<div class="wl-card wl-group">' +
              '<div class="wl-info"><div class="wl-name">' + esc(g.name) + (g.phone ? ' · ' + esc(g.phone) : '') + checkedInBadge + '</div>' +
              custProfHtml(g.name) + '</div>' +
              '<div class="wl-group-tickets">' + lines + '</div>' +
              '<div class="wl-group-foot"><span class="wl-group-total">Total ' + money(total) + (mins ? ' · ' + mins + ' min' : '') + '</span>' + chargeBtn + '</div>' +
              '</div>';
          }
          function renderFloor() {
            set('[data-fs-wait]', floorCount('waiting'));
            set('[data-fs-svc]', floorCount('service'));
            set('[data-fs-ready]', floorCount('ready'));
            set('[data-fs-done]', SALES.length);
            set('[data-fs-rev]', money0(SALES.reduce(function (s, x) { return s + x.total; }, 0)));
            renderCiq(); renderArq(); renderEta();

            var now = Date.now();
            var selW = fSel ? WAITLIST.find(function (x) { return x.id === fSel; }) : null;
            if (!selW) fSel = null;
            var ORD = { waiting: 0, service: 1, ready: 2 };

            // Tickets: one card per guest/order, grouped by orderId. A single-ticket order renders the
            // original floor card unchanged; a multi-ticket order (from a booking with several service
            // tickets) renders one line per ticket under a shared header and a single order-level Checkout.
            // The status chip picks which tickets are included; the view switch picks card vs table.
            renderTicketsStatusChips();
            var groups = waitlistGroups(ticketsMatchesFilter).sort(function (a, b) {
              var rank = function (g) { return Math.min.apply(null, g.tickets.map(function (t) { return ORD[t.status] || 0; })); };
              return rank(a) - rank(b);
            });
            if (ticketsViewMode === 'table') {
              html('[data-wait-list]', renderTicketsTable(groups, now));
            } else {
              html('[data-wait-list]', groups.length ? groups.map(function (g) {
                return g.tickets.length === 1 ? renderSingleTicketCard(g.tickets[0], now, selW) : renderTicketGroupCard(g, now, selW);
              }).join('') : '<div class="wl-empty">No guests yet — add a walk-in, or let the kiosk check someone in.</div>');
            }

          }

          /* ── quick note (🧠 #80 tier 2) ── */
          var qnFor = null, qnSel = {};
          function openQuickNote(name) {
            qnFor = name; qnSel = {};
            set('[data-qn-name]', name);
            $('[data-qn-free]').value = '';
            html('[data-qn-chips]', QN_CHIPS.map(function (c, i) { return '<button class="ap-chip" type="button" data-qn="' + i + '">' + c + '</button>'; }).join(''));
            $('[data-qn-modal]').classList.add('open');
            document.body.style.overflow = 'hidden';
          }
          function closeQuickNote() {
            $('[data-qn-modal]').classList.remove('open');
            document.body.style.overflow = '';
            qnFor = null;
          }

          /* ── swap technician picker ── */
          var swapTechFor = null;
          function swapTechOptionsHtml(w) {
            var options = TECHS.filter(function (t) { return techAvailableForQueueTicket(t.id, w); })
              .filter(function (t) { return t.id !== w.techId; })
              .map(function (t) { return { t: t, match: matchScore(t, w) }; })
              .sort(function (a, b) { return b.match.sc - a.match.sc || a.t.turns - b.t.turns; });
            if (!options.length) return '<div class="swap-tech-empty"><i class="bi bi-person-x" aria-hidden="true"></i> No other free technician is available right now.</div>';
            return options.map(function (option) {
              var t = option.t, m = option.match;
              var skillLabel = m.okSkill ? 'Qualified for ' + (m.req || 'this service') : 'Missing ' + (m.req || 'required') + ' skill';
              var skillClass = m.okSkill ? 'pos-chip-green' : 'pos-chip-amber';
              var scoreColor = m.sc >= 75 ? 'var(--nexora-success)' : m.sc >= 50 ? 'var(--nexora-warning)' : 'var(--nexora-danger)';
              return '<button class="swap-tech-option" type="button" role="option" data-swap-tech-pick="' + esc(t.id) + '">' +
                '<span class="pos-avatar">' + esc(initials(t.name)) + '</span>' +
                '<span class="swap-tech-option-main"><span class="swap-tech-option-name">' + esc(t.name) + '</span>' +
                '<span class="swap-tech-option-meta">' + esc(skillLabel) + ' · ' + t.turns + ' turns</span></span>' +
                '<span class="pos-chip ' + skillClass + '">' + (m.okSkill ? 'Qualified' : 'Override') + '</span>' +
                '<span class="match-badge" style="color:' + scoreColor + '">' + m.sc + '%</span>' +
                '</button>';
            }).join('');
          }
          function openSwapTechModal(wid) {
            var w = WAITLIST.find(function (x) { return x.id == wid; });
            var modal = $('[data-swap-tech-modal]');
            if (!w || !modal) return;
            swapTechFor = w.id;
            fSel = null; fWarn = null;
            set('[data-swap-tech-title-text]', w.techId ? 'Swap technician' : 'Choose technician');
            set('[data-swap-tech-copy-text]', w.techId ? 'Choose a free technician to take over' : 'Choose a free technician for');
            set('[data-swap-tech-guest]', w.name);
            html('[data-swap-tech-list]', swapTechOptionsHtml(w));
            modal.classList.add('open');
            document.body.style.overflow = 'hidden';
          }
          function closeSwapTechModal() {
            var modal = $('[data-swap-tech-modal]');
            if (modal) modal.classList.remove('open');
            document.body.style.overflow = '';
            swapTechFor = null;
          }
          function chooseSwapTech(tid) {
            var w = WAITLIST.find(function (x) { return x.id === swapTechFor; });
            var t = techById(tid);
            if (!w || !t || !techAvailableForQueueTicket(tid, w) || w.techId === tid) return;
            var match = matchScore(t, w);
            var apply = function (override) {
              if (w.status === 'waiting') {
                if (override) wlog(w, '⚠ Skill override: assigned to ' + t.name + ' without: ' + match.missing.join(', '));
                w = assignWaitingTech(w, tid);
                closeSwapTechModal();
                followQueueTicketAfterAction(w, 'waiting');
                toast(w.name + ' assigned to ' + t.name + (override ? ' (override logged)' : ''));
                return;
              }
              if (override) wlog(w, '⚠ Skill override: swapped to ' + t.name + ' without: ' + match.missing.join(', '));
              w = fAssign(w, tid);
              closeSwapTechModal();
              followQueueTicketAfterAction(w, w.status);
              toast(w.name + ' → ' + t.name + (override ? ' (override logged)' : ''));
            };
            if (!match.okSkill) {
              closeSwapTechModal();
              confirmBox('Swap to ' + t.name + ' anyway?', t.name + ' is missing ' + match.missing.join(', ') + ' for ' + queueServiceNames(w).join(', ') + '.').then(function (ok) { if (ok) apply(true); });
              return;
            }
            apply(false);
          }

          /* ── Queue service picker ── */
          var queueServiceFor = null, queueServiceDraftIds = [];
          var queueServiceOriginalServices = [];
          var queueServiceCatalogReady = false;
          function nextBookingServiceTicketId(usedIds) {
            var used = {};
            (usedIds || []).forEach(function (id) { used[String(id)] = true; });
            var index = 1;
            while (used['ticket-' + index]) index++;
            return 'ticket-' + index;
          }
          function queueBookingServicesPatch(booking, w, services) {
            var sourceTickets = (booking.tickets || []).slice();
            var linkedIds = queueTicketServiceIds(w);
            var missingLink = linkedIds.some(function (id) {
              return !sourceTickets.some(function (ticket) { return String(ticket.id) === String(id); });
            });
            if (missingLink) return { ok: false, error: { message: 'The linked booking ticket could not be found.' } };
            var techId = w.techId || w.reqTech || null;
            var usedIds = sourceTickets.map(function (ticket) { return String(ticket.id); });
            var retainedIds = {};
            var selectedById = {};
            var additions = [];
            var selectedTickets = services.map(function (service) {
              var requestedLink = service._serviceTicketId == null ? null : String(service._serviceTicketId);
              var currentItem = (w.items || []).find(function (item) {
                if (requestedLink && String(item.serviceTicketId) === requestedLink) return true;
                if (service.id && String(item.serviceId) === String(service.id)) return true;
                return !service.id && posServiceDisplayName(item.name) === posServiceDisplayName(service.label || service.name);
              });
              var retainedId = requestedLink || (currentItem && currentItem.serviceTicketId != null ? String(currentItem.serviceTicketId) : null);
              if (retainedId && (linkedIds.indexOf(retainedId) === -1 || retainedIds[retainedId])) retainedId = null;
              var original = retainedId ? sourceTickets.find(function (ticket) { return String(ticket.id) === retainedId; }) : null;
              var id = original ? String(original.id) : nextBookingServiceTicketId(usedIds);
              if (!original) usedIds.push(id);
              else retainedIds[id] = true;
              var serviceName = posServiceDisplayName(service.label || service.name || (original && original.serviceName) || '');
              var ticket = Object.assign({}, original || {}, {
                id: id,
                serviceId: String(service.id || (original && original.serviceId) || ''),
                serviceName: serviceName,
                price: Number(service.price) || 0,
                durationMin: Number(service.durationMin) || 0,
                technicianId: techId,
                technicianName: techId ? techName(techId) : 'Anyone',
                status: original && original.status !== 'cancelled' ? original.status : 'confirmed'
              });
              selectedById[id] = ticket;
              if (!original) additions.push(ticket);
              return ticket;
            });
            var nextTickets = sourceTickets.map(function (ticket) {
              var id = String(ticket.id);
              if (selectedById[id]) return selectedById[id];
              if (linkedIds.indexOf(id) !== -1) return Object.assign({}, ticket, { status: 'cancelled' });
              return ticket;
            }).concat(additions);
            var activeTickets = nextTickets.filter(function (ticket) { return ticket.status !== 'cancelled'; });
            return {
              ok: true,
              patch: {
                tickets: nextTickets,
                serviceIds: activeTickets.map(function (ticket) { return ticket.serviceId || ''; }),
                serviceNames: activeTickets.map(function (ticket) { return ticket.serviceName || ''; }),
                serviceDetails: activeTickets.map(function (ticket) {
                  return { id: ticket.serviceId || '', name: ticket.serviceName || '', price: ticket.price, durationMin: ticket.durationMin, icon: '✨' };
                })
              },
              items: selectedTickets.map(function (ticket, index) { return queueItemForService(services[index], techId, ticket.id); }),
              serviceTicketIds: selectedTickets.map(function (ticket) { return String(ticket.id); })
            };
          }
          function queueSelectedServices() {
            var selected = (MENU || []).filter(function (service) {
              return queueServiceDraftIds.indexOf(String(service.id)) !== -1;
            });
            queueServiceOriginalServices.forEach(function (service) {
              if (queueServiceDraftIds.indexOf(String(service._draftId)) === -1) return;
              var duplicate = selected.some(function (candidate) {
                return String(candidate.id) === String(service.id) || String(candidate.id) === String(service._draftId);
              });
              if (!duplicate) selected.push(service);
            });
            return selected;
          }
          function queueServiceOptionsHtml(w) {
            var options = MENU || [];
            var activeOptions = options.map(function (service) {
              var selected = queueServiceDraftIds.indexOf(String(service.id)) !== -1;
              var meta = [service.categoryName || service.requiredSkill || 'Service'];
              if (service.durationMin) meta.push(service.durationMin + ' min');
              return '<button class="swap-tech-option queue-service-option' + (selected ? ' is-selected' : '') + '" type="button" role="option" data-queue-service-pick="' + esc(service.id) + '" aria-selected="' + (selected ? 'true' : 'false') + '">' +
                '<span class="pos-avatar"><i class="bi bi-stars" aria-hidden="true"></i></span>' +
                '<span class="swap-tech-option-main"><span class="swap-tech-option-name">' + esc(service.label || service.name) + '</span>' +
                '<span class="swap-tech-option-meta">' + esc(meta.join(' · ')) + '</span></span>' +
                (selected ? '<i class="bi bi-check-circle-fill queue-service-check" aria-hidden="true"></i>' : '') +
                '<span class="queue-service-price">' + money(service.price || 0) + '</span>' +
                '</button>';
            }).join('');
            var unavailableOptions = queueServiceOriginalServices.filter(function (service) { return service._unavailable; }).map(function (service) {
              var selected = queueServiceDraftIds.indexOf(String(service._draftId)) !== -1;
              return '<button class="swap-tech-option queue-service-option' + (selected ? ' is-selected' : '') + '" type="button" role="option" data-queue-service-pick="' + esc(service._draftId) + '" aria-selected="' + (selected ? 'true' : 'false') + '"' + (selected ? '' : ' disabled') + '>' +
                '<span class="pos-avatar"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span>' +
                '<span class="swap-tech-option-main"><span class="swap-tech-option-name">' + esc(service.label || service.name) + '</span>' +
                '<span class="swap-tech-option-meta">Current service unavailable</span></span>' +
                (selected ? '<i class="bi bi-check-circle-fill queue-service-check" aria-hidden="true"></i>' : '') +
                '<span class="queue-service-price">' + money(service.price || 0) + '</span>' +
                '</button>';
            }).join('');
            if (!activeOptions && !unavailableOptions) return '<div class="swap-tech-empty"><i class="bi bi-card-checklist" aria-hidden="true"></i> No active services are available.</div>';
            return activeOptions + unavailableOptions;
          }
          function renderQueueServiceDraft(w) {
            var selected = queueSelectedServices();
            html('[data-queue-service-list]', queueServiceOptionsHtml(w));
            var duration = selected.reduce(function (sum, service) { return sum + (Number(service.durationMin) || 0); }, 0);
            var total = selected.reduce(function (sum, service) { return sum + (Number(service.price) || 0); }, 0);
            set('[data-queue-service-summary]', selected.length + ' ' + (selected.length === 1 ? 'service' : 'services') + ' · ' + duration + ' min · ' + money(total));
            var saveButton = $('[data-queue-service-save]');
            if (saveButton) saveButton.disabled = !selected.length || !queueServiceCatalogReady;
            var error = $('[data-queue-service-error]');
            if (error) {
              error.textContent = !queueServiceCatalogReady ? 'The service catalog is unavailable. Current services were kept.' : 'At least one service is required.';
              error.hidden = !!selected.length && queueServiceCatalogReady;
            }
          }
          function toggleQueueServiceDraft(serviceId) {
            serviceId = String(serviceId);
            var index = queueServiceDraftIds.indexOf(serviceId);
            var unavailable = queueServiceOriginalServices.find(function (service) { return service._unavailable && String(service._draftId) === serviceId; });
            if (index === -1) {
              if (unavailable) return;
              queueServiceDraftIds.push(serviceId);
            } else {
              queueServiceDraftIds.splice(index, 1);
            }
            var w = WAITLIST.find(function (ticket) { return ticket.id === queueServiceFor; });
            if (w) renderQueueServiceDraft(w);
          }
          function openQueueServiceModal(wid) {
            var w = WAITLIST.find(function (ticket) { return ticket.id == wid && ticketOpen(ticket); });
            var modal = $('[data-queue-service-modal]');
            if (!w || !modal) return;
            queueServiceFor = w.id;
            queueServiceCatalogReady = (MENU || []).length > 0;
            queueServiceOriginalServices = (w.items || []).map(function (item, index) {
              var catalogService = (MENU || []).find(function (service) {
                return String(service.id) === String(item.serviceId) || posServiceDisplayName(service.label || service.name) === posServiceDisplayName(item.name);
              });
              var serviceId = String(item.serviceId || (catalogService && catalogService.id) || '');
              var draftId = serviceId || (item.serviceTicketId ? 'linked:' + item.serviceTicketId : 'legacy:' + index);
              return {
                id: serviceId,
                label: item.name,
                name: item.name,
                price: Number(item.price) || 0,
                durationMin: Number(item.durationMin) || 0,
                _draftId: draftId,
                _serviceTicketId: item.serviceTicketId || null,
                _unavailable: !catalogService
              };
            });
            queueServiceDraftIds = queueServiceOriginalServices.map(function (service) { return String(service._draftId); });
            set('[data-queue-service-guest]', w.name);
            set('[data-queue-service-current]', queueServiceOriginalServices.length ? queueServiceOriginalServices.map(function (service) { return service.label; }).join(', ') : 'No service chosen');
            renderQueueServiceDraft(w);
            modal.classList.add('open');
            document.body.style.overflow = 'hidden';
          }
          function closeQueueServiceModal() {
            var modal = $('[data-queue-service-modal]');
            if (modal) modal.classList.remove('open');
            document.body.style.overflow = '';
            queueServiceFor = null;
            queueServiceDraftIds = [];
            queueServiceOriginalServices = [];
            queueServiceCatalogReady = false;
          }
          function changeQueueTicketServices(w, services) {
            if (!w || !services || !services.length) return { ok: false, error: { message: 'At least one service is required.' } };
            var previousNames = (w.items || []).map(function (item) { return item.name; });
            var techId = w.techId || w.reqTech || null;
            var nextItems, nextIds;
            if (w.bookingId) {
              var booking = posBookingById(w.bookingId);
              if (!booking) return { ok: false, error: { message: 'The linked booking could not be found.' } };
              var prepared = queueBookingServicesPatch(booking, w, services);
              if (!prepared.ok) return prepared;
              var updateResult = appointmentStore.update(booking.id, prepared.patch, null, salonCatalog);
              if (!updateResult.ok) return updateResult;
              nextItems = prepared.items;
              nextIds = prepared.serviceTicketIds;
              reloadAppointmentSnapshot();
            } else {
              nextItems = services.map(function (service) { return queueItemForService(service, techId, null); });
              nextIds = [];
            }
            w.items = nextItems;
            w.serviceTicketIds = nextIds;
            normalizeQueueTicketServices(w);
            wlog(w, 'Changed services from ' + (previousNames.join(', ') || 'none') + ' to ' + w.items.map(function (item) { return item.name; }).join(', '));
            return { ok: true };
          }
          function saveQueueServices() {
            var w = WAITLIST.find(function (ticket) { return ticket.id === queueServiceFor && ticketOpen(ticket); });
            var services = queueSelectedServices();
            var error = $('[data-queue-service-error]');
            if (!services.length) {
              if (error) { error.textContent = 'At least one service is required.'; error.hidden = false; }
              return;
            }
            if (!queueServiceCatalogReady) {
              if (error) { error.textContent = 'The service catalog is unavailable. Current services were kept.'; error.hidden = false; }
              return;
            }
            var result = changeQueueTicketServices(w, services);
            if (!result.ok) {
              if (error) { error.textContent = result.error && result.error.message || 'Services could not be updated.'; error.hidden = false; }
              return;
            }
            closeQueueServiceModal();
            followQueueTicketAfterAction(w, w.status);
            toast(w.name + ' · ' + w.items.length + ' services updated');
          }

          document.addEventListener('click', function (e) {
            /* quick-note modal */
            var qc = e.target.closest('[data-qn]');
            if (qc) {
              var qi = qc.getAttribute('data-qn');
              if (qnSel[qi]) { delete qnSel[qi]; qc.classList.remove('is-on'); } else { qnSel[qi] = 1; qc.classList.add('is-on'); }
              return;
            }
            if (e.target.closest('[data-qn-skip]') || e.target.matches('[data-qn-modal]')) { closeQuickNote(); return; }
            if (e.target.closest('[data-qn-save]')) {
              if (qnFor) {
                var c = custOf(qnFor);
                if (!c) { c = { name: qnFor, phone: '', seg: 'new', visits: 1, spent: 0, tags: [], prefTech: null, notes: { owner: '', staff: '', customer: '' } }; CUSTOMERS.push(c); }
                Object.keys(qnSel).forEach(function (i) { if (c.tags.indexOf(QN_CHIPS[i]) === -1) c.tags.push(QN_CHIPS[i]); });
                var free = $('[data-qn-free]').value.trim();
                if (free) c.notes.staff = (c.notes.staff ? c.notes.staff + ' · ' : '') + free;
              }
              closeQuickNote();
              renderFloor(); renderManagement();
              toast('Note saved to the guest profile');
              return;
            }

            /* swap technician modal */
            if (e.target.closest('[data-swap-tech-close]') || e.target.matches('[data-swap-tech-modal]')) { closeSwapTechModal(); return; }
            var swapPick = e.target.closest('[data-swap-tech-pick]');
            if (swapPick) {
              chooseSwapTech(swapPick.getAttribute('data-swap-tech-pick'));
              return;
            }

            /* queue service modal */
            if (e.target.closest('[data-queue-service-close]') || e.target.matches('[data-queue-service-modal]')) { closeQueueServiceModal(); return; }
            var servicePick = e.target.closest('[data-queue-service-pick]');
            if (servicePick) {
              toggleQueueServiceDraft(servicePick.getAttribute('data-queue-service-pick'));
              return;
            }
            if (e.target.closest('[data-queue-service-save]')) { saveQueueServices(); return; }

            /* check-in modal: search a phone number against today's bookings, or add a walk-in */
            if (e.target.closest('[data-ci-close]') || e.target.matches('[data-ci-modal]')) { closeCheckinModal(); return; }
            var ciCheckin = e.target.closest('[data-ci-checkin]');
            if (ciCheckin) {
              checkInBooking(posBookingById(ciCheckin.getAttribute('data-ci-checkin')));
              closeCheckinModal();
              return;
            }
            if (e.target.closest('[data-ci-ticket-add]')) {
              var svcSel = $('[data-ci-svc-select]'), techSel = $('[data-ci-tech-select]');
              var svc = svcSel && (MENU || []).find(function (m) { return m.id === svcSel.value; });
              if (!svc) { toast('Pick a service first', 'info'); return; }
              var tech = techSel && techSel.value ? techById(techSel.value) : null;
              ciTickets.push({ serviceId: svc.id, serviceName: svc.label, price: svc.price, durationMin: svc.durationMin, technicianId: tech ? tech.id : null, technicianName: tech ? tech.name : 'Anyone' });
              renderCiTickets();
              return;
            }
            var ciTicketRemove = e.target.closest('[data-ci-ticket-remove]');
            if (ciTicketRemove) {
              ciTickets.splice(parseInt(ciTicketRemove.getAttribute('data-ci-ticket-remove'), 10), 1);
              renderCiTickets();
              return;
            }
            if (e.target.closest('[data-ci-add-checkin]')) {
              var ciPhoneEl = $('[data-ci-phone]'), ciNameEl = $('[data-ci-new-name]');
              addWalkIn(ciNameEl ? ciNameEl.value : '', ciPhoneEl ? ciPhoneEl.value : '', ciTickets);
              closeCheckinModal();
              return;
            }

            if (!e.target.closest('[data-pos-panel="checkin"], [data-pos-panel="todaybooking"], [data-pos-panel="tickets"], [data-pos-panel="clock"]')) return;

            /* Tickets: card/table view switch */
            var tixView = e.target.closest('[data-tix-view-target]');
            if (tixView) {
              ticketsViewMode = tixView.getAttribute('data-tix-view-target');
              document.querySelectorAll('[data-tix-view-target]').forEach(function (b) {
                var active = b === tixView;
                b.classList.toggle('is-active', active);
                b.setAttribute('aria-pressed', String(active));
              });
              renderFloor();
              return;
            }
            /* Tickets: status chip filter */
            var tixChip = e.target.closest('[data-tix-status-chip]');
            if (tixChip) { ticketsFilter = tixChip.getAttribute('data-tix-status-chip'); renderFloor(); return; }
            /* Check-in requests: card/table view switch */
            var ciqView = e.target.closest('[data-ciq-view-target]');
            if (ciqView) {
              ciqViewMode = ciqView.getAttribute('data-ciq-view-target');
              document.querySelectorAll('[data-ciq-view-target]').forEach(function (b) {
                var active = b === ciqView;
                b.classList.toggle('is-active', active);
                b.setAttribute('aria-pressed', String(active));
              });
              renderCiq();
              return;
            }
            /* Tech access requests: card/table view switch */
            var arqView = e.target.closest('[data-arq-view-target]');
            if (arqView) {
              arqViewMode = arqView.getAttribute('data-arq-view-target');
              document.querySelectorAll('[data-arq-view-target]').forEach(function (b) {
                var active = b === arqView;
                b.classList.toggle('is-active', active);
                b.setAttribute('aria-pressed', String(active));
              });
              renderArq();
              return;
            }
            /* Tech roster: card/table view switch */
            var rosterView = e.target.closest('[data-tech-roster-view-target]');
            if (rosterView) {
              techRosterViewMode = rosterView.getAttribute('data-tech-roster-view-target');
              renderTechRosterTable();
              return;
            }

            /* check-in requests */
            var cok = e.target.closest('[data-ciq-ok]'), cno = e.target.closest('[data-ciq-no]');
            if (cok || cno) {
              var cid = cok ? cok.getAttribute('data-ciq-ok') : cno.getAttribute('data-ciq-no');
              var r = CHECKINQ.find(function (x) { return x.id === cid; });
              CHECKINQ = CHECKINQ.filter(function (x) { return x.id !== cid; });
              if (cok && r) {
                var nwId = ++wlSeq;
                var nw = { id: nwId, orderId: 'walkin-' + nwId, bookingId: null, serviceTicketId: null, customerId: r.name, durationMin: queueDurationForService(r.svc),
                  name: r.name, phone: '', customerGroup: 'New', badge: 'violet', badgeTxt: r.src.indexOf('📱') === 0 ? '📱 App' : '🌐 QR', svc: r.svc,
                  at: nowTime(), atMs: Date.now(), status: 'waiting', techId: null, reqTech: r.reqTech || null, items: queueItemsForService(r.svc, r.reqTech || null), log: [] };
                WAITLIST.unshift(nw);
                wlog(nw, '📥 Checked in via ' + (r.src.indexOf('📱') === 0 ? 'the Nexora App' : 'the web QR') + ' — confirmed by the front desk' + (r.reqTech ? ' · wants ' + techName(r.reqTech) : ''));
                toast(r.name + ' added to the queue');
                spotlightQueueTicket(nw.id);
                renderManagement();
                return;
              } else if (r) { toast(r.name + ' declined — the app tells them why', 'info'); }
              renderFloor(); renderManagement();
              return;
            }

            /* access requests */
            var aok = e.target.closest('[data-arq-ok]'), ano = e.target.closest('[data-arq-no]');
            if (aok || ano) {
              var aid = aok ? aok.getAttribute('data-arq-ok') : ano.getAttribute('data-arq-no');
              var ar = ACCESSQ.find(function (x) { return x.id === aid; });
              if (!ar) return;
              ACCESSQ = ACCESSQ.filter(function (x) { return x.id !== aid; });
              var aw = WAITLIST.find(function (x) { return x.id === ar.wid; });
              if (aok && aw) {
                var at = techById(ar.tid);
                var accessMatch = at ? matchScore(at, aw) : null;
                if (accessMatch && !accessMatch.okSkill) wlog(aw, '⚠ Skill override: approved ' + at.name + ' without: ' + accessMatch.missing.join(', '));
                wlog(aw, '🔐 Front desk approved the access request — ' + techName(ar.tid) + ' takes the ticket');
                aw = fAssign(aw, ar.tid);
                followQueueTicketAfterAction(aw, 'service');
                toast(techName(ar.tid) + ' now owns ticket #' + aw.id);
                return;
              }
              if (aw) wlog(aw, '🔐 Declined the access request from ' + techName(ar.tid));
              renderFloor();
              return;
            }

            /* bookings & ETA */
            var eh = e.target.closest('[data-eta-here]');
            if (eh) {
              updateAppointmentMetadata(eh.getAttribute('data-eta-here'), { eta: { st: 'here' } });
              return;
            }
            var ei = e.target.closest('[data-eta-in]');
            if (ei) {
              checkInBooking(posBookingById(ei.getAttribute('data-eta-in')));
              return;
            }
            /* Bookings-today card/table view switch */
            var etaView = e.target.closest('[data-eta-view-target]');
            if (etaView) {
              checkinBookingsViewMode = etaView.getAttribute('data-eta-view-target');
              document.querySelectorAll('[data-eta-view-target]').forEach(function (b) {
                var active = b === etaView;
                b.classList.toggle('is-active', active);
                b.setAttribute('aria-pressed', String(active));
              });
              renderEta();
              return;
            }

            /* add a walk-in by hand — opens the Check-in modal (phone search or add-and-check-in) */
            if (e.target.closest('[data-wl-add]')) {
              var nEl = $('[data-wl-name]'), pEl = $('[data-wl-phone]');
              openCheckinModal(nEl.value.trim(), pEl.value.trim());
              return;
            }

            /* edit queue service */
            var serviceEdit = e.target.closest('[data-wservice]');
            if (serviceEdit) { openQueueServiceModal(+serviceEdit.getAttribute('data-wservice')); return; }

            /* ▶ one-tap assign */
            var st = e.target.closest('[data-wstart]');
            if (st) {
              e.preventDefault();
              e.stopImmediatePropagation();
              var sw = WAITLIST.find(function (x) { return x.id == st.getAttribute('data-wstart'); });
              var stech = sw && waitingStartTech(sw);
              if (!stech) { toast('No free tech right now', 'info'); return; }
              sw = fAssign(sw, stech.id);
              followQueueTicketAfterAction(sw, 'service');
              serviceStartedModal(sw, stech);
              return;
            }
            /* ⇄ swap tech */
            var sp = e.target.closest('[data-wswap]');
            if (sp) { openSwapTechModal(+sp.getAttribute('data-wswap')); return; }
            /* ✋ done */
            var dn = e.target.closest('[data-wdone]');
            if (dn) {
              var dw = WAITLIST.find(function (x) { return x.id == dn.getAttribute('data-wdone'); });
              if (dw) {
                dw.status = 'ready'; dw.readyAtMs = Date.now();
                wlog(dw, '✋ ' + techName(dw.techId) + ' finished — guest waiting to pay');
                followQueueTicketAfterAction(dw, 'ready');
                openQuickNote(dw.name);
              }
              return;
            }
            /* 💳 checkout the order — same destination as Booking checkout, seeded with Queue data */
            var pw = e.target.closest('[data-wpay]');
            if (pw) {
              openQueueCheckout(pw.getAttribute('data-wpay'));
              return;
            }
            /* ✕ remove — marks the ticket cancelled instead of deleting it, so a rehydrate never recreates it */
            var cx = e.target.closest('[data-wcancel]');
            if (cx) {
              var xw = WAITLIST.find(function (x) { return x.id == cx.getAttribute('data-wcancel'); });
              if (!xw) return;
              confirmBox('Remove ' + xw.name + ' from the queue?', 'The ticket is dropped — production keeps it as a cancelled record.').then(function (ok) {
                if (!ok) return;
                var result = cancelQueueTicket(xw);
                if (!result.ok) {
                  toast(result.error && result.error.message ? result.error.message : 'The Queue ticket could not be cancelled.', 'error');
                  return;
                }
                followQueueTicketAfterAction(xw, 'cancelled');
              });
              return;
            }
            /* 📟 page a tech by hand */
            var pg = e.target.closest('[data-fpage]');
            if (pg) {
              pageTech(pg.getAttribute('data-fpage'), 'The front desk is paging you — a guest is waiting');
              renderFloor(); renderClock();
              toast('Beeped ' + techName(pg.getAttribute('data-fpage')));
              return;
            }
            /* two-tap: tap a free tech to assign the selected guest */
            var fa = e.target.closest('[data-fassign]');
            if (fa) {
              if (fSel == null) return;
              var aw2 = WAITLIST.find(function (x) { return x.id === fSel; });
              if (!aw2) return;
              var tid = fa.getAttribute('data-fassign');
              var t2 = techById(tid);
              var assignMatch = matchScore(t2, aw2);
              var ok2 = assignMatch.okSkill;
              if (!ok2 && !(fWarn && fWarn.wid === aw2.id && fWarn.tid === tid)) {
                fWarn = { wid: aw2.id, tid: tid };   // first tap: block and warn
                renderFloor();
                return;
              }
              if (!ok2) wlog(aw2, '⚠ Skill override: assigned ' + techName(tid) + ' without: ' + assignMatch.missing.join(', '));
              aw2 = fAssign(aw2, tid);               // second tap (or qualified): assign
              followQueueTicketAfterAction(aw2, 'service');
              toast(aw2.name + ' → ' + techName(tid) + (ok2 ? '' : ' (override logged)'));
              return;
            }
            /* tap a waiting card to select it */
            var tap = e.target.closest('[data-wtap]');
            if (tap) { var tid2 = +tap.getAttribute('data-wtap'); fSel = fSel === tid2 ? null : tid2; fWarn = null; renderFloor(); return; }
          });

          /* ═══════════ 👤 CUSTOMERS — table/card view, segment chips, profile + create/edit modals ═══════════ */
          document.addEventListener('click', function (e) {
            var bookingDetailCheckin = e.target.closest('[data-booking-detail-checkin]');
            if (bookingDetailCheckin) {
              var detailBookingId = bookingDetailCheckin.getAttribute('data-booking-detail-checkin');
              if (window.NEXORA_POS_BOOKING_CHECKIN) window.NEXORA_POS_BOOKING_CHECKIN(detailBookingId);
              if (window.openBookingDetailById) window.openBookingDetailById(detailBookingId);
              return;
            }

            var custView = e.target.closest('[data-cust-view-target]');
            if (custView) {
              custViewMode = custView.getAttribute('data-cust-view-target');
              document.querySelectorAll('[data-cust-view-target]').forEach(function (b) {
                var active = b === custView;
                b.classList.toggle('is-active', active);
                b.setAttribute('aria-pressed', String(active));
              });
              renderCustomersTab();
              return;
            }
            var segChip = e.target.closest('[data-cust-seg-chip]');
            if (segChip) { custSegFilter = segChip.getAttribute('data-cust-seg-chip'); renderCustomersTab(); return; }

            var custUpcomingCheckin = e.target.closest('[data-cust-upcoming-checkin]');
            if (custUpcomingCheckin) {
              checkInBooking(posBookingById(custUpcomingCheckin.getAttribute('data-cust-upcoming-checkin')));
              closeCustProfileModal();
              activateTab('checkin');
              return;
            }

            var custUpcomingDetail = e.target.closest('[data-cust-upcoming-detail]');
            if (custUpcomingDetail) {
              var detailCard = custUpcomingDetail.closest('.cust-upcoming-card');
              var detailCollapse = detailCard && detailCard.querySelector('[data-cust-upcoming-collapse]');
              var expanded = !!detailCollapse && !detailCollapse.hidden;
              if (detailCollapse) detailCollapse.hidden = expanded;
              custUpcomingDetail.setAttribute('aria-expanded', String(!expanded));
              var detailLabel = custUpcomingDetail.querySelector('[data-cust-upcoming-detail-label]');
              if (detailLabel) detailLabel.textContent = expanded ? 'View detail' : 'Hide detail';
              return;
            }

            // Tags & three-level notes — guarded to the Customers panel/profile modal.
            var custTag = e.target.closest('[data-mg-tag]');
            if (custTag && e.target.closest('[data-pos-panel="customers"], [data-cust-profile-modal]')) {
              var ctPt = custTag.getAttribute('data-mg-tag').split('|');
              toggleCustTag(+ctPt[0], ctPt[1]);
              renderCustomersTab();
              refreshOpenCustProfile(+ctPt[0]);
              return;
            }
            var cpick = e.target.closest('[data-cust-pick]');
            if (cpick) { openCustProfileModal(cpick.getAttribute('data-cust-pick')); return; }

            if (e.target.closest('[data-cust-import]')) {
              triggerCustExcelImport();
              return;
            }
            if (e.target.closest('[data-cust-create]')) { openCustCreateModal(); return; }
            var custEdit = e.target.closest('[data-cust-edit]');
            if (custEdit) {
              closeCustProfileModal();
              openCustEditModal(parseInt(custEdit.getAttribute('data-cust-edit'), 10));
              return;
            }
            if (e.target.closest('[data-cust-save]')) { saveCustModal(); return; }
            if (e.target.closest('[data-cust-edit-close]') || e.target.matches('[data-cust-edit-modal]')) { closeCustEditModal(); return; }
            if (e.target.closest('[data-cust-profile-close]') || e.target.matches('[data-cust-profile-modal]')) { closeCustProfileModal(); return; }

            var cci = e.target.closest('[data-cust-checkin]');
            if (cci) {
              var ccName = cci.getAttribute('data-cust-checkin');
              var ccCust = custOf(ccName);
              closeCustProfileModal();
              activateTab('checkin');
              var wlNameEl = $('[data-wl-name]'), wlPhoneEl = $('[data-wl-phone]');
              if (wlNameEl) wlNameEl.value = ccName;
              if (wlPhoneEl) wlPhoneEl.value = ccCust ? (ccCust.phone || '') : '';
              return;
            }
            var cnb = e.target.closest('[data-cust-newbooking]');
            if (cnb) {
              var nbName = cnb.getAttribute('data-cust-newbooking');
              var nbCust = custOf(nbName);
              closeCustProfileModal();
              activateTab('booking');
              if (typeof openBookingNewAppointment === 'function') openBookingNewAppointment();
              var nameField = document.querySelector('[data-booking-create-field="name"]');
              var phoneField = document.querySelector('[data-booking-create-field="phone"]');
              if (nameField) nameField.value = nbName;
              if (phoneField) phoneField.value = nbCust ? (nbCust.phone || '') : '';
              return;
            }
          });
          document.addEventListener('input', function (e) {
            if (e.target.matches('[data-cust-search]')) renderCustomersTab();
          });
          document.addEventListener('change', function (e) {
            if (e.target.matches('[data-cust-import-file]')) handleCustImportFile(e.target.files && e.target.files[0]);
          });
          document.addEventListener('focusout', function (e) {
            var custNote = e.target.closest('[data-mg-note]');
            if (custNote && e.target.closest('[data-pos-panel="customers"], [data-cust-profile-modal]')) {
              var cnPn = custNote.getAttribute('data-mg-note').split('|');
              saveCustNoteLevel(+cnPn[0], cnPn[1], custNote.value);
            }
          });
          document.addEventListener('keydown', function (e) {
            if (e.key !== 'Escape') return;
            if ($('[data-cust-profile-modal]').classList.contains('open')) closeCustProfileModal();
            if ($('[data-cust-edit-modal]').classList.contains('open')) closeCustEditModal();
          });

          /* ═══════════ 🕘 TIME CLOCK ═══════════ */
          var CLK0 = (function () { var d = new Date(); d.setHours(9, 30, 0, 0); return d.getTime(); })();
          var CLOCK = {
            mgr1: [{ in: CLK0 - 50 * 60000, out: null }],
            cash1: [{ in: CLK0 - 35 * 60000, out: null }],
            t1: [{ in: CLK0, out: null }],
            t2: [{ in: CLK0 + 30 * 60000, out: CLK0 + 3.5 * 3600000 }, { in: CLK0 + 4.5 * 3600000, out: null }],
            t3: [{ in: CLK0, out: null }],
            t4: [{ in: CLK0 + 2 * 3600000, out: null }],
            t5: []   // Vy has not clocked in — demo of the "not in" state
          };
          function clockHours(id) {
            return (CLOCK[id] || []).reduce(function (s, x) { return s + ((x.out || Date.now()) - x.in); }, 0) / 3600000;
          }
          function isOnShift(id) { return (CLOCK[id] || []).some(function (x) { return !x.out; }); }
          // Turn order = order of first clock-in today (owner-configurable rule in production)
          function turnOrder() {
            return TECHS.filter(function (t) { return (CLOCK[t.id] || []).length; })
              .map(function (t) { return { id: t.id, at: CLOCK[t.id][0].in }; })
              .sort(function (a, b) { return a.at - b.at || (a.id < b.id ? -1 : 1); })
              .map(function (x) { return x.id; });
          }

          var BEEP = { t1: 1, t3: 2, t2: 3, t4: 4 };   // #78 — beeper number handed out on clock-in, resets at midnight
          var NOTIF = [];                              // #77 — push sent to the Staff App
          var QCLK = { tok: null, exp: 0, seq: 0, drawn: null };
          function qclkRotate() {
            QCLK.tok = 'NXCA-' + Math.random().toString(36).slice(2, 8).toUpperCase();
            QCLK.exp = Date.now() + 15000;
            QCLK.seq++;
          }
          function qclkCheckin(id) {
            var ses = CLOCK[id] || (CLOCK[id] = []);
            if (ses.some(function (x) { return !x.out; })) return false;   // already on shift
            if (!QCLK.tok || Date.now() > QCLK.exp) qclkRotate();
            var usedTok = QCLK.tok;
            ses.push({ in: Date.now(), out: null });
            var t = techById(id);
            var st = STAFF.find(function (s) { return s.id === id; });
            if (t && !BEEP[id]) BEEP[id] = Math.max.apply(null, [0].concat(Object.keys(BEEP).map(function (k) { return BEEP[k]; }))) + 1;
            var msg = '✅ ' + (st ? st.name : id) + ' clocked in at ' + timeFmt(Date.now()) + ' (QR ' + usedTok + ')';
            if (t) msg += ' — 📟 Beeper #' + BEEP[id] + ' today · Station #' + t.bnum;
            NOTIF.push({ tid: id, at: Date.now(), msg: msg });
            qclkRotate();   // single-use: consume the token immediately
            return true;
          }

          function renderQr() {
            if (!QCLK.tok || Date.now() > QCLK.exp) { qclkRotate(); }
            var box = $('[data-clk-qr]');
            if (box && QCLK.drawn !== QCLK.tok) {   // only refetch the image when the token actually changes
              QCLK.drawn = QCLK.tok;
              box.innerHTML = '<img alt="Clock-in QR" src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=' +
                encodeURIComponent('https://nexora.us/ca/' + QCLK.tok) + '">';
            }
            set('[data-clk-token]', QCLK.tok);
            set('[data-clk-seq]', QCLK.seq);
            var left = Math.max(0, Math.ceil((QCLK.exp - Date.now()) / 1000));
            set('[data-clk-left]', left);
            var bar = $('[data-clk-bar]');
            if (bar) bar.style.width = Math.round(left / 15 * 100) + '%';
          }

          var techRosterViewMode = DEFAULT_VIEW_MODE; // 'table' | 'card'
          function renderTechRosterTable() {
            var selW = fSel ? WAITLIST.find(function (x) { return x.id === fSel; }) : null;
            if (!selW) fSel = null;
            var ord = turnOrder();
            var next = nextTech();
            var roster = STAFF.filter(function (s) { return s.role !== 'owner'; });
            var rowsHtml = '', cardsHtml = '';
            roster.forEach(function (s) {
              var ses = CLOCK[s.id] || (CLOCK[s.id] = []);
              var open = ses.find(function (x) { return !x.out; });
              var t = techById(s.id);
              var busy = t ? busyName(t.id) : null;
              var pos = t ? ord.indexOf(t.id) + 1 : 0;
              var match = selW && t ? matchScore(t, selW) : null;
              var pickable = !!(selW && t && !busy && t.id !== selW.techId);
              var shiftLabel = open ? '<i class="bi bi-record-fill" style="color:var(--nexora-success)" aria-hidden="true"></i> In since ' + timeFmt(open.in) : (ses.length ? 'Clocked out' : 'Not in');
              var shiftCell = '<span class="tech-roster-shift">' + shiftLabel + '</span><div class="pos-muted" style="font-size:12px;margin-top:3px">' + clockHours(s.id).toFixed(1) + 'h today</div>';
              var ticketCell = !t ? '<span class="pos-muted">—</span>' : busy
                ? '<span class="tech-roster-ticket is-busy"><i class="bi bi-brush" aria-hidden="true"></i> ' + esc(busy) + '</span>'
                : '<span class="tech-roster-ticket is-free">Free</span>';
              if (match) ticketCell += '<div class="pos-muted" style="font-size:12px;margin-top:3px">Match <span class="match-badge" style="color:' + (match.sc >= 75 ? 'var(--nexora-success)' : match.sc >= 50 ? 'var(--nexora-warning)' : 'var(--nexora-danger)') + '">' + match.sc + '%' + (match.okSkill ? '' : ' ⚠') + '</span></div>';
              var turnsCell = t ? '<span class="tech-roster-turns">' + t.turns + ' turns' + (pos ? ' · #' + pos : '') + '</span>' + (!busy && next && next.id === t.id ? '<div class="next-chip"><i class="bi bi-bullseye" aria-hidden="true"></i> Next up</div>' : '') : '<span class="pos-muted">—</span>';
              var beepCell = t && BEEP[t.id] ? '<span class="pos-chip pos-chip-violet"><i class="bi bi-phone-vibrate-fill" aria-hidden="true"></i> #' + BEEP[t.id] + '</span>' : '<span class="pos-muted">—</span>';
              var stationCell = t ? '<input class="clk-station" id="clk-station-' + esc(s.id) + '" data-clk-bnum="' + esc(s.id) + '" aria-label="Station" value="' + esc(t.bnum) + '">' : '<span class="pos-muted">—</span>';
              var actions = '<button class="pos-btn ' + (open ? '' : 'pos-btn-primary ') + 'pos-btn-sm" data-clk="' + esc(s.id) + '">' + (open ? '<i class="bi bi-stop-circle" aria-hidden="true"></i> Clock out' : '<i class="bi bi-camera" aria-hidden="true"></i> Clock in') + '</button>';
              if (t) actions += '<button class="pos-btn pos-btn-sm" data-fpage="' + esc(t.id) + '" title="Beep this tech"><i class="bi bi-phone-vibrate-fill" aria-hidden="true"></i> Beep</button>';
              if (pickable) actions += '<button class="pos-btn pos-btn-primary pos-btn-sm" data-fassign="' + esc(t.id) + '"><i class="bi bi-person-check" aria-hidden="true"></i> Assign</button>';
              var cardActions = '<button class="perf-cta-btn' + (open ? ' perf-cta-btn-muted' : ' perf-cta-btn-primary') + '" data-clk="' + esc(s.id) + '">' + (open ? '<i class="bi bi-stop-circle" aria-hidden="true"></i> Clock out' : '<i class="bi bi-camera" aria-hidden="true"></i> Clock in') + '</button>';
              if (t) cardActions += '<button class="perf-cta-btn perf-cta-btn-muted" data-fpage="' + esc(t.id) + '" title="Beep this tech"><i class="bi bi-phone-vibrate-fill" aria-hidden="true"></i> Beep</button>';
              if (pickable) cardActions += '<button class="perf-cta-btn perf-cta-btn-primary" data-fassign="' + esc(t.id) + '"><i class="bi bi-person-check" aria-hidden="true"></i> Assign</button>';
              var warnHtml = (match && !match.okSkill && fWarn && fWarn.tid === t.id && selW && fWarn.wid === selW.id)
                ? '⚠ ' + esc(t.name) + ' has no <b>' + esc(match.req) + '</b> skill for "' + esc(posServiceDisplayName(selW.svc || '')) + '" — click Assign again to override (logged).'
                : '';
              rowsHtml += '<tr class="tech-roster-row' + (selW && !pickable ? ' dim' : '') + '">' +
                '<td><div class="tech-roster-person"><span class="pos-avatar' + (t ? '' : ' plain') + '">' + esc(initials(s.name)) + '</span><div><div class="tech-roster-person-name">' + esc(s.name) + '</div><div class="tech-roster-person-role">' + ROLE_LBL[s.role] + '</div></div></div></td>' +
                '<td>' + shiftCell + '</td>' +
                '<td>' + stationCell + '</td>' +
                '<td>' + ticketCell + '</td>' +
                '<td>' + turnsCell + '</td>' +
                '<td>' + beepCell + '</td>' +
                '<td><div class="tech-roster-actions">' + actions + '</div></td>' +
                '</tr>';
              if (warnHtml) rowsHtml += '<tr><td colspan="7" class="warn-row">' + warnHtml + '</td></tr>';

              cardsHtml += '<article class="queue-card perf-card' + (selW && !pickable ? ' dim' : '') + '">' +
                '<div class="perf-head">' +
                  '<span class="payroll-avatar">' + esc(initials(s.name)) + '</span>' +
                  '<div class="perf-head-main">' +
                    '<span class="perf-name">' + esc(s.name) + '</span>' +
                    '<div class="perf-sub" style="font-size:13px;margin-top:2px">' + ROLE_LBL[s.role] + '</div>' +
                    '<div style="margin-top:10px;font-size:14px;font-weight:800">' + shiftLabel + '</div>' +
                    '<div class="perf-sub" style="font-size:13px">' + clockHours(s.id).toFixed(1) + 'h today</div>' +
                  '</div>' +
                '</div>' +
                '<div class="perf-divider"></div>' +
                '<div class="owner-metric-grid">' +
                  '<div class="owner-metric-row">' +
                    '<div class="owner-metric-cell"><span class="perf-section-label">Station</span>' + stationCell + '</div>' +
                    '<div class="owner-metric-cell"><span class="perf-section-label">Current ticket</span>' +
                      (t ? '<span class="perf-stat-value ' + (busy ? 'tech-roster-ticket is-busy' : 'tech-roster-ticket is-free') + '">' + (busy ? esc(busy) : 'Free') + '</span>' : '<span class="perf-stat-value pos-muted">—</span>') +
                      (match ? '<div class="pos-muted" style="font-size:12px;margin-top:3px">Match <span class="match-badge" style="color:' + (match.sc >= 75 ? 'var(--nexora-success)' : match.sc >= 50 ? 'var(--nexora-warning)' : 'var(--nexora-danger)') + '">' + match.sc + '%' + (match.okSkill ? '' : ' ⚠') + '</span></div>' : '') +
                    '</div>' +
                  '</div>' +
                  '<div class="owner-metric-row">' +
                    '<div class="owner-metric-cell"><span class="perf-section-label">Turns today</span>' +
                      (t ? '<span class="perf-stat-value">' + t.turns + ' turns' + (pos ? ' · #' + pos : '') + '</span>' + (!busy && next && next.id === t.id ? '<div class="next-chip" style="margin-top:5px">Next up</div>' : '') : '<span class="perf-stat-value pos-muted">—</span>') +
                    '</div>' +
                    '<div class="owner-metric-cell"><span class="perf-section-label">Beeper</span>' + beepCell + '</div>' +
                  '</div>' +
                '</div>' +
                (warnHtml ? '<div class="perf-divider"></div><div class="pos-danger-text" style="font-size:13px;font-weight:600">' + warnHtml + '</div>' : '') +
                '<div class="perf-divider"></div>' +
                '<div class="perf-cta-row">' + cardActions + '</div>' +
                '</article>';
            });
            var hint = selW ? '<div class="sel-hint"><i class="bi bi-hand-index" aria-hidden="true"></i> Select Assign for a free tech to ' + (selW.status === 'service' ? 'reassign' : 'assign') + ' <b>' + esc(selW.name) + '</b>.</div>' : '';
            var tableBodyHtml = '<div class="tech-roster-table-wrap"><table class="tech-roster-table"><thead><tr><th scope="col">Technician</th><th scope="col">Shift</th><th scope="col">Station</th><th scope="col">Current ticket</th><th scope="col">Turns today</th><th scope="col">Beeper</th><th scope="col">Actions</th></tr></thead><tbody>' + rowsHtml + '</tbody></table></div>';
            html('[data-tech-roster-table]', hint + (techRosterViewMode === 'card' ? cardsHtml : tableBodyHtml));
            document.querySelectorAll('[data-tech-roster-view-target]').forEach(function (b) {
              var active = b.getAttribute('data-tech-roster-view-target') === techRosterViewMode;
              b.classList.toggle('is-active', active);
              b.setAttribute('aria-pressed', String(active));
            });
          }

          function renderClock() {
            var d = new Date();
            set('[data-clk-date]', d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' }));
            renderQr();

            var roster = STAFF.filter(function (s) { return s.role !== 'owner'; });
            set('[data-clk-oncount]', roster.filter(function (s) { return isOnShift(s.id); }).length + ' on shift');
            renderTechRosterTable();

            html('[data-clk-notif]', NOTIF.length
              ? NOTIF.slice(-6).reverse().map(function (n) { return '<div class="feed-line"><i class="bi bi-phone" aria-hidden="true"></i> ' + esc(n.msg) + '</div>'; }).join('')
              : '<div class="pos-muted">No notifications yet — a tech scanning the QR gets one automatically.</div>');

            var log = [];
            Object.keys(CLOCK).forEach(function (id) { (CLOCK[id] || []).forEach(function (x) { log.push({ id: id, x: x }); }); });
            log.sort(function (a, b) { return a.x.in - b.x.in; });
            html('[data-clk-log]', log.length ? log.map(function (r) {
              var s = STAFF.find(function (x) { return x.id === r.id; });
              var tail = r.x.out
                ? '→ out ' + timeFmt(r.x.out) + ' (' + ((r.x.out - r.x.in) / 3600000).toFixed(1) + 'h)'
                : '<span class="pos-good-text">· on shift</span>';
              return '<div class="feed-line"><b style="color:var(--nexora-text)">' + esc(s ? s.name : r.id) + '</b> · in ' + timeFmt(r.x.in) + ' ' + tail + '</div>';
            }).join('') : '<div class="pos-muted">No one has clocked in yet today.</div>');
          }

          document.addEventListener('click', function (e) {
            var b = e.target.closest('[data-clk]'); if (!b) return;
            var id = b.getAttribute('data-clk');
            var ses = CLOCK[id] || (CLOCK[id] = []);
            var open = ses.find(function (x) { return !x.out; });
            var st = STAFF.find(function (s) { return s.id === id; });
            if (!open) {
              if (qclkCheckin(id)) { renderClock(); toast(st.name + ' clocked in'); }
              return;
            }
            confirmBox('Clock ' + st.name + ' out?', 'Out at ' + timeFmt(Date.now()) + ' — production asks for their personal PIN.').then(function (ok) {
              if (!ok) return;
              open.out = Date.now();
              renderClock();
              toast(st.name + ' clocked out');
            });
          });
          document.addEventListener('focusout', function (e) {
            var b = e.target.closest('[data-clk-bnum]'); if (!b) return;
            var t = techById(b.getAttribute('data-clk-bnum')); if (!t) return;
            var v = parseInt(b.value, 10);
            if (v > 0) t.bnum = v;
            renderClock();
          });

          /* ═══════════ 🏢 MANAGEMENT ═══════════ */
          function mgKpisHtml(ps) {
            var rev = SALES.reduce(function (a, s) { return a + s.total; }, 0);
            var tips = SALES.reduce(function (a, s) { return a + s.tip; }, 0);
            var bills = SALES.length;
            return '<div class="pos-grid pos-g4">' +
              '<div class="pos-card"><div class="pos-kpi-label"><i class="bi bi-cash-stack" aria-hidden="true"></i> Revenue today</div><div class="pos-kpi-value">' + money0(rev) + '</div><div class="pos-kpi-foot"><span class="pos-chip pos-chip-green">' + bills + ' tickets paid</span></div></div>' +
              '<div class="pos-card"><div class="pos-kpi-label"><i class="bi bi-receipt" aria-hidden="true"></i> Average ticket</div><div class="pos-kpi-value">' + money(bills ? rev / bills : 0) + '</div><div class="pos-kpi-foot"><span class="pos-chip pos-chip-gray">tip included, after discounts</span></div></div>' +
              '<div class="pos-card"><div class="pos-kpi-label"><i class="bi bi-heart-fill" aria-hidden="true"></i> Tips today</div><div class="pos-kpi-value">' + money0(tips) + '</div><div class="pos-kpi-foot"><span class="pos-chip pos-chip-green">100% to techs</span></div></div>' +
              '<div class="pos-card"><div class="pos-kpi-label"><i class="bi bi-person-workspace" aria-hidden="true"></i> Waiting / service / pay</div><div class="pos-kpi-value">' + floorCount('waiting') + ' / ' + floorCount('service') + ' / ' + floorCount('ready') + '</div><div class="pos-kpi-foot"><span class="pos-chip pos-chip-blue">in the salon right now</span></div></div>' +
              '</div>';
          }

          function mgRevenueHtml() {
            var rev = SALES.reduce(function (a, s) { return a + s.total; }, 0);
            var week = WEEK_PREV.concat([['Today', rev]]);
            var mx = Math.max.apply(null, week.map(function (w) { return w[1]; }).concat([1]));
            return '<div class="pos-card">' +
              '<div class="pos-card-head"><h3><i class="bi bi-graph-up-arrow" aria-hidden="true"></i> Revenue — last 7 days</h3></div>' +
              '<div class="rev-bars">' + week.map(function (w, i) {
                return '<div class="rev-bar' + (i === week.length - 1 ? ' today' : '') + '">' +
                  '<span class="rv">' + money0(w[1]) + '</span>' +
                  '<div class="bar" style="height:' + Math.max(4, Math.round(w[1] / mx * 84)) + 'px"></div>' + w[0] + '</div>';
              }).join('') + '</div>' +
              '</div>';
          }

          var mgPayrollViewMode = DEFAULT_VIEW_MODE;
          function mgPayrollHtml(ps) {
            var daily = payrollStatsForDate(mgPayrollDate, ps);
            ps = daily.rows;
            var tableHtml = '<div class="pos-table-wrap"><table class="pos-table tight"><thead><tr>' +
              '<th>Tech</th><th>Turns</th><th><i class="bi bi-clock" aria-hidden="true"></i> Hours</th><th>Service $</th><th>Comm %</th><th>Commission</th><th>Tip</th><th>Tech takes</th><th>Weekly guarantee</th><th></th>' +
              '</tr></thead><tbody>' +
              TECHS.map(function (t) {
                var p = ps[t.id] || { svc: 0, tip: 0 };
                var comm = p.svc * t.comm;
                var hrs = p.hours;
                var onShift = mgPayrollDate === mgPayrollToday && isOnShift(t.id);
                return '<tr>' +
                  '<td><span class="pos-people"><span class="pos-avatar">' + initials(t.name) + '</span> <span class="pos-strong">' + esc(t.name) + '</span></span></td>' +
                  '<td>' + p.turns + '</td>' +
                  '<td>' + (hrs ? hrs.toFixed(1) + 'h' : '<span class="pos-warn-text">not in</span>') + (onShift ? ' <span class="pos-good-text">●</span>' : '') + '</td>' +
                  '<td class="pos-strong">' + money(p.svc) + '</td>' +
                  '<td><input class="pos-mini" data-mg-comm="' + t.id + '" value="' + Math.round(t.comm * 100) + '" style="width:52px"> %</td>' +
                  '<td>' + money(comm) + '</td>' +
                  '<td class="pos-good-text">' + money(p.tip) + '</td>' +
                  '<td class="pos-strong">' + money(comm + p.tip) + '</td>' +
                  '<td><input class="pos-mini" data-mg-guar="' + t.id + '" value="' + (t.guar || 0) + '" style="width:72px"></td>' +
                  '<td><button class="pos-btn pos-btn-danger pos-btn-sm" data-mg-fire="' + t.id + '">Deactivate</button></td>' +
                  '</tr>';
              }).join('') +
              '</tbody></table></div>';
            var cardsHtml = '<div data-mg-payroll-list>' + TECHS.map(function (t) {
              var p = ps[t.id] || { svc: 0, tip: 0 };
              var comm = p.svc * t.comm;
              var hrs = p.hours;
              var onShift = mgPayrollDate === mgPayrollToday && isOnShift(t.id);
              return '<article class="queue-card payroll-card">' +
                '<div class="perf-head">' +
                  '<span class="payroll-avatar">' + initials(t.name) + '</span>' +
                  '<div class="perf-head-main">' +
                    '<div class="perf-name-row"><span class="perf-name">' + esc(t.name) + '</span></div>' +
                    '<div class="pos-inline" style="margin-top:8px;gap:8px;flex-wrap:wrap">' +
                      '<span class="pos-chip pos-chip-violet" style="white-space:nowrap">' + p.turns + ' turns</span>' +
                      '<span class="pos-chip" style="background:#fff;border:1px solid var(--nexora-border);color:var(--nexora-text);white-space:nowrap">' + (hrs ? hrs.toFixed(1) + 'h' : '<span class="pos-warn-text">not in</span>') + (onShift ? ' <span class="pos-good-text">●</span>' : '') + '</span>' +
                    '</div>' +
                  '</div>' +
                  '<button class="pos-btn pos-btn-danger-outline pos-btn-sm" style="margin-left:auto" data-mg-fire="' + t.id + '">Deactivate</button>' +
                '</div>' +
                '<div class="perf-divider"></div>' +
                '<div class="payroll-metric-grid">' +
                  '<div class="payroll-metric-box"><span class="perf-section-label">Service $</span><span class="perf-stat-value">' + money(p.svc) + '</span></div>' +
                  '<div class="payroll-metric-box"><span class="perf-section-label">Commission</span><span class="perf-stat-value">' + money(comm) + '</span></div>' +
                  '<div class="payroll-metric-box"><span class="perf-section-label">Tip</span><span class="perf-stat-value pos-good-text">' + money(p.tip) + '</span></div>' +
                  '<div class="payroll-metric-box"><span class="perf-section-label">Tech takes</span><span class="perf-stat-value">' + money(comm + p.tip) + '</span></div>' +
                '</div>' +
                '<div class="perf-divider"></div>' +
                '<div class="payroll-foot-row">' +
                  '<div class="payroll-foot-col"><span class="perf-section-label">Comm %</span><span class="pos-inline" style="justify-content:center;gap:2px"><input class="payroll-foot-input" style="width:48px" data-mg-comm="' + t.id + '" value="' + Math.round(t.comm * 100) + '">%</span></div>' +
                  '<div class="payroll-foot-col"><span class="perf-section-label">Weekly guarantee</span><input class="payroll-foot-input" data-mg-guar="' + t.id + '" value="' + (t.guar || 0) + '"></div>' +
                '</div>' +
                '</article>';
            }).join('') + '</div>';
            return '<div class="pos-card">' +
              '<div class="pos-card-head"><h3><i class="bi bi-people-fill" aria-hidden="true"></i> Techs &amp; pay — ' + esc(payrollDateLabel(mgPayrollDate)) + '</h3>' +
              '<div class="pos-inline">' +
                '<label class="pos-inline-lbl">Date<input class="pos-input mg-payroll-date-input" type="date" data-mg-payroll-date value="' + esc(mgPayrollDate) + '" max="' + esc(mgPayrollToday) + '" aria-label="Filter Techs and pay by date"></label>' +
                '<div class="booking-view-switch" role="group" aria-label="Techs and pay view mode">' +
                  '<button class="booking-view-button' + (mgPayrollViewMode === 'table' ? ' is-active' : '') + '" type="button" data-mg-payroll-view-target="table" aria-pressed="' + (mgPayrollViewMode === 'table' ? 'true' : 'false') + '"><i class="bi bi-table" aria-hidden="true"></i>Table</button>' +
                  '<button class="booking-view-button' + (mgPayrollViewMode === 'card' ? ' is-active' : '') + '" type="button" data-mg-payroll-view-target="card" aria-pressed="' + (mgPayrollViewMode === 'card' ? 'true' : 'false') + '"><i class="bi bi-grid-1x2" aria-hidden="true"></i>Card</button>' +
                '</div>' +
                '<button class="pos-btn pos-btn-primary pos-btn-sm" type="button" data-mg-addtech><i class="bi bi-person-plus"></i> Add tech</button>' +
              '</div></div>' +
              (daily.hasActivity ? '' : '<div class="swap-tech-empty" style="margin-bottom:14px"><i class="bi bi-calendar-x" aria-hidden="true"></i> No payroll activity for this date.</div>') +
              (mgPayrollViewMode === 'card' ? cardsHtml : tableHtml) +
              '<div class="pos-hint">Edit commission % or the weekly guarantee: type a number then click away. "Deactivate" keeps payroll and tax history — nothing is deleted.</div>' +
              '</div>';
          }

          function techModalRandomPin() { return String(Math.floor(1000 + Math.random() * 9000)); }

          function formatUsPhoneInput(value) {
            var raw = value || '';
            var digits = raw.replace(/\D/g, '');
            if (/^\s*\+1/.test(raw) && digits.charAt(0) === '1') digits = digits.slice(1);
            if (!digits) return '';
            if (digits.length <= 3) return '(' + digits;
            if (digits.length <= 6) return '(' + digits.slice(0, 3) + ') ' + digits.slice(3);
            return '(' + digits.slice(0, 3) + ') ' + digits.slice(3, 6) + '-' + digits.slice(6);
          }

          /* ── tech modal: services picker — categorized, collapsible checklist built from the live Menu catalog ── */
          function mgTechServiceOptionsForCategory(categoryId) {
            var selectorValue = String(categoryId || '').replace(/\\/g, '\\\\').replace(/"/g, '\\"');
            return Array.from(document.querySelectorAll('[data-mg-tech-service][data-mg-tech-service-category="' + selectorValue + '"]'));
          }

          function syncMgTechServiceCheckAll() {
            var services = Array.from(document.querySelectorAll('[data-mg-tech-service]'));
            var checkAll = $('[data-mg-tech-service-all]');
            var checkedCount = services.filter(function (option) { return option.checked; }).length;
            if (checkAll) {
              checkAll.disabled = services.length === 0;
              checkAll.checked = services.length > 0 && checkedCount === services.length;
              checkAll.indeterminate = checkedCount > 0 && checkedCount < services.length;
            }
            document.querySelectorAll('[data-mg-tech-service-category-all]').forEach(function (categoryAll) {
              var categoryServices = mgTechServiceOptionsForCategory(categoryAll.getAttribute('data-mg-tech-service-category-all'));
              var categoryCheckedCount = categoryServices.filter(function (option) { return option.checked; }).length;
              categoryAll.disabled = categoryServices.length === 0;
              categoryAll.checked = categoryServices.length > 0 && categoryCheckedCount === categoryServices.length;
              categoryAll.indeterminate = categoryCheckedCount > 0 && categoryCheckedCount < categoryServices.length;
            });
          }

          function mgTechServiceCategoryMarkup(group, index) {
            var categoryId = 'mgtechcat-' + index;
            var services = group.services || [];
            return '<details class="tech-service-category" data-mg-tech-service-category-panel="' + esc(categoryId) + '"' + (index === 0 ? ' open' : '') + '>' +
              '<summary class="tech-service-category-head"><label class="tech-service-category-all"><input type="checkbox" data-mg-tech-service-category-all="' + esc(categoryId) + '">Check all</label><span class="tech-service-category-title">' + esc(group.name || 'Other services') + '</span><span class="tech-service-category-count">' + services.length + '</span><i class="bi bi-chevron-down tech-service-category-chevron" aria-hidden="true"></i></summary>' +
              '<div class="tech-service-category-body">' + services.map(function (service) {
                return '<label class="tech-service-check"><input type="checkbox" data-mg-tech-service data-mg-tech-service-category="' + esc(categoryId) + '" value="' + esc(service.label) + '">' + esc(service.label) + '</label>';
              }).join('') + '</div></details>';
          }

          function buildMgTechServicePicker() {
            var container = $('[data-mg-tech-service-picker]');
            if (!container) return;
            var groups = groupedServicesByCategory(MENU).filter(function (group) { return group.services.length; });
            var serviceCount = groups.reduce(function (total, group) { return total + group.services.length; }, 0);
            container.innerHTML = '<div class="tech-service-picker-toolbar"><label><input type="checkbox" data-mg-tech-service-all>Check all categories</label><span class="tech-service-picker-count">' + serviceCount + '</span></div>' +
              (groups.length ? groups.map(mgTechServiceCategoryMarkup).join('') : '<div class="tech-service-catalog-state">No services available.</div>');
            container.querySelectorAll('[data-mg-tech-service-category-all]').forEach(function (categoryAll) {
              categoryAll.addEventListener('click', function (event) { event.stopPropagation(); });
            });
            syncMgTechServiceCheckAll();
          }

          function getMgTechServicesValue() {
            return Array.from(document.querySelectorAll('[data-mg-tech-service]:checked')).map(function (option) { return option.value; }).filter(Boolean);
          }

          /* ── tech modal: weekly schedule grid ── */
          var MG_TECH_DAYS = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'];

          function syncMgTechDayOffRow(dayOff) {
            if (!dayOff) return;
            var day = dayOff.getAttribute('data-mg-tech-day-off');
            var row = dayOff.closest('.tech-schedule-row');
            var start = $('[data-mg-tech-schedule-start="' + day + '"]');
            var end = $('[data-mg-tech-schedule-end="' + day + '"]');
            var isDayOff = Boolean(dayOff.checked);
            if (row) row.classList.toggle('is-day-off', isDayOff);
            [start, end].forEach(function (input) {
              if (!input) return;
              input.disabled = isDayOff;
              if (isDayOff) input.value = '';
            });
          }

          function parseMgTechSchedule(value) {
            var schedule = {};
            (value || '').split(';').forEach(function (entry) {
              var parts = entry.split('=');
              if (parts.length !== 2) return;
              var day = parts[0].trim();
              var range = parts[1].split('-');
              if (!day || range.length !== 2) return;
              schedule[day] = { start: range[0].trim(), end: range[1].trim() };
            });
            return schedule;
          }

          function setMgTechScheduleValue(value, options) {
            var schedule = parseMgTechSchedule(value);
            MG_TECH_DAYS.forEach(function (day) {
              var dayOff = $('[data-mg-tech-day-off="' + day + '"]');
              if (!dayOff) return;
              var daySchedule = schedule[day];
              var start = $('[data-mg-tech-schedule-start="' + day + '"]');
              var end = $('[data-mg-tech-schedule-end="' + day + '"]');
              dayOff.checked = options && options.blank ? false : !daySchedule;
              if (start) start.value = daySchedule ? daySchedule.start : '';
              if (end) end.value = daySchedule ? daySchedule.end : '';
              syncMgTechDayOffRow(dayOff);
            });
          }

          function getMgTechScheduleValue() {
            return MG_TECH_DAYS.map(function (day) {
              var dayOff = $('[data-mg-tech-day-off="' + day + '"]');
              if (!dayOff || dayOff.checked) return '';
              var start = $('[data-mg-tech-schedule-start="' + day + '"]');
              var end = $('[data-mg-tech-schedule-end="' + day + '"]');
              var startValue = start ? start.value : '';
              var endValue = end ? end.value : '';
              return startValue && endValue ? day + '=' + startValue + '-' + endValue : '';
            }).filter(Boolean).join(';');
          }

          /* ── tech modal: "Choose from list" combobox (search an existing tech, or Enter manually) ── */
          function mgTechChoiceRecords() {
            return TECHS.map(function (t) {
              var raw = salonData.findTechnician(salonCatalog, t.id) || {};
              var services = Array.isArray(raw.services) && raw.services.length ? raw.services : (t.skills || []);
              return { id: t.id, name: t.name, phone: raw.phone || '', email: raw.email || '', services: services, schedule: raw.schedule || '' };
            });
          }

          function renderMgTechChoices() {
            var grid = $('[data-mg-tech-choice-grid]');
            if (!grid) return;
            grid.innerHTML = mgTechChoiceRecords().map(function (t) {
              return '<button class="tech-choice-card" type="button" role="option" data-mg-tech-choice="' + esc(t.id) + '" data-name="' + esc(t.name) + '" data-phone="' + esc(t.phone) + '" data-email="' + esc(t.email) + '" data-services="' + esc(t.services.join(', ')) + '" data-schedule="' + esc(t.schedule) + '">' +
                '<span class="tech-avatar">' + esc((t.name || 'T').charAt(0).toUpperCase()) + '</span>' +
                '<span><span class="tech-choice-name">' + esc(t.name) + '</span><span class="tech-choice-meta">' + esc([t.email, t.phone].filter(Boolean).join(' · ') || (t.services[0] || '')) + '</span></span></button>';
            }).join('');
          }

          function filterMgTechChoices(query) {
            var normalized = (query || '').trim().toLowerCase();
            var visibleCount = 0;
            document.querySelectorAll('[data-mg-tech-choice]').forEach(function (choice) {
              var haystack = [choice.dataset.name, choice.dataset.phone, choice.dataset.email, choice.dataset.services, choice.textContent].join(' ').toLowerCase();
              var visible = !normalized || haystack.indexOf(normalized) !== -1;
              choice.hidden = !visible;
              if (visible) visibleCount++;
            });
            var empty = $('[data-mg-tech-empty]');
            if (empty) empty.classList.toggle('is-visible', Boolean(normalized) && visibleCount === 0);
          }

          function setMgTechSelectOpen(open) {
            var menu = $('[data-mg-tech-select-menu]');
            var input = $('[data-mg-tech-select-input]');
            var combobox = $('[data-mg-tech-combobox]');
            if (menu) menu.hidden = !open;
            if (input) input.setAttribute('aria-expanded', open ? 'true' : 'false');
            if (combobox) combobox.classList.toggle('is-open', Boolean(open));
          }

          function updateMgTechModalCopy(mode, techName) {
            var title = $('[data-mg-tech-modal-title]');
            var sub = $('[data-mg-tech-modal-sub]');
            var isCreate = mode === 'create';
            if (title) title.textContent = isCreate ? 'Add technician' : 'Edit technician';
            if (sub) sub.textContent = isCreate ? 'Enter new technician info, services, schedule, login and pay.' : ('Update profile, services, schedule, login and pay for ' + (techName || 'this technician') + '.');
          }

          function fillMgTechModalFromChoice(choice) {
            if (!choice) return;
            document.querySelectorAll('[data-mg-tech-choice], [data-mg-tech-create]').forEach(function (button) {
              button.classList.toggle('is-active', button === choice);
            });

            var isCreate = choice.hasAttribute('data-mg-tech-create');
            var modal = $('[data-mg-tech-modal]');
            var selectInput = $('[data-mg-tech-select-input]');
            if (modal) modal.dataset.mgTechMode = isCreate ? 'create' : 'edit';
            if (selectInput) selectInput.value = isCreate ? '' : (choice.dataset.name || '');
            updateMgTechModalCopy(isCreate ? 'create' : 'edit', choice.dataset.name);

            $('[data-mg-tech-form-name]').value = isCreate ? '' : (choice.dataset.name || '');
            $('[data-mg-tech-form-phone]').value = isCreate ? '' : formatUsPhoneInput(choice.dataset.phone || '');
            $('[data-mg-tech-form-email]').value = isCreate ? '' : (choice.dataset.email || '');
            var services = isCreate ? [] : String(choice.dataset.services || '').split(',').map(function (s) { return s.trim(); }).filter(Boolean);
            document.querySelectorAll('[data-mg-tech-service]').forEach(function (option) {
              option.checked = services.map(function (s) { return s.toLowerCase(); }).indexOf(option.value.toLowerCase()) !== -1;
            });
            syncMgTechServiceCheckAll();
            setMgTechScheduleValue(isCreate ? '' : (choice.dataset.schedule || ''), { blank: isCreate });

            $('[data-mg-tech-form-pin]').value = techModalRandomPin();
            if (!isCreate) {
              var staffRec = STAFF.find(function (s) { return s.id === choice.getAttribute('data-mg-tech-choice'); });
              if (staffRec && staffRec.pin) $('[data-mg-tech-form-pin]').value = staffRec.pin;
            }

            var roleEl = $('[data-mg-tech-form-role]');
            if (roleEl) { roleEl.value = 'tech'; roleEl.disabled = !isCreate; }

            var payModelEl = $('[data-mg-tech-form-paymodel]');
            if (!isCreate) {
              var t = techById(choice.getAttribute('data-mg-tech-choice'));
              if (payModelEl && t) payModelEl.value = t.payModel || 'max';
              $('[data-mg-tech-form-comm]').value = t ? Math.round((t.comm || 0) * 100) : 60;
              $('[data-mg-tech-form-guar]').value = t ? (t.guar || 0) : 0;
              $('[data-mg-tech-form-split]').value = t ? Math.round((t.baoSplit || t.comm || 0) * 100) : 60;
            } else {
              if (payModelEl) payModelEl.value = 'max';
              $('[data-mg-tech-form-comm]').value = '60';
              $('[data-mg-tech-form-guar]').value = '0';
              $('[data-mg-tech-form-split]').value = '60';
            }
            updateTechModalPayVisibility();

            setMgTechSelectOpen(false);
            $('[data-mg-tech-form-name]').focus();
          }

          function updateTechModalPayVisibility() {
            var roleEl = $('[data-mg-tech-form-role]');
            var payModelEl = $('[data-mg-tech-form-paymodel]');
            var paySection = $('[data-mg-tech-pay-section]');
            var guarField = $('[data-mg-tech-guar-field]');
            var splitField = $('[data-mg-tech-split-field]');
            if (paySection) paySection.hidden = roleEl && roleEl.value !== 'tech';
            var m = payModelEl ? payModelEl.value : 'max';
            if (guarField) guarField.hidden = m === 'comm';
            if (splitField) splitField.hidden = m !== 'baoshare';
          }

          function setTechModalError(msg) {
            var errorEl = $('[data-mg-tech-form-error]');
            if (!errorEl) return;
            errorEl.textContent = msg || '';
            errorEl.hidden = !msg;
          }

          function openTechModal(initialChoice, mode) {
            var modal = $('[data-mg-tech-modal]');
            if (!modal) return;
            var payModelEl = $('[data-mg-tech-form-paymodel]');
            if (payModelEl) payModelEl.innerHTML = Object.keys(PAY_MODELS).map(function (k) { return '<option value="' + k + '">' + esc(PAY_MODELS[k]) + '</option>'; }).join('');
            renderMgTechChoices();
            buildMgTechServicePicker();
            var search = $('[data-mg-tech-search]');
            if (search) search.value = '';
            filterMgTechChoices('');
            setTechModalError('');
            var createButton = $('[data-mg-tech-create]');
            var fallbackChoice = mode === 'create'
              ? createButton
              : ($('[data-mg-tech-choice].is-active') || $('[data-mg-tech-choice]') || createButton);
            fillMgTechModalFromChoice(initialChoice || fallbackChoice);
            modal.hidden = false;
            document.body.style.overflow = 'hidden';
            setMgTechSelectOpen(false);
          }

          function openNewTechModal() {
            openTechModal($('[data-mg-tech-create]'), 'create');
          }

          function closeTechModal() {
            var modal = $('[data-mg-tech-modal]');
            if (!modal) return;
            modal.hidden = true;
            setMgTechSelectOpen(false);
            document.body.style.overflow = '';
            setTechModalError('');
          }

          function saveTechModal() {
            var modal = $('[data-mg-tech-modal]');
            var mode = modal ? modal.dataset.mgTechMode : 'create';
            var activeChoice = $('[data-mg-tech-choice].is-active');
            var nameEl = $('[data-mg-tech-form-name]');
            var roleEl = $('[data-mg-tech-form-role]');
            var phoneEl = $('[data-mg-tech-form-phone]');
            var emailEl = $('[data-mg-tech-form-email]');
            var pinEl = $('[data-mg-tech-form-pin]');
            var payModelEl = $('[data-mg-tech-form-paymodel]');
            var commEl = $('[data-mg-tech-form-comm]');
            var guarEl = $('[data-mg-tech-form-guar]');
            var splitEl = $('[data-mg-tech-form-split]');
            var nm = (nameEl.value || '').trim();
            if (!nm) { setTechModalError('Enter a name for the account.'); nameEl.focus(); return; }
            var pin = (pinEl.value || '').trim();
            if (!/^\d{4}$/.test(pin)) { setTechModalError('Login PIN must be 4 digits.'); pinEl.focus(); return; }
            var phone = (phoneEl.value || '').trim();
            var email = (emailEl.value || '').trim();
            var services = getMgTechServicesValue();
            var schedule = getMgTechScheduleValue();
            var payModel = payModelEl.value || 'max';
            var cm = Math.min(100, Math.max(1, parseFloat(commEl.value) || 60)) / 100;
            var gu = Math.max(0, parseFloat(guarEl.value) || 0);
            var sp = Math.min(100, Math.max(0, parseFloat(splitEl.value) || 0)) / 100;
            var skills = services.map(function (serviceName) {
              var service = salonData.findService(salonCatalog, serviceName);
              return service && service.requiredSkill ? service.requiredSkill : serviceName;
            });

            if (mode === 'edit' && activeChoice) {
              var editId = activeChoice.getAttribute('data-mg-tech-choice');
              var nextCatalog = salonData.loadCatalog();
              var nextTechnicians = nextCatalog.technicians.map(function (technician) {
                if (technician.id !== editId) return technician;
                return Object.assign({}, technician, {
                  name: nm, phone: phone, email: email, schedule: schedule, services: services,
                  skills: Array.from(new Set(skills)),
                  posProfile: Object.assign({}, technician.posProfile || {}, { comm: cm, guar: gu, payModel: payModel, baoSplit: payModel === 'baoshare' ? sp : cm })
                });
              });
              salonData.saveCatalog(Object.assign({}, nextCatalog, { technicians: nextTechnicians }));
              rebuildSalonCatalogViews();
              var staffRec = STAFF.find(function (s) { return s.id === editId; });
              if (staffRec) { staffRec.name = nm; staffRec.ava = initials(nm); staffRec.phone = phone; staffRec.email = email; staffRec.pin = pin; }
              logAdmin('✏️ Updated tech ' + nm + ' — ' + PAY_MODELS[payModel] + ', ' + Math.round(cm * 100) + '%');
              closeTechModal();
              renderManagement(); renderClock(); renderBookingTab(); toast(nm + ' updated');
              return;
            }

            var role = roleEl.value;
            if (role !== 'tech') {
              STAFF.push({ id: 'st' + (++stSeq), name: nm, ava: initials(nm), role: role, phone: phone, email: email, pin: pin });
              logAdmin('👥 Created ' + ROLE_LBL[role] + ' account: ' + nm + ' (PIN ' + pin + ', sent by SMS)');
              closeTechModal();
              renderManagement(); renderClock(); toast(nm + ' added');
              return;
            }

            var maxN = TECHS.reduce(function (m, t) { return Math.max(m, +t.id.slice(1) || 0); }, 0);
            var id = 't' + (maxN + 1);
            var bn = TECHS.reduce(function (m, t) { return Math.max(m, t.bnum || 0); }, 0) + 1;
            var nextCatalog = salonData.loadCatalog();
            nextCatalog.technicians.push({
              id: id, name: nm, phone: phone, email: email, schedule: schedule, aliases: [], active: true,
              skills: Array.from(new Set(skills)), exp: [], fit: [], services: services,
              posProfile: { bnum: bn, turns: 0, comm: cm, guar: gu, payModel: payModel, baoSplit: payModel === 'baoshare' ? sp : cm, vlink: null }
            });
            salonData.saveCatalog(nextCatalog);
            rebuildSalonCatalogViews();
            STAFF.push({ id: id, name: nm, ava: initials(nm), role: 'tech', phone: phone, email: email, pin: pin });
            CLOCK[id] = [];
            PAYOUT[id] = { st: 'pending', method: null };
            TECH_PERF[id] = { wtd: 0, rating: null, rev: 0, bills: 0, upsBills: 0 };
            REBOOK[id] = { elig: 0, rb: 0 };
            REWORK[id] = 0;
            logAdmin('➕ Added tech ' + nm + ' — ' + PAY_MODELS[payModel] + ', ' + Math.round(cm * 100) + '%' + (payModel !== 'comm' ? ' / ' + money0(gu) + ' guarantee' : '') + ' (PIN ' + pin + ')');
            closeTechModal();
            renderManagement(); renderClock(); renderBookingTab(); toast(nm + ' added');
          }

          function mgSkillsHtml() {
            return '<div class="pos-card">' +
              '<div class="pos-card-head"><h3><i class="bi bi-tools" aria-hidden="true"></i> Tech skills — dispatch scores matches off this table</h3></div>' +
              '<div class="pos-table-wrap"><table class="pos-table tight"><thead><tr><th>Tech</th>' +
              SKILLS.map(function (s) { return '<th style="text-align:center">' + s + '</th>'; }).join('') +
              '</tr></thead><tbody>' +
              TECHS.map(function (t) {
                return '<tr><td><span class="pos-people"><span class="pos-avatar">' + initials(t.name) + '</span> <span class="pos-strong">' + esc(t.name) + '</span></span></td>' +
                  SKILLS.map(function (sk) {
                    var on = (t.skills || []).indexOf(sk) !== -1;
                    var ex = on && (t.exp || []).indexOf(sk) !== -1;
                    var state = ex ? 2 : on ? 1 : 0;
                    return '<td style="text-align:center"><button class="cyc" data-mg-skill="' + t.id + '|' + sk + '" data-on="' + state + '">' + (ex ? '★' : on ? '✓' : '—') + '</button></td>';
                  }).join('') + '</tr>';
              }).join('') +
              '</tbody></table></div>' +
              '<div class="pos-hint">Tap a cell to cycle: — → ✓ Good → ★ Expert → off. ★ Expert adds +' + MATCH_RULES.wExp + ' match points on the required skill and is a 💎 Smart Commission condition. Techs missing a skill get flagged at assignment (an override is written to the audit log).</div>' +
              '</div>';
          }

          var mgSvcSkillViewMode = DEFAULT_VIEW_MODE;
          function mgSvcSkillHtml() {
            var mrInp = function (k, lbl) {
              return '<label class="pos-inline-lbl">' + lbl + '<input class="pos-mini" data-mg-mr="' + k + '" value="' + MATCH_RULES[k] + '" style="width:52px"></label>';
            };
            var svcSkillRowHtml = function (c) {
              var req = SVC_REQ[c.id] || '';
              var el = TECHS.filter(function (t) { return !req || (t.skills || []).indexOf(req) !== -1; });
              var elTxt = !req ? '<span class="pos-muted">all techs</span>'
                : el.length ? el.map(function (t) { return esc(t.name) + ((t.exp || []).indexOf(req) !== -1 ? ' ★' : ''); }).join(', ')
                : '<span class="pos-danger-text">⚠ No tech has this skill — guests will get stuck</span>';
              var reqSelect = '<select class="pos-input" data-mg-svcreq="' + c.id + '" style="height:32px;font-size:13px">' +
                '<option value="">— none required —</option>' +
                SKILLS.map(function (s) { return '<option value="' + s + '"' + (req === s ? ' selected' : '') + '>' + s + '</option>'; }).join('') +
                '</select>';
              return { reqSelect: reqSelect, elTxt: elTxt };
            };
            var groups = groupedServicesByCategory(MENU).filter(function (group) { return group.services.length; });
            var tableHtml = '<div class="pos-table-wrap"><table class="pos-table tight"><thead><tr><th>Service</th><th>Required skill</th><th>Eligible techs (★ = expert)</th></tr></thead><tbody>' +
              groups.map(function (group) {
                return '<tr><td colspan="3" style="background:var(--nexora-surface-muted);color:var(--nexora-muted);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.03em">' + esc(group.name) + ' · ' + group.services.length + '</td></tr>' +
                  group.services.map(function (c) {
                    var x = svcSkillRowHtml(c);
                    return '<tr><td class="pos-strong">' + esc(c.label) + '</td>' +
                      '<td>' + x.reqSelect + '</td><td class="wrap">' + x.elTxt + '</td></tr>';
                  }).join('');
              }).join('') +
              '</tbody></table></div>';
            var cardsHtml = groups.map(function (group) {
              return '<div class="pos-section-title">' + esc(group.name) + ' · ' + group.services.length + '</div>' +
                '<div data-mg-svcskill-list>' + group.services.map(function (c) {
                  var x = svcSkillRowHtml(c);
                  return '<article class="queue-card">' +
                    '<div class="queue-card-head"><div class="queue-card-identity pos-strong">' + esc(c.label) + '</div></div>' +
                    '<div class="queue-card-meta"><span class="pos-muted" style="font-size:11px">Required skill</span>' + x.reqSelect + '</div>' +
                    '<div class="wrap" style="font-size:12px">' + x.elTxt + '</div>' +
                    '</article>';
                }).join('') + '</div>';
            }).join('');
            return '<div class="pos-card">' +
              '<div class="pos-card-head"><h3><i class="bi bi-receipt" aria-hidden="true"></i> Service → required skill</h3>' +
              '<div class="pos-inline">' +
                '<span class="pos-muted">kiosk · dispatch · Staff App all read this — no guessing</span>' +
                '<div class="booking-view-switch" role="group" aria-label="Service skill view mode">' +
                  '<button class="booking-view-button' + (mgSvcSkillViewMode === 'table' ? ' is-active' : '') + '" type="button" data-mg-svcskill-view-target="table" aria-pressed="' + (mgSvcSkillViewMode === 'table' ? 'true' : 'false') + '"><i class="bi bi-table" aria-hidden="true"></i>Table</button>' +
                  '<button class="booking-view-button' + (mgSvcSkillViewMode === 'card' ? ' is-active' : '') + '" type="button" data-mg-svcskill-view-target="card" aria-pressed="' + (mgSvcSkillViewMode === 'card' ? 'true' : 'false') + '"><i class="bi bi-grid-1x2" aria-hidden="true"></i>Card</button>' +
                '</div>' +
              '</div></div>' +
              (mgSvcSkillViewMode === 'card' ? cardsHtml : tableHtml) +
              '<div class="pos-section-title"><i class="bi bi-sliders" aria-hidden="true"></i> Match rules — assignment weights (dispatch reads them live)</div>' +
              '<div class="pos-inline" style="gap:14px">' +
              mrInp('wSkill', '✓ Has the skill (base)') + mrInp('wMiss', '⚠ Missing the skill') + mrInp('wExp', '★ Expert +') +
              mrInp('wTurn', '⚖️ Fairness max +') + mrInp('wReq', '<i class="bi bi-person" aria-hidden="true"></i> Guest requested +') + mrInp('wPref', '🏷️ Regular tech +') + mrInp('wFit', '🤝 Customer fit +') +
              '<label class="pos-inline-lbl"><input type="checkbox" data-mg-mruse' + (MATCH_RULES.useTurn ? ' checked' : '') + ' style="accent-color:var(--nexora-brand);width:16px;height:16px"> ⚖️ Count turn fairness</label>' +
              '<label class="pos-inline-lbl">Wrong-skill override:<select class="pos-input" data-mg-mrovr style="height:32px;font-size:13px">' +
              ['manager|Manager PIN required', 'reason|Reason required (text)', 'free|Two taps, log only'].map(function (o) {
                var p = o.split('|');
                return '<option value="' + p[0] + '"' + (MATCH_RULES.override === p[0] ? ' selected' : '') + '>' + p[1] + '</option>';
              }).join('') + '</select></label>' +
              '</div>' +
              '</div>';
          }

          var mgWeekPickers = [];
          function initMgWeekPickers() {
            var inputs = document.querySelectorAll('[data-mg-week]');
            if (!inputs.length || !window.flatpickr || !window.weekSelect) return;
            mgWeekPickers = Array.prototype.map.call(inputs, function (input) {
              return window.flatpickr(input, {
                defaultDate: mgPerfWeek,
                dateFormat: 'Y-m-d',
                allowInput: true,
                disableMobile: true,
                locale: { firstDayOfWeek: 0 },
                plugins: [new window.weekSelect()]
              });
            });
          }

          var mgPerfViewMode = DEFAULT_VIEW_MODE;
          function mgPerfHtml(ps) {
            var selectedWeek = performanceWeekData(mgPerfWeek, ps);
            var daysDone = Math.max(1, Number(selectedWeek.daysDone) || AD_DAYS_DONE);
            var daysWeek = Math.max(1, Number(selectedWeek.daysWeek) || AD_DAYS_WEEK);
            var rows = TECHS.map(function (t) {
              var pf = selectedWeek.tech[t.id] || { done: 0, rating: null, reviews: 0, bills: 0, upsBills: 0, rebookEligible: 0, rebooked: 0, rework: 0 };
              var done = Number(pf.done) || 0;
              var target = (t.guar && t.comm) ? t.guar / t.comm : 0;   // service $ needed to cover the guarantee
              var daily = target / daysWeek;
              var proj = done / daysDone * daysWeek;                   // run-rate projection for the full week
              var gap = (t.guar || 0) - proj * t.comm;                 // >0 the salon tops up, <0 the salon profits
              var daysLeft = daysWeek - daysDone;
              var needDay = daysLeft > 0 ? Math.max(0, (target - done) / daysLeft) : 0;
              var billsTot = Number(pf.bills) || 0;
              var ups = billsTot ? (Number(pf.upsBills) || 0) / billsTot : 0;
              var rbk = { elig: Number(pf.rebookEligible) || 0, rb: Number(pf.rebooked) || 0 };
              return {
                t: t, pf: pf, done: done, target: target, daily: daily, proj: proj, gap: gap, needDay: needDay,
                ups: ups, billsTot: billsTot, rbRate: rbk.elig ? rbk.rb / rbk.elig : 0, rbk: rbk, rework: Number(pf.rework) || 0
              };
            }).sort(function (a, b) { return b.gap - a.gap; });

            var perfRowHtml = function (r) {
              var p = r.target ? Math.min(100, Math.round(r.done / r.target * 100)) : 100;
              var status = r.gap > 0
                ? '<span class="pos-warn-text">🔻 Salon tops up ~' + money0(r.gap) + '</span><div class="pos-muted" style="font-size:12px;font-weight:600">' +
                  (daysWeek > daysDone ? '→ needs ' + money0(r.needDay) + '/day for the last ' + (daysWeek - daysDone) + ' day(s)' : 'Week closed — guarantee top-up applies') + '</div>'
                : '<span class="pos-good-text">✅ Over the guarantee — salon nets ~' + money0(-r.gap) + '</span>';
              var rating = r.pf.rating == null ? '<span class="pos-muted">none yet</span>'
                : '<span class="' + (r.pf.rating < 4.5 ? 'pos-danger-text' : '') + '">' + r.pf.rating.toFixed(1) + '</span> <span class="pos-muted" style="font-size:12px">(' + r.pf.reviews + ')</span>' +
                  (r.pf.rating < 4.5 ? '<div class="pos-warn-text" style="font-size:12px">→ read the reviews, coach</div>' : '');
              var upsTxt = '<span class="' + (r.ups < 0.15 ? 'pos-danger-text' : '') + '">' + pct(r.ups) + '</span> <span class="pos-muted" style="font-size:12px">/' + r.billsTot + ' bills</span>' +
                (r.ups < 0.15 ? '<div class="pos-warn-text" style="font-size:12px">→ push gel upgrade, design</div>' : '');
              return { p: p, status: status, rating: rating, upsTxt: upsTxt };
            };
            var tableHtml = '<div class="pos-table-wrap"><table class="pos-table tight"><thead><tr>' +
              '<th>Tech</th><th>Guarantee</th><th>Needs /week</th><th>/day</th><th>Done this week</th><th>Projected</th><th>Guarantee vs earnings</th><th><i class="bi bi-star-fill" aria-hidden="true"></i> Rating</th><th>Upsell</th><th><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Rebook</th><th><i class="bi bi-wrench" aria-hidden="true"></i> Rework</th>' +
              '</tr></thead><tbody>' +
              rows.map(function (r) {
                var x = perfRowHtml(r);
                return '<tr>' +
                  '<td><span class="pos-people"><span class="pos-avatar">' + initials(r.t.name) + '</span> <span class="pos-strong">' + esc(r.t.name) + '</span></span></td>' +
                  '<td>' + money0(r.t.guar || 0) + '</td><td class="pos-strong">' + money0(r.target) + '</td><td>' + money0(r.daily) + '</td>' +
                  '<td style="min-width:130px">' + money0(r.done) + ' <span class="pos-muted" style="font-size:12px">(' + x.p + '%)</span>' +
                  '<div class="pos-meter ' + (r.gap > 0 ? 'warn' : 'good') + '" style="margin-top:5px"><span style="width:' + x.p + '%"></span></div></td>' +
                  '<td>' + money0(r.proj) + '</td><td class="wrap">' + x.status + '</td><td>' + x.rating + '</td><td>' + x.upsTxt + '</td>' +
                  '<td><span class="' + (r.rbRate < 0.45 ? 'pos-danger-text' : '') + '">' + pct(r.rbRate) + '</span> <span class="pos-muted" style="font-size:12px">' + r.rbk.rb + '/' + r.rbk.elig + '</span>' +
                  (r.rbRate < 0.45 ? '<div class="pos-warn-text" style="font-size:12px">→ invite rebooking at the desk</div>' : '') + '</td>' +
                  '<td><span class="' + (r.rework > 2 ? 'pos-danger-text' : '') + '">' + r.rework + '</span>' + (r.rework > 2 ? '<div class="pos-warn-text" style="font-size:12px">→ quality check</div>' : '') + '</td>' +
                  '</tr>';
              }).join('') +
              '</tbody></table></div>';
            var cardsHtml = '<div data-mg-perf-list>' + rows.map(function (r) {
              var t = r.t;
              var p = r.target ? Math.min(100, Math.round(r.done / r.target * 100)) : 100;
              var daysLeft = daysWeek - daysDone;
              var statusChip = r.gap > 0
                ? '<span class="pos-chip pos-chip-amber">Tops up ~' + money0(r.gap) + '</span>'
                : '<span class="pos-chip pos-chip-green">Over guarantee ~' + money0(-r.gap) + '</span>';
              var subLine = r.gap > 0
                ? (daysLeft > 0 ? 'Needs ' + money0(r.needDay) + '/day for the last ' + daysLeft + ' day(s)' : 'Week closed — guarantee top-up applies')
                : 'On pace — no top-up needed this week';
              var ratingVal = r.pf.rating == null ? '—' : r.pf.rating.toFixed(1);
              var ratingSub = r.pf.rating == null ? 'no reviews yet' : r.pf.reviews + ' reviews';
              var upsellSuggested = r.ups < 0.15;
              return '<article class="queue-card perf-card">' +
                '<div class="perf-head">' +
                  '<span class="perf-avatar">' + initials(t.name) + '</span>' +
                  '<div class="perf-head-main">' +
                    '<div class="perf-name-row"><span class="perf-name">' + esc(t.name) + '</span>' + statusChip + '</div>' +
                    '<div class="perf-sub">' + subLine + '</div>' +
                  '</div>' +
                '</div>' +
                '<div class="perf-divider"></div>' +
                '<div>' +
                  '<span class="perf-section-label">Current sales</span>' +
                  '<div class="perf-sales-row"><span><span class="perf-sales-value">' + money0(r.done) + '</span><span class="perf-sales-of">of ' + money0(r.target) + '</span></span><span class="perf-sales-pct">' + p + '%</span></div>' +
                  '<div class="pos-meter" style="height:10px;margin-top:8px"><span style="width:' + p + '%"></span></div>' +
                '</div>' +
                '<div class="perf-divider"></div>' +
                '<div class="perf-stat-row">' +
                  '<div class="perf-stat-col"><span class="perf-section-label">Guaranteed amount</span><span class="perf-stat-value">' + money0(t.guar || 0) + '</span></div>' +
                  '<div class="perf-stat-col"><span class="perf-section-label">Daily target</span><span class="perf-stat-value">' + money0(r.daily) + '/day</span></div>' +
                  '<div class="perf-stat-col"><span class="perf-section-label">Projected sales</span><span class="perf-stat-value">' + money0(r.proj) + '</span></div>' +
                '</div>' +
                '<div class="perf-divider"></div>' +
                '<div class="perf-stat-row">' +
                  '<div class="perf-stat-col"><span class="perf-section-label">Rating</span><span class="perf-stat-value' + (r.pf.rating != null && r.pf.rating < 4.5 ? ' pos-danger-text' : '') + '">' + ratingVal + '</span><span class="perf-stat-sub">' + ratingSub + '</span></div>' +
                  '<div class="perf-stat-col"><span class="perf-section-label">Rebooking rate</span><span class="perf-stat-value' + (r.rbRate < 0.45 ? ' pos-danger-text' : '') + '">' + pct(r.rbRate) + '</span><span class="perf-stat-sub">' + r.rbk.rb + ' of ' + r.rbk.elig + '</span></div>' +
                  '<div class="perf-stat-col"><span class="perf-section-label">Upsell rate</span><span class="perf-stat-value' + (upsellSuggested ? ' pos-danger-text' : '') + '">' + pct(r.ups) + '</span><span class="perf-stat-sub">' + r.billsTot + ' bills</span></div>' +
                '</div>' +
                '<div class="perf-divider"></div>' +
                '<div class="perf-stat-row">' +
                  '<div class="perf-stat-col" style="flex:2 1 0">' +
                    '<span class="perf-section-label">Suggested upsell services</span>' +
                    (upsellSuggested ? '<div class="pill-row"><span class="pos-chip pos-chip-violet">Gel upgrade</span><span class="pos-chip pos-chip-violet">Nail design</span></div>' : '<span class="pos-good-text" style="font-size:13px;font-weight:700">Upselling well — no push needed</span>') +
                  '</div>' +
                  '<div class="perf-stat-col"><span class="perf-section-label">Rework count</span><span class="perf-stat-value' + (r.rework > 2 ? ' pos-danger-text' : '') + '">' + r.rework + '</span></div>' +
                '</div>' +
                '</article>';
            }).join('') + '</div>';
            return '<div class="pos-card">' +
              '<div class="pos-card-head"><h3><i class="bi bi-bullseye" aria-hidden="true"></i> Guarantee &amp; performance — ' + esc(performanceWeekRangeLabel(mgPerfWeek)) + ' (day ' + daysDone + '/' + daysWeek + ')</h3>' +
              '<div class="pos-inline">' +
                '<label class="pos-inline-lbl">Week<input class="pos-input mg-perf-week-input" type="date" data-mg-week data-mg-perf-week value="' + esc(mgPerfWeek) + '" aria-label="Filter guarantee and performance by week"></label>' +
                '<span class="pos-muted">techs needing attention first</span>' +
                '<div class="booking-view-switch" role="group" aria-label="Guarantee and performance view mode">' +
                  '<button class="booking-view-button' + (mgPerfViewMode === 'table' ? ' is-active' : '') + '" type="button" data-mg-perf-view-target="table" aria-pressed="' + (mgPerfViewMode === 'table' ? 'true' : 'false') + '"><i class="bi bi-table" aria-hidden="true"></i>Table</button>' +
                  '<button class="booking-view-button' + (mgPerfViewMode === 'card' ? ' is-active' : '') + '" type="button" data-mg-perf-view-target="card" aria-pressed="' + (mgPerfViewMode === 'card' ? 'true' : 'false') + '"><i class="bi bi-grid-1x2" aria-hidden="true"></i>Card</button>' +
                '</div>' +
              '</div></div>' +
              (selectedWeek.hasActivity ? '' : '<div class="swap-tech-empty" style="margin-bottom:14px"><i class="bi bi-calendar-x" aria-hidden="true"></i> No performance data for this week.</div>') +
              (mgPerfViewMode === 'card' ? cardsHtml : tableHtml) +
              '<div class="pos-hint">Needs /week = guarantee ÷ commission % (a $900 guarantee at 60% means the tech must produce $1,500 of service before the salon breaks even on the guarantee). Ratings come from the post-ticket SMS review. Upsell = share of bills carrying an add-on item. Rebook and rework are fed by checkout flags.</div>' +
              '</div>';
          }

          var mgOwnerViewMode = DEFAULT_VIEW_MODE;
          function mgOwnerHtml(ps) {
            var selectedWeek = performanceWeekData(mgPerfWeek, ps);
            var daysDone = Math.max(1, Number(selectedWeek.daysDone) || AD_DAYS_DONE);
            var daysWeek = Math.max(1, Number(selectedWeek.daysWeek) || AD_DAYS_WEEK);
            var daysLeft = Math.max(0, daysWeek - daysDone);
            var rows = TECHS.map(function (t) {
              var weekTech = selectedWeek.tech[t.id] || {};
              var done = Number(weekTech.done) || 0;
              var m = t.payModel || 'max';
              var pay = techPayWeek(t, done);          // tips excluded — 100% of tips go to the tech
              var own = done - pay;                    // what the salon keeps; negative = paying out of pocket
              var stdPct = m === 'baoshare' ? 1 - (t.baoSplit || t.comm) : 1 - t.comm;
              var ownPct = done ? own / done : 0;
              var T = t.comm ? (t.guar || 0) / t.comm : 0;
              var proj = done / daysDone * daysWeek;
              return { t: t, m: m, done: done, pay: pay, own: own, ownPct: ownPct, stdPct: stdPct, T: T, proj: proj };
            }).sort(function (a, b) { return a.own - b.own; });

            var ownerRowHtml = function (r) {
              var t = r.t;
              var modelSel = '<select class="pos-input" data-mg-model="' + t.id + '" style="height:32px;font-size:13px">' +
                Object.keys(PAY_MODELS).map(function (k) { return '<option value="' + k + '"' + (r.m === k ? ' selected' : '') + '>' + PAY_MODELS[k] + '</option>'; }).join('') + '</select>';
              var splitInp = r.m === 'baoshare'
                ? '<input class="pos-mini" data-mg-split="' + t.id + '" value="' + Math.round((t.baoSplit || t.comm) * 100) + '" style="width:52px"> %'
                : '<span class="pos-muted">—</span>';
              var act;
              if (r.m === 'comm') act = '<span class="pos-good-text">Straight split on every dollar — no guarantee, no top-up risk.</span>';
              else if (r.done >= r.T) act = '<span class="pos-good-text">✅ Past ' + money0(r.T) + ' — standard split, keep the pace.</span>';
              else {
                var need = Math.max(0, r.T - r.done);
                var head = r.own < 0
                  ? '<div class="pos-danger-text">🔴 Right now the salon is ~' + money0(-r.own) + ' out of pocket (produced ' + money0(r.done) + ' &lt; guarantee ' + money0(t.guar || 0) + ').</div>'
                  : '<div class="pos-warn-text">🟠 Below the target — the salon keeps ' + pct(r.ownPct) + ' instead of ' + pct(r.stdPct) + '.</div>';
                act = head + '<div class="pos-muted" style="font-size:12px;font-weight:600">' + (daysLeft
                  ? 'Needs <b>' + money0(need) + '</b> more service (≈' + money0(need / daysLeft) + '/day, ' + daysLeft + ' day(s) left) to clear ' + money0(r.T) + '. → Give them the walk-ins, push upsell/design. Run-rate projection: ' + money0(r.proj) + (r.proj < (t.guar || 0) ? ' — still short; two weeks in a row means revisiting the guarantee or the schedule' : '') + '.'
                  : 'Week closed — finished <b>' + money0(need) + '</b> below the service target. Current pay settings are applied to this selected week.') + '</div>';
              }
              var pctCls = r.ownPct < 0 ? 'pos-danger-text' : r.ownPct < r.stdPct - 0.05 ? 'pos-warn-text' : 'pos-good-text';
              return { modelSel: modelSel, splitInp: splitInp, act: act, pctCls: pctCls };
            };
            var tableHtml = '<div class="pos-table-wrap"><table class="pos-table tight"><thead><tr>' +
              '<th>Tech</th><th>Pay model</th><th>Split over target</th><th>Guarantee</th><th><i class="bi bi-inbox-fill" aria-hidden="true"></i> Produced this week</th><th>Tech takes</th><th>Salon keeps</th><th>Salon % (standard → real)</th><th><i class="bi bi-compass" aria-hidden="true"></i> What to do</th>' +
              '</tr></thead><tbody>' +
              rows.map(function (r) {
                var t = r.t, x = ownerRowHtml(r);
                return '<tr>' +
                  '<td><span class="pos-people"><span class="pos-avatar">' + initials(t.name) + '</span> <span class="pos-strong">' + esc(t.name) + '</span></span></td>' +
                  '<td>' + x.modelSel + '</td><td>' + x.splitInp + '</td><td>' + (r.m === 'comm' ? '—' : money0(t.guar || 0)) + '</td>' +
                  '<td class="pos-strong">' + money0(r.done) + '</td><td>' + money(r.pay) + '</td>' +
                  '<td class="' + (r.own < 0 ? 'pos-danger-text' : '') + '">' + money(r.own) + '</td>' +
                  '<td>' + pct(r.stdPct) + ' → <b class="' + x.pctCls + '">' + pct(r.ownPct) + '</b></td>' +
                  '<td class="wrap" style="min-width:260px">' + x.act + '</td>' +
                  '</tr>';
              }).join('') +
              '</tbody></table></div>';
            var ownerCardParts = function (r) {
              var t = r.t;
              var statusChip, lines = [];
              if (r.m === 'comm') {
                statusChip = { text: 'Straight commission', color: 'var(--nexora-muted)' };
                lines.push({ text: 'Straight split on every dollar — no guarantee, no top-up risk.', cls: 'pos-good-text' });
              } else if (r.done >= r.T) {
                statusChip = { text: 'Past target', color: 'var(--nexora-success)' };
                lines.push({ text: 'Past ' + money0(r.T) + ' — standard split, keep the pace.', cls: 'pos-good-text' });
              } else {
                var need = Math.max(0, r.T - r.done);
                if (r.own < 0) {
                  statusChip = { text: 'Out of pocket ~' + money0(-r.own), color: 'var(--nexora-danger)' };
                  lines.push({ text: 'Right now the salon is ~' + money0(-r.own) + ' out of pocket.', cls: 'pos-danger-text' });
                } else {
                  statusChip = { text: 'Below target', color: 'var(--nexora-warning)' };
                  lines.push({ text: 'Below the target — the salon keeps ' + pct(r.ownPct) + ' instead of ' + pct(r.stdPct) + '.', cls: 'pos-warn-text' });
                }
                if (daysLeft) {
                  lines.push({ text: 'Needs ' + money0(need) + ' more service (~' + money0(need / daysLeft) + '/day, ' + daysLeft + ' day(s) left) to clear ' + money0(r.T) + '.' });
                  lines.push({ text: 'Give walk-ins, push upsell/design.' });
                  lines.push({ text: 'Run-rate projection: ' + money0(r.proj) + (r.proj < (t.guar || 0) ? ' — still short.' : '.') });
                } else {
                  lines.push({ text: 'Week closed — finished ' + money0(need) + ' below the service target.' });
                  lines.push({ text: 'Current pay settings are applied to this selected week.' });
                }
              }
              return { statusChip: statusChip, lines: lines };
            };
            var cardsHtml = '<div data-mg-owner-list>' + rows.map(function (r) {
              var t = r.t, x = ownerRowHtml(r), parts = ownerCardParts(r);
              return '<article class="queue-card owner-card">' +
                '<div class="perf-head">' +
                  '<div class="perf-head-main"><span class="perf-name">' + esc(t.name) + '</span></div>' +
                  '<span class="pos-chip" style="margin-left:auto;flex-shrink:0;white-space:nowrap;border:1.5px solid ' + parts.statusChip.color + ';background:#fff;color:' + parts.statusChip.color + '">' + esc(parts.statusChip.text) + '</span>' +
                '</div>' +
                '<div class="owner-model-bar" style="margin-top:12px"><b>Pay model:</b>' + x.modelSel + '</div>' +
                '<div class="owner-metric-grid" style="margin-top:14px">' +
                  '<div class="owner-metric-row">' +
                    '<div class="owner-metric-cell"><span class="perf-section-label">Split over target</span>' + (r.m === 'baoshare' ? '<span class="pos-inline" style="gap:2px;align-items:baseline"><input value="' + Math.round((t.baoSplit || t.comm) * 100) + '" data-mg-split="' + t.id + '" style="width:40px"><span class="perf-stat-value" style="margin:0">%</span></span>' : '<span class="perf-stat-value pos-muted">—</span>') + '</div>' +
                    '<div class="owner-metric-cell"><span class="perf-section-label">Guarantee</span><span class="perf-stat-value">' + (r.m === 'comm' ? '—' : money0(t.guar || 0)) + '</span></div>' +
                  '</div>' +
                  '<div class="owner-metric-row">' +
                    '<div class="owner-metric-cell"><span class="perf-section-label">Produced this week</span><span class="perf-stat-value">' + money0(r.done) + '</span></div>' +
                    '<div class="owner-metric-cell"><span class="perf-section-label">Tech takes</span><span class="perf-stat-value">' + money(r.pay) + '</span></div>' +
                  '</div>' +
                  '<div class="owner-metric-row">' +
                    '<div class="owner-metric-cell"><span class="perf-section-label">Salon keeps</span><span class="perf-stat-value' + (r.own < 0 ? ' pos-danger-text' : '') + '">' + money(r.own) + '</span></div>' +
                    '<div class="owner-metric-cell"><span class="perf-section-label">Salon % (standard → real)</span><span class="perf-stat-value">' + pct(r.stdPct) + ' → <span class="' + x.pctCls + '">' + pct(r.ownPct) + '</span></span></div>' +
                  '</div>' +
                '</div>' +
                '<div class="perf-divider"></div>' +
                parts.lines.map(function (l) { return '<div class="owner-note-line ' + (l.cls || '') + '">' + esc(l.text) + '</div>'; }).join('') +
                '</article>';
            }).join('') + '</div>';
            return '<div class="pos-card">' +
              '<div class="pos-card-head"><h3><i class="bi bi-briefcase" aria-hidden="true"></i> Pay model &amp; real split — ' + esc(performanceWeekRangeLabel(mgPerfWeek)) + ' (day ' + daysDone + '/' + daysWeek + ')</h3>' +
              '<div class="pos-inline">' +
                '<label class="pos-inline-lbl">Week<input class="pos-input mg-perf-week-input" type="date" data-mg-week data-mg-owner-week value="' + esc(mgPerfWeek) + '" aria-label="Filter pay model and real split by week"></label>' +
                '<span class="pos-muted">riskiest tech first · tips excluded (100% to techs)</span>' +
                '<div class="booking-view-switch" role="group" aria-label="Pay model view mode">' +
                  '<button class="booking-view-button' + (mgOwnerViewMode === 'table' ? ' is-active' : '') + '" type="button" data-mg-owner-view-target="table" aria-pressed="' + (mgOwnerViewMode === 'table' ? 'true' : 'false') + '"><i class="bi bi-table" aria-hidden="true"></i>Table</button>' +
