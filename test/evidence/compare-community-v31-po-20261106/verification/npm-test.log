            max-width: none;
          }
        }

        @media (max-width: 390px) {
          .settings-voice-library-tools {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 100px;
            gap: 7px;
          }

          .settings-voice-filter-button {
            min-width: 0;
          }

          .settings-voice-mini-orb {
            width: 34px;
            height: 34px;
          }

          .settings-voice-row-main {
            gap: 8px;
          }

          .settings-voice-row-copy p {
            max-width: 166px;
          }

          .settings-voice-preview-button {
            width: 36px;
            height: 36px;
          }
