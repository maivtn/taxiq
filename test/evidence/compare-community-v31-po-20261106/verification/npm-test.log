              '<div class="pos-card soft"><div class="pos-kpi-label"><i class="bi bi-clock-history" aria-hidden="true"></i> Unpaid</div><div class="pos-kpi-value">' + money0(pendTot) + '</div><div class="pos-muted" style="font-size:12px">pay + tips still owed</div></div>' +
              '<div class="pos-card soft"><div class="pos-kpi-label"><i class="bi bi-heart-fill" aria-hidden="true"></i> Tips today</div><div class="pos-kpi-value">' + money0(tipTot) + '</div><div class="pos-muted" style="font-size:12px">100% to techs, paid with payroll</div></div>' +
              '<div class="pos-card soft"><div class="pos-kpi-label"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Ready to pay</div><div class="pos-kpi-value">' + readyN + '</div><div class="pos-muted" style="font-size:12px">amount locked, waiting on a tap</div></div>' +
              '<div class="pos-card soft"><div class="pos-kpi-label"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> Missing method</div><div class="pos-kpi-value ' + (missN ? 'pos-warn-text' : '') + '">' + missN + '</div><div class="pos-muted" style="font-size:12px">no payout destination — held</div></div>' +
              '</div>' +
