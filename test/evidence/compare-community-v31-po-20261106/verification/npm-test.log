          function setComposerBackgroundInert(inert) {
            const overlay = $('composerModal');
            if (inert) {
              composerBackgroundStates = [];
              let surface = overlay;
              while (surface && surface !== document.body) {
                const parent = surface.parentElement;
                if (!parent) break;
                Array.from(parent.children)
                  .filter(function(element) { return element !== surface && element.tagName !== 'SCRIPT'; })
                  .forEach(function(element) {
                    composerBackgroundStates.push({ element: element, wasInert: element.hasAttribute('inert') });
                    element.setAttribute('inert', '');
                  });
                surface = parent;
              }
              return;
            }
            composerBackgroundStates.forEach(function(state) {
              if (state.wasInert) state.element.setAttribute('inert', '');
              else state.element.removeAttribute('inert');
            });
            composerBackgroundStates = [];
          }

