            if (c) {
              var t = techById(c.getAttribute('data-mg-comm')); if (!t) return;
              var v = Math.min(100, Math.max(0, parseFloat(c.value) || 0)) / 100;
              if (v !== t.comm) logAdmin('💰 ' + t.name + ' commission ' + Math.round(t.comm * 100) + '% → ' + Math.round(v * 100) + '%');
              t.comm = v; savePosTechnician(t); renderManagement(); return;
            }
            var g = e.target.closest('[data-mg-guar]');
            if (g) {
              var tg2 = techById(g.getAttribute('data-mg-guar')); if (!tg2) return;
