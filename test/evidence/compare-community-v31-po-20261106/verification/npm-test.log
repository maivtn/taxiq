            return { sc: Math.max(5, Math.min(99, sc)), req: reqs.join(', ') || null, reqs: reqs, missing: missing, okSkill: missing.length === 0 };
          }
          function busyName(tid) {
            var w = WAITLIST.find(function (x) { return x.status === 'service' && x.techId === tid; });
            return w ? w.name : null;
          }
          function techAvailableForQueueTicket(tid, w) {
            return !WAITLIST.some(function (candidate) {
              return candidate.status === 'service' && candidate.techId === tid && (!w || String(candidate.orderId) !== String(w.orderId));
            });
          }
          function freeTechs() { return TECHS.filter(function (t) { return !busyName(t.id); }); }
          function nextTech() {
            var f = freeTechs();
            return f.length ? f.slice().sort(function (a, b) { return a.turns - b.turns; })[0] : null;
          }
          // ▶ one-tap: the requested tech if free and qualified, otherwise the qualified tech with the fewest turns
          function fAutoTech(w) {
            var free = freeTechs();
            if (w.reqTech) {
              var r = free.find(function (t) { return t.id === w.reqTech; });
              if (r && matchScore(r, w).okSkill) return r;
            }
            var elig = free.filter(function (t) { return matchScore(t, w).okSkill; });
            var pool = elig.length ? elig : free;   // nobody qualified → fall back to any free tech (manual assign still warns)
            return pool.length ? pool.slice().sort(function (a, b) { return a.turns - b.turns; })[0] : null;
          }
          function waitingStartTech(w) {
            if (!w) return null;
