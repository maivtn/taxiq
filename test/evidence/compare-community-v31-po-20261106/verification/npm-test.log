          function renderVoiceCreditCardForm() {
            var form = document.querySelector('[data-voice-credit-card-form]');
            if (!form) return;
            var isCard = getSelectedVoiceCreditPayment().id === 'CARD';
            form.hidden = !isCard;
            if (!isCard) {
              var error = form.querySelector('[data-voice-credit-card-error]');
              if (error) error.textContent = '';
            }
          }

          function validateVoiceCreditCardForm() {
            var form = document.querySelector('[data-voice-credit-card-form]');
            if (!form || form.hidden) return true;

            var firstMissing = null;
            form.querySelectorAll('[data-voice-credit-card-required]').forEach(function(field) {
              field.removeAttribute('aria-invalid');
              if (!firstMissing && !field.value.trim()) firstMissing = field;
            });
            var error = form.querySelector('[data-voice-credit-card-error]');
            if (firstMissing) {
              firstMissing.setAttribute('aria-invalid', 'true');
              if (error) error.textContent = 'Please complete all required card details.';
              firstMissing.focus();
              return false;
            }
            if (error) error.textContent = '';
            return true;
          }

