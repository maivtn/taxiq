    <!doctype html>
    <html lang="en">
    <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>Nexora Touch - Booking Book Shell</title>
      <script>
        if (['customers', 'calllog'].includes(new URLSearchParams(window.location.search).get('tab'))) {
          document.documentElement.dataset.posWorkspace = 'customers';
        }
        if (new URLSearchParams(window.location.search).get('tab') === 'settings' && new URLSearchParams(window.location.search).get('section') === 'ai-receptionist') {
          document.documentElement.dataset.salonSettingsContext = 'ai-receptionist';
