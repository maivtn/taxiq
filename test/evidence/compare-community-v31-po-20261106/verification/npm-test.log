                : '<button class="perf-cta-btn perf-cta-btn-success-fill" data-mg-payout="' + r.t.id + '"><i class="bi bi-wallet2" aria-hidden="true"></i> Pay ' + money(r.tot) + '</button>';
              return '<article class="queue-card payroll-card">' +
                '<div class="perf-head">' +
                  '<span class="payroll-avatar">' + initials(r.t.name) + '</span>' +
                  '<div class="perf-head-main">' +
                    '<span class="perf-name">' + esc(r.t.name) + '</span>' +
                    '<div class="perf-sub" style="font-size:13px;margin-top:2px">Tech</div>' +
