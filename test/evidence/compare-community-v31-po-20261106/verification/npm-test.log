          flex-wrap: wrap;
          gap: 7px;
        }

        .settings-chip,
        .settings-filter-button {
          border: 1px solid var(--nexora-border);
          border-radius: 999px;
          background: #fff;
          padding: 7px 10px;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 700;
        }

        .settings-chip.is-active,
        .settings-filter-button.is-active {
          border-color: rgba(70, 72, 216, 0.32);
