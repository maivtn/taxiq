            right: -14px;
            width: 54px;
            height: 54px;
          }

          .voice-kpi-section .kpi-top {
            gap: 6px;
            margin-bottom: 8px;
          }

          .voice-kpi-section .kpi-icon {
            width: 30px;
            height: 30px;
            border-radius: 9px;
          }

          .voice-kpi-section .kpi-icon svg {
            width: 15px;
            height: 15px;
          }

          .voice-kpi-section .kpi-top .badge {
            max-width: 66px;
            padding: 4px 6px;
            font-size: 8.5px;
            line-height: 1.05;
            text-align: center;
            white-space: normal;
          }

          .voice-kpi-section .kpi-label {
            font-size: 8.5px;
            letter-spacing: 0.04em;
            line-height: 1.15;
          }

          .voice-kpi-section .kpi-value {
            margin-top: 2px;
            font-size: 24px;
          }

          .voice-kpi-section .kpi-trend {
            margin-top: 6px;
            font-size: 10px;
            line-height: 1.25;
