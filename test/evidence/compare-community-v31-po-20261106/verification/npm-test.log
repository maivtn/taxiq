          }

          var fSel = null;    // guest picked for the two-tap assign
          var fWarn = null;   // {wid, tid} — showing the missing-skill warning; a second tap overrides
          function mergeQueueTicketForAssignment(w) {
            if (!w || !ticketOpen(w)) return w;
            var collisions = WAITLIST.filter(function (candidate) {
              return candidate !== w && ticketOpen(candidate) &&
                String(candidate.orderId) === String(w.orderId) &&
                queueTicketAssignment(candidate) === queueTicketAssignment(w);
            });
            var statusRank = { service: 3, waiting: 2, ready: 1 };
            collisions.forEach(function (collision) {
              var itemKeys = {};
              var mergedItems = [];
              (w.items || []).concat(collision.items || []).forEach(function (item) {
                var key = String(item.serviceTicketId || item.serviceId || item.name || '');
                if (!key || itemKeys[key]) return;
                itemKeys[key] = true;
                mergedItems.push(item);
              });
              w.items = mergedItems;
              w.serviceTicketIds = queueTicketServiceIds(w).concat(queueTicketServiceIds(collision)).filter(function (id, index, ids) {
                return ids.indexOf(id) === index;
              });
              if ((statusRank[collision.status] || 0) > (statusRank[w.status] || 0)) w.status = collision.status;
              if (w.atMs && collision.atMs) w.atMs = Math.min(w.atMs, collision.atMs);
              else w.atMs = w.atMs || collision.atMs;
              if (w.svcAtMs && collision.svcAtMs) w.svcAtMs = Math.min(w.svcAtMs, collision.svcAtMs);
              else w.svcAtMs = w.svcAtMs || collision.svcAtMs;
              if (w.readyAtMs && collision.readyAtMs) w.readyAtMs = Math.min(w.readyAtMs, collision.readyAtMs);
              else w.readyAtMs = w.readyAtMs || collision.readyAtMs;
              w.log = (w.log || []).concat(collision.log || []);
              collision.status = 'cancelled';
              collision.supersededBy = w.id;
