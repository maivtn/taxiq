                        <option value="birthday">🎂 Birthday Special (nexora.ai/btcnailbar/birthday-july)</option>
                      </select>
                    </div>

                    <div class="sms-step">
                      <span class="sms-step-lbl">Bước 5 — Lịch gửi</span>
                      <div class="sched-row" data-sched-row>
                        <button class="sched-opt is-on" type="button" data-mode="now"><span class="sched-opt-icon"><i class="bi bi-lightning-charge-fill" aria-hidden="true"></i></span> Gửi ngay</button>
                        <button class="sched-opt" type="button" data-mode="schedule"><span class="sched-opt-icon"><i class="bi bi-clock" aria-hidden="true"></i></span> Hẹn giờ</button>
                        <button class="sched-opt" type="button" data-mode="auto"><span class="sched-opt-icon"><i class="bi bi-robot" aria-hidden="true"></i></span> Tự động</button>
                      </div>
                      <div class="sched-time" data-sched-time>
