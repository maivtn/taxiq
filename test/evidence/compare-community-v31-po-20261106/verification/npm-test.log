          white-space: nowrap;
        }

        .settings-holiday-icon-button:hover {
          border-color: rgba(70, 72, 216, 0.25);
          background: #f7f8ff;
          color: var(--nexora-brand);
        }

        .settings-holiday-icon-button.is-danger:hover {
          border-color: rgba(220, 38, 38, 0.22);
          background: #fff1f2;
          color: #dc2626;
        }

        .settings-holiday-empty {
          padding: 12px 0 4px;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 700;
        }

        .settings-holiday-badge {
          display: inline-flex;
          align-items: center;
          border-radius: 999px;
          background: #eef2ff;
          padding: 3px 8px;
          color: var(--nexora-brand);
          font-size: 11px;
          font-weight: 900;
          white-space: nowrap;
        }

        .settings-holiday-badge.is-closed {
          background: #fff1f2;
          color: #b91c1c;
        }

        .settings-holiday-badge.is-adjusted {
          background: #fffbeb;
          color: #92400e;
        }

        .booking-calendar-closed-cell {
          background: #fef2f2 !important;
          color: #991b1b;
          pointer-events: none;
        }

        .booking-calendar-closed-cell .booking-cell-add {
          opacity: 0.35;
        }

        @container holiday-card (max-width: 420px) {
          .settings-holiday-table {
            gap: 8px;
          }

          .settings-holiday-table-head {
            display: none;
          }

          .settings-holiday-row {
            grid-template-columns: minmax(0, 1fr) auto;
            grid-template-areas:
              "date type"
              "reason reason"
              "actions actions";
            gap: 8px 10px;
            align-items: start;
            min-height: 0;
            border: 1px solid var(--nexora-border);
            border-radius: 10px;
            background: #fff;
            padding: 10px;
          }

          .settings-holiday-date {
            grid-area: date;
          }

          .settings-holiday-type {
            grid-area: type;
            justify-self: end;
          }

          .settings-holiday-reason {
            grid-area: reason;
            overflow: visible;
            text-overflow: clip;
            white-space: normal;
          }

          .settings-holiday-row-actions {
            grid-area: actions;
            flex-wrap: wrap;
            justify-content: flex-start;
            opacity: 1;
          }

          .settings-holiday-notify {
            align-items: flex-start;
            flex-wrap: wrap;
            justify-content: flex-start;
          }
        }

        @media (max-width: 520px) {
          .settings-booking-sms-row {
            align-items: start;
          }

          .settings-holiday-form {
            grid-template-columns: 1fr;
          }
        }

        .settings-service-list.settings-service-body {
          max-height: 540px;
          overflow-y: auto;
          gap: 5px;
        }

        .settings-service-catalog-state {
          border: 1px dashed var(--nexora-border);
          border-radius: 10px;
          padding: 16px;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 700;
          text-align: center;
        }

        .settings-category-manager {
          margin-bottom: 12px;
          border: 1px solid var(--nexora-border);
          border-radius: 11px;
          background: #fff;
          padding: 10px;
        }

        .settings-category-manager-head {
          display: flex;
          align-items: flex-start;
          justify-content: space-between;
          gap: 10px;
          margin-bottom: 9px;
        }

        .settings-category-manager-title {
          display: flex;
          align-items: center;
          gap: 6px;
          color: var(--nexora-text);
          font-size: 11px;
          font-weight: 900;
        }

        .settings-category-manager-title svg {
          width: 15px;
          height: 15px;
          color: var(--nexora-brand);
        }

        .settings-category-manager-sub {
          margin-top: 3px;
          color: var(--nexora-muted);
          font-size: 10px;
          line-height: 1.4;
        }

        .settings-category-manager-add {
          display: inline-flex;
          flex: 0 0 auto;
          align-items: center;
          gap: 5px;
          border: 1px solid rgba(70, 72, 216, .22);
          border-radius: 8px;
          background: #f6f7ff;
          padding: 6px 8px;
          color: var(--nexora-brand);
          font-size: 10px;
          font-weight: 850;
        }

        .settings-category-manager-add svg {
          width: 13px;
          height: 13px;
        }

        .settings-category-manager-open {
          display: inline-flex;
          align-items: center;
          gap: 6px;
        }

        .settings-category-manager-open svg {
          width: 14px;
          height: 14px;
        }

        .settings-service-actions {
          display: flex;
          flex-wrap: wrap;
          align-items: stretch;
          margin-bottom: 12px;
        }

        .settings-service-actions > button {
          flex: 0 1 auto;
          min-width: 0;
        }

        .settings-category-list {
          display: grid;
          gap: 5px;
        }

        .settings-category-row {
          display: grid;
          grid-template-columns: minmax(0, 1fr) auto;
          align-items: center;
          gap: 7px;
          border: 1px solid var(--nexora-rule);
          border-radius: 8px;
          background: var(--nexora-surface-muted);
          padding: 6px 7px;
        }

        .settings-category-row-main {
          display: flex;
          min-width: 0;
          align-items: center;
          gap: 7px;
        }

        .settings-category-row-main > svg {
          width: 14px;
          height: 14px;
          flex: 0 0 auto;
          color: var(--nexora-brand);
        }

        .settings-category-name-input {
          width: 100%;
          min-width: 0;
          border: 1px solid transparent;
          border-radius: 6px;
          background: transparent;
          padding: 5px 6px;
          color: var(--nexora-text);
          font-size: 11px;
          font-weight: 800;
        }

        .settings-category-name-input:focus {
          border-color: var(--nexora-brand);
          background: #fff;
          outline: 0;
          box-shadow: 0 0 0 2px rgba(70, 72, 216, .1);
        }

        .settings-category-count {
          flex: 0 0 auto;
          color: var(--nexora-subtle);
          font-size: 10px;
          font-weight: 750;
          white-space: nowrap;
        }

        .settings-category-row-actions {
          display: flex;
          align-items: center;
          gap: 3px;
        }

        .settings-category-row-action {
          display: inline-grid;
          width: 27px;
          height: 27px;
          place-items: center;
          border: 1px solid transparent;
          border-radius: 7px;
          background: transparent;
          color: var(--nexora-muted);
        }

        .settings-category-row-action:hover {
          border-color: var(--nexora-border);
          background: #fff;
          color: var(--nexora-brand);
        }

        .settings-category-row-action.is-danger:hover {
          border-color: rgba(220, 38, 38, .18);
          color: #dc2626;
        }

        .settings-category-row-action svg {
          width: 14px;
          height: 14px;
        }

        .settings-category-empty {
          border: 1px dashed var(--nexora-border);
          border-radius: 8px;
          padding: 9px;
          color: var(--nexora-subtle);
          font-size: 10px;
          font-weight: 700;
          text-align: center;
        }

        .settings-service-category {
          overflow: hidden;
          border: 1px solid var(--nexora-border);
          border-radius: 11px;
          background: #fff;
        }

        .settings-service-category + .settings-service-category {
          margin-top: 6px;
        }

        .settings-service-category-head {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 10px;
          list-style: none;
          cursor: pointer;
          padding: 10px 11px;
          background: #f8faff;
        }

        .settings-service-category-head::-webkit-details-marker {
          display: none;
        }

        .settings-service-category-chevron {
          width: 16px;
          height: 16px;
          flex: 0 0 auto;
          color: var(--nexora-subtle);
          transition: transform .16s ease;
        }

        .settings-service-category:not([open]) .settings-service-category-chevron {
          transform: rotate(-90deg);
        }

        .settings-service-category-name {
          color: var(--nexora-text);
          font-size: 11px;
          font-weight: 900;
          letter-spacing: .04em;
          text-transform: uppercase;
        }

        .settings-service-category-count {
          margin-left: auto;
          border-radius: 999px;
          background: #e9edff;
          padding: 2px 7px;
          color: var(--nexora-brand);
          font-size: 10px;
          font-weight: 800;
        }

        .settings-service-category-body {
          display: grid;
          gap: 5px;
          padding: 7px;
        }

        .settings-service-add-button {
          width: 100%;
          justify-content: center;
          border-style: dashed;
          background: #f8faff;
          color: var(--nexora-brand);
        }

        .settings-service-row.is-draft {
          border-color: rgba(70, 72, 216, 0.3);
          background: rgba(70, 72, 216, 0.025);
        }

        .settings-service-header {
          display: grid;
          grid-template-columns: 30px minmax(82px, 1fr) 58px 70px 28px 28px;
          align-items: center;
          gap: 5px;
          padding: 0 7px 4px;
          color: var(--nexora-subtle);
          font-size: 10px;
          font-weight: 750;
          letter-spacing: 0.02em;
          text-transform: uppercase;
        }

        .settings-service-row {
          display: grid;
          grid-template-columns: minmax(0, 1fr);
          gap: 0;
          align-items: center;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: #fff;
          padding: 7px;
        }

        .settings-service-row.is-compact {
          gap: 0;
          padding: 7px;
          border-radius: 10px;
          box-shadow: none;
        }

        .settings-service-edit-grid {
          display: grid;
          grid-template-columns: 30px minmax(82px, 1fr) 58px 70px 28px 28px;
          align-items: center;
          gap: 5px;
        }

        .settings-service-row.is-compact .settings-service-edit-grid {
          grid-template-columns: 34px minmax(96px, 1fr) 64px 72px 28px 28px;
          gap: 6px;
          align-items: center;
        }

        .settings-service-visual {
          display: inline-flex;
          width: 30px;
          height: 30px;
          align-items: center;
          justify-content: center;
          border: 1px solid var(--nexora-border);
          border-radius: 9px;
          background: var(--nexora-canvas);
          font-size: 14px;
        }

        .settings-service-input-wrap {
          position: relative;
          min-width: 0;
        }

        .settings-service-input {
          width: 100%;
          min-height: 34px;
          border: 1px solid var(--nexora-border);
          border-radius: 9px;
          background: #fff;
          padding: 0 8px;
          color: var(--nexora-text);
          font-size: 11.5px;
          font-weight: 600;
          outline: none;
        }

        .settings-service-input.price {
          padding-left: 20px;
        }

        .settings-service-input.duration {
          padding-right: 24px;
        }

        .settings-service-row.is-compact .settings-service-input {
          min-height: 34px;
          padding-right: 8px;
          padding-left: 8px;
          font-size: 11.5px;
        }

        .settings-service-row.is-compact .settings-service-input.price {
          padding-left: 20px;
        }

        .settings-service-row.is-compact .settings-service-input.duration {
          padding-right: 24px;
        }

        .settings-service-prefix,
        .settings-service-suffix {
          position: absolute;
          top: 50%;
          color: var(--nexora-subtle);
          font-size: 10px;
          font-weight: 600;
          transform: translateY(-50%);
          pointer-events: none;
        }

        .settings-service-prefix {
          left: 8px;
        }

        .settings-service-suffix {
          right: 8px;
        }

        .settings-service-input:focus {
          border-color: rgba(70, 72, 216, 0.42);
          box-shadow: 0 0 0 3px rgba(70, 72, 216, 0.1);
        }

        .settings-service-name {
          color: var(--nexora-text);
          font-size: 12px;
          font-weight: 700;
        }

        .settings-service-meta {
          display: flex;
          flex-wrap: wrap;
          gap: 7px;
        }

        .settings-service-edit,
        .settings-service-remove {
          display: inline-flex;
          width: 28px;
          height: 34px;
          align-items: center;
          justify-content: center;
          border: 1px solid var(--nexora-border);
          border-radius: 9px;
          background: #fff;
          color: var(--nexora-muted);
          font-size: 14px;
          font-weight: 700;
        }

        .settings-service-row.is-compact .settings-service-edit,
        .settings-service-row.is-compact .settings-service-remove {
          width: 28px;
          height: 34px;
          border-radius: 8px;
          font-size: 13px;
        }

        .settings-service-edit:hover {
          border-color: rgba(70, 72, 216, 0.25);
          color: var(--nexora-brand);
        }

        .settings-service-remove:hover {
          border-color: rgba(239, 68, 68, 0.24);
          color: #ef4444;
        }

        .settings-service-panel {
          border: 1px solid rgba(70, 72, 216, 0.18);
          border-radius: 12px;
          background: color-mix(in srgb, var(--nexora-brand) 5%, white);
          padding: 12px;
          margin-bottom: 12px;
        }

        .settings-service-panel[hidden] {
          display: none;
        }

        .settings-service-panel-title {
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 600;
          line-height: 1.5;
          margin-bottom: 8px;
        }

        .settings-service-progress {
          color: var(--nexora-muted);
          font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
          font-size: 11px;
          font-weight: 500;
          line-height: 1.8;
        }

        .settings-service-modal {
          position: fixed;
          inset: 0;
          z-index: 125;
          display: flex;
          align-items: center;
          justify-content: center;
          background: rgba(8, 18, 38, 0.54);
          padding: 18px;
          backdrop-filter: blur(10px);
        }

        .settings-service-modal[hidden] {
          display: none;
        }

        .settings-service-dialog {
          width: min(100%, 520px);
          border: 1px solid var(--nexora-border);
          border-radius: 16px;
          background: #fff;
          box-shadow: 0 28px 80px rgba(8, 18, 38, 0.28);
        }

        .settings-service-modal-head,
        .settings-service-modal-actions {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 12px;
        }

        .settings-service-modal-head {
          align-items: flex-start;
          border-bottom: 1px solid var(--nexora-rule);
          padding: 18px;
        }

        .settings-service-modal-title {
          color: var(--nexora-text);
          font-size: 16px;
          font-weight: 800;
          line-height: 1.3;
        }

        .settings-service-modal-sub {
          margin-top: 4px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 500;
          line-height: 1.45;
        }

        .settings-service-modal-close {
          display: inline-flex;
          width: 34px;
          height: 34px;
          flex-shrink: 0;
          align-items: center;
          justify-content: center;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: var(--nexora-surface-muted);
          color: var(--nexora-muted);
          font-size: 16px;
          font-weight: 800;
        }

        .settings-service-modal-body {
          display: grid;
          gap: 12px;
          padding: 18px;
        }

        .settings-service-modal-grid {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 10px;
        }

        .settings-service-modal-field-name {
          grid-column: 1 / -1;
        }

        .settings-service-modal-error {
          border: 1px solid rgba(239, 68, 68, 0.24);
          border-radius: 9px;
          background: #fff5f5;
          padding: 9px 10px;
          color: #c24141;
          font-size: 11px;
          font-weight: 700;
          line-height: 1.4;
        }

        .settings-service-modal-error[hidden] {
          display: none;
        }

        .settings-service-modal-actions {
          justify-content: flex-end;
          border-top: 1px solid var(--nexora-rule);
          padding: 14px 18px 18px;
        }

        .settings-service-suggest-grid {
          display: flex;
          flex-wrap: wrap;
          gap: 7px;
        }

        .settings-service-suggest {
          border: 1px solid var(--nexora-border);
          border-radius: 999px;
          background: #fff;
          padding: 7px 10px;
          color: var(--nexora-text);
          font-size: 11px;
          font-weight: 600;
        }

        .settings-service-suggest span {
          color: var(--nexora-brand);
          font-weight: 700;
        }

        .settings-service-note-bar {
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: var(--nexora-canvas);
          padding: 10px 11px;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 500;
          line-height: 1.45;
          margin-bottom: 12px;
        }

        .settings-mini-stat {
          border-radius: 999px;
          background: var(--nexora-canvas);
          padding: 6px 9px;
          color: var(--nexora-muted);
          font-size: 10px;
          font-weight: 900;
        }

        .settings-mini-stat strong {
          color: var(--nexora-text);
        }

        .settings-template-grid,
        .settings-offer-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 8px;
        }

        .settings-template-card,
        .settings-offer-card {
          border: 1px solid var(--nexora-border);
          border-radius: 11px;
          background: #fff;
          padding: 12px;
          box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
        }

        .settings-template-card {
          text-align: left;
          cursor: pointer;
        }

        .settings-template-card[hidden] {
          display: none;
        }

        .settings-template-name,
        .settings-offer-name {
          color: var(--nexora-text);
          font-size: 12px;
          font-weight: 900;
        }

        .settings-template-desc,
        .settings-offer-desc {
          margin-top: 5px;
          color: var(--nexora-muted);
          font-size: 10px;
          font-weight: 650;
          line-height: 1.45;
        }

        .settings-loyalty-card {
          border: 1px solid rgba(70, 72, 216, 0.18);
          border-radius: 12px;
          background: color-mix(in srgb, var(--nexora-brand) 7%, white);
          padding: 12px;
          margin-bottom: 12px;
        }

        .settings-loyalty-card .settings-config-row {
          grid-template-columns: minmax(0, 1fr) auto;
        }

        .settings-loyalty-copy {
          min-width: 0;
        }

        .settings-loyalty-card .settings-config-desc {
          max-width: none;
        }

        .settings-loyalty-form {
          display: grid;
          gap: 8px;
          margin-top: 12px;
        }

        .settings-template-library {
          border: 1px solid var(--nexora-border);
          border-radius: 13px;
          background: var(--nexora-canvas);
          padding: 14px;
          margin-bottom: 14px;
        }

        .settings-subsection {
          margin-top: 14px;
        }

        .settings-section-head {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 12px;
          margin-bottom: 7px;
        }

        .settings-section-title {
          display: inline-flex;
          align-items: center;
          gap: 8px;
          color: var(--nexora-text);
          font-size: 12px;
          font-weight: 800;
          margin-bottom: 5px;
        }

        .settings-section-head .settings-section-title {
          margin-bottom: 0;
        }

        .settings-section-title .bi {
          color: var(--nexora-brand);
          font-size: 15px;
          line-height: 1;
        }

        .settings-ai-title-icon {
          position: relative;
          display: inline-flex;
          width: 28px;
          height: 24px;
          align-items: center;
          justify-content: center;
          border: 2px solid #f59e0b;
          border-radius: 8px;
          background: linear-gradient(135deg, #fbbf24, #f59e0b);
          color: #1d1748;
          font-size: 11px;
          font-weight: 900;
          line-height: 1;
          box-shadow: 0 8px 18px rgba(245, 158, 11, 0.18);
        }

        .settings-ai-title-icon .bi {
          position: absolute;
          top: -8px;
          right: -9px;
          color: #fbbf24;
          font-size: 13px;
          filter: drop-shadow(0 1px 2px rgba(15, 23, 42, 0.16));
        }

        .settings-template-card {
          display: grid;
          gap: 8px;
          transition: border-color 0.16s ease, transform 0.16s ease;
        }

        .settings-template-card:hover {
          border-color: rgba(70, 72, 216, 0.28);
          transform: translateY(-1px);
        }

        .settings-template-head {
          display: flex;
          gap: 9px;
          align-items: flex-start;
        }

        .settings-template-icon,
        .settings-offer-icon {
          display: inline-flex;
          width: 34px;
          height: 34px;
          flex: 0 0 34px;
          align-items: center;
          justify-content: center;
          border-radius: 10px;
          background: color-mix(in srgb, var(--nexora-brand) 10%, white);
          color: var(--nexora-brand);
          font-size: 17px;
        }

        .settings-service-visual.tone-violet,
        .settings-template-icon.tone-violet,
        .settings-offer-icon.tone-violet {
          border-color: #ddd6fe;
          background: #f3e8ff;
          color: #7c3aed;
        }

        .settings-service-visual.tone-cyan,
        .settings-template-icon.tone-cyan,
        .settings-offer-icon.tone-cyan {
          border-color: #a5f3fc;
          background: #ecfeff;
          color: #0891b2;
        }

        .settings-service-visual.tone-emerald,
        .settings-template-icon.tone-emerald,
        .settings-offer-icon.tone-emerald {
          border-color: #bbf7d0;
          background: #ecfdf5;
          color: #059669;
        }

        .settings-service-visual.tone-amber,
        .settings-template-icon.tone-amber,
        .settings-offer-icon.tone-amber {
          border-color: #fde68a;
          background: #fffbeb;
          color: #d97706;
        }

        .settings-service-visual.tone-rose,
        .settings-template-icon.tone-rose,
        .settings-offer-icon.tone-rose {
          border-color: #fecdd3;
          background: #fff1f2;
          color: #e11d48;
        }

        .settings-service-visual.tone-sky,
        .settings-template-icon.tone-sky,
        .settings-offer-icon.tone-sky {
          border-color: #bae6fd;
          background: #f0f9ff;
          color: #0284c7;
        }

        .settings-template-code {
          color: var(--brand-cyan);
          font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
          font-size: 10px;
          font-weight: 800;
          letter-spacing: 0;
          margin-top: 2px;
        }

        .settings-template-effect {
          color: var(--nexora-success);
          font-size: 10px;
          font-weight: 750;
          line-height: 1.45;
        }

        .settings-offer-grid.is-list {
          grid-template-columns: 1fr;
        }

        .settings-offer-card.is-row {
          display: grid;
          grid-template-columns: 34px minmax(0, 1fr) auto;
          gap: 11px;
          align-items: center;
        }

        .settings-offer-card.is-muted {
          opacity: 0.62;
        }

        .settings-offer-modal {
          position: fixed;
          inset: 0;
          z-index: 90;
          display: flex;
          align-items: center;
          justify-content: center;
          background: rgba(8, 18, 38, 0.54);
          padding: 18px;
          backdrop-filter: blur(12px);
        }

        .settings-offer-modal[hidden] {
          display: none;
        }

        .settings-offer-dialog {
          width: min(100%, 680px);
          max-height: min(760px, calc(100vh - 36px));
          overflow-y: auto;
          border: 1px solid rgba(70, 72, 216, 0.18);
          border-radius: 16px;
          background: #fff;
          box-shadow: 0 28px 80px rgba(8, 18, 38, 0.28);
        }

        .settings-offer-modal-head {
          display: flex;
          align-items: flex-start;
          justify-content: space-between;
          gap: 14px;
          border-bottom: 1px solid var(--nexora-rule);
          padding: 18px;
        }

        .settings-offer-modal-title {
          color: var(--nexora-text);
          font-size: 16px;
          font-weight: 800;
          line-height: 1.3;
        }

        .settings-offer-modal-sub {
          margin-top: 4px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 500;
          line-height: 1.45;
        }

        .settings-offer-modal-close {
          display: inline-flex;
          width: 34px;
          height: 34px;
          flex-shrink: 0;
          align-items: center;
          justify-content: center;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: var(--nexora-surface-muted);
          color: var(--nexora-muted);
          font-size: 16px;
          font-weight: 800;
        }

        .settings-offer-modal-body {
          display: grid;
          gap: 12px;
          padding: 18px;
        }

        .settings-offer-modal-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 10px;
        }

        .settings-offer-modal-actions {
          display: flex;
          flex-wrap: wrap;
          justify-content: flex-end;
          gap: 8px;
          border-top: 1px solid var(--nexora-rule);
          padding: 14px 18px 18px;
        }

        .settings-offer-tags {
          display: flex;
          flex-wrap: wrap;
          gap: 5px;
          margin-top: 5px;
        }

        .settings-offer-actions {
          display: flex;
          gap: 8px;
          align-items: center;
        }

        .settings-icon-button {
          display: inline-flex;
          width: 32px;
          height: 32px;
          align-items: center;
          justify-content: center;
          border: 1px solid var(--nexora-border);
          border-radius: 9px;
          background: #fff;
          color: var(--nexora-muted);
          font-size: 13px;
        }

        .settings-language-grid {
          display: grid;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: 8px;
        }

        .settings-language-card {
          min-height: 44px;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: #fff;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 750;
          transition: border-color 0.16s ease, box-shadow 0.16s ease, color 0.16s ease;
        }

        .settings-language-card.is-active {
          border-color: rgba(70, 72, 216, 0.46);
          box-shadow: 0 0 0 3px rgba(70, 72, 216, 0.1);
          color: var(--nexora-brand);
        }

        .settings-language-status {
          color: var(--nexora-muted);
          font-size: 10.5px;
          font-weight: 500;
          line-height: 1.45;
          margin-top: 8px;
        }

        .settings-promo-meta {
          display: flex;
          flex-wrap: wrap;
          align-items: center;
          gap: 8px;
          margin-top: 8px;
          min-width: 0;
        }

        .settings-promo-count {
          flex: 0 1 auto;
          order: 2;
          margin-top: 0;
          margin-left: auto;
          text-align: right;
          color: var(--nexora-muted);
          font-size: 10.5px;
          font-weight: 700;
        }

        .settings-promo-count.is-max {
          color: var(--nexora-warning);
        }

        .settings-promo-suggest-row {
          display: flex;
          flex: 1 1 220px;
          flex-wrap: wrap;
          align-items: center;
          gap: 8px;
          order: 1;
          min-width: 0;
          margin-top: 8px;
        }

        .settings-promo-meta .settings-promo-suggest-row {
          margin-top: 0;
        }

        .settings-suggest-label {
          display: inline-flex;
          align-items: center;
          gap: 4px;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 800;
          white-space: nowrap;
        }

        .settings-promo-suggest {
          display: inline-flex;
          align-items: center;
          gap: 6px;
          border: 1px dashed rgba(70, 72, 216, 0.42);
          border-radius: 999px;
          background: color-mix(in srgb, var(--nexora-brand) 6%, white);
          padding: 7px 13px;
          color: var(--nexora-brand);
          font-size: 11px;
          font-weight: 800;
          cursor: pointer;
          transition: background 0.15s ease, border-color 0.15s ease;
        }

        .settings-promo-suggest:hover {
          border-style: solid;
          background: color-mix(in srgb, var(--nexora-brand) 12%, white);
        }

        .settings-promo-suggest .bi {
          font-size: 12px;
        }

        .settings-save-bar {
          display: grid;
          gap: 12px;
          align-items: center;
          border: 1px solid rgba(70, 72, 216, 0.18);
          border-radius: 14px;
          background: #fff;
          padding: 14px;
          box-shadow: var(--nexora-card-shadow);
        }

        .settings-save-copy {
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 700;
          line-height: 1.5;
        }

        .settings-status {
          color: var(--nexora-success);
          font-size: 11px;
          font-weight: 900;
        }

        .trial-modal {
          position: fixed;
          inset: 0;
          z-index: 80;
          display: flex;
          align-items: center;
          justify-content: center;
          background: rgba(8, 31, 73, 0.42);
          padding: 18px;
          backdrop-filter: blur(10px);
        }

        .trial-modal[hidden] {
          display: none;
        }

        .trial-dialog {
          position: relative;
          width: min(100%, 680px);
          max-height: min(940px, calc(100vh - 28px));
          overflow-y: auto;
          border: 1px solid var(--nexora-border);
          border-radius: 16px;
          background: #fff;
          box-shadow: 0 28px 80px rgba(8, 31, 73, 0.24);
          scrollbar-width: thin;
          scrollbar-color: var(--brand-cyan) transparent;
        }

        .trial-close {
          position: absolute;
          top: 14px;
          right: 14px;
          display: inline-flex;
          width: 34px;
          height: 34px;
          align-items: center;
          justify-content: center;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: var(--nexora-surface-muted);
          color: var(--nexora-muted);
          font-size: 16px;
          font-weight: 900;
          z-index: 1;
        }

        .trial-head {
          border-bottom: 1px solid var(--nexora-rule);
          background: linear-gradient(180deg, #fff, #f8fbff);
          padding: 22px 22px 16px;
          text-align: left;
        }

        .trial-brand {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          gap: 7px;
          border: 1px solid rgba(70, 72, 216, 0.18);
          border-radius: 999px;
          background: color-mix(in srgb, var(--nexora-brand) 8%, white);
          padding: 7px 13px;
          color: var(--nexora-brand);
          font-size: 11px;
          font-weight: 800;
          letter-spacing: 0.02em;
          text-transform: uppercase;
        }

        .trial-title {
          max-width: 560px;
          margin: 14px 0 0;
          color: var(--nexora-text);
          font-size: 26px;
          font-weight: 800;
          line-height: 1.14;
        }

        .trial-title strong {
          display: block;
          background: linear-gradient(90deg, var(--nexora-electric), var(--nexora-violet));
          -webkit-background-clip: text;
          background-clip: text;
          color: transparent;
        }

        .trial-subtitle {
          margin: 10px 0 0;
          max-width: 560px;
          color: var(--nexora-muted);
          font-size: 13px;
          font-weight: 500;
          line-height: 1.55;
        }

        .trial-benefits {
          display: flex;
          flex-wrap: wrap;
          justify-content: flex-start;
          gap: 8px;
          background: var(--nexora-surface-muted);
          padding: 12px 22px;
        }

        .trial-benefit {
          display: inline-flex;
          align-items: center;
          gap: 5px;
          border: 1px solid var(--nexora-border);
          border-radius: 999px;
          background: #fff;
          padding: 7px 11px;
          color: var(--nexora-text);
          font-size: 10px;
          font-weight: 800;
        }

        .trial-body {
          margin: 18px 22px 20px;
          border: 1px solid var(--nexora-border);
          border-radius: 14px;
          background: var(--nexora-canvas);
          padding: 16px;
        }

        .trial-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 12px;
        }

        .trial-span-2 {
          min-width: 0;
        }

        .trial-field {
          display: grid;
          gap: 6px;
        }

        .trial-label {
          color: var(--nexora-subtle);
          font-size: 11px;
          font-weight: 800;
          letter-spacing: 0;
          text-transform: uppercase;
        }

        .trial-label span {
          color: #f472b6;
        }

        .trial-optional {
          color: var(--nexora-subtle);
          font-weight: 600;
          text-transform: none;
        }

        .trial-label .trial-optional {
          color: var(--nexora-subtle);
        }

        .trial-input,
        .trial-select {
          width: 100%;
          min-height: 42px;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: #fff;
          padding: 0 14px;
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 600;
          outline: none;
        }

        .trial-input::placeholder {
          color: var(--nexora-subtle);
        }

        .trial-select option {
          color: #0f172a;
        }

        .trial-input:focus,
        .trial-select:focus {
          border-color: rgba(70, 72, 216, 0.42);
          box-shadow: 0 0 0 3px rgba(70, 72, 216, 0.1);
        }

        .trial-input.is-invalid,
        .trial-select.is-invalid,
        .trial-input[aria-invalid="true"],
        .trial-select[aria-invalid="true"] {
          border-color: #ef4444;
          box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
        }

        .trial-hours-list .settings-hour-input.is-invalid {
          border-color: #ef4444;
          box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
        }

        .trial-file-input {
          min-height: 46px;
          padding: 9px 12px;
          font-size: 12px;
        }

        .trial-service-price-list {
          margin-top: 4px;
          padding-top: 10px;
          border-top: 1px solid var(--nexora-rule);
        }

        .trial-file-input::file-selector-button {
          margin-right: 10px;
          border: 1px solid rgba(70, 72, 216, 0.2);
          border-radius: 7px;
          background: color-mix(in srgb, var(--nexora-brand) 8%, white);
          padding: 6px 10px;
          color: var(--nexora-brand);
          font-size: 11px;
          font-weight: 800;
          cursor: pointer;
        }

        .trial-note {
          display: inline-flex;
          align-items: center;
          gap: 5px;
          color: var(--nexora-muted);
          font-size: 10px;
          font-weight: 500;
          line-height: 1.45;
        }

        .trial-form-error {
          margin-top: 12px;
          border: 1px solid rgba(239, 68, 68, 0.24);
          border-radius: 9px;
          background: rgba(254, 226, 226, 0.72);
          padding: 9px 11px;
          color: #b91c1c;
          font-size: 11px;
          font-weight: 700;
          line-height: 1.4;
        }

        .trial-chip-list,
        .trial-day-list {
          display: flex;
          flex-wrap: wrap;
          gap: 8px;
        }

        .trial-chip,
        .trial-day {
          border: 1px solid var(--nexora-border);
          border-radius: 999px;
          background: #fff;
          padding: 8px 12px;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 800;
        }

        .trial-chip.is-active,
        .trial-day.is-active {
          border-color: rgba(70, 72, 216, 0.46);
          background: color-mix(in srgb, var(--nexora-brand) 8%, white);
          color: var(--nexora-brand);
        }

        .trial-time-row {
          display: grid;
          grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
          gap: 9px;
          align-items: center;
        }

        .trial-time-separator {
          color: var(--nexora-subtle);
          font-weight: 800;
        }

        .trial-credit {
          display: inline-flex;
          align-items: center;
          gap: 5px;
          color: var(--nexora-success);
          font-size: 10px;
          font-weight: 800;
        }

        .trial-submit {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          gap: 8px;
          width: 100%;
          min-height: 52px;
          margin-top: 14px;
          border: 0;
          border-radius: 10px;
          background: linear-gradient(90deg, var(--nexora-electric), var(--nexora-violet));
          color: #fff;
          font-size: 14px;
          font-weight: 800;
          box-shadow: 0 14px 28px rgba(70, 72, 216, 0.2);
        }

        .trial-footer {
          margin-top: 12px;
          color: var(--nexora-subtle);
          text-align: center;
          font-size: 10px;
          font-weight: 500;
          line-height: 1.45;
        }

        .trial-contact {
          margin: -6px 22px 22px;
          color: var(--nexora-muted);
          text-align: center;
          font-size: 10px;
          font-weight: 600;
          line-height: 1.6;
        }

        .trial-contact strong,
        .trial-contact a {
          color: var(--nexora-brand);
          text-decoration: none;
        }

        .trial-email-preview {
          border: 1px solid var(--nexora-border);
          border-radius: 12px;
          background: #fff;
          padding: 14px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 500;
          line-height: 1.55;
        }

        .trial-step[hidden] {
          display: none;
        }

        .quick-grid {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 8px;
        }

        .quick-button {
          min-height: 74px;
          border: 1px solid var(--nexora-border);
          border-radius: 12px;
          background: var(--nexora-surface);
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 900;
        }

        .quick-button strong {
          display: block;
          margin-top: 5px;
          color: var(--nexora-text);
          font-size: 11px;
        }

        .booking-toolbar {
          display: flex;
          flex-wrap: wrap;
          align-items: center;
          justify-content: space-between;
          gap: 14px;
          margin-bottom: 18px;
        }

        .booking-subtabs {
          display: inline-flex;
          gap: 6px;
          border: 1px solid var(--nexora-border);
          border-radius: 12px;
          background: var(--nexora-surface-muted);
          padding: 5px;
        }

        .booking-subtab {
          display: inline-flex;
          min-height: 38px;
          align-items: center;
          gap: 8px;
          border: 0;
          border-radius: 9px;
          background: transparent;
          padding: 0 12px 0 8px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 900;
          transition: background 0.2s, color 0.2s, box-shadow 0.2s;
        }

        .booking-subtab.is-active {
          background: #fff;
          color: var(--nexora-brand);
          box-shadow: var(--nexora-card-shadow);
        }

        .booking-subtab-icon {
          display: inline-flex;
          width: 28px;
          height: 28px;
          align-items: center;
          justify-content: center;
          border-radius: 8px;
          background: color-mix(in srgb, var(--nexora-brand) 10%, white);
          color: currentColor;
        }

        .booking-subtab-icon svg,
        .booking-action-icon svg,
        .tech-mini-icon svg {
          width: 16px;
          height: 16px;
        }

        .booking-action-icon .bi,
        .tech-mini-icon .bi {
          font-size: 16px;
          line-height: 1;
        }

        .booking-subtab-icon svg path,
        .booking-subtab-icon svg rect,
        .booking-subtab-icon svg circle,
        .booking-action-icon svg path,
        .booking-action-icon svg rect,
        .booking-action-icon svg circle,
        .tech-mini-icon svg path,
        .tech-mini-icon svg rect,
        .tech-mini-icon svg circle {
          stroke: currentColor;
          stroke-width: 2;
          stroke-linecap: round;
          stroke-linejoin: round;
        }

        .booking-sub-panel {
          display: none;
        }

        .booking-sub-panel.is-active {
          display: block;
        }

        .booking-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 16px;
        }

        /* Keep wide appointment tables scrolling inside their wrapper instead of
           forcing the whole overview card and header toolbar wider than the viewport. */
        .booking-grid > .overview-card {
          min-width: 0;
        }

        .booking-appointment-layout {
          display: grid;
          grid-template-columns: 1fr;
          gap: 14px;
          align-items: start;
        }

        .booking-appointment-layout[data-booking-layout="calendar"] {
          grid-template-columns: minmax(0, 1fr) 320px;
        }

        .booking-appointment-main,
        .booking-appointment-panel {
          min-width: 0;
        }

        .booking-appointment-main {
          overflow-x: auto;
        }

        .booking-appointment-panel {
          position: sticky;
          top: 18px;
          min-height: 260px;
          border-radius: 16px;
          background: var(--nexora-surface-muted);
          padding: 18px;
          box-shadow: none;
        }

        .booking-appointment-panel [data-booking-panel-state="empty"] {
          display: grid;
          min-height: 230px;
          place-items: center;
          align-content: center;
          gap: 8px;
          padding: 28px 18px;
          color: var(--nexora-muted);
          text-align: center;
        }

        .booking-appointment-panel [data-booking-panel-state="empty"] i {
          color: var(--nexora-brand);
          font-size: 28px;
        }

        .booking-appointment-panel [data-booking-panel-state="empty"] strong {
          color: var(--nexora-text);
          font-size: 14px;
        }

        .booking-appointment-panel [data-booking-panel-state="empty"] span {
          max-width: 270px;
          font-size: 12px;
          line-height: 1.8;
        }

        .booking-appointment-backdrop[hidden] {
          display: none;
        }

        body.booking-appointment-panel-modal-open {
          overflow: hidden;
        }

        @media (max-width: 1120px) {
          .booking-appointment-layout { grid-template-columns: 1fr; }
        }

        @media (max-width: 1399px) {
          .booking-appointment-layout[data-booking-layout="calendar"] {
            grid-template-columns: 1fr;
          }

          .booking-appointment-backdrop {
            position: fixed;
            inset: 0;
            z-index: 130;
            background: rgba(8, 31, 73, .42);
            backdrop-filter: blur(8px);
          }

          .booking-appointment-panel[data-booking-panel-presentation="modal"] {
            position: fixed;
            z-index: 131;
            top: 50%;
            left: 50%;
            width: min(calc(100vw - 32px), 720px);
            max-height: calc(100dvh - 32px);
            overflow-y: auto;
            transform: translate(-50%, -50%);
          }

          .booking-appointment-panel[data-booking-panel-presentation="modal"] .booking-panel-header-close {
            display: inline-flex;
          }
        }

        @media (max-width: 600px) {
          .booking-appointment-panel {
            min-height: 0;
          }

          .booking-appointment-panel[data-booking-panel-presentation="modal"] {
            top: 50%;
            right: auto;
            bottom: auto;
            left: 50%;
            width: min(calc(100vw - 24px), 720px);
            max-height: calc(100dvh - 24px);
            border-radius: 16px;
            transform: translate(-50%, -50%);
          }
        }

        .booking-daybar {
          display: flex;
          flex-wrap: wrap;
          align-items: center;
          justify-content: space-between;
          gap: 10px;
          margin-bottom: 14px;
        }

        .booking-daybar-actions {
          display: inline-flex;
          flex-wrap: wrap;
          align-items: center;
          justify-content: flex-end;
          gap: 8px;
          margin-left: auto;
        }

        .booking-filter-wrap {
          position: relative;
        }

        .booking-filter-toggle {
          height: 36px;
          min-height: 34px;
          white-space: nowrap;
        }

        .booking-filter-toggle[aria-expanded="true"] {
          border-color: rgba(70, 72, 216, 0.32);
          background: color-mix(in srgb, var(--nexora-brand) 9%, white);
          color: var(--nexora-brand);
        }

        .booking-filter-popover {
          position: absolute;
          top: calc(100% + 8px);
          right: 0;
          z-index: 35;
          width: min(470px, calc(100vw - 40px));
          border: 1px solid var(--nexora-border);
          border-radius: 12px;
          background: #fff;
          padding: 14px;
          box-shadow: 0 18px 45px rgba(8, 31, 73, 0.16);
        }

        .booking-filter-popover[hidden] {
          display: none;
        }

        .booking-filter-popover-head {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 10px;
          margin-bottom: 12px;
          color: var(--nexora-text);
          font-size: 12px;
          font-weight: 900;
        }

