              ['systemLabel', 'CÔNG CỤ HỆ THỐNG', 'SYSTEM TOOLS', '系统工具', '시스템 도구', 'HERRAMIENTAS DEL SISTEMA', 'システムツール', 'เครื่องมือระบบ', 'أدوات النظام', 'OUTILS SYSTÈME'],
