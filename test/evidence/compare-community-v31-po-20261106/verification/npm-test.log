          function renderCredits() {
            set('[data-sms-credits]', 'SMS credits: ' + smsState.credits.toLocaleString('en-US') +
              ' (≈' + money(smsState.credits * PRICE_PER_SMS) + ')');
            var chip = $('[data-sms-credits]');
            if (chip) chip.className = 'pos-chip ' + (smsState.credits < 100 ? 'pos-chip-red' : 'pos-chip-blue');
          }

          function resetConfirm() {
            smsState.confirming = false;
            $('[data-confirm-box]').classList.remove('show');
            set('[data-sms-send]', '🚀 Gửi Campaign');
          }
          function updateSmsPreview(text) {
            var bubble = $('[data-sms-bubble]');
            if (!text.trim()) { bubble.innerHTML = '<span class="sms-bubble-empty">Tin nhắn sẽ hiển thị ở đây...</span>'; return; }
            var safe = esc(text);
            Object.keys(TAG_SAMPLES).forEach(function (tag) {
              var val = TAG_SAMPLES[tag];
              var rendered = tag === '{Link}' ? '<span class="lnk">' + esc(val) + '</span>' : '<strong>' + esc(val) + '</strong>';
              safe = safe.split(esc(tag)).join(rendered);
            });
            bubble.innerHTML = safe.replace(/\n/g, '<br>');
          }
          function updateCost() {
            var info = smsInfo($('[data-sms-text]').value);
            var parts = Math.max(info.parts, 1);
            var totalSms = smsState.segment.count * parts;
            var enough = smsState.credits >= totalSms;
            set('[data-cost-amt]', smsState.segment.count + ' khách × ' + parts + ' tin = ' + totalSms + ' SMS (' + money(totalSms * PRICE_PER_SMS) + ')');
            set('[data-cost-lbl]', enough ? 'Chi phí ước tính' : '⚠️ Không đủ credits (còn ' + smsState.credits + ')');
            $('[data-cost-box]').classList.toggle('warn', !enough);
            $('[data-sms-send]').disabled = !enough;
          }
          function updateCharCount() {
            var text = $('[data-sms-text]').value;
            var info = smsInfo(text);
            var box = $('[data-char-count]');
            box.textContent = info.units + ' ký tự — ' + info.parts + ' tin (' + info.encoding + ', ' + info.perPart + '/tin)';
            box.classList.toggle('multi', info.parts > 1);
            updateSmsPreview(text);
            updateCost();
            if (smsState.confirming) resetConfirm();   // content changed after confirming → re-confirm
          }

          function openComposer(segId) {
