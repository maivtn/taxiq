          var mgSmartViewMode = DEFAULT_VIEW_MODE;
          function mgSmartHtml(ps) {
            var smInp = function (k, lbl) { return '<label class="pos-inline-lbl">' + lbl + '<input class="pos-mini" data-mg-sm="' + k + '" value="' + SMART[k] + '" style="width:46px"> %</label>'; };
            var smartRowHtml = function (t) {
              var sb = smartBonus(t);
              var done = weekDone(t, ps);
              var delta = SMART.on ? done * sb.tot / 100 : 0;
              var bonuses = sb.list.length ? sb.list.map(function (x) { return '<span class="pos-good-text" style="font-size:12px">' + x[0] + ' +' + x[1] + '%</span>'; }).join(' · ') : '<span class="pos-muted">no thresholds met</span>';
              var eff = '<b class="' + (SMART.on && sb.tot ? 'pos-good-text' : '') + '">' + Math.round(effComm(t) * 100) + '%</b>' + (sb.tot >= SMART.cap ? '' : '');
              var deltaHtml = SMART.on ? (delta ? '+' + money(delta) : '—') : '<span class="pos-muted">off</span>';
              return { sb: sb, delta: delta, bonuses: bonuses, eff: eff, deltaHtml: deltaHtml };
            };
            var tableHtml = '<div class="pos-table-wrap"><table class="pos-table tight"><thead><tr><th>Tech</th><th>Base %</th><th>Bonuses earned</th><th>Effective %</th><th>Δ weekly pay (on production)</th></tr></thead><tbody>' +
              TECHS.map(function (t) {
                var x = smartRowHtml(t);
                return '<tr>' +
                  '<td><span class="pos-people"><span class="pos-avatar">' + initials(t.name) + '</span> <span class="pos-strong">' + esc(t.name) + '</span></span></td>' +
