              '<div class="booking-view-switch" role="group" aria-label="Payout Center view mode">' +
                '<button class="booking-view-button' + (mgPayoutViewMode === 'table' ? ' is-active' : '') + '" type="button" data-mg-payout-view-target="table" aria-pressed="' + (mgPayoutViewMode === 'table' ? 'true' : 'false') + '"><i class="bi bi-table" aria-hidden="true"></i>Table</button>' +
                '<button class="booking-view-button' + (mgPayoutViewMode === 'card' ? ' is-active' : '') + '" type="button" data-mg-payout-view-target="card" aria-pressed="' + (mgPayoutViewMode === 'card' ? 'true' : 'false') + '"><i class="bi bi-grid-1x2" aria-hidden="true"></i>Card</button>' +
