            flex-direction: column;
          }

          .settings-ai-voice-summary-card > .booking-secondary-button {
            width: 100%;
          }

          .settings-voice-overlay {
            align-items: flex-end;
            padding: 0;
          }

          .settings-voice-library {
            width: 100%;
            max-height: 92vh;
            max-height: 92dvh;
            border-right: 0;
            border-bottom: 0;
            border-left: 0;
            border-radius: 20px 20px 0 0;
          }

          .settings-voice-modal-head {
            padding: 17px 16px 13px;
          }

          .settings-voice-library-tools {
            padding: 0 16px 13px;
          }

          .settings-voice-filter-button {
            min-width: 104px;
          }

          .settings-voice-list {
            padding: 7px;
          }

          .settings-voice-row {
            min-height: 72px;
            padding: 8px;
          }

          .settings-voice-row-copy p {
            max-width: 210px;
          }

          .settings-voice-select-check {
            display: none;
          }

          .settings-voice-modal-footer {
            align-items: stretch;
            flex-direction: column;
            padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
          }

          .settings-voice-modal-actions .settings-voice-modal-button {
            flex: 1 1 0;
          }

          .settings-voice-toast {
            right: 16px;
            bottom: calc(16px + env(safe-area-inset-bottom));
