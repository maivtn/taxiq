            } else if (w.techId !== tid) {
              wlog(w, '⇄ Swapped tech ' + techName(w.techId) + ' → ' + techName(tid));
              pageTech(tid, 'Taking over: ' + w.name + (w.svc ? ' · ' + w.svc : ''));
            }
            w = applyQueueTechnician(w, tid);   // mid-service swap keeps the status and start time, and does not count another turn
            fSel = null;
            renderFloor(); renderClock();
            return w;
          }

          /* ── guest profile lines (internal — the guest never sees these) ── */
          function custUsual(name) {
            var h = CUSTHIST[name];
            if (!h || !h.length) return null;
            var mode = function (arr) {
              var m = {};
              arr.forEach(function (x) { m[x] = (m[x] || 0) + 1; });
              return Object.keys(m).sort(function (a, b) { return m[b] - m[a]; })[0] || null;
            };
            var days = h.map(function (x) { return x.daysAgo; }).filter(function (v, i, a) { return a.indexOf(v) === i; }).sort(function (a, b) { return b - a; });
            var gaps = [];
            for (var i = 1; i < days.length; i++) gaps.push(days[i - 1] - days[i]);
            return {
              svc: mode(h.map(function (x) { return x.svc; })),
              tech: mode(h.map(function (x) { return x.techId; }).filter(Boolean)),
              cyc: gaps.length ? Math.round(gaps.reduce(function (s, x) { return s + x; }, 0) / gaps.length) : null,
              last: Math.min.apply(null, h.map(function (x) { return x.daysAgo; })),
              tip: Math.round(h.reduce(function (s, x) { return s + (x.tip || 0); }, 0) / h.length),
