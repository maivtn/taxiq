          #panel-overview .overview-table td::before {
            content: attr(data-label);
            flex: 0 0 auto;
            color: var(--nexora-subtle);
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
          }

          #panel-overview .overview-table td:first-child::before {
