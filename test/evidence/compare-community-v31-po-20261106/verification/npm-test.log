            closeVoiceCreditModal();
            showVoiceCreditPurchaseSuccess(selectedPackage, selectedPayment);
          }

          function sendCampaign() {
            const text = $('smsText').value.trim();
            if (!text) { alert('Vui lòng soạn nội dung SMS trước.'); return; }

            if (state.scheduleMode === 'schedule' && (
              !$('schedDate').value ||
              $('schedDate').validity.rangeUnderflow ||
              scheduledDateTimeIsPast()
            )) {
              alert('Vui lòng chọn ngày và giờ gửi trong tương lai.');
              return;
            }

            const info = smsInfo(text);
            const totalSms = state.segment.count * info.parts;
            const editingCampaign = editingSmsCampaignId
              ? smsCampaigns.find(function(campaign) { return campaign.id === editingSmsCampaignId; })
              : null;
            const willChargeCredits = !editingCampaign || state.scheduleMode === 'now';

            if (willChargeCredits && state.credits < totalSms) {
              alert(`Không đủ credits: cần ${totalSms}, còn ${state.credits}. Vui lòng mua thêm.`);
              return;
            }

            // Bước xác nhận — bấm lần 1 hiện chi tiết, lần 2 mới gửi
            if (!state.confirming) {
              state.confirming = true;
              const when = state.scheduleMode === 'now' ? 'Gửi ngay lập tức'
                : state.scheduleMode === 'schedule' ? `Hẹn giờ: ${$('schedDate').value} lúc ${$('schedTime').value}`
                : 'Tự động theo điều kiện segment';
              $('confirmDetail').innerHTML =
                `Nhóm: <strong>${escapeHtml(state.segment.name)}</strong> (${state.segment.count} khách)<br>` +
                `Số tin: <strong>${totalSms} SMS</strong> (${info.parts} tin/khách, ${info.encoding})<br>` +
                `Chi phí: <strong>${marketingMoney(totalSms * PRICE_PER_SMS, { cents: true })}</strong> — trừ ${totalSms} credits<br>` +
                `Lịch: <strong>${when}</strong>`;
              $('confirmBox').classList.add('show');
              $('confirmBox').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
              setSendCampaignButton(true);
              return;
            }

            // Đã xác nhận → gửi
            if (willChargeCredits && window.NEXORA_CREDITS && typeof window.NEXORA_CREDITS.consumeSmsCredits === 'function') {
              const creditCharge = window.NEXORA_CREDITS.consumeSmsCredits(totalSms);
              if (!creditCharge.success) return;
            }
            if (willChargeCredits) updateCredits(state.credits - totalSms);
            if (editingCampaign) {
              const record = createSmsCampaignRecord();
              Object.assign(editingCampaign, record, { id: editingCampaign.id, name: editingCampaign.name });
            } else {
              smsCampaigns.unshift(createSmsCampaignRecord());
            }
            renderSmsCampaignList();
            closeComposer();

            const msg = editingCampaign
              ? `Đã cập nhật campaign ${editingCampaign.name}.`
              : state.scheduleMode === 'now'
              ? `Đã gửi ${totalSms} SMS đến ${state.segment.count} khách (${state.segment.name}).`
              : state.scheduleMode === 'schedule'
                ? `Đã lên lịch ${totalSms} SMS — gửi ${$('schedDate').value} lúc ${$('schedTime').value}.`
                : `Đã bật gửi tự động cho nhóm ${state.segment.name}.`;
            $('successText').textContent = msg;
            $('successBanner').classList.add('show');
            clearTimeout(sendCampaign._t);
            sendCampaign._t = setTimeout(() => $('successBanner').classList.remove('show'), 6000);
          }

          // ── event wiring (ported) ──
          $('closeComposerBtn').addEventListener('click', closeComposer);
          $('cancelComposerBtn').addEventListener('click', closeComposer);
          $('composerModal').addEventListener('click', function (e) { if (e.target === e.currentTarget) closeComposer(); });
          document.querySelectorAll('[data-sms-credit-buy]').forEach(function(button) {
            button.addEventListener('click', openSmsCreditModal);
          });
          document.querySelectorAll('[data-credits-action="sms-buy"]').forEach(function(button) {
            button.addEventListener('click', openSmsCreditModal);
          });
          document.querySelectorAll('[data-credits-action="voice-buy"]').forEach(function(button) {
            button.addEventListener('click', openVoiceCreditModal);
          });
          var smsCreditCardNumber = document.querySelector('[data-sms-credit-card-field="number"]');
          if (smsCreditCardNumber) smsCreditCardNumber.addEventListener('input', function() {
            var digits = this.value.replace(/\D/g, '').slice(0, 16);
            this.value = digits.replace(/(.{4})/g, '$1 ').trim();
          });
          var smsCreditCardExpiry = document.querySelector('[data-sms-credit-card-field="expiry"]');
          if (smsCreditCardExpiry) smsCreditCardExpiry.addEventListener('input', function() {
            var digits = this.value.replace(/\D/g, '').slice(0, 4);
            this.value = digits.length > 2 ? digits.slice(0, 2) + '/' + digits.slice(2) : digits;
          });
          var planCardNumber = document.querySelector('[data-plan-card-field="number"]');
          if (planCardNumber) planCardNumber.addEventListener('input', function() {
            var digits = this.value.replace(/\D/g, '').slice(0, 16);
            this.value = digits.replace(/(.{4})/g, '$1 ').trim();
          });
          var planCardExpiry = document.querySelector('[data-plan-card-field="expiry"]');
          if (planCardExpiry) planCardExpiry.addEventListener('input', function() {
            var digits = this.value.replace(/\D/g, '').slice(0, 4);
            this.value = digits.length > 2 ? digits.slice(0, 2) + '/' + digits.slice(2) : digits;
          });
          var voiceCreditCardNumber = document.querySelector('[data-voice-credit-card-field="number"]');
          if (voiceCreditCardNumber) voiceCreditCardNumber.addEventListener('input', function() {
            var digits = this.value.replace(/\D/g, '').slice(0, 16);
            this.value = digits.replace(/(.{4})/g, '$1 ').trim();
          });
          var voiceCreditCardExpiry = document.querySelector('[data-voice-credit-card-field="expiry"]');
          if (voiceCreditCardExpiry) voiceCreditCardExpiry.addEventListener('input', function() {
            var digits = this.value.replace(/\D/g, '').slice(0, 4);
            this.value = digits.length > 2 ? digits.slice(0, 2) + '/' + digits.slice(2) : digits;
          });
          var smsCreditModal = document.querySelector('[data-sms-credit-modal]');
          if (smsCreditModal) smsCreditModal.addEventListener('click', function(event) {
            if (event.target === smsCreditModal) {
              closeSmsCreditModal();
              return;
            }
            if (event.target.closest('[data-sms-credit-close]')) {
              closeSmsCreditModal();
              return;
            }
            var packageButton = event.target.closest('[data-sms-credit-package]');
            if (packageButton) {
              setSmsCreditPackage(packageButton.dataset.smsCreditPackage);
              return;
            }
            var paymentButton = event.target.closest('[data-sms-credit-payment]');
            if (paymentButton) {
              setSmsCreditPayment(paymentButton.dataset.smsCreditPayment);
              return;
            }
            if (event.target.closest('[data-sms-credit-confirm]')) confirmSmsCreditPurchase();
          });
          var voiceCreditModal = document.querySelector('[data-voice-credit-modal]');
          if (voiceCreditModal) voiceCreditModal.addEventListener('click', function(event) {
            if (event.target === voiceCreditModal) {
              closeVoiceCreditModal();
              return;
            }
            if (event.target.closest('[data-voice-credit-close]')) {
              closeVoiceCreditModal();
              return;
            }
            var packageButton = event.target.closest('[data-voice-credit-package]');
            if (packageButton) {
              setVoiceCreditPackage(packageButton.dataset.voiceCreditPackage);
              return;
            }
            var paymentButton = event.target.closest('[data-voice-credit-payment]');
            if (paymentButton) {
              setVoiceCreditPayment(paymentButton.dataset.voiceCreditPayment);
              return;
            }
            if (event.target.closest('[data-voice-credit-confirm]')) confirmVoiceCreditPurchase();
          });
          var planPaymentModal = document.querySelector('[data-plan-payment-modal]');
          if (planPaymentModal) planPaymentModal.addEventListener('click', function(event) {
            if (event.target === planPaymentModal || event.target.closest('[data-plan-payment-close]')) {
              closeServicePlanPaymentModal();
              return;
            }
            var paymentButton = event.target.closest('[data-plan-payment]');
            if (paymentButton) {
              planPaymentId = paymentButton.dataset.planPayment;
              renderServicePlanPayment();
              refreshBookingMarketingIcons();
              return;
            }
            if (event.target.closest('[data-plan-payment-confirm]')) confirmServicePlanPayment();
          });
          var smsRecipientsModal = document.querySelector('[data-sms-recipients-modal]');
          if (smsRecipientsModal) smsRecipientsModal.addEventListener('click', function(event) {
            if (event.target === smsRecipientsModal || event.target.closest('[data-sms-recipients-close]')) {
              closeSmsCampaignRecipients();
            }
          });
          var smsRecipientFilter = document.querySelector('[data-sms-recipient-filter]');
          if (smsRecipientFilter) smsRecipientFilter.addEventListener('change', function(event) {
            smsRecipientStatusFilter = event.target.value;
            var campaign = smsCampaigns.find(function(item) {
              return item.id === smsRecipientsModal.dataset.smsRecipientCampaignId;
            });
            if (campaign) renderSmsCampaignRecipients(campaign);
          });
          document.addEventListener('keydown', function (event) {
            const overlay = $('composerModal');
            if (!overlay.classList.contains('open')) return;
            if (event.key === 'Escape') {
              event.preventDefault();
              closeComposer();
              return;
            }
            if (event.key !== 'Tab') return;
            const focusable = composerFocusables();
            if (!focusable.length) return;
            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            if (!overlay.contains(document.activeElement)) {
              event.preventDefault();
              first.focus();
            } else if (event.shiftKey && document.activeElement === first) {
              event.preventDefault();
              last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
              event.preventDefault();
              first.focus();
            }
          });
          document.addEventListener('keydown', function(event) {
            var modal = document.querySelector('[data-sms-credit-modal]');
            if (!modal || modal.hidden || event.key !== 'Escape') return;
            event.preventDefault();
            closeSmsCreditModal();
          });
          document.addEventListener('keydown', function(event) {
            var modal = document.querySelector('[data-voice-credit-modal]');
            if (!modal || modal.hidden || event.key !== 'Escape') return;
            event.preventDefault();
            closeVoiceCreditModal();
          });
          document.addEventListener('keydown', function(event) {
            var modal = document.querySelector('[data-plan-payment-modal]');
            if (!modal || modal.hidden || event.key !== 'Escape') return;
            event.preventDefault();
            closeServicePlanPaymentModal();
          });
          document.addEventListener('keydown', function(event) {
            var modal = document.querySelector('[data-sms-recipients-modal]');
            if (!modal || modal.hidden || event.key !== 'Escape') return;
            event.preventDefault();
            closeSmsCampaignRecipients();
          });
          $('segmentGrid').addEventListener('click', function (e) {
            var btn = e.target.closest('.segment-btn'); if (!btn) return;
            var seg = COMPOSER_SEGMENTS.find(function (s) { return s.id === btn.dataset.segment; }); if (!seg) return;
            state.segment = seg;
            document.querySelectorAll('.segment-btn').forEach(function (b) { b.classList.toggle('selected', b === btn); });
            renderTemplates(seg.id); updateCost();
          });
          $('templateList').addEventListener('click', function (e) {
            var item = e.target.closest('.template-item'); if (!item) return;
            var tmpl = (TEMPLATES[state.segment.id] || [])[Number(item.dataset.index)]; if (!tmpl) return;
            $('smsText').value = tmpl.text; updateCharCount();
          });
          $('tagToolbar').addEventListener('click', function (e) {
            var btn = e.target.closest('.tag-btn'); if (!btn) return;
            var ta = $('smsText'); var tag = btn.dataset.tag;
            var s = ta.selectionStart, en = ta.selectionEnd;
            ta.value = ta.value.slice(0, s) + tag + ta.value.slice(en);
            ta.selectionStart = ta.selectionEnd = s + tag.length; ta.focus(); updateCharCount();
          });
          $('smsText').addEventListener('input', updateCharCount);
          $('scheduleOptions').addEventListener('click', function (e) {
            var btn = e.target.closest('.schedule-opt'); if (!btn) return;
            state.scheduleMode = btn.dataset.mode;
            document.querySelectorAll('.schedule-opt').forEach(function (b) { b.classList.toggle('selected', b === btn); });
            $('timeInputRow').style.display = state.scheduleMode === 'schedule' ? 'grid' : 'none';
          });
          $('sendCampaignBtn').addEventListener('click', sendCampaign);
          document.querySelectorAll('[data-sms-campaign-new]').forEach(function(btn) {
            btn.addEventListener('click', function() { openComposer('new'); });
          });
          const smsCampaignGrid = document.querySelector('[data-sms-campaign-grid]');
          if (smsCampaignGrid) smsCampaignGrid.addEventListener('click', function(event) {
            const btn = event.target.closest('[data-sms-segment]');
            if (btn) openComposer(btn.dataset.smsSegment);
          });
          const smsCampaignList = document.querySelector('[data-sms-campaign-list]');
          if (smsCampaignList) smsCampaignList.addEventListener('click', handleSmsCampaignAction);

          renderSegmentButtons();
          renderSmsCampaignCards();
          renderSmsCampaignList();
          updateCredits(state.credits);
          $('schedDate').min = new Date().toISOString().slice(0, 10);
          window.openSmsCampaignComposer = function (opts) { openComposer((opts && opts.segment) || 'new'); };
          if (new URLSearchParams(window.location.search).get('openCredits') === '1') {
            setTimeout(function () { openSmsCreditModal(); }, 0);
          }
        })();
      </script>

      <script>
        (function initQrCodesPanel() {
          'use strict';
          const byId = function(id) { return document.getElementById(id); };
          const panel = byId('panel-qr-codes');
          if (!panel) return;
          const refreshBookingMarketingIcons = window.refreshBookingMarketingIcons || function() {};

          function escapeQrHtml(value) {
            return String(value).replace(/[&<>"']/g, function(char) {
              return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[char];
            });
          }

          const QR_PROMOS = [
            { id: 'promo20',  label: '💅 Giảm 20% toàn bộ dịch vụ',        labelEn: '💅 20% Off All Services',            codePrefix: 'NAIL20' },
            { id: 'freeart',  label: '🎨 Free nail art khi làm full set',   labelEn: '🎨 Free Nail Art with Full Set',      codePrefix: 'FREEART' },
            { id: 'combo25',  label: '✨ Combo mani + pedi giảm 25%',       labelEn: '✨ Mani + Pedi Combo — 25% Off',       codePrefix: 'COMBO25' },
            { id: 'refer10',  label: '👯 Giới thiệu bạn — cả 2 giảm $10',   labelEn: '👯 Refer a Friend — $10 Off for Both', codePrefix: 'REF10' },
            { id: 'gel15',    label: '💎 Gel-X giảm 15% lần đầu',           labelEn: '💎 15% Off Gel-X First Visit',         codePrefix: 'GELX15' }
          ];

          function getQrPromoLabel(promo, language) {
            return language === 'en' ? (promo.labelEn || promo.label) : promo.label;
          }

          const QR_LEADS = [
            { time: 'Hôm nay 15:20', name: 'Hằng Phạm',    phone: '(281) 774-3358', code: 'NAIL20-8Q2F', status: 'Đã dùng code' },
            { time: 'Hôm nay 12:41', name: 'Kelly Trương', phone: '(832) 615-0442', code: 'NAIL20-3XKD', status: 'Đã gửi SMS' },
            { time: 'Hôm qua 17:05', name: 'Sarah Johnson', phone: '(713) 225-7809', code: 'NAIL20-9BM1', status: 'Đã dùng code' },
            { time: 'Hôm qua 13:30', name: 'Vy Lâm',       phone: '(346) 887-2210', code: 'NAIL20-Kk7P', status: 'Đã gửi SMS' }
          ];

          const qrState = { promo: QR_PROMOS[0] };
          let qrInstance = null;

          function qrUrl() {
            const slug = byId('qrSlug').value.trim().toLowerCase().replace(/[^a-z0-9-]/g, '-') || 'qr';
            return `nexora.ai/btcnailbar/qr/${slug}`;
          }

          function renderQrPromoOptions() {
            byId('qrPromo').innerHTML = QR_PROMOS.map(p => `<option value="${p.id}">${p.label}</option>`).join('');
          }

          function renderQrCode() {
            const box = byId('qrCanvas');
            box.innerHTML = '';
            if (typeof QRCode === 'undefined') {
              box.innerHTML = '<div class="qr-fallback marketing-status"><i class="marketing-icon is-compact" data-lucide="alert-triangle" aria-hidden="true"></i><span>Không tải được thư viện QR (cần mạng). Link vẫn hoạt động: ' + escapeQrHtml(qrUrl()) + '</span></div>';
              refreshBookingMarketingIcons();
              return;
            }
            qrInstance = new QRCode(box, {
              text: 'https://' + qrUrl(),
              width: 140,
              height: 140,
              colorDark: '#0a0a0f',
              colorLight: '#ffffff',
              correctLevel: QRCode.CorrectLevel.M
            });
          }

          function renderQrLeads() {
            byId('qrLeadsBody').innerHTML = QR_LEADS.map(l => `
              <tr>
                <td>${escapeQrHtml(l.time)}</td>
                <td>${escapeQrHtml(l.name)}</td>
                <td>${l.phone}</td>
                <td style="font-family:monospace;color:var(--nexora-electric);">${l.code}</td>
                <td><span class="call-status ${l.status === 'Đã dùng code' ? 'call-booked' : 'call-answered'}">${l.status}</span></td>
              </tr>
            `).join('');
          }

          /* Verify code tại quầy — chặn xài lại / share code */
          function verifyCode() {
            const box = byId('verifyResult');
            const raw = byId('verifyInput').value.trim().toUpperCase();
            if (!raw) {
              box.className = 'verify-result show bad';
              box.innerHTML = '<span class="marketing-status"><i class="marketing-icon is-compact" data-lucide="alert-triangle" aria-hidden="true"></i><span>Vui lòng nhập promotion code để kiểm tra.</span></span>';
              refreshBookingMarketingIcons();
              return;
            }
            const lead = QR_LEADS.find(l => l.code.toUpperCase() === raw);
            if (!lead) {
              box.className = 'verify-result show bad';
              box.innerHTML = `<span class="marketing-status"><i class="marketing-icon is-compact" data-lucide="x-circle" aria-hidden="true"></i><span>Code <strong style="font-family:monospace;">${escapeQrHtml(raw)}</strong> không tồn tại. Kiểm tra lại chính tả hoặc hỏi khách xem SMS gốc.</span></span>`;
              refreshBookingMarketingIcons();
              return;
            }
            const promo = QR_PROMOS.find(p => lead.code.toUpperCase().startsWith(p.codePrefix)) || qrState.promo;
            if (lead.status === 'Đã dùng code') {
              box.className = 'verify-result show used';
              box.innerHTML = `<span class="marketing-status"><i class="marketing-icon is-compact" data-lucide="alert-triangle" aria-hidden="true"></i><span>Code này <strong>đã được dùng</strong>${lead.usedAt ? ' lúc ' + escapeQrHtml(lead.usedAt) : ''} — không áp dụng lại.<br>Khách: <strong>${escapeQrHtml(lead.name)}</strong> • ${lead.phone}</span></span>`;
              refreshBookingMarketingIcons();
              return;
            }
            box.className = 'verify-result show ok';
            box.innerHTML = `
              <div class="marketing-status"><i class="marketing-icon is-compact" data-lucide="check-circle" aria-hidden="true"></i><div>
                <div class="verify-name">${escapeQrHtml(lead.name)}</div>
                <div class="verify-meta">${lead.phone} • ${escapeQrHtml(promo.label)} • Nhận code: ${escapeQrHtml(lead.time)}</div>
                <button class="booking-primary-button" type="button" id="markUsedBtn" data-code="${escapeQrHtml(lead.code)}"><i class="marketing-icon is-compact" data-lucide="check" aria-hidden="true"></i><span>Áp dụng & đánh dấu đã dùng</span></button>
              </div></div>`;
            refreshBookingMarketingIcons();
          }

          function markCodeUsed(code) {
            const lead = QR_LEADS.find(l => l.code === code);
            if (!lead) return;
            lead.status = 'Đã dùng code';
            lead.usedAt = new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) + ' hôm nay';
            renderQrLeads();
            const box = byId('verifyResult');
            box.className = 'verify-result show ok';
            box.innerHTML = `<span class="marketing-status"><i class="marketing-icon is-compact" data-lucide="check-circle" aria-hidden="true"></i><span>Đã áp dụng khuyến mãi cho <strong>${escapeQrHtml(lead.name)}</strong>. Code khóa lại — không dùng được lần 2.</span></span>`;
            refreshBookingMarketingIcons();
            byId('verifyInput').value = '';
          }

          function buildQrPageHtml(kiosk) {
            const title = escapeQrHtml(byId('qrFormTitle').value);
            const question = escapeQrHtml(byId('qrQuestion').value).replace(/\n/g, '<br>');
            const promo = qrState.promo;
            const sampleCode = promo.codePrefix + '-X7K2';

            return `<!DOCTYPE html><html><head>
              <meta name="viewport" content="width=device-width,initial-scale=1">
              <style>
                *{margin:0;padding:0;box-sizing:border-box;font-family:'Inter',sans-serif;}
                body{background:linear-gradient(160deg,#7c3aed,#0a0a0f);color:white;min-height:100vh;padding:20px;}
                .top{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;}
                .logo{font-size:12px;letter-spacing:2px;opacity:0.6;}
                .lang{display:flex;gap:4px;}
                .lang button{width:auto;background:rgba(255,255,255,0.12);color:white;border:1px solid rgba(255,255,255,0.2);padding:6px 12px;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;}
                .lang button.on{background:white;color:#7c3aed;}
                .card{background:rgba(255,255,255,0.08);backdrop-filter:blur(12px);border-radius:20px;padding:22px;border:1px solid rgba(255,255,255,0.15);}
                h1{font-size:19px;font-weight:800;line-height:1.35;margin-bottom:10px;}
                .promo{background:rgba(255,255,255,0.14);border-radius:12px;padding:12px;font-size:14px;font-weight:700;margin-bottom:12px;text-align:center;}
                .cond{font-size:12px;color:rgba(255,255,255,0.75);line-height:1.6;margin-bottom:16px;}
                label{font-size:12px;letter-spacing:1px;text-transform:uppercase;opacity:0.7;display:block;margin-bottom:6px;}
                input[type=text],input[type=tel],input[type=date],select{width:100%;padding:15px 14px;border-radius:12px;border:none;font-size:16px;margin-bottom:14px;background:white;color:#111;}
                .consent{display:flex;gap:10px;align-items:flex-start;font-size:12px;color:rgba(255,255,255,0.8);line-height:1.5;margin-bottom:14px;}
                .consent input{width:20px;height:20px;flex-shrink:0;margin-top:1px;}
                .consent label{display:block;margin:0;font-size:inherit;letter-spacing:normal;text-transform:none;opacity:1;}
                button{width:100%;background:white;color:#7c3aed;border:none;padding:17px;border-radius:14px;font-size:16px;font-weight:800;cursor:pointer;}
                button:disabled{opacity:0.5;}
                .success{display:none;text-align:center;padding:10px 0;}
                .success .code{font-family:monospace;font-size:26px;font-weight:800;background:rgba(255,255,255,0.15);border-radius:12px;padding:14px;margin:12px 0;letter-spacing:2px;}
                .footer{text-align:center;font-size:12px;color:rgba(255,255,255,0.4);margin-top:16px;}
              </style>${kiosk ? `<style>
                body{padding:40px;max-width:640px;margin:0 auto;}
                h1{font-size:30px;}
                .promo{font-size:20px;padding:18px;}
                .cond{font-size:16px;}
                label{font-size:14px;}
                input[type=text],input[type=tel]{font-size:22px;padding:20px;}
                .consent{font-size:14px;}
                .consent input{width:26px;height:26px;}
                button{font-size:22px;padding:22px;}
                .success .code{font-size:40px;}
                .footer{font-size:13px;}
              </style>` : ''}</head><body>
              <div class="top">
                <div class="logo">BITCOIN NAIL BAR</div>
                <div class="lang"><button id="lvi" class="on">VI</button><button id="len">EN</button></div>
              </div>
              <div class="card">
                <h1>${title}</h1>
                <div class="promo" id="tPromo">${escapeQrHtml(getQrPromoLabel(promo, 'vi'))}</div>
                <div class="cond">${question}</div>
                <div id="frm">
                  <label id="tNm" for="nm">Tên của bạn</label>
                  <input type="text" id="nm" placeholder="VD: Linh Trần" autocomplete="name">
                  <label id="tPh" for="ph">Số điện thoại</label>
                  <input type="tel" id="ph" placeholder="(832) 000-0000" inputmode="numeric" autocomplete="tel" maxlength="14">
                  <div class="consent">
                    <input type="checkbox" id="cs">
                    <label id="tCs" for="cs">Tôi đồng ý nhận tin nhắn từ Bitcoin Nail Bar. Tần suất thay đổi. Reply STOP để hủy, HELP để được hỗ trợ. Có thể tính phí tin nhắn & dữ liệu.</label>
                  </div>
                  <button id="go">📩 Nhận Promotion Code qua SMS</button>
                </div>
                <div class="success" id="ok">
                  <div style="font-size:34px;">✅</div>
                  <div style="font-size:14px;font-weight:600;margin-top:6px;" id="tOk">Promotion code đã gửi qua SMS!</div>
                  <div class="code">${sampleCode}</div>
                  <div style="font-size:12px;color:rgba(255,255,255,0.7);" id="tShow">Đưa code này cho nhân viên khi thanh toán 💅</div>
                  <button id="bk" style="margin-top:16px;background:rgba(255,255,255,0.15);color:white;border:1px solid rgba(255,255,255,0.3);">📅 Đặt lịch giữ chỗ luôn</button>
                  <div id="bkf" style="display:none;text-align:left;margin-top:16px;">
                    <label id="tSv" for="sv">Dịch vụ</label>
                    <select id="sv">
                      <option>💅 Gel Manicure — $35</option>
                      <option>🦶 Pedicure Deluxe — $45</option>
                      <option>✨ Combo Mani + Pedi — $70</option>
                      <option>💎 Dip Powder — $50</option>
                      <option>🌸 Full Set Gel-X — $65</option>
                    </select>
                    <label id="tDt" for="dt">Ngày</label>
                    <input type="date" id="dt">
                    <label id="tTm" for="tm">Giờ</label>
                    <select id="tm">
                      <option value="">— chọn giờ —</option>
                      <option>10:00</option><option>11:00</option><option>12:00</option>
                      <option>13:00</option><option>14:00</option><option>15:00</option>
                      <option>16:00</option><option>17:00</option><option>18:00</option>
                    </select>
                    <button id="bkgo">✅ Xác nhận đặt lịch</button>
                  </div>
                  <div id="bok" style="display:none;margin-top:16px;font-size:14px;font-weight:600;background:rgba(16,185,129,0.25);border-radius:12px;padding:14px;">📅 Đã đặt lịch! SMS xác nhận đã gửi — hẹn gặp bạn 💅</div>
                </div>
                <div class="footer">Bitcoin Nail Bar • 832-786-5576<br>Powered by NEXORA TOUCH</div>
              </div>
              <scr` + `ipt>
                var PROMO_LABELS=${JSON.stringify({ vi: promo.label, en: promo.labelEn || promo.label })};
                var I18N={
                  vi:{nm:'Tên của bạn',ph:'Số điện thoại',cs:'Tôi đồng ý nhận tin nhắn từ Bitcoin Nail Bar. Tần suất thay đổi. Reply STOP để hủy, HELP để được hỗ trợ. Có thể tính phí tin nhắn & dữ liệu.',go:'📩 Nhận Promotion Code qua SMS',ok:'Promotion code đã gửi qua SMS!',show:'Đưa code này cho nhân viên khi thanh toán 💅',pNm:'VD: Linh Trần',e1:'Vui lòng điền tên và số điện thoại.',e2:'Số điện thoại chưa đủ 10 số.',e3:'Vui lòng đồng ý nhận tin nhắn để nhận code.',bk:'📅 Đặt lịch giữ chỗ luôn',sv:'Dịch vụ',dt:'Ngày',tm:'Giờ',bkgo:'✅ Xác nhận đặt lịch',bok:'📅 Đã đặt lịch! SMS xác nhận đã gửi — hẹn gặp bạn 💅',e4:'Vui lòng chọn ngày và giờ.'},
                  en:{nm:'Your name',ph:'Phone number',cs:'I agree to receive text messages from Bitcoin Nail Bar. Message frequency varies. Reply STOP to cancel, HELP for help. Msg & data rates may apply.',go:'📩 Text Me My Promotion Code',ok:'Promotion code sent via SMS!',show:'Show this code to our staff at checkout 💅',pNm:'e.g. Jessica Smith',e1:'Please enter your name and phone number.',e2:'Phone number must be 10 digits.',e3:'Please agree to receive messages to get your code.',bk:'📅 Book an appointment now',sv:'Service',dt:'Date',tm:'Time',bkgo:'✅ Confirm booking',bok:'📅 Booked! Confirmation text sent — see you soon 💅',e4:'Please pick a date and time.'}
                };
                var L='vi';
                var KIOSK=${kiosk};
                function g(id){return document.getElementById(id);}
                function kioskFocusables(){
                  return Array.prototype.filter.call(
                    document.querySelectorAll('button:not([disabled]), input:not([disabled]), select:not([disabled])'),
                    function(element){return element.offsetParent !== null;}
                  );
                }
                function setLang(l){
                  L=l; var t=I18N[l];
                  g('tPromo').textContent=PROMO_LABELS[l] || PROMO_LABELS.vi;
                  g('tNm').textContent=t.nm; g('tPh').textContent=t.ph; g('tCs').textContent=t.cs;
                  g('go').textContent=t.go; g('tOk').textContent=t.ok; g('tShow').textContent=t.show;
                  g('nm').placeholder=t.pNm;
                  g('bk').textContent=t.bk; g('tSv').textContent=t.sv; g('tDt').textContent=t.dt;
                  g('tTm').textContent=t.tm; g('bkgo').textContent=t.bkgo; g('bok').textContent=t.bok;
                  g('lvi').className=l==='vi'?'on':''; g('len').className=l==='en'?'on':'';
                }
                g('lvi').onclick=function(){setLang('vi');};
                g('len').onclick=function(){setLang('en');};
                g('ph').addEventListener('input',function(){
                  var d=this.value.replace(/\\D/g,'').slice(0,10);
                  if(d.length>6) this.value='('+d.slice(0,3)+') '+d.slice(3,6)+'-'+d.slice(6);
                  else if(d.length>3) this.value='('+d.slice(0,3)+') '+d.slice(3);
                  else this.value=d;
                });
                g('go').onclick=function(){
                  var t=I18N[L];
                  var nm=g('nm').value.trim();
                  var d=g('ph').value.replace(/\\D/g,'');
                  if(!nm||!d){alert(t.e1);return;}
                  if(d.length<10){alert(t.e2);return;}
                  if(!g('cs').checked){alert(t.e3);return;}
                  g('frm').style.display='none';
                  g('ok').style.display='block';
                  if(KIOSK){ T=setTimeout(reset,8000); }
                };
                var T=null;
                function reset(){
                  g('ok').style.display='none'; g('frm').style.display='block';
                  g('nm').value=''; g('ph').value=''; g('cs').checked=false;
                  g('bk').style.display=''; g('bkf').style.display='none'; g('bok').style.display='none';
                  g('dt').value=''; g('tm').selectedIndex=0; g('sv').selectedIndex=0;
                }
                g('bk').onclick=function(){
                  if(T){clearTimeout(T);T=null;}
                  this.style.display='none';
                  g('bkf').style.display='block';
                };
                g('bkgo').onclick=function(){
                  var t=I18N[L];
                  if(!g('dt').value||!g('tm').value){alert(t.e4);return;}
                  g('bkf').style.display='none';
                  g('bok').style.display='block';
                  if(KIOSK){ T=setTimeout(reset,8000); }
                };
                document.addEventListener('keydown',function(event){
                  if (KIOSK && event.key === 'Escape') {
                    event.preventDefault();
                    parent.postMessage({ type: 'nexora-kiosk-close' }, '*');
                    return;
                  }
                  if (!KIOSK || event.key !== 'Tab') return;
                  var focusable=kioskFocusables();
                  if(!focusable.length)return;
                  var first=focusable[0];
                  var last=focusable[focusable.length-1];
                  if(event.shiftKey && document.activeElement === first){
                    event.preventDefault(); last.focus();
                  }else if(!event.shiftKey && document.activeElement === last){
                    event.preventDefault(); first.focus();
                  }
                });
                window.addEventListener('message',function(event){
                  if(!KIOSK || event.source !== parent || !event.data || event.data.type !== 'nexora-kiosk-focus')return;
                  var focusable=kioskFocusables();
                  if(!focusable.length)return;
                  var target=event.data.edge === 'last' ? focusable[focusable.length-1] : focusable[0];
                  target.focus();
                });
              </scr` + `ipt>
              </bo` + `dy></html>`;
          }

          function updateQrPreview() {
            const url = qrUrl();
            byId('qrLinkPreview').textContent = url;
            byId('qrPreviewUrl').textContent = url;
            byId('qrIframe').srcdoc = buildQrPageHtml(false);
          }

          let kioskOpener = null;
          let kioskBackgroundStates = [];

          function setKioskBackgroundInert(inert) {
            const overlay = byId('kioskOverlay');
            if (inert) {
              kioskBackgroundStates = [];
              let surface = overlay;
              while (surface && surface !== document.body) {
                const parent = surface.parentElement;
                if (!parent) break;
                Array.from(parent.children)
                  .filter(function(element) { return element !== surface && element.tagName !== 'SCRIPT'; })
                  .forEach(function(element) {
                    kioskBackgroundStates.push({ element: element, wasInert: element.hasAttribute('inert') });
                    element.setAttribute('inert', '');
                  });
                surface = parent;
              }
              return;
            }
            kioskBackgroundStates.forEach(function(state) {
              if (state.wasInert) state.element.setAttribute('inert', '');
              else state.element.removeAttribute('inert');
            });
            kioskBackgroundStates = [];
          }

          function openKiosk() {
            const overlay = byId('kioskOverlay');
            kioskOpener = document.activeElement;
            byId('kioskIframe').srcdoc = buildQrPageHtml(true);
            setKioskBackgroundInert(true);
            overlay.classList.add('open');
            overlay.setAttribute('aria-hidden', 'false');
            byId('kioskExit').focus();
          }

          function closeKiosk() {
            const overlay = byId('kioskOverlay');
            if (!overlay.classList.contains('open')) return;
            overlay.classList.remove('open');
            overlay.setAttribute('aria-hidden', 'true');
            setKioskBackgroundInert(false);
            if (kioskOpener && typeof kioskOpener.focus === 'function') kioskOpener.focus();
            kioskOpener = null;
          }

          function printPoster() {
            const img = byId('qrCanvas').querySelector('img') || byId('qrCanvas').querySelector('canvas');
            if (!img) { alert('QR chưa render — kiểm tra kết nối mạng.'); return; }
            const qrData = img.tagName === 'CANVAS' ? img.toDataURL('image/png') : img.src;
            const promo = qrState.promo;
            const posterHtml = `<!DOCTYPE html><html><head><meta charset="utf-8"><style>
              @page{size:A4;margin:0;}
              *{margin:0;padding:0;box-sizing:border-box;font-family:'Inter','Helvetica Neue',Arial,sans-serif;}
              body{width:210mm;min-height:297mm;padding:22mm 18mm;background:white;color:#111;text-align:center;}
              .brand{font-size:13px;letter-spacing:4px;color:#7c3aed;font-weight:800;margin-bottom:10mm;}
              h1{font-size:34px;font-weight:900;line-height:1.25;margin-bottom:8mm;}
              .promo{display:inline-block;border:3px solid #7c3aed;color:#7c3aed;border-radius:16px;padding:14px 26px;font-size:24px;font-weight:800;margin-bottom:10mm;}
              .qr{margin-bottom:10mm;}
              .qr img{width:320px;height:320px;border:1px solid #ddd;border-radius:12px;padding:12px;}
              .steps{display:inline-block;text-align:left;font-size:17px;line-height:2.1;margin-bottom:8mm;}
              .steps b{display:inline-block;width:26px;height:26px;line-height:26px;text-align:center;background:#7c3aed;color:white;border-radius:50%;margin-right:10px;font-size:14px;}
              .en{font-size:14px;color:#666;margin-bottom:10mm;}
              .footer{font-size:13px;color:#888;border-top:1px solid #eee;padding-top:6mm;}
            </style></head><body>
              <div class="brand">BITCOIN NAIL BAR</div>
              <h1>📱 Scan — Nhận Ưu Đãi Ngay!</h1>
              <div class="promo">${escapeQrHtml(promo.label)}</div>
              <div class="qr"><img src="${qrData}" alt="QR"></div>
              <div class="steps">
                <div><b>1</b> Mở camera điện thoại, quét mã QR</div>
                <div><b>2</b> Điền tên + số điện thoại</div>
                <div><b>3</b> Nhận promotion code qua SMS — đưa nhân viên khi thanh toán</div>
              </div>
              <div class="en">Scan the QR code with your phone camera to get your discount code by text.</div>
              <div class="footer">Bitcoin Nail Bar • 832-786-5576 • ${qrUrl()}</div>
            </bo` + `dy></html>`;
            const pf = document.createElement('iframe');
            pf.style.cssText = 'position:fixed;width:0;height:0;border:none;';
            document.body.appendChild(pf);
            pf.onload = () => { pf.contentWindow.focus(); pf.contentWindow.print(); setTimeout(() => pf.remove(), 2000); };
            pf.srcdoc = posterHtml;
          }

          function refreshQr() {
            updateQrPreview();
            renderQrCode();
          }

          byId('qrGuideBtn').addEventListener('click', function() {
            const guide = byId('qrGuide');
            const hidden = guide.hidden;
            guide.hidden = !hidden;
            this.innerHTML = '<i class="marketing-icon" data-lucide="book-open" aria-hidden="true"></i><span>' + (hidden ? 'Ẩn hướng dẫn' : 'Hướng dẫn') + '</span>';
            refreshBookingMarketingIcons();
          });
          byId('verifyBtn').addEventListener('click', verifyCode);
          byId('verifyInput').addEventListener('keydown', function(event) { if (event.key === 'Enter') verifyCode(); });
          byId('verifyResult').addEventListener('click', function(event) {
            const button = event.target.closest('[data-code]');
            if (button) markCodeUsed(button.dataset.code);
          });
          ['qrName', 'qrFormTitle', 'qrQuestion'].forEach(function(id) { byId(id).addEventListener('input', updateQrPreview); });
          byId('qrSlug').addEventListener('input', refreshQr);
          byId('qrPromo').addEventListener('change', function(event) {
            qrState.promo = QR_PROMOS.find(function(promo) { return promo.id === event.target.value; }) || QR_PROMOS[0];
            updateQrPreview();
          });
          byId('qrDownloadBtn').addEventListener('click', function() {
            const image = byId('qrCanvas').querySelector('img, canvas');
            if (!image) { alert('QR chưa render — kiểm tra kết nối mạng.'); return; }
            const link = document.createElement('a');
            link.href = image.tagName === 'CANVAS' ? image.toDataURL('image/png') : image.src;
            link.download = 'qr-' + (byId('qrSlug').value.trim() || 'nexora') + '.png';
            link.click();
          });
          byId('qrPrintBtn').addEventListener('click', printPoster);
          byId('kioskBtn').addEventListener('click', openKiosk);
          byId('kioskExit').addEventListener('click', closeKiosk);
          byId('kioskExit').addEventListener('keydown', function(event) {
            if (event.key !== 'Tab') return;
            event.preventDefault();
            byId('kioskIframe').contentWindow.postMessage({
              type: 'nexora-kiosk-focus',
              edge: event.shiftKey ? 'last' : 'first'
            }, '*');
          });
          document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape' && byId('kioskOverlay').classList.contains('open')) {
              event.preventDefault();
              closeKiosk();
            }
          });
          window.addEventListener('message', function(event) {
            if (event.source !== byId('kioskIframe').contentWindow || !event.data || event.data.type !== 'nexora-kiosk-close') return;
            closeKiosk();
          });
          byId('publishQrBtn').addEventListener('click', function() {
            alert('QR đã publish!\n\n' + byId('qrName').value + '\nKhuyến mãi: ' + qrState.promo.label + '\nLink: https://' + qrUrl() + '\n\nTải PNG và in đặt tại quầy. Leads sẽ đổ về tab Customers.');
          });

          renderQrPromoOptions();
          renderQrLeads();
          refreshQr();
        })();
      </script>

      <script src="../assets/booking-online-link.js"></script>
      <script src="../assets/booking-ai-voice-selector.js"></script>
      <script src="../assets/booking-knowledge.js"></script>
      <script src="../assets/booking-settings-tabs.js"></script>
      <script src="../assets/salon-settings-tabs.js"></script>
      <script src="../assets/pos-ai-receptionist-settings.js"></script>
    </body>
    </html>

