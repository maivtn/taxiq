             ============================================================ */
          const GSM7_BASIC = '@£$¥èéùìòÇ\nØø\rÅåΔ_ΦΓΛΩΠΨΣΘΞÆæßÉ !"#¤%&\'()*+,-./0123456789:;<=>?¡ABCDEFGHIJKLMNOPQRSTUVWXYZÄÖÑÜ§¿abcdefghijklmnopqrstuvwxyzäöñüà';
          const GSM7_EXT = '^{}\\[~]|€';

          function smsInfo(text) {
            if (!text) return { units: 0, parts: 0, encoding: 'GSM-7', perPart: 160 };

            let isUnicode = false;
            let gsmUnits = 0;
            for (const ch of text) {
              if (GSM7_BASIC.includes(ch)) gsmUnits += 1;
              else if (GSM7_EXT.includes(ch)) gsmUnits += 2;
              else { isUnicode = true; break; }
            }

            if (isUnicode) {
              const units = text.length; // UTF-16 units = UCS-2 units (emoji = 2)
              const parts = units <= 70 ? 1 : Math.ceil(units / 67);
              return { units, parts, encoding: 'UCS-2', perPart: units <= 70 ? 70 : 67 };
            }
            const parts = gsmUnits <= 160 ? 1 : Math.ceil(gsmUnits / 153);
            return { units: gsmUnits, parts, encoding: 'GSM-7', perPart: gsmUnits <= 160 ? 160 : 153 };
          }

          function renderSegmentButtons() {
            $('segmentGrid').innerHTML = COMPOSER_SEGMENTS.map(s => `
              <button class="segment-btn" data-segment="${s.id}" id="seg-${s.id}">
                <span class="segment-btn-icon"><i class="marketing-icon" data-lucide="${s.icon}" aria-hidden="true"></i></span>
                <span class="segment-btn-name">${escapeHtml(s.shortName)}</span>
                <span class="segment-btn-count">${s.count} khách</span>
              </button>
            `).join('');
            refreshBookingMarketingIcons();
          }

          function renderSmsCampaignCards() {
            const grid = document.querySelector('[data-sms-campaign-grid]');
            if (!grid) return;
            grid.innerHTML = SEGMENTS.map(s => `
              <button class="sms-campaign-card" type="button" data-sms-segment="${s.id}" style="--card-accent:${s.accent}">
                <span class="sms-campaign-icon"><i class="marketing-icon" data-lucide="${s.icon}" aria-hidden="true"></i></span>
                <span class="sms-campaign-copy">
                  <span class="sms-campaign-name">${escapeHtml(s.name)}</span>
                  <span class="sms-campaign-desc">${escapeHtml(s.desc)}</span>
                </span>
                <span class="sms-campaign-meta">
                  <span class="sms-campaign-count-wrap"><span class="sms-campaign-count">${s.count}</span><span class="sms-campaign-count-label">${escapeHtml(s.countLabel)}</span></span>
                  <span class="sms-campaign-badge">${escapeHtml(s.badgeText)}</span>
                </span>
              </button>
            `).join('');
            refreshBookingMarketingIcons();
          }

          function smsCampaignStatusClass(status) {
            return status === 'Sent' ? 'is-sent'
              : status === 'Scheduled' ? 'is-scheduled'
                : status === 'Active' ? 'is-active' : 'is-cancelled';
          }

          function smsCampaignModeLabel(mode) {
            return mode === 'schedule' ? 'Scheduled' : mode === 'auto' ? 'Automated' : 'Now';
          }

          function smsCampaignStatusLabel(mode) {
            return mode === 'schedule' ? 'Scheduled' : mode === 'auto' ? 'Active' : 'Sent';
          }

          function smsRecipientFixturesFor(segmentId) {
            return (SMS_RECIPIENT_FIXTURES[segmentId] || []).map(function(recipient) {
              return Object.assign({}, recipient);
            });
          }

          function createSmsCampaignRecord() {
            const info = smsInfo($('smsText').value);
            const totalSms = state.segment.count * Math.max(info.parts, 1);
            const mode = state.scheduleMode;
            return {
              id: 'sms-campaign-' + Date.now() + '-' + Math.random().toString(36).slice(2, 7),
              name: state.segment.name,
              audience: state.segment.name,
              segmentId: state.segment.id,
              mode: smsCampaignModeLabel(mode),
              status: smsCampaignStatusLabel(mode),
              sent: mode === 'now' ? totalSms : 0,
              failed: 0,
              message: $('smsText').value,
              landingPage: $('lpSelect').value,
              scheduleDate: $('schedDate').value,
              scheduleTime: $('schedTime').value,
              recipients: mode === 'now' ? smsRecipientFixturesFor(state.segment.id) : []
            };
          }

          function renderSmsCampaignList() {
            const list = document.querySelector('[data-sms-campaign-list]');
            if (!list) return;
            if (!smsCampaigns.length) {
              list.innerHTML = '<tr><td class="sms-campaign-empty" colspan="7">Chưa có campaign nào được tạo.</td></tr>';
              return;
            }

            list.innerHTML = smsCampaigns.map(function(campaign) {
              const canManage = campaign.status === 'Scheduled' || campaign.status === 'Active';
              const actionButtons = [
                '<button class="sms-campaign-action" type="button" data-sms-campaign-action="view" data-sms-campaign-id="' + escapeHtml(campaign.id) + '" aria-label="View recipients for ' + escapeHtml(campaign.name) + '">View</button>',
                canManage ? '<button class="sms-campaign-action" type="button" data-sms-campaign-action="edit" data-sms-campaign-id="' + escapeHtml(campaign.id) + '" aria-label="Edit ' + escapeHtml(campaign.name) + '">Edit</button>' : '',
                canManage ? '<button class="sms-campaign-action" type="button" data-sms-campaign-action="cancel" data-sms-campaign-id="' + escapeHtml(campaign.id) + '" aria-label="Cancel ' + escapeHtml(campaign.name) + '">Cancel</button>' : '',
                '<button class="sms-campaign-action is-danger" type="button" data-sms-campaign-action="delete" data-sms-campaign-id="' + escapeHtml(campaign.id) + '" aria-label="Delete ' + escapeHtml(campaign.name) + '">Delete</button>'
              ].join('');
              return '<tr>' +
                '<td>' + escapeHtml(campaign.name) + '</td>' +
                '<td>' + escapeHtml(campaign.audience) + '</td>' +
                '<td>' + escapeHtml(campaign.mode) + '</td>' +
                '<td><span class="sms-campaign-status ' + smsCampaignStatusClass(campaign.status) + '">' + escapeHtml(campaign.status) + '</span></td>' +
                '<td>' + Number(campaign.sent || 0).toLocaleString() + '</td>' +
                '<td>' + Number(campaign.failed || 0).toLocaleString() + '</td>' +
                '<td><div class="sms-campaign-actions">' + actionButtons + '</div></td>' +
              '</tr>';
            }).join('');
          }

          function smsRecipientStatusClass(status) {
            const normalized = String(status || '').toLowerCase();
            return normalized === 'sent' ? 'is-sent'
              : normalized === 'delivered' ? 'is-delivered'
                : normalized === 'failed' ? 'is-failed'
                  : normalized === 'scheduled' ? 'is-scheduled' : 'is-unknown';
          }

          function formatSmsRecipientSentAt(value) {
            const date = new Date(value);
            if (Number.isNaN(date.getTime())) return String(value || '—');
            const dateLabel = date.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
            const timeLabel = date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }).toLowerCase();
            return dateLabel + ' · ' + timeLabel;
          }

          function renderSmsCampaignRecipients(campaign) {
            const list = document.querySelector('[data-sms-recipient-list]');
            const count = document.querySelector('[data-sms-recipient-count]');
            if (!list || !campaign) return;

            const recipients = Array.isArray(campaign.recipients) ? campaign.recipients : [];
            const filteredRecipients = smsRecipientStatusFilter === 'all'
              ? recipients
              : recipients.filter(function(recipient) { return recipient.status === smsRecipientStatusFilter; });
            if (count) count.textContent = filteredRecipients.length + ' recipient' + (filteredRecipients.length === 1 ? '' : 's');

            if (!filteredRecipients.length) {
              list.innerHTML = '<tr><td class="sms-recipient-empty" colspan="5">No recipients sent for this campaign yet.</td></tr>';
              return;
            }

            list.innerHTML = filteredRecipients.map(function(recipient) {
              const status = String(recipient.status || 'Unknown');
              return '<tr>' +
                '<td>' + escapeHtml(String(recipient.customer || 'Unknown')) + '</td>' +
                '<td>' + escapeHtml(String(recipient.phone || '—')) + '</td>' +
                '<td><span class="sms-recipient-status ' + smsRecipientStatusClass(status) + '">' + escapeHtml(status) + '</span></td>' +
                '<td>' + escapeHtml(String(recipient.segments || 1)) + '</td>' +
                '<td>' + escapeHtml(formatSmsRecipientSentAt(recipient.sentAt)) + '</td>' +
              '</tr>';
            }).join('');
          }

          function openSmsCampaignRecipients(campaign) {
            const modal = document.querySelector('[data-sms-recipients-modal]');
            if (!modal || !campaign) return;
            smsRecipientsModalOpener = document.activeElement;
            smsRecipientsPreviousOverflow = document.body.style.overflow;
            smsRecipientStatusFilter = 'all';
            modal.dataset.smsRecipientCampaignId = campaign.id;
            modal.querySelector('[data-sms-recipients-subtitle]').textContent = campaign.name || 'Campaign';
            const filter = modal.querySelector('[data-sms-recipient-filter]');
            if (filter) filter.value = smsRecipientStatusFilter;
            renderSmsCampaignRecipients(campaign);
            modal.hidden = false;
            modal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            const closeButton = modal.querySelector('[data-sms-recipients-close]');
            if (closeButton) closeButton.focus();
          }

          function closeSmsCampaignRecipients() {
            const modal = document.querySelector('[data-sms-recipients-modal]');
            if (!modal || modal.hidden) return;
            modal.hidden = true;
            modal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = smsRecipientsPreviousOverflow;
            if (smsRecipientsModalOpener && typeof smsRecipientsModalOpener.focus === 'function') smsRecipientsModalOpener.focus();
            smsRecipientsModalOpener = null;
          }

          function openSmsCampaignEditor(campaign) {
            editingSmsCampaignId = campaign.id;
            openComposer(campaign.segmentId || 'new', campaign);
          }

          function handleSmsCampaignAction(event) {
            const actionButton = event.target.closest('[data-sms-campaign-action]');
            if (!actionButton) return;
            const campaign = smsCampaigns.find(function(item) { return item.id === actionButton.dataset.smsCampaignId; });
            if (!campaign) return;
            const action = actionButton.dataset.smsCampaignAction;

            if (action === 'view') {
              openSmsCampaignRecipients(campaign);
              return;
            }
            if (action === 'edit') {
              openSmsCampaignEditor(campaign);
              return;
            }
            if (action === 'cancel' && (campaign.status === 'Scheduled' || campaign.status === 'Active')) {
              if (!window.confirm('Cancel campaign "' + campaign.name + '"?')) return;
              campaign.status = 'Cancelled';
              renderSmsCampaignList();
              return;
            }
            if (action === 'delete') {
              if (!window.confirm('Delete campaign "' + campaign.name + '"?')) return;
              const index = smsCampaigns.indexOf(campaign);
              if (index >= 0) smsCampaigns.splice(index, 1);
              renderSmsCampaignList();
            }
          }

          function renderTemplates(segId) {
            const list = TEMPLATES[segId] || [];
            $('templateList').innerHTML = list.map((t, i) => `
              <button class="template-item" data-index="${i}">
                <div class="template-item-title"><i class="marketing-icon is-compact" data-lucide="message-square" aria-hidden="true"></i><span>${escapeHtml(t.title.replace(/^\S+\s+/, ''))}</span></div>
                <div class="template-item-text">${escapeHtml(t.text)}</div>
              </button>
            `).join('');
            refreshBookingMarketingIcons();
          }

          function setSendCampaignButton(confirming) {
            $('sendCampaignBtn').innerHTML = confirming
              ? '<i class="marketing-icon" data-lucide="check-circle" aria-hidden="true"></i><span>Xác nhận gửi</span>'
              : '<i class="marketing-icon" data-lucide="send" aria-hidden="true"></i><span>Gửi Campaign</span>';
            refreshBookingMarketingIcons();
          }

          /* ============================================================
             COMPOSER
             ============================================================ */
          function openComposer(segId) {
            const overlay = $('composerModal');
            const campaign = arguments[1] || null;
            const seg = COMPOSER_SEGMENTS.find(s => s.id === segId) || COMPOSER_SEGMENTS.find(s => s.id === 'new') || COMPOSER_SEGMENTS[0];
            if (!campaign) editingSmsCampaignId = null;
            state.segment = seg;
            state.scheduleMode = campaign
              ? campaign.mode === 'Scheduled' ? 'schedule' : campaign.mode === 'Automated' ? 'auto' : 'now'
              : 'now';
            state.confirming = false;
            $('confirmBox').classList.remove('show');
            setSendCampaignButton(false);

            document.querySelectorAll('.segment-btn').forEach(b => b.classList.toggle('selected', b.dataset.segment === seg.id));
            renderTemplates(seg.id);
            if (campaign) {
              $('smsText').value = campaign.message || '';
              $('lpSelect').value = campaign.landingPage || '';
              $('schedDate').value = campaign.scheduleDate || '';
              $('schedTime').value = campaign.scheduleTime || '10:00';
            } else {
              $('smsText').value = '';
              $('lpSelect').value = '';
              $('schedDate').value = '';
              $('schedTime').value = '10:00';
            }
            document.querySelectorAll('.schedule-opt').forEach(function(button) {
              button.classList.toggle('selected', button.dataset.mode === state.scheduleMode);
            });
            $('timeInputRow').style.display = state.scheduleMode === 'schedule' ? 'grid' : 'none';
            updateCharCount();
            updateCost();
            composerOpener = document.activeElement;
            setComposerBackgroundInert(true);
            overlay.classList.add('open');
            overlay.setAttribute('aria-hidden', 'false');
            $('closeComposerBtn').focus();
          }

          function closeComposer() {
            const overlay = $('composerModal');
            if (!overlay.classList.contains('open')) return;
            overlay.classList.remove('open');
            overlay.setAttribute('aria-hidden', 'true');
            setComposerBackgroundInert(false);
            state.confirming = false;
            $('confirmBox').classList.remove('show');
            setSendCampaignButton(false);
            editingSmsCampaignId = null;
            if (composerOpener && typeof composerOpener.focus === 'function') composerOpener.focus();
            composerOpener = null;
          }

          function scheduledDateTimeIsPast() {
            const date = $('schedDate').value;
            const time = $('schedTime').value;
            if (!date || !time) return false;
            const scheduledAt = new Date(date + 'T' + time);
            return !Number.isNaN(scheduledAt.getTime()) && scheduledAt.getTime() < Date.now();
          }

          function updateCharCount() {
            const text = $('smsText').value;
            const info = smsInfo(text);
            const box = $('charCountBox');
            box.textContent = `${info.units} ký tự — ${info.parts} tin (${info.encoding}, ${info.perPart}/tin)`;
            box.classList.toggle('multi', info.parts > 1);
            updateSmsPreview(text);
            updateCost();
            // Người dùng sửa nội dung sau khi bấm xác nhận → reset bước xác nhận
            if (state.confirming) {
              state.confirming = false;
              $('confirmBox').classList.remove('show');
              setSendCampaignButton(false);
            }
          }

          function updateSmsPreview(text) {
            const bubble = $('smsBubble');
            if (!text.trim()) {
              bubble.innerHTML = '<span class="sms-preview-empty">Tin nhắn sẽ hiển thị ở đây...</span>';
              return;
            }
            let safe = escapeHtml(text);
            for (const [tag, val] of Object.entries(TAG_SAMPLES)) {
              const safeTag = escapeHtml(tag);
              const rendered = tag === '{Link}' ? `<span class="lnk">${escapeHtml(val)}</span>` : `<strong>${escapeHtml(val)}</strong>`;
              safe = safe.split(safeTag).join(rendered);
            }
            bubble.innerHTML = safe.replace(/\n/g, '<br>');
          }

          function updateCost() {
            const info = smsInfo($('smsText').value);
            const parts = Math.max(info.parts, 1);
            const totalSms = state.segment.count * parts;
            const cost = marketingMoney(totalSms * PRICE_PER_SMS, { cents: true });
            const enough = state.credits >= totalSms;
            const lowCredits = state.credits > 0 && totalSms >= state.credits * 0.8;
            const needsCreditWarning = lowCredits || !enough;

            $('costPreview').textContent = `${state.segment.count} khách × ${parts} tin = ${totalSms} SMS (${cost})`;
            $('costLabel').textContent = !enough
              ? `Không đủ credits (còn ${state.credits})`
              : lowCredits
                ? `Sắp hết credits (còn ${state.credits})`
                : 'Chi phí ước tính';
            $('costBox').classList.toggle('warn', needsCreditWarning);
            $('costBuyCreditsBtn').hidden = !needsCreditWarning;
            $('sendCampaignBtn').disabled = !enough;
          }

          function updateCredits(newVal) {
            state.credits = newVal;
            if (window.NEXORA_CREDITS && typeof window.NEXORA_CREDITS.writeSmsCredits === 'function') {
              window.NEXORA_CREDITS.writeSmsCredits(newVal);
            }
            document.querySelectorAll('[data-sms-credits]').forEach(function(el) {
              el.textContent = newVal.toLocaleString();
              el.classList.toggle('low', newVal < 100);
            });
            document.querySelectorAll('[data-sms-credits-usd]').forEach(function(el) {
              el.textContent = `≈ ${marketingMoney(newVal * PRICE_PER_SMS, { cents: true })} remaining`;
            });
            updateCost();
          }

          function getSelectedSmsCreditPackage() {
            return SMS_CREDIT_PACKAGES.find(function(pkg) { return pkg.id === smsCreditPackageId; }) || SMS_CREDIT_PACKAGES[0];
          }

          function getSelectedSmsCreditPayment() {
            return SMS_CREDIT_PAYMENT_METHODS.find(function(method) { return method.id === smsCreditPaymentId; }) || SMS_CREDIT_PAYMENT_METHODS[0];
          }

          function renderSmsCreditPackages() {
            var target = document.querySelector('[data-sms-credit-package-list]');
            if (!target) return;

            target.innerHTML = SMS_CREDIT_PACKAGES.map(function(pkg) {
              var selected = pkg.id === smsCreditPackageId;
              return '<button class="sms-credit-package' + (selected ? ' is-selected' : '') + (pkg.featured ? ' is-featured' : '') + '" type="button" data-sms-credit-package="' + pkg.id + '" aria-pressed="' + (selected ? 'true' : 'false') + '">' +
                '<span class="sms-credit-package-check" aria-hidden="true">✓</span>' +
                '<span class="sms-credit-package-name">' + pkg.name + '</span>' +
                '<span class="sms-credit-package-amount">' + pkg.credits.toLocaleString() + ' SMS</span>' +
                '<span class="sms-credit-package-price">' + marketingMoney(pkg.price, { cents: true }) + '</span>' +
                '<span class="sms-credit-package-note">' + pkg.note + '</span>' +
              '</button>';
            }).join('');
          }

          function renderSmsCreditPaymentOptions(target, selectedId, dataAttribute) {
            target.innerHTML = SMS_CREDIT_PAYMENT_METHODS.map(function(method) {
              var selected = method.id === selectedId;
              var paymentAsset = method.id === 'CARD'
                ? '<i class="marketing-icon sms-credit-card-method-icon" data-lucide="credit-card" aria-hidden="true"></i>'
                : '<img class="sms-credit-token" src="' + method.asset + '" alt="" aria-hidden="true">';
              var paymentBalance = method.id === 'CARD' ? '' : '<span class="sms-credit-payment-balance"><span>Số dư</span><strong>' + method.balance + '</strong></span>';
              return '<button class="sms-credit-payment' + (selected ? ' is-selected' : '') + '" type="button" ' + dataAttribute + '="' + method.id + '" aria-pressed="' + (selected ? 'true' : 'false') + '">' +
                '<span class="sms-credit-payment-main">' +
                  '<span class="sms-credit-radio" aria-hidden="true"></span>' +
                  paymentAsset +
                  '<span class="sms-credit-payment-name">' + method.label + '</span>' +
                '</span>' +
                paymentBalance +
              '</button>';
            }).join('');
          }

          function renderSmsCreditPayments() {
            var target = document.querySelector('[data-sms-credit-payment-list]');
            if (!target) return;
            renderSmsCreditPaymentOptions(target, smsCreditPaymentId, 'data-sms-credit-payment');
          }

          function renderSmsCreditCardForm() {
            var form = document.querySelector('[data-sms-credit-card-form]');
            if (!form) return;
            var isCard = getSelectedSmsCreditPayment().id === 'CARD';
            form.hidden = !isCard;
            if (!isCard) {
              var error = form.querySelector('[data-sms-credit-card-error]');
              if (error) error.textContent = '';
            }
          }

          function validateSmsCreditCardForm() {
            var form = document.querySelector('[data-sms-credit-card-form]');
            if (!form || form.hidden) return true;

            var firstMissing = null;
            form.querySelectorAll('[data-sms-credit-card-required]').forEach(function(field) {
              field.removeAttribute('aria-invalid');
              if (!firstMissing && !field.value.trim()) firstMissing = field;
            });
            var error = form.querySelector('[data-sms-credit-card-error]');
            if (firstMissing) {
              firstMissing.setAttribute('aria-invalid', 'true');
              if (error) error.textContent = 'Please complete all required card details.';
              firstMissing.focus();
              return false;
            }
            if (error) error.textContent = '';
            return true;
          }

          function renderServicePlanPayment() {
            var target = document.querySelector('[data-plan-payment-list]');
            var title = document.querySelector('[data-plan-payment-title]');
            var invoicePlan = document.querySelector('[data-plan-invoice-plan]');
            var invoicePayment = document.querySelector('[data-plan-invoice-payment]');
            var invoiceTotal = document.querySelector('[data-plan-invoice-total]');
            var confirmLabel = document.querySelector('[data-plan-payment-confirm-label]');
            var status = document.querySelector('[data-plan-payment-status]');
            var planPrice = planPaymentPlan === 'Starter' ? 99 : planPaymentPlan === 'Pro' ? 199 : 349;
            if (target) renderSmsCreditPaymentOptions(target, planPaymentId, 'data-plan-payment');
            var selectedPayment = SMS_CREDIT_PAYMENT_METHODS.find(function(method) { return method.id === planPaymentId; }) || SMS_CREDIT_PAYMENT_METHODS[0];
            if (title) title.textContent = 'Choose ' + planPaymentPlan;
            if (invoicePlan) invoicePlan.textContent = planPaymentPlan;
            if (invoicePayment) invoicePayment.textContent = selectedPayment.label;
            if (invoiceTotal) invoiceTotal.textContent = marketingMoney(planPrice) + '/mo';
            if (confirmLabel) confirmLabel.textContent = 'Confirm ' + planPaymentPlan;
            if (status) status.textContent = planPaymentPlan + ', thanh toán bằng ' + selectedPayment.label + '.';
            var cardForm = document.querySelector('[data-plan-card-form]');
            if (cardForm) cardForm.hidden = selectedPayment.id !== 'CARD';
            if (selectedPayment.id !== 'CARD') {
              var error = document.querySelector('[data-plan-card-error]');
              if (error) error.textContent = '';
            }
          }

          function validateElitePlanCardForm() {
            var form = document.querySelector('[data-plan-card-form]');
            if (!form || form.hidden) return true;

            var firstMissing = null;
            form.querySelectorAll('[data-plan-card-required]').forEach(function(field) {
              field.removeAttribute('aria-invalid');
              if (!firstMissing && !field.value.trim()) firstMissing = field;
            });
            var error = form.querySelector('[data-plan-card-error]');
            if (firstMissing) {
              firstMissing.setAttribute('aria-invalid', 'true');
              if (error) error.textContent = 'Please complete all required card details.';
              firstMissing.focus();
              return false;
            }
            if (error) error.textContent = '';
            return true;
          }

          function openServicePlanPaymentModal(plan) {
            var modal = document.querySelector('[data-plan-payment-modal]');
            if (!modal || (plan !== 'Starter' && plan !== 'Pro' && plan !== 'Elite')) return;
            planPaymentModalOpener = document.activeElement;
            planPaymentPlan = plan;
            planPaymentId = SMS_CREDIT_PAYMENT_METHODS[0].id;
            renderServicePlanPayment();
            refreshBookingMarketingIcons();
            modal.hidden = false;
            document.body.style.overflow = 'hidden';
            var closeButton = modal.querySelector('[data-plan-payment-close]');
            if (closeButton) closeButton.focus();
          }
          window.openServicePlanPaymentModal = openServicePlanPaymentModal;

          function closeServicePlanPaymentModal() {
            var modal = document.querySelector('[data-plan-payment-modal]');
            if (!modal || modal.hidden) return;
            modal.hidden = true;
            document.body.style.overflow = '';
            if (planPaymentModalOpener && typeof planPaymentModalOpener.focus === 'function') planPaymentModalOpener.focus();
            planPaymentModalOpener = null;
          }

          function confirmServicePlanPayment() {
            var selectedPayment = SMS_CREDIT_PAYMENT_METHODS.find(function(method) { return method.id === planPaymentId; }) || SMS_CREDIT_PAYMENT_METHODS[0];
            if (selectedPayment.id === 'CARD' && !validateElitePlanCardForm()) return;
            var planPrice = planPaymentPlan === 'Starter' ? 99 : planPaymentPlan === 'Pro' ? 199 : 349;
            selectServicePlan(planPaymentPlan);
            closeServicePlanPaymentModal();
            $('successText').textContent = planPaymentPlan + ' plan selected — ' + marketingMoney(planPrice) + '/mo via ' + selectedPayment.label + '.';
            $('successBanner').classList.add('show');
            clearTimeout(confirmServicePlanPayment._timer);
            confirmServicePlanPayment._timer = setTimeout(function() { $('successBanner').classList.remove('show'); }, 6000);
          }

