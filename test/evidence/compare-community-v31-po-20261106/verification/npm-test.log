        #nx-campaign-root .sms-credit-card-required-note { margin-top:12px; color:var(--nexora-muted); font-size:12px; }
        #nx-campaign-root .sms-credit-card-required-note strong,
        #nx-campaign-root .sms-credit-card-label span { color:#dc2626; }
        #nx-campaign-root .sms-credit-card-fields { display:grid; gap:11px; margin-top:12px; }
        #nx-campaign-root .sms-credit-card-field { display:grid; gap:6px; min-width:0; }
        #nx-campaign-root .sms-credit-card-label { color:#273244; font-size:12px; font-weight:800; }
        #nx-campaign-root .sms-credit-card-input,
        #nx-campaign-root .sms-credit-card-select { width:100%; min-height:35px; border:1px solid #d8dee8; border-radius:8px; background:#fff; padding:8px 10px; color:var(--nexora-text); font-size:12px; outline:0; }
