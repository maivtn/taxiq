                      <button class="tag-btn" data-tag="{TenKhach}"><i class="marketing-icon is-compact" data-lucide="user" aria-hidden="true"></i><span>Tên khách</span></button>
                      <button class="tag-btn" data-tag="{TenTiem}"><i class="marketing-icon is-compact" data-lucide="store" aria-hidden="true"></i><span>Tên tiệm</span></button>
                      <button class="tag-btn" data-tag="{Link}"><i class="marketing-icon is-compact" data-lucide="link" aria-hidden="true"></i><span>Link offer</span></button>
                      <button class="tag-btn" data-tag="{SoDT}"><i class="marketing-icon is-compact" data-lucide="phone" aria-hidden="true"></i><span>Số điện thoại</span></button>
                    </div>
                    <textarea class="sms-textarea" id="smsText" placeholder="Soạn tin nhắn..."></textarea>
