        #panel-qr-codes .verify-result { display:none; margin-top:11px; border-radius:9px; padding:12px; font-size:12px; line-height:1.55; }
        #panel-qr-codes .verify-result.show { display:block; }
        #panel-qr-codes .verify-result.ok { border:1px solid rgba(0,184,115,.35); background:rgba(0,184,115,.07); }
        #panel-qr-codes .verify-result.used { border:1px solid rgba(245,158,11,.35); background:rgba(245,158,11,.07); color:#9a5a00; }
        #panel-qr-codes .verify-result.bad { border:1px solid rgba(220,38,38,.3); background:rgba(220,38,38,.06); color:#b91c1c; }
        #panel-qr-codes .call-status { display:inline-flex; border-radius:999px; padding:4px 8px; font-size:12px; font-weight:800; white-space:nowrap; }
        #panel-qr-codes .call-status.call-answered { background:rgba(0,184,115,.1); color:var(--nexora-success); }
        #panel-qr-codes .call-status.call-booked { background:rgba(245,158,11,.1); color:#9a5a00; }
        #panel-qr-codes .qr-preview { position:sticky; top:86px; overflow:hidden; min-height:650px; border:1px solid var(--nexora-border); border-radius:12px; background:#fff; box-shadow:var(--nexora-card-shadow); }
        #panel-qr-codes .preview-bar { display:flex; align-items:center; gap:6px; border-bottom:1px solid var(--nexora-rule); padding:9px 11px; background:var(--nexora-surface-muted); }
        #panel-qr-codes .preview-dot { width:8px; height:8px; border-radius:50%; }
        #panel-qr-codes .preview-url { flex:1; overflow:hidden; color:var(--nexora-muted); font-family:monospace; font-size:12px; text-overflow:ellipsis; white-space:nowrap; }
        #panel-qr-codes .qr-preview iframe { width:100%; min-height:610px; border:0; }
        .kiosk-overlay { position:fixed; inset:0; z-index:200; display:none; flex-direction:column; background:#0b1220; }
        .kiosk-overlay.open { display:flex; }
        .kiosk-overlay .kiosk-bar { display:flex; justify-content:space-between; align-items:center; gap:12px; border-bottom:1px solid rgba(255,255,255,.14); padding:10px 14px; }
        .kiosk-overlay .kiosk-hint { display:flex; align-items:center; gap:7px; color:#dbe5f4; font-size:11px; }
        .kiosk-overlay iframe { width:100%; flex:1; border:0; }
        @media (max-width:900px) { #panel-sms-campaigns .sms-campaign-stats { grid-template-columns:repeat(2,minmax(0,1fr)); } #panel-sms-campaigns .sms-campaign-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
        @media (max-width:980px) { #panel-qr-codes .guide-cols, #panel-qr-codes .qr-builder { grid-template-columns:1fr; } #panel-qr-codes .qr-preview { position:static; } }
        @media (max-width:767px) { #panel-qr-codes .qr-leads-table td:nth-child(1)::before { content:"Thời gian"; } #panel-qr-codes .qr-leads-table td:nth-child(2)::before { content:"Tên khách"; } #panel-qr-codes .qr-leads-table td:nth-child(3)::before { content:"Điện thoại"; } #panel-qr-codes .qr-leads-table td:nth-child(4)::before { content:"Promotion Code"; } #panel-qr-codes .qr-leads-table td:nth-child(5)::before { content:"Trạng thái"; } }
        @media (max-width:600px) { #panel-qr-codes .marketing-panel-head { flex-direction:column; } #panel-qr-codes .qr-head-actions, #panel-qr-codes .qr-head-actions button { width:100%; } #panel-qr-codes .verify-row { flex-direction:column; } }
        @media (max-width:600px) { #panel-sms-campaigns .marketing-panel-head { flex-direction:column; } #panel-sms-campaigns .marketing-panel-actions { width:100%; flex-direction:column; } #panel-sms-campaigns .sms-campaign-stats, #panel-sms-campaigns .sms-campaign-grid { grid-template-columns:1fr; } #panel-sms-campaigns .sms-campaign-table th, #panel-sms-campaigns .sms-campaign-table td { padding:12px; } }
        @media (max-width: 640px) {
          #nx-campaign-root .segment-grid { grid-template-columns: repeat(2, 1fr); }
          #nx-campaign-root .schedule-options { flex-direction: column; }
          #nx-campaign-root .modal-footer { flex-direction: column; align-items: stretch; }
        }

        .booking-duration {
          display: inline-flex;
          align-items: center;
          gap: 5px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 800;
          font-variant-numeric: tabular-nums;
        }

        .booking-duration .bi { color: var(--nexora-subtle); font-size: 13px; }

        .booking-status-cell {
          white-space: nowrap;
        }

        .booking-status {
          display: inline-flex;
          align-items: center;
          border-radius: 999px;
          padding: 4px 9px;
          font-size: 10px;
          font-weight: 900;
          letter-spacing: 0.02em;
        }

        .booking-status-new {
          background: rgba(245, 158, 11, 0.14);
          color: #9a5a00;
        }

        .booking-status-sms {
          background: rgba(70, 72, 216, 0.12);
          color: var(--nexora-brand);
        }

        .booking-status-done {
          background: rgba(0, 184, 115, 0.12);
          color: var(--nexora-success);
        }

        .booking-status-noshow {
          background: rgba(239, 68, 68, 0.12);
          color: #dc2626;
        }

        .booking-status-chips {
          display: flex;
          flex-wrap: wrap;
          gap: 8px;
          margin-bottom: 14px;
        }

        .booking-status-chip {
          display: inline-flex;
          align-items: center;
          gap: 7px;
          border: 1px solid var(--nexora-border);
          border-radius: 999px;
          background: #fff;
          padding: 7px 13px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 700;
          cursor: pointer;
          transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
        }

        .booking-status-chip:hover {
          border-color: rgba(70, 72, 216, 0.4);
        }

        .booking-status-chip.is-active {
          border-color: rgba(70, 72, 216, 0.5);
          background: color-mix(in srgb, var(--nexora-brand) 8%, white);
          color: var(--nexora-brand);
        }

        .booking-status-chip-count {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          min-width: 20px;
          height: 18px;
          padding: 0 6px;
          border-radius: 999px;
          background: var(--nexora-canvas);
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 800;
        }

        .booking-status-chip.is-active .booking-status-chip-count {
          background: var(--nexora-brand);
          color: #fff;
        }

        .cust-count {
          color: var(--nexora-muted);
          font-size: 11.5px;
          font-weight: 600;
        }

        .booking-empty-cell {
          text-align: center;
          padding: 20px;
          color: var(--nexora-muted);
          font-weight: 600;
        }

        .booking-actions {
          display: flex;
          flex-wrap: wrap;
          justify-content: flex-end;
          gap: 7px;
          min-width: 78px;
        }

        .booking-empty {
          border: 1px dashed var(--nexora-border);
          border-radius: 10px;
          background: var(--nexora-canvas);
          padding: 18px;
          color: var(--nexora-muted);
          text-align: center;
          font-size: 12px;
          font-weight: 700;
        }

        .booking-card-list {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
          gap: 10px;
        }

        .booking-appointment-card {
          display: grid;
          gap: 12px;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: #fff;
          padding: 14px;
          box-shadow: 0 8px 22px rgba(15, 23, 42, 0.05);
        }

        .booking-card-top {
          display: flex;
          align-items: flex-start;
          justify-content: space-between;
          gap: 10px;
        }

        .booking-card-name {
          color: var(--nexora-text);
          font-size: 14px;
          font-weight: 800;
          line-height: 1.3;
        }

        .booking-card-contact {
          margin-top: 4px;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 600;
          line-height: 1.45;
          overflow-wrap: anywhere;
        }

        .booking-card-info-list {
          display: grid;
          gap: 7px;
          border-top: 1px solid var(--nexora-rule);
          padding-top: 10px;
        }

        .booking-card-info-row {
          display: grid;
          grid-template-columns: 76px minmax(0, 1fr);
          align-items: baseline;
          gap: 10px;
          min-width: 0;
        }

        .booking-card-label {
          color: var(--nexora-subtle);
          font-size: 10px;
          font-weight: 800;
          letter-spacing: 0.04em;
          text-transform: uppercase;
        }

        .booking-card-value {
          color: var(--nexora-text);
          font-size: 12px;
          font-weight: 700;
          line-height: 1.4;
          overflow-wrap: anywhere;
        }

        .booking-card-actions {
          display: flex;
          flex-wrap: wrap;
          justify-content: flex-end;
          gap: 7px;
          padding-top: 1px;
        }

        .booking-source-voice {
          background: rgba(50, 215, 255, 0.12);
          color: #087c99;
        }

        .booking-source-lp {
          background: #e9e9ff;
          color: var(--nexora-brand);
        }

        .booking-source-sms {
          background: rgba(0, 184, 115, 0.12);
          color: var(--nexora-success);
        }

        .booking-source-qr {
          background: rgba(142, 77, 248, 0.13);
          color: var(--nexora-violet);
        }

        .booking-source-manual {
          background: rgba(245, 158, 11, 0.14);
          color: #b45309;
        }

        .tech-intro {
          display: flex;
          flex-wrap: wrap;
          align-items: center;
          justify-content: space-between;
          gap: 12px;
          margin-bottom: 14px;
        }

        .tech-intro-text {
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 700;
          line-height: 1.5;
        }

        .tech-grid {
          display: flex;
          flex-wrap: wrap;
          gap: 12px;
        }

        .tech-card {
          display: grid;
          align-content: start;
          gap: 9px;
          flex: 0 1 280px;
          width: 280px;
          max-width: 100%;
          border: 1px solid var(--nexora-border);
          border-radius: 12px;
          background: #fff;
          padding: 13px;
          box-shadow: var(--nexora-card-shadow);
        }

        .tech-top {
          display: grid;
          grid-template-columns: 40px minmax(0, 1fr) auto;
          align-items: center;
          gap: 10px;
          margin-bottom: 0;
        }

        .tech-avatar {
          display: inline-flex;
          width: 40px;
          height: 40px;
          flex-shrink: 0;
          align-items: center;
          justify-content: center;
          border-radius: 999px;
          background: linear-gradient(135deg, var(--nexora-electric), var(--nexora-violet));
          color: #fff;
          font-size: 14px;
          font-weight: 900;
        }

        .tech-profile {
          display: grid;
          min-width: 0;
          gap: 2px;
        }

        .tech-name {
          overflow: hidden;
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 900;
          line-height: 1.18;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .tech-phone {
          margin-top: 2px;
          overflow: hidden;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 700;
          line-height: 1.18;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .toggle-pill {
          position: relative;
          width: 42px;
          height: 24px;
          flex-shrink: 0;
          border: 0;
          border-radius: 999px;
          background: var(--nexora-border);
        }

        .toggle-pill::after {
          content: "";
          position: absolute;
          top: 3px;
          left: 3px;
          width: 18px;
          height: 18px;
          border-radius: 999px;
          background: #fff;
          box-shadow: 0 1px 4px rgba(15, 23, 42, 0.2);
          transition: transform 0.2s;
        }

        .toggle-pill.is-on {
          background: var(--nexora-success);
        }

        .toggle-pill.is-on::after {
          transform: translateX(18px);
        }

        .tech-services {
          display: flex;
          max-height: 128px;
          overflow-y: auto;
          flex-wrap: wrap;
          align-content: flex-start;
          gap: 6px;
          margin-bottom: 0;
          padding-right: 3px;
        }

        .tech-services .badge {
          min-height: 20px;
          padding: 3px 7px;
          line-height: 1;
        }

        .tech-stats {
          display: flex;
          align-items: center;
          gap: 6px;
          margin-top: 0;
          text-align: left;
        }

        .tech-card-footer {
          display: flex;
          height: 42px;
          min-height: 42px;
          align-items: center;
          justify-content: space-between;
          gap: 8px;
          margin-top: 2px;
          border-radius: 10px;
          background: var(--nexora-canvas);
          padding: 6px 7px;
          box-sizing: border-box;
        }

        .tech-card-actions {
          display: flex;
          justify-content: flex-end;
          margin-top: 0;
          padding-top: 0;
        }

        .tech-card-actions .booking-secondary-button {
          min-height: 30px;
          padding: 6px 9px;
          border-radius: 8px;
          font-size: 11px;
        }

        .tech-card-actions .booking-secondary-button.icon-only {
          width: 30px;
          min-width: 30px;
          height: 30px;
          padding: 0;
        }

        .tech-stat {
          display: inline-flex;
          min-height: 28px;
          align-items: center;
          gap: 6px;
          border: 0;
          border-radius: 999px;
          background: var(--nexora-canvas);
          padding: 4px 9px;
        }

        .tech-stat strong {
          display: inline;
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 900;
          line-height: 1;
        }

        .tech-stat span {
          color: var(--nexora-muted);
          font-size: 10px;
          font-weight: 800;
          line-height: 1;
          white-space: nowrap;
        }

        .tech-modal {
          position: fixed;
          inset: 0;
          z-index: 120;
          display: grid;
          place-items: center;
          background: rgba(8, 31, 73, 0.42);
          padding: 18px;
          backdrop-filter: blur(8px);
        }

        .tech-modal[hidden] {
          display: none;
        }

        .tech-dialog {
          display: flex;
          width: min(100%, 920px);
          max-height: min(88vh, 760px);
          overflow: hidden;
          flex-direction: column;
          border: 1px solid var(--nexora-border);
          border-radius: 14px;
          background: #fff;
          box-shadow: 0 28px 80px rgba(8, 31, 73, 0.24);
        }

        .tech-modal-head,
        .tech-modal-actions {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 12px;
          padding: 16px 18px;
        }

        .tech-modal-head {
          flex-shrink: 0;
          border-bottom: 1px solid var(--nexora-border);
          background: linear-gradient(180deg, #fff, #f8fbff);
          padding: 14px 16px;
        }

        .tech-modal-heading {
          display: flex;
          min-width: 0;
          align-items: center;
          gap: 10px;
        }

        .tech-title-mark {
          display: inline-flex;
          width: 36px;
          height: 36px;
          flex: 0 0 auto;
          align-items: center;
          justify-content: center;
          border-radius: 11px;
          background: color-mix(in srgb, var(--nexora-brand) 10%, white);
          color: var(--nexora-brand);
          font-size: 16px;
        }

        .tech-modal-title {
          color: var(--nexora-text);
          font-size: 15px;
          font-weight: 800;
        }

        .tech-modal-sub {
          margin-top: 3px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 500;
          line-height: 1.45;
        }

        .tech-modal-close {
          display: inline-flex;
          width: 34px;
          height: 34px;
          align-items: center;
          justify-content: center;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: #fff;
          color: var(--nexora-muted);
          font-size: 16px;
        }

        .tech-modal-body {
          display: grid;
          grid-template-columns: minmax(0, 1fr);
          gap: 12px;
          overflow: auto;
          padding: 12px;
        }

        .tech-modal-section {
          border: 1px solid var(--nexora-border);
          border-radius: 11px;
          background: #fff;
          padding: 12px;
          box-shadow: 0 8px 22px rgba(15, 23, 42, 0.04);
        }

        .tech-modal-section-title {
          display: flex;
          align-items: center;
          gap: 8px;
          color: var(--nexora-text);
          font-size: 12px;
          font-weight: 800;
          margin-bottom: 10px;
        }

        .tech-modal-section:first-child {
          position: relative;
          z-index: 3;
        }

        .tech-modal[data-tech-mode="detail"] [data-tech-picker-section] {
          display: none;
        }

        .tech-select-row {
          display: grid;
          grid-template-columns: minmax(0, 1fr) auto;
          align-items: start;
          gap: 8px;
        }

        .tech-combobox {
          position: relative;
          min-width: 0;
        }

        .tech-search {
          position: relative;
          display: block;
          margin: 0;
        }

        .tech-search i {
          position: absolute;
          top: 50%;
          left: 12px;
          color: var(--nexora-subtle);
          font-size: 13px;
          transform: translateY(-50%);
          pointer-events: none;
        }

        .tech-search .tech-select-chevron {
          right: 12px;
          left: auto;
          font-size: 12px;
        }

        .tech-combobox.is-open .tech-select-chevron {
          transform: translateY(-50%) rotate(180deg);
        }

        .tech-search input {
          width: 100%;
          height: 42px;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          outline: 0;
          background: #fff;
          padding: 0 34px;
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 700;
        }

        .tech-search input:focus {
          border-color: rgba(0, 184, 115, 0.72);
          box-shadow: 0 0 0 3px rgba(0, 184, 115, 0.12);
        }

        .tech-select-menu {
          position: absolute;
          top: calc(100% + 6px);
          right: 0;
          left: 0;
          z-index: 8;
          max-height: 292px;
          overflow-y: auto;
          border: 1px solid var(--nexora-border);
          border-radius: 12px;
          background: #fff;
          padding: 6px;
          box-shadow: 0 18px 45px rgba(8, 31, 73, 0.16);
        }

        .tech-select-menu[hidden] {
          display: none;
        }

        .tech-choice-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 7px;
          max-height: none;
          overflow: visible;
          padding-right: 2px;
        }

        .tech-choice-card {
          display: flex;
          align-items: center;
          gap: 9px;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: #fff;
          padding: 8px;
          color: var(--nexora-muted);
          text-align: left;
          transition: border-color 0.2s, background 0.2s, transform 0.2s, box-shadow 0.2s;
        }

        .tech-choice-card:hover {
          border-color: rgba(70, 72, 216, 0.25);
          background: var(--nexora-surface-muted);
        }

        .tech-choice-card.is-active {
          border-color: rgba(70, 72, 216, 0.42);
          background: color-mix(in srgb, var(--nexora-brand) 7%, white);
          color: var(--nexora-brand);
        }

        .tech-choice-card .tech-avatar {
          width: 32px;
          height: 32px;
          font-size: 12px;
        }

        .tech-choice-name {
          color: var(--nexora-text);
          font-size: 12px;
          font-weight: 800;
        }

        .tech-choice-meta {
          margin-top: 2px;
          color: var(--nexora-muted);
          font-size: 10.5px;
          font-weight: 500;
        }

        .tech-empty {
          display: none;
          border: 1px dashed var(--nexora-border);
          border-radius: 10px;
          background: #fff;
          padding: 10px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 600;
        }

        .tech-empty.is-visible {
          display: block;
        }

        .tech-create-button {
          height: 42px;
          display: inline-flex;
          align-items: center;
          gap: 6px;
          white-space: nowrap;
        }

        .tech-modal-grid {
          display: grid;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: 10px;
        }

        .tech-modal-grid .settings-field:nth-child(4),
        .tech-modal-grid .settings-field:last-child {
          grid-column: 1 / -1;
        }

        .tech-service-checks {
          display: block;
        }

        .tech-service-picker {
          display: block;
          max-height: 360px;
          overflow-y: auto;
          padding-right: 2px;
        }

        .tech-service-picker > * + * {
          margin-top: 6px;
        }

        .tech-service-picker-toolbar {
          position: sticky;
          top: 0;
          z-index: 2;
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 8px;
          border: 1px solid rgba(70, 72, 216, 0.28);
          border-radius: 9px;
          background: color-mix(in srgb, var(--nexora-brand) 5%, white);
          padding: 8px 9px;
          color: var(--nexora-text);
          font-size: 11px;
          font-weight: 900;
        }

        .tech-service-picker-toolbar label,
        .tech-service-category-all {
          display: inline-flex;
          align-items: center;
          gap: 6px;
          cursor: pointer;
          white-space: nowrap;
        }

        .tech-service-picker-toolbar input,
        .tech-service-category-all input {
          width: 14px;
          height: 14px;
          flex: 0 0 auto;
          accent-color: var(--nexora-brand);
        }

        .tech-service-picker-count,
        .tech-service-category-count {
          flex: 0 0 auto;
          border-radius: 999px;
          background: #e9edff;
          padding: 2px 7px;
          color: var(--nexora-brand);
          font-size: 10px;
          font-weight: 800;
        }

        .tech-service-category-count {
          margin-left: auto;
        }

        .tech-service-category {
          overflow: hidden;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: #fff;
        }

        .tech-service-category-head {
          display: flex;
          align-items: center;
          gap: 8px;
          list-style: none;
          cursor: pointer;
          background: #f8faff;
          padding: 8px 9px;
        }

        .tech-service-category-head::-webkit-details-marker {
          display: none;
        }

        .tech-service-category-head::after {
          content: '⌄';
          margin-left: 0;
          color: var(--nexora-subtle);
          font-size: 14px;
          font-weight: 900;
          line-height: 1;
          transition: transform .16s ease;
        }

        .tech-service-category:not([open]) .tech-service-category-head::after {
          transform: rotate(-90deg);
        }

        .tech-service-category-title {
          min-width: 0;
          overflow: hidden;
          color: var(--nexora-text);
          font-size: 10px;
          font-weight: 900;
          letter-spacing: .04em;
          text-overflow: ellipsis;
          text-transform: uppercase;
          white-space: nowrap;
        }

        .tech-service-category-all {
          color: var(--nexora-muted);
          font-size: 10px;
          font-weight: 800;
        }

        .tech-service-category-body {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
          gap: 6px;
          border-top: 1px solid var(--nexora-rule);
          padding: 8px;
        }

        .tech-service-catalog-state {
          border: 1px dashed var(--nexora-border);
          border-radius: 9px;
          background: #fff;
          padding: 14px 10px;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 700;
          text-align: center;
        }

        .tech-service-check {
          display: flex;
          min-height: 34px;
          align-items: center;
          gap: 6px;
          border: 1px solid var(--nexora-border);
          border-radius: 9px;
          background: #fff;
          padding: 7px 8px;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 700;
        }

        .tech-service-check input {
          width: 14px;
          height: 14px;
          flex: 0 0 auto;
          accent-color: var(--nexora-brand);
        }

        .tech-service-check:has(input:checked) {
          border-color: rgba(70, 72, 216, 0.42);
          background: color-mix(in srgb, var(--nexora-brand) 7%, white);
          color: var(--nexora-text);
        }

        .tech-service-check.is-all {
          grid-column: 1 / -1;
          border-color: rgba(70, 72, 216, 0.28);
          background: color-mix(in srgb, var(--nexora-brand) 5%, white);
          font-weight: 900;
        }

        .tech-schedule {
          display: grid;
          grid-template-columns: 1fr;
          gap: 7px;
        }

        .tech-schedule-row {
          display: grid;
          grid-template-columns: minmax(82px, 1fr) auto minmax(0, 300px);
          align-items: center;
          gap: 8px;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: #fff;
          padding: 8px;
          transition: border-color 0.2s, background 0.2s, opacity 0.2s;
        }

        .tech-schedule-row.is-day-off {
          border-color: var(--nexora-rule);
          background: var(--nexora-canvas);
          opacity: 0.62;
        }

        .tech-schedule-toggle {
          width: 16px;
          height: 16px;
          accent-color: var(--nexora-brand);
        }

        .tech-schedule-off {
          display: inline-flex;
          align-items: center;
          gap: 6px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 700;
          white-space: nowrap;
        }

        .tech-schedule-day {
          color: var(--nexora-text);
          font-size: 12px;
          font-weight: 800;
        }

        .tech-schedule-time {
          display: grid;
          grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
          align-items: center;
          gap: 6px;
        }

        .tech-schedule-time span {
          color: var(--nexora-muted);
          font-size: 10px;
          font-weight: 800;
          text-transform: uppercase;
        }

        .tech-schedule-time input {
          width: 100%;
          height: 32px;
          border: 1px solid var(--nexora-border);
          border-radius: 8px;
          background: #fff;
          padding: 0 8px;
          color: var(--nexora-text);
          font-size: 12px;
          font-weight: 700;
        }

        .tech-schedule-time input:disabled {
          background: var(--nexora-surface-muted);
          color: var(--nexora-subtle);
        }

        .tech-modal-actions {
          flex-shrink: 0;
          justify-content: flex-end;
          border-top: 1px solid var(--nexora-border);
          background: #fff;
          padding: 12px 16px;
        }

        @media (max-width: 767px) {
          .tech-modal {
            padding: 10px;
          }

          .tech-dialog {
            max-height: 92vh;
            border-radius: 12px;
          }

          .tech-modal-head {
            padding: 12px;
          }

          .tech-modal-body {
            grid-template-columns: 1fr;
            gap: 10px;
            padding: 10px;
          }

          .tech-choice-grid {
            max-height: 190px;
          }

          .tech-modal-grid {
            grid-template-columns: 1fr;
          }

          .tech-service-checks {
            grid-template-columns: repeat(auto-fit, minmax(76px, 1fr));
          }

          .tech-schedule-row {
            grid-template-columns: minmax(78px, 1fr) auto;
          }

          .tech-schedule-time {
            grid-column: 1 / -1;
          }
        }

        .sms-preview-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 10px;
        }

        .bottom-nav {
          position: fixed;
          right: 12px;
          bottom: 12px;
          left: 12px;
          z-index: 40;
          display: grid;
          grid-template-columns: repeat(5, 1fr);
          gap: 4px;
          border: 1px solid rgba(221, 229, 239, 0.95);
          border-radius: 18px;
          background: rgba(255, 255, 255, 0.96);
          padding: 8px;
          box-shadow: 0 16px 40px rgba(8, 31, 73, 0.16);
          backdrop-filter: blur(18px);
        }

        .bottom-nav button {
          display: flex;
          min-width: 0;
          flex-direction: column;
          align-items: center;
          gap: 4px;
          border: 0;
          border-radius: 12px;
          background: transparent;
          padding: 8px 4px;
          color: var(--nexora-muted);
          font-size: 10px;
          font-weight: 800;
        }

        .bottom-nav button.is-active {
          background: var(--nexora-brand);
          color: #fff;
        }

        .bottom-nav img {
          width: 22px;
          height: 22px;
          object-fit: contain;
        }

        /* Typography pass: keep hierarchy clear without making every label feel heavy. */
        .page-title,
        .settings-title,
        .trial-title {
          font-weight: 700;
        }

        .mode-switch button,
        .language-switcher button,
        .booking-subtab,
        .booking-primary-button,
        .booking-secondary-button,
        .booking-mini-button,
        .action-button,
        .plan-select-button,
        .voice-scenario-button,
        .quick-button,
        .owner-quick-button,
        .bottom-nav button,
        .trial-submit {
          font-weight: 700;
        }

        .card-title,
        .action-title,
        .owner-action-title,
        .owner-feed-copy,
        .booking-date,
        .booking-customer-name,
        .settings-card-title,
        .settings-config-title,
        .settings-service-name,
        .settings-template-name,
        .settings-offer-name,
        .service-plan-name,
        .business-name,
        .tech-name {
          font-weight: 700;
        }

        .kpi-value,
        .service-plan-price,
        .roi-value,
        .voice-number,
