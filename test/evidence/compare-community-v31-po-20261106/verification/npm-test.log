          }
          function queueCheckoutSnapshot(orderKey, groupTickets) {
            var first = groupTickets[0] || {};
            var bookingTicket = groupTickets.find(function (w) { return !!w.bookingId; }) || null;
            var techTicket = groupTickets.find(function (w) { return !!(w.techId || w.reqTech); }) || null;
            var serviceDetails = [];
            var checkoutTickets = [];
            groupTickets.forEach(function (w) {
              var billItems = (Array.isArray(w.items) && w.items.length) ? w.items : queueItemsForService(w.svc, w.techId || w.reqTech || null);
              if (!billItems.length && w.svc) billItems = [{ name: posServiceDisplayName(w.svc), price: 0, durationMin: w.durationMin || 0, techId: w.techId || w.reqTech || null, cat: '' }];
              billItems.forEach(function (item) {
