      3: |-
        <script>
            const codes = ['vi','en','zh','ko','es','ja','th','ar','fr'];
            const rows = [
              ["navVideo", "Video giới thiệu", "Overview video", "介绍视频", "소개 영상", "Video de presentación", "紹介動画", "วิดีโอแนะนำ", "فيديو تعريفي", "Vidéo de présentation"],
              ["navDownload", "Tải ứng dụng", "Download app", "下载应用", "앱 다운로드", "Descargar app", "アプリをダウンロード", "ดาวน์โหลดแอป", "تنزيل التطبيق", "Télécharger l’application"],
              ["videoKicker", "VIDEO GIỚI THIỆU", "OVERVIEW VIDEO", "介绍视频", "소개 영상", "VIDEO DE PRESENTACIÓN", "紹介動画", "วิดีโอแนะนำ", "فيديو تعريفي", "VIDÉO DE PRÉSENTATION"],
              ["videoTitle", "Xem NEXORA TOUCH vận hành trong một phút", "See NEXORA TOUCH in action in one minute", "一分钟了解 NEXORA TOUCH", "1분 만에 보는 NEXORA TOUCH", "NEXORA TOUCH en acción en un minuto", "1分でわかる NEXORA TOUCH", "ชม NEXORA TOUCH ในหนึ่งนาที", "تعرّف على NEXORA TOUCH في دقيقة", "Découvrez NEXORA TOUCH en une minute"],
              ["videoBody", "Tìm hiểu cách QR, tip, đánh giá và ưu đãi kết nối trong trải nghiệm tại tiệm.", "See how QR, tips, reviews and rewards fit into the salon experience.", "了解二维码、小费、评价和奖励如何融入门店体验。", "QR, 팁, 리뷰와 리워드가 매장 경험에 어떻게 연결되는지 확인하세요.", "Descubre cómo QR, propinas, reseñas y recompensas forman parte de la experiencia del salón.", "QR、チップ、レビュー、特典がサロン体験につながる様子をご覧ください。", "ดูว่า QR ทิป รีวิว และรางวัลเชื่อมต่อกับประสบการณ์ในร้านอย่างไร", "شاهد كيف ترتبط رموز QR والإكراميات والتقييمات والمكافآت بتجربة الصالون.", "Découvrez comment QR, pourboires, avis et récompenses s’intègrent à l’expérience en salon."],
              ["videoPlay", "Phát video giới thiệu", "Play overview video", "播放介绍视频", "소개 영상 재생", "Reproducir video de presentación", "紹介動画を再生", "เล่นวิดีโอแนะนำ", "تشغيل الفيديو التعريفي", "Lire la vidéo de présentation"],
              ["videoCaption", "Video giới thiệu NEXORA TOUCH · 1 phút", "NEXORA TOUCH overview · 1 min", "NEXORA TOUCH 介绍 · 1 分钟", "NEXORA TOUCH 소개 · 1분", "Presentación de NEXORA TOUCH · 1 min", "NEXORA TOUCH 紹介 · 1分", "แนะนำ NEXORA TOUCH · 1 นาที", "نظرة على NEXORA TOUCH · دقيقة واحدة", "Présentation de NEXORA TOUCH · 1 min"],
              ["videoYoutube", "Xem trên YouTube ↗", "Watch on YouTube ↗", "在 YouTube 观看 ↗", "YouTube에서 보기 ↗", "Ver en YouTube ↗", "YouTubeで見る ↗", "ดูบน YouTube ↗", "شاهد على YouTube ↗", "Voir sur YouTube ↗"],
              ["downloadKicker", "ỨNG DỤNG NEXORA TOUCH", "NEXORA TOUCH APP", "NEXORA TOUCH 应用", "NEXORA TOUCH 앱", "APP NEXORA TOUCH", "NEXORA TOUCH アプリ", "แอป NEXORA TOUCH", "تطبيق NEXORA TOUCH", "APPLICATION NEXORA TOUCH"],
              ["downloadTitle", "Mang NEXORA TOUCH theo bạn", "Take NEXORA TOUCH with you", "随身使用 NEXORA TOUCH", "NEXORA TOUCH를 언제나 함께", "Lleva NEXORA TOUCH contigo", "NEXORA TOUCH をいつでも", "พก NEXORA TOUCH ไปกับคุณ", "خذ NEXORA TOUCH معك", "Emportez NEXORA TOUCH avec vous"],
              ["downloadBody", "Quét mã QR hoặc chọn cửa hàng ứng dụng để tải NEXORA TOUCH trên điện thoại.", "Scan a QR code or choose your app store to get NEXORA TOUCH on your phone.", "扫描二维码或选择应用商店，在手机上下载 NEXORA TOUCH。", "QR 코드를 스캔하거나 앱 스토어에서 NEXORA TOUCH를 다운로드하세요.", "Escanea un código QR o elige tu tienda para descargar NEXORA TOUCH en tu teléfono.", "QRコードを読み取るか、ストアから NEXORA TOUCH をダウンロードしてください。", "สแกน QR หรือเลือกสโตร์เพื่อดาวน์โหลด NEXORA TOUCH ลงโทรศัพท์", "امسح رمز QR أو اختر متجر التطبيقات لتنزيل NEXORA TOUCH على هاتفك.", "Scannez un QR code ou choisissez votre boutique pour télécharger NEXORA TOUCH sur votre téléphone."],
              ["downloadOn", "TẢI TRÊN", "DOWNLOAD ON", "下载自", "다운로드", "DESCARGAR EN", "ダウンロード", "ดาวน์โหลดจาก", "حمّل من", "TÉLÉCHARGER SUR"],
              ["closingKicker", "NEXORA BUSINESS SUITE", "NEXORA BUSINESS SUITE", "NEXORA BUSINESS SUITE", "NEXORA BUSINESS SUITE", "NEXORA BUSINESS SUITE", "NEXORA BUSINESS SUITE", "NEXORA BUSINESS SUITE", "NEXORA BUSINESS SUITE", "NEXORA BUSINESS SUITE"],
              ["closingTitle", "Khám phá NEXORA Business Suite", "Explore NEXORA Business Suite", "探索 NEXORA Business Suite", "NEXORA Business Suite 살펴보기", "Explora NEXORA Business Suite", "NEXORA Business Suite を探る", "สำรวจ NEXORA Business Suite", "اكتشف NEXORA Business Suite", "Découvrez NEXORA Business Suite"],
              ["closingBody", "Quản lý lịch hẹn, vận hành quầy, thanh toán, chăm sóc khách hàng và tiếp thị. Chọn những công cụ phù hợp với tiệm của bạn.", "Manage appointments, front desk operations, payments, customer care and marketing. Choose the tools that fit your salon.", "管理预约、前台运营、支付、客户服务和营销。选择适合您门店的工具。", "예약, 카운터 운영, 결제, 고객 관리와 마케팅을 살펴보고 매장에 맞는 도구를 선택하세요.", "Gestiona citas, operaciones de mostrador, pagos, atención al cliente y marketing. Elige las herramientas adecuadas para tu salón.", "予約、受付業務、決済、顧客対応、マーケティングを管理。サロンに合うツールをお選びください。", "จัดการนัดหมาย งานหน้าร้าน การชำระเงิน การดูแลลูกค้า และการตลาด เลือกเครื่องมือที่เหมาะกับร้านของคุณ", "أدر المواعيد وعمليات الاستقبال والمدفوعات ورعاية العملاء والتسويق. اختر الأدوات المناسبة لصالونك.", "Gérez les rendez-vous, l’accueil, les paiements, la relation client et le marketing. Choisissez les outils adaptés à votre salon."],
              ["closingRegister", "Bắt đầu miễn phí ↗", "Get started free ↗", "免费开始 ↗", "무료로 시작하기 ↗", "Empezar gratis ↗", "無料で始める ↗", "เริ่มต้นฟรี ↗", "ابدأ مجانًا ↗", "Commencer gratuitement ↗"],
              ["closingExplore", "Khám phá bộ công cụ ↓", "Explore the tools ↓", "探索工具 ↓", "도구 살펴보기 ↓", "Explorar herramientas ↓", "ツールを見る ↓", "สำรวจเครื่องมือ ↓", "استكشف الأدوات ↓", "Explorer les outils ↓"],
              ["footerBrandBody", "Dành cho những người làm đẹp cho cộng đồng của mình.", "Built for the people who make their community beautiful.", "为让社区更美好的人而打造。", "지역사회를 아름답게 만드는 사람들을 위해.", "Creado para quienes embellecen su comunidad.", "地域を美しくする人々のために。", "สร้างขึ้นเพื่อผู้ที่ทำให้ชุมชนสวยงาม", "صُمّم لمن يجعلون مجتمعهم أجمل.", "Conçu pour celles et ceux qui embellissent leur communauté."],
              ["footerSocial", "Kết nối với chúng tôi", "Connect with us", "与我们联系", "소셜 채널", "Conecta con nosotros", "つながる", "ติดตามเรา", "تواصل معنا", "Suivez-nous"],
              ["footerPendingSocial", "liên kết chính thức đang cập nhật", "official link pending", "官方链接待更新", "공식 링크 준비 중", "enlace oficial pendiente", "公式リンクを準備中", "กำลังรอลิงก์ทางการ", "الرابط الرسمي قيد التحديث", "lien officiel à venir"],
              ["liveAllianceTitle", "Liên minh địa phương", "Local alliances", "本地商户合作", "지역 제휴", "Alianzas locales", "地域の事業者連携", "พันธมิตรในพื้นที่", "شراكات محلية", "Partenariats locaux"],
              ["liveAlliance", "Trang hiện tại giới thiệu cách các doanh nghiệp lân cận chia sẻ ưu đãi và khách hàng.", "The current site presents how neighboring businesses can share offers and customer traffic.", "当前网站展示邻近商户如何共享优惠并相互引流。", "현재 사이트는 이웃 사업장이 혜택과 고객 유입을 공유하는 방식을 소개합니다.", "El sitio actual muestra cómo los negocios vecinos comparten ofertas y clientes.", "現在のサイトでは近隣事業者が特典や顧客をつなぐ方法を紹介します。", "เว็บไซต์ปัจจุบันแสดงวิธีที่ธุรกิจใกล้เคียงแบ่งปันข้อเสนอและลูกค้า", "يعرض الموقع الحالي كيف تتشارك الأنشطة المجاورة العروض وتدفق العملاء.", "Le site actuel présente le partage d’offres et de clientèle entre voisins."],
              ["livePricingTitle", "Gói dịch vụ", "Plans", "服务方案", "요금제", "Planes", "プラン", "แพ็กเกจ", "الباقات", "Offres"],
              ["livePricing", "Xem cách trang hiện tại phân tầng tính năng cho từng quy mô doanh nghiệp.", "See how the current site organizes features for different business sizes.", "查看当前网站如何按企业规模划分功能。", "현재 사이트에서 사업장 규모별 기능 구성을 확인하세요.", "Vea cómo el sitio actual organiza funciones según el tamaño del negocio.", "現在のサイトで事業規模別の機能構成を確認できます。", "ดูการจัดฟีเจอร์ตามขนาดธุรกิจบนเว็บไซต์ปัจจุบัน", "تعرّف على تنظيم ميزات الموقع الحالي بحسب حجم النشاط.", "Découvrez comment le site actuel classe les fonctions selon la taille de l’entreprise."],
              ["navVlinkpay", "VLINKPAY", "VLINKPAY", "VLINKPAY", "VLINKPAY", "VLINKPAY", "VLINKPAY", "VLINKPAY", "VLINKPAY", "VLINKPAY"],
              ["headerNews", "Tin tức", "News", "新闻", "뉴스", "Noticias", "ニュース", "ข่าวสาร", "الأخبار", "Actualités"],
              ["headerLogin", "Đăng nhập", "Login", "登录", "로그인", "Iniciar sesión", "ログイン", "เข้าสู่ระบบ", "تسجيل الدخول", "Connexion"],
