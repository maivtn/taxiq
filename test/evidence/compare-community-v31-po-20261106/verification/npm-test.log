        .settings-input-row,
        .settings-actions {
          display: flex;
          flex-wrap: wrap;
          gap: 8px;
        }

        .settings-input-row .settings-input {
          flex: 1 1 220px;
        }

        .settings-field-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 10px;
        }

        .settings-field {
          display: grid;
          gap: 6px;
        }

        .settings-business-grid {
          align-items: start;
          column-gap: 12px;
          row-gap: 12px;
        }

        .settings-location-grid {
          display: grid;
          grid-column: 1 / -1;
          grid-template-columns: 1fr;
          column-gap: 10px;
          row-gap: 10px;
        }

        .settings-location-grid > .settings-field {
          min-width: 0;
          gap: 6px;
        }

        .settings-location-grid > .settings-field:not(.settings-span-full) {
          grid-template-rows: 14px 40px;
        }

        .settings-location-grid > .settings-span-full {
          grid-column: 1 / -1;
        }

        .settings-location-grid .settings-label {
          font-size: 10px;
        }

        .settings-location-grid .settings-input,
        .settings-location-grid .settings-select {
          min-height: 40px;
          border-radius: 9px;
          padding: 0 11px;
        }

        .settings-business-grid > .settings-field {
          min-width: 0;
        }

        .settings-business-grid > .settings-field:not(.settings-span-full) {
          grid-template-rows: 16px 46px;
        }

        .settings-business-grid > .settings-span-full {
          grid-column: 1 / -1;
        }

        .settings-business-grid .settings-label,
        .settings-business-grid .settings-help {
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .settings-business-grid .settings-input {
          border-radius: 10px;
        }

        .settings-business-grid .settings-help {
          min-height: 16px;
        }

        .settings-social-links {
          display: grid;
          grid-column: 1 / -1;
          gap: 10px;
          border-top: 1px solid var(--nexora-border);
          margin-top: 2px;
          padding-top: 12px;
        }

        .settings-social-links-title {
          color: var(--nexora-text);
          font-size: 12px;
          font-weight: 900;
        }

        .settings-social-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 10px;
        }

        .settings-label {
          color: var(--nexora-subtle);
          font-size: 11px;
          font-weight: 700;
          letter-spacing: 0.02em;
          text-transform: uppercase;
        }

        .settings-label-with-tooltip {
          display: inline-flex;
          align-items: center;
          gap: 4px;
          overflow: visible !important;
          text-overflow: clip !important;
          white-space: nowrap;
        }

        .settings-tooltip {
          position: relative;
          display: inline-flex;
          flex-shrink: 0;
        }

        .settings-tooltip-trigger {
          display: inline-flex;
          width: 16px;
          height: 16px;
          align-items: center;
          justify-content: center;
          border: 0;
          background: transparent;
          padding: 0;
          color: var(--nexora-brand);
          cursor: help;
        }

        .settings-tooltip-trigger .bi {
          font-size: 12px;
          line-height: 1;
        }

        .settings-tooltip-content {
          position: absolute;
          bottom: calc(100% + 8px);
          left: 50%;
          z-index: 20;
          display: none;
          width: max-content;
          max-width: min(320px, calc(100vw - 32px));
          border: 1px solid rgba(255, 255, 255, 0.12);
          border-radius: 10px;
          background: #0b1220;
          padding: 10px 12px;
          color: #fff;
          font-size: 11px;
          font-weight: 500;
          letter-spacing: normal;
          line-height: 1.5;
          text-align: left;
          text-transform: none;
          white-space: normal;
          overflow-wrap: anywhere;
          box-shadow: 0 10px 24px rgba(8, 31, 73, 0.24);
          transform: translateX(-50%);
        }

        .settings-tooltip-content::after {
          position: absolute;
          bottom: -6px;
          left: 50%;
          width: 10px;
          height: 10px;
          border-right: 1px solid rgba(255, 255, 255, 0.12);
          border-bottom: 1px solid rgba(255, 255, 255, 0.12);
          background: #0b1220;
          content: "";
          transform: translateX(-50%) rotate(45deg);
        }

        .settings-tooltip:hover .settings-tooltip-content,
        .settings-tooltip:focus-within .settings-tooltip-content {
          display: block;
        }

        .settings-input,
        .settings-select,
        .settings-textarea {
          width: 100%;
          border: 1px solid var(--nexora-border);
          border-radius: 9px;
          background: #fff;
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 600;
          outline: none;
        }

        .settings-input,
        .settings-select {
          min-height: 42px;
          padding: 0 12px;
        }

        .settings-textarea {
          min-height: 92px;
          padding: 11px 12px;
          line-height: 1.5;
          resize: vertical;
        }

        .settings-input:focus,
        .settings-select:focus,
        .settings-textarea:focus {
          border-color: rgba(70, 72, 216, 0.42);
          box-shadow: 0 0 0 3px rgba(70, 72, 216, 0.1);
        }

        .phone-input-shell {
          display: flex;
          width: 100%;
          min-height: 42px;
          overflow: hidden;
          align-items: center;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: #fff;
          transition: border-color 0.2s, box-shadow 0.2s;
        }

        .phone-input-shell:focus-within {
          border-color: rgba(0, 184, 115, 0.9);
          box-shadow: 0 0 0 3px rgba(0, 184, 115, 0.12);
        }

        .settings-business-grid .phone-input-shell {
