                  <div class="disp-stat" style="--accent:var(--nexora-electric)"><div class="disp-num" data-fs-ready>0</div><div class="disp-lbl"><i class="bi bi-cash-coin" aria-hidden="true"></i> Ready to pay</div></div>
                  <div class="disp-stat" style="--accent:var(--nexora-brand)"><div class="disp-num" data-fs-done>0</div><div class="disp-lbl"><i class="bi bi-receipt" aria-hidden="true"></i> Tickets today</div></div>
                  <div class="disp-stat" style="--accent:var(--nexora-success)"><div class="disp-num" data-fs-rev>$0</div><div class="disp-lbl"><i class="bi bi-cash-stack" aria-hidden="true"></i> Revenue today</div></div>
