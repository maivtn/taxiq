          /* ═══════════ 📅 APPOINTMENTS ═══════════ */
          var appointmentStore = window.NEXORA_APPOINTMENTS_STORE;
          var BOOKINGS = [];
          function posServiceDisplayName(value) {
            return String(value == null ? '' : value).replace(/^\s*[^\wÀ-ỹ]+/i, '').trim();
          }
          function posBookingClock(date) {
            var hour = date.getHours();
            return (hour % 12 || 12) + ':' + String(date.getMinutes()).padStart(2, '0') + ' ' + (hour >= 12 ? 'PM' : 'AM');
          }
          function posBookingRelativeDay(start) {
            var key = String(start || '').slice(0, 10);
            var today = new Date().toISOString().slice(0, 10);
            var tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            if (key === today) return 'today';
            if (key === tomorrow.toISOString().slice(0, 10)) return 'tomorrow';
            return 'future';
          }
          function posBookingById(id) {
            return BOOKINGS.find(function (booking) { return String(booking.id) === String(id); }) || null;
          }
          function posBookingView(record) {
            var names = record.serviceNames || [];
            var serviceLabels = names.map(function (name, index) {
              var service = salonData.findService(salonCatalog, (record.serviceIds || [])[index] || name);
              return service ? service.name : posServiceDisplayName(name);
            });
            if (!serviceLabels.length) {
              serviceLabels = (record.serviceIds || []).map(function (id) {
                var service = salonData.findService(salonCatalog, id);
                return service ? service.name : posServiceDisplayName(id);
              });
            }
            return Object.assign({}, record, {
              start: record.startAt,
              end: record.endAt,
              name: record.customerName || 'Guest',
              phone: record.phone || '',
              source: record.source || 'front-desk',
              techId: record.technicianId,
              techName: record.technicianName || '',
              svc: serviceLabels.join(' + '),
              serviceDetails: (Array.isArray(record.serviceDetails) ? record.serviceDetails : names.map(function (name, index) {
                var service = salonData.findService(salonCatalog, (record.serviceIds || [])[index] || name);
                return service ? { id: service.id, name: posServiceDisplayName(service.name), price: service.price, durationMin: service.durationMin } : { name: posServiceDisplayName(name), price: null, durationMin: null };
              })).map(function (detail) {
                return Object.assign({}, detail || {}, { name: posServiceDisplayName(detail && detail.name) });
              }),
              time: record.startAt ? posBookingClock(new Date(record.startAt)) : '',
              day: posBookingRelativeDay(record.startAt),
              eta: record.metadata && record.metadata.eta ? record.metadata.eta : null
            });
          }
          function reloadAppointmentSnapshot() {
            BOOKINGS = appointmentStore.loadAll(null, salonCatalog).filter(function (record) {
              return record.status !== 'cancelled' && record.startAt && record.endAt;
            }).map(posBookingView);
          }
          function updateAppointmentMetadata(id, metadataPatch) {
            var booking = posBookingById(id);
            if (!booking) return null;
            var result = appointmentStore.update(id, { metadata: Object.assign({}, booking.metadata || {}, metadataPatch || {}) }, null, salonCatalog);
            if (!result.ok) { toast(result.error.message, 'error'); return null; }
            reloadAppointmentSnapshot();
            renderFloor();
            return posBookingById(id);
          }
          reloadAppointmentSnapshot();
          rehydrateOperationalTickets();
          appointmentStore.subscribe(function () {
            rebuildSalonCatalogViews();
            reloadAppointmentSnapshot();
            rehydrateOperationalTickets();
            renderFloor();
          }, window);
          window.addEventListener('storage', function (event) {
            if (!event || event.key !== salonData.STORAGE_KEY) return;
            rebuildSalonCatalogViews();
            reloadAppointmentSnapshot();
            rehydrateOperationalTickets();
            renderManagement();
            renderClock();
            renderFloor();
          });
          /* ═══════════ 💬 SMS CAMPAIGNS (ported from nexora-sms-dashboard) ═══════════ */
          var PRICE_PER_SMS = 0.025;   // $ per message part
