          box-shadow: 0 0 0 4px rgba(220, 38, 38, .14);
        }

        .owner-button.is-danger:hover {
          background: #b91c1c;
          color: #fff;
        }

        .owner-button.is-soft {
          border-color: rgba(245, 158, 11, .28);
          background: rgba(245, 158, 11, .08);
          color: #945500;
        }

        .save-status {
          margin-right: auto;
          color: var(--nexora-subtle);
          font-size: 12px;
          font-weight: 700;
        }

        .info-list {
          display: grid;
          gap: 10px;
          margin: 0;
          padding: 0;
          list-style: none;
        }

        .info-item {
          display: grid;
          grid-template-columns: 30px minmax(0, 1fr);
          gap: 10px;
          align-items: start;
          border: 1px solid var(--nexora-rule);
          border-radius: 8px;
          background: #fbfcff;
          padding: 12px;
        }

        .info-mark {
          display: inline-flex;
          width: 30px;
          height: 30px;
          align-items: center;
          justify-content: center;
          border-radius: 8px;
          background: #eafaf3;
          color: var(--nexora-success);
        }

        .info-mark.is-warn {
          background: #fff7e8;
          color: var(--nexora-warning);
        }

        .info-mark.is-blue {
          background: #eef6ff;
          color: var(--nexora-electric);
        }

        .info-mark i {
          width: 16px;
          height: 16px;
        }

        .info-title {
          margin: 0;
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 850;
          line-height: 18px;
        }

        .info-copy {
          margin: 3px 0 0;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 500;
          line-height: 18px;
        }

        .status-pill {
          display: inline-flex;
          min-height: 26px;
          align-items: center;
          border-radius: 8px;
          background: rgba(0, 184, 115, .1);
          padding: 0 10px;
          color: var(--nexora-success);
          font-size: 11px;
          font-weight: 400;
          line-height: 16px;
          white-space: nowrap;
        }

        .status-pill.is-review {
          background: rgba(245, 158, 11, .12);
          color: #945500;
        }

        .document-list {
          display: grid;
          gap: 10px;
        }

        .document-row {
          display: grid;
          grid-template-columns: 34px minmax(0, 1fr) auto;
          gap: 10px;
          align-items: center;
          border: 1px solid var(--nexora-rule);
          border-radius: 8px;
          background: #fff;
          padding: 12px;
        }

        .document-row i {
          width: 18px;
          height: 18px;
          color: var(--nexora-brand);
        }

        .document-title {
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 850;
        }

        .document-meta {
          margin-top: 2px;
          color: var(--nexora-subtle);
          font-size: 12px;
          font-weight: 600;
        }

        .link-box {
          display: grid;
          grid-template-columns: minmax(0, 1fr) auto;
          gap: 10px;
          align-items: center;
        }

        .terms-list {
          display: grid;
          gap: 10px;
        }

        .terms-row {
          display: grid;
          grid-template-columns: 20px minmax(0, 1fr) auto;
          gap: 12px;
          align-items: center;
          border: 1px solid var(--nexora-rule);
          border-radius: 8px;
          background: #fff;
          padding: 12px;
        }

        .terms-row input {
          width: 18px;
          height: 18px;
          accent-color: var(--nexora-brand);
        }

        .terms-title {
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 850;
        }

        .terms-meta {
          margin-top: 2px;
          color: var(--nexora-subtle);
          font-size: 12px;
          font-weight: 600;
        }

        .mini-metrics {
          display: grid;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: 10px;
        }

        .mini-metric {
          border: 1px solid var(--nexora-rule);
          border-radius: 8px;
          background: #fbfcff;
          padding: 12px;
        }

        .metric-label {
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 800;
        }

        .metric-value {
          margin-top: 6px;
          color: var(--nexora-text);
          font-size: 22px;
          font-weight: 900;
          line-height: 28px;
        }

        .sub-account-toolbar {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 12px;
          flex-wrap: wrap;
          margin-bottom: 14px;
        }

        .booking-view-switch {
          display: inline-flex;
          width: max-content;
          max-width: 100%;
          flex-shrink: 0;
          align-items: center;
          gap: 4px;
          height: 36px;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: var(--nexora-surface-muted);
          overflow-x: auto;
          overflow-y: hidden;
          padding: 3px;
          scrollbar-width: none;
        }

        .booking-view-switch::-webkit-scrollbar {
          display: none;
        }

        .booking-view-button {
          display: inline-flex;
          width: auto;
          flex: 0 0 auto;
          height: 28px;
          min-height: 28px;
          align-items: center;
          justify-content: center;
          gap: 6px;
          border: 0;
          border-radius: 8px;
          background: transparent;
          padding: 0 10px;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 800;
          white-space: nowrap;
          cursor: pointer;
          transition: background 0.2s, color 0.2s, box-shadow 0.2s;
        }

        .booking-view-button i {
          width: 14px;
          height: 14px;
        }

        .booking-view-button.is-active {
          background: #fff;
          color: var(--nexora-brand);
          box-shadow: var(--nexora-card-shadow);
        }

        .sub-account-panel[hidden] {
          display: none;
        }

        .filter-row {
          display: grid;
          grid-template-columns: minmax(220px, 1fr) repeat(2, minmax(140px, 180px));
          gap: 10px;
          margin-bottom: 12px;
        }

        .table-shell {
          overflow-x: auto;
          border: 1px solid var(--nexora-rule);
          border-radius: 8px;
          background: #fff;
        }

        .table-responsive {
          display: block;
          width: 100%;
          max-width: 100%;
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
        }

        .owner-table {
          width: 100%;
          min-width: 760px;
          border-collapse: collapse;
        }

        .owner-table th,
        .owner-table td {
          border-bottom: 1px solid var(--nexora-rule);
          padding: 12px;
          text-align: left;
          vertical-align: middle;
        }

        .owner-table th {
          background: #fbfcff;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 900;
          text-transform: uppercase;
        }

        .owner-table tr:last-child td {
          border-bottom: 0;
        }

        .identity-cell {
          display: flex;
          align-items: center;
          gap: 10px;
          min-width: 0;
        }

        .mini-avatar {
          display: inline-flex;
          width: 34px;
          height: 34px;
          flex: 0 0 auto;
          align-items: center;
          justify-content: center;
          border-radius: 8px;
          background: #eef2ff;
          color: var(--nexora-brand);
          font-size: 12px;
          font-weight: 900;
        }

        .mini-avatar i {
          width: 16px;
          height: 16px;
        }

        .cell-title {
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 850;
          line-height: 18px;
        }

        .cell-meta {
          margin-top: 2px;
          color: var(--nexora-subtle);
          font-size: 12px;
          font-weight: 600;
          line-height: 17px;
        }

        .role-badge {
          display: inline-flex;
          min-height: 25px;
          align-items: center;
          border-radius: 8px;
          background: #eef6ff;
          padding: 0 9px;
          color: var(--nexora-electric);
          font-size: 11px;
          font-weight: 400;
          line-height: 16px;
          white-space: nowrap;
        }

        .status-pill.is-pending {
          background: rgba(245, 158, 11, .12);
          color: #945500;
        }

        .status-pill.is-disabled {
          background: var(--nexora-surface-muted);
          color: var(--nexora-subtle);
        }

        .table-actions {
          display: inline-flex;
          align-items: center;
          gap: 5px;
          flex-wrap: wrap;
        }

        .icon-action {
          display: inline-flex;
          min-height: 30px;
          align-items: center;
          justify-content: center;
          gap: 5px;
          border: 1px solid var(--nexora-border);
          border-radius: 8px;
          background: #fff;
          padding: 0 8px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 850;
          text-decoration: none;
          cursor: pointer;
          white-space: nowrap;
        }

        .icon-action:hover {
          border-color: rgba(70, 72, 216, .35);
          color: var(--nexora-brand);
        }

        .icon-action:disabled {
          border-color: var(--nexora-rule);
          background: var(--nexora-surface-muted);
          color: var(--nexora-subtle);
          cursor: not-allowed;
          opacity: .58;
        }

        .icon-action:disabled:hover {
          border-color: var(--nexora-rule);
          color: var(--nexora-subtle);
          transform: none;
        }

        .icon-action i {
          width: 11px;
          height: 11px;
          display: block;
          flex: 0 0 auto;
        }

        .icon-action svg {
          width: 11px;
          height: 11px;
          display: block;
          flex: 0 0 auto;
        }

        .owner-table.is-account-table [data-open-modal="sub-account-detail-modal"] {
          border-color: rgba(43, 89, 255, .22);
          background: #eef6ff;
          color: #155eef;
        }

        .owner-table.is-account-table [data-open-modal="edit-sub-account-modal"] {
          border-color: rgba(70, 72, 216, .22);
          background: #f1f2ff;
          color: var(--nexora-brand);
        }

        .owner-table.is-account-table [data-open-deactivate-modal] {
          border-color: rgba(180, 35, 24, .22);
          background: #fff1f1;
          color: #b42318;
        }

        .owner-table.is-account-table [data-open-reset-password-modal] {
          border-color: rgba(245, 158, 11, .28);
          background: #fff7e8;
          color: #945500;
        }

        .owner-table.is-account-table [data-open-resend-email-modal] {
          border-color: rgba(15, 118, 110, .22);
          background: #ecfdf8;
          color: #0f766e;
        }

        .owner-table.is-account-table [data-sub-account-action="activate"] {
          border-color: rgba(8, 169, 82, .24);
          background: #eafaf3;
          color: #087a55;
        }

        .owner-table.is-role-table a.icon-action[href^="role-details.html"] {
          border-color: rgba(70, 72, 216, .22);
          background: #f1f2ff;
          color: var(--nexora-brand);
        }

        .owner-table.is-role-table [data-delete-role]:not(:disabled) {
          border-color: rgba(180, 35, 24, .22);
          background: #fff1f1;
          color: #b42318;
        }

        .sub-account-action-status {
          display: none;
          align-items: center;
          min-height: 34px;
          margin-top: 10px;
          border: 1px solid rgba(70, 72, 216, .18);
          border-radius: 8px;
          background: rgba(70, 72, 216, .07);
          padding: 8px 11px;
          color: var(--nexora-brand);
          font-size: 12px;
          font-weight: 800;
          line-height: 18px;
        }

        .sub-account-action-status:not(:empty) {
          display: flex;
        }

        .permission-grid {
          display: grid;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: 10px;
        }

        .permission-item {
          border: 1px solid var(--nexora-rule);
          border-radius: 8px;
          background: #fbfcff;
          padding: 11px;
        }

        .permission-title {
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 850;
        }

        .permission-copy {
          margin-top: 4px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 600;
          line-height: 18px;
        }

        .sidebar-menu-list {
          display: grid;
          gap: 10px;
        }

        .sidebar-menu-row {
          display: grid;
          grid-template-columns: 38px minmax(0, 1fr) auto;
          gap: 12px;
          align-items: center;
          border: 1px solid var(--nexora-rule);
          border-radius: 8px;
          background: #fff;
          padding: 12px;
        }

        .sidebar-menu-row.is-locked {
          background: #fbfcff;
        }

        .sidebar-menu-icon {
          display: inline-flex;
          width: 38px;
          height: 38px;
          align-items: center;
          justify-content: center;
          border-radius: 8px;
          background: #eef6ff;
          color: var(--nexora-electric);
        }

        .sidebar-menu-icon i {
          width: 17px;
          height: 17px;
        }

        .sidebar-menu-copy {
          min-width: 0;
        }

        .sidebar-menu-title {
          display: block;
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 850;
          line-height: 18px;
        }

        .sidebar-menu-subtitle {
          display: block;
          margin-top: 2px;
          color: var(--nexora-subtle);
          font-size: 12px;
          font-weight: 600;
          line-height: 17px;
        }

        .sidebar-menu-toggle {
          position: relative;
          display: inline-flex;
          flex: 0 0 auto;
          align-items: center;
          cursor: pointer;
        }

        .sidebar-menu-toggle input {
          position: absolute;
          width: 1px;
          height: 1px;
          opacity: 0;
          pointer-events: none;
        }

        .sidebar-menu-toggle-track {
          position: relative;
          display: inline-flex;
          width: 46px;
          height: 26px;
          align-items: center;
          border-radius: 999px;
          background: #dfe5ef;
          transition: background .16s, box-shadow .16s;
        }

        .sidebar-menu-toggle-thumb {
          position: absolute;
          left: 3px;
          width: 20px;
          height: 20px;
          border-radius: 50%;
          background: #fff;
          box-shadow: 0 2px 6px rgba(13, 18, 33, .18);
          transition: transform .16s;
        }

        .sidebar-menu-toggle input:checked + .sidebar-menu-toggle-track {
          background: var(--nexora-brand);
          box-shadow: 0 0 0 4px rgba(70, 72, 216, .12);
        }

        .sidebar-menu-toggle input:checked + .sidebar-menu-toggle-track .sidebar-menu-toggle-thumb {
          transform: translateX(20px);
        }

        .sidebar-menu-toggle input:disabled + .sidebar-menu-toggle-track {
          background: #d9f7e9;
          box-shadow: none;
          opacity: .9;
          cursor: not-allowed;
        }

        .sidebar-menu-lock-note {
          display: inline-flex;
          min-height: 26px;
          align-items: center;
          border-radius: 8px;
          background: rgba(0, 184, 115, .1);
          padding: 0 10px;
          color: var(--nexora-success);
          font-size: 11px;
          font-weight: 800;
          white-space: nowrap;
        }

        .filter-row.is-account-filters {
          grid-template-columns: minmax(180px, 260px) repeat(2, minmax(120px, 160px));
        }

        .sub-account-filter-bar {
          display: grid;
          grid-template-columns: minmax(0, 1fr) auto;
          align-items: end;
          gap: 10px;
          margin-bottom: 12px;
        }

        .sub-account-filter-bar .filter-row {
          margin-bottom: 0;
        }

        .sub-account-filter-bar .owner-button {
          min-height: 42px;
        }

        .log-filter-menu {
          position: relative;
          display: flex;
          align-items: flex-start;
          justify-content: flex-end;
          margin-bottom: 12px;
        }

        .log-filter-toggle {
          width: auto;
          min-height: 38px;
          flex: 0 0 auto;
          align-self: flex-start;
        }

        .log-filter-toggle.is-active {
          border-color: rgba(70, 72, 216, .35);
          background: #f8faff;
          color: var(--nexora-brand);
        }

        .log-filter-dropdown[hidden] {
          display: none;
        }

        .log-filter-dropdown {
          position: absolute;
          top: calc(100% + 8px);
          right: 0;
          z-index: 12;
          width: min(100%, 900px);
          border: 1px solid var(--nexora-border);
          border-radius: 8px;
          background: #fff;
          box-shadow: 0 18px 40px rgba(8, 31, 73, .16);
          padding: 12px;
        }

        .log-filter-dropdown .filter-row {
          margin-bottom: 0;
        }

        .filter-row.is-log-filters {
          display: flex;
          align-items: end;
          flex-wrap: wrap;
        }

        .filter-row.is-log-filters > .form-field {
          flex: 1 1 180px;
        }

        .log-filter-pair {
          display: flex;
          flex: 1 1 300px;
          gap: 10px;
          min-width: 260px;
        }

        .log-filter-pair .form-field {
          flex: 1 1 0;
        }

        .owner-table.is-account-table {
          min-width: 980px;
        }

        .owner-table.is-role-table {
          min-width: 860px;
        }

        .owner-table.is-log-table {
          min-width: 1160px;
        }

        .owner-table.is-log-table td {
          color: var(--nexora-text);
          font-size: 14px;
          font-weight: 650;
          line-height: 20px;
        }

        .owner-table.is-log-table .credits-history-date {
          font-size: 14px;
          line-height: 18px;
        }

        .owner-table.is-log-table .credits-history-date small {
          font-size: 11px;
          line-height: 14px;
        }

        .inline-workflow-grid {
          display: grid;
          grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
          gap: 12px;
          margin-top: 14px;
        }

        .workflow-panel {
          border: 1px solid var(--nexora-rule);
          border-radius: 8px;
          background: #fff;
          padding: 14px;
        }

        .workflow-title-row {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 10px;
          margin-bottom: 12px;
        }

        .workflow-title {
          margin: 0;
          color: var(--nexora-text);
          font-size: 14px;
          font-weight: 900;
          line-height: 20px;
        }

        .workflow-copy {
          margin: 4px 0 0;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 600;
          line-height: 18px;
        }

        .preview-box {
          display: grid;
          gap: 6px;
          margin-top: 12px;
          border: 1px dashed rgba(70, 72, 216, .32);
          border-radius: 8px;
          background: #f8faff;
          padding: 12px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 700;
          line-height: 18px;
        }

        .detail-list {
          display: grid;
          gap: 9px;
        }

        .detail-row {
          display: grid;
          grid-template-columns: minmax(96px, 118px) minmax(0, 1fr);
          align-items: flex-start;
          justify-content: start;
          column-gap: 10px;
          border-bottom: 1px solid var(--nexora-rule);
          padding-bottom: 9px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 700;
          line-height: 18px;
        }

        .detail-row:last-child {
          border-bottom: 0;
          padding-bottom: 0;
        }

        .detail-value {
          color: var(--nexora-text);
          font-weight: 850;
          text-align: left;
          overflow-wrap: anywhere;
        }

        .edit-account-form {
          display: grid;
          gap: 14px;
        }

        .edit-account-row {
          display: grid;
          grid-template-columns: 140px minmax(0, 1fr);
          gap: 16px;
          align-items: center;
        }

        .edit-account-readonly {
          color: var(--nexora-text);
          font-size: 14px;
          font-weight: 850;
          line-height: 20px;
          overflow-wrap: anywhere;
        }

        .phone-input-group {
          display: grid;
          grid-template-columns: 74px minmax(0, 1fr);
          gap: 0;
        }

        .phone-input-group .field-select {
          border-radius: 8px 0 0 8px;
          border-right: 0;
          background-position: right 12px center;
          padding-left: 10px;
          padding-right: 30px;
        }

        .phone-input-group .field-input {
          border-radius: 0 8px 8px 0;
        }

        .module-chip-list {
          display: flex;
          flex-wrap: wrap;
          gap: 6px;
          margin-top: 10px;
        }

        .module-chip {
          display: inline-flex;
          min-height: 26px;
          align-items: center;
          border-radius: 8px;
          background: #eef6ff;
          padding: 0 9px;
          color: var(--nexora-electric);
          font-size: 12px;
          font-weight: 850;
        }

        .role-toolbar {
          display: flex;
          align-items: center;
          justify-content: flex-end;
          gap: 10px;
          margin-bottom: 12px;
        }

        .owner-modal[hidden] {
          display: none;
        }

        .owner-modal {
          position: fixed;
          inset: 0;
          z-index: 90;
          display: grid;
          place-items: center;
          padding: 24px;
        }

        .owner-modal-backdrop {
          position: absolute;
          inset: 0;
          border: 0;
          background: rgba(13, 18, 33, .48);
          cursor: pointer;
        }

        .owner-modal-card {
          position: relative;
          z-index: 1;
          width: min(100%, 720px);
          max-height: min(760px, calc(100vh - 48px));
          overflow: hidden;
          border: 1px solid var(--nexora-border);
          border-radius: 8px;
          background: #fff;
          box-shadow: 0 24px 70px rgba(13, 18, 33, .24);
        }

        .owner-modal-card.is-wide {
          width: min(100%, 860px);
        }

        .owner-modal-head {
          display: flex;
          align-items: flex-start;
          justify-content: space-between;
          gap: 14px;
          border-bottom: 1px solid var(--nexora-rule);
          padding: 18px;
        }

        .modal-title {
          margin: 0;
          color: var(--nexora-text);
          font-size: 18px;
          font-weight: 900;
          line-height: 24px;
        }

        .modal-copy {
          margin: 4px 0 0;
          color: var(--nexora-muted);
          font-size: 13px;
          font-weight: 600;
          line-height: 19px;
        }

        .owner-modal-close {
          display: inline-flex;
          width: 34px;
          height: 34px;
          flex: 0 0 auto;
          align-items: center;
          justify-content: center;
          border: 1px solid var(--nexora-border);
          border-radius: 8px;
          background: #fff;
          color: var(--nexora-muted);
          cursor: pointer;
        }

        .owner-modal-close:hover {
          border-color: rgba(70, 72, 216, .35);
          color: var(--nexora-brand);
        }

        .owner-modal-close i {
          width: 16px;
          height: 16px;
        }

        .owner-modal-body {
          max-height: calc(100vh - 210px);
          overflow-y: auto;
          padding: 18px;
        }

        .owner-modal-footer {
          display: flex;
          align-items: center;
          justify-content: flex-end;
          gap: 10px;
          border-top: 1px solid var(--nexora-rule);
          padding: 14px 18px;
        }

        /* SweetAlert2 follows the Owner Settings design system. */
        .swal2-popup {
          border-radius: 16px !important;
          box-shadow: 0 24px 60px rgba(8, 16, 34, .28) !important;
          font-family: Inter, system-ui, sans-serif !important;
        }

        .swal2-title {
          color: var(--nexora-text) !important;
          font-size: 19px !important;
          font-weight: 900 !important;
          line-height: 26px !important;
        }

        .swal2-html-container {
          color: var(--nexora-muted) !important;
          font-size: 14px !important;
          font-weight: 600 !important;
          line-height: 21px !important;
        }

        .swal2-actions {
          gap: 10px !important;
        }

        .swal2-styled.swal2-confirm,
        .swal2-styled.swal2-cancel {
          border-radius: 8px !important;
          font-size: 14px !important;
          font-weight: 850 !important;
          padding: 10px 20px !important;
        }

        .swal2-styled.swal2-confirm {
          box-shadow: 0 12px 26px rgba(70, 72, 216, .24) !important;
        }

        .swal2-styled.swal2-cancel {
          background: #fff !important;
          border: 1px solid var(--nexora-border) !important;
          color: var(--nexora-text) !important;
        }

        .swal2-styled:focus {
          box-shadow: none !important;
        }

        @media (max-width: 900px) {
          .page-heading {
            flex-direction: column;
            align-items: stretch;
          }

          .owner-status {
            width: fit-content;
          }

          .page-tabs {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 4px;
            margin-bottom: 14px;
          }

          .page-tab {
            width: 100%;
            min-width: 0;
            min-height: 48px;
            flex-direction: column;
            justify-content: center;
            gap: 3px;
            border-radius: 10px;
            padding: 5px 2px;
            font-size: 10px;
            line-height: 1.12;
            text-align: center;
            box-shadow: none;
          }

          .page-tab > span:last-child {
            display: block;
            max-width: 100%;
            overflow-wrap: anywhere;
          }

          .settings-grid {
            grid-template-columns: 1fr;
          }

          .filter-row,
          .filter-row.is-account-filters,
          .filter-row.is-log-filters,
          .sub-account-filter-bar,
          .edit-account-row,
          .permission-grid,
          .inline-workflow-grid {
            grid-template-columns: 1fr;
          }

          .filter-row.is-account-filters {
            display: flex;
            flex-wrap: nowrap;
            overflow-x: auto;
            overflow-y: hidden;
            padding-bottom: 2px;
            scrollbar-width: none;
          }

          .filter-row.is-account-filters .form-field {
            flex: 0 0 150px;
          }

          .filter-row.is-account-filters::-webkit-scrollbar {
            display: none;
          }

          .table-responsive {
            overflow-x: visible;
            border: 0;
            background: transparent;
          }

          .table-responsive .owner-table {
            display: block;
            width: 100%;
            min-width: 0;
            border-collapse: separate;
            border-spacing: 0 10px;
          }

          .table-responsive .owner-table thead {
            display: none;
          }

          .table-responsive .owner-table tbody,
          .table-responsive .owner-table tr,
          .table-responsive .owner-table td {
            display: block;
            width: 100%;
          }

          .table-responsive .owner-table tbody {
            border: 0;
          }

          .table-responsive .owner-table tr {
            margin-bottom: 10px;
            border: 1px solid var(--nexora-rule);
            border-radius: 8px;
            background: #fff;
            overflow: hidden;
          }

          .table-responsive .owner-table tr:last-child {
            margin-bottom: 0;
          }

          .table-responsive .owner-table td {
            position: relative;
            border-bottom: 1px solid var(--nexora-rule);
            padding: 10px 12px 10px 128px;
            min-height: 40px;
            white-space: normal;
          }

          .table-responsive .owner-table tr:last-child td {
            border-bottom: 1px solid var(--nexora-rule);
          }

          .table-responsive .owner-table td::before {
            content: attr(data-label) ":";
            position: absolute;
            top: 10px;
            left: 12px;
            width: 104px;
            display: block;
            color: var(--nexora-muted);
            font-size: 11px;
            font-weight: 900;
            line-height: 16px;
            text-transform: uppercase;
          }

          .table-responsive .owner-table td:last-child {
            border-bottom: 0;
          }

          .table-responsive .owner-table tr:last-child td:last-child {
            border-bottom: 0;
          }

          .table-responsive .owner-table .table-actions {
            justify-content: flex-start;
          }
        }

        @media (max-width: 560px) {

          .form-grid,
          .mini-metrics {
            grid-template-columns: 1fr;
          }

          .section-head,
          .section-body,
          .action-row {
            padding: 14px;
          }

          .document-row,
          .terms-row,
          .link-box,
          .owner-modal-footer {
            grid-template-columns: 1fr;
          }

          .owner-modal {
            padding: 14px;
          }

          .owner-modal-body {
            max-height: calc(100vh - 190px);
          }

          .document-row i {
            display: none;
          }

          .owner-button {
            width: 100%;
          }

          .save-status {
            width: 100%;
          }

          .log-filter-menu {
            flex-direction: column;
            align-items: flex-start;
            justify-content: flex-start;
          }

          .log-filter-menu .owner-button {
            width: auto;
            min-height: 38px;
            flex: 0 0 auto;
          }

          .log-filter-dropdown {
            position: static;
            width: 100%;
            margin-top: 8px;
          }

          .booking-view-switch {
            width: max-content;
            max-width: 100%;
            flex-direction: row;
            height: auto;
          }

          .booking-view-button {
            width: auto;
            flex: 0 0 auto;
          }
        }
