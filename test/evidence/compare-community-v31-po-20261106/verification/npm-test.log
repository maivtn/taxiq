              <!-- Campaign composer -->
              <div class="sms-modal" data-sms-modal role="dialog" aria-modal="true" aria-label="Tạo SMS Campaign">
                <div class="sms-dialog">
                  <div class="sms-mhead">
                    <h3><i class="bi bi-stars" aria-hidden="true"></i> Tạo SMS Campaign</h3>
                    <button class="pos-icon-btn" type="button" data-sms-close aria-label="Đóng"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                  </div>
                  <div class="sms-mbody">
                    <div class="sms-step">
                      <span class="sms-step-lbl">Bước 1 — Chọn nhóm khách</span>
                      <div class="seg-grid" data-seg-grid></div>
                    </div>

                    <div class="sms-step">
                      <span class="sms-step-lbl">Bước 2 — Chọn template hoặc tự viết</span>
                      <div class="tpl-list" data-tpl-list></div>
                    </div>

                    <div class="sms-step">
                      <span class="sms-step-lbl">Bước 3 — Soạn nội dung SMS</span>
                      <div class="sms-composer">
                        <div class="sms-toolbar" data-tag-toolbar>
                          <span style="font-size:12px;font-weight:700;color:var(--nexora-subtle)">Chèn:</span>
                          <button class="tag-btn" type="button" data-tag="{TenKhach}"><i class="bi bi-person" aria-hidden="true"></i> Tên khách</button>
