        #nx-campaign-root .cost-preview-buy-button { display:inline-flex; align-items:center; justify-content:center; flex-shrink:0; gap:6px; border:1px solid rgba(220,38,38,.35); border-radius:8px; background:#fff; padding:8px 11px; color:#b91c1c; font-size:12px; font-weight:800; white-space:nowrap; }
