    <body>
      <div class="shell">
        <aside class="sidebar" aria-label="Dashboard sidebar"></aside>

        <div class="app-area">
          <header class="header"></header>

          <main class="content" aria-label="POS content">
            <div class="page-heading">
              <div class="page-title-row">
                <h1 class="page-title">POS</h1>
                <span class="pos-chip pos-chip-gold"><i class="bi bi-award-fill" aria-hidden="true"></i> <span data-pos-mode-badge-text>Owner · Brian</span></span>
                <button class="pos-btn pos-btn-sm" type="button" data-pos-mode-open><i class="bi bi-shuffle" aria-hidden="true"></i> Đổi mode</button>
                <a class="pos-btn pos-btn-sm" href="https://pos-nexoratouch.vercel.app/mockups/phase1/kiosk.html" target="_blank" rel="noopener noreferrer"><i class="bi bi-tablet" aria-hidden="true"></i> Kiosk</a>
              </div>
              <p class="page-description">Bitcoin Nail Bar · Houston, TX — run the front desk: time clock, salon management, and appointments.</p>
              <div class="page-tabs" role="tablist" aria-label="POS sections">
                <button class="page-tab" type="button" role="tab" hidden data-pos-tab="checkin"><i class="bi bi-door-open" aria-hidden="true"></i> Check-in</button>
                <button class="page-tab is-active" type="button" role="tab" data-pos-tab="todaybooking"><i class="bi bi-calendar-event" aria-hidden="true"></i> Today Booking</button>
                <button class="page-tab" type="button" role="tab" data-pos-tab="tickets"><i class="bi bi-grid-1x2" aria-hidden="true"></i> Queue & Tech Assign</button>
                <button class="page-tab" type="button" role="tab" data-pos-tab="booking"><i class="bi bi-calendar-check" aria-hidden="true"></i> Booking</button>
                <button class="page-tab" type="button" role="tab" data-pos-tab="estimate"><i class="bi bi-calculator" aria-hidden="true"></i> Estimate</button>
                <button class="page-tab" type="button" role="tab" data-pos-tab="customers"><i class="bi bi-person-vcard" aria-hidden="true"></i> Customers</button>
                <button class="page-tab" type="button" role="tab" data-pos-tab="clock"><i class="bi bi-clock-history" aria-hidden="true"></i> Staff Clock</button>
                <button class="page-tab" type="button" role="tab" data-pos-tab="management"><i class="bi bi-building-gear" aria-hidden="true"></i> Management</button>
                <button class="page-tab" type="button" role="tab" data-pos-tab="printer"><i class="bi bi-printer" aria-hidden="true"></i> Printer Settings</button>
                <a class="page-tab" role="tab" href="pos-staff.html"><i class="bi bi-people" aria-hidden="true"></i> Staff</a>
              </div>
            </div>

            <div class="sms-modal" data-pos-mode-modal role="dialog" aria-modal="true" aria-labelledby="pos-mode-title" aria-hidden="true">
              <div class="sms-dialog pos-mode-dialog">
                <div class="sms-mhead">
                  <h2 id="pos-mode-title"><i class="bi bi-person-badge" aria-hidden="true"></i> Đổi mode POS</h2>
                  <button class="pos-icon-btn" type="button" data-pos-mode-close aria-label="Đóng"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                </div>
                <div class="sms-mbody">
                  <p class="pos-muted pos-mode-copy">Chọn tài khoản rồi nhập PIN để chuyển mode.</p>
                  <div class="pos-mode-roles" role="group" aria-label="Chọn vai trò POS">
                    <button class="pos-mode-role-card is-selected" type="button" aria-pressed="true" data-pos-role="owner">
                      <span class="pos-mode-role-avatar">B</span><span class="pos-mode-role-name">Brian</span><span class="pos-mode-role-label">Owner</span>
                    </button>
                    <button class="pos-mode-role-card" type="button" aria-pressed="false" data-pos-role="manager">
                      <span class="pos-mode-role-avatar">M</span><span class="pos-mode-role-name">Mia</span><span class="pos-mode-role-label">Manager</span>
                    </button>
                    <button class="pos-mode-role-card" type="button" aria-pressed="false" data-pos-role="frontdesk">
                      <span class="pos-mode-role-avatar">C</span><span class="pos-mode-role-name">Cindy</span><span class="pos-mode-role-label">Front Desk</span>
                    </button>
                  </div>
                  <label class="pos-inline-lbl" for="pos-mode-pin">PIN</label>
