        return iconWrap(node.key === 'business-tools' ? 'briefcase-business' : (TREE_ICONS[node.iconKey] || 'circle'));
      }

      function renderTree(nodes, depth) {
        var hidden = hiddenSidebarKeySet();
        return nodes.filter(function (node) { return !node.accountOnly && !hidden[node.key]; }).map(function (node) {
          var active = treeNodeIsActive(node);
          var label = ((depth === 0 || node.showIcon) && node.iconKey ? treeIcon(node) : '') + '<span class="shell-tree-label">' + esc(node.label) + '</span>' + (node.externalIndicator || node.newTab ? '<i class="sidebar-external-icon" data-lucide="arrow-up-right" aria-hidden="true"></i>' : '');
          var cls = (depth ? 'nav-subitem' : 'nav-item') + (node.shortcutTo ? ' shell-tree-shortcut' : '');
          if (node.toggleProducts) return '<button type="button" class="shell-products-toggle nav-parent' + (expandedGroups.products === true ? ' is-expanded' : '') + '" data-sidebar-products-toggle aria-expanded="' + (expandedGroups.products === true) + '" aria-controls="nexora-product-menu-community nexora-product-menu-booking nexora-product-menu-business-tools">' + label + CARET + '</button>';
          // Captions keep the PO's grouping while exposing links with the product menu.
          if (node.sectionLabel && node.children) return '<div class="shell-tree-section-label">' + esc(node.label) + '</div>' + renderTree(node.children, depth);
          if (node.children) {
            var open = expandedGroups[node.key] === true, id = 'nexora-subnav-' + node.key;
            var ancestor = groupIsActive(node, activeTab);
            return '<div class="shell-tree-branch' + (node.dividerBefore ? ' has-divider-before' : '') + '" data-depth="' + depth + '"' + (node.productMenu ? ' id="nexora-product-menu-' + esc(node.key) + '" data-product-menu' + (expandedGroups.products === true ? '' : ' hidden') : '') + '><div class="shell-tree-row">' +
              (node.href ? '<a class="' + cls + (active ? ' is-active' : '') + '" href="' + esc(node.href) + '"' + (active ? ' aria-current="page"' : '') + '>' + label + '</a>' : '') +
              '<button class="' + cls + ' nav-parent' + (open ? ' is-expanded' : '') + (ancestor ? ' is-active' : '') + '" type="button" data-sidebar-key="' + esc(node.key) + '" data-nav-group aria-expanded="' + open + '" aria-controls="' + id + '"' + (node.href ? ' aria-label="' + esc(node.label) + '"' : '') + '>' + (node.href ? '' : label) + CARET + '</button></div>' +
              '<div class="nav-subnav' + (open ? '' : ' is-collapsed') + '" id="' + id + '" data-nav-subnav><div class="nav-subnav-inner">' + renderTree(node.children, depth + 1) + '</div></div></div>';
          }
          if (node.linkPending) return '<button type="button" class="' + cls + '" data-shell-key="' + esc(node.key) + '">' + label + '</button>';
          if (node.availability === 'unavailable') return '<button type="button" class="' + cls + '" data-shell-key="' + esc(node.key) + '" disabled>' + label + '</button>';
          if (!node.href) return '';
          var native = !node.navContext && node.page === activePage && node.tab && node.href.split('?')[0] === (window.location.pathname || '').split('/').pop() && node.href.indexOf('&view=') === -1 && (typeof cfg.onNavigate === 'function' || typeof window.activateMainTab === 'function');
          return '<' + (native ? 'button type="button" data-shell-tab="' + esc(node.tab) + '"' : 'a href="' + esc(node.href) + '"' + (node.newTab ? ' target="_blank" rel="noopener noreferrer"' : '')) + ' class="' + cls + (active ? ' is-active' : '') + '" data-shell-key="' + esc(node.key) + '"' + (node.navContext ? ' data-shell-nav-context="' + esc(node.navContext) + '"' : '') + (!native && node.page && node.tab && node.href.indexOf('&view=') === -1 ? ' data-shell-active-tab="' + esc(node.tab) + '" data-shell-pages="' + esc(node.page) + '"' : '') + (active ? ' aria-current="page"' : '') + '>' + label + (node.availability === 'preview' ? '<small class="shell-preview-tag">PREVIEW</small>' : '') + '</' + (native ? 'button' : 'a') + '>';
        }).join('');
      }

      function renderNav() {
        if (treeNav) {
          var nodes = visibleNav().filter(function(node) { return node.key !== 'public-home'; });
          var supportKeys = ['news-library', 'support'];
          var supportNodes = nodes.filter(function(node) { return supportKeys.indexOf(node.key) !== -1; });
          return renderTree(nodes.filter(function(node) { return supportKeys.indexOf(node.key) === -1; }), 0) +
            (supportNodes.length ? '<div class="sidebar-section-label sidebar-support-title" id="nav-support-title">Support</div>' + renderTree(supportNodes, 0) : '');
        }
        return visibleNav().map(function (node) {
          if (node.type === 'divider') return '<div class="nav-divider"></div>';
          if (node.type === 'group') return renderGroup(node);
          return renderFlat(node);
        }).join('');
      }

