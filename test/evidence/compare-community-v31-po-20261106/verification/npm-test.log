              '<div class="pos-card soft"><div class="pos-kpi-label"><i class="bi bi-heart-fill" aria-hidden="true"></i> Tips today</div><div class="pos-kpi-value">' + money0(tipTot) + '</div><div class="pos-muted" style="font-size:12px">100% to techs, paid with payroll</div></div>' +
              '<div class="pos-card soft"><div class="pos-kpi-label"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Ready to pay</div><div class="pos-kpi-value">' + readyN + '</div><div class="pos-muted" style="font-size:12px">amount locked, waiting on a tap</div></div>' +
              '<div class="pos-card soft"><div class="pos-kpi-label"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> Missing method</div><div class="pos-kpi-value ' + (missN ? 'pos-warn-text' : '') + '">' + missN + '</div><div class="pos-muted" style="font-size:12px">no payout destination — held</div></div>' +
              '</div>' +
              (mgPayoutViewMode === 'card' ? cardsHtml : tableHtml) +
              '</div>';
          }

          function slugText(value) {
            return String(value || 'service').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'service';
          }

          function serviceCategoryLabel(service) {
            return String(service.categoryName || service.requiredSkill || 'Other services').trim() || 'Other services';
          }

          function serviceCategoryKey(name) {
            return String(name || 'Other services').toLowerCase().replace(/\s+/g, ' ').trim() || 'other services';
          }

          function serviceCategoryRows() {
            var seen = {};
            var rows = [];
            function ensureRow(name, category) {
              var cleanName = String(name || 'Other services').trim() || 'Other services';
              var key = serviceCategoryKey(cleanName);
              if (!seen[key]) {
                seen[key] = {
                  key: key,
                  id: category && category.id ? category.id : slugText(cleanName),
                  name: cleanName,
                  kind: category && category.kind ? category.kind : 'service',
                  active: !category || category.active !== false,
                  activeServices: 0,
                  totalServices: 0
                };
                rows.push(seen[key]);
              } else if (category) {
                seen[key].id = category.id || seen[key].id;
                seen[key].kind = category.kind || seen[key].kind;
                seen[key].active = category.active !== false;
              }
              return seen[key];
            }
            (salonCatalog.categories || []).forEach(function (category) {
              ensureRow(category.name, category);
            });
            salonCatalog.services.forEach(function (service) {
              var row = ensureRow(serviceCategoryLabel(service), {
                id: service.categoryId,
                kind: service.type === 'add-on' ? 'add-on' : 'service',
                active: true
              });
              row.totalServices += 1;
              if (service.active !== false) row.activeServices += 1;
            });
            return rows;
          }

          function serviceCategories() {
            return serviceCategoryRows().filter(function (row) {
              return row.active !== false;
            }).map(function (row) {
              return row.name;
            });
          }

          function groupedServicesByCategory(services) {
            var groups = [], seen = {};
            serviceCategoryRows().forEach(function (row) {
              if (row.active === false && !row.totalServices) return;
              seen[row.key] = { name: row.name, services: [], active: row.active };
              groups.push(seen[row.key]);
            });
            services.forEach(function (service) {
              var name = serviceCategoryLabel(service);
              var key = serviceCategoryKey(name);
              if (!seen[key]) {
                seen[key] = { name: name, services: [] };
                groups.push(seen[key]);
              }
              seen[key].services.push(service);
            });
            return groups;
          }

          function serviceSkillOptions(selected) {
            var skills = Array.from(new Set(SKILLS.concat(selected ? [selected] : []))).filter(Boolean);
            return '<option value="">— none —</option>' + skills.map(function (skill) {
              return '<option value="' + esc(skill) + '"' + (selected === skill ? ' selected' : '') + '>' + esc(skill) + '</option>';
            }).join('');
          }

          function serviceTypeOptions(selected) {
            return ['', 'service', 'add-on'].map(function (type) {
              var label = type || 'standard';
              return '<option value="' + esc(type) + '"' + (selected === type ? ' selected' : '') + '>' + esc(label) + '</option>';
            }).join('');
          }

          function serviceCategoryOptions(selected) {
            var current = String(selected || '').trim();
            var currentKey = serviceCategoryKey(current);
            var categories = serviceCategories();
            if (current && !categories.some(function (name) { return serviceCategoryKey(name) === currentKey; })) {
              categories = categories.concat(current);
            }
            return '<option value="">Choose category</option>' + categories.map(function (name) {
              return '<option value="' + esc(name) + '"' + (serviceCategoryKey(name) === currentKey ? ' selected' : '') + '>' + esc(name) + '</option>';
            }).join('');
          }

          function priceLabelForService(price) {
            if (price == null || price === '') return '';
            var n = Math.round(Number(price) * 100) / 100;
            return Number.isFinite(n) ? '$' + String(n).replace(/\.00$/, '') : '';
          }

          var serviceViewMode = DEFAULT_VIEW_MODE;
          var serviceCategoryManagerCollapsed = true;
          var serviceCollapsedCategories = {};
          var serviceModalId = null;
          var serviceModalMode = 'edit';
          var categoryModalKey = null;
          var categoryModalMode = 'edit';

          function resetServiceCategoryCollapses() {
            serviceCollapsedCategories = {};
            serviceCategoryManagerCollapsed = true;
          }

          function isServiceCategoryCollapsed(name) {
            var key = serviceCategoryKey(name);
            return Object.prototype.hasOwnProperty.call(serviceCollapsedCategories, key) ? serviceCollapsedCategories[key] : true;
          }

          function categoryByKey(key) {
            var rows = serviceCategoryRows();
            for (var i = 0; i < rows.length; i++) if (rows[i].key === key) return rows[i];
            return null;
          }

          function serviceById(id, catalog) {
            var source = (catalog || salonCatalog).services || [];
            for (var i = 0; i < source.length; i++) if (source[i].id === id) return source[i];
            return null;
          }

          function uniqueServiceId(catalog, categoryName, name) {
            var base = slugText((categoryName ? categoryName + '-' : '') + name);
            var id = base, suffix = 1;
            while (serviceById(id, catalog)) id = base + '-' + suffix++;
            return id;
          }

          function uniqueCategoryId(catalog, name, keepId) {
            var base = slugText(name || 'category');
            var id = base, suffix = 1;
            var categories = (catalog && catalog.categories) || [];
            while (categories.some(function (category) { return category.id === id && category.id !== keepId; })) id = base + '-' + suffix++;
            return id;
          }

          function categoryRowByKey(categoryKeyValue) {
            var rows = serviceCategoryRows();
            for (var i = 0; i < rows.length; i++) if (rows[i].key === categoryKeyValue) return rows[i];
            return null;
          }

          function ensureCategoryInCatalog(catalog, categoryName, kind) {
            var name = String(categoryName || '').trim();
            if (!name) return (catalog.categories || []).slice();
            var key = serviceCategoryKey(name);
            var found = false;
            var nextCategories = (catalog.categories || []).map(function (category) {
              if (serviceCategoryKey(category.name) !== key) return category;
              found = true;
              return Object.assign({}, category, { active: true, kind: kind || category.kind || 'service' });
            });
            if (!found) {
              nextCategories.push({
                id: uniqueCategoryId(catalog, name),
                name: name,
                kind: kind || 'service',
                active: true,
                source: 'pos-management'
              });
            }
            return nextCategories;
          }

          function saveSalonCategory(category, message) {
            var nextCatalog = salonData.loadCatalog();
            var name = String(category && category.name || '').trim();
            if (!name) return false;
            var key = serviceCategoryKey(name);
            var found = false;
            var nextCategories = (nextCatalog.categories || []).map(function (existing) {
              if (serviceCategoryKey(existing.name) !== key && existing.id !== category.id) return existing;
              found = true;
              return Object.assign({}, existing, category, { name: name, active: category.active !== false });
            });
            if (!found) {
              nextCategories.push(Object.assign({
                id: uniqueCategoryId(nextCatalog, name),
                kind: 'service',
                active: true,
                source: 'pos-management'
              }, category, { name: name }));
            }
            salonData.saveCatalog(Object.assign({}, nextCatalog, { categories: nextCategories }));
            logAdmin('🗂️ ' + message);
            refreshSalonCatalogConsumers();
            return true;
          }

          function renameSalonCategory(categoryKey, nextName, nextKind) {
            var cleanName = String(nextName || '').trim();
            if (!cleanName) { toast('Enter a category name', 'info'); return false; }
            var row = categoryRowByKey(categoryKey);
            if (!row) return false;
            var nextCatalog = salonData.loadCatalog();
            var nextKey = serviceCategoryKey(cleanName);
            var duplicate = (nextCatalog.categories || []).some(function (category) {
              return serviceCategoryKey(category.name) === nextKey && serviceCategoryKey(category.name) !== categoryKey;
            });
            if (duplicate) { toast('Category already exists', 'warning'); return false; }
            var nextId = uniqueCategoryId(nextCatalog, cleanName, row.id);
            var changed = false;
            var nextCategories = (nextCatalog.categories || []).map(function (category) {
              if (serviceCategoryKey(category.name) !== categoryKey) return category;
              changed = true;
              return Object.assign({}, category, { id: nextId, name: cleanName, kind: nextKind || category.kind || 'service', active: true });
            });
            if (!changed) {
              nextCategories.push({ id: nextId, name: cleanName, kind: nextKind || 'service', active: true, source: 'pos-management' });
            }
            var nextServices = nextCatalog.services.map(function (service) {
              if (serviceCategoryKey(serviceCategoryLabel(service)) !== categoryKey) return service;
              return Object.assign({}, service, { categoryId: nextId, categoryName: cleanName });
            });
            salonData.saveCatalog(Object.assign({}, nextCatalog, { categories: nextCategories, services: nextServices }));
            logAdmin('🗂️ Renamed category "' + row.name + '" to "' + cleanName + '"');
            refreshSalonCatalogConsumers();
            return true;
          }

          function setSalonCategoryActive(categoryKey, active) {
            var row = categoryRowByKey(categoryKey);
            if (!row) return false;
            var nextCatalog = salonData.loadCatalog();
            var nextCategories = (nextCatalog.categories || []).map(function (category) {
              if (serviceCategoryKey(category.name) !== categoryKey) return category;
              return Object.assign({}, category, { active: active !== false });
            });
            if (!nextCategories.some(function (category) { return serviceCategoryKey(category.name) === categoryKey; })) {
              nextCategories.push({ id: row.id, name: row.name, kind: row.kind || 'service', active: active !== false, source: 'pos-management' });
            }
            var nextServices = nextCatalog.services.map(function (service) {
              if (serviceCategoryKey(serviceCategoryLabel(service)) !== categoryKey || active !== false) return service;
              return Object.assign({}, service, { active: false });
            });
            salonData.saveCatalog(Object.assign({}, nextCatalog, { categories: nextCategories, services: nextServices }));
            logAdmin('🗂️ ' + (active === false ? 'Deleted' : 'Restored') + ' category "' + row.name + '"');
            refreshSalonCatalogConsumers();
            return true;
          }

          function saveSalonService(service, message) {
            var nextCatalog = salonData.loadCatalog();
            var found = false;
            var nextServices = nextCatalog.services.map(function (existing) {
              if (existing.id !== service.id) return existing;
              found = true;
              return Object.assign({}, existing, service);
            });
            if (!found) nextServices.push(service);
            salonData.saveCatalog(Object.assign({}, nextCatalog, {
              categories: ensureCategoryInCatalog(nextCatalog, service.categoryName, service.type === 'add-on' ? 'add-on' : 'service'),
              services: nextServices
            }));
            logAdmin('🧾 ' + message);
            refreshSalonCatalogConsumers();
          }

          function serviceIncludesText(includes) {
            return (Array.isArray(includes) ? includes : []).join('\n');
          }

          function serviceIncludesFromText(value) {
            return String(value || '').split(/\n+/).map(function (line) { return line.trim(); }).filter(Boolean);
          }

          function setServiceFormError(message) {
            var errorEl = $('[data-mg-service-form-error]');
            if (!errorEl) return;
            errorEl.textContent = message || '';
            errorEl.hidden = !message;
          }

          function serviceStatusChip(service) {
            return service.active === false
              ? '<span class="pos-chip pos-chip-gray">Inactive</span>'
              : '<span class="pos-chip pos-chip-green"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Active</span>';
          }

          function serviceIncludesHtml(service) {
            var includes = Array.isArray(service.includes) ? service.includes : [];
            if (!includes.length) return '<span class="pos-muted">—</span>';
            return includes.slice(0, 3).map(function (item) {
              return '<span class="pos-chip pos-chip-blue">' + esc(item) + '</span>';
            }).join(' ') + (includes.length > 3 ? ' <span class="pos-muted">+' + (includes.length - 3) + '</span>' : '');
          }

          function categoryKindOptions(selected) {
            return ['service', 'add-on'].map(function (kind) {
              return '<option value="' + kind + '"' + (selected === kind ? ' selected' : '') + '>' + (kind === 'add-on' ? 'Add-on' : 'Service') + '</option>';
            }).join('');
          }

          function categoryKindLabel(kind) {
            return kind === 'add-on' ? 'Add-on' : 'Service';
          }

          function setCategoryFormError(message) {
            var errorEl = $('[data-mg-category-form-error]');
            if (!errorEl) return;
            errorEl.textContent = message || '';
            errorEl.hidden = !message;
          }

          function categoryDetailHtml(category) {
            if (!category) return '<div class="service-detail-section"><div class="service-detail-empty">Category not found.</div></div>';
            var status = category.active === false ? 'Inactive' : 'Active';
            var detailRows = [
              ['Category ID', category.id, 'No category ID'],
              ['Name', category.name, 'No name'],
              ['Type', categoryKindLabel(category.kind)],
              ['Status', status],
              ['Active services', category.activeServices],
              ['Total services', category.totalServices]
            ].map(function (row) { return serviceDetailFieldHtml(row[0], row[1], row[2]); }).join('');
            return '<div class="service-detail-hero">' +
              '<div class="service-detail-top"><div><div class="service-detail-kicker">Menu category</div><h3 class="service-detail-name">' + esc(category.name || 'Category') + '</h3></div>' + serviceStatusChip(category) + '</div>' +
              '<div class="service-detail-meta">' +
                '<span class="service-detail-stat"><i class="bi bi-tags" aria-hidden="true"></i>' + esc(categoryKindLabel(category.kind)) + '</span>' +
                '<span class="service-detail-stat"><i class="bi bi-card-checklist" aria-hidden="true"></i>' + category.activeServices + ' active services</span>' +
                '<span class="service-detail-stat"><i class="bi bi-list-ul" aria-hidden="true"></i>' + category.totalServices + ' total services</span>' +
              '</div>' +
            '</div>' +
            '<div class="service-detail-section"><div class="service-detail-section-title"><i class="bi bi-info-circle" aria-hidden="true"></i>Category information</div><div class="service-detail-kv-grid">' + detailRows + '</div></div>';
          }

          function openCategoryModal(key, mode) {
            var modal = $('[data-mg-category-modal]');
            if (!modal) return;
            categoryModalKey = key || null;
            categoryModalMode = mode === 'view' ? 'view' : (categoryModalKey ? 'edit' : 'add');
            var category = categoryModalKey ? categoryByKey(categoryModalKey) : null;
            var isReadOnly = categoryModalMode === 'view';
            var titleEl = $('[data-mg-category-modal-title]');
            var subtitleEl = $('[data-mg-category-modal-subtitle]');
            var detailEl = $('[data-mg-category-detail]');
            var formShellEl = $('[data-mg-category-form-shell]');
            var nameEl = $('[data-mg-category-form-name]');
            var kindEl = $('[data-mg-category-form-kind]');
            var activeEl = $('[data-mg-category-form-active]');
            var saveEl = $('[data-mg-category-save]');
            var saveLabelEl = $('[data-mg-category-save-label]');
            var cancelLabelEl = $('[data-mg-category-cancel-label]');
            if (titleEl) titleEl.textContent = isReadOnly ? 'Category details' : (category ? 'Edit category' : 'Add category');
            if (subtitleEl) subtitleEl.textContent = categoryModalMode === 'add' ? 'Create a new menu category' : (isReadOnly ? 'Read-only category detail' : 'Update category details');
            if (detailEl) {
              detailEl.innerHTML = isReadOnly ? categoryDetailHtml(category) : '';
              detailEl.hidden = !isReadOnly;
            }
            if (formShellEl) formShellEl.hidden = isReadOnly;
            if (nameEl) nameEl.value = category ? category.name || '' : '';
            if (kindEl) kindEl.innerHTML = categoryKindOptions(category ? category.kind || 'service' : 'service');
            if (activeEl) activeEl.value = category && category.active === false ? 'inactive' : 'active';
            [nameEl, kindEl, activeEl].forEach(function (field) {
              if (field) field.disabled = isReadOnly;
            });
            if (cancelLabelEl) cancelLabelEl.textContent = isReadOnly ? 'Close' : 'Cancel';
            if (saveLabelEl) saveLabelEl.textContent = categoryModalMode === 'add' ? 'Create category' : 'Save changes';
            if (saveEl) saveEl.hidden = isReadOnly;
            modal.setAttribute('data-category-modal-mode', categoryModalMode);
            setCategoryFormError('');
            modal.classList.add('open');
            modal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            setTimeout(function () {
              var focusEl = isReadOnly ? $('[data-mg-category-cancel]') : nameEl;
              if (focusEl) focusEl.focus();
            }, 0);
          }

          function closeCategoryModal() {
            var modal = $('[data-mg-category-modal]');
            if (!modal) return;
            var detailEl = $('[data-mg-category-detail]');
            var formShellEl = $('[data-mg-category-form-shell]');
            var cancelLabelEl = $('[data-mg-category-cancel-label]');
            modal.classList.remove('open');
            modal.setAttribute('aria-hidden', 'true');
            modal.removeAttribute('data-category-modal-mode');
            if (detailEl) {
              detailEl.innerHTML = '';
              detailEl.hidden = true;
            }
            if (formShellEl) formShellEl.hidden = false;
            if (cancelLabelEl) cancelLabelEl.textContent = 'Cancel';
            document.body.style.overflow = '';
            categoryModalKey = null;
            categoryModalMode = 'edit';
            setCategoryFormError('');
          }

          function readCategoryModal() {
            var existing = categoryModalKey ? categoryByKey(categoryModalKey) : null;
            var nameEl = $('[data-mg-category-form-name]');
            var kindEl = $('[data-mg-category-form-kind]');
            var activeEl = $('[data-mg-category-form-active]');
            var name = (nameEl && nameEl.value || '').trim();
            if (!name) return null;
            return {
              id: existing ? existing.id : uniqueCategoryId(salonData.loadCatalog(), name),
              name: name,
              kind: kindEl ? kindEl.value : 'service',
              active: activeEl ? activeEl.value === 'active' : true,
              source: 'pos-management'
            };
          }

          function saveCategoryModal() {
            if (categoryModalMode === 'view') { closeCategoryModal(); return; }
            var category = readCategoryModal();
            if (!category) {
              setCategoryFormError('Enter a category name.');
              var nameEl = $('[data-mg-category-form-name]');
              if (nameEl) nameEl.focus();
              return;
            }
            var isNew = !categoryModalKey;
            if (isNew) {
              if (!saveSalonCategory(category, 'Added category "' + category.name + '"')) return;
            } else {
              if (!renameSalonCategory(categoryModalKey, category.name, category.kind)) return;
              if (category.active === false) setSalonCategoryActive(serviceCategoryKey(category.name), false);
            }
            closeCategoryModal();
            renderManagement();
            toast(category.name + (isNew ? ' category added' : ' category saved'));
          }

          var serviceCategoryViewMode = DEFAULT_VIEW_MODE;
          function serviceCategoryManagerHtml(categoryRows) {
            var activeCategories = categoryRows.filter(function (row) { return row.active !== false; }).length;
            var categoryActionsHtml = function (row) {
              return '<button class="pos-btn pos-btn-sm" type="button" data-mg-category-view="' + esc(row.key) + '"><i class="bi bi-eye" aria-hidden="true"></i> View</button><button class="pos-btn pos-btn-sm" type="button" data-mg-category-edit="' + esc(row.key) + '"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>' +
                (row.active === false ? '<button class="pos-btn pos-btn-sm" type="button" data-mg-category-restore="' + esc(row.key) + '">Restore</button>' : '<button class="pos-btn pos-btn-danger pos-btn-sm" type="button" data-mg-category-delete="' + esc(row.key) + '"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>');
            };
            var tableHtml = '<div class="pos-table-wrap" data-mg-category-table><table class="pos-table tight"><thead><tr><th>Category</th><th>Services</th><th>Status</th><th>Type</th><th>Actions</th></tr></thead><tbody>' +
              categoryRows.map(function (row) {
                return '<tr data-mg-category-row="' + esc(row.key) + '">' +
                  '<td><span class="pos-strong">' + esc(row.name) + '</span></td>' +
                  '<td><span class="pos-strong">' + row.activeServices + '</span> active · ' + row.totalServices + ' total</td>' +
                  '<td>' + (row.active === false ? '<span class="pos-chip pos-chip-gray">Inactive</span>' : '<span class="pos-chip pos-chip-green"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Active</span>') + '</td>' +
                  '<td>' + esc(categoryKindLabel(row.kind)) + '</td>' +
                  '<td style="white-space:nowrap"><div class="pos-inline">' + categoryActionsHtml(row) + '</div></td></tr>';
              }).join('') +
              '</tbody></table></div>';
            var cardsHtml = '<div data-mg-category-list>' + categoryRows.map(function (row) {
              return '<article class="queue-card" data-mg-category-row="' + esc(row.key) + '">' +
                '<div class="queue-card-head"><div class="queue-card-identity pos-strong">' + esc(row.name) + '</div>' +
                (row.active === false ? '<span class="pos-chip pos-chip-gray">Inactive</span>' : '<span class="pos-chip pos-chip-green"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Active</span>') + '</div>' +
                '<div class="pos-inline" style="flex-wrap:wrap;gap:8px"><span class="pos-chip pos-chip-gray">' + row.activeServices + ' active · ' + row.totalServices + ' total</span><span class="pos-chip pos-chip-gray">' + esc(categoryKindLabel(row.kind)) + '</span></div>' +
                '<div class="queue-card-actions">' + categoryActionsHtml(row) + '</div>' +
                '</article>';
            }).join('') + '</div>';
            return '<div class="pos-card service-category-card' + (serviceCategoryManagerCollapsed ? ' is-collapsed' : '') + '" data-mg-category-manager>' +
              '<div class="pos-card-head"><div><button class="service-category-manager-title" type="button" data-mg-category-manager-toggle aria-expanded="' + (!serviceCategoryManagerCollapsed ? 'true' : 'false') + '"><i class="bi bi-tags" aria-hidden="true"></i> Categories <i class="bi ' + (serviceCategoryManagerCollapsed ? 'bi-chevron-right' : 'bi-chevron-down') + '" aria-hidden="true"></i></button><div class="pos-muted" style="font-size:12px;margin-top:2px">' + activeCategories + ' active · ' + categoryRows.length + ' total</div></div>' +
                '<div class="pos-inline">' +
                  '<div class="booking-view-switch" role="group" aria-label="Service categories view mode">' +
                    '<button class="booking-view-button' + (serviceCategoryViewMode === 'table' ? ' is-active' : '') + '" type="button" data-mg-category-view-target="table" aria-pressed="' + (serviceCategoryViewMode === 'table' ? 'true' : 'false') + '"><i class="bi bi-table" aria-hidden="true"></i>Table</button>' +
                    '<button class="booking-view-button' + (serviceCategoryViewMode === 'card' ? ' is-active' : '') + '" type="button" data-mg-category-view-target="card" aria-pressed="' + (serviceCategoryViewMode === 'card' ? 'true' : 'false') + '"><i class="bi bi-grid-1x2" aria-hidden="true"></i>Card</button>' +
                  '</div>' +
                  '<button class="pos-btn pos-btn-primary pos-btn-sm" type="button" data-mg-category-add><i class="bi bi-plus-lg" aria-hidden="true"></i> Add category</button>' +
                '</div></div>' +
              (serviceCategoryManagerCollapsed ? '' : (serviceCategoryViewMode === 'card' ? cardsHtml : tableHtml)) +
            '</div>';
          }

          function serviceModalSummaryHtml(service, mode) {
            var current = service || {};
            var name = current.name || (mode === 'add' ? 'New service' : 'Service');
            var category = current.categoryName || current.requiredSkill || (current.name ? serviceCategoryLabel(current) : 'Choose category');
            var price = current.price == null ? 'No price' : money(current.price);
            var duration = current.durationMin ? current.durationMin + ' min' : 'No duration';
            var skill = current.requiredSkill || 'No skill';
            var type = current.type || 'standard';
            var includesCount = Array.isArray(current.includes) ? current.includes.length : 0;
            return '<div class="service-editor-preview">' +
              '<div class="service-editor-preview-top"><span class="service-editor-preview-icon"><i class="bi bi-card-checklist" aria-hidden="true"></i></span><div class="service-editor-preview-copy"><div class="service-editor-preview-name">' + esc(name) + '</div><div class="service-editor-preview-category">' + esc(category) + '</div></div></div>' +
              '<div>' + serviceStatusChip(current) + '</div>' +
              '<div class="service-editor-summary-grid">' +
                '<div class="service-editor-summary-item"><span>Price</span><strong>' + esc(price) + '</strong></div>' +
                '<div class="service-editor-summary-item"><span>Minutes</span><strong>' + esc(duration) + '</strong></div>' +
                '<div class="service-editor-summary-item"><span>Skill</span><strong>' + esc(skill) + '</strong></div>' +
                '<div class="service-editor-summary-item"><span>Type</span><strong>' + esc(type) + '</strong></div>' +
                '<div class="service-editor-summary-item"><span>Includes</span><strong>' + includesCount + '</strong></div>' +
              '</div>' +
            '</div>';
          }

          function serviceDetailValue(value, fallback) {
            if (Array.isArray(value)) return value.length ? value.join(', ') : (fallback || 'None');
            if (value === true) return 'true';
            if (value === false) return 'false';
            if (value == null || value === '') return fallback || 'None';
            return String(value);
          }

          function serviceDetailFieldHtml(label, value, fallback) {
            return '<div class="service-detail-kv"><span>' + esc(label) + '</span><strong>' + esc(serviceDetailValue(value, fallback)) + '</strong></div>';
          }

          function serviceDetailHtml(service) {
            if (!service) return '<div class="service-detail-section"><div class="service-detail-empty">Service not found.</div></div>';
            var category = serviceCategoryLabel(service);
            var price = service.price == null ? 'No price' : money(service.price);
            var duration = service.durationMin ? service.durationMin + ' min' : 'No duration';
            var skill = service.requiredSkill || 'No skill';
            var type = service.type || 'standard';
            var kind = service.kind || (service.type === 'add-on' ? 'add-on' : 'service');
            var description = (service.description || '').trim();
            var includes = Array.isArray(service.includes) ? service.includes : [];
            var aliases = Array.isArray(service.aliases) ? service.aliases : [];
            var includesHtml = includes.length
              ? '<ul class="service-detail-list">' + includes.map(function (item) { return '<li>' + esc(item) + '</li>'; }).join('') + '</ul>'
              : '<div class="service-detail-empty">No includes</div>';
            var aliasesHtml = aliases.length
              ? '<div class="service-detail-pills">' + aliases.map(function (alias) { return '<span class="pos-chip pos-chip-blue">' + esc(alias) + '</span>'; }).join('') + '</div>'
              : '<div class="service-detail-empty">No aliases</div>';
            var detailRows = [
              ['Service ID', service.id, 'No ID'],
              ['Name', service.name, 'No name'],
              ['Category ID', service.categoryId, 'No category ID'],
              ['Category name', service.categoryName || category, 'No category'],
              ['Price', service.price == null ? '' : money(service.price), 'No price'],
              ['Price label', service.priceLabel, 'No price label'],
              ['Minutes', service.durationMin ? service.durationMin + ' min' : '', 'No duration'],
              ['Required skill', service.requiredSkill, 'No skill'],
              ['Type', type],
              ['Kind', kind],
              ['Status', service.active === false ? 'Inactive' : 'Active']
            ].map(function (row) { return serviceDetailFieldHtml(row[0], row[1], row[2]); }).join('');
            return '<div class="service-detail-hero">' +
              '<div class="service-detail-top"><div><div class="service-detail-kicker">' + esc(category) + '</div><h3 class="service-detail-name">' + esc(service.name || 'Service') + '</h3></div>' + serviceStatusChip(service) + '</div>' +
              '<div class="service-detail-meta">' +
                '<span class="service-detail-stat"><i class="bi bi-currency-dollar" aria-hidden="true"></i>' + esc(price) + '</span>' +
                '<span class="service-detail-stat"><i class="bi bi-clock" aria-hidden="true"></i>' + esc(duration) + '</span>' +
                '<span class="service-detail-stat"><i class="bi bi-person-check" aria-hidden="true"></i>' + esc(skill) + '</span>' +
                '<span class="service-detail-stat"><i class="bi bi-tags" aria-hidden="true"></i>' + esc(type) + '</span>' +
              '</div>' +
            '</div>' +
            '<div class="service-detail-body-grid">' +
              '<div class="service-detail-section"><div class="service-detail-section-title"><i class="bi bi-text-paragraph" aria-hidden="true"></i>Description</div><p class="service-detail-text">' + esc(description || 'No description') + '</p></div>' +
              '<div class="service-detail-section"><div class="service-detail-section-title"><i class="bi bi-list-check" aria-hidden="true"></i>Includes</div>' + includesHtml + '</div>' +
            '</div>' +
            '<div class="service-detail-section"><div class="service-detail-section-title"><i class="bi bi-info-circle" aria-hidden="true"></i>Service information</div><div class="service-detail-kv-grid">' + detailRows + '</div></div>' +
            '<div class="service-detail-section"><div class="service-detail-section-title"><i class="bi bi-bookmark" aria-hidden="true"></i>Aliases</div>' + aliasesHtml + '</div>';
          }

          function openServiceModal(id, mode, categoryName) {
            var modal = $('[data-mg-service-modal]');
            if (!modal) return;
            serviceModalId = id || null;
            serviceModalMode = mode === 'view' ? 'view' : (serviceModalId ? 'edit' : 'add');
            var service = serviceModalId ? serviceById(serviceModalId) : null;
            var categoryPrefill = !serviceModalId && categoryName ? categoryName : '';
            var summaryService = service || (categoryPrefill ? { categoryName: categoryPrefill, active: true } : null);
            var isReadOnly = serviceModalMode === 'view';
            var titleEl = $('[data-mg-service-modal-title]');
            var subtitleEl = $('[data-mg-service-modal-subtitle]');
            var summaryEl = $('[data-mg-service-summary]');
            var detailEl = $('[data-mg-service-detail]');
            var formShellEl = $('[data-mg-service-form-shell]');
            var nameEl = $('[data-mg-service-form-name]');
            var categoryEl = $('[data-mg-service-form-category]');
            var priceEl = $('[data-mg-service-form-price]');
            var durationEl = $('[data-mg-service-form-duration]');
            var skillEl = $('[data-mg-service-form-skill]');
            var typeEl = $('[data-mg-service-form-type]');
            var activeEl = $('[data-mg-service-form-active]');
            var descriptionEl = $('[data-mg-service-form-description]');
            var includesEl = $('[data-mg-service-form-includes]');
            var saveEl = $('[data-mg-service-save]');
            var saveLabelEl = $('[data-mg-service-save-label]');
            var serviceModalCancelLabel = $('[data-mg-service-cancel-label]');
            if (titleEl) titleEl.textContent = isReadOnly ? 'Service details' : (service ? 'Edit service' : 'Add service');
            if (subtitleEl) subtitleEl.textContent = serviceModalMode === 'add' ? 'Create a new menu service' : (isReadOnly ? 'Read-only service detail' : 'Update service details');
            if (summaryEl) {
              summaryEl.innerHTML = serviceModalSummaryHtml(summaryService, serviceModalMode);
              summaryEl.hidden = isReadOnly;
            }
            if (detailEl) {
              detailEl.innerHTML = isReadOnly ? serviceDetailHtml(service) : '';
              detailEl.hidden = !isReadOnly;
            }
            if (formShellEl) formShellEl.hidden = isReadOnly;
            if (categoryEl) categoryEl.innerHTML = serviceCategoryOptions(service ? service.categoryName || '' : categoryPrefill);
            if (skillEl) skillEl.innerHTML = serviceSkillOptions(service ? service.requiredSkill || '' : '');
            if (typeEl) typeEl.innerHTML = serviceTypeOptions(service ? service.type || '' : '');
            if (activeEl) activeEl.value = service && service.active === false ? 'inactive' : 'active';
            if (nameEl) nameEl.value = service ? service.name || '' : '';
            if (categoryEl) categoryEl.value = service ? service.categoryName || '' : categoryPrefill;
            if (priceEl) priceEl.value = service && service.price != null ? service.price : '';
            if (durationEl) durationEl.value = service && service.durationMin ? service.durationMin : '';
            if (descriptionEl) descriptionEl.value = service ? service.description || '' : '';
            if (includesEl) includesEl.value = service ? serviceIncludesText(service.includes) : '';
            [nameEl, categoryEl, priceEl, durationEl, skillEl, typeEl, activeEl, descriptionEl, includesEl].forEach(function (field) {
              if (field) field.disabled = isReadOnly;
            });
            if (serviceModalCancelLabel) serviceModalCancelLabel.textContent = isReadOnly ? 'Close' : 'Cancel';
            if (saveLabelEl) saveLabelEl.textContent = serviceModalMode === 'add' ? 'Create service' : 'Save changes';
            if (saveEl) saveEl.hidden = isReadOnly;
            modal.setAttribute('data-service-modal-mode', serviceModalMode);
            if (!isReadOnly) updateServiceModalSummary();
            setServiceFormError('');
            modal.classList.add('open');
            modal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            setTimeout(function () {
              var focusEl = isReadOnly ? $('[data-mg-service-cancel]') : nameEl;
              if (focusEl) focusEl.focus();
            }, 0);
          }

          function closeServiceModal() {
            var modal = $('[data-mg-service-modal]');
            if (!modal) return;
            var detailEl = $('[data-mg-service-detail]');
            var formShellEl = $('[data-mg-service-form-shell]');
            var summaryEl = $('[data-mg-service-summary]');
            var serviceModalCancelLabel = $('[data-mg-service-cancel-label]');
            modal.classList.remove('open');
            modal.setAttribute('aria-hidden', 'true');
            modal.removeAttribute('data-service-modal-mode');
            if (detailEl) {
              detailEl.innerHTML = '';
              detailEl.hidden = true;
            }
            if (formShellEl) formShellEl.hidden = false;
            if (summaryEl) summaryEl.hidden = false;
            if (serviceModalCancelLabel) serviceModalCancelLabel.textContent = 'Cancel';
            document.body.style.overflow = '';
            serviceModalId = null;
            serviceModalMode = 'edit';
            setServiceFormError('');
          }

          function serviceModalDraft() {
            var existing = serviceModalId ? serviceById(serviceModalId) : null;
            var nameEl = $('[data-mg-service-form-name]');
            var categoryEl = $('[data-mg-service-form-category]');
            var priceEl = $('[data-mg-service-form-price]');
            var durationEl = $('[data-mg-service-form-duration]');
            var skillEl = $('[data-mg-service-form-skill]');
            var typeEl = $('[data-mg-service-form-type]');
            var activeEl = $('[data-mg-service-form-active]');
            var descriptionEl = $('[data-mg-service-form-description]');
            var includesEl = $('[data-mg-service-form-includes]');
            var price = priceEl && priceEl.value !== '' ? Number(priceEl.value) : null;
            var duration = durationEl && durationEl.value !== '' ? parseInt(durationEl.value, 10) : null;
            return Object.assign({}, existing || {}, {
              name: (nameEl && nameEl.value || '').trim(),
              categoryName: (categoryEl && categoryEl.value || '').trim(),
              price: Number.isFinite(price) ? price : null,
              durationMin: Number.isFinite(duration) && duration > 0 ? duration : null,
              requiredSkill: skillEl ? skillEl.value : '',
              active: activeEl ? activeEl.value === 'active' : true,
              description: (descriptionEl && descriptionEl.value || '').trim(),
              includes: serviceIncludesFromText(includesEl && includesEl.value),
              type: typeEl ? typeEl.value : ''
            });
          }

          function updateServiceModalSummary() {
            if (serviceModalMode === 'view') return;
            var summaryEl = $('[data-mg-service-summary]');
            if (summaryEl) summaryEl.innerHTML = serviceModalSummaryHtml(serviceModalDraft(), serviceModalMode);
          }

          function readServiceModal() {
            var existing = serviceModalId ? serviceById(serviceModalId) : null;
            var nameEl = $('[data-mg-service-form-name]');
            var categoryEl = $('[data-mg-service-form-category]');
            var priceEl = $('[data-mg-service-form-price]');
            var durationEl = $('[data-mg-service-form-duration]');
            var skillEl = $('[data-mg-service-form-skill]');
            var typeEl = $('[data-mg-service-form-type]');
            var activeEl = $('[data-mg-service-form-active]');
            var descriptionEl = $('[data-mg-service-form-description]');
            var includesEl = $('[data-mg-service-form-includes]');
            var name = (nameEl && nameEl.value || '').trim();
            if (!name) return null;
            var categoryName = (categoryEl && categoryEl.value || '').trim();
            var price = priceEl && priceEl.value !== '' ? Number(priceEl.value) : null;
            var duration = durationEl && durationEl.value !== '' ? parseInt(durationEl.value, 10) : null;
            var catalog = salonData.loadCatalog();
            return Object.assign({}, existing || {}, {
              id: existing ? existing.id : uniqueServiceId(catalog, categoryName, name),
              name: name,
              aliases: existing && Array.isArray(existing.aliases) ? existing.aliases : [],
              price: Number.isFinite(price) ? price : null,
              durationMin: Number.isFinite(duration) && duration > 0 ? duration : null,
              requiredSkill: skillEl ? skillEl.value : '',
              icon: existing && existing.icon ? existing.icon : '✨',
              active: activeEl ? activeEl.value === 'active' : true,
              categoryId: categoryName ? slugText(categoryName) : '',
              categoryName: categoryName,
              kind: existing && existing.kind ? existing.kind : 'service',
              priceLabel: Number.isFinite(price) ? priceLabelForService(price) : '',
              description: (descriptionEl && descriptionEl.value || '').trim(),
              includes: serviceIncludesFromText(includesEl && includesEl.value),
              type: typeEl ? typeEl.value : '',
              source: existing && existing.source ? existing.source : 'pos-management'
            });
          }

          function saveServiceModal() {
            if (serviceModalMode === 'view') { closeServiceModal(); return; }
            var service = readServiceModal();
            if (!service) {
              setServiceFormError('Enter a service name.');
              var nameEl = $('[data-mg-service-form-name]');
              if (nameEl) nameEl.focus();
              return;
            }
            var isNew = !serviceModalId;
            saveSalonService(service, (isNew ? 'Added' : 'Updated') + ' service "' + service.name + '"');
            closeServiceModal();
            toast(service.name + (isNew ? ' added' : ' saved'));
          }

          function mgServicesHtml() {
            var services = salonCatalog.services.slice();
            var categoryRows = serviceCategoryRows();
            var serviceCategoryGroups = groupedServicesByCategory(services);
            var categoryManagerHtml = serviceCategoryManagerHtml(categoryRows);
            var serviceTableHtml = '<div class="pos-table-wrap" data-mg-service-table><table class="pos-table tight"><thead><tr><th>Service</th><th>Price</th><th>Minutes</th><th>Status</th><th>Category</th><th>Actions</th></tr></thead><tbody>' +
              serviceCategoryGroups.map(function (group) {
                var collapsed = isServiceCategoryCollapsed(group.name);
                var categoryToggleHtml = '<button class="pos-btn pos-btn-sm service-category-toggle" type="button" data-mg-service-category-toggle="' + esc(group.name) + '" aria-expanded="' + (collapsed ? 'false' : 'true') + '"><i class="bi ' + (collapsed ? 'bi-chevron-right' : 'bi-chevron-down') + '" aria-hidden="true"></i> ' + esc(group.name) + ' · ' + group.services.length + '</button>';
                var categoryAddHtml = '<button class="pos-btn pos-btn-sm service-category-add" type="button" data-mg-service-add-category="' + esc(group.name) + '"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add service</button>';
                return '<tr data-mg-service-category-group="' + esc(group.name) + '"><td colspan="6" style="background:var(--nexora-surface-muted);color:var(--nexora-muted);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.03em"><div class="service-category-head">' + categoryToggleHtml + categoryAddHtml + '</div></td></tr>' +
                  (collapsed ? '' : group.services.map(function (service) {
                    return '<tr>' +
                      '<td><span class="pos-strong">' + esc(service.name) + '</span></td>' +
                      '<td>' + (service.price == null ? '—' : money(service.price)) + '</td>' +
                      '<td>' + (service.durationMin || '—') + '</td>' +
                      '<td>' + serviceStatusChip(service) + '</td>' +
                      '<td>' + esc(serviceCategoryLabel(service)) + '</td>' +
                      '<td style="white-space:nowrap"><div class="pos-inline"><button class="pos-btn pos-btn-sm" type="button" data-mg-service-view="' + esc(service.id) + '"><i class="bi bi-eye" aria-hidden="true"></i> View</button><button class="pos-btn pos-btn-sm" type="button" data-mg-service-edit="' + esc(service.id) + '"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button class="pos-btn pos-btn-danger pos-btn-sm" type="button" data-mg-service-delete="' + esc(service.id) + '"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button></div></td>' +
                      '</tr>';
                  }).join(''));
              }).join('') +
              '</tbody></table></div>';
            var serviceCardsHtml = '<div data-mg-service-cards style="display:grid;gap:16px">' +
              serviceCategoryGroups.map(function (group) {
                var collapsed = isServiceCategoryCollapsed(group.name);
                var categoryToggleHtml = '<button class="pos-btn pos-btn-sm service-category-toggle" type="button" data-mg-service-category-toggle="' + esc(group.name) + '" aria-expanded="' + (collapsed ? 'false' : 'true') + '"><i class="bi ' + (collapsed ? 'bi-chevron-right' : 'bi-chevron-down') + '" aria-hidden="true"></i> ' + esc(group.name) + ' · ' + group.services.length + '</button>';
                var categoryAddHtml = '<button class="pos-btn pos-btn-sm service-category-add" type="button" data-mg-service-add-category="' + esc(group.name) + '"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add service</button>';
                return '<section data-mg-service-card-category="' + esc(group.name) + '">' +
                  '<div class="service-category-bar"><div class="service-category-head">' + categoryToggleHtml + categoryAddHtml + '</div></div>' +
                  (collapsed ? '' : '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:12px">' +
                  group.services.map(function (service) {
                    var description = (service.description || '').trim();
                    return '<article class="queue-card">' +
                      '<div class="cust-card-head"><div><div class="pos-strong">' + esc(service.name) + '</div><div class="pos-muted" style="font-size:12px;margin-top:3px">' + esc(serviceCategoryLabel(service)) + '</div></div>' + serviceStatusChip(service) + '</div>' +
                      '<div class="pos-inline" style="margin-top:8px"><span class="pos-chip pos-chip-gray">' + (service.price == null ? 'No price' : money(service.price)) + '</span><span class="pos-chip pos-chip-gray">' + (service.durationMin || '—') + ' min</span><span class="pos-chip pos-chip-gray">' + esc(service.requiredSkill || 'No skill') + '</span></div>' +
                      (description ? '<div class="pos-muted wrap" style="font-size:12px;margin-top:8px">' + esc(description) + '</div>' : '') +
                      '<div class="pill-row" style="margin-top:8px">' + serviceIncludesHtml(service) + '</div>' +
                      '<div class="wl-actions" style="margin-top:10px"><button class="pos-btn pos-btn-sm" type="button" data-mg-service-view="' + esc(service.id) + '"><i class="bi bi-eye" aria-hidden="true"></i> View</button><button class="pos-btn pos-btn-sm" type="button" data-mg-service-edit="' + esc(service.id) + '"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button><button class="pos-btn pos-btn-danger pos-btn-sm" type="button" data-mg-service-delete="' + esc(service.id) + '"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button></div>' +
                      '</article>';
                  }).join('') +
                  '</div>') + '</section>';
              }).join('') +
              '</div>';
            var serviceBodyHtml = serviceViewMode === 'card' ? serviceCardsHtml : serviceTableHtml;
            return categoryManagerHtml +
              '<div class="pos-card">' +
              '<div class="pos-card-head"><div><h3><i class="bi bi-card-checklist" aria-hidden="true"></i> Services</h3></div>' +
                '<div class="pos-inline">' +
                  '<div class="booking-view-switch" role="group" aria-label="Service view mode">' +
                    '<button class="booking-view-button' + (serviceViewMode === 'table' ? ' is-active' : '') + '" type="button" data-mg-service-view-target="table" aria-pressed="' + (serviceViewMode === 'table' ? 'true' : 'false') + '"><i class="bi bi-table" aria-hidden="true"></i>Table</button>' +
                    '<button class="booking-view-button' + (serviceViewMode === 'card' ? ' is-active' : '') + '" type="button" data-mg-service-view-target="card" aria-pressed="' + (serviceViewMode === 'card' ? 'true' : 'false') + '"><i class="bi bi-grid-1x2" aria-hidden="true"></i>Card</button>' +
                  '</div>' +
                  '<button class="pos-btn pos-btn-primary pos-btn-sm" type="button" data-mg-service-add><i class="bi bi-plus-lg" aria-hidden="true"></i> Add service</button>' +
                '</div></div>' +
              serviceBodyHtml +
              '<div class="pos-hint">Delete marks a service inactive so old bookings and tickets keep their history. Active services appear in Booking and Check-in immediately after Save.</div>' +
              '</div>';
          }

          var mgStaffViewMode = DEFAULT_VIEW_MODE;
          function mgStaffHtml() {
            var staffRowHtml = function (s) {
              var roleCell = s.role === 'owner'
                ? '<span class="pos-chip pos-chip-gold">👑 Owner</span>'
                : '<select class="pos-input staff-role-select" data-mg-strole="' + s.id + '">' +
                  ['manager', 'frontdesk', 'tech'].map(function (r) { return '<option value="' + r + '"' + (s.role === r ? ' selected' : '') + '>' + ROLE_LBL[r] + '</option>'; }).join('') +
                  '</select>';
              return { roleCell: roleCell };
            };
            var tableHtml = '<div class="pos-table-wrap"><table class="pos-table tight"><thead><tr><th>Employee</th><th>Role</th><th>Login PIN</th><th>Access</th></tr></thead><tbody>' +
              STAFF.map(function (s) {
                var x = staffRowHtml(s);
                return '<tr>' +
                  '<td><span class="pos-people"><span class="pos-avatar plain">' + esc(initials(s.name)) + '</span> <span class="pos-strong">' + esc(s.name) + '</span></span></td>' +
                  '<td>' + x.roleCell + '</td>' +
                  '<td>•••• <button class="pos-btn pos-btn-sm" data-mg-stpin="' + s.id + '"><i class="bi bi-key" aria-hidden="true"></i> Reset PIN</button></td>' +
                  '<td class="pos-muted wrap">' + ROLE_ACCESS[s.role] + '</td></tr>';
              }).join('') +
              '</tbody></table></div>';
            var cardsHtml = '<div data-mg-staff-list>' + STAFF.map(function (s) {
              var x = staffRowHtml(s);
              return '<article class="queue-card staff-card">' +
                '<div class="staff-head">' +
                  '<span class="staff-avatar">' + esc(initials(s.name)) + '</span>' +
                  '<span class="staff-name">' + esc(s.name) + '</span>' +
                  x.roleCell +
                  '<div class="staff-head-actions">' +
                    '<span class="staff-pin-dots">••••</span>' +
                    '<button class="pos-btn pos-btn-sm" data-mg-stpin="' + s.id + '"><i class="bi bi-key" aria-hidden="true"></i> Reset PIN</button>' +
                  '</div>' +
                '</div>' +
                '<div class="perf-divider"></div>' +
                '<div><span class="perf-section-label">Access</span><div class="staff-access-value">' + ROLE_ACCESS[s.role] + '</div></div>' +
                '</article>';
            }).join('') + '</div>';
            return '<div class="pos-card">' +
              '<div class="pos-card-head"><h3><i class="bi bi-person-badge" aria-hidden="true"></i> Staff accounts — the role decides what a login sees</h3>' +
              '<div class="pos-inline">' +
                '<span class="pos-muted">per-permission detail lives in the 🔐 matrix below</span>' +
                '<div class="booking-view-switch" role="group" aria-label="Staff accounts view mode">' +
                  '<button class="booking-view-button' + (mgStaffViewMode === 'table' ? ' is-active' : '') + '" type="button" data-mg-staff-view-target="table" aria-pressed="' + (mgStaffViewMode === 'table' ? 'true' : 'false') + '"><i class="bi bi-table" aria-hidden="true"></i>Table</button>' +
                  '<button class="booking-view-button' + (mgStaffViewMode === 'card' ? ' is-active' : '') + '" type="button" data-mg-staff-view-target="card" aria-pressed="' + (mgStaffViewMode === 'card' ? 'true' : 'false') + '"><i class="bi bi-grid-1x2" aria-hidden="true"></i>Card</button>' +
                '</div>' +
              '</div></div>' +
              (mgStaffViewMode === 'card' ? cardsHtml : tableHtml) +
              '<div class="pos-inline" style="margin-top:12px">' +
              '<input class="pos-input" data-mg-stname placeholder="New employee name" style="width:220px">' +
              '<select class="pos-input" data-mg-strolenew style="width:150px"><option value="manager">Manager</option><option value="frontdesk" selected>Front Desk</option></select>' +
              '<span class="pos-muted" style="font-size:12px">Techs (with pay and turns) are added from ➕ Add tech in the pay table above.</span>' +
              '<button class="pos-btn pos-btn-primary pos-btn-sm" data-mg-stadd><i class="bi bi-plus-lg"></i> Create account</button>' +
              '</div>' +
              '</div>';
          }

          function mgRolesHtml() {
            return '<div class="pos-card">' +
              '<div class="pos-card-head"><h3><i class="bi bi-shield-lock" aria-hidden="true"></i> Roles &amp; permissions</h3><span class="pos-muted">tap a cell to cycle: None → Limited → Full</span></div>' +
              '<div class="pos-table-wrap"><table class="pos-table tight"><thead><tr><th>Permission</th>' +
              PERM_ROLES.map(function (r) { return '<th style="text-align:center">' + r[1] + '</th>'; }).join('') +
              '</tr></thead><tbody>' +
              PERMS.map(function (row) {
                return '<tr><td class="wrap">' + esc(row[0]) + '</td>' + PERM_ROLES.map(function (pr) {
                  var v = row[1][pr[0]];
                  return '<td style="text-align:center"><button class="perm-cell" data-state="' + v + '" data-mg-perm="' + esc(row[0]) + '|' + pr[0] + '"' + (pr[0] === 'owner' ? ' disabled' : '') + '>' + PERM_TXT[v] + '</button></td>';
                }).join('') + '</tr>';
              }).join('') +
              '</tbody></table></div>' +
              '</div>';
          }

          function mgLogHtml() {
            if (!ADMIN_LOG.length) return '';
            return '<div class="pos-card soft">' +
              '<div class="pos-card-head"><h3><i class="bi bi-journal-text" aria-hidden="true"></i> Audit log — this session</h3><span class="pos-muted">production writes these server-side</span></div>' +
              ADMIN_LOG.slice(-8).reverse().map(function (l) { return '<div class="feed-line">' + timeFmt(l.at) + ' · ' + esc(l.msg) + '</div>'; }).join('') +
              '</div>';
          }

          function renderManagement() {
            if (typeof mgWeekPickers !== 'undefined' && Array.isArray(mgWeekPickers)) {
              mgWeekPickers.forEach(function (picker) { if (picker && typeof picker.destroy === 'function') picker.destroy(); });
              mgWeekPickers = [];
            }
            var ps = payStats();
            html('[data-mgmt-body]', '<div class="pos-stack">' +
              mgKpisHtml(ps) +
              '<div class="mg-split">' + mgRevenueHtml() + mgPayrollHtml(ps) + '</div>' +
              mgPerfHtml(ps) +
              mgOwnerHtml(ps) +
              mgSmartHtml(ps) +
              mgPayoutHtml(ps) +
              mgServicesHtml() +
              mgStaffHtml() +
              mgRolesHtml() +
              mgLogHtml() +
              mgSkillsHtml() +
              mgSvcSkillHtml() +
              '</div>');
            if (typeof initMgWeekPickers === 'function') initMgWeekPickers();
          }

          /* ── management: clicks ── */
          document.addEventListener('click', function (e) {
            if (!e.target.closest('[data-pos-panel="management"]')) return;

            var serviceView = e.target.closest('[data-mg-service-view-target]');
            if (serviceView) {
              serviceViewMode = serviceView.getAttribute('data-mg-service-view-target') === 'card' ? 'card' : 'table';
              resetServiceCategoryCollapses();
              renderManagement();
              return;
            }

            var payrollView = e.target.closest('[data-mg-payroll-view-target]');
            if (payrollView) { mgPayrollViewMode = payrollView.getAttribute('data-mg-payroll-view-target') === 'card' ? 'card' : 'table'; renderManagement(); return; }

            var perfView = e.target.closest('[data-mg-perf-view-target]');
            if (perfView) { mgPerfViewMode = perfView.getAttribute('data-mg-perf-view-target') === 'card' ? 'card' : 'table'; renderManagement(); return; }

            var ownerView = e.target.closest('[data-mg-owner-view-target]');
            if (ownerView) { mgOwnerViewMode = ownerView.getAttribute('data-mg-owner-view-target') === 'card' ? 'card' : 'table'; renderManagement(); return; }

            var smartView = e.target.closest('[data-mg-smart-view-target]');
            if (smartView) { mgSmartViewMode = smartView.getAttribute('data-mg-smart-view-target') === 'card' ? 'card' : 'table'; renderManagement(); return; }

            var payoutView = e.target.closest('[data-mg-payout-view-target]');
            if (payoutView) { mgPayoutViewMode = payoutView.getAttribute('data-mg-payout-view-target') === 'card' ? 'card' : 'table'; renderManagement(); return; }

            var svcSkillView = e.target.closest('[data-mg-svcskill-view-target]');
            if (svcSkillView) { mgSvcSkillViewMode = svcSkillView.getAttribute('data-mg-svcskill-view-target') === 'card' ? 'card' : 'table'; renderManagement(); return; }

            var staffView = e.target.closest('[data-mg-staff-view-target]');
            if (staffView) { mgStaffViewMode = staffView.getAttribute('data-mg-staff-view-target') === 'card' ? 'card' : 'table'; renderManagement(); return; }

            var categoryView = e.target.closest('[data-mg-category-view-target]');
            if (categoryView) { serviceCategoryViewMode = categoryView.getAttribute('data-mg-category-view-target') === 'card' ? 'card' : 'table'; renderManagement(); return; }

            var categoryManagerToggle = e.target.closest('[data-mg-category-manager-toggle]');
            if (categoryManagerToggle) {
              serviceCategoryManagerCollapsed = !serviceCategoryManagerCollapsed;
              renderManagement();
              return;
            }

            var categoryAdd = e.target.closest('[data-mg-category-add]');
            if (categoryAdd) {
              openCategoryModal(null, 'add');
              return;
            }

            var categoryView = e.target.closest('[data-mg-category-view]');
            if (categoryView) {
              openCategoryModal(categoryView.getAttribute('data-mg-category-view'), 'view');
              return;
            }

            var categoryEdit = e.target.closest('[data-mg-category-edit]');
            if (categoryEdit) {
              openCategoryModal(categoryEdit.getAttribute('data-mg-category-edit'), 'edit');
              return;
            }

            if (e.target.closest('[data-mg-category-save]')) { saveCategoryModal(); return; }

            if (e.target.closest('[data-mg-category-cancel]') || e.target.matches('[data-mg-category-modal]')) { closeCategoryModal(); return; }

            var categoryDelete = e.target.closest('[data-mg-category-delete]');
            if (categoryDelete) {
              var deleteCategoryKey = categoryDelete.getAttribute('data-mg-category-delete');
              var deleteCategoryRow = categoryRowByKey(deleteCategoryKey);
              if (!deleteCategoryRow) return;
              confirmBox('Delete category ' + deleteCategoryRow.name + '?', 'The category and its services will be hidden from Booking and Check-in while history stays intact.').then(function (ok) {
                if (!ok) return;
                if (setSalonCategoryActive(deleteCategoryKey, false)) {
                  renderManagement();
                  toast(deleteCategoryRow.name + ' category deleted', 'info');
                }
              });
              return;
            }

            var categoryRestore = e.target.closest('[data-mg-category-restore]');
            if (categoryRestore) {
              var restoreCategoryKey = categoryRestore.getAttribute('data-mg-category-restore');
              if (setSalonCategoryActive(restoreCategoryKey, true)) {
                renderManagement();
                toast('Category restored');
              }
              return;
            }

            var serviceCategoryAdd = e.target.closest('[data-mg-service-add-category]');
            if (serviceCategoryAdd) {
              openServiceModal(null, 'add', serviceCategoryAdd.getAttribute('data-mg-service-add-category'));
              return;
            }

            var serviceCategoryToggle = e.target.closest('[data-mg-service-category-toggle]');
            if (serviceCategoryToggle) {
              var serviceCategoryStateKey = serviceCategoryKey(serviceCategoryToggle.getAttribute('data-mg-service-category-toggle'));
              serviceCollapsedCategories[serviceCategoryStateKey] = !isServiceCategoryCollapsed(serviceCategoryToggle.getAttribute('data-mg-service-category-toggle'));
              renderManagement();
              return;
            }

            if (e.target.closest('[data-mg-service-add]')) {
              openServiceModal(null);
              return;
            }

            var serviceView = e.target.closest('[data-mg-service-view]');
            if (serviceView) {
              openServiceModal(serviceView.getAttribute('data-mg-service-view'), 'view');
              return;
            }

            var serviceEdit = e.target.closest('[data-mg-service-edit]');
            if (serviceEdit) {
              openServiceModal(serviceEdit.getAttribute('data-mg-service-edit'), 'edit');
              return;
            }

            if (e.target.closest('[data-mg-service-save]')) { saveServiceModal(); return; }

            if (e.target.closest('[data-mg-service-cancel]') || e.target.matches('[data-mg-service-modal]')) { closeServiceModal(); return; }

            var serviceDelete = e.target.closest('[data-mg-service-delete]');
            if (serviceDelete) {
              var deleteId = serviceDelete.getAttribute('data-mg-service-delete');
              var deleteService = serviceById(deleteId);
              if (!deleteService) return;
              confirmBox('Delete ' + deleteService.name + '?', 'The service will be hidden from Booking and Check-in, while old tickets keep their history.').then(function (ok) {
                if (!ok) return;
                saveSalonService(Object.assign({}, deleteService, { active: false }), 'Deleted service "' + deleteService.name + '"');
                toast(deleteService.name + ' deleted', 'info');
              });
              return;
            }

            var sk = e.target.closest('[data-mg-skill]');
            if (sk) {
              var pr = sk.getAttribute('data-mg-skill').split('|');
              var t = techById(pr[0]); if (!t) return;
              var name = pr[1];
              t.skills = t.skills || []; t.exp = t.exp || [];
              var i = t.skills.indexOf(name), xi = t.exp.indexOf(name);
              if (i < 0) t.skills.push(name);                          // — → ✓ Good
              else if (xi < 0) t.exp.push(name);                       // ✓ → ★ Expert
              else { t.skills.splice(i, 1); t.exp.splice(xi, 1); }     // ★ → off
              savePosTechnician(t);
              renderManagement(); return;
            }

            var ft = e.target.closest('[data-mg-fit]');
            if (ft) {
              var pf = ft.getAttribute('data-mg-fit').split('|');
              var tf = techById(pf[0]); if (!tf) return;
              tf.fit = tf.fit || [];
              var fi = tf.fit.indexOf(pf[1]);
              if (fi >= 0) tf.fit.splice(fi, 1); else tf.fit.push(pf[1]);
              savePosTechnician(tf);
              renderManagement(); return;
            }

            var pm = e.target.closest('[data-mg-perm]');
            if (pm) {
              var pp = pm.getAttribute('data-mg-perm').split('|');
              var row = permRow(pp[0]);
              if (!row || pp[1] === 'owner') return;
              row[pp[1]] = (row[pp[1]] + 1) % 3;
              logAdmin('🔐 "' + pp[0] + '" for ' + ROLE_LBL[pp[1]] + ' → ' + PERM_TXT[row[pp[1]]]);
              renderManagement(); return;
            }

            if (e.target.closest('[data-mg-smart]')) {
              SMART.on = !SMART.on;
              logAdmin('💎 Smart Commission ' + (SMART.on ? 'ON' : 'OFF') + ' — applies from the next pay period');
              renderManagement(); return;
            }

            var po = e.target.closest('[data-mg-payout]');
            if (po) {
              var p = PAYOUT[po.getAttribute('data-mg-payout')];
              if (!p || !p.method) return;
              p.st = 'paid'; p.paidAt = Date.now();
              logAdmin('💸 Paid ' + techName(po.getAttribute('data-mg-payout')) + ' via ' + PAYOUT_M[p.method]);
              renderManagement(); toast('Payout sent'); return;
            }

            var pst = e.target.closest('[data-mg-paysetup]');
            if (pst) {
              var pid = pst.getAttribute('data-mg-paysetup');
              var pr2 = PAYOUT[pid]; if (!pr2) return;
              pr2.method = 'vlink'; pr2.st = 'ready';
              var tv = techById(pid); if (tv && !tv.vlink) { tv.vlink = 'VL-' + Math.floor(10000 + Math.random() * 89999); savePosTechnician(tv); }
              logAdmin('🔗 Payout method set for ' + techName(pid) + ' → VLinkPay');
              renderManagement(); return;
            }

            var rp = e.target.closest('[data-mg-stpin]');
            if (rp) {
              var s = STAFF.find(function (x) { return x.id === rp.getAttribute('data-mg-stpin'); });
              if (s) { logAdmin('🔑 PIN reset for ' + s.name + ' — temporary PIN sent by SMS, must change on first login'); renderManagement(); toast('Temporary PIN sent to ' + s.name); }
              return;
            }

            if (e.target.closest('[data-mg-stadd]')) {
              var nameEl = $('[data-mg-stname]'), roleEl = $('[data-mg-strolenew]');
              var nm = (nameEl.value || '').trim();
              if (!nm) { toast('Enter an employee name', 'info'); return; }
              var role = roleEl.value;
              STAFF.push({ id: 'st' + (++stSeq), name: nm, ava: initials(nm), role: role });
              logAdmin('👥 Created ' + ROLE_LBL[role] + ' account: ' + nm + ' (temporary PIN sent by SMS)');
              renderManagement(); renderClock(); toast(nm + ' added');
              return;
            }

            if (e.target.closest('[data-mg-addtech]')) { openNewTechModal(); return; }

            var mgTechCombobox = e.target.closest('[data-mg-tech-combobox]');
            if (mgTechCombobox && !e.target.closest('[data-mg-tech-choice]')) { setMgTechSelectOpen(true); }

            var mgTechChoice = e.target.closest('[data-mg-tech-choice], [data-mg-tech-create]');
            if (mgTechChoice) { fillMgTechModalFromChoice(mgTechChoice); return; }

            if (e.target.closest('[data-mg-tech-cancel]') || e.target.matches('[data-mg-tech-modal]')) { closeTechModal(); return; }

            if (e.target.closest('[data-mg-tech-save]')) { saveTechModal(); return; }

            if (e.target.closest('[data-mg-tech-pin-generate]')) {
              $('[data-mg-tech-form-pin]').value = techModalRandomPin();
              return;
            }

            var mgTechModalEl = $('[data-mg-tech-modal]');
            if (mgTechModalEl && !mgTechModalEl.hidden && !e.target.closest('[data-mg-tech-combobox]')) {
              setMgTechSelectOpen(false);
            }

            var fr = e.target.closest('[data-mg-fire]');
            if (fr) {
              var fid = fr.getAttribute('data-mg-fire');
              var tfire = techById(fid); if (!tfire) return;
              confirmBox('Deactivate ' + tfire.name + '?', 'Production deactivates the account and keeps payroll history. Their appointments become unassigned.').then(function (ok) {
                if (!ok) return;
                var nextCatalog = salonData.loadCatalog();
                nextCatalog.technicians = nextCatalog.technicians.map(function (technician) {
                  return technician.id === fid ? Object.assign({}, technician, { active: false }) : technician;
                });
                salonData.saveCatalog(nextCatalog);
                BOOKINGS.slice().forEach(function (b) {
                  if (b.techId === fid) appointmentStore.update(b.id, { technicianId: null }, null, nextCatalog);
                });
                rebuildSalonCatalogViews();
                var si = STAFF.findIndex(function (s) { return s.id === fid; });
                if (si > -1) STAFF.splice(si, 1);
                delete PAYOUT[fid]; delete BEEP[fid];
                logAdmin('🚪 Deactivated ' + tfire.name + ' — payroll history kept, appointments released');
                renderManagement(); renderClock(); renderBookingTab(); toast(tfire.name + ' deactivated', 'info');
              });
              return;
            }
          });

          /* ── management: numeric / text edits ── */
          document.addEventListener('input', function (e) {
            if (!e.target.closest('[data-pos-panel="management"]')) return;

            if (e.target.matches('[data-mg-service-form-name], [data-mg-service-form-price], [data-mg-service-form-duration], [data-mg-service-form-description], [data-mg-service-form-includes]')) {
              updateServiceModalSummary();
              return;
            }

            if (e.target.matches('[data-mg-tech-form-phone]')) { e.target.value = formatUsPhoneInput(e.target.value); return; }

            if (e.target.matches('[data-mg-tech-search]')) { filterMgTechChoices(e.target.value); setMgTechSelectOpen(true); return; }
          });

          document.addEventListener('focusin', function (e) {
            if (e.target.matches('[data-mg-tech-select-input]')) setMgTechSelectOpen(true);
          });

          document.addEventListener('focusout', function (e) {
            if (!e.target.closest('[data-pos-panel="management"]')) return;

            var c = e.target.closest('[data-mg-comm]');
            if (c) {
              var t = techById(c.getAttribute('data-mg-comm')); if (!t) return;
              var v = Math.min(100, Math.max(0, parseFloat(c.value) || 0)) / 100;
              if (v !== t.comm) logAdmin('💰 ' + t.name + ' commission ' + Math.round(t.comm * 100) + '% → ' + Math.round(v * 100) + '%');
              t.comm = v; savePosTechnician(t); renderManagement(); return;
            }
            var g = e.target.closest('[data-mg-guar]');
            if (g) {
              var tg2 = techById(g.getAttribute('data-mg-guar')); if (!tg2) return;
              var gv = Math.max(0, parseFloat(g.value) || 0);
              if (gv !== tg2.guar) logAdmin('💰 ' + tg2.name + ' weekly guarantee ' + money0(tg2.guar) + ' → ' + money0(gv));
              tg2.guar = gv; savePosTechnician(tg2); renderManagement(); return;
            }
            var sp = e.target.closest('[data-mg-split]');
            if (sp) {
              var ts = techById(sp.getAttribute('data-mg-split')); if (!ts) return;
              ts.baoSplit = Math.min(100, Math.max(0, parseFloat(sp.value) || 0)) / 100;
              savePosTechnician(ts); renderManagement(); return;
            }
            var mr = e.target.closest('[data-mg-mr]');
            if (mr) { MATCH_RULES[mr.getAttribute('data-mg-mr')] = Math.max(0, parseFloat(mr.value) || 0); renderManagement(); return; }
            var sm = e.target.closest('[data-mg-sm]');
            if (sm) { SMART[sm.getAttribute('data-mg-sm')] = Math.max(0, parseFloat(sm.value) || 0); renderManagement(); return; }
          });

          /* ── management: selects & checkboxes ── */
          document.addEventListener('change', function (e) {
            if (!e.target.closest('[data-pos-panel="management"]')) return;

            var payrollDate = e.target.closest('[data-mg-payroll-date]');
            if (payrollDate) {
              mgPayrollDate = payrollDate.value || mgPayrollToday;
              renderManagement();
              return;
            }

            var perfWeek = e.target.closest('[data-mg-perf-week], [data-mg-owner-week]');
            if (perfWeek) {
              mgPerfWeek = performanceWeekStartKey(perfWeek.value || mgPerfCurrentWeek);
              renderManagement();
              return;
            }

            if (e.target.matches('[data-mg-service-form-category], [data-mg-service-form-skill], [data-mg-service-form-type], [data-mg-service-form-active]')) {
              updateServiceModalSummary();
              return;
            }

            if (e.target.matches('[data-mg-tech-form-role], [data-mg-tech-form-paymodel]')) {
              updateTechModalPayVisibility();
              return;
            }

            if (e.target.matches('[data-mg-tech-day-off]')) { syncMgTechDayOffRow(e.target); return; }

            if (e.target.matches('[data-mg-tech-service-all]')) {
              document.querySelectorAll('[data-mg-tech-service]').forEach(function (option) { option.checked = e.target.checked; });
              syncMgTechServiceCheckAll();
              return;
            }

            var mgTechServiceCategoryAll = e.target.closest('[data-mg-tech-service-category-all]');
            if (mgTechServiceCategoryAll) {
              mgTechServiceOptionsForCategory(mgTechServiceCategoryAll.getAttribute('data-mg-tech-service-category-all')).forEach(function (option) { option.checked = mgTechServiceCategoryAll.checked; });
              syncMgTechServiceCheckAll();
              return;
            }

            if (e.target.matches('[data-mg-tech-service]')) { syncMgTechServiceCheckAll(); return; }

            var sr = e.target.closest('[data-mg-strole]');
            if (sr) {
              var s = STAFF.find(function (x) { return x.id === sr.getAttribute('data-mg-strole'); });
              if (s && s.role !== 'owner') {
                logAdmin('👥 ' + s.name + ': ' + ROLE_LBL[s.role] + ' → ' + ROLE_LBL[sr.value] + ' (applies at next login)');
                s.role = sr.value;
                renderManagement(); renderClock();
              }
              return;
            }
            var m = e.target.closest('[data-mg-model]');
            if (m) {
              var tm = techById(m.getAttribute('data-mg-model'));
              if (tm) { logAdmin('💼 ' + tm.name + ' pay model → ' + PAY_MODELS[m.value] + ' (applies from the next pay period)'); tm.payModel = m.value; savePosTechnician(tm); }
              renderManagement(); return;
            }
            var sq = e.target.closest('[data-mg-svcreq]');
            if (sq) {
              var cid = sq.getAttribute('data-mg-svcreq');
              SVC_REQ[cid] = sq.value;
              var cat = catById(cid);
              logAdmin('🧾 "' + (cat ? cat.label : cid) + '" → skill ' + (sq.value || 'none required'));
              renderManagement(); return;
            }
            if (e.target.closest('[data-mg-mruse]')) { MATCH_RULES.useTurn = e.target.checked; renderManagement(); return; }
            var ov = e.target.closest('[data-mg-mrovr]');
            if (ov) { MATCH_RULES.override = ov.value; logAdmin('⚙️ Wrong-skill override mode → ' + ov.value); renderManagement(); return; }
          });

          /* ═══════════ 📅 APPOINTMENTS ═══════════ */
          var appointmentStore = window.NEXORA_APPOINTMENTS_STORE;
          var BOOKINGS = [];
          function posServiceDisplayName(value) {
            return String(value == null ? '' : value).replace(/^\s*[^\wÀ-ỹ]+/i, '').trim();
          }
          function posBookingClock(date) {
            var hour = date.getHours();
            return (hour % 12 || 12) + ':' + String(date.getMinutes()).padStart(2, '0') + ' ' + (hour >= 12 ? 'PM' : 'AM');
          }
          function posBookingRelativeDay(start) {
            var key = String(start || '').slice(0, 10);
            var today = new Date().toISOString().slice(0, 10);
            var tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            if (key === today) return 'today';
            if (key === tomorrow.toISOString().slice(0, 10)) return 'tomorrow';
            return 'future';
          }
          function posBookingById(id) {
            return BOOKINGS.find(function (booking) { return String(booking.id) === String(id); }) || null;
          }
          function posBookingView(record) {
            var names = record.serviceNames || [];
            var serviceLabels = names.map(function (name, index) {
              var service = salonData.findService(salonCatalog, (record.serviceIds || [])[index] || name);
              return service ? service.name : posServiceDisplayName(name);
            });
            if (!serviceLabels.length) {
              serviceLabels = (record.serviceIds || []).map(function (id) {
                var service = salonData.findService(salonCatalog, id);
                return service ? service.name : posServiceDisplayName(id);
              });
            }
            return Object.assign({}, record, {
              start: record.startAt,
              end: record.endAt,
              name: record.customerName || 'Guest',
              phone: record.phone || '',
              source: record.source || 'front-desk',
              techId: record.technicianId,
              techName: record.technicianName || '',
              svc: serviceLabels.join(' + '),
              serviceDetails: (Array.isArray(record.serviceDetails) ? record.serviceDetails : names.map(function (name, index) {
                var service = salonData.findService(salonCatalog, (record.serviceIds || [])[index] || name);
                return service ? { id: service.id, name: posServiceDisplayName(service.name), price: service.price, durationMin: service.durationMin } : { name: posServiceDisplayName(name), price: null, durationMin: null };
              })).map(function (detail) {
                return Object.assign({}, detail || {}, { name: posServiceDisplayName(detail && detail.name) });
              }),
              time: record.startAt ? posBookingClock(new Date(record.startAt)) : '',
              day: posBookingRelativeDay(record.startAt),
              eta: record.metadata && record.metadata.eta ? record.metadata.eta : null
            });
          }
          function reloadAppointmentSnapshot() {
            BOOKINGS = appointmentStore.loadAll(null, salonCatalog).filter(function (record) {
              return record.status !== 'cancelled' && record.startAt && record.endAt;
            }).map(posBookingView);
          }
          function updateAppointmentMetadata(id, metadataPatch) {
            var booking = posBookingById(id);
            if (!booking) return null;
