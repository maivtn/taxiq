              var tip = ps[t.id] ? ps[t.id].tip : 0;
              var po = PAYOUT[t.id] || (PAYOUT[t.id] = { st: 'pending', method: t.vlink ? 'vlink' : null });
              return { t: t, pay: pay, tip: tip, tot: pay + tip, po: po };
            });
            var pendTot = rows.filter(function (r) { return r.po.st !== 'paid'; }).reduce(function (s, r) { return s + r.tot; }, 0);
            var tipTot = rows.reduce(function (s, r) { return s + r.tip; }, 0);
            var readyN = rows.filter(function (r) { return r.po.st === 'ready'; }).length;
            var missN = rows.filter(function (r) { return !r.po.method; }).length;

            var payoutRowHtml = function (r) {
