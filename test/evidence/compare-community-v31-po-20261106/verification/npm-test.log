                  '<button class="perf-cta-btn perf-cta-btn-danger" data-wcancel="' + w.id + '" title="Cancel"><i class="bi bi-x-lg" aria-hidden="true"></i> Cancel</button>' +
                '</div></article>';
            }
            if (w.status === 'ready') {
              var rdyMin = w.readyAtMs ? Math.max(0, Math.floor((now - w.readyAtMs) / 60000)) : 0;
              return '<article class="wl-card queue-card perf-card rdy" data-queue-ticket-id="' + w.id + '">' +
                ticketCardBodyHtml(w, w.readyAtMs ? rdyMin + "' to pay" : '—', ticketStatusBadge('ready')) +
                '<div class="perf-divider"></div>' +
