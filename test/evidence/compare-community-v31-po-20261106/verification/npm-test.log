        #nx-campaign-root .schedule-opt-label { font-size: 12px; font-weight: 700; }
        #nx-campaign-root .time-input-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
        #nx-campaign-root .confirm-box { display: none; margin-bottom: 16px; border: 1px solid rgba(245, 158, 11, 0.35); border-radius: 12px; background: rgba(245, 158, 11, 0.09); padding: 14px 16px; }
        #nx-campaign-root .confirm-box.show { display: block; }
        #nx-campaign-root .confirm-title { display: flex; align-items: center; gap: 7px; margin-bottom: 8px; color: #9a5a00; font-size: 13px; font-weight: 800; }
        #nx-campaign-root .confirm-detail { color: var(--nexora-muted); font-size: 13px; line-height: 1.7; }
        #nx-campaign-root .confirm-detail strong { color: var(--nexora-text); }
        #nx-campaign-root .success-banner { display: none; position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); z-index: 140; align-items: center; gap: 10px; border: 1px solid rgba(0, 184, 115, 0.4); border-radius: 12px; background: #fff; padding: 13px 18px; box-shadow: 0 18px 44px rgba(8, 31, 73, 0.18); }
        #nx-campaign-root .success-banner.show { display: flex; }
