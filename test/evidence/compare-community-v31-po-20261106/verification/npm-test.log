      <script src="../assets/salon-data.js"></script>
      <script src="../assets/appointment-service-catalog.js"></script>
      <script src="../assets/appointment-tickets.js"></script>
      <script src="../assets/appointments-store.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/@daypilot/daypilot-lite-javascript@5.9.0/daypilot-javascript.min.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/plugins/weekSelect/weekSelect.js"></script>
      <script src="https://unpkg.com/lucide@1.23.0/dist/umd/lucide.min.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
      <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
      <script>
        window.NEXORA_SHELL = { activePage: 'pos', activeTab: 'checkin' };
      </script>
      <script src="../assets/nexora-icons.js"></script>
      <script src="../assets/nexora-shell-nav.js?v=20261029-sidebar-group-labels"></script>
      <script src="../assets/nexora-shell.js?v=20261030-header-nine-dots-v48"></script>
      <script src="../assets/booking-demo-date.js"></script>
      <script src="../assets/pos-booking-runtime.js"></script>
      <script src="../assets/pos-customer-import.js"></script>
      <script src="../assets/pos-printer-settings.js"></script>
      <script src="../assets/pos-estimate.js"></script>
      <script>
        (function () {
          'use strict';

          /* ═══════════ helpers ═══════════ */
          function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
          function escPlain(s) { return String(s == null ? '' : s); }
          function money(n) { return '$' + (Math.round((n || 0) * 100) / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
          function money0(n) { return '$' + Math.round(n || 0).toLocaleString('en-US'); }
          function pct(n) { return Math.round((n || 0) * 100) + '%'; }
          function $(sel) { return document.querySelector(sel); }
          function set(sel, v) { var e = $(sel); if (e) e.textContent = v; }
          function html(sel, v) { var e = $(sel); if (e) e.innerHTML = v; }
          function initials(n) { return String(n).split(' ').map(function (x) { return x[0]; }).join('').slice(0, 2).toUpperCase(); }
          function toast(title, icon) { if (window.Swal) Swal.fire({ icon: icon || 'success', title: title, timer: 1400, showConfirmButton: false }); }
          function confirmBox(title, text) {
            if (!window.Swal) return Promise.resolve(window.confirm(title));
            return Swal.fire({ icon: 'warning', title: title, text: text, showCancelButton: true, confirmButtonText: 'Confirm', cancelButtonText: 'Cancel' })
              .then(function (r) { return !!r.isConfirmed; });
          }
          function serviceStartedModal(w, t) {
            if (window.Swal) {
              Swal.fire({ icon: 'success', title: 'Service started', text: escPlain(w.name) + ' is now in service with ' + escPlain(t.name), confirmButtonText: 'OK' });
              return;
            }
            if (window.alert) window.alert('Service started');
          }
          var timeFmt = function (ms) { return new Date(ms).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }); };
          function nowTime() { return timeFmt(Date.now()); }

          // Screens 1366px and narrower (iPad landscape and below) default every table/card
          // toggle to card view — tables force horizontal scroll at that width, cards don't.
          var DEFAULT_VIEW_MODE = window.innerWidth <= 1366 ? 'card' : 'table';

          /* ═══════════ shared state (ported from the prototype) ═══════════ */
          var ROLE_LBL = { owner: 'Owner', manager: 'Manager', frontdesk: 'Front Desk', tech: 'Technician' };
          var ROLE_ACCESS = { owner: 'All screens', manager: 'All except Affiliate config', frontdesk: 'Operations · Register · Appointments · Time Clock', tech: 'Staff App · Time Clock' };
          var POS_DEMO_PIN = '1234';
          var activeStaffId = 'owner';
          var selectedStaffId = 'owner';
          var activeTabId = 'todaybooking';

          var STAFF = [
            { id: 'owner', name: 'Brian', ava: 'B', role: 'owner' },
            { id: 'mgr1', name: 'Mia', ava: 'M', role: 'manager' },
            { id: 'cash1', name: 'Cindy', ava: 'C', role: 'frontdesk' },
            { id: 't1', name: 'Tina', ava: 'T', role: 'tech' },
            { id: 't2', name: 'Kim', ava: 'K', role: 'tech' },
            { id: 't3', name: 'Helen', ava: 'H', role: 'tech' },
            { id: 't4', name: 'Andy', ava: 'A', role: 'tech' },
            { id: 't5', name: 'Vy', ava: 'V', role: 'tech' }
          ];
          var stSeq = 0;

          function getActiveStaff() {
            return STAFF.find(function (staff) { return staff.id === activeStaffId; }) || STAFF[0];
          }

          var modeModal = $('[data-pos-mode-modal]');
          var modeOpenButton = $('[data-pos-mode-open]');
          var modePin = $('[data-pos-mode-pin]');
          var modeError = $('[data-pos-mode-error]');

          function setModeError(message) {
            modeError.textContent = message || '';
            modeError.hidden = !message;
          }

          function updateModeRoleCards(role) {
            document.querySelectorAll('[data-pos-role]').forEach(function (card) {
              var selected = card.getAttribute('data-pos-role') === role;
              card.classList.toggle('is-selected', selected);
              card.setAttribute('aria-pressed', String(selected));
            });
          }

          function selectModeRole(role) {
            var selected = STAFF.find(function (staff) {
              return staff.role === role && ['owner', 'manager', 'frontdesk'].indexOf(staff.role) !== -1;
            });
            if (!selected) return;
            selectedStaffId = selected.id;
            updateModeRoleCards(selected.role);
            setModeError('');
          }

          function openModeModal() {
            selectedStaffId = activeStaffId;
            updateModeRoleCards(getActiveStaff().role);
            modePin.value = '';
            setModeError('');
            modeModal.classList.add('open');
            modeModal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            setTimeout(function () { modePin.focus(); }, 0);
          }

          function closeModeModal() {
            modeModal.classList.remove('open');
            modeModal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
            setModeError('');
            if (modeOpenButton) modeOpenButton.focus();
          }

          function submitModeSwitch() {
            var selected = STAFF.find(function (staff) { return staff.id === selectedStaffId; });
            if (!selected) { setModeError('Hãy chọn một tài khoản.'); return; }
            if (modePin.value !== POS_DEMO_PIN) {
              setModeError('PIN không đúng. PIN demo là 1234.');
              modePin.focus();
              return;
            }
            activeStaffId = selectedStaffId;
            applyPosModeAccess();
            closeModeModal();
          }

          function applyPosModeAccess() {
            var active = getActiveStaff();
            var isFrontDesk = active.role === 'frontdesk';
            var managementTab = $('[data-pos-tab="management"]');
            var managementPanel = $('[data-pos-panel="management"]');
            var modeBadge = $('[data-pos-mode-badge-text]');
            if (modeBadge) modeBadge.textContent = ROLE_LBL[active.role] + ' · ' + active.name;
            if (managementTab) {
              managementTab.hidden = isFrontDesk;
              managementTab.setAttribute('aria-hidden', String(isFrontDesk));
            }
            if (managementPanel) {
              managementPanel.hidden = isFrontDesk;
              managementPanel.setAttribute('aria-hidden', String(isFrontDesk));
            }
            if (isFrontDesk && activeTabId === 'management') activateTab('todaybooking');
          }

          var salonData = window.NEXORA_SALON_DATA;
          var appointmentServiceCatalogLoader = window.NEXORA_APPOINTMENT_SERVICE_CATALOG;
          var SERVICE_MENU_URL = '../menu/menu.json';
          var salonCatalog = salonData.loadCatalog();
          var SKILLS = [];
          var FIT_TAGS = ['VIP', 'New guest', 'Needs Extra Care', 'Sensitive Skin', 'Prefers Female Tech'];
          var TAG_LIB = ['Needs Extra Care', 'Sensitive Skin', 'Prefers Female Tech', 'Likes Warm Water', 'Confirm Price Before Add-on', 'Allergic to Acrylic'];

          // Technician and service definitions come from the salon-level catalog.
          // POS-only payroll fields stay under posProfile so other booking surfaces
          // can use the same roster without inheriting POS concerns.
          var TECHS = null;
          var MENU = null;
          var SVC_REQ = {};
          function legacyServiceGroupKey(service) {
            var text = (service.categoryName || service.requiredSkill || service.name || '').toLowerCase();
            if (/pedicure/.test(text)) return 'pedi';
            if (/manicure/.test(text)) return 'mani';
            if (/full set/.test(text)) return 'full';
            if (/fill/.test(text)) return 'fill';
            if (/dipping|dip/.test(text)) return 'dip';
            if (/gel/.test(text)) return 'gel';
            if (/wax/.test(text)) return 'wax';
            if (/add-on|additional|design|chrome|art/.test(text)) return 'addon';
            if (/kid/.test(text)) return 'kid';
            return '';
          }
          function rebuildSalonCatalogViews() {
            salonCatalog = salonData.loadCatalog();
            SKILLS = Array.from(new Set(salonCatalog.services.map(function (service) { return service.requiredSkill; }).filter(Boolean).concat(['Design'])));
            TECHS = salonCatalog.technicians.filter(function (technician) { return technician.active; }).map(function (technician) {
              return Object.assign({ bnum: null, turns: 0, comm: 0, guar: 0, payModel: 'max', baoSplit: 0, vlink: null }, technician.posProfile || {}, {
                id: technician.id,
                name: technician.name,
                skills: technician.skills || [],
                exp: technician.exp || [],
                fit: technician.fit || []
              });
            });
            MENU = salonCatalog.services.filter(function (service) { return service.active; }).map(function (service) {
              return { id: service.id, label: posServiceDisplayName(service.name), price: service.price, durationMin: service.durationMin, requiredSkill: service.requiredSkill || '', categoryId: service.categoryId || '', categoryName: service.categoryName || '', type: service.type || '' };
            });
            SVC_REQ = {};
            salonCatalog.services.forEach(function (service) {
              var requiredSkill = service.requiredSkill || '';
              SVC_REQ[service.id] = requiredSkill;
              if (service.categoryId && !SVC_REQ[service.categoryId]) SVC_REQ[service.categoryId] = requiredSkill;
              var legacyKey = legacyServiceGroupKey(service);
              if (legacyKey && !SVC_REQ[legacyKey]) SVC_REQ[legacyKey] = requiredSkill;
            });
          }
          rebuildSalonCatalogViews();
          function techById(id) { for (var i = 0; i < TECHS.length; i++) if (TECHS[i].id === id) return TECHS[i]; return null; }
          function techName(id) { var t = techById(id); return t ? t.name : '—'; }
          function savePosTechnician(tech) {
            if (!tech) return;
            var nextCatalog = salonData.loadCatalog();
            var existing = salonData.findTechnician(nextCatalog, tech.id);
            if (!existing) return;
            var nextTechnicians = nextCatalog.technicians.map(function(technician) {
              if (technician.id !== tech.id) return technician;
              return Object.assign({}, technician, {
                name: tech.name,
                skills: tech.skills || [],
                exp: tech.exp || [],
                fit: tech.fit || [],
                posProfile: Object.assign({}, technician.posProfile || {}, {
                  bnum: tech.bnum,
                  turns: tech.turns,
                  comm: tech.comm,
                  guar: tech.guar,
                  payModel: tech.payModel,
                  baoSplit: tech.baoSplit,
                  vlink: tech.vlink
                })
              });
            });
            salonData.saveCatalog(Object.assign({}, nextCatalog, { technicians: nextTechnicians }));
            rebuildSalonCatalogViews();
          }

          function refreshSalonCatalogConsumers() {
            rebuildSalonCatalogViews();
            renderFloor();
            renderManagement();
            renderBookingTab();
          }

          function loadMenuServicesIntoSalonCatalog() {
            if (!appointmentServiceCatalogLoader || typeof appointmentServiceCatalogLoader.load !== 'function') return;
            if (!salonData.seedServicesFromMenuCatalog) return;
            appointmentServiceCatalogLoader.load(SERVICE_MENU_URL).then(function (menuCatalog) {
              var seeded = salonData.seedServicesFromMenuCatalog(salonData.loadCatalog(), menuCatalog);
              if (!seeded.seeded) return;
              salonData.saveCatalog(seeded.catalog);
              refreshSalonCatalogConsumers();
            }).catch(function () {
              // Keep the bundled fallback catalog when menu.json cannot be fetched in a local preview.
            });
          }

          function catById(id) { for (var i = 0; i < MENU.length; i++) if (MENU[i].id === id) return MENU[i]; return null; }
          function queueServiceForName(svc) {
            return salonData.findService(salonCatalog, svc);
          }
          function queueServiceCategory(service, svc) {
            if (service) return legacyServiceGroupKey(service) || service.categoryId || '';
            return legacyServiceGroupKey({ name: svc, categoryName: svc });
          }
          function queueDurationForService(svc) {
            var service = queueServiceForName(svc);
            return service ? service.durationMin || 0 : 0;
          }
          function queueItemForService(service, techId, serviceTicketId) {
            var serviceName = posServiceDisplayName(service && (service.label || service.name) || '');
            return {
              serviceId: service && service.id ? String(service.id) : '',
              serviceTicketId: serviceTicketId == null ? null : String(serviceTicketId),
              name: serviceName,
              price: Number(service && service.price) || 0,
              durationMin: Number(service && service.durationMin) || 0,
              techId: techId || null,
              cat: queueServiceCategory(service, serviceName)
            };
          }
          function queueItemsForService(svc, techId) {
            var service = salonData.findService(salonCatalog, svc);
            if (!service) service = { id: '', label: posServiceDisplayName(svc || ''), price: 0, durationMin: 0 };
            return service.label || service.name ? [queueItemForService(service, techId || null, null)] : [];
          }
          function queueTicketServiceIds(w) {
            var ids = [];
            (w && w.items || []).forEach(function (item) {
              var id = item && item.serviceTicketId;
              if (id != null && ids.indexOf(String(id)) === -1) ids.push(String(id));
            });
            (w && w.serviceTicketIds || []).forEach(function (id) {
              if (id != null && ids.indexOf(String(id)) === -1) ids.push(String(id));
            });
            if (w && w.serviceTicketId != null && ids.indexOf(String(w.serviceTicketId)) === -1) ids.push(String(w.serviceTicketId));
            return ids;
          }
          function normalizeQueueTicketServices(w) {
            var legacyDuration = Number(w.durationMin) || 0;
            if (!Array.isArray(w.items)) w.items = [];
            if (!w.items.length && w.svc) w.items = queueItemsForService(w.svc, w.techId || w.reqTech || null);
            w.items = w.items.map(function (item) {
              var service = salonData.findService(salonCatalog, item.serviceId || item.name);
              return {
                serviceId: String(item.serviceId || (service && service.id) || ''),
                serviceTicketId: item.serviceTicketId == null ? null : String(item.serviceTicketId),
                name: posServiceDisplayName(item.name || (service && (service.label || service.name)) || ''),
                price: Number(item.price != null ? item.price : service && service.price) || 0,
                durationMin: Number(item.durationMin != null ? item.durationMin : service && service.durationMin) || 0,
                techId: w.techId || w.reqTech || item.techId || null,
