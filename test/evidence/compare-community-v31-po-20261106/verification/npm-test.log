  code: 'ERR_ASSERTION'
  name: 'AssertionError'
  expected:
  actual: |-
    /* ==========================================================================
       Nexora shared shell — sidebar + header
       Single source of truth for the merchant sidebar and top header, used by
       every page that includes nexora-shell.js. Load this AFTER a page's inline
       <style> so it governs the shell consistently across pages.
       ========================================================================== */

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      min-height: 100%;
      font-family: "Inter", sans-serif;
      background: var(--nexora-canvas);
      color: var(--nexora-text);
    }

    button,
    input,
    textarea,
    select {
      font: inherit;
    }

    .credits-history-date {
      display: grid;
      gap: 2px;
      color: var(--nexora-text);
      font-size: 12px;
      font-weight: 800;
      line-height: 16px;
      white-space: nowrap;
    }

    .credits-history-date small {
      display: block;
      color: var(--nexora-text);
      font-size: 11px;
      font-weight: 700;
      line-height: 14px;
    }

    :root {
      --luxury-gold: #d4af37;
      --brand-cyan: #32d7ff;
      --nexora-canvas: #f7f9fc;
      --nexora-surface: #ffffff;
      --nexora-surface-muted: #f3f6fa;
      --nexora-border: #dde5ef;
      --nexora-rule: #e7ecf3;
      --nexora-text: #0b1220;
      --nexora-muted: #4d5870;
      --nexora-subtle: #7a8296;
      --nexora-sidebar: #081f49;
      --nexora-brand: #4648d8;
      --nexora-brand-dark: #393bc8;
      --nexora-electric: #2b59ff;
      --nexora-violet: #8e4df8;
      --nexora-success: #00b873;
      --nexora-warning: #f59e0b;
      --nexora-danger: #ef4444;
      --nexora-card-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
      --nexora-soft-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
    }

    .shell {
      min-height: 100vh;
      background: var(--nexora-canvas);
    }

    /* ── sidebar shell ─────────────────────────────────────────────────────── */
    .sidebar {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 30;
      display: none;
      width: 288px;
      flex-direction: column;
      background: var(--nexora-sidebar);
      color: #fff;
      padding: 28px 20px;
    }

    .sidebar-panel {
      flex-shrink: 0;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.05);
      padding: 8px;
    }

    .profile-row {
      display: flex;
      min-width: 0;
      align-items: center;
      gap: 12px;
    }

    .avatar {
      display: inline-flex;
      width: 40px;
      height: 40px;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--nexora-electric), var(--nexora-violet));
      color: #fff;
      font-size: 13px;
      font-weight: 800;
      text-transform: uppercase;
    }

    .profile-name {
      overflow: hidden;
      color: #fff;
      font-size: 14px;
      font-weight: 700;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .profile-email {
      margin-top: 2px;
      overflow: hidden;
      color: rgba(255, 255, 255, 0.6);
      font-size: 11px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .plan-panel {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-top: 16px;
      margin-bottom: 12px;
      padding: 10px 12px;
    }

    .plan-info {
      min-width: 0;
    }

    .panel-kicker {
      color: rgba(255, 255, 255, 0.45);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .panel-title {
      margin-top: 2px;
      color: #fff;
      font-size: 13px;
      font-weight: 900;
    }

    .plan-button {
      flex-shrink: 0;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 8px;
      background: transparent;
      padding: 6px 12px;
      color: var(--luxury-gold);
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s;
    }

    .plan-button:hover {
      border-color: rgba(255, 255, 255, 0.25);
      background: rgba(255, 255, 255, 0.05);
    }

    .sidebar-nav {
      margin-top: 24px;
      flex: 1;
      overflow-y: auto;
      padding-right: 4px;
    }

    .nav-divider {
      margin: 4px 0;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .nav-item {
      display: flex;
      width: 100%;
      height: 48px;
      align-items: center;
      gap: 12px;
      border: 0;
      border-radius: 8px;
      background: transparent;
      padding: 0 16px;
      color: rgba(255, 255, 255, 0.85);
      text-align: left;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.2s, color 0.2s, box-shadow 0.2s;
    }

    .nav-item:hover {
      background: rgba(255, 255, 255, 0.05);
      color: #fff;
    }

    .nav-item.is-active {
      background: linear-gradient(90deg, var(--nexora-electric), var(--nexora-violet));
      color: #fff;
      box-shadow: 0 10px 24px rgba(43, 89, 255, 0.2);
    }

    .sidebar-icon-wrap {
      display: inline-flex;
      width: 30px;
      height: 30px;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
    }

    .sidebar-icon {
      width: 24px;
      height: 24px;
      object-fit: contain;
      filter: brightness(1.15) saturate(1.2) contrast(1.05)
        drop-shadow(0 0 3px rgba(255, 66, 215, 0.3))
        drop-shadow(0 0 6px rgba(50, 215, 255, 0.2));
      transition: filter 0.2s, transform 0.2s;
    }

    .nav-item:hover .sidebar-icon,
    .nav-item.is-active .sidebar-icon {
      filter: brightness(1.3) saturate(1.35) contrast(1.1)
        drop-shadow(0 0 4px rgba(255, 66, 215, 0.45))
        drop-shadow(0 0 8px rgba(50, 215, 255, 0.35))
        drop-shadow(0 0 12px rgba(138, 92, 255, 0.25));
      transform: scale(1.04);
    }

    .nav-item:hover .sidebar-icon-wrap,
    .nav-item.is-active .sidebar-icon-wrap {
      background: radial-gradient(
        circle,
        rgba(138, 92, 255, 0.24) 0%,
        rgba(50, 215, 255, 0.08) 45%,
        transparent 72%
      );
    }

    .lucide-menu-icon {
      display: block;
      width: 22px;
      height: 22px;
      color: #fff;
      filter: drop-shadow(0 0 4px rgba(255, 66, 215, 0.32))
        drop-shadow(0 0 8px rgba(50, 215, 255, 0.24));
      transition: filter 0.2s, transform 0.2s;
    }

    .nav-item:hover .lucide-menu-icon,
    .nav-item.is-active .lucide-menu-icon {
      filter: drop-shadow(0 0 4px rgba(255, 66, 215, 0.45))
        drop-shadow(0 0 8px rgba(50, 215, 255, 0.35))
        drop-shadow(0 0 12px rgba(138, 92, 255, 0.25));
      transform: scale(1.04);
    }

    .lucide-menu-icon path,
    .lucide-menu-icon rect,
    .lucide-menu-icon circle,
    .lucide-menu-icon line,
    .lucide-menu-icon polyline {
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* ── expandable nav groups ─────────────────────────────────────────────── */
    .nav-parent {
      position: relative;
    }

    .nav-caret {
      width: 16px;
      height: 16px;
      margin-left: auto;
      flex-shrink: 0;
      color: rgba(255, 255, 255, 0.6);
      transition: transform 0.24s ease, color 0.2s;
    }

    .nav-parent:hover .nav-caret {
      color: #fff;
    }

    .nav-parent.is-expanded .nav-caret {
      transform: rotate(180deg);
    }

    .nav-caret path {
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
      fill: none;
    }

    /* collapse via max-height so a collapsed group leaves ZERO height — overflow
       clips the inner's margins/border too, which the old grid 0fr trick did not
       (that left a stray strip between groups that read as a horizontal line). */
    .nav-subnav {
      display: block;
      overflow: hidden;
      max-height: 500px;
      transition: max-height 0.26s ease;
    }

    .nav-subnav.is-collapsed {
      max-height: 0;
    }

    .nav-subnav-inner {
      display: flex;
      flex-direction: column;
      gap: 2px;
      margin: 2px 0 6px 30px;
      padding-left: 14px;
      border-left: 1px solid rgba(255, 255, 255, 0.12);
    }

    .nav-subitem {
      display: flex;
      width: 100%;
      height: 38px;
      align-items: center;
      gap: 8px;
      border: 0;
      border-radius: 8px;
      background: transparent;
      padding: 0 12px;
      color: rgba(255, 255, 255, 0.62);
      text-align: left;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
    }

    .nav-subitem:hover {
      background: rgba(255, 255, 255, 0.05);
      color: #fff;
    }

    .nav-subitem.is-active {
      background: rgba(255, 255, 255, 0.09);
      color: #fff;
      font-weight: 800;
    }

    .nav-subitem-dot {
      width: 6px;
      height: 6px;
      flex-shrink: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.3);
      transition: background 0.2s, box-shadow 0.2s;
    }

    .nav-subitem:hover .nav-subitem-dot {
      background: rgba(255, 255, 255, 0.55);
    }

    .nav-subitem.is-active .nav-subitem-dot {
      background: var(--brand-cyan);
      box-shadow: 0 0 8px rgba(50, 215, 255, 0.6);
    }

    .sidebar-footer {
      margin-top: auto;
      flex-shrink: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.15);
      padding-top: 16px;
    }

    .logout-button {
      display: flex;
      width: 100%;
      align-items: center;
      gap: 8px;
      border: 0;
      background: transparent;
      padding: 8px 12px;
      color: rgba(255, 255, 255, 0.65);
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      transition: color 0.2s;
    }

    .logout-button:hover {
      color: #fff;
    }

    .logout-icon {
      display: inline-flex;
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
    }

    .logout-icon svg {
      width: 17px;
      height: 17px;
    }

    /* ── header shell ──────────────────────────────────────────────────────── */
    .app-area {
      min-height: 100vh;
    }

    .content {
      min-height: calc(100vh - 64px);
      padding: 16px 16px 96px;
    }

    .header {
      position: sticky;
      top: 0;
      z-index: 20;
      display: flex;
      min-height: 64px;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      border-bottom: 1px solid var(--nexora-border);
      background: var(--nexora-surface);
      padding: 0 16px;
    }

    .mobile-brand {
      display: flex;
      min-width: 0;
      align-items: center;
      gap: 12px;
    }

    .icon-button {
      display: inline-flex;
      width: 40px;
      height: 40px;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--nexora-border);
      border-radius: 8px;
      background: #fff;
      color: var(--nexora-text);
      box-shadow: var(--nexora-soft-shadow);
      cursor: pointer;
      transition: background 0.2s;
    }

    .icon-button:hover {
      background: var(--nexora-surface-muted);
    }

    .brand-logo {
      width: 36px;
      height: 36px;
      flex-shrink: 0;
      object-fit: contain;
    }

    .search {
      position: relative;
      display: none;
      width: min(100%, 385px);
    }

    .search svg {
      position: absolute;
      top: 50%;
      left: 16px;
      width: 16px;
      height: 16px;
      color: var(--nexora-muted);
      transform: translateY(-50%);
      pointer-events: none;
    }

    .search input {
      width: 100%;
      height: 44px;
      border: 1px solid transparent;
      border-radius: 999px;
      outline: 0;
      background: var(--nexora-surface-muted);
      padding: 0 16px 0 48px;
      color: var(--nexora-text);
      font-size: 14px;
    }

    .search input::placeholder {
      color: var(--nexora-subtle);
    }

    .search input:focus {
      border-color: var(--nexora-brand);
      box-shadow: 0 0 0 2px rgba(70, 72, 216, 0.2);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .shell-clear-storage-button {
      display: inline-flex;
      min-height: 38px;
      align-items: center;
      gap: 7px;
      border: 1px solid #f0caca;
      border-radius: 8px;
      background: #fff7f7;
      padding: 0 11px;
      color: #b42318;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s;
    }

    .shell-clear-storage-button:hover {
      border-color: #e9a6a6;
      background: #ffeded;
    }

    .shell-clear-storage-button:disabled {
      border-color: #c9e8d7;
      background: #effaf3;
      color: #16804a;
      cursor: default;
    }

    .shell-clear-storage-button svg {
      width: 16px;
      height: 16px;
    }

    .language-switcher {
      display: none;
      align-items: center;
      gap: 4px;
      border: 1px solid var(--nexora-border);
      border-radius: 999px;
      background: var(--nexora-surface-muted);
      padding: 4px;
    }

    .language-switcher button {
      border: 0;
      border-radius: 999px;
      background: transparent;
      padding: 5px 9px;
      color: var(--nexora-muted);
      font-size: 11px;
      font-weight: 800;
      cursor: pointer;
    }

    .language-switcher button.is-active {
      background: #fff;
      color: var(--nexora-brand);
      box-shadow: var(--nexora-card-shadow);
    }

    .notification-button {
      position: relative;
    }

    .notification-dot {
      position: absolute;
      top: 8px;
      right: 8px;
      width: 8px;
      height: 8px;
      border: 2px solid #fff;
      border-radius: 999px;
      background: #ef4444;
    }

    .profile-button {
      display: flex;
      align-items: center;
      gap: 10px;
      border: 1px solid var(--nexora-border);
      border-radius: 999px;
      background: #fff;
      padding: 5px 10px 5px 5px;
      box-shadow: var(--nexora-soft-shadow);
      cursor: pointer;
    }

    .profile-button .avatar {
      width: 32px;
      height: 32px;
      font-size: 11px;
    }

    .profile-copy {
      display: none;
      text-align: left;
    }

    .profile-copy strong {
      display: block;
      color: var(--nexora-text);
      font-size: 12px;
      line-height: 1.2;
    }

    .profile-copy span {
      color: var(--nexora-subtle);
      font-size: 11px;
    }

    /* mobile drawer backdrop */
    .nexora-shell-backdrop {
      position: fixed;
      inset: 0;
      z-index: 29;
      display: none;
      background: rgba(6, 12, 28, 0.55);
    }

    .nexora-shell-backdrop.is-open {
      display: block;
    }

    /* ── responsive ────────────────────────────────────────────────────────── */
    @media (min-width: 640px) {
      .header {
        padding: 0 20px;
      }

      .search {
        display: block;
      }

      .language-switcher {
        display: inline-flex;
      }

      .profile-copy {
        display: block;
      }

      .content {
        padding: 24px 24px 96px;
      }
    }

    /* At 768px and below, the sidebar becomes a drawer opened from the header. */
    @media (max-width: 768px) {
      .sidebar {
        display: flex;
        z-index: 40;
        transform: translateX(-105%);
        box-shadow: 24px 0 60px rgba(0, 0, 0, 0.35);
        transition: transform 0.26s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .sidebar.is-open {
        transform: none;
      }
    }

    @media (min-width: 769px) {
      .sidebar {
        display: flex;
      }

      .app-area {
        padding-left: 288px;
      }

      .mobile-brand {
        display: none;
      }

      .header {
        padding: 0 28px;
      }

      .content {
        padding: 28px;
      }

      .nexora-shell-backdrop {
        display: none !important;
      }
    }

    /* Merchant menu layout and account entry from the live Nexora Touch sidebar. */
    .sidebar-account{position:relative;flex-shrink:0}
    .sidebar-account-toggle{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;padding:8px;text-align:left;cursor:pointer;color:#fff;font:inherit}
    .sidebar-account-toggle .profile-row{flex:1;min-width:0;gap:10px}
    .sidebar-account-toggle .avatar{width:36px;height:36px;font-size:12px}
    .sidebar-account-toggle .profile-name{font-size:13px}
    .sidebar-account-toggle[aria-expanded="true"] .nav-caret{transform:rotate(180deg)}
    .sidebar-account-menu{position:absolute;top:calc(100% + 8px);left:0;right:0;z-index:50;padding:6px;border:1px solid #ffffff26;border-radius:12px;background:#122951;box-shadow:0 12px 28px #0004}
    .sidebar-account-menu[hidden]{display:none}
    .sidebar-account-menu a{display:flex;align-items:center;gap:10px;min-height:40px;padding:10px;border-radius:8px;color:#ffffffe0;text-decoration:none;font-size:12px;font-weight:600}
    .sidebar-account-menu a:hover{background:#ffffff0d;color:#fff}
    .sidebar-account-menu svg{width:17px;height:17px;flex-shrink:0;color:#d69cff}
    .sidebar-account-toggle:focus-visible,.sidebar-account-menu a:focus-visible{outline:2px solid #32d7ff;outline-offset:2px}
    .sidebar:not(.staff-sidebar) .sidebar-nav>.nav-item+.nav-item,.sidebar:not(.staff-sidebar) .sidebar-nav>.nav-subnav+.nav-item{margin-top:6px}
    .sidebar:not(.staff-sidebar) .nav-subitem{height:36px;font-size:12px;color:#ffffffbf}
    .sidebar:not(.staff-sidebar) .nav-subitem:disabled{opacity:.45;cursor:default}
    .sidebar:not(.staff-sidebar) .nav-subitem:disabled:hover{background:transparent}
    .sidebar:not(.staff-sidebar) .lucide-menu-icon{width:18px;height:18px;color:#d69cff;filter:drop-shadow(0 0 5px #d69cff55)}
    .sidebar:not(.staff-sidebar) .nav-item.is-active .lucide-menu-icon{color:#fff}
    .sidebar-nav{scrollbar-width:thin;scrollbar-color:#32d7ff transparent}
    @media(prefers-reduced-motion:reduce){.sidebar-account-toggle .nav-caret{transition:none}}

    .nav-subitem-image{display:block;width:20px;height:20px;flex-shrink:0;object-fit:contain}

    /* Keep the merchant menu's original typography and consistent rows at each level. */
    .sidebar:not(.staff-sidebar) { background:linear-gradient(180deg,#213b64 0%,#1f3458 100%); color:#dce5f7; }
    body[data-nexora-workspace="salon"] .sidebar,
    body[data-nexora-workspace="pos"] .sidebar { padding:18px 14px; }
    .sidebar:not(.staff-sidebar) .sidebar-nav {
      --shell-menu-active-background:linear-gradient(110deg,#7655e8,#405bd6 72%,#2587c3);
      --shell-menu-active-shadow:inset 0 1px #ffffff78,inset 0 -2px #222b7e86,0 5px 0 #0a1740,0 10px 16px #060d30a8;
      --shell-menu-sub-background:linear-gradient(110deg,#474e9d,#276f9f);
      --shell-menu-sub-shadow:inset 0 1px #ffffff48,0 3px 0 #091841,0 8px 13px #07132b8c;
      display:flex; flex-direction:column; gap:3px; min-height:0; overflow-y:auto; overflow-x:hidden; overscroll-behavior:contain; scrollbar-width:thin;
      font-family:"Inter",sans-serif;
    }
    .sidebar:not(.staff-sidebar) .sidebar-nav > * { flex-shrink:0; }
    .sidebar:not(.staff-sidebar) .sidebar-nav > .nav-item + .nav-item { margin-top:0; }
    .sidebar:not(.staff-sidebar) .sidebar-nav .nav-item { height:auto; min-height:42px; gap:10px; padding:9px 11px; border-radius:9px; color:#dce5f7; font-size:14px; font-weight:700; line-height:1.5; }
    .sidebar:not(.staff-sidebar) .sidebar-nav .sidebar-icon-wrap { width:20px; height:20px; background:none; }
    .sidebar:not(.staff-sidebar) .sidebar-nav .lucide-menu-icon { width:16px; height:16px; color:currentColor; filter:none; }
    .shell-tree-row { display:flex; align-items:stretch; min-width:0; }
    .shell-tree-row > a { flex:1; }
    .shell-tree-row > a + button { flex:0 0 35px; justify-content:center; padding:8px; }
    .shell-tree-row > button:only-child { width:100%; }
    .sidebar:not(.staff-sidebar) .shell-tree-branch .nav-subnav { margin-left:0; max-height:none; overflow:visible; transition:none; }
    .sidebar:not(.staff-sidebar) .shell-tree-branch .nav-subnav.is-collapsed { display:none; }
    .sidebar:not(.staff-sidebar) .shell-tree-branch .nav-subnav-inner { gap:3px; margin:3px 0 9px 21px; padding-left:10px; border-left:1px solid #526388; }
    .sidebar:not(.staff-sidebar) .shell-tree-branch:not([data-depth="0"]) > .nav-subnav > .nav-subnav-inner:not(:has(> .shell-tree-branch)) { gap:1px; margin:1px 0 5px 7px; padding-left:9px; }
    .sidebar:not(.staff-sidebar) .sidebar-nav .nav-subitem { height:auto; min-height:38px; gap:7px; padding:7px 9px; border-radius:7px; color:#e3ecfb; font-size:12px; font-weight:600; line-height:1.4; white-space:normal; }
    .sidebar:not(.staff-sidebar) .sidebar-nav .nav-subitem.shell-tree-shortcut { min-height:36px; margin-top:5px; border-top:1px solid #526388; border-radius:0; color:#c6d9ff; }
    .sidebar:not(.staff-sidebar) .shell-tree-shortcut :is(.sidebar-icon-wrap,.lucide-menu-icon) { width:16px; height:16px; }
    .sidebar:not(.staff-sidebar) .shell-tree-branch.has-divider-before { margin-top:8px; padding-top:9px; border-top:1px solid #526388; }
    .sidebar:not(.staff-sidebar) #nexora-subnav-booking > .nav-subnav-inner > .nav-subitem { gap:9px; }
    .sidebar:not(.staff-sidebar) #nexora-subnav-booking > .nav-subnav-inner > .nav-subitem :is(.sidebar-icon-wrap,.lucide-menu-icon) { width:16px; height:16px; }
    .sidebar:not(.staff-sidebar) :is(.sidebar-nav > .nav-item,.shell-tree-row,.nav-subnav-inner > .nav-subitem) { position:relative; transition:box-shadow .25s,background .25s,border-color .25s; }
    .sidebar:not(.staff-sidebar) :is(.sidebar-nav > .nav-item,.shell-tree-row,.nav-subnav-inner > .nav-subitem):is(:hover,:focus-visible),
    .sidebar:not(.staff-sidebar) .shell-tree-row:has(> :focus-visible) { color:#fff; background:linear-gradient(115deg,#6353d572,#2583c452); box-shadow:inset 0 1px #ffffff55,0 5px 0 #07122c8c,0 12px 18px #07122c8c; }
    .sidebar:not(.staff-sidebar) .shell-tree-row:is(:hover,:has(> :focus-visible)) > :is(.nav-item,.nav-subitem) { color:#fff; }
    .sidebar:not(.staff-sidebar) :is(.sidebar-nav > .nav-item,.shell-tree-row,.nav-subnav-inner > .nav-subitem):active { box-shadow:inset 0 3px 8px #07122c8c,0 1px 0 #07122c8c; }
    /* Current destinations use the primary gradient; open groups use the secondary one. */
    .sidebar:not(.staff-sidebar) .sidebar-nav .nav-item.is-active:not(.nav-parent) { background:var(--shell-menu-active-background); box-shadow:var(--shell-menu-active-shadow); color:#fff; }
    .sidebar:not(.staff-sidebar) .sidebar-nav .nav-subitem.is-active:not(.nav-parent) { background:var(--shell-menu-active-background); box-shadow:var(--shell-menu-active-shadow); color:#fff; font-weight:800; }
    .sidebar:not(.staff-sidebar) .sidebar-nav .nav-parent.is-active { background:#ffffff2b; box-shadow:none; color:#fff; }
    .sidebar:not(.staff-sidebar) .sidebar-nav .nav-parent.is-expanded { background:var(--shell-menu-sub-background); box-shadow:none; color:#fff; }
    .sidebar:not(.staff-sidebar) .shell-tree-row { border-radius:7px; }
    .sidebar:not(.staff-sidebar) .shell-tree-branch[data-depth="0"] > .shell-tree-row { border-radius:9px; }
    .sidebar:not(.staff-sidebar) .sidebar-nav .shell-tree-row:has(> .nav-parent.is-active) { background:#ffffff2b; box-shadow:none; }
    .sidebar:not(.staff-sidebar) .sidebar-nav .shell-tree-row:has(> .nav-parent.is-expanded) { background:var(--shell-menu-sub-background); box-shadow:none; }
    .sidebar:not(.staff-sidebar) .sidebar-nav .shell-tree-row:has(> a.nav-subitem.is-active) { background:var(--shell-menu-active-background); box-shadow:var(--shell-menu-active-shadow); }
    .sidebar:not(.staff-sidebar) .sidebar-nav .shell-tree-row:has(> a.nav-item.is-active) { background:var(--shell-menu-active-background); box-shadow:var(--shell-menu-active-shadow); }
    .sidebar:not(.staff-sidebar) .sidebar-nav .shell-tree-row:has(> :is(.is-active,.is-expanded)) > :is(.nav-item,.nav-subitem) { color:#fff; }
    .sidebar:not(.staff-sidebar) .sidebar-nav .shell-tree-branch > .shell-tree-row > :is(.nav-item,.nav-subitem) { background:transparent; box-shadow:none; }
    .sidebar:not(.staff-sidebar) .shell-tree-row:has(> a + button.nav-parent) > a { border-top-right-radius:0; border-bottom-right-radius:0; }
    .sidebar:not(.staff-sidebar) .shell-tree-row:has(> a + button.nav-parent) > button { border-top-left-radius:0; border-bottom-left-radius:0; }
    .sidebar:not(.staff-sidebar) .shell-tree-branch > .nav-subnav:not(.is-collapsed) { animation:shellNavMenuUnfold .34s cubic-bezier(.2,.8,.2,1) both; }
    .sidebar:not(.staff-sidebar) .nav-caret { transition:transform .3s cubic-bezier(.2,.8,.2,1); }
    .sidebar [data-product-menu][hidden] { display:none!important; }
    .shell-products-toggle { display:flex; margin:10px 0 4px; width:100%; min-height:39px; align-items:center; gap:12px; border:1px solid #6379a6; border-radius:9px; padding:9px 12px; background:#ffffff0d; color:#e8efff; box-shadow:none; font:inherit; font-size:12px; font-weight:700; text-align:left; cursor:pointer; }
    .shell-products-toggle:hover { border-color:#95a9d6; background:#ffffff1b; color:#fff; }
    .shell-products-toggle:focus-visible { outline:2px solid #32d7ff; outline-offset:2px; }
    .shell-tree-label { min-width:0; overflow-wrap:anywhere; flex:1; text-align:left; }
    .sidebar:not(.staff-sidebar) .shell-tree-section-label { margin:12px 0 3px; padding:0 9px; color:#99adcc; font-size:10px; font-weight:800; line-height:1.4; letter-spacing:.12em; text-transform:uppercase; }
    .sidebar:not(.staff-sidebar) .shell-tree-section-label:first-child { margin-top:4px; }
    @keyframes shellNavMenuUnfold { from { opacity:.3; } to { opacity:1; } }
    @media (max-width:768px) {
      .sidebar:not(.staff-sidebar) .sidebar-nav .nav-item { min-height:48px; padding:10px 11px; }
      .sidebar:not(.staff-sidebar) .sidebar-nav .nav-subitem { min-height:45px; padding:9px 10px; }
      .shell-products-toggle { min-height:48px; padding:11px 13px; }
    }
    @media (prefers-reduced-motion:reduce) {
      .sidebar:not(.staff-sidebar) :is(.sidebar-nav > .nav-item,.shell-tree-row,.nav-subnav-inner > .nav-subitem,.nav-subnav,.nav-caret) { animation:none!important; transition:none!important; transform:none!important; }
    }
    .shell-preview-tag { max-width:70px; font-size:8px; line-height:1.4; color:#ced6ee; }
    .shell-workspace-search { position:relative; flex:1; max-width:560px; min-width:0; }
    .shell-workspace-search .search { width:100%; }
    .shell-workspace-actions { display:flex; gap:6px; align-items:center; margin-left:auto; }
    .shell-workspace-actions a { display:flex; width:40px; height:40px; align-items:center; justify-content:center; color:var(--nexora-muted); border:1px solid var(--nexora-border); border-radius:10px; }
    .shell-workspace-actions svg { width:18px; height:18px; }
    .shell-function-results { position:absolute; z-index:50; left:0; right:0; top:calc(100% + 8px); max-height:60vh; overflow:auto; border:1px solid var(--nexora-border); border-radius:10px; background:#fff; box-shadow:var(--nexora-soft-shadow); padding:6px; }
    .shell-function-results a { display:block; padding:12px; font-size:13px; text-decoration:none; color:var(--nexora-text); }
    .shell-function-results a:hover, .shell-function-results a:focus-visible { background:#eeefff; }
    body[data-nexora-workspace="pos"] .header { background:#fff; }
    body[data-nexora-workspace="salon"] .header .mobile-brand,
    body[data-nexora-workspace="pos"] .header .mobile-brand { flex-shrink:0; }
    @media (max-width:767px) {
     body[data-nexora-workspace="salon"] .header,
     body[data-nexora-workspace="pos"] .header { gap:10px; padding:12px; flex-wrap:wrap; }
     .shell-workspace-search { order:3; flex-basis:100%; max-width:none; }
     .shell-workspace-actions { gap:4px; }
     .shell-workspace-actions a { width:34px; height:34px; }
    }
    @media (max-width:768px) { body.nexora-drawer-open { overflow:hidden; } }
    /* Nested PO trees have variable height; a fixed expansion ceiling clips grandchildren. */
    .shell-tree-branch .nav-subnav { max-height:none; }
    .shell-tree-branch .nav-subnav.is-collapsed { display:none; }
    .shell-tree-branch .nav-subnav-inner { margin:2px 0 6px 7px; padding-left:8px; }
    .shell-tree-branch .nav-subitem { height:auto; }
    .shell-workspace-search .search { display:flex; }
    @media (max-width:767px) {
     body[data-nexora-workspace="salon"] .header,
     body[data-nexora-workspace="pos"] .header { min-height:116px; }
    }
    @media (max-width:767px) {
     .header:has([data-shell-clear-storage]) .shell-workspace-actions { flex-basis:100%; margin-left:0; flex-wrap:wrap; }
    }

    /* Merchant sidebar order follows the PO reference: logo, public home, salon, platform. */
    .sidebar-brand { flex-shrink:0; display:flex; align-items:center; min-height:54px; padding:0 6px; margin-bottom:10px; }
    .sidebar-brand img { display:block; width:192px; max-width:100%; height:auto; }
    .sidebar-public-home { flex-shrink:0; margin-bottom:12px; }
    .sidebar-public-home .nav-item { min-height:43px; height:auto; padding:9px 12px; border:1px solid #ffffff26; border-radius:9px; background:#ffffff0c; font-size:12px; }
    .sidebar-public-home .sidebar-icon-wrap { height:20px; }
    .sidebar-salon-logo { width:38px; height:38px; object-fit:contain; border-radius:50%; flex-shrink:0; }
    .sidebar-salon-copy { min-width:0; display:flex; flex-direction:column; gap:4px; }
    .sidebar-salon-kicker { color:#b7c9ec; font-size:9px; font-weight:800; letter-spacing:.12em; }
    .sidebar-salon-copy .profile-name { display:block; text-transform:uppercase; }
    body[data-nexora-workspace="salon"] .sidebar-nav,
    body[data-nexora-workspace="pos"] .sidebar-nav { margin-top:14px; }
    .plan-panel .plan-icon { display:flex; flex:0 0 28px; }
    .plan-panel .plan-info { flex:1; }
    .sidebar-section-label { flex-shrink:0; padding:14px 8px 0; color:#b7c9ec; font-size:9px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; }
    .sidebar-support-title { margin-top:10px; padding:12px 11px 6px; border-top:1px solid #3e4f73; color:#aabada; }
    body[data-nexora-workspace="salon"] .sidebar-section-label + .sidebar-nav,
    body[data-nexora-workspace="pos"] .sidebar-section-label + .sidebar-nav { margin-top:8px; }

    /* The sidebar uses one consistent Lucide outline set. */
    .sidebar:not(.staff-sidebar) .lucide-menu-icon { width:16px; height:16px; color:#c4d2eb; filter:none; stroke-width:1.8; }
    .sidebar-external-icon { width:15px; height:15px; flex-shrink:0; color:currentColor; }
    .plan-panel { gap:10px; }
    .plan-panel .plan-icon { flex:0 0 24px; color:#f5c451; }
    .plan-panel .plan-icon svg { width:24px; height:24px; stroke-width:1.8; }
    .plan-panel .plan-info { min-width:0; }
    .plan-panel .panel-title { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:12px; font-weight:700; }
    .plan-panel .plan-button { flex-shrink:0; }

    /* Current Salon menu remains English across the local merchant prototype. */
    .sidebar-account-language{display:flex;align-items:center;gap:4px;min-height:40px;padding:0 10px;color:#ffffffe0;font-size:12px;font-weight:600}
    .sidebar-account-language-control{position:relative;flex:1;min-width:0}
    .sidebar-account-language select{display:block;appearance:none;width:100%;min-height:40px;padding:0 44px 0 0;border:0;border-radius:6px;background:transparent;color:inherit;font:inherit;cursor:pointer}
    .sidebar-account-language option{background:#fff;color:#182841}
    .sidebar-account-language-control svg{position:absolute;right:16px;top:50%;width:16px;height:16px;transform:translateY(-50%);pointer-events:none;color:#b7c9ec}
    .sidebar-account-language select:focus-visible{outline:2px solid #32d7ff;outline-offset:2px}

    /* All workspace headers share the same icon treatment and mobile search. */
    .header.shell-header .shell-search-toggle { display:none; }
    .header.shell-header :is(.shell-workspace-actions a,.mobile-brand .icon-button) { border:0; background:transparent; box-shadow:none; }
    .header.shell-header .mobile-brand .icon-button { color:#64748b; }
    .header.shell-header .shell-workspace-actions a[href="owner-setting.html"] { color:#2563eb; }
    .header.shell-header .shell-workspace-actions a[href="news-library.html?tab=news"] { color:#b45309; }
    .header.shell-header .shell-workspace-actions a[href="community.html?tab=connect"] { color:#0f766e; }
    .header.shell-header .shell-workspace-actions a[href="dashboard.html"] { color:#7c3aed; }
    .header.shell-header .shell-header-search svg { color:#64748b; }
    .header.shell-header :is(.shell-workspace-actions a,.icon-button):focus-visible { outline:2px solid #64748b; outline-offset:2px; }
    @media (max-width:767px) {
      body[data-nexora-workspace] .header.shell-header { min-height:64px; padding:10px 12px; gap:8px; flex-wrap:wrap; }
      .header.shell-header .shell-header-search { display:none; order:3; flex:1 0 100%; width:100%; max-width:none; }
      body.shell-search-open .header.shell-header .shell-header-search { display:block; }
      .header.shell-header .shell-search-toggle { display:inline-flex; flex:none; width:44px; height:44px; padding:0; border:0; background:transparent; color:#64748b; box-shadow:none; }
      .header.shell-header .shell-search-toggle svg { width:17px; height:17px; }
