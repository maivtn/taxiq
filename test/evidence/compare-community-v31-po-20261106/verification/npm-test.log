        #nx-campaign-root .sms-credit-card-select:focus { border-color:var(--nexora-brand); box-shadow:0 0 0 3px rgba(70,72,216,.1); }
        #nx-campaign-root .sms-credit-card-input::placeholder { color:#94a3b8; }
        #nx-campaign-root .sms-credit-card-input-wrap { position:relative; }
        #nx-campaign-root .sms-credit-card-input-wrap .marketing-icon { position:absolute; top:50%; left:10px; width:17px; height:17px; transform:translateY(-50%); color:#64748b; pointer-events:none; }
        #nx-campaign-root .sms-credit-card-input-wrap .sms-credit-card-input { padding-left:34px; }
        #nx-campaign-root .sms-credit-card-row { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
        #nx-campaign-root .sms-credit-card-error { min-height:16px; color:#b91c1c; font-size:12px; font-weight:700; }
        #nx-campaign-root .sms-credit-invoice { border:1px solid var(--nexora-border); border-radius:12px; background:#fff; padding:13px; }
        #nx-campaign-root .sms-credit-invoice-row { display:flex; align-items:center; justify-content:space-between; gap:12px; color:var(--nexora-muted); font-size:12px; font-weight:600; }
        #nx-campaign-root .sms-credit-invoice-row + .sms-credit-invoice-row { margin-top:8px; }
        #nx-campaign-root .sms-credit-invoice-row strong { color:var(--nexora-text); font-weight:900; }
        #nx-campaign-root .sms-credit-invoice-total { margin-top:10px; border-top:1px solid var(--nexora-rule); padding-top:10px; color:var(--nexora-text); font-size:14px; font-weight:900; }
        #nx-campaign-root .sms-credit-invoice-total strong { color:var(--nexora-brand); font-size:16px; }
        #nx-campaign-root .sms-credit-modal-foot { display:flex; flex:0 0 auto; align-items:center; gap:10px; border-top:1px solid var(--nexora-rule); background:#fff; padding:14px 20px; }
        #nx-campaign-root .sms-credit-modal-foot .btn-outline { flex:1; color:var(--nexora-muted); }
        #nx-campaign-root .sms-credit-modal-foot .btn-primary { flex:2; justify-content:center; }
        @media (max-width:560px) {
