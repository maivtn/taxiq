          document.body.style.overflow = '';
        }

        function showTrialStep(stepName) {
          document.querySelectorAll('[data-trial-step]').forEach(function(step) {
            step.hidden = step.dataset.trialStep !== stepName;
          });
        }

        var TRIAL_PRICE_LIST_MAX_BYTES = 10 * 1024 * 1024;

        function setTrialFormError(message) {
          var error = document.querySelector('[data-trial-error]');
          if (!error) return;
          error.textContent = message || '';
          error.hidden = !message;
        }

        function clearTrialFormValidation(modal) {
          if (!modal) return;
          modal.querySelectorAll('.is-invalid, [aria-invalid="true"]').forEach(function(field) {
            field.classList.remove('is-invalid');
            field.removeAttribute('aria-invalid');
          });
          setTrialFormError('');
        }

        function syncTrialHourRow(toggle) {
          var row = toggle ? toggle.closest('[data-trial-hour-row]') : null;
          if (!row) return;

          var isOpen = toggle.checked;
          row.classList.toggle('is-closed', !isOpen);
          row.querySelectorAll('[data-trial-hour-start], [data-trial-hour-end]').forEach(function(input) {
            input.disabled = !isOpen;
          });
        }

        function trialClockMinutes(value) {
          var text = (value || '').trim().toUpperCase();
          var twelveHour = text.match(/^(\d{1,2})(?::([0-5]\d))?\s*(AM|PM)$/);
          if (twelveHour) {
            var hour = Number(twelveHour[1]);
            var minute = Number(twelveHour[2] || 0);
            if (hour < 1 || hour > 12) return null;
            if (twelveHour[3] === 'AM' && hour === 12) hour = 0;
            if (twelveHour[3] === 'PM' && hour !== 12) hour += 12;
            return hour * 60 + minute;
          }

          var twentyFourHour = text.match(/^([01]?\d|2[0-3]):([0-5]\d)$/);
          return twentyFourHour ? Number(twentyFourHour[1]) * 60 + Number(twentyFourHour[2]) : null;
        }

        function collectTrialHours() {
          var modal = document.querySelector('[data-trial-modal]');
          var hours = {};
          if (!modal) return hours;

          modal.querySelectorAll('[data-trial-hour-row]').forEach(function(row) {
            var toggle = row.querySelector('[data-trial-hour-toggle]');
            var start = row.querySelector('[data-trial-hour-start]');
            var end = row.querySelector('[data-trial-hour-end]');
            hours[row.dataset.trialHourRow] = {
              open: !!(toggle && toggle.checked),
              start: start ? start.value.trim() : '',
              end: end ? end.value.trim() : ''
            };
          });

          return hours;
        }

        function trialPriceListIsSupported(file) {
          if (!file) return true;
          var fileName = (file.name || '').toLowerCase();
          var supportedExtension = /\.(pdf|png|jpe?g|csv|xlsx?|xls)$/i.test(fileName);
          var supportedMime = /^(application\/pdf|image\/(png|jpe?g)|text\/csv|application\/vnd\.ms-excel|application\/vnd\.openxmlformats-officedocument\.spreadsheetml\.sheet)$/i.test(file.type || '');
          return (supportedExtension || supportedMime) && file.size <= TRIAL_PRICE_LIST_MAX_BYTES;
        }

        function handleTrialPriceListChange(input) {
          var modal = input ? input.closest('[data-trial-modal]') : null;
          var label = modal ? modal.querySelector('[data-trial-price-list-label]') : null;
          var file = input && input.files && input.files[0] ? input.files[0] : null;

          if (!file) {
            if (label) label.textContent = 'No file selected · PDF, image, or spreadsheet up to 10 MB';
            setTrialFormError('');
            return;
          }

          if (!trialPriceListIsSupported(file)) {
            input.value = '';
            if (label) label.textContent = 'No file selected · PDF, image, or spreadsheet up to 10 MB';
            setTrialFormError('Price list must be a PDF, image, or spreadsheet no larger than 10 MB.');
            return;
          }

          if (label) label.textContent = file.name + ' · ' + Math.max(1, Math.round(file.size / 1024)) + ' KB';
          setTrialFormError('');
        }

        function validateTrialForm() {
          var modal = document.querySelector('[data-trial-modal]');
          if (!modal) return false;
          clearTrialFormValidation(modal);

          var checks = [
            { field: modal.querySelector('[data-trial-salon]'), message: 'Salon name is required.' },
            { field: modal.querySelector('[data-trial-owner]'), message: 'Owner name is required.' },
            { field: modal.querySelector('[data-trial-phone]'), message: 'Salon phone number is required.' },
            { field: modal.querySelector('[data-trial-owner-phone]'), message: 'Owner phone number is required.' },
            { field: modal.querySelector('[data-trial-email]'), message: 'A valid email is required.' }
          ];

          for (var index = 0; index < checks.length; index += 1) {
            var check = checks[index];
            var value = check.field ? check.field.value.trim() : '';
            if (!value || (check.field && check.field.matches('[type="tel"]') && value.replace(/\D/g, '').length < 10) || (check.field && check.field.matches('[type="email"]') && !/^\S+@\S+\.\S+$/.test(value))) {
              if (check.field) {
                check.field.classList.add('is-invalid');
                check.field.setAttribute('aria-invalid', 'true');
                check.field.focus();
              }
              setTrialFormError(check.field && check.field.matches('[type="tel"]') ? check.message.replace(' is required.', ' must contain at least 10 digits.') : check.message);
              return false;
            }
          }

          var hours = collectTrialHours();
          var openDays = Object.keys(hours).filter(function(day) { return hours[day].open; });
          if (!openDays.length) {
            setTrialFormError('Select at least one open day.');
            return false;
          }

          for (var hourIndex = 0; hourIndex < openDays.length; hourIndex += 1) {
            var day = openDays[hourIndex];
            var schedule = hours[day];
            var startMinutes = trialClockMinutes(schedule.start);
            var endMinutes = trialClockMinutes(schedule.end);
            if (startMinutes === null || endMinutes === null || startMinutes >= endMinutes) {
              var hourRow = modal.querySelector('[data-trial-hour-row="' + day + '"]');
              var hourStart = hourRow ? hourRow.querySelector('[data-trial-hour-start]') : null;
              var hourEnd = hourRow ? hourRow.querySelector('[data-trial-hour-end]') : null;
              var dayLabel = hourRow && hourRow.querySelector('.settings-hour-toggle span') ? hourRow.querySelector('.settings-hour-toggle span').textContent : day;
              if (hourStart) hourStart.classList.add('is-invalid');
              if (hourEnd) hourEnd.classList.add('is-invalid');
              setTrialFormError(dayLabel + ' must have a valid closing time later than its opening time.');
              if (hourStart) hourStart.focus();
              return false;
            }
          }

          var priceList = modal.querySelector('[data-trial-price-list]');
          var file = priceList && priceList.files && priceList.files[0] ? priceList.files[0] : null;
          if (file && !trialPriceListIsSupported(file)) {
            priceList.classList.add('is-invalid');
            priceList.setAttribute('aria-invalid', 'true');
            setTrialFormError('Price list must be a PDF, image, or spreadsheet no larger than 10 MB.');
            priceList.focus();
            return false;
          }

          return true;
        }

        function submitTrialForm() {
          var modal = document.querySelector('[data-trial-modal]');
          if (!modal) return;

          if (!validateTrialForm()) return;

          var email = modal.querySelector('[data-trial-email]');
          var emailValue = email ? email.value.trim() : '';
          var priceList = modal.querySelector('[data-trial-price-list]');
          var priceListFile = priceList && priceList.files && priceList.files[0] ? priceList.files[0] : null;
          var trialSubmission = {
            plan: 'Trial',
            salon: modal.querySelector('[data-trial-salon]') ? modal.querySelector('[data-trial-salon]').value.trim() : '',
            owner: modal.querySelector('[data-trial-owner]') ? modal.querySelector('[data-trial-owner]').value.trim() : '',
            salonPhone: modal.querySelector('[data-trial-phone]') ? modal.querySelector('[data-trial-phone]').value.trim() : '',
            ownerPhone: modal.querySelector('[data-trial-owner-phone]') ? modal.querySelector('[data-trial-owner-phone]').value.trim() : '',
            email: emailValue,
            city: modal.querySelector('[data-trial-city]') ? modal.querySelector('[data-trial-city]').value.trim() : '',
            website: modal.querySelector('[data-trial-website]') ? modal.querySelector('[data-trial-website]').value.trim() : '',
            services: Array.prototype.map.call(modal.querySelectorAll('[data-trial-chip].is-active'), function(chip) { return chip.textContent.trim(); }),
            hours: collectTrialHours(),
            priceList: priceListFile ? { name: priceListFile.name, size: priceListFile.size, type: priceListFile.type || '' } : null,
            painPoint: modal.querySelector('[data-trial-pain]') ? modal.querySelector('[data-trial-pain]').value : '',
            referralCode: modal.querySelector('[data-trial-ref]') ? modal.querySelector('[data-trial-ref]').value.trim().toUpperCase() : ''
          };

          modal.dataset.trialSubmission = JSON.stringify(trialSubmission);
          modal._trialSubmission = trialSubmission;
          window.NEXORA_TRIAL_SUBMISSION = trialSubmission;
          window.NEXORA_TRIAL_PRICE_LIST_FILE = priceListFile;

          var emailShow = modal.querySelector('[data-trial-email-show]');
          if (emailShow) emailShow.textContent = emailValue;
          showTrialStep('email');
        }

        function activateTrialAccount() {
          var status = document.querySelector('[data-trial-status]');
          if (status) {
            status.innerHTML = '<span style="color: var(--nexora-success); font-weight: 700;">Account activated. Your 14-day trial has started.</span>';
          }
        }

        function setSettingsStatus(message) {
          var status = document.querySelector('[data-settings-status]');
          if (status) {
            status.textContent = message;
          }
        }

        var SETTINGS_HOLIDAY_STORAGE_KEY = 'nexora:holiday-closures:v2:' + (salonData && salonData.SALON_ID ? salonData.SALON_ID : 'bitcoin-nail-bar-houston');
        var settingsHolidayClosures = [
          {
            date: '2026-12-25',
            status: 'closed',
            open: '10:00 AM',
            close: '3:00 PM',
            reason: 'Christmas Day',
            autoNotify: true,
            message: ''
          },
          {
            date: '2026-11-26',
            status: 'adjusted',
            open: '10:00 AM',
            close: '3:00 PM',
            reason: 'Thanksgiving',
            autoNotify: true,
            message: ''
          }
        ];
        var settingsHolidayInitialized = false;
        var settingsHolidayModalMode = 'add';

        function normalizeSettingsHolidayClosure(item) {
          item = item || {};
          var status = item.status === 'adjusted' ? 'adjusted' : 'closed';
          return {
            date: String(item.date || '').slice(0, 10),
            status: status,
            open: String(item.open || '10:00 AM').trim(),
            close: String(item.close || '3:00 PM').trim(),
            reason: String(item.reason || (status === 'closed' ? 'Closed' : 'Adjusted hours')).trim(),
            autoNotify: item.autoNotify !== false,
            message: String(item.message || '').trim()
          };
        }

        function loadSettingsHolidayClosures() {
          try {
            var raw = localStorage.getItem(SETTINGS_HOLIDAY_STORAGE_KEY);
            if (!raw) return settingsHolidayClosures.slice();
            var parsed = JSON.parse(raw);
            if (!Array.isArray(parsed)) return settingsHolidayClosures.slice();
            var seen = {};
            return parsed.map(normalizeSettingsHolidayClosure).filter(function(item) {
              if (!item.date || seen[item.date]) return false;
              seen[item.date] = true;
              return true;
            });
          } catch (error) {
            return settingsHolidayClosures.slice();
          }
        }

        function saveSettingsHolidayClosures() {
          try {
            localStorage.setItem(SETTINGS_HOLIDAY_STORAGE_KEY, JSON.stringify(settingsHolidayClosures));
          } catch (error) {
            return false;
          }
          return true;
        }

        settingsHolidayClosures = loadSettingsHolidayClosures();

        function settingsHolidayField(selector) {
          return document.querySelector(selector);
        }

        function defaultSettingsHolidayClosure() {
          var notify = settingsHolidayField('[data-settings-holiday-auto-notify-toggle]');
          return {
            date: '',
            status: 'closed',
            open: '10:00 AM',
            close: '3:00 PM',
            reason: '',
            autoNotify: !notify || notify.classList.contains('is-on'),
            message: ''
          };
        }

        function openSettingsHolidayModal(closure, mode) {
          var modal = settingsHolidayField('[data-settings-holiday-modal]');
          if (!modal) return;
          var savedClosure = closure && closure.date ? settingsHolidayClosureByDate(closure.date) : null;
          settingsHolidayModalMode = mode === 'view' ? 'view' : (savedClosure ? 'edit' : 'add');
          fillSettingsHolidayForm(closure || defaultSettingsHolidayClosure());
          var title = settingsHolidayField('[data-settings-holiday-modal-title]');
          if (title) {
            title.textContent = settingsHolidayModalMode === 'view'
              ? 'View Holiday & Closure'
              : (settingsHolidayModalMode === 'edit' ? 'Edit Holiday & Closure' : 'Add Holiday & Closure');
          }
          modal.dataset.settingsHolidayMode = settingsHolidayModalMode;
          modal.hidden = false;
          var date = settingsHolidayField('[data-settings-holiday-date]');
          if (date && !date.value) date.focus();
        }

        function openSettingsHolidayForm(closure, mode) {
          openSettingsHolidayModal(closure, mode);
        }

        function closeSettingsHolidayModal() {
          var modal = settingsHolidayField('[data-settings-holiday-modal]');
          if (modal) modal.hidden = true;
          settingsHolidayModalMode = 'add';
        }

        function closeSettingsHolidayForm() {
          closeSettingsHolidayModal();
        }

        function settingsHolidayDisplayDate(date) {
          var parsed = new Date(String(date || '') + 'T12:00:00');
          if (!Number.isFinite(parsed.getTime())) return date || 'Selected date';
          return parsed.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        }

        function settingsHolidayClockMinutes(value) {
          var text = String(value || '').trim().toUpperCase();
          var twelveHour = text.match(/^(\d{1,2})(?::([0-5]\d))?\s*(AM|PM)$/);
          if (twelveHour) {
            var hour = Number(twelveHour[1]);
            var minute = Number(twelveHour[2] || 0);
            if (hour < 1 || hour > 12) return null;
            if (twelveHour[3] === 'AM' && hour === 12) hour = 0;
            if (twelveHour[3] === 'PM' && hour !== 12) hour += 12;
            return hour * 60 + minute;
          }

          var twentyFourHour = text.match(/^([01]?\d|2[0-3]):([0-5]\d)$/);
          return twentyFourHour ? Number(twentyFourHour[1]) * 60 + Number(twentyFourHour[2]) : null;
        }

        function settingsHolidayClosureByDate(date) {
          return settingsHolidayClosures.find(function(item) { return item.date === date; }) || null;
        }

        function collectSettingsHolidayForm() {
          var date = settingsHolidayField('[data-settings-holiday-date]');
          var status = settingsHolidayField('[data-settings-holiday-status]');
          var open = settingsHolidayField('[data-settings-holiday-open]');
          var close = settingsHolidayField('[data-settings-holiday-close]');
          var reason = settingsHolidayField('[data-settings-holiday-reason]');
          var notify = settingsHolidayField('[data-settings-holiday-auto-notify-toggle]');
          return {
            date: date ? date.value : '',
            status: status ? status.value : 'closed',
            open: open ? open.value.trim() : '',
            close: close ? close.value.trim() : '',
            reason: reason ? reason.value.trim() : '',
            autoNotify: !notify || notify.classList.contains('is-on')
          };
        }

        function fillSettingsHolidayForm(closure) {
          if (!closure) return;
          var date = settingsHolidayField('[data-settings-holiday-date]');
          var status = settingsHolidayField('[data-settings-holiday-status]');
          var open = settingsHolidayField('[data-settings-holiday-open]');
          var close = settingsHolidayField('[data-settings-holiday-close]');
          var reason = settingsHolidayField('[data-settings-holiday-reason]');
          var notify = settingsHolidayField('[data-settings-holiday-auto-notify-toggle]');
          if (date) date.value = closure.date || '';
          if (status) status.value = closure.status || 'closed';
          if (open) open.value = closure.open || '10:00 AM';
          if (close) close.value = closure.close || '3:00 PM';
          if (reason) reason.value = closure.reason || '';
          if (notify) notify.classList.toggle('is-on', closure.autoNotify !== false);
          syncSettingsHolidayAutoNotifyToggle(notify);
          syncSettingsHolidayFormState();
        }

        function settingsHolidayAppointmentMinutes(record) {
          var start = new Date(record && record.startAt ? record.startAt : '');
          if (!Number.isFinite(start.getTime())) return null;
          var end = record && record.endAt ? new Date(record.endAt) : new Date(start.getTime() + (Number(record.durationMin) || 60) * 60000);
          if (!Number.isFinite(end.getTime())) end = new Date(start.getTime() + (Number(record.durationMin) || 60) * 60000);
          return {
            startMinutes: start.getHours() * 60 + start.getMinutes(),
            endMinutes: end.getHours() * 60 + end.getMinutes()
          };
        }

        function settingsHolidayAppointmentIsAffected(record, closure) {
          if (!record || !closure || !closure.date || record.status === 'cancelled') return false;
          if (String(record.startAt || '').slice(0, 10) !== closure.date) return false;
          var appointmentMinutes = settingsHolidayAppointmentMinutes(record);
          if (!appointmentMinutes) return false;
          var startMinutes = appointmentMinutes.startMinutes;
          var endMinutes = appointmentMinutes.endMinutes;

          if (closure.status === 'closed') return true;

          var openMinutes = settingsHolidayClockMinutes(closure.open);
          var closeMinutes = settingsHolidayClockMinutes(closure.close);
          if (openMinutes === null || closeMinutes === null || openMinutes >= closeMinutes) return true;

          return startMinutes < openMinutes || endMinutes > closeMinutes;
        }

        function settingsHolidayImpactedAppointments(closure) {
          if (!closure || !closure.date || !appointmentStore || typeof appointmentStore.loadAll !== 'function') return [];
          return appointmentStore.loadAll(null, catalog).filter(function(record) {
            return settingsHolidayAppointmentIsAffected(record, closure);
          }).sort(function(a, b) {
            return String(a.startAt || '').localeCompare(String(b.startAt || ''));
          });
        }

        function settingsHolidayScheduleForRange(startAt, endAt) {
          var start = new Date(startAt);
          var end = new Date(endAt);
          if (!Number.isFinite(start.getTime()) || !Number.isFinite(end.getTime())) return null;
          var date = formatBookingCalendarDate(start);
          var closure = settingsHolidayClosureByDate(date);
          if (!closure) return null;
          var candidate = {
            startAt: formatBookingCalendarDateTime(start),
            endAt: formatBookingCalendarDateTime(end),
            status: 'pending'
          };
          var blocked = settingsHolidayAppointmentIsAffected(candidate, closure);
          return {
            closure: closure,
            blocked: blocked,
            date: date,
            label: settingsHolidayClosureLabel(closure)
          };
        }

        function settingsHolidayPlacementError(startAt, endAt) {
          var schedule = settingsHolidayScheduleForRange(startAt, endAt);
          if (!schedule || !schedule.blocked) return '';
          var closure = schedule.closure;
          if (closure.status === 'closed') {
            return 'Salon is closed on ' + settingsHolidayDisplayDate(closure.date) + (closure.reason ? ' for ' + closure.reason : '') + '. Choose another date.';
          }
          return 'Salon hours are adjusted on ' + settingsHolidayDisplayDate(closure.date) + ' to ' + closure.open + ' - ' + closure.close + '. Choose a time inside salon hours.';
        }

        function settingsHolidayCellIsBlocked(startAt, endAt) {
          return Boolean(settingsHolidayPlacementError(bookingCalendarDayPilotTime(startAt), bookingCalendarDayPilotTime(endAt)));
        }

        function settingsHolidayServiceLabel(record) {
          return bookingRecordServiceNames(record || {}).join(', ') || 'Service to confirm';
        }

        function settingsHolidayClosureLabel(closure) {
          if (!closure) return 'No closure selected';
          if (closure.status === 'closed') return 'Closed all day';
          return 'Adjusted hours: ' + (closure.open || 'Open') + ' to ' + (closure.close || 'Close');
        }

        function settingsHolidayFallbackMessage(closure) {
          var salonNameField = document.querySelector('.settings-business-grid .settings-input');
          var salonName = salonNameField && salonNameField.value ? salonNameField.value.trim() : 'Bitcoin Nail Bar';
          var date = settingsHolidayDisplayDate(closure && closure.date);
          var reason = closure && closure.reason ? ' for ' + closure.reason : '';
          if (closure && closure.status === 'adjusted') {
            return salonName + ' has adjusted hours on ' + date + ' from ' + (closure.open || 'open') + ' to ' + (closure.close || 'close') + reason + '. Please contact us or book a new time online.';
          }
          return salonName + ' is closed on ' + date + reason + '. Please contact us or book a new time online.';
        }

        function settingsHolidayNotificationSignature(closure, messageText) {
          return [
            closure && closure.date || '',
            closure && closure.status || '',
            closure && closure.open || '',
            closure && closure.close || '',
            closure && closure.reason || '',
            messageText || ''
          ].join('|');
        }

        function queueSettingsHolidayNotifications(closure, messageText) {
          if (!closure || closure.autoNotify === false) return 0;
          var affected = settingsHolidayImpactedAppointments(closure);
          messageText = String(messageText || closure.message || '').trim() || settingsHolidayFallbackMessage(closure);
          var signature = settingsHolidayNotificationSignature(closure, messageText);
          affected.forEach(function(record) {
            var metadata = Object.assign({}, record.metadata || {});
            var existing = metadata.holidayClosureNotification || {};
            var queuedAt = existing.signature === signature && existing.queuedAt ? existing.queuedAt : new Date().toISOString();
            metadata.holidayClosureNotification = {
              date: closure.date,
              reason: closure.reason,
              status: closure.status,
              notificationStatus: 'queued',
              channel: 'AI Voice + SMS',
              message: messageText,
              phone: record.phone || '',
              queuedAt: queuedAt,
              signature: signature
            };
            appointmentStore.update(record.id, {
              metadata: metadata
            }, null, catalog);
          });
          return affected.length;
        }

        function syncSettingsHolidayAutoNotifyToggle(toggle) {
          if (!toggle) return;
          var enabled = toggle.classList.contains('is-on');
          toggle.setAttribute('aria-checked', enabled ? 'true' : 'false');
          toggle.setAttribute('aria-label', enabled ? 'Disable holiday auto-notify' : 'Enable holiday auto-notify');
          var label = settingsHolidayField('[data-settings-holiday-auto-notify-status]');
          if (label) {
            label.textContent = enabled ? 'Auto-notify via AI Voice & SMS' : 'Auto-notify off';
            label.classList.toggle('is-off', !enabled);
          }
        }

        function syncSettingsHolidayFormState() {
          var form = collectSettingsHolidayForm();
          var isAdjusted = form.status === 'adjusted';
          var isViewMode = settingsHolidayModalMode === 'view';
          document.querySelectorAll('[data-settings-holiday-form] .settings-input, [data-settings-holiday-form] .settings-select').forEach(function(input) {
            var isHourInput = Boolean(input.closest('[data-settings-holiday-hours]'));
            input.disabled = isViewMode || (isHourInput && !isAdjusted);
          });
          document.querySelectorAll('[data-settings-holiday-reason-suggestion]').forEach(function(button) {
            button.hidden = isViewMode;
            button.disabled = isViewMode;
          });
          var saveButton = settingsHolidayField('[data-settings-holiday-save]');
          if (saveButton) {
            saveButton.hidden = isViewMode;
            saveButton.disabled = isViewMode;
          }
        }

        function settingsHolidayRowMarkup(closure) {
          var statusClass = closure.status === 'closed' ? 'is-closed' : 'is-adjusted';
          var type = closure.status === 'closed' ? 'Closed' : 'Adjusted';
          return '<div class="settings-holiday-row" role="row" data-settings-holiday-row="' + escapeHtml(closure.date) + '">' +
            '<span class="settings-holiday-date" role="cell">' + escapeHtml(settingsHolidayDisplayDate(closure.date)) + '</span>' +
            '<span class="settings-holiday-reason" role="cell">' + escapeHtml(closure.reason || 'No reason') + '</span>' +
            '<span class="settings-holiday-type" role="cell"><span class="settings-holiday-badge ' + statusClass + '">' + escapeHtml(type) + '</span></span>' +
            '<span class="settings-holiday-row-actions" role="cell">' +
            '<button class="settings-holiday-icon-button" type="button" data-settings-holiday-edit="' + escapeHtml(closure.date) + '" aria-label="Edit closure" title="Edit closure">Edit</button>' +
            '<button class="settings-holiday-icon-button" type="button" data-settings-holiday-view="' + escapeHtml(closure.date) + '" aria-label="View closure" title="View closure">View</button>' +
            '<button class="settings-holiday-icon-button is-danger" type="button" data-settings-holiday-remove="' + escapeHtml(closure.date) + '" aria-label="Delete closure" title="Delete closure">Delete</button></span></div>';
        }

        function renderSettingsHolidayClosures() {
          var list = settingsHolidayField('[data-settings-holiday-list]');
          if (!list) return;
          var sorted = settingsHolidayClosures.slice().sort(function(a, b) {
            return String(a.date || '').localeCompare(String(b.date || ''));
          });
          list.innerHTML = sorted.length
            ? sorted.map(settingsHolidayRowMarkup).join('')
            : '<div class="settings-holiday-empty" role="row">No Holiday & Closures configured.</div>';
          syncSettingsHolidayFormState();
        }

        function upsertSettingsHolidayClosure() {
          var form = collectSettingsHolidayForm();
          if (!form.date) {
            setSettingsStatus('Choose a date before saving Holiday & Closures.');
            return;
          }
          if (form.status === 'adjusted') {
            var openMinutes = settingsHolidayClockMinutes(form.open);
            var closeMinutes = settingsHolidayClockMinutes(form.close);
            if (openMinutes === null || closeMinutes === null || openMinutes >= closeMinutes) {
              setSettingsStatus('Adjusted hours need a valid open and close time.');
              return;
            }
          }
          if (!form.reason) form.reason = form.status === 'closed' ? 'Closed' : 'Adjusted hours';

          var previousClosures = settingsHolidayClosures.slice();
          var existingIndex = settingsHolidayClosures.findIndex(function(item) { return item.date === form.date; });
          if (existingIndex >= 0) {
            settingsHolidayClosures[existingIndex] = form;
          } else {
            settingsHolidayClosures.push(form);
          }
          if (!saveSettingsHolidayClosures()) {
            settingsHolidayClosures = previousClosures;
            renderSettingsHolidayClosures();
            setSettingsStatus('Could not save Holiday & Closures. Check browser storage and try again.');
            return;
          }
          var queuedCount = form.autoNotify !== false ? queueSettingsHolidayNotifications(form) : null;
          renderSettingsHolidayClosures();
          fillSettingsHolidayForm(form);
          closeSettingsHolidayForm();
          if (queuedCount !== null) {
            renderBookingStoreRows();
            filterBookingItems();
          }
          renderBookingCalendar();
          var status = 'Holiday & Closures saved for ' + settingsHolidayDisplayDate(form.date) + '.';
          if (queuedCount !== null) {
            status += ' AI Voice and SMS queued for ' + queuedCount + ' affected appointment' + (queuedCount === 1 ? '' : 's') + '.';
          }
          setSettingsStatus(status);
        }

        function editSettingsHolidayClosure(date) {
          var closure = settingsHolidayClosureByDate(date);
          if (!closure) return;
          openSettingsHolidayForm(closure, 'edit');
          setSettingsStatus('Editing Holiday & Closures for ' + settingsHolidayDisplayDate(date) + '.');
        }

        function viewSettingsHolidayClosure(date) {
          var closure = settingsHolidayClosureByDate(date);
          if (!closure) return;
          openSettingsHolidayForm(closure, 'view');
          setSettingsStatus('Viewing Holiday & Closures for ' + settingsHolidayDisplayDate(date) + '.');
        }

        function deleteSettingsHolidayClosure(date) {
          var targetDate = date;
          var before = settingsHolidayClosures.length;
          var previousClosures = settingsHolidayClosures.slice();
          settingsHolidayClosures = settingsHolidayClosures.filter(function(item) { return item.date !== targetDate; });
          if (!saveSettingsHolidayClosures()) {
            settingsHolidayClosures = previousClosures;
            renderSettingsHolidayClosures();
            setSettingsStatus('Could not delete Holiday & Closures. Check browser storage and try again.');
            return;
          }
          renderSettingsHolidayClosures();
          syncSettingsHolidayFormState();
          closeSettingsHolidayForm();
          renderBookingCalendar();
          if (before !== settingsHolidayClosures.length) {
            setSettingsStatus('Holiday & Closures deleted for ' + settingsHolidayDisplayDate(targetDate) + '.');
          }
        }

        function initSettingsHolidayClosures() {
          var card = settingsHolidayField('[data-settings-holiday-card]');
          if (!card) return;
          if (!settingsHolidayInitialized) {
            settingsHolidayInitialized = true;
            document.querySelectorAll('[data-settings-holiday-status], [data-settings-holiday-open], [data-settings-holiday-close], [data-settings-holiday-reason]').forEach(function(field) {
              field.addEventListener('input', syncSettingsHolidayFormState);
              field.addEventListener('change', syncSettingsHolidayFormState);
            });
            var date = settingsHolidayField('[data-settings-holiday-date]');
            if (date) {
              date.addEventListener('change', function() {
                var existing = settingsHolidayClosureByDate(date.value);
                var title = settingsHolidayField('[data-settings-holiday-modal-title]');
                if (existing) {
                  fillSettingsHolidayForm(existing);
                  if (title) title.textContent = 'Edit Holiday & Closure';
                } else {
                  if (title) title.textContent = 'Add Holiday & Closure';
                  syncSettingsHolidayFormState();
                }
              });
            }
            var notify = settingsHolidayField('[data-settings-holiday-auto-notify-toggle]');
            if (notify) {
              syncSettingsHolidayAutoNotifyToggle(notify);
              notify.addEventListener('click', function() {
                syncSettingsHolidayAutoNotifyToggle(notify);
                syncSettingsHolidayFormState();
              });
            }
            var save = settingsHolidayField('[data-settings-holiday-save]');
            if (save) save.addEventListener('click', upsertSettingsHolidayClosure);
            var add = settingsHolidayField('[data-settings-holiday-add]');
            if (add) add.addEventListener('click', function() {
              openSettingsHolidayForm(defaultSettingsHolidayClosure());
              setSettingsStatus('Adding a Holiday & Closures date.');
            });
            document.querySelectorAll('[data-settings-holiday-cancel]').forEach(function(cancel) {
              cancel.addEventListener('click', function() {
                closeSettingsHolidayForm();
                setSettingsStatus('Holiday & Closures form closed.');
              });
            });
            var modal = settingsHolidayField('[data-settings-holiday-modal]');
            if (modal) {
              modal.addEventListener('click', function(event) {
                if (event.target === modal) closeSettingsHolidayForm();
              });
            }
            document.querySelectorAll('[data-settings-holiday-reason-suggestion]').forEach(function(suggestion) {
              suggestion.addEventListener('click', function() {
                var reason = settingsHolidayField('[data-settings-holiday-reason]');
                if (!reason) return;
                reason.value = suggestion.dataset.settingsHolidayReasonSuggestion || '';
                reason.focus();
                syncSettingsHolidayFormState();
              });
            });
            var list = settingsHolidayField('[data-settings-holiday-list]');
            if (list) {
              list.addEventListener('click', function(event) {
                var removeButton = event.target.closest('[data-settings-holiday-remove]');
                if (removeButton) {
                  deleteSettingsHolidayClosure(removeButton.dataset.settingsHolidayRemove);
                  return;
                }
                var view = event.target.closest('[data-settings-holiday-view]');
                if (view) {
                  viewSettingsHolidayClosure(view.dataset.settingsHolidayView);
                  return;
                }
                var edit = event.target.closest('[data-settings-holiday-edit]');
                if (edit) {
                  editSettingsHolidayClosure(edit.dataset.settingsHolidayEdit);
                  return;
                }
              });
            }
          }
          var selected = settingsHolidayClosureByDate((settingsHolidayField('[data-settings-holiday-date]') || {}).value);
          if (selected) fillSettingsHolidayForm(selected);
          renderSettingsHolidayClosures();
        }

        function settingsServiceCategoriesFromCatalog(source) {
          if (source && Array.isArray(source.categories) && source.categories.length) return source.categories;

          var groups = {};
          (source && Array.isArray(source.services) ? source.services : []).filter(function(service) {
            return service && service.active !== false;
          }).forEach(function(service) {
            var name = service.requiredSkill || 'Other services';
            var id = 'fallback-' + name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
            if (!groups[id]) groups[id] = { id: id, name: name, services: [] };
            groups[id].services.push(service);
          });
          return Object.keys(groups).map(function(id) { return groups[id]; });
        }

        function settingsCategoryRowMarkup(category) {
          var services = Array.isArray(category.services) ? category.services : [];
          var isDraft = Boolean(category.isDraft);
          var countLabel = isDraft ? 'New category' : (services.length === 1 ? '1 service' : services.length + ' services');
          var rowAttributes = ' data-settings-category-row data-settings-category-id="' + escapeHtml(isDraft ? '' : category.id || '') + '"' + (isDraft ? ' data-settings-category-new="true"' : '');
          var inputValue = isDraft ? '' : (category.name || 'Other services');
          var inputPlaceholder = isDraft ? 'Category name' : '';
          return '<div class="settings-category-row' + (isDraft ? ' is-new' : '') + '"' + rowAttributes + '>' +
            '<div class="settings-category-row-main"><i data-lucide="folder" aria-hidden="true"></i><input class="settings-category-name-input" type="text" value="' + escapeHtml(inputValue) + '"' + (inputPlaceholder ? ' placeholder="' + inputPlaceholder + '"' : '') + ' data-settings-category-name aria-label="Category name"><span class="settings-category-count" data-settings-category-count>' + countLabel + '</span></div>' +
            '<div class="settings-category-row-actions"><button class="settings-category-row-action is-danger" type="button" data-settings-category-remove aria-label="' + (isDraft ? 'Cancel new category' : 'Remove category') + '"><i data-lucide="' + (isDraft ? 'x' : 'trash-2') + '" aria-hidden="true"></i></button></div>' +
          '</div>';
        }

        function renderSettingsCategoryManager(source) {
          var list = document.querySelector('[data-settings-category-list]');
          if (!list) return;

          if (source) {
            settingsManagedCategories = settingsServiceCategoriesFromCatalog(source).map(function(category) {
              return {
                id: String(category.id || ''),
                name: String(category.name || 'Other services'),
                services: Array.isArray(category.services) ? category.services.slice() : []
              };
            }).filter(function(category) { return category.id; });
          }

          var categories = settingsManagedCategories.slice();
          if (settingsCategoryDraft) categories.push(settingsCategoryDraft);
          list.innerHTML = categories.length
            ? categories.map(settingsCategoryRowMarkup).join('')
            : '<div class="settings-category-empty">No categories yet.</div>';
          renderLucideIcons();
        }

        function settingsEnsureManagedCategory(categoryId, categoryName) {
          var targetId = categoryId || 'custom-services';
          var category = settingsManagedCategories.find(function(item) { return item.id === targetId; });
          if (!category) {
            category = { id: targetId, name: categoryName || 'CUSTOM SERVICES', services: [] };
            settingsManagedCategories.push(category);
            renderSettingsCategoryManager();
          }
          return category;
        }

        function settingsServiceRowMarkup(service, index) {
          service = service || {};
          var isDraft = Boolean(service.isDraft);
          var name = service.name == null || (isDraft && !service.name) ? '' : service.name;
          var price = service.price == null ? '' : service.price;
          var duration = service.durationMin == null ? (isDraft ? '' : 60) : service.durationMin;
          var tone = ['tone-violet', 'tone-cyan', 'tone-rose', 'tone-sky', 'tone-amber', 'tone-emerald'][index % 6];
          var serviceIcon = service.id === 'eyelash' || /\b(?:eyelash(?:es)?|lash(?:es)?)\b/i.test(name)
            ? '<img src="../assets/flaticon-flat/industry-lash-12756080.png" alt="" width="24" height="24" style="object-fit:contain">'
            : escapeHtml(service.icon || '✨');
          return '<div class="settings-service-row' + (isDraft ? ' is-draft' : '') + '" data-service-row data-service-id="' + escapeHtml(service.id || '') + '"' + (isDraft ? ' data-service-draft="true"' : '') + '>' +
            '<div class="settings-service-edit-grid">' +
              '<span class="settings-service-visual ' + tone + '" aria-hidden="true">' + serviceIcon + '</span>' +
              '<input class="settings-service-input" type="text" value="' + escapeHtml(name || (isDraft ? '' : 'Unnamed service')) + '"' + (isDraft ? ' placeholder="Service name"' : '') + ' aria-label="Service name">' +
              '<div class="settings-service-input-wrap"><span class="settings-service-prefix">$</span><input class="settings-service-input price" type="number" value="' + escapeHtml(price) + '"' + (isDraft ? ' placeholder="0.00"' : '') + ' aria-label="Service price"></div>' +
              '<div class="settings-service-input-wrap"><input class="settings-service-input duration" type="number" value="' + escapeHtml(duration) + '"' + (isDraft ? ' placeholder="60"' : '') + ' aria-label="Service duration"><span class="settings-service-suffix">min</span></div>' +
              '<button class="settings-service-edit" type="button" data-service-edit aria-label="Edit service"><i class="bi bi-pencil" aria-hidden="true"></i></button>' +
              '<button class="settings-service-remove" type="button" data-service-remove aria-label="Remove service">×</button>' +
            '</div>' +
          '</div>';
        }

        function settingsServiceCategoryMarkup(category, index) {
          var services = Array.isArray(category.services) ? category.services : [];
          return '<details class="settings-service-category" data-service-category data-service-category-id="' + escapeHtml(category.id || '') + '"' + (index === 0 ? ' open' : '') + '>' +
            '<summary class="settings-service-category-head"><span class="settings-service-category-name">' + escapeHtml(category.name || 'Other services') + '</span><span class="settings-service-category-count">' + services.length + '</span><i class="settings-service-category-chevron" data-lucide="chevron-down" aria-hidden="true"></i></summary>' +
            '<div class="settings-service-category-body"><div class="settings-service-header" aria-hidden="true"><span></span><span>Service</span><span>Price</span><span>Duration</span><span></span><span></span></div>' +
            services.map(function(service, serviceIndex) { return settingsServiceRowMarkup(service, index + serviceIndex); }).join('') +
            '<button class="booking-secondary-button settings-service-add-button" type="button" data-settings-service-draft-add><i class="bi bi-plus-lg" aria-hidden="true"></i>Add services</button></div></details>';
        }

        function renderSettingsServiceCatalog(source, fallback) {
          var container = document.querySelector('[data-settings-service-catalog]');
          if (!container) return;
          var categories = settingsServiceCategoriesFromCatalog(source);
          renderSettingsCategoryManager(source);
          container.innerHTML = categories.length
            ? categories.map(settingsServiceCategoryMarkup).join('')
            : '<div class="settings-service-catalog-state">No services available.</div>';
          renderLucideIcons();
          if (fallback) setSettingsStatus('Catalog JSON unavailable. Showing salon catalog services.');
        }

        function settingsEnsureCategory(categoryId, categoryName) {
          var container = document.querySelector('[data-settings-service-catalog]');
          if (!container) return null;

          var targetId = categoryId || 'custom-services';
          settingsEnsureManagedCategory(targetId, categoryName);
          var category = Array.from(container.querySelectorAll('[data-service-category]')).find(function(item) {
            return item.dataset.serviceCategoryId === targetId;
          });
          if (!category) {
            container.insertAdjacentHTML('beforeend', settingsServiceCategoryMarkup({
              id: targetId,
              name: categoryName || 'CUSTOM SERVICES',
              services: []
            }, container.querySelectorAll('[data-service-category]').length));
            renderLucideIcons();
            category = Array.from(container.querySelectorAll('[data-service-category]')).find(function(item) {
              return item.dataset.serviceCategoryId === targetId;
            });
          }
          if (category) category.open = true;
          return category ? category.querySelector('.settings-service-category-body') : null;
        }

        function settingsEnsureCustomCategory() {
          return settingsEnsureCategory('custom-services', 'CUSTOM SERVICES');
        }

        function settingsCategorySlug(value) {
          var slug = String(value || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
          return slug || 'category';
        }

        function setSettingsCategoryModalError(message) {
          var error = document.querySelector('[data-settings-category-modal-error]');
          if (!error) return;
          error.textContent = message || '';
          error.hidden = !message;
        }

        function openSettingsCategoryModal() {
          var modal = document.querySelector('[data-settings-category-modal]');
          if (!modal) return;
          settingsCategoryDraft = null;
          renderSettingsCategoryManager();
          setSettingsCategoryModalError('');
          modal.hidden = false;
          document.body.style.overflow = 'hidden';
          var addButton = modal.querySelector('[data-settings-category-action="add"]');
          if (addButton) addButton.focus();
        }

        function addSettingsCategoryDraft() {
          var list = document.querySelector('[data-settings-category-list]');
          if (!list) return;

          var existingDraft = list.querySelector('[data-settings-category-new]');
          if (existingDraft) {
            var existingField = existingDraft.querySelector('[data-settings-category-name]');
            if (existingField) existingField.focus();
            return;
          }

          settingsCategoryDraft = { id: '', name: '', services: [], isDraft: true };
          renderSettingsCategoryManager();
          var row = list.querySelector('[data-settings-category-new]');
          var field = row && row.querySelector('[data-settings-category-name]');
          if (field) field.focus();
        }

        function closeSettingsCategoryModal() {
          var modal = document.querySelector('[data-settings-category-modal]');
          if (!modal) return;
          modal.hidden = true;
          settingsCategoryDraft = null;
          renderSettingsCategoryManager();
          setSettingsCategoryModalError('');
          document.body.style.overflow = '';
        }

        function saveSettingsCategoryModal() {
          var list = document.querySelector('[data-settings-category-list]');
          var rows = list ? Array.from(list.querySelectorAll('[data-settings-category-row]')) : [];
          var nextCategories = [];
          var seenNames = {};
          var draftAdded = false;

          if (!rows.length) {
            setSettingsCategoryModalError('Add at least one category before saving.');
            return;
          }

          for (var index = 0; index < rows.length; index += 1) {
            var row = rows[index];
            var field = row.querySelector('[data-settings-category-name]');
            var name = field ? field.value.trim() : '';
            var normalizedName = name.toLowerCase();
            if (!name) {
              setSettingsCategoryModalError('Category name is required.');
              if (field) field.focus();
              return;
            }
            if (seenNames[normalizedName]) {
              setSettingsCategoryModalError('A category with this name already exists.');
              if (field) field.focus();
              return;
            }
            seenNames[normalizedName] = true;

            if (row.dataset.settingsCategoryNew === 'true') {
              var baseId = 'custom-' + settingsCategorySlug(name);
              var id = baseId;
              var suffix = 2;
              while (settingsManagedCategories.some(function(category) { return category.id === id; }) || nextCategories.some(function(category) { return category.id === id; })) id = baseId + '-' + suffix++;
              nextCategories.push({ id: id, name: name, services: [] });
              draftAdded = true;
            } else {
              var existingCategory = settingsManagedCategories.find(function(category) { return category.id === row.dataset.settingsCategoryId; });
              if (existingCategory) {
                existingCategory.name = name;
                nextCategories.push(existingCategory);
              }
            }
          }

          settingsManagedCategories = nextCategories;
          settingsCategoryDraft = null;
          renderSettingsCategoryManager();
          settingsManagedCategories.forEach(function(category) {
            settingsEnsureCategory(category.id, category.name);
            var serviceCategory = Array.from(document.querySelectorAll('[data-service-category-id]')).find(function(item) { return item.dataset.serviceCategoryId === category.id; });
            var label = serviceCategory && serviceCategory.querySelector('.settings-service-category-name');
            if (label) label.textContent = category.name;
          });
          populateSettingsServiceModalCategories();
          setSettingsCategoryModalError('');
          setSettingsStatus(draftAdded ? 'Categories saved. New category added.' : 'Categories saved.');
        }

        function removeSettingsCategory(row) {
          if (!row) return;
          if (row.dataset.settingsCategoryNew === 'true') {
            settingsCategoryDraft = null;
            renderSettingsCategoryManager();
            setSettingsCategoryModalError('');
            return;
          }
          var id = row.dataset.settingsCategoryId;
          var category = settingsManagedCategories.find(function(item) { return item.id === id; });
          if (!category) return;
          if (category.services.length) {
            setSettingsStatus('Remove all services from this category before deleting it.');
            return;
          }

          settingsManagedCategories = settingsManagedCategories.filter(function(item) { return item.id !== id; });
          var serviceCategory = Array.from(document.querySelectorAll('[data-service-category-id]')).find(function(item) { return item.dataset.serviceCategoryId === id; });
          if (serviceCategory) serviceCategory.remove();
          renderSettingsCategoryManager();
          populateSettingsServiceModalCategories();
          setSettingsStatus('Category removed.');
        }

        function populateSettingsServiceModalCategories() {
          var select = document.querySelector('[data-service-modal-field="category"]');
          if (!select) return;

          var source = appointmentServiceCatalog || { services: catalog.services };
          var categories = settingsManagedCategories.length ? settingsManagedCategories : settingsServiceCategoriesFromCatalog(source);
          var seen = {};
          var options = categories.filter(function(category) {
            if (!category || !category.id || seen[category.id]) return false;
            seen[category.id] = true;
            return true;
          }).map(function(category) {
            return '<option value="' + escapeHtml(category.id) + '">' + escapeHtml(category.name || 'Other services') + '</option>';
          });

          if (!seen['custom-services']) {
            options.push('<option value="custom-services">CUSTOM SERVICES</option>');
          }
          select.innerHTML = options.join('');
          select.value = 'custom-services';
        }

        function updateSettingsServiceCategoryCount(category) {
          if (!category) return;
          var count = category.querySelector('.settings-service-category-count');
          if (count) count.textContent = category.querySelectorAll('[data-service-row]').length;
        }

        function addSettingsServiceDraft(button) {
          var category = button ? button.closest('[data-service-category]') : null;
          if (!category) return null;

          var categoryId = category.dataset.serviceCategoryId || '';
          var categoryNameElement = category.querySelector('.settings-service-category-name');
          var categoryName = categoryNameElement ? categoryNameElement.textContent.trim() : 'Other services';
          var rowIndex = category.querySelectorAll('[data-service-row]').length;
          var draft = {
            id: 'draft-' + Date.now() + '-' + (++settingsServiceDraftSequence),
            name: '',
            price: null,
            durationMin: null,
            icon: '✨',
            isDraft: true
          };

          category.open = true;
          button.insertAdjacentHTML('beforebegin', settingsServiceRowMarkup(draft, rowIndex));
          var row = button.previousElementSibling;
          updateSettingsServiceCategoryCount(category);

          var managedCategory = settingsEnsureManagedCategory(categoryId, categoryName);
          managedCategory.services.push(draft);
          renderSettingsCategoryManager();
          setSettingsStatus('Draft service added to ' + categoryName + '.');

          var nameField = row ? row.querySelector('[aria-label="Service name"]') : null;
          if (nameField) nameField.focus();
          return row;
        }

