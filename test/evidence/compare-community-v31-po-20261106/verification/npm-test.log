            padding-bottom: 6px;
            border-bottom: 1px solid var(--nexora-rule);
            font-size: 12px;
          }

          #panel-overview .overview-table td::before {
            content: attr(data-label);
            flex: 0 0 auto;
            color: var(--nexora-subtle);
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
          }

          #panel-overview .overview-table td:first-child::before {
            content: none;
          }

          #panel-overview .badge {
            max-width: 100%;
            text-align: center;
            white-space: normal;
          }

          #panel-overview .card-heading {
