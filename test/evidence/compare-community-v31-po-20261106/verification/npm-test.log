                  '<div class="owner-metric-row">' +
                    '<div class="owner-metric-cell"><span class="perf-section-label">Total</span><span class="perf-stat-value pos-good-text">' + money(r.tot) + '</span></div>' +
                    '<div class="owner-metric-cell"><span class="perf-section-label">Method</span><span class="perf-stat-value">' + (x.m ? PAYOUT_M[x.m] : '<span class="pos-warn-text">— none</span>') + '</span></div>' +
