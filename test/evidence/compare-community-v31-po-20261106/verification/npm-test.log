          };
          // Booking → completed (#pos-nail-salon-ops Phase 4, rule 3): only once every non-cancelled
          // service ticket of the booking has been paid (operational status 'completed').
          function checkBookingOrderComplete(bookingId) {
            var booking = posBookingById(bookingId);
            if (!booking || booking.status === 'completed') return;
            var relevantTickets = (booking.tickets || []).filter(function (t) { return t.status !== 'cancelled'; });
            if (!relevantTickets.length) return;
            var allDone = relevantTickets.every(function (t) {
              var w = WAITLIST.find(function (candidate) { return queueTicketHasServiceTicket(candidate, t.id); });
              return w && w.status === 'completed';
            });
            if (!allDone) return;
            var result = appointmentStore.update(bookingId, { status: 'completed' }, null, salonCatalog);
            if (result.ok) reloadAppointmentSnapshot();
          }
          function cancelQueueTicket(w) {
            if (!w) return { ok: false, error: { message: 'Queue ticket not found.' } };
            if (w.bookingId) {
