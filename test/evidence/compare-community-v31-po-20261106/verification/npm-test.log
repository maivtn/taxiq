        #nx-campaign-root .sms-credit-package-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
        #nx-campaign-root .sms-credit-package { position:relative; min-width:0; border:1px solid var(--nexora-border); border-radius:12px; background:#fff; padding:13px; color:var(--nexora-text); text-align:left; cursor:pointer; transition:border-color .18s ease, box-shadow .18s ease, transform .18s ease; }
