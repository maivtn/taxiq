          margin-top: -2px;
        }

        .settings-holiday-reason-chip {
          border: 1px solid rgba(70, 72, 216, 0.18);
          border-radius: 999px;
          background: #f7f8ff;
          padding: 6px 10px;
          color: var(--nexora-brand);
          font-size: 11px;
          font-weight: 800;
          line-height: 1;
          white-space: nowrap;
          transition: border-color 0.16s ease, background 0.16s ease, color 0.16s ease;
        }

        .settings-holiday-reason-chip:hover {
          border-color: rgba(70, 72, 216, 0.34);
          background: #eef2ff;
          color: var(--nexora-electric);
        }

        .settings-holiday-actions {
          display: flex;
          flex-wrap: wrap;
          gap: 8px;
          justify-content: flex-end;
        }

        .settings-holiday-actions > button {
          min-width: 0;
        }

        .settings-holiday-notify {
          display: flex;
          justify-content: space-between;
          align-items: center;
          gap: 12px;
          margin-top: 12px;
          color: var(--nexora-text);
          font-size: 12px;
          font-weight: 800;
        }

        .settings-holiday-notify span {
          min-width: 0;
        }

        .settings-holiday-notify .is-off {
          color: var(--nexora-subtle);
        }

        .settings-holiday-row-actions {
          display: inline-flex;
          align-items: center;
          gap: 5px;
          justify-content: flex-end;
          opacity: 1;
          transition: opacity 0.16s ease;
        }

        .settings-holiday-row:hover .settings-holiday-row-actions,
        .settings-holiday-row:focus-within .settings-holiday-row-actions {
          opacity: 1;
        }

        .settings-holiday-icon-button {
          display: inline-flex;
          align-items: center;
          height: 26px;
          padding: 0 9px;
          border: 1px solid transparent;
          border-radius: 8px;
          background: transparent;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 800;
          white-space: nowrap;
        }

        .settings-holiday-icon-button:hover {
          border-color: rgba(70, 72, 216, 0.25);
          background: #f7f8ff;
          color: var(--nexora-brand);
        }

        .settings-holiday-icon-button.is-danger:hover {
          border-color: rgba(220, 38, 38, 0.22);
          background: #fff1f2;
          color: #dc2626;
        }

        .settings-holiday-empty {
          padding: 12px 0 4px;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 700;
        }

        .settings-holiday-badge {
          display: inline-flex;
          align-items: center;
          border-radius: 999px;
          background: #eef2ff;
          padding: 3px 8px;
          color: var(--nexora-brand);
          font-size: 11px;
          font-weight: 900;
          white-space: nowrap;
        }

        .settings-holiday-badge.is-closed {
          background: #fff1f2;
          color: #b91c1c;
        }

        .settings-holiday-badge.is-adjusted {
          background: #fffbeb;
          color: #92400e;
        }

        .booking-calendar-closed-cell {
          background: #fef2f2 !important;
          color: #991b1b;
          pointer-events: none;
        }

        .booking-calendar-closed-cell .booking-cell-add {
          opacity: 0.35;
        }

        @container holiday-card (max-width: 420px) {
          .settings-holiday-table {
            gap: 8px;
          }

          .settings-holiday-table-head {
            display: none;
          }

          .settings-holiday-row {
            grid-template-columns: minmax(0, 1fr) auto;
            grid-template-areas:
              "date type"
              "reason reason"
              "actions actions";
            gap: 8px 10px;
            align-items: start;
            min-height: 0;
            border: 1px solid var(--nexora-border);
            border-radius: 10px;
            background: #fff;
            padding: 10px;
          }

          .settings-holiday-date {
            grid-area: date;
          }

          .settings-holiday-type {
            grid-area: type;
            justify-self: end;
          }

          .settings-holiday-reason {
            grid-area: reason;
            overflow: visible;
            text-overflow: clip;
            white-space: normal;
          }

          .settings-holiday-row-actions {
            grid-area: actions;
            flex-wrap: wrap;
            justify-content: flex-start;
            opacity: 1;
          }

          .settings-holiday-notify {
            align-items: flex-start;
            flex-wrap: wrap;
            justify-content: flex-start;
          }
        }

        @media (max-width: 520px) {
          .settings-booking-sms-row {
            align-items: start;
          }

          .settings-holiday-form {
            grid-template-columns: 1fr;
          }
        }

        .settings-service-list.settings-service-body {
          max-height: 540px;
          overflow-y: auto;
          gap: 5px;
        }

        .settings-service-catalog-state {
          border: 1px dashed var(--nexora-border);
          border-radius: 10px;
          padding: 16px;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 700;
          text-align: center;
        }

        .settings-category-manager {
          margin-bottom: 12px;
          border: 1px solid var(--nexora-border);
          border-radius: 11px;
          background: #fff;
          padding: 10px;
        }

        .settings-category-manager-head {
          display: flex;
          align-items: flex-start;
          justify-content: space-between;
          gap: 10px;
          margin-bottom: 9px;
        }

        .settings-category-manager-title {
          display: flex;
          align-items: center;
          gap: 6px;
          color: var(--nexora-text);
          font-size: 11px;
          font-weight: 900;
        }

        .settings-category-manager-title svg {
          width: 15px;
          height: 15px;
          color: var(--nexora-brand);
        }

        .settings-category-manager-sub {
          margin-top: 3px;
          color: var(--nexora-muted);
          font-size: 10px;
          line-height: 1.4;
        }

        .settings-category-manager-add {
          display: inline-flex;
          flex: 0 0 auto;
          align-items: center;
          gap: 5px;
          border: 1px solid rgba(70, 72, 216, .22);
          border-radius: 8px;
          background: #f6f7ff;
          padding: 6px 8px;
          color: var(--nexora-brand);
          font-size: 10px;
          font-weight: 850;
        }

        .settings-category-manager-add svg {
          width: 13px;
          height: 13px;
        }

        .settings-category-manager-open {
          display: inline-flex;
          align-items: center;
          gap: 6px;
        }

        .settings-category-manager-open svg {
          width: 14px;
          height: 14px;
        }

        .settings-service-actions {
          display: flex;
          flex-wrap: wrap;
          align-items: stretch;
          margin-bottom: 12px;
        }

        .settings-service-actions > button {
          flex: 0 1 auto;
          min-width: 0;
        }

        .settings-category-list {
          display: grid;
          gap: 5px;
        }

        .settings-category-row {
          display: grid;
          grid-template-columns: minmax(0, 1fr) auto;
          align-items: center;
          gap: 7px;
          border: 1px solid var(--nexora-rule);
          border-radius: 8px;
          background: var(--nexora-surface-muted);
          padding: 6px 7px;
        }

        .settings-category-row-main {
          display: flex;
          min-width: 0;
          align-items: center;
          gap: 7px;
        }

        .settings-category-row-main > svg {
          width: 14px;
          height: 14px;
          flex: 0 0 auto;
          color: var(--nexora-brand);
        }

        .settings-category-name-input {
          width: 100%;
          min-width: 0;
          border: 1px solid transparent;
          border-radius: 6px;
          background: transparent;
          padding: 5px 6px;
          color: var(--nexora-text);
          font-size: 11px;
          font-weight: 800;
        }

        .settings-category-name-input:focus {
          border-color: var(--nexora-brand);
          background: #fff;
          outline: 0;
          box-shadow: 0 0 0 2px rgba(70, 72, 216, .1);
        }

        .settings-category-count {
          flex: 0 0 auto;
          color: var(--nexora-subtle);
          font-size: 10px;
          font-weight: 750;
          white-space: nowrap;
        }

        .settings-category-row-actions {
          display: flex;
          align-items: center;
          gap: 3px;
        }

        .settings-category-row-action {
          display: inline-grid;
          width: 27px;
          height: 27px;
          place-items: center;
          border: 1px solid transparent;
          border-radius: 7px;
          background: transparent;
          color: var(--nexora-muted);
        }

        .settings-category-row-action:hover {
          border-color: var(--nexora-border);
          background: #fff;
          color: var(--nexora-brand);
        }

        .settings-category-row-action.is-danger:hover {
          border-color: rgba(220, 38, 38, .18);
          color: #dc2626;
        }

        .settings-category-row-action svg {
          width: 14px;
          height: 14px;
        }

        .settings-category-empty {
          border: 1px dashed var(--nexora-border);
          border-radius: 8px;
          padding: 9px;
          color: var(--nexora-subtle);
          font-size: 10px;
          font-weight: 700;
          text-align: center;
        }

        .settings-service-category {
          overflow: hidden;
          border: 1px solid var(--nexora-border);
          border-radius: 11px;
          background: #fff;
        }

        .settings-service-category + .settings-service-category {
          margin-top: 6px;
        }

        .settings-service-category-head {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 10px;
          list-style: none;
          cursor: pointer;
          padding: 10px 11px;
          background: #f8faff;
        }

        .settings-service-category-head::-webkit-details-marker {
          display: none;
        }

        .settings-service-category-chevron {
          width: 16px;
          height: 16px;
          flex: 0 0 auto;
          color: var(--nexora-subtle);
          transition: transform .16s ease;
        }

        .settings-service-category:not([open]) .settings-service-category-chevron {
          transform: rotate(-90deg);
        }

        .settings-service-category-name {
          color: var(--nexora-text);
          font-size: 11px;
          font-weight: 900;
          letter-spacing: .04em;
          text-transform: uppercase;
        }

        .settings-service-category-count {
          margin-left: auto;
          border-radius: 999px;
          background: #e9edff;
          padding: 2px 7px;
          color: var(--nexora-brand);
          font-size: 10px;
          font-weight: 800;
        }

        .settings-service-category-body {
          display: grid;
          gap: 5px;
          padding: 7px;
        }

        .settings-service-add-button {
          width: 100%;
          justify-content: center;
          border-style: dashed;
          background: #f8faff;
          color: var(--nexora-brand);
        }

        .settings-service-row.is-draft {
          border-color: rgba(70, 72, 216, 0.3);
          background: rgba(70, 72, 216, 0.025);
        }

        .settings-service-header {
          display: grid;
          grid-template-columns: 30px minmax(82px, 1fr) 58px 70px 28px 28px;
          align-items: center;
          gap: 5px;
          padding: 0 7px 4px;
          color: var(--nexora-subtle);
          font-size: 10px;
          font-weight: 750;
          letter-spacing: 0.02em;
          text-transform: uppercase;
        }

        .settings-service-row {
          display: grid;
          grid-template-columns: minmax(0, 1fr);
          gap: 0;
          align-items: center;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: #fff;
          padding: 7px;
        }

        .settings-service-row.is-compact {
          gap: 0;
          padding: 7px;
          border-radius: 10px;
          box-shadow: none;
        }

        .settings-service-edit-grid {
          display: grid;
          grid-template-columns: 30px minmax(82px, 1fr) 58px 70px 28px 28px;
          align-items: center;
          gap: 5px;
        }

        .settings-service-row.is-compact .settings-service-edit-grid {
          grid-template-columns: 34px minmax(96px, 1fr) 64px 72px 28px 28px;
          gap: 6px;
          align-items: center;
        }

        .settings-service-visual {
          display: inline-flex;
          width: 30px;
          height: 30px;
          align-items: center;
          justify-content: center;
          border: 1px solid var(--nexora-border);
          border-radius: 9px;
          background: var(--nexora-canvas);
          font-size: 14px;
        }

        .settings-service-input-wrap {
          position: relative;
          min-width: 0;
        }

        .settings-service-input {
          width: 100%;
          min-height: 34px;
          border: 1px solid var(--nexora-border);
          border-radius: 9px;
          background: #fff;
          padding: 0 8px;
          color: var(--nexora-text);
          font-size: 11.5px;
          font-weight: 600;
          outline: none;
        }

        .settings-service-input.price {
          padding-left: 20px;
        }

        .settings-service-input.duration {
          padding-right: 24px;
        }

        .settings-service-row.is-compact .settings-service-input {
          min-height: 34px;
          padding-right: 8px;
          padding-left: 8px;
          font-size: 11.5px;
        }

        .settings-service-row.is-compact .settings-service-input.price {
          padding-left: 20px;
        }

        .settings-service-row.is-compact .settings-service-input.duration {
          padding-right: 24px;
        }

        .settings-service-prefix,
        .settings-service-suffix {
          position: absolute;
          top: 50%;
          color: var(--nexora-subtle);
          font-size: 10px;
          font-weight: 600;
          transform: translateY(-50%);
          pointer-events: none;
        }

        .settings-service-prefix {
          left: 8px;
        }

        .settings-service-suffix {
          right: 8px;
        }

        .settings-service-input:focus {
          border-color: rgba(70, 72, 216, 0.42);
          box-shadow: 0 0 0 3px rgba(70, 72, 216, 0.1);
        }

        .settings-service-name {
          color: var(--nexora-text);
          font-size: 12px;
          font-weight: 700;
        }

        .settings-service-meta {
          display: flex;
          flex-wrap: wrap;
          gap: 7px;
        }

        .settings-service-edit,
        .settings-service-remove {
          display: inline-flex;
          width: 28px;
          height: 34px;
          align-items: center;
          justify-content: center;
          border: 1px solid var(--nexora-border);
          border-radius: 9px;
          background: #fff;
          color: var(--nexora-muted);
          font-size: 14px;
          font-weight: 700;
        }

        .settings-service-row.is-compact .settings-service-edit,
        .settings-service-row.is-compact .settings-service-remove {
          width: 28px;
          height: 34px;
          border-radius: 8px;
          font-size: 13px;
        }

        .settings-service-edit:hover {
          border-color: rgba(70, 72, 216, 0.25);
          color: var(--nexora-brand);
        }

        .settings-service-remove:hover {
          border-color: rgba(239, 68, 68, 0.24);
          color: #ef4444;
        }

        .settings-service-panel {
          border: 1px solid rgba(70, 72, 216, 0.18);
          border-radius: 12px;
          background: color-mix(in srgb, var(--nexora-brand) 5%, white);
          padding: 12px;
          margin-bottom: 12px;
        }

        .settings-service-panel[hidden] {
          display: none;
        }

        .settings-service-panel-title {
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 600;
          line-height: 1.5;
          margin-bottom: 8px;
        }

        .settings-service-progress {
          color: var(--nexora-muted);
          font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
          font-size: 11px;
          font-weight: 500;
          line-height: 1.8;
        }

        .settings-service-modal {
          position: fixed;
          inset: 0;
          z-index: 125;
          display: flex;
          align-items: center;
          justify-content: center;
          background: rgba(8, 18, 38, 0.54);
          padding: 18px;
          backdrop-filter: blur(10px);
        }

        .settings-service-modal[hidden] {
          display: none;
        }

        .settings-service-dialog {
          width: min(100%, 520px);
          border: 1px solid var(--nexora-border);
          border-radius: 16px;
          background: #fff;
          box-shadow: 0 28px 80px rgba(8, 18, 38, 0.28);
        }

        .settings-service-modal-head,
        .settings-service-modal-actions {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 12px;
        }

        .settings-service-modal-head {
          align-items: flex-start;
          border-bottom: 1px solid var(--nexora-rule);
          padding: 18px;
        }

        .settings-service-modal-title {
          color: var(--nexora-text);
          font-size: 16px;
          font-weight: 800;
          line-height: 1.3;
        }

        .settings-service-modal-sub {
          margin-top: 4px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 500;
          line-height: 1.45;
        }

        .settings-service-modal-close {
          display: inline-flex;
          width: 34px;
          height: 34px;
          flex-shrink: 0;
          align-items: center;
          justify-content: center;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: var(--nexora-surface-muted);
          color: var(--nexora-muted);
          font-size: 16px;
          font-weight: 800;
        }

        .settings-service-modal-body {
          display: grid;
          gap: 12px;
          padding: 18px;
        }

        .settings-service-modal-grid {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 10px;
        }

        .settings-service-modal-field-name {
          grid-column: 1 / -1;
        }

        .settings-service-modal-error {
          border: 1px solid rgba(239, 68, 68, 0.24);
          border-radius: 9px;
          background: #fff5f5;
          padding: 9px 10px;
          color: #c24141;
          font-size: 11px;
          font-weight: 700;
          line-height: 1.4;
        }

        .settings-service-modal-error[hidden] {
