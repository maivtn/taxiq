                '</article>';
            }).join('') + '</div>';
            return '<div class="pos-card">' +
              '<div class="pos-card-head"><h3><i class="bi bi-gem" aria-hidden="true"></i> Smart Commission — performance bonus on top of the base %</h3>' +
              '<div class="pos-inline">' +
                '<button class="pos-btn pos-btn-sm ' + (SMART.on ? 'pos-btn-success' : '') + '" data-mg-smart>' + (SMART.on ? '<i class="bi bi-check-circle-fill" aria-hidden="true"></i> On — turn off' : '<i class="bi bi-circle" aria-hidden="true"></i> Off — turn on') + '</button>' +
                '<div class="booking-view-switch" role="group" aria-label="Smart Commission view mode">' +
                  '<button class="booking-view-button' + (mgSmartViewMode === 'table' ? ' is-active' : '') + '" type="button" data-mg-smart-view-target="table" aria-pressed="' + (mgSmartViewMode === 'table' ? 'true' : 'false') + '"><i class="bi bi-table" aria-hidden="true"></i>Table</button>' +
                  '<button class="booking-view-button' + (mgSmartViewMode === 'card' ? ' is-active' : '') + '" type="button" data-mg-smart-view-target="card" aria-pressed="' + (mgSmartViewMode === 'card' ? 'true' : 'false') + '"><i class="bi bi-grid-1x2" aria-hidden="true"></i>Card</button>' +
                '</div>' +
