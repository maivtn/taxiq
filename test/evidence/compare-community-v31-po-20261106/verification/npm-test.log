        }

        .settings-help {
          color: var(--nexora-muted);
          font-size: 10.5px;
          font-weight: 500;
          line-height: 1.45;
        }

        .settings-progress {
          margin-top: 12px;
          border: 1px solid rgba(70, 72, 216, 0.16);
          border-radius: 12px;
          background: rgba(255, 255, 255, 0.7);
          padding: 11px 12px;
          color: var(--nexora-muted);
          font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
          font-size: 11px;
          font-weight: 750;
          line-height: 1.8;
        }

        .settings-progress[hidden] {
