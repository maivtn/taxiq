          function showSmsCreditPurchaseSuccess(selectedPackage, selectedPayment) {
            $('successText').textContent = 'Đã thêm ' + selectedPackage.credits.toLocaleString() + ' SMS credits qua ' + selectedPayment.label + '.';
            $('successBanner').classList.add('show');
