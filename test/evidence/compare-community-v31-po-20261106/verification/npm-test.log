        .booking-service-category-chip { flex: 0 0 auto; border: 1px solid var(--nexora-border); border-radius: 999px; background: #fff; padding: 6px 10px; color: var(--nexora-muted); font-size: 11px; font-weight: 800; white-space: nowrap; transition: background .2s, border-color .2s, color .2s; }
        .booking-service-category-chip.category-trigger { width: auto; max-width: 100%; min-height: 34px; display: inline-flex; align-items: center; gap: 7px; padding: 5px 8px 5px 12px; text-align: left; box-shadow: 0 5px 12px rgba(24, 20, 54, .05); }
