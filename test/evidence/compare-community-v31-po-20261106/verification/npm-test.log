            var tableHtml = '<div class="pos-table-wrap"><table class="pos-table tight"><thead><tr><th>Tech</th><th>Weekly pay (<i class="bi bi-briefcase" aria-hidden="true"></i>)</th><th>Tips today</th><th>Total</th><th>Method</th><th>Status</th><th></th></tr></thead><tbody>' +
