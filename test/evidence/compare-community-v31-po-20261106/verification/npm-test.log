  code: 'ERR_ASSERTION'
  name: 'AssertionError'
  expected:
  actual: |-
    /* ==========================================================================
       Nexora shared shell — sidebar + header
       Single source of truth for the merchant sidebar and top header, used by
       every page that includes nexora-shell.js. Load this AFTER a page's inline
       <style> so it governs the shell consistently across pages.
       ========================================================================== */

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      min-height: 100%;
      font-family: "Inter", sans-serif;
      background: var(--nexora-canvas);
      color: var(--nexora-text);
    }

    button,
    input,
    textarea,
    select {
      font: inherit;
    }

    .credits-history-date {
      display: grid;
      gap: 2px;
      color: var(--nexora-text);
      font-size: 12px;
      font-weight: 800;
      line-height: 16px;
      white-space: nowrap;
    }

    .credits-history-date small {
      display: block;
      color: var(--nexora-text);
      font-size: 11px;
      font-weight: 700;
      line-height: 14px;
    }

    :root {
      --luxury-gold: #d4af37;
      --brand-cyan: #32d7ff;
      --nexora-canvas: #f7f9fc;
      --nexora-surface: #ffffff;
      --nexora-surface-muted: #f3f6fa;
      --nexora-border: #dde5ef;
      --nexora-rule: #e7ecf3;
      --nexora-text: #0b1220;
      --nexora-muted: #4d5870;
      --nexora-subtle: #7a8296;
      --nexora-sidebar: #081f49;
      --nexora-brand: #4648d8;
      --nexora-brand-dark: #393bc8;
      --nexora-electric: #2b59ff;
      --nexora-violet: #8e4df8;
      --nexora-success: #00b873;
      --nexora-warning: #f59e0b;
      --nexora-danger: #ef4444;
      --nexora-card-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
      --nexora-soft-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
    }

    .shell {
      min-height: 100vh;
      background: var(--nexora-canvas);
    }

    /* ── sidebar shell ─────────────────────────────────────────────────────── */
    .sidebar {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 30;
      display: none;
      width: 288px;
      flex-direction: column;
      background: var(--nexora-sidebar);
      color: #fff;
      padding: 28px 20px;
    }

    .sidebar-panel {
      flex-shrink: 0;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.05);
      padding: 8px;
    }

    .profile-row {
      display: flex;
      min-width: 0;
      align-items: center;
      gap: 12px;
    }

    .avatar {
      display: inline-flex;
      width: 40px;
      height: 40px;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--nexora-electric), var(--nexora-violet));
      color: #fff;
      font-size: 13px;
      font-weight: 800;
      text-transform: uppercase;
    }

    .profile-name {
      overflow: hidden;
      color: #fff;
      font-size: 14px;
      font-weight: 700;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .profile-email {
      margin-top: 2px;
      overflow: hidden;
      color: rgba(255, 255, 255, 0.6);
      font-size: 11px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .plan-panel {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-top: 16px;
      margin-bottom: 12px;
      padding: 10px 12px;
    }

    .plan-info {
      min-width: 0;
    }

    .panel-kicker {
      color: rgba(255, 255, 255, 0.45);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .panel-title {
      margin-top: 2px;
      color: #fff;
      font-size: 13px;
      font-weight: 900;
    }

    .plan-button {
      flex-shrink: 0;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 8px;
      background: transparent;
      padding: 6px 12px;
      color: var(--luxury-gold);
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s;
    }

    .plan-button:hover {
      border-color: rgba(255, 255, 255, 0.25);
      background: rgba(255, 255, 255, 0.05);
    }

    .sidebar-nav {
      margin-top: 24px;
      flex: 1;
      overflow-y: auto;
      padding-right: 4px;
    }

    .nav-divider {
      margin: 4px 0;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .nav-item {
      display: flex;
      width: 100%;
      height: 48px;
      align-items: center;
      gap: 12px;
      border: 0;
      border-radius: 8px;
      background: transparent;
      padding: 0 16px;
      color: rgba(255, 255, 255, 0.85);
      text-align: left;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.2s, color 0.2s, box-shadow 0.2s;
    }

    .nav-item:hover {
      background: rgba(255, 255, 255, 0.05);
      color: #fff;
    }

    .nav-item.is-active {
      background: linear-gradient(90deg, var(--nexora-electric), var(--nexora-violet));
      color: #fff;
      box-shadow: 0 10px 24px rgba(43, 89, 255, 0.2);
    }

    .sidebar-icon-wrap {
      display: inline-flex;
      width: 30px;
      height: 30px;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
    }

    .sidebar-icon {
      width: 24px;
      height: 24px;
      object-fit: contain;
      filter: brightness(1.15) saturate(1.2) contrast(1.05)
        drop-shadow(0 0 3px rgba(255, 66, 215, 0.3))
        drop-shadow(0 0 6px rgba(50, 215, 255, 0.2));
      transition: filter 0.2s, transform 0.2s;
    }

    .nav-item:hover .sidebar-icon,
    .nav-item.is-active .sidebar-icon {
      filter: brightness(1.3) saturate(1.35) contrast(1.1)
        drop-shadow(0 0 4px rgba(255, 66, 215, 0.45))
        drop-shadow(0 0 8px rgba(50, 215, 255, 0.35))
        drop-shadow(0 0 12px rgba(138, 92, 255, 0.25));
      transform: scale(1.04);
    }

    .nav-item:hover .sidebar-icon-wrap,
    .nav-item.is-active .sidebar-icon-wrap {
      background: radial-gradient(
        circle,
        rgba(138, 92, 255, 0.24) 0%,
        rgba(50, 215, 255, 0.08) 45%,
        transparent 72%
      );
    }

    .lucide-menu-icon {
      display: block;
      width: 22px;
      height: 22px;
      color: #fff;
      filter: drop-shadow(0 0 4px rgba(255, 66, 215, 0.32))
        drop-shadow(0 0 8px rgba(50, 215, 255, 0.24));
      transition: filter 0.2s, transform 0.2s;
    }

    .nav-item:hover .lucide-menu-icon,
    .nav-item.is-active .lucide-menu-icon {
      filter: drop-shadow(0 0 4px rgba(255, 66, 215, 0.45))
        drop-shadow(0 0 8px rgba(50, 215, 255, 0.35))
        drop-shadow(0 0 12px rgba(138, 92, 255, 0.25));
      transform: scale(1.04);
    }

    .lucide-menu-icon path,
    .lucide-menu-icon rect,
    .lucide-menu-icon circle,
    .lucide-menu-icon line,
    .lucide-menu-icon polyline {
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* ── expandable nav groups ─────────────────────────────────────────────── */
    .nav-parent {
      position: relative;
    }

    .nav-caret {
      width: 16px;
      height: 16px;
      margin-left: auto;
      flex-shrink: 0;
      color: rgba(255, 255, 255, 0.6);
      transition: transform 0.24s ease, color 0.2s;
    }

    .nav-parent:hover .nav-caret {
      color: #fff;
    }

    .nav-parent.is-expanded .nav-caret {
      transform: rotate(180deg);
    }

    .nav-caret path {
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
      fill: none;
    }

    /* collapse via max-height so a collapsed group leaves ZERO height — overflow
       clips the inner's margins/border too, which the old grid 0fr trick did not
       (that left a stray strip between groups that read as a horizontal line). */
    .nav-subnav {
      display: block;
      overflow: hidden;
      max-height: 500px;
      transition: max-height 0.26s ease;
    }

    .nav-subnav.is-collapsed {
      max-height: 0;
    }

    .nav-subnav-inner {
      display: flex;
      flex-direction: column;
      gap: 2px;
      margin: 2px 0 6px 30px;
      padding-left: 14px;
      border-left: 1px solid rgba(255, 255, 255, 0.12);
    }

    .nav-subitem {
      display: flex;
      width: 100%;
      height: 38px;
      align-items: center;
      gap: 8px;
      border: 0;
      border-radius: 8px;
      background: transparent;
      padding: 0 12px;
      color: rgba(255, 255, 255, 0.62);
      text-align: left;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
    }

    .nav-subitem:hover {
      background: rgba(255, 255, 255, 0.05);
      color: #fff;
    }

    .nav-subitem.is-active {
      background: rgba(255, 255, 255, 0.09);
      color: #fff;
      font-weight: 800;
    }

    .nav-subitem-dot {
      width: 6px;
      height: 6px;
      flex-shrink: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.3);
      transition: background 0.2s, box-shadow 0.2s;
    }

    .nav-subitem:hover .nav-subitem-dot {
      background: rgba(255, 255, 255, 0.55);
    }

    .nav-subitem.is-active .nav-subitem-dot {
      background: var(--brand-cyan);
      box-shadow: 0 0 8px rgba(50, 215, 255, 0.6);
    }

    .sidebar-footer {
      margin-top: auto;
      flex-shrink: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.15);
      padding-top: 16px;
    }

    .logout-button {
      display: flex;
      width: 100%;
      align-items: center;
      gap: 8px;
      border: 0;
      background: transparent;
      padding: 8px 12px;
      color: rgba(255, 255, 255, 0.65);
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      transition: color 0.2s;
    }

    .logout-button:hover {
      color: #fff;
    }

    .logout-icon {
      display: inline-flex;
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
    }

    .logout-icon svg {
      width: 17px;
      height: 17px;
    }

    /* ── header shell ──────────────────────────────────────────────────────── */
    .app-area {
      min-height: 100vh;
    }

    .content {
      min-height: calc(100vh - 64px);
      padding: 16px 16px 96px;
    }

    .header {
      position: sticky;
      top: 0;
      z-index: 20;
      display: flex;
      min-height: 64px;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      border-bottom: 1px solid var(--nexora-border);
      background: var(--nexora-surface);
      padding: 0 16px;
    }

    .mobile-brand {
      display: flex;
      min-width: 0;
      align-items: center;
      gap: 12px;
    }

    .icon-button {
      display: inline-flex;
      width: 40px;
      height: 40px;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--nexora-border);
      border-radius: 8px;
      background: #fff;
      color: var(--nexora-text);
      box-shadow: var(--nexora-soft-shadow);
      cursor: pointer;
      transition: background 0.2s;
    }

    .icon-button:hover {
      background: var(--nexora-surface-muted);
    }

    .brand-logo {
      width: 36px;
      height: 36px;
      flex-shrink: 0;
      object-fit: contain;
    }

    .search {
      position: relative;
      display: none;
      width: min(100%, 385px);
    }

    .search svg {
      position: absolute;
      top: 50%;
      left: 16px;
      width: 16px;
      height: 16px;
      color: var(--nexora-muted);
      transform: translateY(-50%);
      pointer-events: none;
    }

    .search input {
      width: 100%;
      height: 44px;
      border: 1px solid transparent;
      border-radius: 999px;
      outline: 0;
      background: var(--nexora-surface-muted);
      padding: 0 16px 0 48px;
      color: var(--nexora-text);
      font-size: 14px;
    }

    .search input::placeholder {
      color: var(--nexora-subtle);
    }

    .search input:focus {
      border-color: var(--nexora-brand);
      box-shadow: 0 0 0 2px rgba(70, 72, 216, 0.2);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .shell-clear-storage-button {
      display: inline-flex;
      min-height: 38px;
      align-items: center;
      gap: 7px;
      border: 1px solid #f0caca;
      border-radius: 8px;
      background: #fff7f7;
      padding: 0 11px;
      color: #b42318;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s;
    }

    .shell-clear-storage-button:hover {
      border-color: #e9a6a6;
      background: #ffeded;
    }

    .shell-clear-storage-button:disabled {
      border-color: #c9e8d7;
      background: #effaf3;
      color: #16804a;
      cursor: default;
    }

    .shell-clear-storage-button svg {
      width: 16px;
      height: 16px;
    }

    .language-switcher {
      display: none;
      align-items: center;
      gap: 4px;
      border: 1px solid var(--nexora-border);
      border-radius: 999px;
      background: var(--nexora-surface-muted);
      padding: 4px;
    }

    .language-switcher button {
      border: 0;
      border-radius: 999px;
      background: transparent;
      padding: 5px 9px;
      color: var(--nexora-muted);
      font-size: 11px;
      font-weight: 800;
      cursor: pointer;
    }

    .language-switcher button.is-active {
      background: #fff;
      color: var(--nexora-brand);
      box-shadow: var(--nexora-card-shadow);
    }

    .notification-button {
      position: relative;
    }

    .notification-dot {
      position: absolute;
      top: 8px;
      right: 8px;
      width: 8px;
      height: 8px;
      border: 2px solid #fff;
      border-radius: 999px;
      background: #ef4444;
    }

    .profile-button {
      display: flex;
      align-items: center;
      gap: 10px;
      border: 1px solid var(--nexora-border);
      border-radius: 999px;
      background: #fff;
      padding: 5px 10px 5px 5px;
      box-shadow: var(--nexora-soft-shadow);
      cursor: pointer;
    }

    .profile-button .avatar {
      width: 32px;
      height: 32px;
      font-size: 11px;
    }

    .profile-copy {
      display: none;
      text-align: left;
    }

    .profile-copy strong {
      display: block;
      color: var(--nexora-text);
      font-size: 12px;
      line-height: 1.2;
    }

    .profile-copy span {
      color: var(--nexora-subtle);
      font-size: 11px;
    }

    /* mobile drawer backdrop */
    .nexora-shell-backdrop {
      position: fixed;
      inset: 0;
      z-index: 29;
      display: none;
      background: rgba(6, 12, 28, 0.55);
    }

    .nexora-shell-backdrop.is-open {
      display: block;
    }

    /* ── responsive ────────────────────────────────────────────────────────── */
    @media (min-width: 640px) {
      .header {
