        #nx-campaign-root .sms-preview { margin-top: 12px; border: 1px solid var(--nexora-border); border-radius: 10px; background: #f4f7fb; padding: 14px; }
        #nx-campaign-root .sms-preview-label { display:flex; align-items:center; gap:6px; margin-bottom: 8px; color: var(--nexora-subtle); font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
        #nx-campaign-root .sms-bubble { max-width: 85%; border-radius: 16px 16px 16px 4px; background: #fff; padding: 11px 14px; color: var(--nexora-text); font-size: 13px; line-height: 1.5; word-wrap: break-word; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08); }
        #nx-campaign-root .sms-bubble .lnk { color: var(--nx-electric); text-decoration: underline; }
        #nx-campaign-root .sms-preview-empty { color: var(--nexora-subtle); font-size: 12px; font-style: italic; }
        #nx-campaign-root .form-input,
        #nx-campaign-root .form-select,
        #nx-campaign-root .form-textarea {
          width: 100%;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: #fff;
          padding: 10px 14px;
          color: var(--nexora-text);
          font-family: inherit;
          font-size: 13px;
          outline: none;
          transition: border-color 0.15s;
        }
        #nx-campaign-root .form-input:focus,
        #nx-campaign-root .form-select:focus,
        #nx-campaign-root .form-textarea:focus { border-color: var(--nx-brand); }
        #nx-campaign-root .modal-footer {
