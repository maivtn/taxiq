            // Bookmarked Call Log URLs belong to the POS Customers & marketing screen.
            if (pair[0] === 'nav' && value === null && current.pathname.endsWith('/booking-book-phase-1.html') && current.searchParams.get('tab') === 'calllog') value = 'pos';
            return value === pair[1];
