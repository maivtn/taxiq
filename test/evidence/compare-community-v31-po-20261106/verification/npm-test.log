        #nx-campaign-root .cost-preview-buy-button:focus-visible { outline:3px solid rgba(220,38,38,.2); outline-offset:2px; }
        #nx-campaign-root .cost-preview-buy-button[hidden] { display:none; }
        #nx-campaign-root .btn-primary {
          display: inline-flex;
