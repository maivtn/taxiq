          display: grid;
          grid-template-columns: minmax(110px, 1.1fr) minmax(120px, 1.25fr) minmax(78px, 0.7fr) 168px;
          column-gap: 14px;
          align-items: center;
        }

        .settings-holiday-table-head {
          color: var(--nexora-subtle);
          font-size: 10px;
          font-weight: 850;
          letter-spacing: 0.02em;
          text-transform: uppercase;
