        #nx-campaign-root .sms-credit-package-note { display:block; margin-top:4px; color:var(--nexora-subtle); font-size:12px; font-weight:600; }
        #nx-campaign-root .sms-credit-package-check { position:absolute; right:11px; bottom:10px; display:grid; width:20px; height:20px; place-items:center; border:1px solid var(--nexora-border); border-radius:50%; background:#fff; color:transparent; font-size:12px; font-weight:900; opacity:.75; transition:background .18s ease, border-color .18s ease, color .18s ease, transform .18s ease; }
        #nx-campaign-root .sms-credit-package.is-selected .sms-credit-package-check { border-color:var(--nexora-brand); background:var(--nexora-brand); color:#fff; opacity:1; transform:scale(1.05); }
        #nx-campaign-root .sms-credit-payment-list { display:grid; gap:8px; }
        #nx-campaign-root .sms-credit-payment { display:flex; width:100%; align-items:center; justify-content:space-between; gap:12px; border:1px solid var(--nexora-border); border-radius:11px; background:#fff; padding:8px 11px; color:var(--nexora-text); text-align:left; cursor:pointer; transition:.18s ease; }
        #nx-campaign-root .sms-credit-payment:hover { border-color:rgba(70,72,216,.45); }
        #nx-campaign-root .sms-credit-payment.is-selected { border-color:var(--nexora-brand); background:rgba(70,72,216,.065); box-shadow:0 5px 12px rgba(70,72,216,.08); }
        #nx-campaign-root .sms-credit-payment-main { display:flex; min-width:0; align-items:center; gap:9px; }
        #nx-campaign-root .sms-credit-radio { display:grid; width:15px; height:15px; flex:0 0 15px; place-items:center; border:2px solid #cbd5e1; border-radius:50%; }
        #nx-campaign-root .sms-credit-payment.is-selected .sms-credit-radio { border-color:var(--nexora-brand); }
        #nx-campaign-root .sms-credit-payment.is-selected .sms-credit-radio::after { width:7px; height:7px; border-radius:50%; background:var(--nexora-brand); content:''; }
        #nx-campaign-root .sms-credit-token { display:block; width:28px; height:28px; flex:0 0 28px; border:1px solid rgba(15,23,42,.08); border-radius:50%; background:#fff; object-fit:contain; padding:1px; }
        #nx-campaign-root .sms-credit-payment-name { font-size:12px; font-weight:800; }
        #nx-campaign-root .sms-credit-payment-balance { flex:0 0 auto; color:var(--nexora-muted); text-align:right; }
        #nx-campaign-root .sms-credit-payment-balance span { display:block; color:var(--nexora-subtle); font-size:12px; font-weight:800; letter-spacing:.05em; text-transform:uppercase; }
        #nx-campaign-root .sms-credit-payment-balance strong { display:block; margin-top:2px; color:var(--nexora-text); font-size:12px; font-weight:900; }
        #nx-campaign-root .sms-credit-card-form { margin-top:12px; border:1px solid #f97316; border-radius:9px; background:#fff; padding:12px; }
        #nx-campaign-root .sms-credit-card-form[hidden] { display:none; }
        #nx-campaign-root .sms-credit-card-form-head { display:flex; align-items:center; gap:7px; color:var(--nexora-text); font-size:14px; font-weight:800; }
