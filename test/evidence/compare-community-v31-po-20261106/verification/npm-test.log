            if ((button.dataset.planSelect === 'Starter' || button.dataset.planSelect === 'Pro' || button.dataset.planSelect === 'Elite') && typeof window.openServicePlanPaymentModal === 'function') {
              window.openServicePlanPaymentModal(button.dataset.planSelect);
              return;
            }

            selectServicePlan(button.dataset.planSelect);
          });
        });

