        var CALL_STATUS_META = {
          answered:  { cls: 'booking-status-sms',    icon: 'bi-telephone-inbound', label: 'Answered' },
          missed:    { cls: 'booking-status-noshow', icon: 'bi-telephone-x',       label: 'Missed' },
          booked:    { cls: 'booking-status-done',   icon: 'bi-calendar-check',    label: 'Booked' }
        };

        var CALL_STATUS_CHIPS = [
          { id: 'all',       icon: '',                     label: 'All' },
          { id: 'missed',    icon: 'bi-telephone-x',       label: 'Missed' },
          { id: 'answered',  icon: 'bi-telephone-inbound', label: 'Answered' },
          { id: 'booked',    icon: 'bi-calendar-check',    label: 'Booked' }
        ];

        var callFilter = 'all';
        var callSearch = '';

        function formatCallDur(sec) {
          return String(Math.floor(sec / 60)).padStart(2, '0') + ':' + String(sec % 60).padStart(2, '0');
        }

        function renderCallStats() {
          var host = document.querySelector('[data-call-stats]');
          if (!host) return;

          var missed = CALLS.filter(function(c) { return c.status === 'missed'; }).length;
          var booked = CALLS.filter(function(c) { return c.status === 'booked'; }).length;
          var answeredRate = CALLS.length ? Math.round((CALLS.length - missed) / CALLS.length * 100) : 0;

          host.innerHTML =
            '<article class="overview-card kpi-card" style="--kpi-accent: var(--nexora-electric);">' +
              '<div class="kpi-top"><div class="kpi-icon"><i class="bi bi-telephone-inbound" aria-hidden="true"></i></div></div>' +
              '<div class="kpi-label">Calls</div><div class="kpi-value">' + CALLS.length + '</div></article>' +
            '<article class="overview-card kpi-card" style="--kpi-accent: #ef4444;">' +
              '<div class="kpi-top"><div class="kpi-icon"><i class="bi bi-telephone-x" aria-hidden="true"></i></div><span class="badge booking-status booking-status-noshow">Follow-up</span></div>' +
              '<div class="kpi-label">Missed calls</div><div class="kpi-value">' + missed + '</div>' +
              '</article>' +
            '<article class="overview-card kpi-card" style="--kpi-accent: var(--nexora-success);">' +
              '<div class="kpi-top"><div class="kpi-icon"><i class="bi bi-calendar-check" aria-hidden="true"></i></div><span class="badge booking-status booking-status-done">Booking</span></div>' +
              '<div class="kpi-label">Booked by phone</div><div class="kpi-value">' + booked + '</div>' +
              '</article>' +
            '<article class="overview-card kpi-card" style="--kpi-accent: var(--nexora-brand);">' +
              '<div class="kpi-top"><div class="kpi-icon"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></div></div>' +
              '<div class="kpi-label">Answer rate</div><div class="kpi-value">' + answeredRate + '%</div>' +
              '</article>';
        }

        function renderCallStatusChips() {
          var wrap = document.querySelector('[data-call-status-filter]');
          if (!wrap) return;

          var counts = { all: CALLS.length };
          ['missed', 'answered', 'booked'].forEach(function(id) {
            counts[id] = CALLS.filter(function(c) { return c.status === id; }).length;
          });

          wrap.innerHTML = CALL_STATUS_CHIPS.map(function(s) {
            var isActive = callFilter === s.id;
            var iconHtml = s.icon ? '<i class="bi ' + s.icon + '" aria-hidden="true"></i> ' : '';
            return '<button class="booking-status-chip' + (isActive ? ' is-active' : '') + '" type="button" data-call-status="' + s.id + '" aria-pressed="' + (isActive ? 'true' : 'false') + '">' +
              iconHtml + escapeHtml(s.label) + ' <span class="booking-status-chip-count">' + (counts[s.id] || 0) + '</span></button>';
          }).join('');
        }

        function renderCalls() {
          var tbody = document.querySelector('[data-call-tbody]');
          if (!tbody) return;

          var q = (callSearch || '').toLowerCase();
          var qDigits = q.replace(/\D/g, '');
          var rows = CALLS.filter(function(c) {
            var statusOk = callFilter === 'all' || c.status === callFilter;
            var searchOk = !q || c.name.toLowerCase().indexOf(q) !== -1 ||
              (qDigits && c.phone.replace(/\D/g, '').indexOf(qDigits) !== -1);
            return statusOk && searchOk;
          });

          var countEl = document.querySelector('[data-call-count]');
          if (countEl) countEl.textContent = rows.length + '/' + CALLS.length + ' calls';

          if (!rows.length) {
            tbody.innerHTML = '<tr><td colspan="7" class="booking-empty-cell">No calls found</td></tr>';
            renderCallStatusChips();
            return;
          }

          tbody.innerHTML = rows.map(function(c) {
            var meta = CALL_STATUS_META[c.status] || { cls: 'booking-status-new', icon: '', label: c.status };
            var metaIcon = meta.icon ? '<i class="bi ' + meta.icon + '" aria-hidden="true"></i> ' : '';
            var action = c.status === 'missed'
              ? '<button class="booking-mini-button primary" type="button" data-call-sms="' + CALLS.indexOf(c) + '" title="Follow-up SMS" aria-label="Follow-up SMS"><i class="bi bi-send" aria-hidden="true"></i><span class="booking-mini-label">Follow-up SMS</span></button>'
              : '';
            return '<tr class="booking-table-row">' +
              '<td>' + escapeHtml(c.time.split(' ')[0]) + '<small class="pos-call-time">' + escapeHtml(c.time.split(' ').slice(1).join(' ')) + '</small></td>' +
              '<td><div class="booking-customer-name">' + escapeHtml(c.name) + '</div></td>' +
              '<td>+1 ' + escapeHtml(c.phone) + '</td>' +
              '<td><span class="badge booking-status ' + meta.cls + '">' + metaIcon + escapeHtml(meta.label) + '</span></td>' +
              '<td>' + formatCallDur(c.dur) + '</td>' +
              '<td>' + escapeHtml(c.note) + '</td>' +
              '<td><div class="booking-actions">' + action + '</div></td>' +
            '</tr>';
          }).join('');

          renderCallStatusChips();
        }

        var custSearchInput = document.querySelector('[data-cust-search]');
        if (custSearchInput) {
          custSearchInput.addEventListener('input', function() {
            custFilter.search = custSearchInput.value;
            renderCustomers();
          });
        }

        var custSortInput = document.querySelector('[data-cust-sort]');
        if (custSortInput) custSortInput.addEventListener('change', function() {
          custFilter.sort = custSortInput.value;
          renderCustomers();
        });

        var custImportInput = document.querySelector('[data-cust-import-file]');
        var custImportButton = document.querySelector('[data-cust-import]');
        var customerExcelLoader;
        function loadCustomerExcel() {
          if (window.XLSX) return Promise.resolve(window.XLSX);
          if (!customerExcelLoader) {
            customerExcelLoader = new Promise(function(resolve, reject) {
              var script = document.createElement('script');
              script.src = 'https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js';
              script.onload = function() { resolve(window.XLSX); };
              script.onerror = function() { script.remove(); customerExcelLoader = null; reject(new Error('Excel import unavailable')); };
              document.head.appendChild(script);
            });
          }
          return customerExcelLoader;
        }
        if (custImportButton && custImportInput) {
          custImportButton.addEventListener('click', function() { custImportInput.click(); });
          custImportInput.addEventListener('change', async function() {
            var file = custImportInput.files[0];
            if (!file) return;
            var status = document.querySelector('[data-cust-import-status]');
            status.hidden = false;
            status.textContent = 'Importing...';
            custImportButton.disabled = true;
            try {
              var importer = window.NEXORA_CUSTOMER_IMPORT;
              var rows;
              if (/\.(xlsx|xls)$/i.test(file.name)) {
                var excel = await loadCustomerExcel();
                var workbook = excel.read(await file.arrayBuffer(), { type: 'array' });
                rows = workbook.SheetNames.length ? excel.utils.sheet_to_json(workbook.Sheets[workbook.SheetNames[0]], { defval: '', raw: false }) : [];
              } else if (/\.json$/i.test(file.name)) {
                rows = JSON.parse(await file.text());
                if (!Array.isArray(rows)) throw new Error('Could not import customer file');
              } else {
                rows = importer.parseDelimited(await file.text(), /\.tsv$/i.test(file.name) ? '\t' : null);
              }
              var result = importer.mergeCustomers(CUSTOMERS, rows.filter(function(row) { return row && typeof row === 'object' && !Array.isArray(row); }));
              custFilter.search = '';
              custFilter.seg = 'all';
              custFilter.sort = 'newest';
              custSearchInput.value = '';
              custSortInput.value = 'newest';
              renderCustomers();
              status.textContent = result.imported || result.updated
                ? 'Imported ' + result.imported + ' | Updated ' + result.updated + (result.skipped ? ' | Skipped ' + result.skipped : '')
                : 'No customers imported';
            } catch (error) {
              status.textContent = 'Could not import customer file';
            } finally {
              custImportInput.value = '';
              custImportButton.disabled = false;
            }
          });
        }

        var callSearchInput = document.querySelector('[data-call-search]');
        if (callSearchInput) {
          callSearchInput.addEventListener('input', function() {
            callSearch = callSearchInput.value;
            renderCalls();
          });
        }

        var promoTextarea = document.querySelector('[data-settings-promo]');
        if (promoTextarea) {
          promoTextarea.addEventListener('input', updatePromoCount);
          updatePromoCount();
        }

        var custEditIndex = -1;

        function custTypeOf(c) { return c.type || (c.seg === 'vip' ? 'VIP' : 'Individual'); }
        function custStatusOf(c) { return c.status || 'active'; }

        function setCustModalError(message) {
          var error = document.querySelector('[data-cust-modal-error]');
          if (!error) return;
          error.textContent = message || '';
          error.hidden = !message;
        }

        function setCustStatusToggle(on) {
          var btn = document.querySelector('[data-cf-status]');
          var lbl = document.querySelector('[data-cf-status-label]');
          if (btn) { btn.classList.toggle('is-on', on); btn.setAttribute('aria-checked', on ? 'true' : 'false'); }
          if (lbl) lbl.textContent = on ? 'Active' : 'Inactive';
        }

        function resetCustModalFields() {
          var modal = document.querySelector('[data-cust-modal]');
          if (!modal) return;
          modal.querySelector('[data-cf-name]').value = '';
          modal.querySelector('[data-cf-phone]').value = '';
          modal.querySelector('[data-cf-email]').value = '';
          modal.querySelector('[data-cf-address]').value = '';
          modal.querySelector('[data-cf-type]').value = 'Individual';
          if (custBirthdayPicker) custBirthdayPicker.clear();
          else modal.querySelector('[data-cf-birthday]').value = '';
          setCustStatusToggle(true);
          setCustModalError('');
        }

        function setCustModalMode(readOnly) {
          var modal = document.querySelector('[data-cust-modal]');
          modal.querySelectorAll('input').forEach(function(input) { input.readOnly = readOnly; });
          modal.querySelectorAll('select, [data-cf-status]').forEach(function(control) { control.disabled = readOnly; });
          modal.querySelector('[data-cust-save]').hidden = readOnly;
          modal.querySelector('.cust-modal-foot [data-cust-modal-close]').textContent = readOnly ? 'Close' : 'Cancel';
          if (custBirthdayPicker) custBirthdayPicker.set('clickOpens', !readOnly);
        }

        function openCustCreateModal() {
          var modal = document.querySelector('[data-cust-modal]');
          var title = document.querySelector('[data-cust-modal-title]');
          if (!modal) return;
          setCustModalMode(false);
          custEditIndex = -1;
          resetCustModalFields();
          if (title) title.textContent = 'Create customer';
          modal.hidden = false;
        }

        function openCustModal(index, readOnly) {
          var c = CUSTOMERS[index];
          var modal = document.querySelector('[data-cust-modal]');
          var title = document.querySelector('[data-cust-modal-title]');
          if (!c || !modal) return;
          setCustModalMode(!!readOnly);
          custEditIndex = index;
          modal.querySelector('[data-cf-name]').value = c.name || '';
          modal.querySelector('[data-cf-phone]').value = c.phone || '';
          modal.querySelector('[data-cf-email]').value = c.email || '';
          modal.querySelector('[data-cf-address]').value = c.address || '';
          if (custBirthdayPicker) {
            if (c.birthday) custBirthdayPicker.setDate(c.birthday, false);
            else custBirthdayPicker.clear();
          } else {
            modal.querySelector('[data-cf-birthday]').value = c.birthday || '';
          }
          modal.querySelector('[data-cf-type]').value = custTypeOf(c);
          setCustStatusToggle(custStatusOf(c) === 'active');
          setCustModalError('');
          if (title) title.textContent = readOnly ? 'Customer profile' : 'Update customer';
          modal.hidden = false;
        }

        function closeCustModal() {
          var modal = document.querySelector('[data-cust-modal]');
          if (modal) modal.hidden = true;
          custEditIndex = -1;
          setCustModalError('');
        }

        function saveCustModal() {
          var modal = document.querySelector('[data-cust-modal]');
          if (!modal) return;

          var name = (modal.querySelector('[data-cf-name]').value || '').trim();
          var phone = (modal.querySelector('[data-cf-phone]').value || '').trim();
          if (custEditIndex === -1 && (!name || !phone)) {
            setCustModalError('Name and phone are required.');
            return;
          }

          var email = (modal.querySelector('[data-cf-email]').value || '').trim();
          var address = (modal.querySelector('[data-cf-address]').value || '').trim();
          var birthday = modal.querySelector('[data-cf-birthday]').value || '';
          var type = modal.querySelector('[data-cf-type]').value;
          var status = modal.querySelector('[data-cf-status]').classList.contains('is-on') ? 'active' : 'inactive';
          var isCreating = custEditIndex === -1;
          var c = CUSTOMERS[custEditIndex];

          if (isCreating) {
            CUSTOMERS.push({
              name: name,
              phone: phone,
              email: email,
              address: address,
              birthday: birthday,
              type: type,
              status: status,
              seg: 'new',
              visits: 0,
              last: '—',
              src: 'manual'
            });
          } else {
            if (!c) { closeCustModal(); return; }
            c.name = name || c.name;
            c.phone = phone || c.phone;
            c.email = email;
            c.address = address;
            c.birthday = birthday;
            c.type = type;
            c.status = status;
          }

          var savedName = isCreating ? name : c.name;
          closeCustModal();
          renderCustomers();
          if (window.Swal) {
            Swal.fire({
              icon: 'success',
              title: isCreating ? 'Customer created' : 'Customer updated',
              text: savedName,
              timer: 1600,
              showConfirmButton: false
            });
          }
        }

        document.addEventListener('keydown', function(event) {
          if (event.key !== 'Escape') return;
          var modal = document.querySelector('[data-cust-modal]');
          if (modal && !modal.hidden) closeCustModal();
        });

        document.addEventListener('click', function(event) {
          var custCreateBtn = event.target.closest('[data-cust-create]');
          if (custCreateBtn) {
            openCustCreateModal();
            return;
          }

          var custEditBtn = event.target.closest('[data-cust-edit]');
          if (custEditBtn) {
            openCustModal(parseInt(custEditBtn.dataset.custEdit, 10));
            return;
          }

          var custViewBtn = event.target.closest('[data-cust-view]');
          if (custViewBtn) {
            openCustModal(parseInt(custViewBtn.dataset.custView, 10), true);
            return;
          }

          var custStatusBtn = event.target.closest('[data-cf-status]');
          if (custStatusBtn) {
            setCustStatusToggle(!custStatusBtn.classList.contains('is-on'));
            return;
          }

          var custSaveBtn = event.target.closest('[data-cust-save]');
          if (custSaveBtn) {
            saveCustModal();
            return;
          }

          if (event.target.closest('[data-cust-modal-close]') || event.target.matches('[data-cust-modal]')) {
            closeCustModal();
            return;
          }

          var segChip = event.target.closest('[data-cust-seg]');
          if (segChip) {
            custFilter.seg = segChip.dataset.custSeg;
            renderCustomers();
            return;
          }

          var callChip = event.target.closest('[data-call-status]');
          if (callChip) {
            callFilter = callChip.dataset.callStatus;
            renderCalls();
            return;
          }

          var callSmsBtn = event.target.closest('[data-call-sms]');
          if (callSmsBtn) {
            if (window.openSmsCampaignComposer) window.openSmsCampaignComposer({ segment: 'new' });
            return;
          }
