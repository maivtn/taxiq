          outline:3px solid rgba(245,158,11,.28);
          outline-offset:2px;
        }
        #nx-campaign-root .sms-credit-modal { position:fixed; inset:0; z-index:150; display:grid; place-items:center; padding:18px; background:rgba(8,31,73,.48); backdrop-filter:blur(8px); }
        #nx-campaign-root .sms-credit-modal[hidden] { display:none; }
        #nx-campaign-root .sms-credit-dialog { display:flex; width:min(100%,720px); max-height:min(90vh,760px); flex-direction:column; overflow:hidden; border:1px solid var(--nexora-border); border-radius:16px; background:#fff; box-shadow:0 28px 80px rgba(8,31,73,.28); }
        #nx-campaign-root .sms-credit-modal-head { display:flex; flex:0 0 auto; align-items:center; justify-content:space-between; gap:16px; border-bottom:1px solid var(--nexora-rule); background:linear-gradient(180deg,#fff,#f8fbff); padding:17px 20px; }
        #nx-campaign-root .sms-credit-modal-title { display:flex; align-items:center; gap:9px; color:var(--nexora-text); font-size:17px; font-weight:900; }
        #nx-campaign-root .sms-credit-modal-title .marketing-icon { color:var(--nexora-brand); }
        #nx-campaign-root .sms-credit-modal-sub { margin-top:4px; color:var(--nexora-muted); font-size:12px; font-weight:600; }
        #nx-campaign-root .sms-credit-close { display:grid; width:34px; height:34px; flex:0 0 34px; place-items:center; border:1px solid var(--nexora-border); border-radius:50%; background:#fff; color:var(--nexora-muted); cursor:pointer; transition:.18s ease; }
        #nx-campaign-root .sms-credit-close:hover { border-color:rgba(70,72,216,.35); background:var(--nexora-surface-muted); color:var(--nexora-text); }
        #nx-campaign-root .sms-credit-modal-body { overflow-y:auto; background:#f8fafc; padding:18px 20px 20px; }
        #nx-campaign-root .sms-credit-section + .sms-credit-section { margin-top:22px; }
        #nx-campaign-root .sms-credit-section-label { margin-bottom:10px; color:var(--nexora-subtle); font-size:12px; font-weight:900; letter-spacing:.08em; text-transform:uppercase; }
        #nx-campaign-root .sms-credit-package-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
        #nx-campaign-root .sms-credit-package { position:relative; min-width:0; border:1px solid var(--nexora-border); border-radius:12px; background:#fff; padding:13px; color:var(--nexora-text); text-align:left; cursor:pointer; transition:border-color .18s ease, box-shadow .18s ease, transform .18s ease; }
        #nx-campaign-root .sms-credit-package:hover { border-color:rgba(70,72,216,.45); transform:translateY(-1px); }
        #nx-campaign-root .sms-credit-package.is-selected { border-color:var(--nexora-brand); background:rgba(70,72,216,.055); box-shadow:0 8px 18px rgba(70,72,216,.12); }
        #nx-campaign-root .sms-credit-package.is-featured::after { position:absolute; top:9px; right:10px; border-radius:999px; background:var(--nexora-brand); padding:3px 6px; color:#fff; content:'Best value'; font-size:12px; font-weight:900; letter-spacing:.04em; text-transform:uppercase; }
        #nx-campaign-root .sms-credit-package-name { display:block; color:var(--nexora-muted); font-size:12px; font-weight:800; letter-spacing:.04em; text-transform:uppercase; }
        #nx-campaign-root .sms-credit-package-amount { display:block; margin-top:5px; color:var(--nexora-text); font-size:21px; font-weight:900; line-height:1.1; }
