            <!-- Customer profile modal (#pos-nail-salon-ops) -->
            <div class="sms-modal" data-cust-profile-modal role="dialog" aria-modal="true" aria-label="Customer profile">
              <div class="sms-dialog" style="max-width:640px">
                <div class="sms-mhead">
                  <h3><i class="bi bi-person-vcard" aria-hidden="true"></i> Customer profile</h3>
                  <button class="pos-icon-btn" type="button" data-cust-profile-close aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                </div>
                <div class="sms-mbody" data-cust-profile></div>
