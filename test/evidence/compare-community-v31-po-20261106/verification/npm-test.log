        /* customer edit modal */
        .cust-modal-overlay {
          position: fixed;
          inset: 0;
          z-index: 60;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 20px;
          background: rgba(8, 15, 34, 0.55);
        }

        .cust-modal-overlay[hidden] {
          display: none;
        }

        .cust-modal {
          width: min(560px, 100%);
          max-height: 90vh;
          overflow-y: auto;
          border-radius: 16px;
          background: var(--nexora-surface);
          box-shadow: 0 24px 60px rgba(8, 16, 34, 0.28);
        }

        .cust-modal-head {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 12px;
          padding: 18px 20px;
          border-bottom: 1px solid var(--nexora-border);
        }

        .cust-modal-head h3 {
          margin: 0;
          font-size: 16px;
          font-weight: 800;
          color: var(--nexora-text);
        }

        .cust-modal-close {
          display: inline-flex;
          width: 32px;
          height: 32px;
          flex-shrink: 0;
          align-items: center;
          justify-content: center;
          border: 1px solid var(--nexora-border);
          border-radius: 8px;
          background: #fff;
          color: var(--nexora-muted);
          transition: background 0.2s, color 0.2s;
        }

        .cust-modal-close:hover {
          background: var(--nexora-surface-muted);
          color: var(--nexora-text);
        }

        .cust-modal-body {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 14px;
          padding: 20px;
        }

        .cust-field {
          display: flex;
          flex-direction: column;
          gap: 6px;
        }

        .cust-field-full {
          grid-column: 1 / -1;
        }

        .cust-field > span,
        .cust-status-row > span {
          font-size: 11px;
          font-weight: 800;
          color: var(--nexora-muted);
          text-transform: uppercase;
          letter-spacing: 0.04em;
        }

        .cust-status-row {
          grid-column: 1 / -1;
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 12px;
          border: 1px solid var(--nexora-border);
          border-radius: 8px;
          padding: 12px 14px;
        }

        .cust-status-toggle {
          display: inline-flex;
          align-items: center;
          gap: 10px;
        }

        .cust-status-toggle span {
          font-size: 13px;
          font-weight: 700;
          color: var(--nexora-text);
        }

        .cust-modal-foot {
          display: flex;
          justify-content: flex-end;
          gap: 10px;
          padding: 16px 20px;
          border-top: 1px solid var(--nexora-border);
        }

        .cust-modal-foot .booking-mini-button {
          height: 38px;
          padding: 0 16px;
        }

        .cust-modal-error {
          grid-column: 1 / -1;
          margin: -4px 20px 16px;
          color: #b91c1c;
          font-size: 12px;
          font-weight: 700;
          line-height: 1.45;
        }

        .cust-inactive-tag {
          margin-left: 6px;
          color: var(--nexora-muted);
        }

        @media (max-width: 560px) {
          .cust-modal-body {
            grid-template-columns: 1fr;
          }
        }
        /* TEMP HIDE — call-log follow-up SMS buttons (booking actions stay available) */
        [data-call-sms],
        .sms-temp-hidden {
          display: none !important;
        }
        /* SweetAlert2 — match booking design system */
        .swal2-popup {
          font-family: Inter, system-ui, sans-serif !important;
          border-radius: 16px !important;
          box-shadow: 0 24px 60px rgba(8, 16, 34, 0.28) !important;
        }

        .swal2-title {
          font-size: 19px !important;
          font-weight: 800 !important;
          color: var(--nexora-text) !important;
        }

        .swal2-html-container {
          font-size: 14px !important;
          font-weight: 600 !important;
          color: var(--nexora-muted) !important;
        }

        .booking-save-summary {
          display: grid;
          gap: 8px;
          text-align: left;
        }

        .booking-save-summary-row {
          display: flex;
          align-items: baseline;
          justify-content: space-between;
          gap: 16px;
          border-bottom: 1px solid var(--nexora-rule);
          padding-bottom: 6px;
        }

        .booking-save-summary-row:last-child {
          border-bottom: 0;
          padding-bottom: 0;
        }

        .booking-save-summary-label {
          color: var(--nexora-subtle);
          font-size: 12px;
          font-weight: 700;
        }

        .booking-save-summary-value {
          color: var(--nexora-text);
          font-size: 12px;
          font-weight: 800;
          text-align: right;
        }

        .swal2-actions {
          gap: 10px !important;
        }

        .swal2-styled.swal2-confirm {
          border-radius: 10px !important;
          padding: 10px 20px !important;
          font-size: 14px !important;
          font-weight: 800 !important;
          background: var(--nexora-brand) !important;
          box-shadow: 0 12px 26px rgba(70, 72, 216, 0.26) !important;
        }

        .swal2-styled.swal2-cancel {
          border-radius: 10px !important;
          padding: 10px 20px !important;
          font-size: 14px !important;
          font-weight: 800 !important;
          background: var(--nexora-surface-muted) !important;
          color: var(--nexora-muted) !important;
        }

        .swal2-styled:focus {
          box-shadow: none !important;
        }

        .swal2-icon.swal2-success {
          border-color: var(--nexora-success) !important;
          color: var(--nexora-success) !important;
        }

        .swal2-icon.swal2-success [class^='swal2-success-line'] {
          background-color: var(--nexora-success) !important;
        }

        .swal2-icon.swal2-success .swal2-success-ring {
          border-color: rgba(0, 184, 115, 0.3) !important;
        }

        .swal2-timer-progress-bar {
          background: var(--nexora-success) !important;
        }

