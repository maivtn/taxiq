            var service = serviceModalId ? serviceById(serviceModalId) : null;
            var categoryPrefill = !serviceModalId && categoryName ? categoryName : '';
            var summaryService = service || (categoryPrefill ? { categoryName: categoryPrefill, active: true } : null);
            var isReadOnly = serviceModalMode === 'view';
            var titleEl = $('[data-mg-service-modal-title]');
