        }
        #nx-campaign-root .sms-credit-modal { position:fixed; inset:0; z-index:150; display:grid; place-items:center; padding:18px; background:rgba(8,31,73,.48); backdrop-filter:blur(8px); }
        #nx-campaign-root .sms-credit-modal[hidden] { display:none; }
