    <!doctype html>
    <html lang="en">
    <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>Nexora Touch - POS</title>
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">
      <style>
        :root {
          --luxury-gold: #d4af37;
          --brand-cyan: #32d7ff;
          --nexora-canvas: #f7f9fc;
          --nexora-surface: #ffffff;
          --nexora-surface-muted: #f3f6fa;
          --nexora-border: #dde5ef;
          --nexora-text: #0b1220;
          --nexora-muted: #4d5870;
          --nexora-subtle: #7a8296;
          --nexora-sidebar: #081f49;
          --nexora-brand: #4648d8;
          --nexora-electric: #2b59ff;
          --nexora-violet: #8e4df8;
          --nexora-card-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
          --nexora-soft-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
          /* Single dial for every Card/Table view mode's content text (names, service,
             tech, status, amounts) — retune here instead of hunting each card function. */
          --pos-card-content-fs: 15px;
        }

        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

        html, body {
          margin: 0;
          min-height: 100%;
          font-family: "Inter", sans-serif;
          font-size: 14px;
          background: var(--nexora-canvas);
          color: var(--nexora-text);
        }

        button, input, select, textarea { font: inherit; }
        button { cursor: pointer; }

        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: rgba(0, 0, 0, 0.05); }
        ::-webkit-scrollbar-thumb { background: var(--brand-cyan); border-radius: 99px; }

        .shell { min-height: 100vh; background: var(--nexora-canvas); }

        /* ── content ── */
        .content { min-height: calc(100vh - 64px); padding: 16px 16px 96px; }
        @media (min-width: 1366px) { .content { padding: 28px 28px 96px; } }

        .page-heading { margin-bottom: 20px; }
        .page-title-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .page-title { margin: 0; color: var(--nexora-text); font-size: 24px; font-weight: 800; line-height: 32px; }
        @media (min-width: 640px) { .page-title { font-size: 30px; line-height: 36px; } }
        .page-description { margin: 8px 0 0; color: var(--nexora-muted); font-size: 14px; font-weight: 500; line-height: 20px; }

        .page-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
        .page-tab {
          display: inline-flex; align-items: center; gap: 8px; min-height: 40px;
          border: 1px solid var(--nexora-border); border-radius: 10px; background: var(--nexora-surface);
          padding: 8px 14px; color: var(--nexora-muted); font-size: 13px; font-weight: 800;
          box-shadow: var(--nexora-card-shadow); transition: background .2s, border-color .2s, color .2s, transform .2s;
        }
        .page-tab:hover { color: var(--nexora-text); border-color: rgba(70, 72, 216, .35); transform: translateY(-1px); }
        .page-tab.is-active { border-color: transparent; background: linear-gradient(90deg, var(--nexora-electric), var(--nexora-violet)); color: #fff; box-shadow: 0 10px 22px rgba(43, 89, 255, .22); }
        .page-tab i { font-size: 15px; }

        .pos-panel { display: none; }
        .pos-panel.is-active { display: block; animation: posFade .2s ease; }
        .page-tab[hidden], .pos-panel[hidden] { display: none !important; }
        @keyframes posFade { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }

        /* ── layout helpers ── */
        .pos-grid { display: grid; gap: 14px; }
        .pos-g2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .pos-g4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
        /* stat grids stay 2-up all the way down to the smallest phone */
        @media (max-width: 1000px) { .pos-g4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        @media (max-width: 900px) { .pos-g2 { grid-template-columns: 1fr; } }
        .pos-split { display: grid; grid-template-columns: 2.4fr 1fr; gap: 14px; align-items: start; }
        @media (max-width: 1000px) { .pos-split { grid-template-columns: 1fr; } }
        .mg-split { display: grid; grid-template-columns: 1fr; gap: 14px; align-items: start; }
        @media (max-width: 1200px) { .mg-split { grid-template-columns: 1fr; } }
        /* grid children default to min-width:auto, which lets a wide table blow the column out */
        .pos-grid > *, .pos-split > *, .mg-split > *, .ap-grid > * { min-width: 0; }
        .pos-stack > * + * { margin-top: 14px; }

        .pos-card { background: var(--nexora-surface); border: 1px solid var(--nexora-border); border-radius: 16px; padding: 18px; box-shadow: var(--nexora-card-shadow); }
        .pos-card.soft { background: var(--nexora-surface-muted); box-shadow: none; }
        .pos-card-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
        .pos-card-head h3 { margin: 0; font-size: 16px; font-weight: 800; color: var(--nexora-text); }
        .frontdesk-kiosk-frame { display: block; width: 100%; min-height: min(760px, calc(100vh - 220px)); border: 0; border-radius: 12px; background: #fff; }
        @media (max-width: 900px) { .frontdesk-kiosk-frame { min-height: 820px; } }

        .pos-kpi-label { color: var(--nexora-muted); font-size: 12px; font-weight: 700; }
        .pos-kpi-value { font-size: 24px; font-weight: 900; color: var(--nexora-text); margin-top: 4px; }
        .pos-kpi-foot { margin-top: 6px; }

        .pos-chip { display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: 999px; font-size: 12px; font-weight: 800; }
        .pos-chip-green { background: #e7f8f0; color: var(--nexora-success); }
        .pos-chip-blue { background: #eaf0ff; color: var(--nexora-brand); }
        .pos-chip-amber { background: #fff4e2; color: var(--nexora-warning); }
        .pos-chip-red { background: #fdecec; color: var(--nexora-danger); }
        .pos-chip-gray { background: #eef1f6; color: var(--nexora-muted); }
        .pos-chip-gold { background: #fbf3dc; color: #9a7b17; }
        .pos-chip-violet { background: #f3ecff; color: var(--nexora-violet); }

        /* ── tables ── */
        .pos-table-wrap { overflow-x: auto; }
        .pos-table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .pos-table th { text-align: left; padding: 10px 12px; color: var(--nexora-subtle); font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; border-bottom: 1px solid var(--nexora-border); white-space: nowrap; }
        .pos-table td { padding: 12px; border-bottom: 1px solid var(--nexora-rule); color: var(--nexora-text); font-weight: 600; white-space: nowrap; vertical-align: middle; }
        .pos-table td.wrap { white-space: normal; min-width: 180px; }
        .pos-table tbody tr:last-child td { border-bottom: 0; }
        .pos-table tbody tr:hover { background: var(--nexora-surface-muted); }
        .pos-table.tight td, .pos-table.tight th { padding: 8px 10px; }
        .pos-strong { font-weight: 800; }
        .pos-danger-text { color: var(--nexora-danger); font-weight: 800; }
        .pos-warn-text { color: var(--nexora-warning); font-weight: 800; }
        .pos-good-text { color: var(--nexora-success); font-weight: 800; }

        /* ── buttons ── */
        .pos-btn { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--nexora-border); border-radius: 10px; background: #fff; padding: 9px 14px; font-size: 13px; font-weight: 800; color: var(--nexora-text); transition: border-color .2s, background .2s, color .2s, box-shadow .2s, transform .2s; }
        .pos-btn:hover { border-color: rgba(70, 72, 216, .4); transform: translateY(-1px); }
        .pos-btn[disabled] { opacity: .45; cursor: not-allowed; box-shadow: none; transform: none; }
        .pos-btn-primary { border-color: transparent; background: var(--nexora-brand); color: #fff; }
        .pos-btn-primary:hover { background: var(--nexora-brand-dark); }
        .pos-btn-success { border-color: transparent; background: var(--nexora-success); color: #fff; }
        .pos-btn-success:hover { background: #069764; border-color: transparent; }
        .pos-btn-danger { border-color: transparent; background: #fdecec; color: var(--nexora-danger); }
        .pos-btn-danger:hover { border-color: rgba(239, 68, 68, .32); background: #fee2e2; }
        .pos-btn-sm { padding: 6px 10px; font-size: 12px; border-radius: 8px; gap: 5px; }
        .pos-icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border: 1px solid var(--nexora-border); border-radius: 8px; background: #fff; color: var(--nexora-muted); }
        .pos-icon-btn:hover { color: var(--nexora-brand); border-color: var(--nexora-brand); }

        /* ── form ── */
        .pos-input { height: 40px; border: 1px solid var(--nexora-border); border-radius: 10px; padding: 0 12px; font-size: 13px; font-weight: 600; color: var(--nexora-text); background: #fff; }
        .pos-input:focus { outline: 0; border-color: var(--nexora-brand); box-shadow: 0 0 0 2px rgba(70, 72, 216, .16); }
        .pos-mini { height: 32px; width: 66px; border: 1px solid var(--nexora-border); border-radius: 8px; padding: 0 8px; font-size: 13px; font-weight: 700; color: var(--nexora-text); background: #fff; }
        .pos-mini:focus { outline: 0; border-color: var(--nexora-brand); box-shadow: 0 0 0 2px rgba(70, 72, 216, .16); }
        .pos-mini.text { width: 100%; min-width: 170px; font-weight: 600; }
        .pos-inline { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        .pos-inline-lbl { font-size: 12px; font-weight: 700; color: var(--nexora-muted); display: inline-flex; align-items: center; gap: 6px; }
        .pos-pay-icon { width: 16px; height: 16px; object-fit: contain; vertical-align: middle; flex: 0 0 16px; }

        /* ── key/value line ── */
        .pos-line { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 11px 0; border-bottom: 1px dashed var(--nexora-rule); }
        .pos-line:last-child { border-bottom: 0; }
        .pos-line .pos-line-key { color: var(--nexora-muted); font-size: 13px; font-weight: 600; }
        .pos-line .pos-line-val { font-weight: 800; }
        .pos-hint { color: var(--nexora-subtle); font-size: 12px; font-weight: 600; line-height: 1.6; margin-top: 8px; }

        .pos-meter { height: 8px; border-radius: 999px; background: var(--nexora-surface-muted); overflow: hidden; }
        .pos-meter > span { display: block; height: 100%; border-radius: 999px; background: linear-gradient(90deg, var(--nexora-electric), var(--nexora-violet)); }
        .pos-meter.warn > span { background: var(--nexora-warning); }
        .pos-meter.good > span { background: var(--nexora-success); }

        .pos-avatar { display: inline-flex; width: 32px; height: 32px; align-items: center; justify-content: center; border-radius: 999px; background: linear-gradient(135deg, var(--nexora-electric), var(--nexora-violet)); color: #fff; font-size: 12px; font-weight: 800; flex-shrink: 0; }
        .pos-avatar.plain { background: var(--nexora-surface-muted); color: var(--nexora-text); font-size: 15px; }
        .pos-people { display: inline-flex; align-items: center; gap: 10px; }
        .pos-section-title { margin: 22px 0 12px; font-size: 12px; font-weight: 800; color: var(--nexora-subtle); text-transform: uppercase; letter-spacing: .05em; }
        /* ── cycle / pill toggle cells ── */
        .cyc { display: inline-flex; align-items: center; justify-content: center; min-width: 38px; height: 30px; padding: 0 8px; border: 1px solid var(--nexora-border); border-radius: 8px; background: #fff; font-size: 12px; font-weight: 800; color: var(--nexora-subtle); }
        .cyc[data-on="1"] { border-color: var(--nexora-success); color: var(--nexora-success); background: #e7f8f0; }
        .cyc[data-on="2"] { border-color: var(--nexora-violet); color: var(--nexora-violet); background: #f3ecff; }
        .pill { border: 1px solid var(--nexora-border); border-radius: 999px; background: #fff; padding: 5px 11px; font-size: 11px; font-weight: 800; color: var(--nexora-subtle); }
        .pill.is-on { border-color: var(--nexora-violet); color: var(--nexora-violet); background: #f3ecff; }
        .pill-row { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
        .cust-note-levels { display: flex; flex-direction: column; gap: 4px; margin-top: 6px; min-width: 200px; }

        /* ── permission matrix ── */
        .perm-cell { display: inline-flex; align-items: center; justify-content: center; min-width: 78px; padding: 6px 8px; border-radius: 8px; font-size: 12px; font-weight: 800; border: 0; }
        .perm-cell[data-state="2"] { background: #e7f8f0; color: var(--nexora-success); }
        .perm-cell[data-state="1"] { background: #fff4e2; color: var(--nexora-warning); }
        .perm-cell[data-state="0"] { background: #eef1f6; color: var(--nexora-subtle); }
        .perm-cell[disabled] { opacity: .55; cursor: not-allowed; }

        /* ── revenue bars ── */
        .rev-bars { display: flex; align-items: flex-end; gap: 8px; height: 132px; padding-top: 8px; }
        .rev-bar { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 5px; font-size: 12px; font-weight: 800; color: var(--nexora-subtle); }
        .rev-bar .rv { font-size: 12px; color: var(--nexora-muted); }
        .rev-bar .bar { width: 100%; border-radius: 6px 6px 0 0; background: #dfe6f5; }
        .rev-bar.today .bar { background: linear-gradient(180deg, var(--nexora-electric), var(--nexora-violet)); }
        .rev-bar.today { color: var(--nexora-brand); }

        /* ── dispatch (floor) ── */
        .disp-stats { display: flex; flex-wrap: wrap; align-items: stretch; gap: 8px; }
        .disp-stat { position: relative; flex: 1 1 140px; min-width: 120px; overflow: hidden; background: var(--nexora-surface); border: 1px solid var(--nexora-border); border-radius: 12px; padding: 10px 11px; box-shadow: var(--nexora-card-shadow); text-align: center; transition: transform .18s, box-shadow .18s; }
        .disp-stat::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 3px; background: var(--accent, var(--nexora-brand)); opacity: .85; }
        .disp-stat:hover { transform: translateY(-2px); box-shadow: var(--nexora-soft-shadow); }
        .disp-num { font-size: 20px; font-weight: 900; color: var(--nexora-text); }
        .disp-lbl { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 12px; font-weight: 800; color: var(--nexora-muted); margin-top: 2px; }
        .disp-lbl i { font-size: 12px; line-height: 1; color: var(--accent, var(--nexora-brand)); }
        .disp-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 14px; align-items: start; }
        .disp-grid > * { min-width: 0; }

        .panel-violet { border-color: rgba(142, 77, 248, .45); }
        .panel-amber { border-color: rgba(245, 158, 11, .5); }
        .panel-blue { border-color: rgba(43, 89, 255, .4); }

        /* ── shared list-row card (Check-in ETA, App/QR check-in requests, tech access requests,
           check-in-modal results, customers table's card mode) — a flex row of info + actions that
           wraps on narrow screens. The Tickets queue overrides this to a full-width flex list. ── */
        .wl-card {
          display: flex; align-items: center; flex-wrap: wrap; gap: 10px;
          padding: 14px 16px; margin-bottom: 10px;
          border: 1px solid var(--nexora-border); border-radius: 14px; background: #fff;
          box-shadow: var(--nexora-card-shadow);
        }
        .wl-card:last-child { margin-bottom: 0; }

        /* ── queue-style card lists — Bootstrap-style flex row/col (not CSS grid): cards
           keep responsive columns; each card's child rows own the full left-aligned width. ── */
        [data-wait-list]:has(> .wl-card) { display: flex; flex-wrap: wrap; gap: 6px; }
        [data-wait-list] > .wl-card { flex: 0 0 calc(33.33% - 9px); max-width: calc(33.33% - 9px); min-width: 0; margin-bottom: 0; padding: 6px 10px; gap: 4px; }
        [data-wait-list] > .wl-card .perf-divider { margin: 2px 0; }
        [data-wait-list] > .booking-table-wrap { flex: 1 1 100%; max-width: 100%; width: 100%; }
        [data-ciq-list]:has(> .queue-card) { display: flex; flex-wrap: wrap; gap: 12px; }
        [data-ciq-list] > .queue-card { flex: 0 0 calc(33.33% - 9px); max-width: calc(33.33% - 9px); min-width: 0; margin-bottom: 0; }
        [data-ciq-list] > .booking-table-wrap { flex: 1 1 100%; max-width: 100%; width: 100%; }
        [data-arq-list]:has(> .queue-card) { display: flex; flex-wrap: wrap; gap: 12px; }
        [data-arq-list] > .queue-card { flex: 0 0 calc(33.33% - 9px); max-width: calc(33.33% - 9px); min-width: 0; margin-bottom: 0; }
        [data-arq-list] > .booking-table-wrap { flex: 1 1 100%; max-width: 100%; width: 100%; }
        [data-eta-list]:has(> .queue-card) { display: flex; flex-wrap: wrap; gap: 12px; }
        [data-eta-list] > .queue-card { flex: 0 0 calc(33.33% - 9px); max-width: calc(33.33% - 9px); min-width: 0; margin-bottom: 0; }
        [data-eta-list] > .booking-table-wrap { flex: 1 1 100%; max-width: 100%; width: 100%; }
        [data-tech-roster-table]:has(> .queue-card) { display: flex; flex-wrap: wrap; gap: 12px; }
        [data-tech-roster-table] > .queue-card { flex: 0 0 calc(50% - 6px); max-width: calc(50% - 6px); min-width: 0; margin-bottom: 0; }
        [data-tech-roster-table] > .tech-roster-table-wrap { flex: 1 1 100%; max-width: 100%; width: 100%; }
        /* ── management: tech-roster-style card lists (Techs & pay, Guarantee, Pay model, Smart
           Commission, Payout Center, Service→skill, Categories, Staff) — same flex row/col idiom ── */
        [data-mg-payroll-list], [data-mg-perf-list], [data-mg-owner-list], [data-mg-smart-list],
        [data-mg-payout-list], [data-mg-svcskill-list], [data-mg-category-list], [data-mg-staff-list] {
          display: flex; flex-wrap: wrap; gap: 12px;
        }
        [data-mg-payroll-list] > .queue-card, [data-mg-perf-list] > .queue-card, [data-mg-owner-list] > .queue-card,
        [data-mg-smart-list] > .queue-card, [data-mg-payout-list] > .queue-card, [data-mg-svcskill-list] > .queue-card,
        [data-mg-category-list] > .queue-card, [data-mg-staff-list] > .queue-card {
          flex: 0 0 calc(33.333% - 8px); max-width: calc(33.333% - 8px); min-width: 0; margin-bottom: 0;
        }
        [data-mg-perf-list] > .queue-card, [data-mg-owner-list] > .queue-card {
          flex-basis: calc(50% - 6px); max-width: calc(50% - 6px);
        }
        @media (max-width: 1199px) {
          [data-wait-list] > .wl-card { flex-basis: calc(50% - 8px); max-width: calc(50% - 8px); }
          [data-ciq-list] > .queue-card { flex-basis: calc(50% - 8px); max-width: calc(50% - 8px); }
          [data-arq-list] > .queue-card { flex-basis: calc(50% - 8px); max-width: calc(50% - 8px); }
          [data-eta-list] > .queue-card { flex-basis: calc(50% - 8px); max-width: calc(50% - 8px); }
          [data-mg-payroll-list] > .queue-card, [data-mg-smart-list] > .queue-card, [data-mg-payout-list] > .queue-card,
          [data-mg-svcskill-list] > .queue-card, [data-mg-category-list] > .queue-card, [data-mg-staff-list] > .queue-card {
            flex-basis: calc(50% - 6px); max-width: calc(50% - 6px);
          }
        }
        /* iPad and up (≥768px): every management card list keeps a 2-column floor —
           never collapses to a single column until phone widths. */
        @media (max-width: 900px) {
          [data-wait-list] > .wl-card { flex-basis: calc(50% - 6px); max-width: calc(50% - 6px); }
          [data-ciq-list] > .queue-card { flex-basis: calc(50% - 6px); max-width: calc(50% - 6px); }
          [data-arq-list] > .queue-card { flex-basis: calc(50% - 6px); max-width: calc(50% - 6px); }
          [data-eta-list] > .queue-card { flex-basis: calc(50% - 6px); max-width: calc(50% - 6px); }
        }
        @media (max-width: 600px) {
          [data-tech-roster-table] > .queue-card { flex-basis: 100%; max-width: 100%; }
          [data-mg-payroll-list] > .queue-card, [data-mg-perf-list] > .queue-card, [data-mg-owner-list] > .queue-card,
          [data-mg-smart-list] > .queue-card, [data-mg-payout-list] > .queue-card, [data-mg-svcskill-list] > .queue-card,
          [data-mg-category-list] > .queue-card, [data-mg-staff-list] > .queue-card {
            flex-basis: 100%; max-width: 100%;
          }
        }

        /* ── Guarantee & performance card: editorial layout — avatar+name+status head,
           a big current-sales figure with progress, then two 3-column stat rows and a
           suggested-upsell/rework row, each section separated by a full-width divider. ── */
        .perf-card { padding: 18px 20px; gap: 0; }
        .perf-head { display: flex; align-items: flex-start; gap: 14px; }
        .perf-avatar { width: 52px; height: 52px; flex-shrink: 0; border-radius: 50%; background: #efeafe; color: var(--nexora-brand); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 19px; }
        .perf-head-main { flex: 1; min-width: 0; }
        .perf-name-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .perf-name { font-size: var(--pos-card-content-fs); font-weight: 800; color: var(--nexora-text); }
        .perf-sub { margin-top: 4px; font-size: 12.5px; font-weight: 600; color: var(--nexora-muted); }
        .perf-divider { height: 1px; background: var(--nexora-rule); margin: 8px 0; flex-shrink: 0; }
        .perf-section-label { display: block; font-size: 11px; font-weight: 700; color: var(--nexora-muted); margin-bottom: 8px; }
        .perf-sales-row { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
        .perf-sales-value { font-size: var(--pos-card-content-fs); font-weight: 900; color: var(--nexora-text); }
        .perf-sales-of { font-size: var(--pos-card-content-fs); font-weight: 600; color: var(--nexora-muted); margin-left: 6px; }
        .perf-sales-pct { font-size: var(--pos-card-content-fs); font-weight: 900; color: var(--nexora-brand); }
        .perf-stat-row { display: flex; }
        .perf-stat-col { flex: 1; min-width: 0; padding: 0 14px; border-left: 1px solid var(--nexora-rule); }
        .perf-stat-col:first-child { padding-left: 0; border-left: 0; }
        .perf-stat-value { display: block; font-size: var(--pos-card-content-fs); font-weight: 800; color: var(--nexora-text); margin-top: 2px; }
        .perf-stat-sub { display: block; font-size: 11.5px; font-weight: 600; color: var(--nexora-muted); margin-top: 2px; }
        .mg-perf-week-input { height: 34px; min-width: 145px; padding: 0 8px; }
        .flatpickr-day.week.selected { border-color: rgba(70, 72, 216, .2); border-radius: 0; background: rgba(70, 72, 216, .14); color: var(--nexora-brand); box-shadow: none; }
        .flatpickr-day.week.selected:nth-child(7n + 1) { border-radius: 999px 0 0 999px; }
        .flatpickr-day.week.selected:nth-child(7n) { border-radius: 0 999px 999px 0; }

        /* ── Techs & pay card: avatar+name+shift-chips head with a pinned Deactivate button,
           a 2×2 grid of boxed metrics, then a centered two-column editable footer. ── */
        .payroll-card { padding: 18px 20px; gap: 0; }
        .mg-payroll-date-input { height: 34px; min-width: 150px; padding: 0 8px; }
        .payroll-avatar { width: 52px; height: 52px; flex-shrink: 0; border-radius: 50%; background: linear-gradient(135deg, var(--nexora-electric), var(--nexora-violet)); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 19px; }
        .payroll-metric-grid { display: flex; flex-wrap: wrap; gap: 10px; }
        .payroll-metric-box { flex: 1 1 calc(50% - 5px); min-width: 130px; border: 1px solid var(--nexora-border); border-radius: 12px; padding: 12px 14px; }
        .payroll-foot-row { display: flex; }
        .payroll-foot-col { flex: 1; min-width: 0; text-align: center; padding: 0 10px; border-left: 1px solid var(--nexora-rule); }
        .payroll-foot-col:first-child { border-left: 0; }
        .payroll-foot-input { width: 100%; text-align: center; border: none; background: transparent; font-size: var(--pos-card-content-fs); font-weight: 800; color: var(--nexora-text); margin-top: 2px; font-family: inherit; }
        .payroll-foot-input:focus { outline: none; background: var(--nexora-surface-muted); border-radius: 6px; }
        .pos-btn-danger-outline { border: 1.5px solid var(--nexora-danger); background: #fff; color: var(--nexora-danger); }
        .pos-btn-danger-outline:hover { background: #fdecec; }

        /* ── Pay model & real split card: name+status head, a "Pay model:" info bar, a
           bordered 2×3 metric grid with both row and column dividers, then a plain-text
           action narrative (one short sentence per line) below a final divider. ── */
        .owner-card { padding: 18px 20px; gap: 0; }
        .owner-model-bar { background: var(--nexora-surface-muted); border-radius: 10px; padding: 10px 14px; font-size: var(--pos-card-content-fs); color: var(--nexora-text); }
        .owner-model-bar select { border: 0; background: transparent; height: auto; padding: 0; font: inherit; font-weight: 700; color: var(--nexora-text); margin-left: 4px; }
        .owner-metric-grid { border: 1px solid var(--nexora-border); border-radius: 14px; overflow: hidden; }
        .owner-metric-row { display: flex; border-top: 1px solid var(--nexora-rule); }
        .owner-metric-row:first-child { border-top: 0; }
        .owner-metric-cell { flex: 1; min-width: 0; padding: 12px 16px; border-left: 1px solid var(--nexora-rule); }
        .owner-metric-cell:first-child { border-left: 0; }
        .owner-metric-cell input { border: none; background: transparent; font: inherit; font-weight: 800; font-size: var(--pos-card-content-fs); color: var(--nexora-text); width: 100%; margin-top: 2px; }
        .owner-metric-cell input:focus { outline: none; background: #fff; border-radius: 6px; }
        .owner-note-line { font-size: 13.5px; font-weight: 600; color: var(--nexora-text); margin-top: 6px; }
        .owner-note-line:first-child { margin-top: 0; }

        /* ── Smart Commission card: avatar+name+Base% head, a "Bonuses earned" section with
           a wrapping grid of green earned-bonus chips, then an Effective %/Δ weekly pay
           footer (reuses the Payroll card's centered-columns-with-divider pattern). ── */
        .smart-card { padding: 18px 20px; gap: 0; }
        .smart-bonus-grid { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
        .smart-bonus-chip { flex: 1 1 calc(50% - 5px); min-width: 150px; background: #e7f8f0; color: var(--nexora-success); border-radius: 12px; padding: 12px 14px; font-size: var(--pos-card-content-fs); font-weight: 800; }

        /* ── Staff accounts card: avatar+name+role head with PIN dots and a Reset PIN
           button pinned to the right, a divider, then an Access section — name/access text
           share --pos-card-content-fs with every other management card, and Reset PIN reuses
           the plain .pos-btn.pos-btn-sm so it matches the table view's button exactly. ── */
        .staff-card { padding: 16px 18px; gap: 0; }
        .staff-head { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
        .staff-avatar { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; flex-shrink: 0; border-radius: 999px; background: var(--nexora-surface-muted); color: var(--nexora-text); font-size: 17px; font-weight: 800; }
        .staff-name { font-size: var(--pos-card-content-fs); font-weight: 800; color: var(--nexora-text); }
        .staff-role-select { height: 32px; font-size: 13px; width: auto; min-width: 118px; }
        .staff-head-actions { display: flex; align-items: center; gap: 8px; margin-left: auto; flex-wrap: wrap; }
        .staff-pin-dots { font-size: 13px; font-weight: 700; color: var(--nexora-muted); letter-spacing: 2px; }
        .staff-access-value { font-size: var(--pos-card-content-fs); font-weight: 800; color: var(--nexora-text); margin-top: 2px; }

        /* ── shared big CTA button — Today's bookings/ETA and Tickets queue cards' primary
           actions: full-width (or half, in a .perf-cta-row) brand-outline by default, plus
           filled/muted/danger variants for the different ticket states. Kept compact (not
           full 44px touch-target padding) since these sit in dense card grids — still
           tall enough to tap reliably, just not wasting card real estate. ── */
        .perf-cta-btn { display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; padding: 9px 12px; border-radius: 10px; border: 1.5px solid var(--nexora-brand); background: #fff; color: var(--nexora-brand); font-size: 14px; font-weight: 800; }
        .perf-cta-btn:hover { background: #f1f2ff; }
        .perf-cta-btn:disabled { opacity: .5; cursor: not-allowed; }
        .perf-cta-btn-success { border-color: var(--nexora-success); color: var(--nexora-success); }
        .perf-cta-btn-success:hover { background: #e7f8f0; }
        .perf-cta-btn-primary { background: var(--nexora-brand); color: #fff; }
        .perf-cta-btn-primary:hover { background: #3739c0; }
        .perf-cta-btn-success-fill { border-color: var(--nexora-success); background: var(--nexora-success); color: #fff; }
        .perf-cta-btn-success-fill:hover { background: #00a366; }
        .perf-cta-btn-muted { border-color: var(--nexora-border); color: var(--nexora-muted); }
        .perf-cta-btn-muted:hover { background: var(--nexora-surface-muted); }
        .perf-cta-btn-danger { border-color: var(--nexora-danger); color: var(--nexora-danger); }
        .perf-cta-btn-danger:hover { background: #fdecec; }
        .perf-cta-row { display: flex; flex-wrap: wrap; gap: 8px; }
        .perf-cta-row .perf-cta-btn { width: auto; flex: 1 1 calc(50% - 5px); }

        /* ── single ticket card: a flex column of full-width rows (Bootstrap-style row/col via
           flexbox — no CSS grid) — head, then service + tech/time, an optional note, then actions ── */
        .queue-card {
          display: flex; flex-direction: column; gap: 10px; min-width: 0;
          padding: 12px; border: 1px solid var(--nexora-border); border-radius: 14px; background: #fff;
          box-shadow: var(--nexora-card-shadow);
        }
        .queue-card > :not(.queue-card-note) { width: 100%; min-width: 0; }
        .queue-card.tappable { cursor: pointer; transition: border-color .2s, box-shadow .2s, transform .15s; }
        .queue-card.tappable:hover { border-color: rgba(70, 72, 216, .4); transform: translateY(-1px); }
        .queue-card.is-sel { border-color: var(--nexora-brand); box-shadow: 0 0 0 3px rgba(70, 72, 216, .14); }
        .queue-card.late { border-color: rgba(239, 68, 68, .45); }
        .queue-card.appt { border-color: rgba(70, 72, 216, .35); }

        /* row 1 — identity and status/timer share one left-aligned flex row */
        .queue-card-head { display: flex; flex-direction: row; flex-wrap: wrap; align-items: flex-start; justify-content: flex-start; gap: 8px; min-width: 0; }
        .queue-card-identity { flex: 1 1 0; min-width: 0; }
        /* three separate rows in the identity block: name, then phone, then customer-group tags */
        .queue-card-phone { display: flex; align-items: center; gap: 5px; margin-top: 3px; font-size: 12px; font-weight: 600; color: var(--nexora-muted); }
        .queue-card-status { display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-start; gap: 4px; flex: 0 0 auto; max-width: 100%; flex-wrap: nowrap; white-space: nowrap; }
        .queue-card .queue-customer-group { display: flex; align-items: center; gap: 4px; margin-top: 4px; flex-wrap: wrap; }

        /* row 2 — service (a step below the guest name in the hierarchy) + tech/time meta */
        .queue-card-service { min-width: 0; }
        .queue-card-service strong { display: block; overflow-wrap: anywhere; font-size: var(--pos-card-content-fs); font-weight: 700; color: var(--nexora-text); }
        .queue-card-sub { display: block; margin-top: 2px; font-size: 12px; font-weight: 600; color: var(--nexora-muted); }
        .queue-card-tech-value { overflow-wrap: anywhere; font-size: var(--pos-card-content-fs); font-weight: 700; color: var(--nexora-text); }
        .queue-card-tech-value.is-requested, .queue-card-tech-value.is-anyone, .queue-table-tech.is-anyone { color: var(--nexora-warning); }
        .queue-card-meta { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 8px; width: 100%; margin-top: 6px; flex-wrap: wrap; }
        .queue-card-tech, .queue-card-booking { display: inline-flex; align-items: center; gap: 4px; max-width: 100%; min-width: 0; overflow-wrap: anywhere; font-size: 12px; font-weight: 600; color: var(--nexora-muted); }
        .queue-card-tech i, .queue-card-booking i { font-size: 11px; }

        /* row 3 — note, set apart as a muted annotation chip instead of plain text */
        .queue-card-note { align-self: flex-start; width: fit-content; max-width: 100%; overflow-wrap: anywhere; display: flex; align-items: center; gap: 5px; padding: 5px 9px; border-radius: 8px; background: var(--nexora-surface-muted); font-size: 12px; font-weight: 600; color: var(--nexora-muted); }
        .queue-card-note span { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

        /* row 4 — actions, always full-width with no divider — no special-casing by button count */
        .queue-card-actions { display: flex; align-items: center; justify-content: flex-start; gap: 5px; width: 100%; flex-wrap: wrap; padding-top: 8px; }
        .queue-card-actions .pos-btn { flex: 0 0 auto; width: auto; }
        .queue-card-actions .x-btn { width: auto; min-width: 30px; }
        .queue-action-primary { box-shadow: 0 6px 14px rgba(70, 72, 216, .18); }
        .queue-action-primary:hover { box-shadow: 0 8px 18px rgba(70, 72, 216, .22); }
        .queue-action-approve, .queue-action-pay { box-shadow: 0 6px 14px rgba(0, 184, 115, .16); }
        .queue-action-approve:hover, .queue-action-pay:hover { box-shadow: 0 8px 18px rgba(0, 184, 115, .2); }
        .queue-action-progress { border-color: rgba(70, 72, 216, .22); background: #f1f2ff; color: var(--nexora-brand); }
        .queue-action-progress:hover { border-color: rgba(70, 72, 216, .42); background: #e9ebff; }
        .queue-action-arrived { border-color: rgba(43, 89, 255, .22); background: #eef4ff; color: #2451d6; }
        .queue-action-arrived:hover { border-color: rgba(43, 89, 255, .42); background: #e5edff; color: var(--nexora-electric); }
        .queue-action-muted { border-color: var(--nexora-border); background: var(--nexora-surface-muted); color: var(--nexora-muted); }

        /* Tech access request card — stacked labeled rows (TECH/TICKET/CURRENTLY/SKILL),
           each set apart by a full-width divider, so the tech being asked for is the
           first thing front desk reads. */
        .arq-card-row { border-top: 1px solid var(--nexora-rule); padding-top: 8px; }
        .arq-card-row:first-child { border-top: 0; padding-top: 0; }
        .arq-card-label { color: var(--nexora-subtle); font-size: 11px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; margin-bottom: 4px; }
        .arq-card-value { font-size: var(--pos-card-content-fs); font-weight: 800; color: var(--nexora-text); overflow-wrap: anywhere; }
        .arq-card-value-xl { font-size: var(--pos-card-content-fs); line-height: 1.3; }
        .arq-card-value-plain { font-weight: 600; }
        .queue-action-muted:hover { border-color: rgba(70, 72, 216, .32); background: #f8faff; color: var(--nexora-brand); }
        .queue-action-danger { border-color: rgba(239, 68, 68, .22); background: #fff5f5; color: var(--nexora-danger); }
        .queue-action-danger:hover { border-color: rgba(239, 68, 68, .42); background: #fee2e2; color: #dc2626; }

        .wl-wait { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 700; color: var(--nexora-muted); white-space: nowrap; }
        .wl-wait i { font-size: 12px; }
        .wl-wait.bad { color: var(--nexora-danger); }

        .wl-info { flex: 1; min-width: 190px; }
        .wl-name { font-size: var(--pos-card-content-fs); font-weight: 800; color: var(--nexora-text); display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
        .wl-meta { font-size: 12px; color: var(--nexora-muted); margin-top: 3px; font-weight: 600; }
        .wl-actions { display: inline-flex; gap: 6px; align-items: center; flex-shrink: 0; }
        .wl-empty { color: var(--nexora-subtle); font-size: 13px; padding: 18px 0; text-align: center; }
        /* Grouped order card — one guest/order with several service tickets (#pos-nail-salon-ops Phase 3) */
        .wl-group { flex-direction: column; align-items: stretch; }
        .wl-group-tickets { display: flex; flex-direction: column; gap: 6px; width: 100%; margin-top: 6px; }
        .wl-ticket-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 7px 10px; border: 1px solid var(--nexora-border); border-radius: 9px; background: var(--nexora-panel, #f8f9fc); flex-wrap: wrap; }
        .wl-ticket-row.is-sel { border-color: var(--nexora-brand); box-shadow: 0 0 0 3px rgba(70, 72, 216, .14); }
        .wl-ticket-svc { font-size: 13px; font-weight: 700; color: var(--nexora-text); }
        .wl-ticket-actions { display: inline-flex; gap: 6px; align-items: center; flex-shrink: 0; }
        .wl-group-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; margin-top: 10px; padding-top: 10px; border-top: 1px dashed var(--nexora-border); }
        .wl-group-total { font-size: 13px; font-weight: 800; color: var(--nexora-muted); }
        .x-btn { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border: 1px solid var(--nexora-border); border-radius: 8px; background: #fff; color: var(--nexora-subtle); font-size: 13px; transition: border-color .18s, background .18s, color .18s, box-shadow .18s, transform .18s; }
        .x-btn:hover { color: var(--nexora-danger); border-color: var(--nexora-danger); transform: translateY(-1px); }
        .x-btn.queue-action-danger-icon { border-color: rgba(239, 68, 68, .18); background: #fff7f7; color: var(--nexora-danger); }
        .x-btn.queue-action-danger-icon:hover { border-color: rgba(239, 68, 68, .48); background: #fee2e2; color: #dc2626; box-shadow: 0 6px 14px rgba(239, 68, 68, .12); }

        .cust-usual { font-size: 12px; font-weight: 600; color: var(--nexora-electric); margin-top: 3px; line-height: 1.6; }
        .cust-pkg { font-size: 12px; font-weight: 700; color: var(--nexora-violet); margin-top: 3px; }
        .cust-tags { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 4px; }
        .cust-tag { font-size: 12px; font-weight: 700; padding: 2px 7px; border-radius: 8px; background: #f3ecff; color: var(--nexora-violet); border: 1px solid rgba(142, 77, 248, .3); }
        .cust-note { font-size: 12px; font-weight: 600; color: var(--nexora-warning); margin-top: 3px; }
        .cust-section-title { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .03em; color: var(--nexora-subtle); margin-bottom: 6px; }
        /* Customer profile modal layout (#pos-nail-salon-ops) */
        .cust-profile-head { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 14px; }
        .cust-profile-avatar { width: 52px; height: 52px; flex-shrink: 0; border-radius: 50%; background: linear-gradient(135deg, var(--nexora-electric), var(--nexora-violet)); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 17px; }
        .cust-profile-name { font-size: 19px; font-weight: 800; color: var(--nexora-text); display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        .cust-profile-contact { display: flex; gap: 18px; flex-wrap: wrap; margin-top: 6px; font-size: 13px; color: var(--nexora-muted); font-weight: 600; }
        .cust-profile-contact i { color: var(--nexora-brand); margin-right: 6px; }
        .cust-profile-stats { display: flex; border: 1px solid var(--nexora-border); border-radius: 14px; margin-bottom: 14px; overflow: hidden; }
        .cust-profile-stat { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px; padding: 9px 6px; text-align: center; border-right: 1px solid var(--nexora-border); }
        .cust-profile-stat:last-child { border-right: 0; }
        .cust-profile-stat-value { font-size: 15px; font-weight: 900; color: var(--nexora-brand); }
        .cust-profile-stat-value.is-text { font-size: 13px; font-weight: 800; }
        .cust-profile-stat-label { font-size: 11px; font-weight: 600; color: var(--nexora-muted); }
        .cust-upcoming-card { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; background: var(--nexora-surface-muted); border: 1px solid var(--nexora-border); border-radius: 14px; padding: 14px 16px; margin-bottom: 14px; }
        .cust-upcoming-icon { width: 40px; height: 40px; flex-shrink: 0; border-radius: 50%; background: #efeafe; color: var(--nexora-brand); display: flex; align-items: center; justify-content: center; font-size: 17px; }
        .cust-upcoming-text { flex: 1; min-width: 0; }
        .cust-upcoming-title { font-weight: 800; color: var(--nexora-brand); font-size: 14px; }
        .cust-upcoming-meta { font-size: 13px; color: var(--nexora-text); font-weight: 600; margin-top: 2px; }
        .cust-upcoming-detail { font-size: 12px; color: var(--nexora-muted); font-weight: 600; margin-top: 4px; }
        .cust-upcoming-actions { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 6px; flex-shrink: 0; margin-left: auto; }
        .cust-upcoming-more { font-size: 12px; color: var(--nexora-muted); font-weight: 700; white-space: nowrap; }
        .cust-upcoming-chevron { color: var(--nexora-subtle); }
        .cust-upcoming-collapse { flex: 1 0 100%; min-width: 0; border-top: 1px solid var(--nexora-border); padding-top: 12px; }
        .cust-upcoming-collapse[hidden] { display: none; }
        .cust-upcoming-detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 12px; }
        .cust-upcoming-detail-item { min-width: 0; }
        .cust-upcoming-detail-label { color: var(--nexora-muted); font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; }
        .cust-upcoming-detail-value { margin-top: 3px; color: var(--nexora-text); font-size: 13px; font-weight: 700; overflow-wrap: anywhere; }
        .cust-upcoming-detail-services { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 4px; }
        .cust-upcoming-detail-note { margin-top: 10px; padding-top: 9px; border-top: 1px solid var(--nexora-border); color: var(--nexora-muted); font-size: 12px; line-height: 1.5; }
        .cust-upcoming-detail-actions { display: flex; justify-content: flex-end; margin-top: 10px; }
        @media (max-width: 600px) { .cust-upcoming-detail-grid { grid-template-columns: 1fr; } }
        .cust-insights-card, .cust-prefs-card { border: 1px solid var(--nexora-border); border-radius: 14px; padding: 14px 16px; margin-bottom: 14px; }
        .cust-insights-row { display: flex; gap: 16px; padding-bottom: 12px; margin-bottom: 12px; border-bottom: 1px solid var(--nexora-border); }
        .cust-insights-row-last { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }
        .cust-insight-item { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10px; }
        .cust-insight-icon { width: 34px; height: 34px; flex-shrink: 0; border-radius: 9px; background: #efeafe; color: var(--nexora-brand); display: flex; align-items: center; justify-content: center; }
        .cust-insight-label { font-size: 12px; color: var(--nexora-muted); font-weight: 600; }
        .cust-insight-value { font-size: 14px; font-weight: 800; color: var(--nexora-text); }
        .cust-insight-value select.pos-input { border: 0; background: none; padding: 0; height: auto; font-size: 14px; font-weight: 800; color: var(--nexora-text); }
        /* Customer chip family (regular-tech / frequent-tech / preference tags) synced to one
           readable size — was a scatter of 10-11px chips that read too small against 12px meta text. */
        .cust-pref-tag { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 999px; border: 1px solid var(--nexora-border); font-size: 12px; font-weight: 400; background: #fff; color: var(--nexora-muted); }
        .cust-pref-tag.is-on { background: #eaf0ff; border-color: rgba(43, 89, 255, .35); color: var(--nexora-brand); }
        .cust-tech-chip-row { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 5px; }
        .cust-pref-tech-list { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; }
        .cust-pref-tech-chip { display: inline-flex; align-items: center; gap: 4px; padding: 5px 8px; border-radius: 999px; border: 1px solid var(--nexora-border); font-size: 12px; font-weight: 400; background: #fff; color: var(--nexora-muted); cursor: default; }
        .cust-pref-tech-chip.is-on { background: #f3ecff; border-color: rgba(142, 77, 248, .35); color: var(--nexora-violet); }
        .cust-tag-chip-row { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 5px; }
        .cust-tag-chip { display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; border-radius: 999px; border: 1px solid var(--nexora-border); font-size: 12px; font-weight: 400; background: #fff; color: var(--nexora-muted); }
        .cust-tag-chip.is-on { background: #f3ecff; border-color: rgba(142, 77, 248, .35); color: var(--nexora-violet); }
        /* Customers table (7-col) sub-lines, and the Card-mode flat layout it collapses to on narrow widths. */
        .cust-table-sub { font-size: 12px; color: var(--nexora-muted); font-weight: 600; margin-top: 2px; }
        /* Card mode is a 3-up contact-card grid (Bootstrap-style flex row/col, not CSS grid) — kept
           visually distinct from the check-in/queue ticket rows (.wl-card used as a full-width list). */
        [data-cust-results]:has(> .cust-card) { display: flex; flex-wrap: wrap; gap: 12px; }
        [data-cust-results] > .cust-card { flex: 0 0 calc(33.333% - 8px); max-width: calc(33.333% - 8px); min-width: 0; margin-bottom: 0; }
        @media (max-width: 1099px) { [data-cust-results] > .cust-card { flex-basis: calc(50% - 6px); max-width: calc(50% - 6px); } }
        @media (max-width: 640px) { [data-cust-results] > .cust-card { flex-basis: 100%; max-width: 100%; } }
        .cust-card { flex-direction: column; align-items: stretch; gap: 2px; }
        .cust-card-head { display: flex; align-items: center; gap: 8px; flex-wrap: nowrap; }
        .cust-card-name { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; background: none; border: 0; padding: 0; cursor: pointer; text-align: left; font: inherit; font-size: var(--pos-card-content-fs); font-weight: 800; color: var(--nexora-text); }
        .cust-card-badges { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
        .cust-card-meta { font-size: 12px; color: var(--nexora-muted); font-weight: 600; margin-top: 3px; }
        /* Compact history tables (Visit history / Payment history) — full width, columns auto-size to
           their content instead of the wide booking-table's fixed min-width. */
        .cust-history-table-wrap { overflow-x: auto; border: 1px solid var(--nexora-border); border-radius: 10px; margin-top: 2px; }
        .cust-history-table { width: 100%; border-collapse: collapse; font-size: 13px; table-layout: auto; }
        .cust-history-table th { padding: 8px 10px; background: var(--nexora-surface-muted); color: var(--nexora-muted); text-align: left; font-size: 11px; font-weight: 800; letter-spacing: .03em; text-transform: uppercase; white-space: nowrap; width: 1%; }
        .cust-history-table th:last-child, .cust-history-table td:last-child { width: auto; }
        .cust-history-table td { padding: 8px 10px; border-top: 1px solid var(--nexora-border); color: var(--nexora-text); font-weight: 600; white-space: nowrap; }
        @media (max-width: 640px) { .cust-insights-row { flex-direction: column; gap: 12px; } }

        .tech-row.pickable { border-color: var(--nexora-brand); background: #f2f3ff; cursor: pointer; }
        .tech-row.dim { opacity: .5; }
        .tech-busy { background: var(--nexora-warning); }
        .next-chip { font-size: 12px; font-weight: 800; color: var(--nexora-success); background: #e7f8f0; border-radius: 6px; padding: 2px 7px; white-space: nowrap; }
        .pick-arrow { font-size: 12px; font-weight: 800; color: var(--nexora-brand); white-space: nowrap; }
        .match-badge { font-size: 12px; font-weight: 800; margin-left: auto; white-space: nowrap; }
        .sel-hint { font-size: 12px; font-weight: 700; color: var(--nexora-brand); background: #f2f3ff; border: 1px dashed rgba(70, 72, 216, .4); border-radius: 8px; padding: 8px 10px; margin-bottom: 10px; }
        .warn-row { font-size: 13px; font-weight: 600; color: #9a6608; background: #fff9ee; border: 1px solid rgba(245, 158, 11, .4); border-radius: 8px; padding: 7px 10px; margin: -4px 0 8px; line-height: 1.6; }
        .live-map { height: 44px; border-radius: 10px; background: linear-gradient(135deg, #dce9ff, #edf1ff); display: flex; align-items: center; justify-content: center; color: #6f7d96; font-size: 12px; font-weight: 700; margin-top: 6px; flex-basis: 100%; }

        /* ── time clock ── */
        .clk-qr-card { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; }
        .clk-qr img { width: 156px; height: 156px; display: block; border: 1px solid var(--nexora-border); border-radius: 14px; padding: 6px; background: #fff; }
        .clk-token { font-size: 13px; font-weight: 800; color: var(--nexora-violet); letter-spacing: .04em; }
        .clk-countdown { max-width: 300px; margin: 10px 0 6px; }
        .clk-countdown > span { transition: width 1s linear; }
        .tech-roster-table-wrap { overflow-x: auto; border: 1px solid var(--nexora-border); border-radius: 12px; background: #fff; }
        .tech-roster-table { width: 100%; min-width: 860px; border-collapse: collapse; font-size: 13px; }
        .tech-roster-table th { padding: 9px 10px; background: var(--nexora-surface-muted); color: var(--nexora-muted); text-align: left; font-size: 11px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; }
        .tech-roster-table td { padding: 9px 10px; border-top: 1px solid var(--nexora-rule); color: var(--nexora-text); vertical-align: middle; }
        .tech-roster-table tbody tr:hover { background: #fbfcff; }
        .tech-roster-person { display: flex; align-items: center; gap: 8px; min-width: 150px; }
        .tech-roster-person-name { font-weight: 800; white-space: nowrap; }
        .tech-roster-person-role { margin-top: 2px; color: var(--nexora-subtle); font-size: 12px; font-weight: 600; }
        .tech-roster-shift, .tech-roster-ticket, .tech-roster-turns { white-space: nowrap; }
        .tech-roster-ticket { font-weight: 700; }
        .tech-roster-ticket.is-free { color: var(--nexora-success); }
        .tech-roster-ticket.is-busy { color: var(--nexora-warning); }
        .tech-roster-actions { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; min-width: 176px; }
        .tech-row { display: flex; align-items: center; gap: 10px; border: 1px solid var(--nexora-border); border-radius: 12px; padding: 10px 12px; margin-bottom: 8px; background: #fff; flex-wrap: nowrap; }
        @media (max-width: 780px) { .tech-row { flex-wrap: wrap; } }
        .tech-dot { width: 9px; height: 9px; border-radius: 999px; flex-shrink: 0; }
        .tech-free { background: var(--nexora-success); }
        .tech-off { background: var(--nexora-border); }
        .tech-name { font-weight: 800; font-size: 13px; color: var(--nexora-text); }
        .tech-sub { margin-left: auto; font-size: 12px; color: var(--nexora-muted); white-space: nowrap; }
        .clk-station { width: 46px; height: 32px; border: 1px solid var(--nexora-border); border-radius: 8px; font-size: 12px; font-weight: 700; }
        .feed-line { font-size: 13px; font-weight: 600; color: var(--nexora-muted); padding: 8px 0; border-bottom: 1px solid var(--nexora-rule); line-height: 1.6; }
        .feed-line:last-child { border-bottom: 0; }

        /* ── sms campaigns ── */
        .sms-banner { display: none; align-items: center; gap: 10px; border: 1px solid rgba(0, 184, 115, .35); background: #e7f8f0; border-radius: 12px; padding: 12px 14px; margin-bottom: 14px; font-size: 13px; font-weight: 700; color: #04794f; }
        .sms-banner.show { display: flex; animation: posFade .2s ease; }
        .camp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(238px, 1fr)); gap: 12px; }
        .camp-card { border: 1px solid var(--nexora-border); border-left: 3px solid var(--accent, var(--nexora-brand)); border-radius: 14px; background: #fff; padding: 16px; text-align: left; box-shadow: var(--nexora-card-shadow); transition: transform .15s, box-shadow .15s, border-color .15s; }
        .camp-card:hover { transform: translateY(-2px); box-shadow: var(--nexora-soft-shadow); }
        .camp-icon { font-size: 22px; }
        .camp-name { margin-top: 8px; font-size: 14px; font-weight: 800; color: var(--nexora-text); }
        .camp-desc { margin-top: 5px; font-size: 12px; font-weight: 500; color: var(--nexora-muted); line-height: 1.6; min-height: 38px; }
        .camp-meta { display: flex; align-items: flex-end; justify-content: space-between; gap: 8px; margin-top: 12px; padding-top: 12px; border-top: 1px dashed var(--nexora-rule); }
        .camp-count { font-size: 22px; font-weight: 900; color: var(--nexora-text); line-height: 1; }
        .camp-count-lbl { font-size: 12px; font-weight: 700; color: var(--nexora-subtle); margin-top: 3px; }

        .sms-modal { display: none; position: fixed; inset: 0; z-index: 60; background: rgba(8, 16, 34, .5); padding: 24px 16px; overflow-y: auto; }
        .sms-modal.open { display: block; }
        .sms-dialog { max-width: 760px; margin: 0 auto; background: var(--nexora-surface); border-radius: 18px; box-shadow: 0 24px 64px rgba(8, 16, 34, .3); overflow: hidden; }
        .sms-mhead { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 16px 20px; border-bottom: 1px solid var(--nexora-border); }
        .sms-mhead h3 { margin: 0; font-size: 16px; font-weight: 800; }
        .sms-mbody { padding: 20px; }
        .sms-mfoot { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 14px 20px; border-top: 1px solid var(--nexora-border); background: var(--nexora-surface-muted); }

        .ap-chips { display: flex; flex-wrap: wrap; gap: 8px; }
