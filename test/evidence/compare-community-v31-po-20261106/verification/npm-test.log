                        <div class="sms-preview-lbl"><i class="bi bi-phone" aria-hidden="true"></i> Preview trên điện thoại khách</div>
                        <div class="sms-bubble" data-sms-bubble><span class="sms-bubble-empty">Tin nhắn sẽ hiển thị ở đây...</span></div>
                      </div>
