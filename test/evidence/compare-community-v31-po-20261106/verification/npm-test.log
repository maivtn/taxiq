                  '<td>' + x.eff + '</td>' +
                  '<td>' + x.deltaHtml + '</td>' +
                  '</tr>';
              }).join('') +
              '</tbody></table></div>';
            var cardsHtml = '<div data-mg-smart-list>' + TECHS.map(function (t) {
