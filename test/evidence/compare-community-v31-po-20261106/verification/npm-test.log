            if (packageTarget) packageTarget.textContent = selectedPackage.credits.toLocaleString() + ' phút';
            if (paymentTarget) paymentTarget.textContent = selectedPayment.label;
            if (totalTarget) totalTarget.textContent = marketingMoney(selectedPackage.price, { cents: true });
            if (statusTarget) statusTarget.textContent = selectedPackage.credits.toLocaleString() + ' phút Voice, thanh toán bằng ' + selectedPayment.label + '.';
