            </section>

            <!-- ══════════ 🗂️ CUSTOMERS — LOOKUP ══════════ -->
            <section class="pos-panel" data-pos-panel="customers" aria-label="Customers">
              <div class="pos-stack">
                <div class="pos-card">
                  <div class="pos-card-head">
                    <h3><i class="bi bi-people" aria-hidden="true"></i> Customers <span class="pos-muted" data-cust-count></span></h3>
                    <div class="pos-inline">
                      <input class="pos-input" data-cust-search placeholder="Name or phone" style="width:200px;height:34px">
                      <div class="booking-view-switch" role="group" aria-label="Customers view mode">
                        <button class="booking-view-button is-active" type="button" data-cust-view-target="table" aria-pressed="true"><i class="bi bi-table" aria-hidden="true"></i>Table</button>
                        <button class="booking-view-button" type="button" data-cust-view-target="card" aria-pressed="false"><i class="bi bi-grid-1x2" aria-hidden="true"></i>Card</button>
