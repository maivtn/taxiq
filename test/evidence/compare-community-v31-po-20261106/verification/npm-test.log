        #panel-sms-campaigns .sms-campaign-action[data-sms-campaign-action="edit"]:hover { border-color:rgba(142,77,248,.48); background:rgba(142,77,248,.14); color:#7134d4; }
        #panel-sms-campaigns .sms-campaign-action[data-sms-campaign-action="cancel"]:hover { border-color:rgba(217,119,6,.48); background:#fff3d6; color:#b45f00; }
