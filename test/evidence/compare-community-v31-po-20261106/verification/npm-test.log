            document.body.style.overflow = '';
          }
          // Atomic check-in: persist the Booking state, then create one Queue ticket per technician group.
          function checkInBooking(eb) {
            if (!eb) return;
            if (eb.status === 'completed' || eb.status === 'no-show') { toast('This booking is already closed', 'info'); return; }
            var result = appointmentStore.update(eb.id, { status: 'checked-in', metadata: Object.assign({}, eb.metadata || {}, { eta: { st: 'in' }, checkedInAt: Date.now() }) }, null, salonCatalog);
            if (!result.ok) { toast(result.error.message, 'error'); return; }
