              <div class="modal-body">

                <!-- STEP 1: SEGMENT -->
                <div class="field-group">
                  <div class="field-label">Bước 1 — Chọn nhóm khách</div>
                  <div class="segment-grid" id="segmentGrid"></div>
                </div>

                <!-- STEP 2: TEMPLATES -->
                <div class="field-group">
                  <div class="field-label">Bước 2 — Chọn template hoặc tự viết</div>
                  <div class="template-list" id="templateList"></div>
                </div>

                <!-- STEP 3: COMPOSER -->
                <div class="field-group">
                  <div class="field-label">Bước 3 — Soạn nội dung SMS</div>
                  <div class="sms-composer">
                    <div class="sms-toolbar" id="tagToolbar">
                      <span style="font-size:12px;color:var(--text-dim);">Chèn:</span>
                      <button class="tag-btn" data-tag="{TenKhach}"><i class="marketing-icon is-compact" data-lucide="user" aria-hidden="true"></i><span>Tên khách</span></button>
                      <button class="tag-btn" data-tag="{TenTiem}"><i class="marketing-icon is-compact" data-lucide="store" aria-hidden="true"></i><span>Tên tiệm</span></button>
                      <button class="tag-btn" data-tag="{Link}"><i class="marketing-icon is-compact" data-lucide="link" aria-hidden="true"></i><span>Link offer</span></button>
                      <button class="tag-btn" data-tag="{SoDT}"><i class="marketing-icon is-compact" data-lucide="phone" aria-hidden="true"></i><span>Số điện thoại</span></button>
                    </div>
                    <textarea class="sms-textarea" id="smsText" placeholder="Soạn tin nhắn..."></textarea>
                    <div class="sms-footer">
                      <span>Reply STOP để hủy nhận tin</span>
                      <span class="char-count" id="charCountBox">0 ký tự — 0 tin</span>
                    </div>
                  </div>

                  <!-- PHONE PREVIEW -->
                  <div class="sms-preview">
                    <div class="sms-preview-label"><i class="marketing-icon is-compact" data-lucide="smartphone" aria-hidden="true"></i><span>Preview trên điện thoại khách</span></div>
                    <div class="sms-bubble" id="smsBubble"><span class="sms-preview-empty">Tin nhắn sẽ hiển thị ở đây...</span></div>
                  </div>
                </div>

                <!-- STEP 4: LANDING PAGE -->
                <div class="field-group">
                  <div class="field-label">Bước 4 — Đính kèm Landing Page (tùy chọn)</div>
                  <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
                    <select class="form-select" style="flex:1;min-width:200px;" id="lpSelect">
                      <option value="">-- Không đính kèm --</option>
                      <option value="comeback">Comeback Offer July (nexora.ai/btcnailbar/comeback-offer-july)</option>
                      <option value="birthday">Birthday Special (nexora.ai/btcnailbar/birthday-july)</option>
                    </select>
                    <a class="btn-outline" id="createLpBtn" href="nexora-sms-dashboard.html?view=landingpage" target="_blank" rel="noopener"><i class="marketing-icon is-compact" data-lucide="plus" aria-hidden="true"></i><span>Tạo trang</span></a>
                  </div>
                </div>

                <!-- STEP 5: SCHEDULE -->
                <div class="field-group">
                  <div class="field-label">Bước 5 — Lịch gửi</div>
                  <div class="schedule-options" id="scheduleOptions">
                    <button class="schedule-opt selected" data-mode="now">
                      <span class="schedule-opt-icon"><i class="marketing-icon" data-lucide="zap" aria-hidden="true"></i></span>
                      <span class="schedule-opt-label">Gửi ngay</span>
                    </button>
                    <button class="schedule-opt" data-mode="schedule">
                      <span class="schedule-opt-icon"><i class="marketing-icon" data-lucide="clock" aria-hidden="true"></i></span>
                      <span class="schedule-opt-label">Hẹn giờ</span>
                    </button>
                    <button class="schedule-opt" data-mode="auto">
                      <span class="schedule-opt-icon"><i class="marketing-icon" data-lucide="refresh-cw" aria-hidden="true"></i></span>
                      <span class="schedule-opt-label">Tự động</span>
