        #nx-campaign-root .cost-preview-group { display:flex; min-width:0;   flex-direction:column; align-items:flex-start; gap:8px; }
        #nx-campaign-root .cost-preview { display:flex; width:100%; min-width:0; align-items:center; justify-content:space-between; gap:12px; border: 1px solid rgba(43, 89, 255, 0.25); border-radius: 10px; background: rgba(43, 89, 255, 0.06); padding: 10px 16px; }
        #nx-campaign-root .cost-preview.warn { border-color: rgba(220, 38, 38, 0.35); background: rgba(220, 38, 38, 0.07); }
        #nx-campaign-root .cost-preview-info { min-width:0; }
        #nx-campaign-root .cost-preview-label { color: var(--nexora-muted); font-size: 12px; font-weight: 600; }
        #nx-campaign-root .cost-preview-amount { color: var(--nx-electric); font-size: 16px; font-weight: 800; }
        #nx-campaign-root .cost-preview.warn .cost-preview-amount { color: #dc2626; }
        #nx-campaign-root .cost-preview-buy-button { display:inline-flex; align-items:center; justify-content:center; flex-shrink:0; gap:6px; border:1px solid rgba(220,38,38,.35); border-radius:8px; background:#fff; padding:8px 11px; color:#b91c1c; font-size:12px; font-weight:800; white-space:nowrap; }
        #nx-campaign-root .cost-preview-buy-button:hover { border-color:#dc2626; background:#fff1f2; }
        #nx-campaign-root .cost-preview-buy-button:focus-visible { outline:3px solid rgba(220,38,38,.2); outline-offset:2px; }
        #nx-campaign-root .cost-preview-buy-button[hidden] { display:none; }
        #nx-campaign-root .btn-primary {
          display: inline-flex;
          align-items: center;
          gap: 7px;
