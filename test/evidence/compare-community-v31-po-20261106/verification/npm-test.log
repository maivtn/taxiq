    forms:
      0: |-
        <form class="contact-form" id="home-contact-form">
                  <div class="contact-form-heading"><h3 data-contact-i18n="formTitle">Gửi lời nhắn cho chúng tôi</h3><p data-contact-i18n="formIntro">Cho chúng tôi biết chủ đề và điều bạn muốn trao đổi.</p></div>
                  <div class="contact-fields">
                    <label><span data-contact-i18n="name">Họ và tên *</span><input name="name" autocomplete="name" required="" maxlength="120"></label>
                    <label><span data-contact-i18n="business">Doanh nghiệp</span><input name="business" autocomplete="organization" maxlength="120"></label>
                    <label><span data-contact-i18n="email">Email *</span><input name="email" type="email" autocomplete="email" required="" maxlength="254"></label>
                    <label><span data-contact-i18n="phone">Số điện thoại</span><input name="phone" type="tel" autocomplete="tel" maxlength="40"></label>
                  </div>
                  <label class="contact-topic"><span data-contact-i18n="topic">Chủ đề *</span><select name="topic" required=""><option value="" data-contact-i18n="choose">Chọn chủ đề</option><option value="support" data-contact-i18n="support">Hỗ trợ sử dụng</option><option value="onboarding" data-contact-i18n="onboarding">Giá và đăng ký</option><option value="partner" data-contact-i18n="partner">Hợp tác</option><option value="billing" data-contact-i18n="billing">Thanh toán</option><option value="other" data-contact-i18n="other">Khác</option></select></label>
                  <label class="contact-message"><span data-contact-i18n="message">Nội dung yêu cầu *</span><textarea name="message" required="" minlength="10" maxlength="2000" rows="3"></textarea></label>
                  <label class="contact-consent"><input name="consent" type="checkbox" required=""><span data-contact-i18n="consent">Tôi đồng ý để Nexora liên hệ về yêu cầu này. Không nhận quảng cáo nếu chưa đồng ý riêng.</span></label>
                  <div class="contact-form-bottom"><button class="contact-submit" type="submit" aria-describedby="contact-help" data-contact-i18n="submit">Gửi yêu cầu qua email →</button><button class="contact-copy" id="contact-copy" type="button" data-contact-i18n="copy">Sao chép nội dung</button><p class="contact-help" id="contact-help" data-contact-i18n="help">Bản xem trước sẽ mở ứng dụng email của bạn. Vui lòng bấm Gửi trong ứng dụng email để hoàn tất.</p></div>
                  <p class="contact-status" id="contact-status" role="status" aria-live="polite" hidden=""></p>
                </form>
