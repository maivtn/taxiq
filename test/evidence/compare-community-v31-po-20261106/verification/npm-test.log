        #nx-campaign-root .sms-credit-modal-head { display:flex; flex:0 0 auto; align-items:center; justify-content:space-between; gap:16px; border-bottom:1px solid var(--nexora-rule); background:linear-gradient(180deg,#fff,#f8fbff); padding:17px 20px; }
        #nx-campaign-root .sms-credit-modal-title { display:flex; align-items:center; gap:9px; color:var(--nexora-text); font-size:17px; font-weight:900; }
