          // A technician must cover every distinct requirement represented by the ticket's service items.
          function reqSkills(w) {
            var requirements = [];
            (w.items && w.items.length ? w.items : [{ name: w.svc || '', cat: '' }]).forEach(function (item) {
              var req = item.cat && SVC_REQ[item.cat] ? SVC_REQ[item.cat] : null;
              if (!req) {
                var txt = String(item.name || '').toLowerCase();
                if (/acrylic|full set|fill|ombre|sculpt/.test(txt)) req = 'Acrylic';
                else if (/dip/.test(txt)) req = 'Dip';
                else if (/pedicure|pedi/.test(txt)) req = 'Pedicure';
                else if (/design|nail art|chrome|cat eye/.test(txt)) req = 'Design';
                else if (/wax/.test(txt)) req = 'Waxing';
                else if (/gel|shellac/.test(txt)) req = 'Gel';
                else if (/manicure|mani/.test(txt)) req = 'Manicure';
              }
              if (req && requirements.indexOf(req) === -1) requirements.push(req);
            });
            return requirements;
          }
          function reqSkill(w) { return reqSkills(w)[0] || null; }
          function custOf(name) { return CUSTOMERS.find(function (c) { return c.name === name; }) || null; }
          function custByPhone(phone) {
            var digits = String(phone || '').replace(/\D/g, '');
            if (!digits) return null;
            return CUSTOMERS.find(function (c) { return String(c.phone || '').replace(/\D/g, '') === digits; }) || null;
          }
          function matchScore(t, w) {
            var R = MATCH_RULES;
            var reqs = reqSkills(w);
            var missing = reqs.filter(function (req) { return (t.skills || []).indexOf(req) === -1; });
            var okSkill = missing.length === 0;
            var sc = okSkill ? R.wSkill : R.wMiss;                                   // the skill dominates
            if (okSkill) sc += reqs.filter(function (req) { return (t.exp || []).indexOf(req) !== -1; }).length * R.wExp;
            if (R.useTurn) {
              var avg = TECHS.reduce(function (s, x) { return s + x.turns; }, 0) / (TECHS.length || 1);
              sc += Math.max(-10, Math.min(R.wTurn, Math.round((avg - t.turns) * 8)));  // turn fairness
            }
            if (w.reqTech === t.id) sc += R.wReq;                                    // guest asked for them by name
            var c = custOf(w.name);
            if (c && c.prefTech === t.id) sc += R.wPref;                             // regular tech on the profile
            if (c && (t.fit || []).some(function (f) { return (c.tags || []).indexOf(f) !== -1 || (f === 'VIP' && c.seg === 'vip'); })) sc += R.wFit;
            return { sc: Math.max(5, Math.min(99, sc)), req: reqs.join(', ') || null, reqs: reqs, missing: missing, okSkill: missing.length === 0 };
          }
          function busyName(tid) {
            var w = WAITLIST.find(function (x) { return x.status === 'service' && x.techId === tid; });
            return w ? w.name : null;
          }
          function techAvailableForQueueTicket(tid, w) {
            return !WAITLIST.some(function (candidate) {
              return candidate.status === 'service' && candidate.techId === tid && (!w || String(candidate.orderId) !== String(w.orderId));
            });
          }
          function freeTechs() { return TECHS.filter(function (t) { return !busyName(t.id); }); }
          function nextTech() {
            var f = freeTechs();
            return f.length ? f.slice().sort(function (a, b) { return a.turns - b.turns; })[0] : null;
          }
          // ▶ one-tap: the requested tech if free and qualified, otherwise the qualified tech with the fewest turns
          function fAutoTech(w) {
            var free = freeTechs();
            if (w.reqTech) {
              var r = free.find(function (t) { return t.id === w.reqTech; });
              if (r && matchScore(r, w).okSkill) return r;
            }
            var elig = free.filter(function (t) { return matchScore(t, w).okSkill; });
            var pool = elig.length ? elig : free;   // nobody qualified → fall back to any free tech (manual assign still warns)
            return pool.length ? pool.slice().sort(function (a, b) { return a.turns - b.turns; })[0] : null;
          }
          function waitingStartTech(w) {
            if (!w) return null;
            if (w.techId) return techById(w.techId);
            var requested = w.reqTech && techById(w.reqTech);
            if (requested) return requested;
            return fAutoTech(w);
          }
          // 📟 #78 — beep the tech; the push lands in the Time Clock notification feed
          function pageTech(tid, why) {
            var t = techById(tid); if (!t) return;
            NOTIF.push({ tid: tid, at: Date.now(), beep: true, msg: '📟 Beeper #' + (BEEP[tid] || '—') + ' — ' + why });
          }

          var fSel = null;    // guest picked for the two-tap assign
          var fWarn = null;   // {wid, tid} — showing the missing-skill warning; a second tap overrides
          function mergeQueueTicketForAssignment(w) {
            if (!w || !ticketOpen(w)) return w;
            var collisions = WAITLIST.filter(function (candidate) {
              return candidate !== w && ticketOpen(candidate) &&
                String(candidate.orderId) === String(w.orderId) &&
                queueTicketAssignment(candidate) === queueTicketAssignment(w);
            });
            var statusRank = { service: 3, waiting: 2, ready: 1 };
            collisions.forEach(function (collision) {
              var itemKeys = {};
              var mergedItems = [];
              (w.items || []).concat(collision.items || []).forEach(function (item) {
                var key = String(item.serviceTicketId || item.serviceId || item.name || '');
                if (!key || itemKeys[key]) return;
                itemKeys[key] = true;
                mergedItems.push(item);
              });
              w.items = mergedItems;
              w.serviceTicketIds = queueTicketServiceIds(w).concat(queueTicketServiceIds(collision)).filter(function (id, index, ids) {
                return ids.indexOf(id) === index;
              });
              if ((statusRank[collision.status] || 0) > (statusRank[w.status] || 0)) w.status = collision.status;
              if (w.atMs && collision.atMs) w.atMs = Math.min(w.atMs, collision.atMs);
              else w.atMs = w.atMs || collision.atMs;
              if (w.svcAtMs && collision.svcAtMs) w.svcAtMs = Math.min(w.svcAtMs, collision.svcAtMs);
              else w.svcAtMs = w.svcAtMs || collision.svcAtMs;
              if (w.readyAtMs && collision.readyAtMs) w.readyAtMs = Math.min(w.readyAtMs, collision.readyAtMs);
              else w.readyAtMs = w.readyAtMs || collision.readyAtMs;
              w.log = (w.log || []).concat(collision.log || []);
              collision.status = 'cancelled';
              collision.supersededBy = w.id;
              collision.items = [];
              collision.serviceTicketIds = [];
              collision.serviceTicketId = null;
              collision.svc = '';
              collision.durationMin = 0;
              wlog(w, 'Merged technician ticket #' + collision.id + ' into this ticket');
            });
