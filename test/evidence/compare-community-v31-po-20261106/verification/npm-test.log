      <style>
        :root {
          --luxury-gold: #d4af37;
          --brand-cyan: #32d7ff;
          --nexora-canvas: #f7f9fc;
          --nexora-surface: #ffffff;
          --nexora-surface-muted: #f3f6fa;
          --nexora-border: #dde5ef;
          --nexora-text: #0b1220;
          --nexora-muted: #4d5870;
          --nexora-subtle: #7a8296;
          --nexora-sidebar: #081f49;
          --nexora-brand: #4648d8;
          --nexora-electric: #2b59ff;
          --nexora-violet: #8e4df8;
          --nexora-card-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
          --nexora-soft-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
        }

        * {
          box-sizing: border-box;
          -webkit-tap-highlight-color: transparent;
        }

        .sr-only {
          position: absolute;
          width: 1px;
          height: 1px;
          padding: 0;
          margin: -1px;
          overflow: hidden;
          clip: rect(0, 0, 0, 0);
          white-space: nowrap;
          border: 0;
        }

        html,
        body {
          margin: 0;
          min-height: 100%;
          font-family: "Inter", sans-serif;
          background: var(--nexora-canvas);
          color: var(--nexora-text);
        }

        button,
        input,
        textarea,
        select {
          font: inherit;
        }

        button {
          cursor: pointer;
        }

        ::-webkit-scrollbar {
          width: 6px;
          height: 6px;
        }

        ::-webkit-scrollbar-track {
          background: rgba(0, 0, 0, 0.05);
        }

        ::-webkit-scrollbar-thumb {
          background: var(--brand-cyan);
          border-radius: 99px;
        }

        .shell {
          min-height: 100vh;
          background: var(--nexora-canvas);
        }

        .sidebar {
          position: fixed;
          inset: 0 auto 0 0;
          z-index: 30;
          display: none;
          width: 288px;
          flex-direction: column;
          background: var(--nexora-sidebar);
          color: #fff;
          padding: 28px 20px;
        }

        .sidebar-panel {
          flex-shrink: 0;
          border: 1px solid rgba(255, 255, 255, 0.15);
          border-radius: 12px;
          background: rgba(255, 255, 255, 0.05);
          padding: 16px;
        }

        .profile-row {
          display: flex;
          min-width: 0;
          align-items: center;
          gap: 12px;
        }

        .avatar {
          display: inline-flex;
          width: 40px;
          height: 40px;
          flex-shrink: 0;
          align-items: center;
          justify-content: center;
          border-radius: 999px;
          background: linear-gradient(135deg, var(--nexora-electric), var(--nexora-violet));
          color: #fff;
          font-size: 13px;
          font-weight: 800;
          text-transform: uppercase;
        }

        .profile-name {
          overflow: hidden;
          color: #fff;
          font-size: 14px;
          font-weight: 700;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .profile-email {
          margin-top: 2px;
          overflow: hidden;
          color: rgba(255, 255, 255, 0.6);
          font-size: 10px;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .plan-panel {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 10px;
          margin-top: 16px;
          margin-bottom: 12px;
          padding: 10px 12px;
        }

        .plan-info {
          min-width: 0;
        }

        .panel-kicker {
          color: rgba(255, 255, 255, 0.45);
          font-size: 10px;
          font-weight: 800;
          letter-spacing: 0.08em;
          text-transform: uppercase;
        }

        .panel-title {
          margin-top: 2px;
          color: #fff;
          font-size: 13px;
          font-weight: 900;
        }

        .plan-button {
          flex-shrink: 0;
          border: 1px solid rgba(255, 255, 255, 0.15);
          border-radius: 8px;
          background: transparent;
          padding: 6px 12px;
          color: var(--luxury-gold);
          font-size: 12px;
          font-weight: 700;
          white-space: nowrap;
          transition: background 0.2s, border-color 0.2s;
        }

        .plan-button:hover {
          border-color: rgba(255, 255, 255, 0.25);
          background: rgba(255, 255, 255, 0.05);
        }

        .sidebar-nav {
          margin-top: 24px;
          flex: 1;
          overflow-y: auto;
          padding-right: 4px;
        }

        .nav-divider {
          margin: 4px 0;
          border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .nav-item {
          display: flex;
          width: 100%;
          height: 48px;
          align-items: center;
          gap: 12px;
          border: 0;
          border-radius: 8px;
          background: transparent;
          padding: 0 16px;
          color: rgba(255, 255, 255, 0.85);
          text-align: left;
          font-size: 14px;
          font-weight: 700;
          transition: background 0.2s, color 0.2s, box-shadow 0.2s;
        }

        .nav-item:hover {
          background: rgba(255, 255, 255, 0.05);
          color: #fff;
        }

        .nav-item.is-active {
          background: linear-gradient(90deg, var(--nexora-electric), var(--nexora-violet));
          color: #fff;
          box-shadow: 0 10px 24px rgba(43, 89, 255, 0.2);
        }

        .sidebar-icon-wrap {
          display: inline-flex;
          width: 36px;
          height: 36px;
          flex-shrink: 0;
          align-items: center;
          justify-content: center;
          border-radius: 8px;
        }

        .sidebar-icon {
          width: 28px;
          height: 28px;
          object-fit: contain;
          filter: brightness(1.15) saturate(1.2) contrast(1.05)
            drop-shadow(0 0 3px rgba(255, 66, 215, 0.3))
            drop-shadow(0 0 6px rgba(50, 215, 255, 0.2));
          transition: filter 0.2s, transform 0.2s;
        }

        .nav-item:hover .sidebar-icon,
        .nav-item.is-active .sidebar-icon {
          filter: brightness(1.3) saturate(1.35) contrast(1.1)
            drop-shadow(0 0 4px rgba(255, 66, 215, 0.45))
            drop-shadow(0 0 8px rgba(50, 215, 255, 0.35))
            drop-shadow(0 0 12px rgba(138, 92, 255, 0.25));
          transform: scale(1.04);
        }

        .nav-item:hover .sidebar-icon-wrap,
        .nav-item.is-active .sidebar-icon-wrap {
          background: radial-gradient(
            circle,
            rgba(138, 92, 255, 0.24) 0%,
            rgba(50, 215, 255, 0.08) 45%,
            transparent 72%
          );
        }

        .lucide-menu-icon {
          display: block;
          width: 28px;
          height: 28px;
          color: #fff;
          filter: drop-shadow(0 0 4px rgba(255, 66, 215, 0.32))
            drop-shadow(0 0 8px rgba(50, 215, 255, 0.24));
          transition: filter 0.2s, transform 0.2s;
        }

        .nav-item:hover .lucide-menu-icon,
        .nav-item.is-active .lucide-menu-icon {
          filter: drop-shadow(0 0 4px rgba(255, 66, 215, 0.45))
            drop-shadow(0 0 8px rgba(50, 215, 255, 0.35))
            drop-shadow(0 0 12px rgba(138, 92, 255, 0.25));
          transform: scale(1.04);
        }

        .lucide-menu-icon path,
        .lucide-menu-icon rect,
        .lucide-menu-icon circle,
        .lucide-menu-icon line,
        .lucide-menu-icon polyline {
          stroke: currentColor;
          stroke-width: 2;
          stroke-linecap: round;
          stroke-linejoin: round;
        }

        .nav-parent {
          position: relative;
        }

        .nav-caret {
          width: 16px;
          height: 16px;
          margin-left: auto;
          flex-shrink: 0;
          color: rgba(255, 255, 255, 0.6);
          transition: transform 0.24s ease, color 0.2s;
        }

        .nav-parent:hover .nav-caret {
          color: #fff;
        }

        .nav-parent.is-expanded .nav-caret {
          transform: rotate(180deg);
        }

        .nav-caret path {
          stroke: currentColor;
          stroke-width: 2;
          stroke-linecap: round;
          stroke-linejoin: round;
          fill: none;
        }

        .nav-subnav {
          display: grid;
          grid-template-rows: 1fr;
          transition: grid-template-rows 0.24s ease;
        }

        .nav-subnav.is-collapsed {
          grid-template-rows: 0fr;
        }

        .nav-subnav-inner {
          display: flex;
          min-height: 0;
          flex-direction: column;
          gap: 2px;
          overflow: hidden;
          margin: 2px 0 4px 30px;
          padding: 2px 0 2px 12px;
          border-left: 1px solid rgba(255, 255, 255, 0.12);
        }

        .nav-subitem {
          display: flex;
          width: 100%;
          height: 38px;
          align-items: center;
          gap: 8px;
          border: 0;
          border-radius: 8px;
          background: transparent;
          padding: 0 12px;
          color: rgba(255, 255, 255, 0.62);
          text-align: left;
          font-size: 13px;
          font-weight: 600;
          transition: background 0.2s, color 0.2s;
        }

        .nav-subitem:hover {
          background: rgba(255, 255, 255, 0.05);
          color: #fff;
        }

        .nav-subitem.is-active {
          background: rgba(255, 255, 255, 0.09);
          color: #fff;
          font-weight: 800;
        }

        .nav-subitem-dot {
          width: 6px;
          height: 6px;
          flex-shrink: 0;
          border-radius: 50%;
          background: rgba(255, 255, 255, 0.3);
          transition: background 0.2s, box-shadow 0.2s;
        }

        .nav-subitem:hover .nav-subitem-dot {
          background: rgba(255, 255, 255, 0.55);
        }

        .nav-subitem.is-active .nav-subitem-dot {
          background: var(--brand-cyan);
          box-shadow: 0 0 8px rgba(50, 215, 255, 0.6);
        }

        .sidebar-footer {
          margin-top: auto;
          flex-shrink: 0;
          border-top: 1px solid rgba(255, 255, 255, 0.15);
          padding-top: 16px;
        }

        .logout-button {
          display: flex;
          width: 100%;
          align-items: center;
          gap: 8px;
          border: 0;
          background: transparent;
          padding: 8px 12px;
          color: rgba(255, 255, 255, 0.65);
          font-size: 14px;
          font-weight: 700;
          transition: color 0.2s;
        }

        .logout-button:hover {
          color: #fff;
        }

        .app-area {
          min-height: 100vh;
        }

        .header {
          position: sticky;
          top: 0;
          z-index: 20;
          display: flex;
          min-height: 64px;
          align-items: center;
          justify-content: space-between;
          gap: 12px;
          border-bottom: 1px solid var(--nexora-border);
          background: var(--nexora-surface);
          padding: 0 16px;
        }

        .mobile-brand {
          display: flex;
          min-width: 0;
          align-items: center;
          gap: 12px;
        }

        .icon-button {
          display: inline-flex;
          width: 40px;
          height: 40px;
          align-items: center;
          justify-content: center;
          border: 1px solid var(--nexora-border);
          border-radius: 8px;
          background: #fff;
          color: var(--nexora-text);
          box-shadow: var(--nexora-soft-shadow);
          transition: background 0.2s;
        }

        .icon-button:hover {
          background: var(--nexora-surface-muted);
        }

        .brand-logo {
          width: 36px;
          height: 36px;
          flex-shrink: 0;
          object-fit: contain;
        }

        .search {
          position: relative;
          display: none;
          width: min(100%, 385px);
        }

        .search svg {
          position: absolute;
          top: 50%;
          left: 16px;
          width: 16px;
          height: 16px;
          color: var(--nexora-muted);
          transform: translateY(-50%);
          pointer-events: none;
        }

        .search input {
          width: 100%;
          height: 44px;
          border: 1px solid transparent;
          border-radius: 999px;
          outline: 0;
          background: var(--nexora-surface-muted);
          padding: 0 16px 0 48px;
          color: var(--nexora-text);
          font-size: 14px;
        }

        .search input::placeholder {
          color: var(--nexora-subtle);
        }

        .search input:focus {
          border-color: var(--nexora-brand);
          box-shadow: 0 0 0 2px rgba(70, 72, 216, 0.2);
        }

        .header-actions {
          display: flex;
          align-items: center;
          gap: 10px;
        }

        .language-switcher {
          display: none;
          align-items: center;
          gap: 4px;
          border: 1px solid var(--nexora-border);
          border-radius: 999px;
          background: var(--nexora-surface-muted);
          padding: 4px;
        }

        .language-switcher button {
          border: 0;
          border-radius: 999px;
          background: transparent;
          padding: 5px 9px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 800;
        }

        .language-switcher button.is-active {
          background: #fff;
          color: var(--nexora-brand);
          box-shadow: var(--nexora-card-shadow);
        }

        .notification-button {
          position: relative;
        }

        .notification-dot {
          position: absolute;
          top: 8px;
          right: 8px;
          width: 8px;
          height: 8px;
          border: 2px solid #fff;
          border-radius: 999px;
          background: #ef4444;
        }

        .profile-button {
          display: flex;
          align-items: center;
          gap: 10px;
          border: 1px solid var(--nexora-border);
          border-radius: 999px;
          background: #fff;
          padding: 5px 10px 5px 5px;
          box-shadow: var(--nexora-soft-shadow);
        }

        .profile-button .avatar {
          width: 32px;
          height: 32px;
          font-size: 11px;
        }

        .profile-copy {
          display: none;
          text-align: left;
        }

        .profile-copy strong {
          display: block;
          color: var(--nexora-text);
          font-size: 12px;
          line-height: 1.2;
        }

        .profile-copy span {
          color: var(--nexora-subtle);
          font-size: 10px;
        }

        .content {
          min-height: calc(100vh - 64px);
          padding: 16px 16px 96px;
        }

        .blank-stage {
          min-height: calc(100vh - 176px);
        }

        .page-heading {
          margin-bottom: 24px;
        }

        .page-title {
          margin: 0;
          color: var(--nexora-text);
          font-size: 24px;
          font-weight: 800;
          line-height: 32px;
          letter-spacing: normal;
        }

        .page-description {
          margin: 8px 0 0;
          color: var(--nexora-muted);
          font-size: 14px;
          font-weight: 500;
          line-height: 20px;
        }

        .page-heading-links {
          display: flex;
          flex-wrap: wrap;
          align-items: stretch;
          gap: 10px;
          margin-top: 14px;
        }

        .page-guide-link {
          display: inline-flex;
          max-width: 100%;
          align-items: center;
          gap: 8px;
          border: 1px solid rgba(70, 72, 216, .2);
          border-radius: 10px;
          background: linear-gradient(135deg, #fff, #f5f6ff);
          padding: 9px 12px;
          color: var(--nexora-brand);
          font-size: 12px;
          font-weight: 800;
          text-decoration: none;
          box-shadow: var(--nexora-card-shadow);
          transition: border-color .2s, box-shadow .2s, transform .2s;
        }

        .page-guide-link:hover {
          border-color: var(--nexora-brand);
          box-shadow: 0 8px 18px rgba(70, 72, 216, .12);
          transform: translateY(-1px);
        }

        .page-guide-link .bi:first-child {
          color: var(--nexora-electric);
          font-size: 16px;
        }

        .page-guide-link .bi:last-child {
          color: var(--nexora-subtle);
          font-size: 13px;
        }

        .booking-online-share {
          display: grid;
          width: min(100%, 620px);
          min-width: 0;
          grid-template-columns: minmax(180px, 1fr) 38px 38px;
          align-items: stretch;
          gap: 6px;
          border: 1px solid rgba(43, 89, 255, .2);
          border-radius: 10px;
          background: linear-gradient(135deg, #fff, #f4fbff);
          padding: 5px;
          box-shadow: var(--nexora-card-shadow);
        }

        .booking-online-anchor {
          display: flex;
          min-width: 0;
          flex-direction: column;
          justify-content: center;
          gap: 2px;
          border-radius: 7px;
          padding: 3px 7px;
          color: var(--nexora-text);
          text-decoration: none;
        }

        .booking-online-anchor:hover .booking-online-url {
          color: var(--nexora-electric);
          text-decoration: underline;
        }

        .booking-online-label {
          display: flex;
          align-items: center;
          gap: 6px;
          color: var(--nexora-brand);
          font-size: 12px;
          font-weight: 800;
          line-height: 16px;
        }

        .booking-online-url {
          overflow: hidden;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 600;
          line-height: 15px;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .booking-online-icon-button {
          display: inline-flex;
          width: 38px;
          min-height: 38px;
          align-items: center;
          justify-content: center;
          border: 1px solid var(--nexora-border);
          border-radius: 8px;
          background: #fff;
          color: var(--nexora-brand);
          font-size: 16px;
          transition: background .2s, border-color .2s, color .2s, transform .2s;
        }

        .booking-online-icon-button:hover {
          border-color: var(--nexora-brand);
          background: #f4f4ff;
          color: var(--nexora-electric);
          transform: translateY(-1px);
        }

        .booking-online-icon-button:focus-visible,
        .booking-online-anchor:focus-visible,
        .booking-online-qr-close:focus-visible,
        .booking-online-qr-link:focus-visible {
          outline: 3px solid rgba(43, 89, 255, .25);
          outline-offset: 2px;
        }

        .booking-online-qr-dialog {
          width: min(calc(100vw - 32px), 420px);
          max-width: 420px;
          border: 0;
          border-radius: 20px;
          background: transparent;
          padding: 0;
          color: var(--nexora-text);
          box-shadow: 0 24px 70px rgba(15, 23, 42, .28);
        }

        .booking-online-qr-dialog::backdrop {
          background: rgba(8, 31, 73, .58);
          backdrop-filter: blur(4px);
        }

        .booking-online-qr-card {
          position: relative;
          border: 1px solid var(--nexora-border);
          border-radius: 20px;
          background: #fff;
          padding: 28px;
          text-align: center;
        }

        .booking-online-qr-close {
          position: absolute;
          top: 14px;
          right: 14px;
          display: inline-flex;
          width: 36px;
          height: 36px;
          align-items: center;
          justify-content: center;
          border: 1px solid var(--nexora-border);
          border-radius: 9px;
          background: #fff;
          color: var(--nexora-muted);
          font-size: 14px;
        }

        .booking-online-qr-title {
          margin: 4px 40px 0;
          font-size: 20px;
          line-height: 28px;
        }

        .booking-online-qr-description {
          margin: 8px 0 0;
          color: var(--nexora-muted);
          font-size: 13px;
          line-height: 20px;
        }

        .booking-online-qr-art {
          display: flex;
          width: 248px;
          min-height: 248px;
          align-items: center;
          justify-content: center;
          margin: 20px auto 0;
          border: 1px solid var(--nexora-border);
          border-radius: 16px;
          background: #fff;
          padding: 12px;
        }

        .booking-online-qr-art canvas,
        .booking-online-qr-art img {
          display: block;
          max-width: 224px;
          height: auto;
        }

        .booking-online-qr-fallback {
          margin: 14px 0 0;
          color: #b45309;
          font-size: 12px;
          line-height: 18px;
        }

        .booking-online-qr-link {
          display: block;
          margin-top: 16px;
          overflow-wrap: anywhere;
          color: var(--nexora-electric);
          font-size: 12px;
          font-weight: 700;
          line-height: 18px;
        }

        .page-tabs {
          display: flex;
          flex-wrap: wrap;
          gap: 4px;
          margin-top: 20px;
        }

        .page-tab {
          display: inline-flex;
          min-height: 44px;
          align-items: center;
          gap: 4px;
          border: 1px solid var(--nexora-border);
          border-radius: 12px;
          background: var(--nexora-surface);
          padding: 8px 8px;
          color: var(--nexora-muted);
          font-size: 13px;
          font-weight: 600;
          box-shadow: var(--nexora-card-shadow);
          transition: background 0.2s, border-color 0.2s, color 0.2s, box-shadow 0.2s, transform 0.2s;
        }

        .page-tab:hover {
          border-color: rgba(70, 72, 216, 0.35);
          background: #fff;
          color: var(--nexora-text);
          transform: translateY(-1px);
        }

        .page-tab.is-active {
          border-color: transparent;
          background: linear-gradient(90deg, var(--nexora-electric), var(--nexora-violet));
          color: #fff;
          box-shadow: 0 12px 26px rgba(43, 89, 255, 0.22);
        }

        .page-tab-icon {
          display: inline-flex;
          width: 28px;
          height: 28px;
          flex-shrink: 0;
          align-items: center;
          justify-content: center;
          border-radius: 9px;
          background: var(--nexora-surface-muted);
          color: var(--nexora-brand);
        }

        .page-tab.is-active .page-tab-icon {
          background: rgba(255, 255, 255, 0.18);
          color: #fff;
        }

        .page-tab svg {
          width: 17px;
          height: 17px;
        }

        .page-tab .bi {
          font-size: 17px;
          line-height: 1;
        }

        .page-tab svg path,
        .page-tab svg rect {
          stroke: currentColor;
          stroke-width: 2;
          stroke-linecap: round;
          stroke-linejoin: round;
        }

        .page-tab svg.bi path {
          fill: currentColor;
          stroke: none;
        }

        @media (max-width: 767px) {
          .page-tabs {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 4px;
            margin-top: 14px;
          }

          .page-tab {
            width: 100%;
            min-width: 0;
            min-height: 48px;
            flex-direction: column;
            justify-content: center;
            gap: 3px;
            border-radius: 10px;
            padding: 5px 2px;
            font-size: 10px;
            line-height: 1.12;
            text-align: center;
            box-shadow: none;
          }

          .page-tab-icon {
            width: 20px;
            height: 20px;
            border-radius: 7px;
          }

          .page-tab svg {
            width: 13px;
            height: 13px;
          }

          .page-tab .bi {
            font-size: 13px;
          }

          .page-tab > span:last-child {
            display: block;
            max-width: 100%;
            overflow-wrap: anywhere;
          }
        }

        @media (max-width: 380px) {
          .page-tab {
            min-height: 46px;
            font-size: 9px;
          }

          .page-tab-icon {
            width: 18px;
            height: 18px;
          }
        }

        .tab-content {
          margin-top: 24px;
        }

        .tab-panel,
        .sub-panel {
          display: none;
        }

        .tab-panel.is-active,
        .sub-panel.is-active {
          display: block;
        }

        .placeholder-panel {
          display: grid;
          min-height: 280px;
          place-items: center;
          border: 1px dashed var(--nexora-border);
          border-radius: 12px;
          background: rgba(255, 255, 255, 0.72);
          color: var(--nexora-muted);
          text-align: center;
          box-shadow: var(--nexora-card-shadow);
        }

        .placeholder-panel h2 {
          margin: 0;
          color: var(--nexora-text);
          font-size: 18px;
          font-weight: 900;
        }

        .placeholder-panel p {
          max-width: 420px;
          margin: 8px auto 0;
          font-size: 13px;
          font-weight: 500;
          line-height: 1.6;
        }

        .overview-toolbar {
          display: flex;
          flex-wrap: wrap;
          align-items: center;
          justify-content: space-between;
          gap: 14px;
          margin-bottom: 18px;
        }

        .mode-switch {
          display: inline-flex;
          gap: 6px;
          border: 1px solid var(--nexora-border);
          border-radius: 12px;
          background: var(--nexora-surface-muted);
          padding: 5px;
        }

        .mode-switch button {
          min-height: 34px;
          border: 0;
          border-radius: 9px;
          background: transparent;
          padding: 0 12px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 800;
        }

        .mode-switch button.is-active {
          background: #fff;
          color: var(--nexora-brand);
          box-shadow: var(--nexora-card-shadow);
        }

        .sync-note {
          color: var(--nexora-subtle);
          font-size: 11px;
          font-weight: 700;
        }

        .overview-card {
          border: 1px solid var(--nexora-border);
          border-radius: 12px;
          background: var(--nexora-surface);
          box-shadow: var(--nexora-card-shadow);
        }

        .overview-card-pad {
          padding: 18px;
        }

        .overview-kpis {
          display: flex;
          flex-wrap: wrap;
          gap: 12px;
          margin-bottom: 18px;
        }

        .overview-kpis > .kpi-card {
          flex: 1 1 220px;
          min-width: min(100%, 220px);
        }

        /* Call Log stats: keep two cards per row on compact screens and four on larger screens. */
        #panel-calllog .overview-kpis[data-call-stats] {
          gap: 12px;
        }

        #panel-calllog .overview-kpis[data-call-stats] > .kpi-card {
          flex-basis: calc(50% - 6px);
        }

        @media (min-width: 768px) {
          #panel-calllog .overview-kpis[data-call-stats] > .kpi-card {
            flex-basis: calc(25% - 9px);
          }
        }

        .kpi-card {
          position: relative;
          overflow: hidden;
          padding: 18px;
        }

        .kpi-card::after {
          content: "";
          position: absolute;
          top: -18px;
          right: -18px;
          width: 82px;
          height: 82px;
          border-radius: 999px;
          background: var(--kpi-accent, var(--nexora-brand));
          opacity: 0.08;
        }

        .kpi-top {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 12px;
          margin-bottom: 12px;
        }

        .kpi-icon {
          display: inline-flex;
          width: 38px;
          height: 38px;
          align-items: center;
          justify-content: center;
          border-radius: 11px;
          background: color-mix(in srgb, var(--kpi-accent, var(--nexora-brand)) 12%, white);
          color: var(--kpi-accent, var(--nexora-brand));
        }

        .kpi-icon svg {
          width: 19px;
          height: 19px;
        }

        .kpi-icon .bi {
          font-size: 18px;
          line-height: 1;
        }

        .kpi-icon svg path,
        .kpi-icon svg rect,
        .kpi-icon svg circle {
          stroke: currentColor;
          stroke-width: 2;
          stroke-linecap: round;
          stroke-linejoin: round;
        }

        .kpi-label {
          color: var(--nexora-subtle);
          font-size: 10px;
          font-weight: 900;
          letter-spacing: 0.08em;
          text-transform: uppercase;
        }

        .kpi-value {
          color: var(--nexora-text);
          font-size: 28px;
          font-weight: 900;
          line-height: 1;
        }

        .kpi-trend {
          margin-top: 8px;
          color: var(--nexora-success);
          font-size: 12px;
          font-weight: 800;
        }

        /* Compact KPI cards for the overview sections */
        .overview-kpis .kpi-card {
          min-height: 78px;
          padding: 5px 8px;
        }

        .overview-kpis .kpi-card::after {
          top: -12px;
          right: -12px;
          width: 58px;
          height: 58px;
        }

        .overview-kpis .kpi-top {
          gap: 6px;
          margin-bottom: 2px;
        }

        .overview-kpis .kpi-icon {
          width: 24px;
          height: 24px;
          border-radius: 8px;
        }

        .overview-kpis .kpi-icon svg {
          width: 13px;
          height: 13px;
        }

        .overview-kpis .kpi-icon .bi {
          font-size: 14px;
        }

        .overview-kpis .kpi-label {
          font-size: 9px;
          line-height: 1.1;
        }

        .overview-kpis .kpi-value {
          margin-top: 1px;
          font-size: 20px;
        }

        .overview-kpis .kpi-trend {
          margin-top: 2px;
          font-size: 10px;
          line-height: 1.1;
        }

        .overview-kpis .kpi-card {
          display: grid;
          grid-template-columns: 24px minmax(0, 1fr);
          column-gap: 8px;
          align-items: center;
        }

        .overview-kpis .kpi-top {
          display: contents;
        }

        .overview-kpis .kpi-icon {
          grid-column: 1;
          grid-row: 1 / span 3;
        }

        .overview-kpis .kpi-label,
        .overview-kpis .kpi-value,
        .overview-kpis .kpi-trend {
          grid-column: 2;
          min-width: 0;
        }

        .overview-kpis .kpi-label {
          grid-row: 1;
        }

        .overview-kpis .kpi-value {
          grid-row: 2;
        }

        .overview-kpis .kpi-trend {
          grid-row: 3;
        }

        .overview-kpis .kpi-top .badge {
          position: absolute;
          top: 5px;
          right: 8px;
        }

        @media (max-width: 767px) {
          .overview-kpis .kpi-card {
            grid-template-columns: 1fr;
          }

          .overview-kpis .kpi-icon {
            display: none;
          }

          .overview-kpis .kpi-label,
          .overview-kpis .kpi-value,
          .overview-kpis .kpi-trend {
            grid-column: 1;
          }

          .overview-kpis .kpi-label,
          .overview-kpis .kpi-value {
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
          }

          .overview-kpis .kpi-label {
            font-size: 8px;
          }

          .overview-kpis .kpi-value {
            font-size: 18px;
          }
        }

        .overview-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 16px;
          margin-bottom: 18px;
        }

        .card-heading {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 12px;
          margin-bottom: 14px;
        }

        .card-title {
          margin: 0;
          color: var(--nexora-text);
          font-size: 14px;
          font-weight: 900;
        }

        .card-meta {
          color: var(--nexora-subtle);
          font-size: 10px;
          font-weight: 800;
          letter-spacing: 0.08em;
          text-transform: uppercase;
        }

        .table-wrap {
          overflow-x: auto;
        }

        .overview-table {
          width: 100%;
          min-width: 460px;
          border-collapse: collapse;
          font-size: 13px;
        }

        .overview-table th {
          padding: 10px 12px;
          background: var(--nexora-canvas);
          color: var(--nexora-muted);
          text-align: left;
          font-size: 10px;
          font-weight: 900;
          letter-spacing: 0.08em;
          text-transform: uppercase;
        }

        .overview-table td {
          border-top: 1px solid var(--nexora-rule);
          padding: 13px 12px;
          color: var(--nexora-muted);
          font-weight: 600;
        }

        .overview-table td:first-child {
          color: var(--nexora-text);
          font-weight: 900;
        }

        .badge {
          display: inline-flex;
          align-items: center;
          gap: 5px;
          border-radius: 999px;
          padding: 4px 9px;
          font-size: 10px;
          font-weight: 900;
          text-transform: uppercase;
        }

        .badge-plan {
          background: #e9e9ff;
          color: var(--nexora-brand);
        }

        .badge-success {
          background: rgba(0, 184, 115, 0.12);
          color: var(--nexora-success);
        }

        .badge-warning {
          background: rgba(245, 158, 11, 0.14);
          color: var(--nexora-warning);
        }

        .badge-soft {
          background: var(--nexora-canvas);
          color: var(--nexora-muted);
          border: 1px solid var(--nexora-border);
        }

        .seg-badge {
          background: color-mix(in srgb, var(--seg, var(--nexora-brand)) 14%, white);
          color: var(--seg, var(--nexora-brand));
        }

        .progress-stack {
          display: grid;
          gap: 14px;
        }

        .progress-top {
          display: flex;
          justify-content: space-between;
          gap: 12px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 800;
        }

        .progress-value {
          color: var(--nexora-text);
        }

        .progress-track {
          height: 8px;
          margin-top: 7px;
          overflow: hidden;
          border-radius: 999px;
          background: var(--nexora-surface-muted);
        }

        .progress-fill {
          height: 100%;
          border-radius: inherit;
          background: linear-gradient(90deg, var(--nexora-electric), var(--nexora-violet));
        }

        .owner-strip {
          display: flex;
          flex-wrap: wrap;
          align-items: center;
          gap: 12px;
          margin-bottom: 18px;
          padding: 16px;
        }

        .business-mark {
          display: inline-flex;
          width: 44px;
          height: 44px;
          flex-shrink: 0;
          align-items: center;
          justify-content: center;
          border-radius: 12px;
          background: linear-gradient(135deg, var(--nexora-electric), var(--nexora-violet));
          color: #fff;
          font-size: 20px;
          font-weight: 900;
        }

        .business-name {
          margin: 0;
          color: var(--nexora-text);
          font-size: 16px;
          font-weight: 900;
        }

        .business-sub {
          margin-top: 3px;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 700;
        }

        .action-list {
          display: grid;
          gap: 8px;
        }

        .action-card {
          display: grid;
          gap: 10px;
          border: 1px solid var(--nexora-border);
          border-radius: 12px;
          background: var(--nexora-canvas);
          padding: 13px;
        }

        .action-title {
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 900;
        }

        .action-desc {
          margin-top: 2px;
          color: var(--nexora-muted);
          font-size: 12px;
          line-height: 1.45;
        }

        .action-button {
          justify-self: start;
          border: 0;
          border-radius: 8px;
          background: var(--nexora-brand);
          padding: 8px 12px;
          color: #fff;
          font-size: 11px;
          font-weight: 900;
        }

        .owner-section-label {
          display: flex;
          align-items: center;
          gap: 8px;
          margin-bottom: 10px;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 900;
          letter-spacing: 0.08em;
          text-transform: uppercase;
        }

        .owner-pulse {
          width: 8px;
          height: 8px;
          border-radius: 999px;
          background: var(--nexora-warning);
          box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.45);
          animation: ownerPulse 2s infinite;
        }

        @keyframes ownerPulse {
          70% {
            box-shadow: 0 0 0 8px rgba(245, 158, 11, 0);
          }
          100% {
            box-shadow: 0 0 0 0 rgba(245, 158, 11, 0);
          }
        }

        .owner-actions {
          display: grid;
          gap: 8px;
          margin-bottom: 18px;
        }

        .owner-action-card {
          display: grid;
          grid-template-columns: 36px minmax(0, 1fr);
          gap: 12px;
          align-items: center;
          border: 1px solid var(--nexora-border);
          border-radius: 12px;
          background: var(--nexora-surface);
          padding: 13px;
          box-shadow: var(--nexora-card-shadow);
        }

        .owner-action-card.hot {
          border-color: rgba(70, 72, 216, 0.28);
          background: linear-gradient(135deg, rgba(70, 72, 216, 0.08), rgba(50, 215, 255, 0.04));
        }

        .owner-action-icon {
          display: inline-flex;
          width: 36px;
          height: 36px;
          align-items: center;
          justify-content: center;
          border-radius: 10px;
          background: color-mix(in srgb, var(--nexora-brand) 12%, white);
          color: var(--nexora-brand);
        }

        .owner-action-icon.warning {
          background: rgba(245, 158, 11, 0.12);
          color: var(--nexora-warning);
        }

        .owner-action-icon.success {
          background: rgba(0, 184, 115, 0.12);
          color: var(--nexora-success);
        }

        .owner-action-icon svg,
        .owner-feed-icon svg,
        .owner-quick-icon svg {
          width: 17px;
          height: 17px;
        }

        .owner-action-icon svg path,
        .owner-action-icon svg rect,
        .owner-action-icon svg circle,
        .owner-feed-icon svg path,
        .owner-feed-icon svg rect,
        .owner-feed-icon svg circle,
        .owner-quick-icon svg path,
        .owner-quick-icon svg rect,
        .owner-quick-icon svg circle {
          stroke: currentColor;
          stroke-width: 2;
          stroke-linecap: round;
          stroke-linejoin: round;
        }

        .owner-action-title {
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 900;
          line-height: 1.35;
        }

        .owner-action-api {
          margin-top: 3px;
          color: var(--nexora-subtle);
          font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
          font-size: 10px;
          font-weight: 700;
        }

        .owner-action-card .action-button {
          grid-column: 1 / -1;
        }

        .owner-dashboard-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 16px;
          margin-bottom: 18px;
        }

        .owner-feed {
          display: grid;
          gap: 0;
        }

        .owner-feed-row {
          display: grid;
          grid-template-columns: 34px minmax(0, 1fr) auto;
          gap: 10px;
          align-items: start;
          border-bottom: 1px solid var(--nexora-rule);
          padding: 11px 0;
        }

        .owner-feed-row:last-child {
          border-bottom: 0;
          padding-bottom: 0;
        }

        .owner-feed-icon {
          display: inline-flex;
          width: 30px;
          height: 30px;
          align-items: center;
          justify-content: center;
          border-radius: 9px;
          background: var(--nexora-canvas);
          color: var(--nexora-brand);
        }

        .owner-feed-copy {
          color: var(--nexora-text);
          font-size: 12px;
          font-weight: 800;
          line-height: 1.45;
        }

        .owner-feed-time {
          color: var(--brand-cyan);
          font-size: 10px;
          font-weight: 900;
          white-space: nowrap;
        }

        .owner-side-stack {
          display: grid;
          gap: 14px;
        }

        .owner-quick-grid {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 8px;
        }

        .owner-quick-button {
          display: flex;
          min-height: 78px;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          gap: 7px;
          border: 1px solid var(--nexora-border);
          border-radius: 12px;
          background: #fff;
          color: var(--nexora-muted);
          font-size: 10px;
          font-weight: 900;
          transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s, color 0.2s;
        }

        .owner-quick-button:hover,
        .owner-quick-button.is-primary {
          border-color: rgba(70, 72, 216, 0.35);
          color: var(--nexora-brand);
          box-shadow: var(--nexora-card-shadow);
          transform: translateY(-1px);
        }

        .owner-quick-icon {
          display: inline-flex;
          width: 32px;
          height: 32px;
          align-items: center;
          justify-content: center;
          border-radius: 10px;
          background: color-mix(in srgb, var(--nexora-brand) 10%, white);
          color: currentColor;
        }

        .usage-stack {
          display: grid;
          gap: 12px;
        }

        .usage-row {
          display: grid;
          gap: 7px;
        }

        .voice-grid,
        .plans-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 16px;
        }

        .voice-kpi-section {
          width: 100%;
          margin-bottom: 16px;
        }

        .voice-kpis {
          display: grid;
          grid-template-columns: 1fr;
          gap: 12px;
        }

        .voice-phone-wrap {
          display: grid;
          justify-items: center;
        }

        .voice-phone {
          width: min(100%, 260px);
          border: 1px solid var(--nexora-border);
          border-radius: 28px;
          background: #0b1220;
          padding: 10px;
          box-shadow: 0 18px 48px rgba(8, 31, 73, 0.18);
        }

        .voice-phone-screen {
          min-height: 330px;
          border-radius: 22px;
          background: #fff;
          padding: 16px;
          color: var(--nexora-text);
        }

        .voice-phone-head {
          border-bottom: 1px solid var(--nexora-rule);
          padding: 8px 0 14px;
          text-align: center;
        }

        .voice-avatar {
          display: inline-flex;
          width: 42px;
          height: 42px;
          align-items: center;
          justify-content: center;
          border-radius: 999px;
          background: linear-gradient(135deg, var(--nexora-electric), var(--nexora-violet));
          color: #fff;
          font-size: 14px;
          font-weight: 900;
          box-shadow: 0 8px 18px rgba(70, 72, 216, 0.28);
        }

        .voice-bubbles {
          display: grid;
          gap: 8px;
          margin-top: 12px;
        }

        .voice-bubble {
          max-width: 92%;
          border-radius: 14px 14px 14px 4px;
          background: var(--nexora-canvas);
          padding: 10px 12px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 700;
          line-height: 1.45;
        }

        .voice-bubble.in {
          justify-self: end;
          border-radius: 14px 14px 4px 14px;
          background: var(--nexora-brand);
          color: #fff;
        }

        .voice-scenario-grid {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 8px;
          margin-top: 14px;
        }

        .voice-scenario-button {
          display: inline-flex;
          min-height: 42px;
          align-items: center;
          justify-content: center;
          gap: 7px;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: #fff;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 900;
          transition: border-color 0.2s, color 0.2s, box-shadow 0.2s, transform 0.2s;
        }

        .voice-scenario-button:hover,
        .voice-scenario-button.is-active {
          border-color: rgba(70, 72, 216, 0.38);
          color: var(--nexora-brand);
          box-shadow: var(--nexora-card-shadow);
          transform: translateY(-1px);
        }

        .voice-bridge {
          display: flex;
          align-items: center;
          gap: 10px;
          margin-top: 12px;
          border: 1px solid rgba(70, 72, 216, 0.18);
          border-radius: 12px;
          background: color-mix(in srgb, var(--nexora-brand) 7%, white);
          padding: 11px 12px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 700;
        }

        .voice-log {
          display: grid;
          gap: 0;
        }

        .voice-log-row {
          display: grid;
          grid-template-columns: 64px minmax(0, 1fr) auto;
          gap: 10px;
          align-items: center;
          border-bottom: 1px solid var(--nexora-rule);
          padding: 10px 0;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 800;
        }

        .voice-log-row:last-child {
          border-bottom: 0;
          padding-bottom: 0;
        }

        .voice-number-card,
        .roi-panel,
        .guarantee-panel {
          position: relative;
          overflow: hidden;
          border-radius: 12px;
          padding: 16px;
          box-shadow: 0 16px 36px rgba(8, 31, 73, 0.1);
        }

        .voice-number-card > *,
        .roi-panel > *,
        .guarantee-panel > * {
          position: relative;
          z-index: 1;
        }

        .voice-number-card {
          border: 1px solid rgba(70, 72, 216, 0.18);
          background:
            radial-gradient(circle at 94% 8%, rgba(70, 72, 216, 0.08), transparent 34%),
            linear-gradient(135deg, #fff 0%, var(--nexora-surface-muted) 100%);
        }

        .voice-number-card::after {
          content: "";
          position: absolute;
          right: -38px;
          bottom: -44px;
          width: 160px;
          height: 160px;
          border-radius: 999px;
          background: var(--nexora-brand);
          opacity: 0.07;
        }

        .roi-panel {
          border: 1px solid rgba(70, 72, 216, 0.24);
          background:
            radial-gradient(circle at 0% 0%, rgba(239, 68, 68, 0.14), transparent 28%),
            radial-gradient(circle at 96% 10%, rgba(16, 185, 129, 0.18), transparent 30%),
            linear-gradient(135deg, #fff7ed 0%, #f5f3ff 48%, #ecfeff 100%);
        }

        .roi-panel::after {
          content: "";
          position: absolute;
          inset: auto 18px 0;
          height: 4px;
          border-radius: 999px 999px 0 0;
          background: linear-gradient(90deg, #ef4444, var(--nexora-brand), var(--nexora-success));
          opacity: 0.72;
        }

        .guarantee-panel {
          border: 1px solid rgba(16, 185, 129, 0.26);
          background:
            radial-gradient(circle at 90% 0%, rgba(34, 211, 238, 0.18), transparent 34%),
            linear-gradient(135deg, #ecfdf5 0%, #f0fdfa 48%, #eff6ff 100%);
        }

        .voice-number {
          width: fit-content;
          background: linear-gradient(90deg, var(--nexora-brand) 0%, var(--brand-cyan) 100%);
          -webkit-background-clip: text;
          background-clip: text;
          color: transparent;
          font-size: 28px;
          font-weight: 900;
          letter-spacing: 0.03em;
        }

        .voice-number-card .card-meta {
          color: var(--nexora-brand);
        }

        .voice-number-card .business-sub {
          color: var(--nexora-muted);
        }

        .roi-panel .card-meta {
          color: #6d28d9;
        }

        .guarantee-panel .card-meta {
          color: #047857;
        }

        .plans-hero {
          border: 1px solid rgba(245, 158, 11, 0.24);
          border-radius: 12px;
          background: rgba(245, 158, 11, 0.08);
          padding: 12px 14px;
          color: #9a6100;
          font-size: 12px;
          font-weight: 900;
        }

        .service-plan-card {
          position: relative;
          display: flex;
          flex-direction: column;
          border: 1px solid var(--nexora-border);
          border-radius: 12px;
          background: #fff;
          padding: 18px;
          box-shadow: var(--nexora-card-shadow);
          transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
        }

        .service-plan-card:hover,
        .service-plan-card.is-recommended,
        .service-plan-card.is-selected {
          border-color: rgba(70, 72, 216, 0.38);
          box-shadow: var(--nexora-soft-shadow);
          transform: translateY(-1px);
        }

        .service-plan-card.is-recommended {
          background: linear-gradient(135deg, rgba(70, 72, 216, 0.07), rgba(50, 215, 255, 0.04), #fff 54%);
        }

        .plan-rec {
          min-height: 24px;
          color: var(--nexora-brand);
          font-size: 11px;
          font-weight: 900;
          text-transform: uppercase;
        }

        .service-plan-name {
          color: var(--nexora-text);
          font-size: 18px;
          font-weight: 900;
        }

        .service-plan-price {
          margin-top: 10px;
          color: var(--nexora-text);
          font-size: 34px;
          font-weight: 900;
          line-height: 1;
        }

        .service-plan-price span {
          color: var(--nexora-muted);
          font-size: 14px;
          font-weight: 800;
        }

        .service-plan-cross {
          margin-top: 5px;
          color: var(--nexora-subtle);
          font-size: 12px;
          font-weight: 800;
          text-decoration: line-through;
        }

        .plan-features {
          display: grid;
          gap: 9px;
          margin: 16px 0;
        }

        .plan-feature {
          display: grid;
          grid-template-columns: 22px minmax(0, 1fr);
          gap: 9px;
          align-items: start;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 800;
          line-height: 1.45;
        }

        .plan-check {
          display: inline-flex;
          width: 22px;
          height: 22px;
          align-items: center;
          justify-content: center;
          border-radius: 999px;
          background: rgba(0, 184, 115, 0.12);
          color: var(--nexora-success);
          font-size: 12px;
          font-weight: 900;
        }

        .plan-check.muted {
          background: var(--nexora-surface-muted);
          color: var(--nexora-subtle);
        }

        .plan-aio {
          border: 1px solid rgba(70, 72, 216, 0.18);
          border-radius: 10px;
          background: color-mix(in srgb, var(--nexora-brand) 7%, white);
          padding: 9px;
          color: var(--nexora-brand);
          font-size: 12px;
          font-weight: 900;
          line-height: 1.45;
        }

        .plan-select-button {
          width: 100%;
          margin-top: auto;
          border: 1px solid var(--nexora-border);
          border-radius: 9px;
          background: #fff;
          padding: 12px;
          color: var(--nexora-brand);
          font-size: 12px;
          font-weight: 900;
        }

        .service-plan-card.is-recommended .plan-select-button,
        .plan-select-button.is-primary {
          border-color: transparent;
          background: var(--nexora-brand);
          color: #fff;
          box-shadow: 0 10px 22px rgba(70, 72, 216, 0.22);
        }

        .plan-action-stack {
          display: grid;
          gap: 10px;
          margin-top: auto;
        }

        .plan-action-stack .plan-select-button {
          margin-top: 0;
        }

        .service-plan-card.is-recommended .plan-buy-button {
          border-color: var(--nexora-brand);
          background: #fff;
          color: var(--nexora-brand);
          box-shadow: none;
        }

        .roi-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 12px;
          text-align: center;
        }

        .roi-metric {
          --metric-color: var(--nexora-brand);
          position: relative;
          overflow: hidden;
          border: 1px solid color-mix(in srgb, var(--metric-color) 22%, white);
          border-radius: 12px;
          background: rgba(255, 255, 255, 0.72);
          padding: 13px 12px;
          box-shadow: 0 10px 24px rgba(8, 31, 73, 0.08);
        }

        .roi-metric::before {
          content: "";
          position: absolute;
          top: -28px;
          right: -24px;
          width: 72px;
          height: 72px;
          border-radius: 999px;
          background: var(--metric-color);
          opacity: 0.12;
        }

        .roi-metric > * {
          position: relative;
          z-index: 1;
        }

        .roi-metric.is-loss {
          --metric-color: #ef4444;
        }

        .roi-metric.is-cost {
          --metric-color: var(--nexora-brand);
        }

        .roi-metric.is-gain {
          --metric-color: var(--nexora-success);
        }

        .roi-value {
          position: relative;
          color: var(--metric-color, var(--nexora-text));
          font-size: 26px;
          font-weight: 900;
        }

        .roi-label {
          margin-top: 3px;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 800;
        }

        .roi-summary {
          margin-top: 12px;
          border: 1px solid rgba(6, 182, 212, 0.2);
          border-radius: 10px;
          background: rgba(255, 255, 255, 0.68);
          padding: 9px 11px;
        }

        .guarantee-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 8px;
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 800;
        }

        .guarantee-grid div {
          border: 1px solid rgba(16, 185, 129, 0.18);
          border-radius: 10px;
          background: rgba(255, 255, 255, 0.72);
          padding: 9px 11px;
          color: #047857;
          box-shadow: 0 8px 18px rgba(8, 31, 73, 0.06);
        }

        .settings-shell {
          display: grid;
          gap: 16px;
        }

        .settings-hero {
          position: relative;
          overflow: hidden;
          border: 1px solid rgba(70, 72, 216, 0.24);
          border-radius: 14px;
          background:
            radial-gradient(circle at 8% 0%, rgba(70, 72, 216, 0.16), transparent 32%),
            radial-gradient(circle at 92% 10%, rgba(6, 182, 212, 0.16), transparent 34%),
            linear-gradient(135deg, #f8fafc 0%, #eef2ff 52%, #ecfeff 100%);
          padding: 18px;
          box-shadow: var(--nexora-card-shadow);
        }

        .settings-hero.is-compact {
          padding: 14px;
        }

        .settings-eyebrow {
          display: inline-flex;
          align-items: center;
          gap: 8px;
          border: 1px solid rgba(70, 72, 216, 0.18);
          border-radius: 999px;
          background: rgba(255, 255, 255, 0.7);
          padding: 6px 10px;
          color: var(--nexora-brand);
          font-size: 10px;
          font-weight: 900;
          text-transform: uppercase;
        }

        .settings-hero.is-compact .settings-eyebrow {
          gap: 6px;
          padding: 5px 9px;
          font-size: 9.5px;
        }

        .settings-title {
          margin: 12px 0 0;
          color: var(--nexora-text);
          font-size: 24px;
          font-weight: 900;
          line-height: 1.16;
        }

        .settings-hero.is-compact .settings-title {
          margin-top: 9px;
          font-size: 20px;
          line-height: 1.18;
        }

        .settings-desc {
          max-width: 760px;
          margin-top: 8px;
          color: var(--nexora-muted);
          font-size: 13px;
          font-weight: 650;
          line-height: 1.55;
        }

        .settings-hero.is-compact .settings-desc {
          max-width: 680px;
          margin-top: 6px;
          font-size: 12px;
          line-height: 1.42;
        }

        .settings-sync-grid {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 8px;
          margin-top: 16px;
        }

        .settings-hero.is-compact .settings-sync-grid {
          display: flex;
          flex-wrap: wrap;
          gap: 6px;
          margin-top: 10px;
        }

        .settings-sync-pill {
          border: 1px solid rgba(70, 72, 216, 0.14);
          border-radius: 11px;
          background: rgba(255, 255, 255, 0.7);
          padding: 9px 10px;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 900;
        }

        .settings-hero.is-compact .settings-sync-pill {
          display: inline-flex;
          align-items: center;
          gap: 5px;
          border-radius: 999px;
          padding: 6px 9px;
          font-size: 10px;
          font-weight: 650;
          line-height: 1.2;
          white-space: nowrap;
        }

        .settings-sync-pill strong {
          display: block;
          color: var(--nexora-text);
          font-size: 12px;
        }

        .settings-hero.is-compact .settings-sync-pill strong {
          display: inline;
          font-size: 10.5px;
          font-weight: 800;
        }

        .settings-grid,
        .settings-two-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 14px;
        }

        .settings-two-grid > .settings-service-pricing-card {
          grid-column: 1 / -1;
        }

        .settings-card {
          border: 1px solid var(--nexora-border);
          border-radius: 12px;
          background: var(--nexora-surface);
          padding: 16px;
          box-shadow: var(--nexora-card-shadow);
        }

        .settings-card.is-featured {
          border-color: rgba(70, 72, 216, 0.26);
          background:
            radial-gradient(circle at 0% 0%, rgba(70, 72, 216, 0.12), transparent 32%),
            linear-gradient(135deg, #fff 0%, #f5f3ff 48%, #ecfeff 100%);
        }

        .settings-card-head {
          display: flex;
          align-items: flex-start;
          justify-content: space-between;
          gap: 12px;
          margin-bottom: 14px;
        }

        .settings-card-head > div:first-child {
          min-width: 0;
        }

        .settings-card-actions {
          display: inline-flex;
          flex-shrink: 0;
          align-items: center;
          gap: 8px;
          margin-left: auto;
        }

        .settings-collapse-button {
          display: inline-flex;
          width: 30px;
          height: 30px;
          flex: 0 0 30px;
          align-items: center;
          justify-content: center;
          border: 1px solid var(--nexora-border);
          border-radius: 9px;
          background: #fff;
          color: var(--nexora-brand);
          font-size: 13px;
          transition: border-color 0.16s ease, background 0.16s ease, color 0.16s ease;
        }

        .settings-collapse-button:hover {
          border-color: rgba(70, 72, 216, 0.3);
          background: color-mix(in srgb, var(--nexora-brand) 7%, white);
        }

        .settings-collapse-button .bi {
          line-height: 1;
          transition: transform 0.16s ease;
        }

        .settings-card.is-collapsed > :not(.settings-card-head),
        .settings-template-library.is-collapsed > :not(.settings-section-head),
        .settings-subsection.is-collapsed > :not(.settings-section-head) {
          display: none !important;
        }

        .settings-card.is-collapsed .settings-collapse-button .bi,
        .settings-template-library.is-collapsed .settings-collapse-button .bi,
        .settings-subsection.is-collapsed .settings-collapse-button .bi {
          transform: rotate(180deg);
        }

        .settings-card-title {
          display: inline-flex;
          align-items: center;
          gap: 8px;
          color: var(--nexora-text);
          font-size: 14px;
          font-weight: 900;
        }

        .settings-card-title .bi {
          color: var(--nexora-brand);
          font-size: 16px;
          line-height: 1;
        }

        .settings-card-sub {
          margin-top: 4px;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 650;
          line-height: 1.45;
        }

        .settings-first-call-sms,
        .settings-ai-content-group {
          display: grid;
          gap: 12px;
          border: 1px solid rgba(70, 72, 216, 0.18);
          border-radius: 12px;
          background: linear-gradient(180deg, rgba(70, 72, 216, 0.06), rgba(50, 215, 255, 0.04));
          padding: 14px;
        }

        .settings-ai-content-group {
          grid-column: 1 / -1;
        }

        .settings-ai-content-group-head {
          display: flex;
          min-height: 24px;
          align-items: center;
        }

        .settings-first-call-sms-head {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 16px;
        }

        .settings-first-call-sms-copy {
          display: flex;
          flex: 1 1 auto;
          align-items: center;
          min-width: 0;
        }

        .settings-first-call-sms-copy > .settings-label {
          flex: 0 0 auto;
        }

        .settings-first-call-sms-toggle {
          display: flex;
          flex-shrink: 0;
          align-items: center;
          gap: 8px;
        }

        .settings-first-call-sms-toggle-label {
          color: var(--nexora-success);
          font-size: 10px;
          font-weight: 800;
          white-space: nowrap;
        }

        .settings-first-call-sms-toggle-label.is-off {
          color: var(--nexora-subtle);
        }

        .settings-first-call-sms .settings-textarea {
          min-height: 84px;
        }

        body.has-settings-voice-overlay {
          overflow: hidden;
        }

        .settings-ai-voice-field {
          grid-column: 1 / -1;
        }

        .settings-ai-voice-summary-card,
        .settings-ai-voice-summary,
        .settings-ai-voice-name-line,
        .settings-voice-modal-title-row,
        .settings-voice-library-tools,
        .settings-voice-filter-button,
        .settings-voice-filter-option,
        .settings-voice-row,
        .settings-voice-row-main,
        .settings-voice-row-actions,
        .settings-voice-modal-footer,
        .settings-voice-toast {
          display: flex;
          align-items: center;
        }

        .settings-ai-voice-summary-card {
          min-height: 76px;
          justify-content: space-between;
          gap: 14px;
          border: 1px solid rgba(70, 72, 216, 0.24);
          border-radius: 12px;
          background: linear-gradient(135deg, rgba(70, 72, 216, 0.055), rgba(50, 215, 255, 0.035));
          padding: 12px 13px;
        }

        .settings-ai-voice-summary {
          min-width: 0;
          gap: 11px;
        }

        .settings-ai-voice-orb {
          position: relative;
          display: grid;
          width: 44px;
          height: 44px;
          flex: 0 0 auto;
          place-items: center;
          overflow: hidden;
          border-radius: 50%;
          background: linear-gradient(145deg, #171b4a, #5d59e8 60%, #31c7ec);
          box-shadow: 0 8px 18px rgba(70, 72, 216, 0.22);
          color: #fff;
        }

        .settings-ai-voice-orb::before,
        .settings-ai-voice-orb::after {
          position: absolute;
          border: 1px solid rgba(255, 255, 255, 0.48);
          border-radius: 50%;
          content: "";
        }

        .settings-ai-voice-orb::before {
          width: 24px;
          height: 24px;
        }

        .settings-ai-voice-orb::after {
          width: 13px;
          height: 13px;
        }

        .settings-ai-voice-orb .bi {
          position: relative;
          z-index: 1;
          font-size: 17px;
        }

        .settings-ai-voice-copy {
          min-width: 0;
        }

        .settings-ai-voice-name-line {
          gap: 7px;
        }

        .settings-ai-voice-name-line strong {
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 850;
        }

        .settings-ai-voice-active-chip {
          border-radius: 999px;
          background: rgba(0, 184, 115, 0.1);
          padding: 2px 7px;
          color: #008c58;
          font-size: 9px;
          font-weight: 850;
          letter-spacing: 0.05em;
          text-transform: uppercase;
        }

        .settings-ai-voice-copy p {
          margin: 2px 0 0;
          color: var(--nexora-muted);
          font-size: 11px;
        }

        .settings-voice-overlay {
          position: fixed;
          inset: 0;
          z-index: 150;
          display: flex;
          align-items: center;
          justify-content: center;
          background: rgba(5, 13, 30, 0.58);
          padding: 20px;
          backdrop-filter: blur(5px);
          opacity: 1;
          transition: opacity 180ms ease;
        }

        .settings-voice-overlay[aria-hidden="true"] {
          visibility: hidden;
          opacity: 0;
          pointer-events: none;
        }

        .settings-voice-library {
          display: flex;
          width: min(100%, 660px);
          max-height: 88vh;
          max-height: 88dvh;
          flex-direction: column;
          overflow: hidden;
          border: 1px solid rgba(255, 255, 255, 0.5);
          border-radius: 18px;
          background: #fff;
          box-shadow: 0 24px 72px rgba(12, 22, 44, 0.24);
          transform: translateY(0) scale(1);
          transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
        }

        .settings-voice-overlay[aria-hidden="true"] .settings-voice-library {
          transform: translateY(12px) scale(0.985);
        }

        .settings-voice-modal-head {
          padding: 19px 20px 14px;
        }

        .settings-voice-modal-title-row {
          justify-content: space-between;
          gap: 12px;
        }

        .settings-voice-modal-title-row h2 {
          margin: 0;
          color: var(--nexora-text);
          font-size: 17px;
          letter-spacing: -0.02em;
        }

        .settings-voice-modal-head > p {
          margin: 4px 36px 0 0;
          color: var(--nexora-muted);
          font-size: 11px;
        }

        .settings-voice-icon-button {
          display: grid;
          width: 38px;
          height: 38px;
          flex: 0 0 auto;
          place-items: center;
          border: 1px solid transparent;
          border-radius: 9px;
          background: transparent;
          color: var(--nexora-muted);
          cursor: pointer;
        }

        .settings-voice-icon-button:hover {
          border-color: var(--nexora-border);
          background: var(--nexora-surface-muted);
          color: var(--nexora-text);
        }

        .settings-voice-library-tools {
          position: relative;
          align-items: stretch;
          gap: 9px;
          padding: 0 20px 14px;
          border-bottom: 1px solid var(--nexora-rule);
        }

        .settings-voice-search-wrap {
          position: relative;
          min-width: 0;
          flex: 1 1 auto;
        }

        .settings-voice-search-wrap .bi-search {
          position: absolute;
          top: 50%;
          left: 12px;
          color: var(--nexora-subtle);
          font-size: 15px;
          transform: translateY(-50%);
          pointer-events: none;
        }

        .settings-voice-search-input {
          width: 100%;
          min-height: 42px;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: var(--nexora-surface-muted);
          padding: 0 12px 0 38px;
          color: var(--nexora-text);
          font-size: 12px;
        }

        .settings-voice-filter-wrap {
          position: relative;
          flex: 0 0 auto;
        }

        .settings-voice-filter-button {
          min-width: 112px;
          min-height: 42px;
          justify-content: space-between;
          gap: 9px;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: #fff;
          padding: 0 11px;
          cursor: pointer;
          font-size: 11px;
          font-weight: 750;
        }

        .settings-voice-filter-button .bi {
          color: var(--nexora-subtle);
          font-size: 12px;
          transition: transform 140ms ease;
        }

        .settings-voice-filter-button[aria-expanded="true"] .bi {
          transform: rotate(180deg);
        }

        .settings-voice-filter-menu {
          position: absolute;
          top: calc(100% + 6px);
          right: 0;
          z-index: 4;
          width: 150px;
          border: 1px solid var(--nexora-border);
          border-radius: 11px;
          background: #fff;
          padding: 5px;
          box-shadow: 0 16px 38px rgba(15, 23, 42, 0.16);
        }

        .settings-voice-filter-menu[hidden] {
          display: none;
        }

        .settings-voice-filter-option {
          width: 100%;
          min-height: 38px;
          justify-content: space-between;
          border: 0;
          border-radius: 8px;
          background: transparent;
          padding: 0 10px;
          cursor: pointer;
          font-size: 11px;
          font-weight: 700;
        }

        .settings-voice-filter-option:hover,
        .settings-voice-filter-option.is-selected {
          background: #e9e9ff;
          color: var(--nexora-brand);
        }

        .settings-voice-filter-check {
          opacity: 0;
          font-size: 13px;
          font-weight: 900;
        }

        .settings-voice-filter-option.is-selected .settings-voice-filter-check {
          opacity: 1;
        }

        .settings-voice-list {
          flex: 1 1 auto;
          min-height: 0;
          overflow-y: auto;
          padding: 8px;
          scrollbar-color: #c6cfdd transparent;
          scrollbar-width: thin;
        }

        .settings-voice-row {
          width: 100%;
          min-height: 68px;
          justify-content: space-between;
          gap: 12px;
          border: 1px solid transparent;
          border-radius: 11px;
          padding: 8px 10px;
          transition: border-color 140ms ease, background 140ms ease, box-shadow 140ms ease;
        }

        .settings-voice-row:hover {
          background: var(--nexora-surface-muted);
        }

        .settings-voice-row[aria-selected="true"] {
          border-color: rgba(70, 72, 216, 0.4);
          background: #e9e9ff;
          box-shadow: 0 0 0 1px rgba(70, 72, 216, 0.06);
        }

        .settings-voice-row[data-playing="true"] {
          border-color: rgba(70, 72, 216, 0.48);
        }

        .settings-voice-row-main {
          min-width: 0;
          flex: 1 1 auto;
          gap: 11px;
          align-self: stretch;
          border: 0;
          border-radius: 8px;
          background: transparent;
          padding: 0;
          text-align: left;
          cursor: pointer;
        }

        .settings-voice-mini-orb {
          display: grid;
          width: 36px;
          height: 36px;
          flex: 0 0 auto;
          place-items: center;
          border-radius: 50%;
          background: linear-gradient(145deg, #20275c, var(--voice-accent, #6f72ea));
          color: #fff;
          font-size: 10px;
          font-weight: 850;
          letter-spacing: 0.02em;
          box-shadow: 0 6px 14px rgba(42, 50, 97, 0.16);
        }

        .settings-voice-row-copy {
          min-width: 0;
        }

        .settings-voice-row-name {
          display: flex;
          align-items: center;
          gap: 7px;
        }

        .settings-voice-row-name strong {
          color: var(--nexora-text);
          font-size: 12px;
        }

        .settings-voice-gender {
          color: var(--nexora-subtle);
          font-size: 9px;
          font-weight: 750;
          letter-spacing: 0.06em;
          text-transform: uppercase;
        }

        .settings-voice-row-copy p {
          margin: 2px 0 0;
          overflow: hidden;
          color: var(--nexora-muted);
          font-size: 10.5px;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .settings-voice-row-actions {
          flex: 0 0 auto;
          gap: 7px;
        }

        .settings-voice-select-check {
          display: grid;
          width: 24px;
          height: 24px;
          place-items: center;
          border: 1px solid var(--nexora-border);
          border-radius: 50%;
          background: #fff;
          padding: 0;
          color: transparent;
          cursor: pointer;
          font-size: 13px;
          font-weight: 900;
        }

        .settings-voice-row[aria-selected="true"] .settings-voice-select-check {
          border-color: var(--nexora-brand);
          background: var(--nexora-brand);
          color: #fff;
        }

        .settings-voice-preview-button {
          display: grid;
          width: 38px;
          height: 38px;
          place-items: center;
          border: 1px solid #cfd8e5;
          border-radius: 10px;
          background: #fff;
          color: var(--nexora-text);
          cursor: pointer;
        }

        .settings-voice-preview-button:hover {
          border-color: rgba(70, 72, 216, 0.42);
          color: var(--nexora-brand);
        }

        .settings-voice-preview-button .bi-stop-fill {
          display: none;
        }

        .settings-voice-row[data-playing="true"] .settings-voice-preview-button {
          border-color: var(--nexora-brand);
          background: var(--nexora-brand);
          color: #fff;
        }

        .settings-voice-row[data-playing="true"] .settings-voice-preview-button .bi-play-fill {
          display: none;
        }

        .settings-voice-row[data-playing="true"] .settings-voice-preview-button .bi-stop-fill {
          display: block;
        }

        .settings-voice-empty-results {
          display: grid;
          min-height: 170px;
          place-items: center;
          padding: 24px;
          color: var(--nexora-muted);
          text-align: center;
        }

        .settings-voice-empty-results strong {
          display: block;
          margin-bottom: 3px;
          color: var(--nexora-text);
          font-size: 12px;
        }

        .settings-voice-empty-results span {
          font-size: 10px;
        }

        .settings-voice-row[hidden],
        .settings-voice-empty-results[hidden] {
          display: none;
        }

        .settings-voice-modal-footer {
          justify-content: space-between;
          gap: 12px;
          border-top: 1px solid var(--nexora-rule);
          background: var(--nexora-surface-muted);
          padding: 13px 20px;
        }

        .settings-voice-modal-footer-copy {
          color: var(--nexora-muted);
          font-size: 10px;
        }

        .settings-voice-modal-footer-copy strong {
          color: var(--nexora-text);
        }

        .settings-voice-modal-actions {
          display: flex;
          gap: 8px;
        }

        .settings-voice-modal-button {
          display: inline-flex;
          min-height: 40px;
          align-items: center;
          justify-content: center;
          gap: 7px;
          border: 1px solid var(--nexora-border);
          border-radius: 9px;
          background: #fff;
          padding: 0 13px;
          color: var(--nexora-text);
          cursor: pointer;
          font-size: 11px;
          font-weight: 800;
        }

        .settings-voice-modal-button.is-primary {
          border-color: var(--nexora-brand);
          background: var(--nexora-brand);
          color: #fff;
        }

        .settings-voice-modal-button:disabled {
          cursor: not-allowed;
          opacity: 0.48;
        }

        .settings-voice-icon-button:focus-visible,
        .settings-voice-filter-button:focus-visible,
        .settings-voice-filter-option:focus-visible,
        .settings-voice-row-main:focus-visible,
        .settings-voice-preview-button:focus-visible,
        .settings-voice-modal-button:focus-visible,
        .settings-voice-search-input:focus-visible {
          outline: none;
          box-shadow: 0 0 0 3px rgba(70, 72, 216, 0.2);
        }

        .settings-voice-toast {
          position: fixed;
          right: 22px;
          bottom: 22px;
          z-index: 170;
          max-width: min(360px, calc(100vw - 32px));
          gap: 10px;
          border: 1px solid rgba(0, 184, 115, 0.22);
          border-radius: 12px;
          background: #fff;
          padding: 12px 14px;
          box-shadow: 0 18px 48px rgba(15, 23, 42, 0.18);
          color: var(--nexora-text);
          font-size: 11px;
          font-weight: 700;
          opacity: 1;
          transform: translateY(0);
          transition: opacity 180ms ease, transform 180ms ease;
        }

        .settings-voice-toast[aria-hidden="true"] {
          visibility: hidden;
          opacity: 0;
          transform: translateY(10px);
        }

        .settings-voice-toast-icon {
          display: grid;
          width: 24px;
          height: 24px;
          place-items: center;
          border-radius: 50%;
          background: rgba(0, 184, 115, 0.12);
          color: var(--nexora-success);
        }

        @media (max-width: 639px) {
          .settings-ai-voice-summary-card {
            align-items: stretch;
            flex-direction: column;
          }

          .settings-ai-voice-summary-card > .booking-secondary-button {
            width: 100%;
          }

          .settings-voice-overlay {
            align-items: flex-end;
            padding: 0;
          }

          .settings-voice-library {
            width: 100%;
            max-height: 92vh;
            max-height: 92dvh;
            border-right: 0;
            border-bottom: 0;
            border-left: 0;
            border-radius: 20px 20px 0 0;
          }

          .settings-voice-modal-head {
            padding: 17px 16px 13px;
          }

          .settings-voice-library-tools {
            padding: 0 16px 13px;
          }

          .settings-voice-filter-button {
            min-width: 104px;
          }

          .settings-voice-list {
            padding: 7px;
          }

          .settings-voice-row {
            min-height: 72px;
            padding: 8px;
          }

          .settings-voice-row-copy p {
            max-width: 210px;
          }

          .settings-voice-select-check {
            display: none;
          }

          .settings-voice-modal-footer {
            align-items: stretch;
            flex-direction: column;
            padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
          }

          .settings-voice-modal-actions .settings-voice-modal-button {
            flex: 1 1 0;
          }

          .settings-voice-toast {
            right: 16px;
            bottom: calc(16px + env(safe-area-inset-bottom));
            left: 16px;
            max-width: none;
          }
        }

        @media (max-width: 390px) {
          .settings-voice-library-tools {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 100px;
            gap: 7px;
          }

          .settings-voice-filter-button {
            min-width: 0;
          }

          .settings-voice-mini-orb {
            width: 34px;
            height: 34px;
          }

          .settings-voice-row-main {
            gap: 8px;
          }

          .settings-voice-row-copy p {
            max-width: 166px;
          }

          .settings-voice-preview-button {
            width: 36px;
            height: 36px;
          }
        }

        .settings-input-row,
        .settings-actions {
          display: flex;
          flex-wrap: wrap;
          gap: 8px;
        }

        .settings-input-row .settings-input {
          flex: 1 1 220px;
        }

        .settings-field-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 10px;
        }

        .settings-field {
          display: grid;
          gap: 6px;
        }

        .settings-business-grid {
          align-items: start;
          column-gap: 12px;
          row-gap: 12px;
        }

        .settings-location-grid {
          display: grid;
          grid-column: 1 / -1;
          grid-template-columns: 1fr;
          column-gap: 10px;
          row-gap: 10px;
        }

        .settings-location-grid > .settings-field {
          min-width: 0;
          gap: 6px;
        }

        .settings-location-grid > .settings-field:not(.settings-span-full) {
          grid-template-rows: 14px 40px;
        }

        .settings-location-grid > .settings-span-full {
          grid-column: 1 / -1;
        }

        .settings-location-grid .settings-label {
          font-size: 10px;
        }

        .settings-location-grid .settings-input,
        .settings-location-grid .settings-select {
          min-height: 40px;
          border-radius: 9px;
          padding: 0 11px;
        }

        .settings-business-grid > .settings-field {
          min-width: 0;
        }

        .settings-business-grid > .settings-field:not(.settings-span-full) {
          grid-template-rows: 16px 46px;
        }

        .settings-business-grid > .settings-span-full {
          grid-column: 1 / -1;
        }

        .settings-business-grid .settings-label,
        .settings-business-grid .settings-help {
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        .settings-business-grid .settings-input {
          border-radius: 10px;
        }

        .settings-business-grid .settings-help {
          min-height: 16px;
        }

        .settings-social-links {
          display: grid;
          grid-column: 1 / -1;
          gap: 10px;
          border-top: 1px solid var(--nexora-border);
          margin-top: 2px;
          padding-top: 12px;
        }

        .settings-social-links-title {
          color: var(--nexora-text);
          font-size: 12px;
          font-weight: 900;
        }

        .settings-social-grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 10px;
        }

        .settings-label {
          color: var(--nexora-subtle);
          font-size: 11px;
          font-weight: 700;
          letter-spacing: 0.02em;
          text-transform: uppercase;
        }

        .settings-label-with-tooltip {
          display: inline-flex;
          align-items: center;
          gap: 4px;
          overflow: visible !important;
          text-overflow: clip !important;
          white-space: nowrap;
        }

        .settings-tooltip {
          position: relative;
          display: inline-flex;
          flex-shrink: 0;
        }

        .settings-tooltip-trigger {
          display: inline-flex;
          width: 16px;
          height: 16px;
          align-items: center;
          justify-content: center;
          border: 0;
          background: transparent;
          padding: 0;
          color: var(--nexora-brand);
          cursor: help;
        }

        .settings-tooltip-trigger .bi {
          font-size: 12px;
          line-height: 1;
        }

        .settings-tooltip-content {
          position: absolute;
          bottom: calc(100% + 8px);
          left: 50%;
          z-index: 20;
          display: none;
          width: max-content;
          max-width: min(320px, calc(100vw - 32px));
          border: 1px solid rgba(255, 255, 255, 0.12);
          border-radius: 10px;
          background: #0b1220;
          padding: 10px 12px;
          color: #fff;
          font-size: 11px;
          font-weight: 500;
          letter-spacing: normal;
          line-height: 1.5;
          text-align: left;
          text-transform: none;
          white-space: normal;
          overflow-wrap: anywhere;
          box-shadow: 0 10px 24px rgba(8, 31, 73, 0.24);
          transform: translateX(-50%);
        }

        .settings-tooltip-content::after {
          position: absolute;
          bottom: -6px;
          left: 50%;
          width: 10px;
          height: 10px;
          border-right: 1px solid rgba(255, 255, 255, 0.12);
          border-bottom: 1px solid rgba(255, 255, 255, 0.12);
          background: #0b1220;
          content: "";
          transform: translateX(-50%) rotate(45deg);
        }

        .settings-tooltip:hover .settings-tooltip-content,
        .settings-tooltip:focus-within .settings-tooltip-content {
          display: block;
        }

        .settings-input,
        .settings-select,
        .settings-textarea {
          width: 100%;
          border: 1px solid var(--nexora-border);
          border-radius: 9px;
          background: #fff;
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 600;
          outline: none;
        }

        .settings-input,
        .settings-select {
          min-height: 42px;
          padding: 0 12px;
        }

        .settings-textarea {
          min-height: 92px;
          padding: 11px 12px;
          line-height: 1.5;
          resize: vertical;
        }

        .settings-input:focus,
        .settings-select:focus,
        .settings-textarea:focus {
          border-color: rgba(70, 72, 216, 0.42);
          box-shadow: 0 0 0 3px rgba(70, 72, 216, 0.1);
        }

        .phone-input-shell {
          display: flex;
          width: 100%;
          min-height: 42px;
          overflow: hidden;
          align-items: center;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: #fff;
          transition: border-color 0.2s, box-shadow 0.2s;
        }

        .phone-input-shell:focus-within {
          border-color: rgba(0, 184, 115, 0.9);
          box-shadow: 0 0 0 3px rgba(0, 184, 115, 0.12);
        }

        .settings-business-grid .phone-input-shell {
          min-height: 46px;
        }

        .phone-country-select {
          width: 74px;
          min-height: 100%;
          flex-shrink: 0;
          border: 0;
          border-right: 1px solid var(--nexora-border);
          background: transparent;
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 800;
          outline: none;
          padding: 0 12px;
        }

        .phone-mask-input,
        .phone-input-shell .settings-input,
        .phone-input-shell .trial-input,
        .phone-input-shell .booking-input {
          flex: 1;
          min-width: 0;
          min-height: auto;
          border: 0;
          border-radius: 0;
          background: transparent;
          box-shadow: none;
          padding: 0 14px;
        }

        .phone-input-shell .settings-input:focus,
        .phone-input-shell .trial-input:focus,
        .phone-input-shell .booking-input:focus {
          border-color: transparent;
          box-shadow: none;
        }

        .phone-mask-input[readonly] {
