          gap: 8px;
        }

        .settings-hours-toolbar {
          display: flex;
          min-height: 64px;
          align-items: center;
          gap: 10px;
          margin-top: 12px;
          margin-bottom: 0;
          padding: 10px 12px;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: var(--nexora-canvas);
        }

        .settings-timezone-field {
          display: grid;
          min-width: 220px;
          align-self: center;
          flex: 0 1 280px;
          grid-template-rows: auto 38px;
          gap: 4px;
        }

        .settings-timezone-select {
          height: 38px;
          min-height: 38px;
          border-radius: 9px;
          padding: 0 10px;
        }

        .settings-timezone-status {
          align-self: center;
          padding-bottom: 0;
          color: var(--nexora-muted);
          font-size: 11px;
          font-weight: 600;
        }

        @media (max-width: 520px) {
          .settings-hours-toolbar {
            align-items: stretch;
            flex-direction: column;
          }

          .settings-timezone-field {
            min-width: 0;
          }

          .settings-timezone-status {
            padding-bottom: 0;
          }
        }

        .settings-hour-row,
        .settings-config-row {
          display: grid;
          gap: 8px;
          align-items: center;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: var(--nexora-canvas);
          padding: 10px;
        }

        .settings-hour-row {
          grid-template-columns: 90px minmax(0, 1fr) auto minmax(0, 1fr);
          gap: 10px;
          background: #fff;
          padding: 7px 12px;
        }

        .settings-hour-row.is-closed {
          background: var(--nexora-canvas);
          opacity: 0.6;
        }

        .settings-hour-day,
        .settings-config-title {
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 700;
        }

        .settings-hour-time,
        .settings-config-desc {
          color: var(--nexora-muted);
          font-size: 11.5px;
          font-weight: 500;
          line-height: 1.45;
        }

        .settings-hour-toggle {
          display: inline-flex;
          min-width: 0;
          align-items: center;
          gap: 10px;
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 700;
        }

        .settings-hour-toggle input {
          width: 16px;
          height: 16px;
          flex-shrink: 0;
          margin: 0;
          accent-color: var(--nexora-brand);
        }

        .settings-time-box {
          position: relative;
          min-width: 0;
        }

        .settings-hour-input {
          width: 100%;
          min-height: 34px;
          border: 1px solid var(--nexora-border);
          border-radius: 10px;
          background: #fff;
          padding: 0 34px 0 12px;
          color: var(--nexora-text);
          font-size: 13px;
          font-weight: 600;
          outline: none;
        }

        .settings-hour-input:focus {
          border-color: rgba(70, 72, 216, 0.42);
          box-shadow: 0 0 0 3px rgba(70, 72, 216, 0.1);
        }

        .settings-time-box svg {
          position: absolute;
          top: 50%;
          right: 10px;
          width: 16px;
          height: 16px;
          color: var(--nexora-subtle);
          transform: translateY(-50%);
          pointer-events: none;
        }

        .settings-time-box svg path,
        .settings-time-box svg circle {
          stroke: currentColor;
          stroke-width: 2;
          stroke-linecap: round;
          stroke-linejoin: round;
        }

        .settings-hour-to {
          color: var(--nexora-muted);
          font-size: 12px;
          font-weight: 600;
          text-align: center;
        }

        .settings-hour-row.is-closed .settings-hour-toggle,
        .settings-hour-row.is-closed .settings-hour-input,
        .settings-hour-row.is-closed .settings-time-box svg,
        .settings-hour-row.is-closed .settings-hour-to {
          color: var(--nexora-subtle);
        }

        .settings-hour-row.is-closed .settings-hour-input {
          background: var(--nexora-surface-muted);
        }

        .settings-chip-row {
