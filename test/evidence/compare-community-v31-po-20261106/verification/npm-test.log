          function floorCount(st) { return WAITLIST.filter(function (w) { return w.status === st; }).length; }
          function ticketOpen(w) { return w.status !== 'completed' && w.status !== 'cancelled'; }
          function hasOperationalTicketForServiceTicket(serviceTicketId) {
