                  '<td>' + x.stChip + '</td><td>' + x.act + '</td></tr>';
              }).join('') +
              '</tbody></table></div>';
            var cardsHtml = '<div data-mg-payout-list>' + rows.map(function (r) {
              var x = payoutRowHtml(r);
              var bigAct = r.po.st === 'paid' ? ''
