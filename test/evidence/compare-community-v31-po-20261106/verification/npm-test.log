                    </div>

                    <div class="confirm-box" data-confirm-box>
                      <div class="confirm-title"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> Xác nhận trước khi gửi</div>
                      <div class="confirm-detail" data-confirm-detail></div>
                    </div>
                  </div>

                  <div class="sms-mfoot">
